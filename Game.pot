msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00022a0c_Oblivion_RESP1"
msgid "Farewell, and be careful, Kurdan is not to be trusted."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13StaffofIndarys_00031c97_Oblivion_RESP2"
msgid "Farewell, and may Arkay guide you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13ThornbladeTopic_00031c96_Oblivion_RESP2"
msgid "Farewell, and may Arkay guide you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004f9bf_Oblivion_RESP1"
msgid ""
"Farewell, and may you find your way home safely each night to a warm fire."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001e06f_Oblivion_RESP1"
msgid "Farewell, child."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0006fdcc_Oblivion_RESP1"
msgid "Farewell, citizen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003c9b6_Oblivion_RESP1"
msgid "Farewell, friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0006a84c_Oblivion_RESP1"
msgid "Farewell, magister. May your spells never falter."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008673a_Oblivion_RESP1"
msgid "Farewell, my friend!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000165b5_Oblivion_RESP1"
msgid "Farewell, my friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000a712f_Oblivion_RESP1"
msgid "Farewell, my friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000236ee_Oblivion_RESP1"
msgid ""
"Farewell, my friend. May your blade always strike true. And first. He he."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15RitualReady_00027e44_Oblivion_RESP1"
msgid ""
"Farewell, my friend. Our fate is in your hands. Bring back the Amulet of "
"Kings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003c35f_Oblivion_RESP1"
msgid "Farewell, serjo."
msgstr ""

