msgid "Yes, Sir Knight?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk1_00034045_Oblivion_RESP1"
msgid "Yes, Sister?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000251d5_Oblivion_RESP1"
msgid "Yes, Sister? What can old Gogron do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Ally01Tactic1_0001798f_Oblivion_RESP1"
msgid "Yes, Your Grace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Ally01Tactic1_000181bf_Oblivion_RESP1"
msgid "Yes, Your Grace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Ally01Tactic2_00017990_Oblivion_RESP1"
msgid "Yes, Your Grace."
msgstr ""

