msgstr ""

msgctxt "ST_LogEntries/LOC_LE_MQ05_STAGE10_LOG0"
msgid ""
"I should speak to Jauffre about how to recover the Amulet from the enemy."
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_SE06_STAGE15_LOG1"
msgid ""
"I should speak to Kaneh, the Golden Saint commander, about kindling the Flame "
"of Agnon."
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_MQ07_STAGE90_LOG1"
msgid ""
"I should speak to Martin about his progress in deciphering the Mysterium "
"Xarxes."
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_MQ09_STAGE5_LOG0"
msgid ""
"I should speak to Martin about the second item he needs for the ritual to "
"open a portal to Mankar Camoran's realm of Paradise."
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_SE03_STAGE5_LOG0"
msgid "I should speak to Sheogorath and see if he has any further need of me."
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_SE06_STAGE10_LOG1"
msgid ""
"I should speak to Ulfri, the Dark Seducer commander, about kindling the Flame "
"of Agnon."
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_SE39_STAGE60_LOG1"
msgid "I should speak with Ranarr-Jo to tell him the mission is accomplished."
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_MQ02_STAGE20_LOG1"
msgid ""
"I should take the Amulet of Kings to Jauffre, at Weynon Priory near the city "
"of Chorrol."
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_SE02_STAGE21_LOG1"
msgid "I should talk to Jayred about killing the Gatekeeper."
msgstr ""

