msgid ""
"Have you heard? Someone desecrated the tomb of Llathasa. No wonder her ghost "
"haunts that place."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00027999_Oblivion_RESP1"
msgid "Have you heard? Someone's been murdered! One of us!"
msgstr ""

