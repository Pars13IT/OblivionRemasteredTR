msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_0004837b_Oblivion_RESP1"
msgid ""
"Behold the new hero of the people of Cyrodiil! Behold, your Arena Grand "
"Champion, the Black Arrow!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048379_Oblivion_RESP1"
msgid ""
"Behold the new hero of the people of Cyrodiil! Behold, your Arena Grand "
"Champion, the Butcher!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_0004837f_Oblivion_RESP1"
msgid ""
"Behold the new hero of the people of Cyrodiil! Behold, your Arena Grand "
"Champion, the Crimson Blade!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_0004837d_Oblivion_RESP1"
msgid ""
"Behold the new hero of the people of Cyrodiil! Behold, your Arena Grand "
"Champion, the Divine Avenger!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048385_Oblivion_RESP1"
msgid ""
"Behold the new hero of the people of Cyrodiil! Behold, your Arena Grand "
"Champion, the Iron Maiden!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_0004837e_Oblivion_RESP1"
msgid ""
"Behold the new hero of the people of Cyrodiil! Behold, your Arena Grand "
"Champion, the Messenger of Death!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048378_Oblivion_RESP1"
msgid ""
"Behold the new hero of the people of Cyrodiil! Behold, your Arena Grand "
"Champion, the Spellslinger!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048382_Oblivion_RESP1"
msgid ""
"Behold the new hero of the people of Cyrodiil! Behold, your Arena Grand "
"Champion, the Tamriel Terror!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND10KnightsHail_00002caa_Knights_RESP1"
msgid "Behold the power of the Nine!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048373_Oblivion_RESP1"
msgid "Behold, Dragonheart!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048374_Oblivion_RESP1"
msgid "Behold, Lady Luck!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048370_Oblivion_RESP1"
msgid "Behold, Man o' War!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_0004836a_Oblivion_RESP1"
msgid "Behold, Shadowstep!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048371_Oblivion_RESP1"
msgid "Behold, Sir Slaughter!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_0004836c_Oblivion_RESP1"
msgid "Behold, Skullcrusher!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_0004836b_Oblivion_RESP1"
msgid "Behold, the Black Arrow!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048369_Oblivion_RESP1"
msgid "Behold, the Butcher!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_0004836f_Oblivion_RESP1"
msgid "Behold, the Crimson Blade!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_0004836d_Oblivion_RESP1"
msgid "Behold, the Divine Avenger!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048375_Oblivion_RESP1"
msgid "Behold, the Iron Maiden!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_0004836e_Oblivion_RESP1"
msgid "Behold, the Messenger of Death!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000566e_Oblivion_RESP1"
msgid ""
"Behold, the Night Mother! The locals call this statue the Lucky Old Lady. "
"They have no idea how lucky they really are."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048368_Oblivion_RESP1"
msgid "Behold, the Spellslinger!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048372_Oblivion_RESP1"
msgid "Behold, the Tamriel Terror!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14TruepaintTopic_0001c1c6_Oblivion_RESP3"
msgid ""
"Being a devout follower of Dibella, he prayed to her for something that would "
"allow him to express himself once more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ04Notes_0018a958_Oblivion_RESP3"
msgid ""
"Being the first person to discover Welkynd Stones growing outside their "
"natural environment, I was worried a rival researcher would snatch them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalChoice4_00026ad3_Oblivion_RESP1"
msgid ""
"Bejeen? Bejeen knows nothing. Bejeen tells stories. Silly Bejeen. Shame on "
"Bejeen to tell such silly, silly stories."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND05FortBulwarkTopic_00002aec_Knights_RESP2"
msgid ""
"Believe in yourself, and use your knowledge wisely. You will pass through "
"unharmed, and the Shield will be yours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_000bf1ce_Oblivion_RESP1"
msgid ""
"Believe me, Mehrunes Dagon will know he was in a fight if he tries to take "
"this city from me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS04HotWater_000704bc_Oblivion_RESP2"
msgid ""
"Believe me, he'll need all the help he can get to worm his way out of this "
"one. To think he'd fall for the gang's scheme... agh! I could kill him!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000463d4_Oblivion_RESP1"
msgid ""
"Believe me, it was no picnic. But thanks to our friend here, I now know we "
"can close these hell-gates. We can defend Bruma!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000688f3_Oblivion_RESP1"
msgid "Belisarius, how are you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00068904_Oblivion_RESP1"
msgid "Belisarius, thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MartinB_0003782f_Oblivion_RESP1"
msgid "Belongs to me? The Amulet of Kings?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND04SirRalvasGreeting02_00002ad7_Knights_RESP1"
msgid ""
"Below the Chapel of Zenithar in Leyawiin there is a shrine to the great "
"craftsman, Saint Kaladas. Those seeking the Mace must pray before the shrine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15GaiarAlataTopic_00015880_Oblivion_RESP3"
msgid ""
"Beneath the mountain lies the Forbidden Grotto, the only way out of the "
"Savage Garden."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c24f_Oblivion_RESP1"
msgid ""
"Bernadette Peneles works over at the Tamika Winery. They make a quality wine "
"there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ShadowbanishWine_0018d92e_Oblivion_RESP3"
msgid ""
"Besides tasting incredible, the magic within the wine allows the imbiber to "
"be gifted with Night Eye!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028a00_Oblivion_RESP1"
msgid ""
"Besides you and me, he's the only one left! By Ysmir, that boy will pay for "
"what he's done! Come, we must kill Primo before he kills us!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AleswellTopic_0000085d_Oblivion_RESP2"
msgid "Besides, I don't know if they'd have been happy to see me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Victims_00081fdc_Oblivion_RESP2"
msgid ""
"Besides, they are furthering important research into the nature of pain and "
"suffering, of life and death."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07ChMania_000139ac_Oblivion_RESP2"
msgid ""
"Besides, won't it be a grand surprise when you make his heart burst from too "
"much Greenmote? Thadon loves surprises!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04Profits_00035fb1_Oblivion_RESP2"
msgid "Besides, you're a thief. You'd just sell the ring and let me swing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_000add08_Oblivion_RESP4"
msgid ""
"Besides... I'd have a full-scale political crisis on my hands if I tried to "
"pull any troops out of the provinces."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022498_Oblivion_RESP3"
msgid "Best if kept just between us, yes? So, what say you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018b19a_Oblivion_RESP2"
msgid ""
"Best mage I've ever seen, but a bit eccentric. Last I heard, she had camped "
"out at a shrine to Kynareth, and was killing wildlife for fun, I think."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ViranusDontonTOPIC_0002f9e1_Oblivion_RESP1"
msgid "Best not to speak of him now. Go on about your business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00061c3c_Oblivion_RESP1"
msgid ""
"Best not to talk about it here. Meet me after dark at the sewer grate "
"northeast of the Sheogorath statue."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007bac0_Oblivion_RESP2"
msgid "Best of luck."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_00175bc7_Oblivion_RESP1"
msgid ""
"Best prices? Right here at Gundalas' Best Goods and Guarantees! Never an "
"unhappy customer! Huge discounts... to qualifying patrons!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003cf92_Oblivion_RESP1"
msgid ""
"Best shops in Anvil? Norbert Lelles handles rare books, exotic ingredients, "
"and gems, and they have fine weapons at Morvayn's Peacemakers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Pillar_00035f51_Oblivion_RESP5"
msgid ""
"Best to play it safe. No complex magic. Stick to basic spells with single "
"effects. It's not worth taking unnecessary risks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0007817e_Oblivion_RESP1"
msgid "Best way to kill a Skinned Hound is with a fireball, or a good weapon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bcc7_Oblivion_RESP1"
msgid ""
"Best way to take out a skeleton is with a big weapon. Forget spells. Just "
"smack them and watch the bones fly!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006fdc3_Oblivion_RESP1"
msgid ""
"Bet you think you're somethin' huh? You call yourself a citizen of the "
"Empire? No respect for order, no respect for law. You make me sick."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_0003334c_Oblivion_RESP1"
msgid ""
"Bet you're glad it won't last long, huh? Oh, didn't you know? No one ever "
"leaves this prison alive! You're going to die in here, Redguard! Die!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0000917c_Oblivion_RESP1"
msgid "Betrayer! I have found you at last! Your reckoning is at hand!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFlameofAgnonTopic_00019ad4_Oblivion_RESP1"
msgid ""
"Betraying the Dark Seducers! The biters bit, so to speak. Most ingenious. I "
"must say, I really didn't think you had it in you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00028bc2_Oblivion_RESP1"
msgid "Better be moving along, outsider."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004f54a_Oblivion_RESP1"
msgid "Better go talk to ol' Arvena."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_HackdirtStrangerResponse_000981dd_Oblivion_RESP1"
msgid "Better keep an eye on her."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_HackdirtStrangerResponse_000981dc_Oblivion_RESP1"
msgid "Better keep an eye on him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_00032b12_Oblivion_RESP1"
msgid ""
"Better not close this one. There's no way to open it from the other side."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG12Choice1B_0000beeb_Oblivion_RESP1"
msgid ""
"Better that you should be adequately prepared. I shall await your return."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_000b0702_Oblivion_RESP2"
msgid "Better, maybe, now that we've got the Dragon to watch over us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479eb_Oblivion_RESP1"
msgid ""
"Betto Plotius. I'm a faithful servant of Leyawiin and the Emperor... Gods "
"rest his soul."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE35Hate_0007866f_Oblivion_RESP2"
msgid ""
"Between my shop and a few others in Crucible, he's been caught stealing maybe "
"a dozen times last month."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f1e6_Oblivion_RESP1"
msgid ""
"Between the Gatekeeper and the Resonator of Judgment, I feel much safer in "
"New Sheoth right now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000566f_Oblivion_RESP9"
msgid ""
"Between the hours of midnight and 3:00 AM, ask me about the Night Mother, and "
"we will away to our Lady's home. Only then will the ritual begin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0cf_Oblivion_RESP1"
msgid ""
"Between the sailors and shipmen of the port, and my little local circle of "
"friends, I have plenty of yarns for knitting up my tales."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0005d51a_Oblivion_RESP1"
msgid ""
"Between the seen and unseen, the seeming and the being, lies the gulf of "
"ignorance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesGuildTopic_0006261e_Oblivion_RESP1"
msgid ""
"Between the two of them, Borissean and Gaspar have mastered nearly every type "
"of spell there is. You'd be wise to go see them if you can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_00028716_Oblivion_RESP1"
msgid ""
"Between you and me, I think Matilde found the gold, and one of the others "
"killed her for it! Maybe that means the rest of us are safe. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0007b478_Oblivion_RESP1"
msgid ""
"Between you and me? Ysabel is completely in love with me. But I'm just not a "
"one-woman guy. Nope, the life of the bachelor suits me just fine..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UlrichLelandTopic_0003c2ac_Oblivion_RESP1"
msgid ""
"Beware of Ulrich. I wouldn't confront him at this time, as he'll surely have "
"you thrown in jail."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0004db76_Oblivion_RESP1"
msgid "Beware the Obelisks!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008db85_Oblivion_RESP1"
msgid ""
"Beware the vicious Scalon for it carries dread disease. If this foe bites "
"you, then stay away from me please."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECreatureResponses_0008e102_Oblivion_RESP1"
msgid ""
"Beware the vicious Scalon for it carries dread disease. If this foe bites "
"you, then stay away from me please."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDKnightsStartCombat_00002b40_Knights_RESP1"
msgid "Beware!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDKnightsStartCombat_00002b49_Knights_RESP1"
msgid "Beware! Umaril's Aurorans are attacking!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008da9e_Oblivion_RESP1"
msgid ""
"Beware. The Redguard Valley Ogres are not known for their... hospitality."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03AReward_0007f3cf_Oblivion_RESP1"
msgid ""
"Beyond that, take whatever else you need from the recovery chest... you've "
"earned it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChallengeArgonian_0009f9af_Oblivion_RESP1"
msgid ""
"Beyond this gate is my Argonian challenger. She is a clever thing, and eager "
"for your blood."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_00082629_Oblivion_RESP1"
msgid ""
"Bhisha is always following him around. Ushnar would do anything to stop it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e86_Oblivion_RESP1"
msgid ""
"Biene Amelion sold her family sword and armor to pay her debts. And you think "
"you have it bad?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BieneAmelionTOPIC_000091cc_Oblivion_RESP1"
msgid "Biene? She should be around here somewhere. Just look around a bit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45EndChoice1_00081b7a_Oblivion_RESP1"
msgid ""
"Big Head knows a secret about blades. Point them out, never in. Blade is out -"
" poke, poke, poke! Kill the grandpa netch!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_00047703_Oblivion_RESP1"
msgid ""
"Big city. I really LOVE the lights at night, shoo-shoo. The City of Love. Got "
"it? Love? Light? Night? Big. Big, big, big, BIG!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FishermansRockLater_000860d6_Oblivion_RESP1"
msgid "Big help you are.... All right. Maybe I'll wait here. And maybe not."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45HaveFork_00078785_Oblivion_RESP4"
msgid ""
"Big-Head knows secrets. Secrets of learning. Alchemy, Sneaking, and stabbing "
"with Blades! Which will you learn?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45HaveFork_00078785_Oblivion_RESP2"
msgid ""
"Big-Head names you friend! Songs of friendship! Songs of ship-friends! "
"Presents for you! Presents on Hatching Day!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45HaveFork_00078785_Oblivion_RESP3"
msgid ""
"Big-Head was hatched, but his brother was not! Presents for egg-friend! "
"Almost forgot! Selfish Big-Head. Shellfish Big-Head!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture3_0007194a_Oblivion_RESP1"
msgid ""
"Birthstone Doomstones bear red runes, appear with stone circles, and are "
"associated with the classic birthsigns like the Apprentice and the Atronach."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BittneldTopic_0002a990_Oblivion_RESP1"
msgid ""
"Bittneld -- captain of the castle guard? -- he seems like such a nice fellow. "
"Too bad I don't see him in here very much."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ10Husband_00061420_Oblivion_RESP4"
msgid ""
"Bjalfi snatched Rockshatter from our mantle and took off to \"find his "
"fortune\" with the local Marauder gang at Fort Strand. I want that mace back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00090b5e_Oblivion_RESP1"
msgid "Black Brugo is dead, right? So I'm going to be a knight?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0014600d_Oblivion_RESP1"
msgid ""
"Black Brugo, chief of the Black Bow Bandits, is dead. And the Count made his "
"killers Knights of the White Stallion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CurrentEventsResponses_00024ffa_Oblivion_RESP1"
msgid ""
"Black Marsh has become more dangerous than ever. Many settlers have been "
"lost, and most non-Argonians have left in fear."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD05Choice9_0002c622_Oblivion_RESP2"
msgid ""
"Blackheart has a fascination with these Ayleid ruins. There's one northeast "
"of here, Atatar. My bet is that he moved his base there. I'll lead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_00159763_Oblivion_RESP1"
msgid ""
"Blackwood Company is putting the Fighters Guild to shame. They're a new "
"mercenary company, competing with the guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e6e_Oblivion_RESP1"
msgid ""
"Blackwood Company is sloppy. They make mistakes. Sooner or later it is going "
"to cost them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e35_Oblivion_RESP1"
msgid ""
"Blackwood Company takes any and all contracts, and always completes them. "
"Hard to beat that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000477f3_Oblivion_RESP1"
msgid ""
"Blackwood Company's a problem. Not for me. I mostly do training. But we don't "
"see many contracts in Leyawiin guildhall. Blackwood gets them all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e7a_Oblivion_RESP1"
msgid ""
"Blackwood Company's getting all the contracts around Leyawiin. No wonder the "
"boys there are getting restless."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624c1_Oblivion_RESP1"
msgid ""
"Blackwood isn't so bad, once you get used to the flies. And being lost all "
"the time. And the zombies and will-o-the-wisps."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479cf_Oblivion_RESP3"
msgid ""
"Blackwood' refers in part to Blackwood Forest, but it also carries a "
"reference to the 'thoghatt', of 'charcoal warriors' of Khajiit tradition."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062ccd_Oblivion_RESP1"
msgid "Blade and bone. Speak to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OrderOfTalosTopic_00033dfb_Oblivion_RESP3"
msgid ""
"Blades who are too old for active service often join the Order as lay "
"brothers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ04Conv_00037c38_Oblivion_RESP1"
msgid ""
"Blades! Dark times are upon us. The Emperor and his sons were slain on our "
"watch. The Empire is in chaos."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15Voice_00094073_Oblivion_RESP1"
msgid "Blades! Do homage to Martin's champion!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0006833e_Oblivion_RESP1"
msgid "Bladesman, I was wondering if I might have a word?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BOASTHATE_0018b2b6_Oblivion_RESP1"
msgid "Blah, blah, blah. What a bore."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Arden_0001f3ba_Oblivion_RESP1"
msgid "Blasphemy! Never utter the name of the Dark Deceiver lightly!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEArctusSpeech03_0008988b_Oblivion_RESP1"
msgid ""
"Blasphemy! These words are the pillars upon which the teachings of Arden-Sul "
"stand!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03GrommokChamberTwoStart_00067120_Oblivion_RESP1"
msgid "Blast! The cage is locked."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_0006445c_Oblivion_RESP1"
msgid ""
"Blasted thief. I hope they string him up when they catch him. He's a slippery "
"one, though. The beggars are his eyes and ears."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00036320_Oblivion_RESP1"
msgid ""
"Blech! I would not feed on you if you were the last warm body in Tamriel!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGDirectGiveCoin_00045f6c_Oblivion_RESP1"
msgid "Bless you! Dar Jee lives east of the temple."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGDirectGiveCoin_00045f6f_Oblivion_RESP1"
msgid ""
"Bless you! Fathis Ules lives in the middle of the Elven Gardens district."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGDirectGiveCoin_00045f6b_Oblivion_RESP1"
msgid "Bless you! Ongar lives behind the temple."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGDirectGiveCoin_00045f6e_Oblivion_RESP1"
msgid "Bless you! Orrin lives in the Castle. Hard to believe, eh?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGDirectGiveCoin_00045f73_Oblivion_RESP1"
msgid "Bless you! There's none in this town, but you could try Anvil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGDirectGiveCoin_00045f72_Oblivion_RESP1"
msgid "Bless you! There's none in this town, but you could try Bravil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGDirectGiveCoin_00045f70_Oblivion_RESP1"
msgid "Bless you! There's none in this town, but you could try Bruma."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGDirectGiveCoin_00045f71_Oblivion_RESP1"
msgid "Bless you! There's none in this town, but you could try Leyawiin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGDirectGiveCoin_00045f74_Oblivion_RESP1"
msgid ""
"Bless you! There's none in this town, but you could try the Imperial City."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033b2d_Oblivion_RESP1"
msgid "Bless you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TheForgottenOnesTOPIC_0001ce9c_Oblivion_RESP1"
msgid ""
"Blessed are the Forgotten Ones, Chosen of Namira. In squalor they thrive, "
"wallowing in filth, low and repulsive, darlings of Namira."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebb2_Oblivion_RESP1"
msgid "Blessed are you who wields the Goldbrand."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ShrineofMolagBalTOPIC_00026b41_Oblivion_RESP1"
msgid "Blessed are you, who has spoken to the Corrupter."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ef74_Oblivion_RESP1"
msgid ""
"Blessed are you, who walks his true path. Enlightened are you, who learns of "
"himself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ef75_Oblivion_RESP1"
msgid "Blessed are you. How may I serve you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00091a76_Oblivion_RESP1"
msgid "Blessed we are."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00015e0f_Oblivion_RESP1"
msgid "Blessings of Akatosh upon ye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS26GiveCoins_00035c94_Oblivion_RESP1"
msgid "Blessings of Akatosh upon you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00015e11_Oblivion_RESP1"
msgid "Blessings of Anu upon ye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00015e13_Oblivion_RESP1"
msgid "Blessings of Arkay upon ye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00015e0e_Oblivion_RESP1"
msgid "Blessings of Julianos upon ye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00015e12_Oblivion_RESP1"
msgid "Blessings of Mystara upon ye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00015e14_Oblivion_RESP1"
msgid "Blessings of Stendarr upon ye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000579c6_Oblivion_RESP1"
msgid "Blessings of the Lady upon you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000914b1_Oblivion_RESP1"
msgid "Blessings of the Madgod, citizen. Walk without fear."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00070f85_Oblivion_RESP1"
msgid "Blessings of the Madgod."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000029e5_Knights_RESP1"
msgid "Blessings of the Nine upon you, my friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e8a6_Oblivion_RESP1"
msgid ""
"Blessings of the Nine. I'm Ohtesse the Healer. By the grace of Mara, I offer "
"Advanced Training in the Restoration Arts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038aa8_Oblivion_RESP1"
msgid ""
"Blessings of the Nine. My name is Tumindil. I'm the chapel priest. I'm sure "
"you can find your way around the chapel by yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00015e10_Oblivion_RESP1"
msgid "Blessings of the Shadow upon ye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081da1_Oblivion_RESP1"
msgid "Blessings upon you Lord.... Bring the Skooma next time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00061ccc_Oblivion_RESP1"
msgid "Blessings, brother."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00061cb7_Oblivion_RESP1"
msgid "Blessings, citizen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00061cca_Oblivion_RESP1"
msgid "Blessings, dark sister."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000238df_Oblivion_RESP1"
msgid ""
"Blessings. I'm Orag gra-Bargol, servant of Stendarr. May you grow in the "
"Faith."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_000617ff_Oblivion_RESP1"
msgid "Bliss is safer with the army's return."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Components_00013571_Oblivion_RESP2"
msgid ""
"Blood Liqueur, Osseous Marrow, Dermis Membrane, and the Essence of Breath. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGWhatIsBloodPrice_0001d4cf_Oblivion_RESP2"
msgid ""
"Blood price is for each person slain. You can pay any of the guild Doyen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001fc4a_Oblivion_RESP3"
msgid ""
"Blood ran blue, and dragons flew high. Under broken towers and broken bodies "
"it now lies, waiting to be found."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00038ee0_Oblivion_RESP1"
msgid "Blood! I need your blood!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Ceremony_00014ac1_Oblivion_RESP1"
msgid ""
"Blood, liquid nutrient, that ocean which casts pearls of life upon the shores "
"of existence...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5a0_Oblivion_RESP1"
msgid "Bloody scamps. I could skin them all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_COERCEHATE_0006232a_Oblivion_RESP1"
msgid "Blow away, windbag."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01FinChoice1A_00023e4b_Oblivion_RESP2"
msgid ""
"Board the ship and find its captain, Gaston Tussaud. He'll be in his cabin. "
"Eliminate Tussaud in any manner you see fit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebc2_Oblivion_RESP1"
msgid ""
"Boethia has opened a portal for you. Consider yourself lucky. You have the "
"chance to die in Boethia's service."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Ceremony_00014ac4_Oblivion_RESP1"
msgid "Bone, branch and stone of the body, giving shape and structure...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkOrcElfConvo_00026e7b_Oblivion_RESP1"
msgid ""
"Bonuses? Ha ha ha ha ha! Useless, I say! Gold and magical trinkets are no "
"substitute for the freedom to slaughter anyone I please, at any time!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00078160_Oblivion_RESP1"
msgid "Books of Bliss has quite a selection."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023fa3_Oblivion_RESP1"
msgid "Books. I sell books. Go ahead. Look. Buy some."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeBoots_00016536_Oblivion_RESP1"
msgid ""
"Boots are useful. Though, sometimes, it's nice to wade barefoot through the "
"blood of your fallen foes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ10BurdSpeech_000463bb_Oblivion_RESP1"
msgid ""
"Bor, Soren, you're with me. The rest of you, stay outside and kill anything "
"that comes out of that Gate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e895_Oblivion_RESP1"
msgid ""
"Borba gra-Uzgash. We've got everything the adventurer needs. I'm an old "
"adventurer myself, and I know what's wanted."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047640_Oblivion_RESP1"
msgid ""
"Borissean. Master Spellmaker for the Mages Guild. Guildsmen, only, of course."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e8dd_Oblivion_RESP1"
msgid ""
"Boss uglies in Cheydinhal are the Orums. Don't mean nothing to you. You is "
"the Outside. Just stay Outside, and everything's Mister Tinker. Got me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DirectionsSleep_0018bd97_Oblivion_RESP1"
msgid "Both inns are next to the west gate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e56_Oblivion_RESP1"
msgid "Both the new Fighters Guild recruits got back alive. It's a good start."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d2ae_Oblivion_RESP4"
msgid ""
"Both vineyards, Tamika's and Surilie Brothers. Vintage 399. Oh, what a good "
"year that was..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062ce3_Oblivion_RESP1"
msgid "Bother me again, and you might live to regret it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002dc2_Oblivion_RESP1"
msgid ""
"Bothiel may know more about this \"Shade of the Revenant\" referred to in the "
"book you've given me. Speak with her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0000080B_AltarESPMain_RESP1"
msgid ""
"Bothiel, from the Arcane University, is looking for someone to chase the "
"bandits from Camp Ales. Probably trying to enhance her weird machine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BloatedFloat_00015713_Oblivion_RESP2"
msgid ""
"Bought it maybe ten years ago when it was decommissioned. Had to gut the "
"whole thing to make room, but kept it seaworthy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0004db91_Oblivion_RESP1"
msgid "Bow before the might of my Lord Jyggalag!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13JyggalagVoice_00095fe7_Oblivion_RESP1"
msgid "Bow before the power of Order!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00086088_Oblivion_RESP1"
msgid "Bow to me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00014d84_AltarDeluxe_RESP2"
msgid ""
"Bow to the will of Mehrunes Dagon and take this puny imperial life to assert "
"your hatred of the Septims."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15RitualReady_00027e44_Oblivion_RESP2"
msgid "Brace yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MundaneAmulet_00038b02_Oblivion_RESP3"
msgid ""
"Bradon told me about this amulet when they first brought it home from "
"whatever distant land it came from."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000919ca_Oblivion_RESP1"
msgid "Bradon... I'll miss you..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5b4_Oblivion_RESP1"
msgid "Brandy and comberry wine. Not a good combination."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033599_Oblivion_RESP1"
msgid "Brash child. Now look what he's gotten himself into."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d281_Oblivion_RESP1"
msgid "Brave deeds, friend. Taking the fight to Oblivion itself! I salute you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_0004890c_Oblivion_RESP3"
msgid ""
"Bravil is an important trade center, and a rich melting pot of Imperial, "
"Khajiit, and Argonian cultures. And, yes, a bit shabby and shopworn."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00048916_Oblivion_RESP1"
msgid ""
"Bravil is perhaps not so nice. But Bravil Castle, and castle gardens, they "
"are jewels, are they not?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00048918_Oblivion_RESP1"
msgid ""
"Bravil perhaps presents little scope for an ambitious member of our guild. "
"Perhaps you may find the castle entertaining. Little else."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00048913_Oblivion_RESP1"
msgid ""
"Bravil? Good points? Cheap to live. Unpretentious. Free-wheeling. Bad points? "
"Culturally, a hole. Count's a clown and his son's a skooma-sucker."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00086099_Oblivion_RESP1"
msgid "Break and fall!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13JyggalagVoice_0009605e_Oblivion_RESP1"
msgid "Break before the March of Order!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000bf1c1_Oblivion_RESP1"
msgid ""
"Break the law on my watch, will ya? I'll be confiscating your stolen goods. "
"Oh, and no gold to pay your fine, hmm? It's off to the lockup then!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00086092_Oblivion_RESP1"
msgid "Break! Bleed!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006dc21_Oblivion_RESP1"
msgid ""
"Break-in at the Imperial Palace! A Black Horse Courier exclusive. Take a copy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGWhatIsBloodPrice_0001d4cf_Oblivion_RESP1"
msgid ""
"Breaking any of the three rules means expulsion from the Thieves Guild. If "
"you commit murder, you must pay the blood price to rejoin the guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Ceremony_00014ac7_Oblivion_RESP1"
msgid "Breath, child of air, bestowing movement, the stirring of spirit...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEBrellachTopic_0008f04c_Oblivion_RESP1"
msgid "Brellach is our stronghold. It is our place of refuge in this Realm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008f525_Oblivion_RESP1"
msgid "Brellach is ours!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEBrellachInfo_0001e970_Oblivion_RESP1"
msgid ""
"Brellach was given to us by our Lord Sheogorath as a sanctuary and place of "
"restoration."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008f524_Oblivion_RESP1"
msgid "Brellach will be cleansed!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45BrethrenTopic_00028216_Oblivion_RESP1"
msgid "Brethren?  I got no brothers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VampireTopic_0001da5e_Oblivion_RESP4"
msgid ""
"Bring back the vampire dust from their remains. That should be proof enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03GrommokC3Idle01_0008ea87_Oblivion_RESP1"
msgid "Bring it on... I'm ready."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG05AChoice1A_00028c07_Oblivion_RESP5"
msgid ""
"Bring it to me once you have it. I'll even still give you the reward I "
"promised, despite your incompetence. Now go!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018b18d_Oblivion_RESP2"
msgid ""
"Bring me 20 bear pelts, as proof that you have helped tear nature asunder. "
"Then we shall speak of spells and teaching."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Components_00013572_Oblivion_RESP1"
msgid ""
"Bring me Blood Liqueur, Osseous Marrow, Dermis Membrane, and the Essence of "
"Breath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JskarTopic_00031039_Oblivion_RESP1"
msgid ""
"Bring me Jeanne's Manual of Spellcraft, and then we'll talk about helping you "
"find J'skar."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ02Skooma_00189180_Oblivion_RESP5"
msgid ""
"Bring me Lonavo's ring as proof he's... been dealt with... and I'll give you "
"the bounty on him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE01GateSpeech_0005a761_Oblivion_RESP1"
msgid ""
"Bring me a champion! Rend the flesh of my foes! A mortal champion to wade "
"through the entrails of my enemies!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30Matrices_0001e697_Oblivion_RESP3"
msgid ""
"Bring me a matrix and enough Ore, and I will forge you a new item and bleed "
"the magic of the matrix into it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE41Yes_0006ea4c_Oblivion_RESP3"
msgid ""
"Bring me back the remedy, and I will reward you well. Here, take this special "
"flask to collect the aquanostrum."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CureforVampirism_00053741_Oblivion_RESP1"
msgid "Bring me the Soul Gems I've asked for, and then we'll discuss a cure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAHircineSpeech_00051edf_Oblivion_RESP1"
msgid "Bring me this creature's horn, mortal. If you dare."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00026baa_Oblivion_RESP1"
msgid "Bring my salutations to Julienne. Safe journey to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001ce04_Oblivion_RESP1"
msgid "Bring that book immediately to Thoronir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAClavicusSpeech_000243bb_Oblivion_RESP1"
msgid ""
"Bring the sword to me, and I'll reward you with my Masque. You'll not find a "
"better bargain, mortal. Begin your search in Pell's Gate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE44Supplies_0007876e_Oblivion_RESP3"
msgid ""
"Bring these to me, and I will reward you well. Ahjazda has many, many things."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraSpeech_0005dc96_Oblivion_RESP1"
msgid ""
"Bringer of Light, bless these wretches that they may see the path to your "
"glory."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003dfcf_Oblivion_RESP1"
msgid ""
"Brodras has been teaching Fighters Guild members how to better use heavy "
"armor. Odd for a Bosmer, but he's apparently good at it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000477f4_Oblivion_RESP1"
msgid ""
"Brodras of the Fighters Guild. I don't do contracts much. Mostly I'm a "
"trainer. Heavy Armor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488c2_Oblivion_RESP1"
msgid ""
"Brokil gro-Shatur, Lord High Warden of the Taps, Gilgondorin's most prized "
"customer. I taste everything. Over and over. And over again..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c9c0_Oblivion_RESP1"
msgid "Brotch Calus, Alchemist. Advanced Training, available by appointment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000982d2_Oblivion_RESP1"
msgid "Brother Hjar, we must clean the chapel soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000982df_Oblivion_RESP1"
msgid ""
"Brother Holger, we need to prepare for the ritual of purity by the next full "
"moon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000982ce_Oblivion_RESP1"
msgid "Brother Hridi, your homily was most inspiring."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JauffreTopic_000299cb_Oblivion_RESP1"
msgid "Brother Jauffre? He should be in the Priory House, I think."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MartinTopic_000699f7_Oblivion_RESP1"
msgid ""
"Brother Martin? Yes, he's right over there. He led a group of us here during "
"the confusion of the attack. We owe him our lives."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrotherPinerTopic_000247e9_Oblivion_RESP1"
msgid ""
"Brother Piner is a fine young monk, zealous and energetic. In time, I hope he "
"may add patience and prudence to his list of virtues."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeynonPrioryTopic_000247ea_Oblivion_RESP2"
msgid "Brother Piner, Father Jauffre, and I are members of the Order of Talos."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003402a_Oblivion_RESP1"
msgid "Brother, if I may have a word."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00084b42_Oblivion_RESP1"
msgid "Brother? Wow... hope he's got a wine cellar!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS11CommandWord_0006c2a7_Oblivion_RESP1"
msgid "Brotherhood."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05RavenSpeech_00022ef3_Oblivion_RESP1"
msgid "Brothers, kill this pretender!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugoTopic1Tell_00090b70_Oblivion_RESP1"
msgid ""
"Brugo's a jerk. He's got a hideout in a ruin called Telepe. Every night, "
"between midnight and six AM, he stops there to pick up his take."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_000270ec_Oblivion_RESP1"
msgid ""
"Bruma cannot hold off the hordes of Oblivion alone. You should ask the rulers "
"of the other cities of Cyrodiil to send help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ00BrumaResponse_00062bf3_Oblivion_RESP1"
msgid ""
"Bruma certainly was fortunate to have Martin and his champion on the "
"battlefield that day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bab2_Oblivion_RESP1"
msgid ""
"Bruma has been saved! It's true! Let's see how the Daedra do without their "
"big Siege Machine, or their so-called \"Great Gate\"! Ha ha ha ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c9b1_Oblivion_RESP1"
msgid ""
"Bruma is a perfect town for a Nord man of leisure. Bracing mountain air, good "
"food and drink, and lively Nord fellowship."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006249d_Oblivion_RESP1"
msgid ""
"Bruma is not a fit place to live, but no one can fault Countess Bruma on the "
"quality of her guard or defenses."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HorseInquiry_000545d1_Oblivion_RESP1"
msgid ""
"Bruma's Paint horses are the toughest in Cyrodiil. You can only buy them from "
"me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c9ad_Oblivion_RESP1"
msgid ""
"Bruma's a funny place... half Cyrodiil and half Skyrim. I'm old Nord all the "
"way. I keep the old songs and stories alive."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003dfad_Oblivion_RESP1"
msgid ""
"Bugak gro-Bol has some good books at Southern Books. He's an odd one, though. "
"Always seems ready for a fight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003dfb8_Oblivion_RESP1"
msgid ""
"Bugok gro-Bol always seems ready for a fight. Seems odd for a bookseller."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026aac_Oblivion_RESP1"
msgid ""
"Bugs. Bugs! Everywhere. All over. Wonderful, tasty bugs. No time for you. "
"Talk to Ravel. He doesn't like the bugs. Not even with mead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081d97_Oblivion_RESP1"
msgid ""
"Buh-bye! Nice talking with you, Lord. No need to come back any time soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003cf96_Oblivion_RESP1"
msgid ""
"Buildings here look different. Why? This is the Gold Coast style, like in "
"Hammerfell. Eastern towns look grey and dull to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000465e9_Oblivion_RESP1"
msgid ""
"Bumph gra-Gash is very skilled in heavy armor use. I wouldn't want to get on "
"her bad side."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13Speech_00027787_Oblivion_RESP1"
msgid "Burd! Deploy the troops for battle!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_DEM02DarkElfMaleVoice_00003104_AltarDeluxe_RESP1"
msgid "Burn him! Light the pyre!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraSpeech_00084aac_Oblivion_RESP1"
msgid "Burns...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008609b_Oblivion_RESP1"
msgid "Burst, bloodsack!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0018d2fc_Oblivion_RESP1"
msgid ""
"Business is bad with that damn Oblivion Gate outside of town. You think "
"things can't get any worse, and then they do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434d5_Oblivion_RESP1"
msgid ""
"Business isn't going to be the same, now that anyone can just wander into the "
"Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03ElvenBust_00009189_Oblivion_RESP1"
msgid "Bust? What bust? I didn't overhear any conversation about a bust."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00070400_Oblivion_RESP1"
msgid "Busy day today, isn't it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_000241bb_Oblivion_RESP1"
msgid "Busy today?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkOrcElfConvo_00026e7a_Oblivion_RESP1"
msgid ""
"But Brother, what of the contracts that require subtlety! You must at least "
"strive to earn the bonuses that are offered?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate1_00013a5a_Oblivion_RESP1"
msgid "But I AM innocent. I've done nothing!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06GSWardenGreet2_00018db8_Oblivion_RESP2"
msgid ""
"But I am honor-bound to guard the doors of Cylarne, and so I will stay my "
"hand. For now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06NoGive_0001f169_Oblivion_RESP2"
msgid ""
"But I am sure you will reconsider. You have proven yourself worthy and "
"dedicated to have come this far."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MysteriumXarxes_000221f6_Oblivion_RESP4"
msgid ""
"But I believe it can be done. I will continue working to decipher the arcane "
"items needed for the binding ritual."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG11ChoiceHeretohelp_00033634_Oblivion_RESP3"
msgid ""
"But I do appreciate the sentiment. If there's anything specific you need, "
"that may be more reasonable then just asking me about Necromancers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22MaricHighFane_0002b09c_Oblivion_RESP2"
msgid ""
"But I do not advise you to go there. Read \"The Cleansing of the Fane\" "
"first. Then decide. As I said, a very bad place."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04ChaliceNo_00013309_Oblivion_RESP4"
msgid ""
"But I don't have it. So I can't eat Felldew, because that would just be bad. "
"I mean, really bad. Damn her!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017973_Oblivion_RESP3"
msgid ""
"But I fear that our work is not yet done. The area is still overrun with "
"Knights that were not destroyed in the spire. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006bed7_Oblivion_RESP3"
msgid ""
"But I never doubted you, my friend. Emperor Uriel, he had the vision of the "
"Dragonborn. He saw something in you. And he was right."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_000270f0_Oblivion_RESP2"
msgid ""
"But I still fear that Bruma will fall before you can complete the ritual. You "
"need to buy Martin more time. Bruma needs more help!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MartinB_0008b619_Oblivion_RESP3"
msgid ""
"But I will need time. Tampering with dark secrets, even just reading them, "
"can be very dangerous. I'll have to proceed carefully."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40MelisandeIhavethem_0005373b_Oblivion_RESP4"
msgid ""
"But I'll also need the blood of an Argonian, and the ashes of a powerful "
"vampire. Those may be... more difficult for you to acquire."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KvatchTopic_0002d775_Oblivion_RESP3"
msgid "But I'll be here. This is my town. Nothing is driving me out of here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479c8_Oblivion_RESP4"
msgid ""
"But I'm a smart, law-abiding evil wizard, because I only blow up my own stuff."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40MelisandeRumor_0003f290_Oblivion_RESP3"
msgid ""
"But I'm afraid the information isn't free. You do me a small favor, and then "
"we'll talk about this cure you seek."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028bf1_Oblivion_RESP3"
msgid ""
"But I'm afraid your little game is over now. I've killed more assassins in my "
"day than I can count. So let's get this over with!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06MaikiChoiceA_00012cbe_Oblivion_RESP2"
msgid "But I'm convinced the Mazken don't expect us to come that way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03LexMyvryna_000355d3_Oblivion_RESP1"
msgid ""
"But I've been loyal to you! I've reported everything that Armand has done. "
"You can't just toss me aside like a soiled cloth!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000224f6_Oblivion_RESP6"
msgid ""
"But I've kept you long enough. Vicente is waiting. You'll find him in his "
"quarters. Go now, my child, and may Sithis go with you. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036645_Oblivion_RESP3"
msgid ""
"But Sancre Tor became evil long ago. No one has returned from the Shrine of "
"Tiber Septim for many lifetimes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ09ArmorTopic_000c4315_Oblivion_RESP3"
msgid ""
"But Sancre Tor became evil long ago. No one has returned from the Shrine of "
"Tiber Septim for many lifetimes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MartinTopic_00092a70_Oblivion_RESP2"
msgid ""
"But Savlian Matius might know more. He's in charge of the city guard that are "
"defending the camp."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23MemCave_0001da6d_Oblivion_RESP3"
msgid ""
"But Seridur is a stubborn one. Hehe. Takes integrity for a man to risk his "
"own life to honor the fallen. I admire him for that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40MelisandeWitch_0003f291_Oblivion_RESP3"
msgid ""
"But a cure for vampirism... That's something I haven't thought about in quite "
"some time. Very challenging, and potentially dangerous."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EyjaTopic_000b97e5_Oblivion_RESP5"
msgid ""
"But all that's different now. I'm glad to be serving you instead. I can see "
"we will get along just fine!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02JauffreD1_00092d85_Oblivion_RESP3"
msgid ""
"But all the scholars agree that the mortal world is protected from the daedra "
"of Oblivion by magical barriers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000224f5_Oblivion_RESP4"
msgid ""
"But before you go, please accept this gift from your new family. A unique set "
"of armor, lighter than normal leather and black as the Void."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000224f6_Oblivion_RESP5"
msgid ""
"But before you go, please accept this gift from your new family. A unique set "
"of armor, lighter than normal leather and black as the Void."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GatherClues_000038c9_Oblivion_RESP2"
msgid ""
"But confidentially, I will say that Orgnolf has been acting a bit unusal. His "
"abuse of drink has gotten worse lately."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05RavenSpeech_00022da8_Oblivion_RESP1"
msgid ""
"But do you have the wit and strength to use the key that you have been given? "
"If so, I will see you next at Dagon's Shrine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQLastItem_00026ef6_Oblivion_RESP3"
msgid "But don't worry. I will solve it. I must. I am close, I'm sure of it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033347_Oblivion_RESP1"
msgid ""
"But don't worry. The guards always treat the pretty ones nice. Right 'til the "
"end. Oh, that's right. You're going to die in here, Nord!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001efe0_Oblivion_RESP2"
msgid "But everyone expects me to suddenly know what to do. How to behave."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AyleidReference_00033539_Oblivion_RESP2"
msgid ""
"But fine. If he wants it, he can have it. It's just one more thing I'll get "
"blamed for in the end."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0000bcae_Oblivion_RESP2"
msgid ""
"But first I guess you have to find him, right? The Elven races of the "
"Imperial City are a community unto themselves. Ask them about Faelian."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002aef8_Oblivion_RESP2"
msgid "But first, of course: you must hand over the carving."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002908_Knights_RESP2"
msgid ""
"But for the first time, it seems that someone may succeed where we have "
"failed. I see in you the chance to redeem our souls and restore the order. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQJauffreHelp_0005e160_Oblivion_RESP2"
msgid ""
"But go ahead and take this hammer. You might have use of it, and I have "
"others. Not much call for smith-work around here in any case."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LucienLachanceTopic_00091219_Oblivion_RESP2"
msgid ""
"But he is certainly in a better place now. Lucien Lachance's soul now serves "
"Sithis in the Void. It is an honor he earned, and deserves."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001647b_Oblivion_RESP5"
msgid ""
"But here you are instead. Skilled enough to make it this far, which speaks "
"volumes about you. Perhaps you'll be as useful to me as Traven would."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ16MartinB_0004bfbd_Oblivion_RESP2"
msgid ""
"But how to use this power against Dagon? The Amulet was not intended as a "
"weapon... "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MankarRant_0008c23f_Oblivion_RESP10"
msgid "But if a god can die, how does his heart survive?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00043cd1_Oblivion_RESP3"
msgid ""
"But if you can get that gate near the bridge open, we can bypass their traps "
"and meet them blade-to-blade!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEChaliceofReversal_00018b7b_Oblivion_RESP2"
msgid ""
"But if you insist... Do you know the lengths of his depravity? How low he "
"stoops to pursue his pathetic lifestyle?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d14e_Oblivion_RESP2"
msgid ""
"But if you're dead set on it, head to The Best Defense in the Imperial City. "
"He's a smith there, and might be persuaded to train you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture5_0007195e_Oblivion_RESP1"
msgid ""
"But imagine, as the emperors grew weak, and as the power and glory of the "
"Empire waned, and as the people fell away from their service to the gods..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_000476b9_Oblivion_RESP2"
msgid ""
"But in the water, we are the masters, and whiteskins pay well for our skills."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGEmperor15_0003247f_Oblivion_RESP2"
msgid ""
"But in your face, I behold the sun's companion. The dawn of Akatosh's bright "
"glory may banish the coming darkness."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10WhatHappened_0001746f_Oblivion_RESP3"
msgid ""
"But it doesn't matter anymore. The only thing that matters now is the "
"Wellspring. We must reach it at once!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10WhatHappened_00017d16_Oblivion_RESP3"
msgid ""
"But it doesn't matter anymore. The only thing that matters now is the "
"Wellspring. We must reach it at once!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07ProgressPlans_00020085_Oblivion_RESP2"
msgid ""
"But it is clear that Mankar Camoran will soon bring all his power to bear "
"against Bruma. I will warn the Countess of the danger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45ForkTopic_00078789_Oblivion_RESP2"
msgid ""
"But it is gone. Gone, gone, gone. No more singing. No more ringing. Taken "
"from Big-Head, never returned."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MartinD_00037831_Oblivion_RESP2"
msgid ""
"But it is one thing to talk of becoming Emperor, and quite another to "
"actually be the Emperor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07Spies_00020077_Oblivion_RESP2"
msgid ""
"But it seems that you have been given the freedom to attack the enemy that we "
"all crave! Good luck. We will keep the Emperor safe here, don't worry."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE40SleepOutsideChoice1b_000790bc_Oblivion_RESP2"
msgid ""
"But it's not at the bottom of a tall wall. So that means I can sleep without "
"waking up under a pile of rubble, or worse - waking up dead!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13BattlePlans_000276a9_Oblivion_RESP4"
msgid ""
"But it's our only hope to get the Great Sigil Stone we need to complete the "
"ritual. You'll have to act swiftly when the Great Gate opens."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007b7f6_Oblivion_RESP2"
msgid ""
"But it's over. Thank Akatosh, the Oblivion Invasion is over, and we've "
"survived!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE34ExplainMore_0008f7b8_Oblivion_RESP3"
msgid ""
"But most importantly, I've met the woman of my dreams. If I had to leave Zoe, "
"I think I'd be the loneliest man alive."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06SheoIntro3_00082464_Oblivion_RESP3"
msgid "But mostly because I asked nicely."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalSpeech_00084a4b_Oblivion_RESP1"
msgid ""
"But my Eye is blind and drowned, stolen from its shrine, and hid in dark "
"waters."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00041f18_Oblivion_RESP3"
msgid ""
"But my message is actually one of comfort. The world is ending, and we can't "
"do anything about it. Once you accept that, you'll be at peace, like me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000276a4_Oblivion_RESP2"
msgid ""
"But my militia is no substitute for trained soldiers. Can we not wait for "
"more help to arrive?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27UmbacanoC2_000a6584_Oblivion_RESP2"
msgid ""
"But no matter! This is clearly authentic Ayleid workmanship. Later ages have "
"never seen the like."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12TraitorTaunts_00081ae1_Oblivion_RESP1"
msgid "But no more. No more!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12TraitorTaunts_0008f7c9_Oblivion_RESP1"
msgid "But no more. No more!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GreatWelkyndStoneTopic_00027100_Oblivion_RESP3"
msgid ""
"But no one has ever done more than glimpse it from a distance. It is said to "
"be guarded by the ghost of the last king of Miscarcand."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ09ArmorTopic_00026d5f_Oblivion_RESP5"
msgid ""
"But no one has visited the shrine and lived to tell the tale in centuries."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e11f_Oblivion_RESP4"
msgid "But now I must go. The Dragon waits."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_00028c33_Oblivion_RESP2"
msgid "But now I'm old, and my instincts have failed. I let that woman down."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE35Brithaur_00078662_Oblivion_RESP1"
msgid ""
"But now he's become a genuine troublemaker, eh? That's my speciality. Don't "
"worry, it will be handled."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ16OcatoE_000add1e_Oblivion_RESP4"
msgid ""
"But now is not the time to worry about the future. Let's just give thanks "
"that we're alive."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDCrusadersRelicsTopic_00002a83_Knights_RESP11"
msgid ""
"But now the time has come for a new Divine Crusader to arise, wielding the "
"holy Relics, to destroy Umaril Godsbane once and for all. I have seen it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilB2_0003fbe1_Oblivion_RESP3"
msgid ""
"But now you are here. Perhaps you can kill Mankar Camoran. Save Tamriel from "
"Dagon's final victory."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ09Scales_00066f2c_Oblivion_RESP3"
msgid ""
"But now, I can't get out there to the lake -- not with this leg. I only "
"needed twelve more scales! Can you believe it? I was so close!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000566f_Oblivion_RESP4"
msgid ""
"But now, we can begin anew! I bestow upon you the title of Speaker. You will "
"take Lucien Lachance's place on the Black Hand! Welcome!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ12MartinB_000270ff_Oblivion_RESP4"
msgid ""
"But of course its beauty is a mask for its deadly power, like everything "
"crafted by the Ayleids."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk1_0006a85a_Oblivion_RESP1"
msgid "But of course. What troubles you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e89e_Oblivion_RESP6"
msgid ""
"But on the whole, I like Cheydinhal's Dark Elves better than I like the "
"Imperials, so go figure...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS39Seen_0004ed74_Oblivion_RESP4"
msgid ""
"But one of the moldy pages contained the recipe for a potion known as an "
"Elixir of Exploration, a sort of \"ultimate dungeon delver's\" brew."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Nirnroot_0004e977_Oblivion_RESP4"
msgid ""
"But one of the moldy pages contained the recipe for a potion known as an "
"Elixir of Exploration, a sort of \"ultimate dungeon delver's\" brew."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ08Wine_0018d92d_Oblivion_RESP2"
msgid ""
"But one vintage continues to elude me; Shadowbanish Wine. How I'd love to add "
"it to my collection."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09VictimChoice2b_00082092_Oblivion_RESP2"
msgid ""
"But only if you can prove to me the sincerity of your position, and the depth "
"of your conviction. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15SavageGarden_00047365_Oblivion_RESP5"
msgid ""
"But our life here is a nightmare. The creatures of the Garden torment us "
"endlessly. When they kill us, we are soon reborn and the cycle begins again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36Choice6HowDie_00061c4e_Oblivion_RESP3"
msgid "But remember, I don't want to see it coming. Take me unaware!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS51AccuseChoice1_0003151f_Oblivion_RESP3"
msgid ""
"But she is never to set foot in Chorrol again. Congratulations on a job well "
"done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS51AccuseChoice1_00031510_Oblivion_RESP3"
msgid ""
"But she is never to set foot in Chorrol again. I am a bit dismayed that you "
"incorrectly accused Orgnolf, who was clearly innocent."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00058e08_Oblivion_RESP2"
msgid "But so few ... surely the other cities will send help?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaTopic_00146851_Oblivion_RESP3"
msgid ""
"But stay away from Ysabel, the Battle Matron. She doesn't deal with "
"combatants, unless they want to challenge the Grand Champion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081c50_Oblivion_RESP2"
msgid ""
"But that feeling only lasts a little while. Then I start thinking about how "
"miserable everything is, and then all I want to do is step off the ledge."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06CurseTopic_00002b1f_Knights_RESP2"
msgid ""
"But that means taking the curse on yourself. You'll be marked for life, as "
"will all your children and your children's children."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElderCouncilTopic_000adc6a_Oblivion_RESP3"
msgid ""
"But the Blades answer only to the Emperor, of course. We are not an arm of "
"the government."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026ea8_Oblivion_RESP2"
msgid ""
"But the Bruma Guard cannot defend the city indefinitely. The daedra of "
"Oblivion are innumerable; the guardsmen of Bruma are not."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateTopic_0008571a_Oblivion_RESP7"
msgid ""
"But the Dragonfires can only be relit by an heir of the Septim blood wielding "
"the Amulet of Kings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusH_0001e90d_Oblivion_RESP3"
msgid "But the Emperor trusted you for a reason, and I trust the Emperor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElderCouncilTopic_000add0b_Oblivion_RESP3"
msgid ""
"But the Inner Council still holds regular meetings. We have the situation "
"well in hand, I assure you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDCrusadersRelicsTopic_00002a7f_Knights_RESP2"
msgid ""
"But the Prophet says that the time has come for them to finally be recovered, "
"lest the faithful be scattered and destroyed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_000add08_Oblivion_RESP2"
msgid "But the circumstances are not normal, are they?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Gardens_00013570_Oblivion_RESP2"
msgid ""
"But the fruits born of that labor were the essential components of true Flesh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02JauffreD2_00092d86_Oblivion_RESP3"
msgid ""
"But the mortal world is protected from the daedra of Oblivion by magical "
"barriers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS12PaleNo_00018236_Oblivion_RESP6"
msgid ""
"But their greatest error was marching through Morrowind on the way to their "
"objective and dismissing the response it would garner from Vivec."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GatherClues_00033954_Oblivion_RESP2"
msgid ""
"But then again, I stayed in my quarters most of the night. There was no point "
"in going on my usual walk with all of the rain falling."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37Response_000452e0_Oblivion_RESP1"
msgid ""
"But then who will run around the town? I need to keep retracing the circle or "
"it will break."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HaderusGoldwineTopic_0002ad7e_Oblivion_RESP3"
msgid ""
"But then, things got confused. Even the Legion troops stationed here couldn't "
"hold the defenses."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ04Conv_00037c39_Oblivion_RESP1"
msgid "But there is yet hope. Here is Martin Septim, true son of Uriel Septim!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27LastAyleidKing_000a6576_Oblivion_RESP2"
msgid ""
"But there never was a single King of the Ayleids. Each city-state had its "
"king, and their power waxed and waned over the years."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilC2_0003fbe0_Oblivion_RESP5"
msgid ""
"But they fought on anyway. Desperately. They seemed to think this decadent, "
"mundane world of theirs was worth defending."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05SylWho_000139b3_Oblivion_RESP2"
msgid ""
"But they'll never take me down. Never! I'll see them all rotting in shallow "
"graves before I let my guard down!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22SrazirrNegotiate_0002c527_Oblivion_RESP1"
msgid ""
"But this one is taking all of the risk! What do you have to lose? One fourth, "
"that's S'razirr's final offer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElderCouncilTopic_000add0c_Oblivion_RESP2"
msgid ""
"But to be honest, I don't know what will happen. The provinces have been "
"restive for years, even before the latest crisis."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05GwinasB4_0009532b_Oblivion_RESP4"
msgid "But to murder the Emperor... Mara preserve us!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46Goblins_000319d1_Oblivion_RESP4"
msgid ""
"But two tribes are at war, and their war parties are crossing right through "
"Cropsford. What you'll need to do is stop the war somehow."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a902_Oblivion_RESP3"
msgid ""
"But wait, I'm sorry. I'm being selfish. You're a Champion, and have the right "
"to challenge me for my Grand Champion title. Is that your wish?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetB3_00002b82_Knights_RESP4"
msgid ""
"But we also found a terrible guardian -- the wraith of Lord Vlindrel -- Sir "
"Berich."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MartinB1_00027102_Oblivion_RESP4"
msgid ""
"But we have no choice. The only way to recover the Amulet of Kings is to "
"allow the Mythic Dawn to proceed with their plan to attack Bruma."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07ProgressAllDead_00020081_Oblivion_RESP2"
msgid ""
"But we have not eliminated the threat against Bruma and Cloud Ruler Temple, "
"only delayed it. I will warn the Countess of the danger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JeanneFrasoricTopic_0001cef5_Oblivion_RESP4"
msgid "But we have our ways of coping with the situation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateTopic_00085712_Oblivion_RESP7"
msgid ""
"But we must hurry! The barriers between our world and Oblivion weaken with "
"every Gate that is opened."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d7ed_Oblivion_RESP2"
msgid ""
"But we need to act quickly. Camoran will not take long to recognize his "
"danger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeersStone_00033792_Oblivion_RESP2"
msgid ""
"But we never said anything about Dagail's father. How would he know anything "
"about that?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025df0_Oblivion_RESP1"
msgid "But we will cross paths again before the end, I am sure of it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06HelpDefendA2_000131b8_Oblivion_RESP2"
msgid ""
"But we'll teach her to try to take the Mazken by surprise! We'll cut them to "
"pieces in those corridors! I'll redeploy my forces at once."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11TheLightTopic_0008f12d_Oblivion_RESP3"
msgid ""
"But what does she do? She sits in her chamber and dreams of revenge against "
"Sheogorath! She is a liar and has stolen our lives."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalConvo1_00026aba_Oblivion_RESP1"
msgid "But what if a fisherman uses the cave?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalConvo1_000878d8_Oblivion_RESP1"
msgid "But what if a fisherman uses the cave?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalConvo1_00026ad5_Oblivion_RESP1"
msgid "But what if the trolls eat it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalConvo1_000878dc_Oblivion_RESP1"
msgid "But what if the trolls eat it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalConvo2_00084a3d_Oblivion_RESP1"
msgid "But what if the trolls eat it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27HerminiaD2_000a5606_Oblivion_RESP2"
msgid "But what if... what if you brought him another Ayleid Crown?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14TivelaHeard_0001c1c5_Oblivion_RESP3"
msgid ""
"But when he didn't come out for a full day, I unlocked the studio with the "
"key he said to use only in emergencies. It turned out he wasn't inside!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00018c6b_Oblivion_RESP2"
msgid ""
"But where are my manners? Ahem... must get into my professional tone... "
"ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022489_Oblivion_RESP2"
msgid ""
"But where is Rallus? I don't see him...  oh, please tell me I haven't lost "
"one of my sons."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048360_Oblivion_RESP1"
msgid ""
"But who, you might ask, could possibly be brave enough to face such a "
"fearless foe? Who could wrest the title from our famed Gray Prince?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000af05b_Oblivion_RESP2"
msgid ""
"But why am I telling you? You were there. You saw... him. Sometimes I wonder "
"if I'll ever be able to sleep again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS04SayNo_0003d4b1_Oblivion_RESP2"
msgid ""
"But why say no, when it's so much easier, and more lucrative, to say yes? Or "
"are you here for something else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkOrcElfConvo_00026e75_Oblivion_RESP1"
msgid ""
"But why, Sister? What is the point? Why should anyone bother with all that "
"sneaking and skulking?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000252cb_Oblivion_RESP1"
msgid ""
"But why, Sister? Why must I use stealth? Sneaking around in the shadows is so "
"very... slow.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00026e9b_Oblivion_RESP2"
msgid ""
"But with an Oblivion Gate threatening Bravil, I need all my soldiers here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ff09_Oblivion_RESP2"
msgid ""
"But you can be sure Adamus Phillida will suspect the Dark Brotherhood was "
"involved, and will launch an investigation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003489e_Oblivion_RESP2"
msgid ""
"But you can be sure Adamus Phillida will suspect the Dark Brotherhood was "
"involved, and will launch an investigation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND09ProphetGreeting03_00002c11_Knights_RESP4"
msgid ""
"But you can do what Pelinal could not. The Blessing of Talos will allow you "
"to follow Umaril's spirit when it leaves his body."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15KathutetC6_0003e8fd_Oblivion_RESP2"
msgid ""
"But you have courage, at least. To slay a bold animal like you is not without "
"glory."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007ac76_Oblivion_RESP2"
msgid ""
"But you look tired. Carrying all that gear will do that to you. I'd be glad "
"to shoulder some of the burden... relieve you of that expensive stuff."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE11RakheranGreeting3b1_00019fce_Oblivion_RESP2"
msgid ""
"But you must be discreet. Do not remove the robes, or you will be attacked. "
"Even I will have to kill you, so I do not draw more suspicion to myself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0018d2a2_Oblivion_RESP2"
msgid ""
"But you must hurry! I'm afraid of what might happen if the daedra are able to "
"get a foothold here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003b1da_Oblivion_RESP2"
msgid ""
"But you need Agronak's Raiment! That's right, just go back to the Arena and "
"take it right from his body! Go get it, and bring it back to me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkGiftTopic_0004cf46_Oblivion_RESP5"
msgid ""
"But you need not worry about that now. Maybe in a few centuries, hmm? Just "
"remember, blood is your salvation! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15KathutetB4_0003e8f4_Oblivion_RESP3"
msgid ""
"But you shamed my kin at Ganonah. To bring you into my service... that would "
"also bring me honor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10SheoJyggalag3_00091400_Oblivion_RESP2"
msgid ""
"But you're still going to stop the Greymarch. Stop Jyggalag... Me... from "
"destroying My Realm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_bed_000bb9bc_Oblivion_RESP1"
msgid "But you've already rented a room for the night."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e703_Oblivion_RESP2"
msgid ""
"But you, you seem so pleasant! And dressed so well! You must have a very full "
"purse. Very full indeed. You are a very fortunate soul."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_000239e0_Oblivion_RESP4"
msgid ""
"But, I wonder, was he really trying to be a fool? Or was something wrong?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDCrusadersRelicsTopic_00002a80_Knights_RESP7"
msgid ""
"But, alas for Tamriel, the Crusader's Relics have been lost for many an age."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFlameofAgnonTopic_00019ad0_Oblivion_RESP3"
msgid ""
"But, alas, the times are not normal, and Sheogorath has given you this task, "
"without the authority to command it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11StaffOfSheogorath_00016ef5_Oblivion_RESP2"
msgid ""
"But, apotheosis is no simple matter and the creation of the staff is no "
"simple task. I will require two sacred items in order to complete it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479f4_Oblivion_RESP4"
msgid ""
"But, as I was going to say, welcome to Five Riders Stable. Five? Riders? I "
"don't see them, either..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15KathutetD_0003e8fe_Oblivion_RESP2"
msgid ""
"But, being no true immortals, they are without honor or courage, and shy from "
"battle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEChaliceofReversal_00013385_Oblivion_RESP2"
msgid "But, didn't he mention where it is?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06SheoIntro2_00082463_Oblivion_RESP2"
msgid ""
"But, for all intents and purposes, you'll be Me. A Me to fight the Him. Since "
"I won't be around. It's simple, really. If you don't think about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47NeedAntidote_0003003f_Oblivion_RESP2"
msgid ""
"But, if it will get everyone to leave me alone, fine. I did work out a "
"counter-spell last week... if I can just put my hand to it... ah!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07GreymarchTopic_00091016_Oblivion_RESP3"
msgid ""
"But, if we can get you into shape, we might stand a chance. You'll lead My "
"forces, inspire My people! Hopefully, everyone won't end up dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07GreymarchTopic_00091273_Oblivion_RESP3"
msgid ""
"But, if we can get you into shape, we might stand a chance. You'll lead my "
"forces, inspire my people! Hopefully, everyone won't end up dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46OtherOptions_0000ab73_Oblivion_RESP3"
msgid ""
"But, kill the shaman and the tribe will dissolve into confusion. Most likely "
"end the war."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001b6a6_Oblivion_RESP2"
msgid ""
"But, perhaps now's not the time. You've made it this far. Farther than anyone "
"else. Well done!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReynaldJemaneTopic_00023e83_Oblivion_RESP4"
msgid ""
"But, please -- come and see us in Chorrol. It would be wonderful for us both "
"to be able to thank you for helping us find each other again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD03Choice2_0002d724_Oblivion_RESP1"
msgid ""
"But, she's the Guildmaster. Certainly, she'd.... No. You're right. If the "
"order came from Oreyn, it's a valid one. We should be off immediately."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48Convo_00024836_Oblivion_RESP1"
msgid "But, sir! I want to help fight!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Displeased_0001365c_Oblivion_RESP2"
msgid ""
"But, sometimes you need to break a few eggs. Or skulls. There are rules, "
"though. Even in the Isles. Rituals and rules. You need to follow them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11RakheranGreeting2b_00019fc9_Oblivion_RESP2"
msgid ""
"But, there are those of us here who want her gone as well, yes. Those of us "
"who think that maybe we could lead better then she does."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07SheoIntro2_00082468_Oblivion_RESP3"
msgid ""
"But, this is all new! A fresh idea! Something I hadn't thought of, until I "
"did. It's sure to work, even though it might not."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AThadonLeaves_000206c5_Oblivion_RESP1"
msgid ""
"But, this... stranger? Someone new? From somewhere else? Not here. I'm sure "
"of that. I don't understand. Or I can't."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGC07Choice5_00009215_Oblivion_RESP1"
msgid ""
"But, where are they? Please, bring me the sword and armor. The debtors aren't "
"giving me much time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMolagBalSpeech_0003780d_Oblivion_RESP1"
msgid ""
"But, you'll still get your prize, won't you? I think it was worth it... don't "
"you? Keep up the good work, little mortal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11TalkToMillona04_00022e7f_Oblivion_RESP1"
msgid "But..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06CurseTopic_00002b20_Knights_RESP2"
msgid ""
"But... But if it is the will of the Nine, then there is little that can be "
"done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity4_00079f52_Oblivion_RESP3"
msgid ""
"But... I already have... or had.... How odd. It seems to be missing. I'm "
"sorry I don't have the funds to purchase it from you. Again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MazogatheOrcTopic_00086070_Oblivion_RESP3"
msgid ""
"But... I never learned anything by being smart. And you seem to be a right "
"skipper."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDKellenTopic_00002b04_Knights_RESP2"
msgid "But... That means that now you've cursed yourself!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThadonTopic_0001338a_Oblivion_RESP4"
msgid ""
"But... You don't need to hear that. You need to know. You need to know what "
"he's asked of you. The Chalice, yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08Choice6B_00085a65_Oblivion_RESP1"
msgid ""
"But... but I thought you were my friend? How could you say such a horrible "
"thing? Just leave me alone, you monster!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS05DreamworldTopic_0002c6d0_Oblivion_RESP1"
msgid "But... how? What you say must be the truth... I feel strange..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE40GreetingChoice2_000790c0_Oblivion_RESP4"
msgid ""
"But... if you find me a good place to sleep, a safe place -- outside -- I'll "
"reward you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022e5c_Oblivion_RESP1"
msgid ""
"But... perhaps you are an adventurer? Could you assist me in acquiring "
"something for my crystal collection?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ03Avenge_00189cfc_Oblivion_RESP1"
msgid "But... this is amazing!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002443c_Oblivion_RESP2"
msgid "But.... oh, no. Poor Rallus."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EmfridDEMOchoice3_00028a30_Oblivion_RESP3"
msgid ""
"But...what if we're wrong? Bittneld has traveled the world, while I've spent "
"my whole life in this tavern."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_0008273d_Oblivion_RESP1"
msgid "Buy a drink and watch the fight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00072e03_Oblivion_RESP1"
msgid "Buy us a drink!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e8c9_Oblivion_RESP1"
msgid "Buzz, buzz, buzz. Go away, little fly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkTimeWound_00014e28_AltarDeluxe_RESP1"
msgid ""
"By Akatosh's Grace... what you describe is a Time Wound! A few years ago, an "
"Elder Scroll was stolen from my Order."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000aed3e_Oblivion_RESP1"
msgid ""
"By Azura, by Azura, by Azura! It's the Grand Champion! I can't believe it's "
"you! Standing here! Next to me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_000c425c_Oblivion_RESP1"
msgid ""
"By Shinji, we have a new Champion! All hail the Blue Team! Victorious "
"Champion, return to the Bloodworks now and see the Blademaster! Well done!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0014684c_Oblivion_RESP1"
msgid ""
"By Shinji, you did it! You beat them all! You're a Champion! My friend, you "
"have brought honor to the Blue Team in ways I can't even describe!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_000981b6_Oblivion_RESP1"
msgid "By Sithis, I don't have all day! Hurry it up!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00036326_Oblivion_RESP1"
msgid "By Sithis, I hope you shoot your own eye out..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk3_0003404e_Oblivion_RESP1"
msgid ""
"By Sithis, what a night that was! Reminded me of the time you and I raided "
"that traveling carnival! Ah, now that takes me back..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036305_Oblivion_RESP1"
msgid ""
"By Sithis, what have you done? What madness has claimed you? You have "
"betrayed me, you have betrayed the Dark Brotherhood! Why?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00025269_Oblivion_RESP1"
msgid "By Ysmer's beard, not you again!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Seen_001854ec_Oblivion_RESP1"
msgid "By Ysmir's beard, we've got ourselves a live one!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028797_Oblivion_RESP1"
msgid ""
"By Ysmir's dragon blood, what's wrong with you? Two people are dead! It's "
"hardly the time to chat about that Legion lackey!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_000289fe_Oblivion_RESP1"
msgid ""
"By Ysmir, you've got nerve! Three people are dead! What, are you trying to "
"turn me against Primo now?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetTopic_00002a8d_Knights_RESP1"
msgid ""
"By all accounts, he preaches that the attack on Anvil Chapel is an omen of "
"some kind of coming doom."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneUniversityTopic_000473ee_Oblivion_RESP2"
msgid ""
"By all means, travel to the Imperial City and get stopped at the gates. You "
"should get used to that sort of rejection."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Reward_0002367a_Oblivion_RESP1"
msgid ""
"By all means. I would have paid any amount to be rid of those watching eyes, "
"always watching me ... but never again! Ha ha ha! I'm FREE!!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk1_00068907_Oblivion_RESP1"
msgid "By all means. What do you need?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003640c_Oblivion_RESP1"
msgid "By all that is holy, we must get out of this hellish place!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004d16c_Oblivion_RESP1"
msgid ""
"By ancient tradition, I may not present myself as a candidate for the throne. "
"I need you to formally present my claim to Chancellor Ocato."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGEmperor01_00053261_Oblivion_RESP3"
msgid "By chance, the entrance to that escape route leads through your cell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001c0d7_Oblivion_RESP1"
msgid ""
"By defeating that Breton, you've secured your advancement. It's been a long "
"time since I've said this, but congratulations, Hero."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ee2f_Oblivion_RESP2"
msgid ""
"By failing to fulfill this contract, you have brought shame upon us all. "
"Leave me now, and contemplate your uselessness as a member of this family."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ee30_Oblivion_RESP2"
msgid ""
"By failing to fulfill this contract, you have brought shame upon us all. "
"Leave me now, and contemplate your uselessness as a member of this family."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f146_Oblivion_RESP5"
msgid ""
"By following the Path of Dawn hidden in the writings of the Master, Mankar "
"Camoran, you have earned a place among the Chosen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15KathutetC4_0003e8fa_Oblivion_RESP2"
msgid ""
"By freeing the Xivilai Anaxes, you restored the order to the Garden that the "
"unmortals had upset by imprisoning him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15KathutetB4_0003e8f5_Oblivion_RESP6"
msgid ""
"By giving you this choice -- gift or battle -- I discharge my debt to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS21StatueGive_0002b525_Oblivion_RESP2"
msgid ""
"By good fortune, my research has uncovered some new information that may help "
"you in your search for the remaining statues."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07RitualYesD_0001365d_Oblivion_RESP4"
msgid ""
"By poisoning the sacramental wine, Arden-Sul was able to suppress any such "
"conspiracy in one fell swoop."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ08Wine_0018d92b_Oblivion_RESP1"
msgid "By the Divines! You found some? Fantastic!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ02Skooma_0018917c_Oblivion_RESP2"
msgid ""
"By the Divines, I salute you in the name of the Legion. Here is your well-"
"earned reward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000bc8e_Oblivion_RESP1"
msgid "By the Divines, you've done it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FromTheDead_0001ce03_Oblivion_RESP1"
msgid ""
"By the Divines... I can't believe this! They would dare defile the dead to "
"make a profit? The City Watch will hear of this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_000624ff_Oblivion_RESP1"
msgid "By the Nine Divines! Assault! Assault!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Trespass_00062279_Oblivion_RESP1"
msgid "By the Nine Divines, can't a woman get a moment to herself? Leave me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00027668_Oblivion_RESP1"
msgid ""
"By the Nine Divines, you did it! You actually won! You ain't so bad after "
"all, Pit Dog. You may even survive enough matches to advance in rank."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_0003336b_Oblivion_RESP1"
msgid ""
"By the Nine Divines, you're an ugly one. And female, no less. But then, all "
"Orcs are ugly. The most repulsive race in all of Tamriel, really."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_0003336a_Oblivion_RESP1"
msgid ""
"By the Nine Divines, you're an ugly one. But then, all Orcs are ugly. The "
"most repulsive race in all of Tamriel, really."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000aed3f_Oblivion_RESP1"
msgid ""
"By the Nine Divines, you're the Grand Champion of the Arena! This is such an "
"honor!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MucianusAliasTopic_00095a69_Oblivion_RESP2"
msgid "By the Nine! And there was nothing you could do for him?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000293e_Knights_RESP1"
msgid "By the Nine! It's just like what happened to Anvil and Bravil!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MartinA_0008b618_Oblivion_RESP1"
msgid "By the Nine! Such a thing is dangerous even to handle!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02JauffreB1_0001e74a_Oblivion_RESP1"
msgid "By the Nine! This IS the Amulet of Kings!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ09Scales_00067dd1_Oblivion_RESP1"
msgid ""
"By the Nine! You've got the scales! Thank you! Let it never be said that "
"there are no kind souls in this world."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000290f_Knights_RESP1"
msgid ""
"By the Nine, I've not seen such strength. Could you be... no. You cannot. You "
"are simply a noble knight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMeridiaSpeech_000579c5_Oblivion_RESP1"
msgid ""
"By the detritus of the profane, I am brought forth. And by your offering, you "
"have made the profane your interest, mortal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FearGeneral_00024266_Oblivion_RESP1"
msgid "By the gods!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03LewinChamberOneGnarl02_000648b6_Oblivion_RESP1"
msgid "By the gods! When will it stop? It could devour us whole!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MurderNoCrime_00062508_Oblivion_RESP1"
msgid "By the gods, how could you do such a thing?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AngerReceive_0002425e_Oblivion_RESP1"
msgid "By the gods, no!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006fdbd_Oblivion_RESP1"
msgid ""
"By the gods, the snow's coming down! What brings you out here in the cold, "
"citizen?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_00062500_Oblivion_RESP1"
msgid "By the gods, there's a psychopath on the loose!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000236db_Oblivion_RESP1"
msgid "By the gods, what do you want?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028725_Oblivion_RESP1"
msgid ""
"By the gods, you're the only one left. It was you! How could you? How could "
"you have killed all those people? You won't take me so easily!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000441ee_Oblivion_RESP1"
msgid ""
"By the grace of Arden-Sul a new successor has been selected to rule. Joy to "
"Arden-Sul and Maniacs!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ecc9_Oblivion_RESP1"
msgid ""
"By the grace of Arden-Sul a new successor has been selected to rule. Joy to "
"Arden-Sul and Maniacs!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f3f1_Oblivion_RESP1"
msgid "By the grace of Arden-Sul, the armies have returned."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraReactions_00084ab3_Oblivion_RESP1"
msgid "By the light!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0005dc8a_Oblivion_RESP1"
msgid "By the light!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebf2_Oblivion_RESP1"
msgid "By the light, how did you make it out of there?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003b1d7_Oblivion_RESP1"
msgid ""
"By the love of Shinji, you did it! You beat the Gray Prince! This... This is "
"unbelievable! That makes you the best fighter the Arena has ever seen!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003b1da_Oblivion_RESP1"
msgid ""
"By the love of Shinji, you did it! You beat the Gray Prince! This... This is "
"unbelievable! That makes you the best fighter the Arena has ever seen!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND10KnightsHail_00002cac_Knights_RESP1"
msgid "By the might of Talos, the Crusader is arisen!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND10KnightsHail_00002cad_Knights_RESP1"
msgid "By the power of Akatosh!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11TalkToMillona_00022e7c_Oblivion_RESP1"
msgid ""
"By the power of the Elder Scrolls I name Emer Dareloth as the true thief of "
"Nocturnal's Cowl."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000290e_Knights_RESP1"
msgid ""
"By the strength and guidance of the Nine, who comes before us upon this "
"sacred ground seeking the Cuirass of the Divine Crusader? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDChapelAttackTopic_00002b93_Knights_RESP1"
msgid ""
"By the time we got there, it was too late. We have no idea how they got in or "
"out without any of our patrols seeing them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0005371a_Oblivion_RESP1"
msgid ""
"By the way the guards tossed you in here, I can see you're no friend of "
"theirs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00034070_Oblivion_RESP1"
msgid ""
"By the way, I heard that Faelian was killed. You didn't know him, did you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusI_0001e90e_Oblivion_RESP2"
msgid ""
"By the way, thanks for recovering Captain Renault's sword. I'll see that it "
"is given a place of honor in the halls of the Blades."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusI_00079442_Oblivion_RESP2"
msgid ""
"By the way, thanks for recovering Glenroy's sword. I'll see that it is given "
"a place of honor in the halls of the Blades."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusI_00079441_Oblivion_RESP2"
msgid ""
"By the way, thanks for recovering my comrades' swords. I'll see that they are "
"given a place of honor in the halls of the Blades."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_00038aa1_Oblivion_RESP3"
msgid ""
"By the way... do you happen to know what the fine is here in Cyrodiil for "
"necrophilia? Just asking."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BleakFlatsCaveTopic_0000a1e7_Oblivion_RESP2"
msgid ""
"By we, I mean you, of course. I have something that may help - it's a basic "
"fireball spell, in case you need to defend yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09SlainYes_00013569_Oblivion_RESP2"
msgid "By what authority do you disturb me?!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062ced_Oblivion_RESP1"
msgid "By what right do you disturb me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE14EscortFollow_000637d9_Oblivion_RESP1"
msgid "By your command."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE14EscortFollow_000637e1_Oblivion_RESP1"
msgid "By your command."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025df2_Oblivion_RESP1"
msgid ""
"By your crimes, you have been permanently expelled from the Fighters Guild. "
"You have no further chance to atone for your actions."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00002db3_Oblivion_RESP1"
msgid "Bye now, sweetie. I look forward to seeing you again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00073116_Oblivion_RESP1"
msgid "Bye, dear."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000241a6_Oblivion_RESP1"
msgid "Bye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003aab5_Oblivion_RESP1"
msgid "Bye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000617cb_Oblivion_RESP1"
msgid "Bye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00049946_Oblivion_RESP1"
msgid "Calindil runs a nice place at the Mystic Emporium."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE42Calipers_0007322f_Oblivion_RESP1"
msgid "Calipers? Tongs? What would I need those for?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMephalaSpeech_000579d7_Oblivion_RESP1"
msgid "Call me 'Webspinner'. Pluck but a single thread, and the weave unravels."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BSylLeaves_0003b824_Oblivion_RESP1"
msgid ""
"Calm yourself, Syl. You're making my teeth itch. You still hold your office. "
"I suggest you see to your duties."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AThadonLeaves_000206c4_Oblivion_RESP1"
msgid ""
"Calm yourself, Thadon. You're making my teeth itch. You still hold your "
"office. I suggest you see to your duties."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000363b9_Oblivion_RESP1"
msgid "Can I ask you a favor?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028707_Oblivion_RESP1"
msgid ""
"Can I be honest with you, my friend? I find Dovesi... captivating. She "
"possesses a beauty beyond compare."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028245_Oblivion_RESP1"
msgid ""
"Can I be honest with you? Nels won't stop looking at me. At first I was "
"flattered. But now he's scaring me! He could be the killer! I could be next!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00095030_Oblivion_RESP1"
msgid "Can I beg a favor of you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000363c9_Oblivion_RESP1"
msgid "Can I help you Citizen?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001e54e_Oblivion_RESP1"
msgid "Can I help you, Associate?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00034459_Oblivion_RESP1"
msgid "Can I help you, Pickpocket?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00129be6_Oblivion_RESP1"
msgid "Can I help you, brother?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00129be5_Oblivion_RESP1"
msgid "Can I help you, sister?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002f1f0_Oblivion_RESP1"
msgid "Can I help you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bc8a_Oblivion_RESP1"
msgid "Can I help you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d14f_Oblivion_RESP1"
msgid "Can I help you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003aaad_Oblivion_RESP1"
msgid "Can I help you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00072e02_Oblivion_RESP1"
msgid "Can I help you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_000091bc_Oblivion_RESP1"
msgid "Can I interest you in some of my wares?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008152f_Oblivion_RESP1"
msgid "Can I show you my latest trick, Lord Sheogorath?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000452f0_Oblivion_RESP1"
msgid "Can I tidy up for you? Your house is always such a mess."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062cf7_Oblivion_RESP1"
msgid "Can it speak? Can it make words?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_0004665f_Oblivion_RESP1"
msgid ""
"Can the Blue Team's Brawler possibly hope to defeat the Yellow Team's Wood "
"Elf twin sisters? Let's find out! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000181bc_Oblivion_RESP1"
msgid "Can we get out of here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03LewinC1Idle01_0008ea8b_Oblivion_RESP1"
msgid "Can we just leave? I don't like the looks of this place."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00015e01_Oblivion_RESP1"
msgid "Can ya spare a coin?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0004659f_Oblivion_RESP1"
msgid "Can you believe how Skjorta acts?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00064468_Oblivion_RESP1"
msgid "Can you believe that a thief broke into the Imperial Palace itself!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGPayBloodPrice_0001c474_Oblivion_RESP3"
msgid ""
"Can you believe that fool even bothered to collect this paltry sum? You can "
"keep it. I merely wanted the Watch know they went too far."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG02GiveItem_000165f3_Oblivion_RESP2"
msgid ""
"Can you believe that fool even bothered to collect this paltry sum? You can "
"keep it. I merely wanted the Watch to know they went too far."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilA2_0003fbd8_Oblivion_RESP4"
msgid ""
"Can you defeat Mankar Camoran? And free all the souls of the poor fools who "
"followed him?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetSpeechAmulet_00002d1d_Knights_RESP1"
msgid ""
"Can you feel that, people of Cyrodiil? The red gem is nearby! The Oversoul is "
"speaking!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_001885da_Oblivion_RESP1"
msgid "Can you help me find my lost Jumbo Potatoes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000093c4_Oblivion_RESP1"
msgid "Can you help me, please?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033b32_Oblivion_RESP1"
msgid "Can you help me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Gang_0003d30e_Oblivion_RESP4"
msgid "Can you help us?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilA2_0003fbd8_Oblivion_RESP3"
msgid "Can you really do it? Can you bring this eternal nightmare to an end?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000452e7_Oblivion_RESP1"
msgid "Can you spare some coins? I need a drink."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001e7e7_Oblivion_RESP1"
msgid "Can you tell me where Armand Christophe is hiding?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OgreSlaves_0001ec3c_Oblivion_RESP1"
msgid ""
"Can you think of a better use for the mindless beasts? Under my eye, they do "
"some good in this world. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00049948_Oblivion_RESP1"
msgid ""
"Can you think of a more appropriate name for a store than Slash 'N Smash?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00049905_Oblivion_RESP1"
msgid "Can you think of anyplace better to buy books than First Edition?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e961_Oblivion_RESP4"
msgid "Can't be too careful. Please, friend. I'm begging you. Help me out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONEXIT_0018b2f2_Oblivion_RESP1"
msgid "Can't do better than that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02GatesOfMadness_0008e4fa_Oblivion_RESP1"
msgid ""
"Can't get in without Sheogorath's Blessing. That's what Relmyna says. That's "
"the reason we're all waiting here - for Sheogorath's blessing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DaedraCultTopic_000a495d_Oblivion_RESP3"
msgid ""
"Can't give you any better directions, unfortunately. Traveled mostly at night "
"with a guide, and didn't see much on the way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Repair_00066a58_Oblivion_RESP1"
msgid "Can't go into battle with broken equipment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recharge_0006550f_Oblivion_RESP1"
msgid "Can't have you walking around without working equipment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArdalineTopic_0002ba67_Oblivion_RESP2"
msgid "Can't help you. I don't really know her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003377a_Oblivion_RESP1"
msgid "Can't quit now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_00082613_Oblivion_RESP1"
msgid "Can't say I blame him, living in Crucible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_thieves_00002e5e_Oblivion_RESP1"
msgid ""
"Can't say I know anything myself, but I heard that Newheim the Portly had "
"some things stolen, and he's been asking around about it. Ask him."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BrumaNQDQuestionResponses_0004662b_Oblivion_RESP1"
msgid ""
"Can't say I know him well. I understand he'll train people to cast illusions, "
"for a price."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07NoBribeBeggar_00015f19_Oblivion_RESP1"
msgid "Can't say I know of any."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c205_Oblivion_RESP1"
msgid "Can't say I like tomatoes. I'm sure Undena's are good, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028cd9_Oblivion_RESP1"
msgid ""
"Can't say I'm sorry to see there's one less Nord in the world. Still, I don't "
"appreciate someone getting murdered right under my nose."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingArmorerNothing_0018d160_Oblivion_RESP1"
msgid ""
"Can't say I'm surprised. Few recognize the name anymore, even though he was "
"famous. Had a book written about him, in fact!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolNQDResponses_00029fe1_Oblivion_RESP1"
msgid "Can't say I've heard anything myself. Still, that's odd."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_000498fa_Oblivion_RESP1"
msgid "Can't say I've spent much time there. I hear it's nice, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAClavicusChoice7_00026b1a_Oblivion_RESP1"
msgid ""
"Can't say for sure. Some say they've seen her nearby, near the Vindasel "
"Ruins. Might just be wishful thinking, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000790a9_Oblivion_RESP1"
msgid "Can't sleep at home so I just walk around. Can't sleep."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000790c2_Oblivion_RESP1"
msgid "Can't sleep at home. Can't sleep. The walls aren't safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000790a8_Oblivion_RESP1"
msgid "Can't sleep."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000790a6_Oblivion_RESP1"
msgid "Can't sleep... the walls, they'd fall on me. Can't have that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00071171_Oblivion_RESP1"
msgid ""
"Can't talk now. That door has been making noises again. No telling what's "
"coming out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002c7a9_Oblivion_RESP1"
msgid "Can't thank you enough for your help. What do you need?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_0002872c_Oblivion_RESP1"
msgid ""
"Can't this wait, huh? Someone's been murdered and I've got better things to "
"do than gossip about an old woman."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003d4ce_Oblivion_RESP1"
msgid "Can't wait to get my hands on you..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000b97d8_Oblivion_RESP1"
msgid "Can't wait to get out of here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d48e_Oblivion_RESP1"
msgid "Can't wait to see you later. Don't keep us waiting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062cdf_Oblivion_RESP1"
msgid "Can't you find someone else to bother?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03GrommokC2Idle01_0008ea82_Oblivion_RESP1"
msgid "Can't you just wizard it open?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00089977_Oblivion_RESP1"
msgid "Can't you see I have things to do? Now please... get out of my way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00041095_Oblivion_RESP1"
msgid ""
"Can't you see I was in the middle of my daily dewfall survey? Now I have to "
"start all over again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062ce0_Oblivion_RESP1"
msgid "Can't you see I wish to be left alone!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000781ee_Oblivion_RESP1"
msgid ""
"Can't you see I'm busy? My house. So orderly. And now this! Where do I even "
"begin?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022488_Oblivion_RESP1"
msgid ""
"Can't you see I'm busy? Without the translation, this book is useless. Now go "
"away and let me work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028bf7_Oblivion_RESP1"
msgid ""
"Can't you see I'm busy? Without the translation, this book is useless. Now go "
"away and let me work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003c33e_Oblivion_RESP1"
msgid "Can't you see that I'm busy?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0005327a_Oblivion_RESP1"
msgid "Can't you see that I'm upset?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00028f81_Oblivion_RESP1"
msgid "Can't you see that I'm very busy?!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_000624fd_Oblivion_RESP1"
msgid "Can't you settle this peacefully?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003360c_Oblivion_RESP1"
msgid "Can't you take a hint?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000661f8_Oblivion_RESP1"
msgid ""
"Can't... Can't move... Body frozen... Must have been... the damn... Mead..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09accept_00014826_Oblivion_RESP1"
msgid ""
"Capital! Bring me the Arrow of Extrication. It has a key shaped head. "
"Bravil's court wizard, Fathis Aren, recently acquired this unique item."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11Accept_0001fb62_Oblivion_RESP1"
msgid ""
"Capital! I have worked for eleven years planning this heist. Savilla's Stone "
"provided the last bit of information I needed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGPayBloodPrice_0001cf1b_Oblivion_RESP1"
msgid "Capital! I hearby reinstate you into the Thieves Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGPayBloodPrice_0001cf1f_Oblivion_RESP1"
msgid ""
"Capital! I knew you could not stand for a stain on your honor, or that of the "
"guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGPayBloodPrice_0001cf38_Oblivion_RESP1"
msgid ""
"Capital! I like the swiftness of your reply. Here is your reward for getting "
"me those boots. Be ready. I may call for you again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08GiveStone_00014705_Oblivion_RESP1"
msgid ""
"Capital! Now I can see past the palace defenses. It's a good thing the "
"Emperor didn't know they had this stone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08GiveStone_0001cf35_Oblivion_RESP1"
msgid ""
"Capital! Now I can see past the palace defenses. It's a good thing the "
"Emperor didn't know they had this stone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10accept_00015309_Oblivion_RESP1"
msgid ""
"Capital! The Earl of Imbel is the only descendant of his line that I have "
"been able to locate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08accept_000146ff_Oblivion_RESP1"
msgid ""
"Capital! The monastery is called the Temple of the Ancestor Moths. It is "
"where retired, blind Moth priests go to wait out the rest of their days."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10GiveBoots_00015310_Oblivion_RESP1"
msgid ""
"Capital! This may be the last piece of the puzzle. I need to spend more time "
"with Savilla's Stone first."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10GiveBoots_0001cf37_Oblivion_RESP1"
msgid ""
"Capital! This may be the last piece of the puzzle. I need to spend more time "
"with Savilla's Stone first."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c999_Oblivion_RESP1"
msgid ""
"Captain Burd and I make a good pair. He understands Nords and the North, "
"while I appreciate the subtleties of southern culture and politics."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07SpiesResponse_00020076_Oblivion_RESP2"
msgid ""
"Captain Burd in Bruma may also be able to help. I've asked the Countess to "
"have the guard keep an eye out for strangers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ10JauffreA_00026efb_Oblivion_RESP1"
msgid ""
"Captain Burd is waiting for you outside the Bruma city gate. He'll show you "
"the Oblivion Gate. Although I doubt it will be hard to find."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0018d2a2_Oblivion_RESP1"
msgid ""
"Captain Burd wanted to attack the Oblivion Gate immediately, but I ordered "
"him to wait for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00000806_AltarESPMain_RESP1"
msgid ""
"Captain Dugal's rumored treasure has to be true! I wonder if the first count "
"of Anvil found it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006444c_Oblivion_RESP1"
msgid ""
"Captain Lex blames the Gray Fox for stealing the tax collection. He wants a "
"bounty put on the Gray Fox, but the Legion Commander has refused."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48IlendSlowDown_00098154_Oblivion_RESP1"
msgid ""
"Captain Matius sent us in to try and close the gate. We were ambushed, "
"trapped, and picked off."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenVoice_0004ea45_Oblivion_RESP1"
msgid "Captain Renault?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000688f7_Oblivion_RESP1"
msgid "Captain. Carry on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000688fd_Oblivion_RESP1"
msgid "Captain. No news is good news, I hope."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002fd72_Oblivion_RESP2"
msgid "Carahil has sent you, has she not?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0c0_Oblivion_RESP1"
msgid ""
"Carahil inherited the Anvil Mages Guild chapter from Hannibal Traven, the "
"Archmage. She runs a clean hall, just like Traven did."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesGuildTopic_0002d066_Oblivion_RESP1"
msgid ""
"Carahil supported Arch-Mage Traven's appointment from the beginning, and I "
"don't believe the rumors that she just wanted his job at this hall."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LorgrenSpeech_0006e7f2_Oblivion_RESP1"
msgid ""
"Carahil was justified in his actions. Slaying me was the only way to stop the "
"madness. I have accepted that fate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesGuildTopic_0002d067_Oblivion_RESP1"
msgid ""
"Carahil's a good leader. She's been a staunch supporter of the Council of "
"Mages for as long as I've known her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488d9_Oblivion_RESP1"
msgid ""
"Carandial. Mage-trained. Scholar by inclination. Student of our Aldmeri "
"ancestors, the Ayleids."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_NecromancersAmuletTopic_0000c08a_Oblivion_RESP1"
msgid ""
"Caranya insisted on removing it from the University. She said it posed a "
"threat to the safety of the Imperial City."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_NecromancersAmuletTopic_000146cd_Oblivion_RESP1"
msgid "Caranya turned on the Guild?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03XedilianTopic_0008e94d_Oblivion_RESP3"
msgid "Care to donate?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00073124_Oblivion_RESP1"
msgid "Careful! Don't want to get squashed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008ea29_Oblivion_RESP1"
msgid "Careful. Beasts all around. You might taste good to them, no?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005c0ca_Oblivion_RESP1"
msgid "Careful..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00068900_Oblivion_RESP1"
msgid "Caroline, a good day to you. Or is it evening?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000688f2_Oblivion_RESP1"
msgid "Caroline. Don't let me keep you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000982bd_Oblivion_RESP1"
msgid "Carry on, soldier."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00068905_Oblivion_RESP1"
msgid "Carry on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0018baab_Oblivion_RESP1"
msgid "Carry on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeSword_0001651c_Oblivion_RESP1"
msgid "Carve a happy smile. Let the blood wash over your hands."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_NDGauntletsoftheCrusader_00002b13_Knights_RESP1"
msgid ""
"Casimir left with the Gauntlets when the Order dissolved. I heard that he "
"lost them, but I had my own problems to deal with."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008dc18_Oblivion_RESP1"
msgid "Cast lots of spells at Gnarls. That's the best way to hurt them. Really!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraSpeech_0005dc89_Oblivion_RESP1"
msgid ""
"Cast this spell upon the priests. Allow my beloved Forgotten to kill the "
"interlopers. When this is done, I shall reward you for your efforts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000255c2_Oblivion_RESP1"
msgid ""
"Casta Scribonia has finished a new book. Nothing that interests me, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10JyggalagTopic_00091460_Oblivion_RESP1"
msgid ""
"Cat's out of the bag on that one, isn't it? Who puts cats in bags, anyway? "
"Cats hate bags."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479f4_Oblivion_RESP1"
msgid ""
"Cat-Face. Yes, that's right. That's what they call me. Because they can't "
"pronounce my Black Marsh name, I guess..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00072e06_Oblivion_RESP1"
msgid "Cats. Everywhere."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_causingtrouble_0002c8db_Oblivion_RESP1"
msgid ""
"Causing trouble, yes. Causing much trouble. Scaring customers. Breaking "
"furniture. Bad, bad men."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45Caverns_0001778f_Oblivion_RESP1"
msgid ""
"Caves run all beneath the town. Some natural, some dug over the years since "
"we found the Deep Ones. Every house has an entrance now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000915bc_Oblivion_RESP1"
msgid "Cease your prattling."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_TG11PriestDeliverScroll_0014c71b_Oblivion_RESP1"
msgid "Celia Camoran, I present to you the Elder Scroll you requested."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32OfferHelp_00012d04_Oblivion_RESP2"
msgid ""
"Centuries ago, Vitharn was overrun by Fanatics. We were soft and failed to "
"defend ourselves. I was the weakest of all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND04CarodusGreetingMace_00002ac0_Knights_RESP2"
msgid ""
"Centuries later, the master craftsman Saint Kaladas built the Chapel of "
"Zenithar in Leyawiin as a tribute to the legend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND04Mace_00002ac9_Knights_RESP2"
