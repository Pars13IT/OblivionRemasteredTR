msgid "Hello. Are you searching for something?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000038d1_Oblivion_RESP1"
msgid ""
"Hello. I am Laythe Wavrick, the Chief Herald and Countess Valga's attendant. "
"Welcome to Chorrol."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0015974b_Oblivion_RESP1"
msgid ""
"Hello. I am Laythe Wavrick, the Chief Herald and Countess Valga's attendant. "
"Welcome to Chorrol."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00033ee2_Oblivion_RESP1"
msgid ""
"Hello. I hope the goblins along the Yellow Road didn't give you any trouble."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004300f_Oblivion_RESP1"
msgid ""
"Hello. I'm Atrabhi! People think I'm not friendly because I'm always reading. "
"I enjoy a good conversation, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001dc44_Oblivion_RESP1"
msgid "Hello. I'm Brother Jauffre. Can I help you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00024f11_Oblivion_RESP1"
msgid "Hello. I'm Casta Scribonia. The writer. Author of 'Woman Gone Wild'."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000238e3_Oblivion_RESP1"
msgid ""
"Hello. I'm Rasheda -- the smith -- and this is Fire and Steel. Quality armor "
"and weapons, repairs, too. What can I do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488e3_Oblivion_RESP1"
msgid ""
"Hello. I'm Roxanne Brigette. I help the boys. They get a little squirrelly "
"sometimes, find it hard to cope. So I help out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000314f4_Oblivion_RESP1"
msgid "Hello. I'm not really in the mood to chat right now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00043013_Oblivion_RESP1"
msgid ""
"Hello. My name isn't Atrabhi, I don't know why everyone calls me that. And I "
"don't know where I get this reputation for being a liar, either."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038aaa_Oblivion_RESP1"
msgid ""
"Hello. We haven't met, have we? I'm Sister Marie Palielle, the chapel healer, "
"and trainer in the Restoration Arts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00035748_Oblivion_RESP1"
msgid "Hello. Welcome to Castle Chorrol."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000251db_Oblivion_RESP1"
msgid "Hello. What is it I can do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002ad89_Oblivion_RESP1"
msgid ""
"Hello. You haven't seen my sons, have you? They went off into the forest to "
"fight those monsters, and I'm worried about them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000be68_Oblivion_RESP1"
msgid ""
"Hello. You're from the Fighters Guild, I presume. It's good that you've "
"arrived. We need your help with some disappearances."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000790a5_Oblivion_RESP1"
msgid ""
"Hello... don't mind me... I'm a little tired. Can't sleep at home, you know. "
"The walls. They aren't safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark11Choice4C_00002ddb_Oblivion_RESP1"
msgid ""
"Hello? Did you hear me? I asked if you needed anything. Well then, I've got "
"duties to tend to, so if you'll excuse me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAClavicusSpeech_000243b5_Oblivion_RESP1"
msgid ""
"Hello? Hey! Pay attention! In your pack. The dog. I swear, you heroes aren't "
"particularly quick on the uptake...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Noticed_0002d3fa_Oblivion_RESP1"
msgid "Hello? Who's there?  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_0001fb50_Oblivion_RESP3"
msgid ""
"Help Theranis bring back this book. If Theranis is unwilling or unable, bring "
"back the book yourself. Are you agreeable?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ09Scales_00066f2c_Oblivion_RESP4"
msgid "Help an old fisherman out, won't you?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_NecromancersAmuletTopic_0000c08a_Oblivion_RESP4"
msgid ""
"Help her to see that she should not use the weapons of the enemy, especially "
"out of fear."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e121_Oblivion_RESP1"
msgid "Help me get past Dagon and into the Temple of the One! I'll do the rest!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e961_Oblivion_RESP2"
msgid ""
"Help me out,friend. I need some skooma. Real bad. The good stuff. You know? "
"Been dry for days. Got some skooma for me? I pay well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029a8_Knights_RESP1"
msgid "Help me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00054fa0_Oblivion_RESP1"
msgid "Help us hold the Altar against the Mazken's counterattack!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraSpeech_00084aa6_Oblivion_RESP1"
msgid "Help us...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0000bf9a_Oblivion_RESP1"
msgid "Help!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Flee_00086968_Oblivion_RESP1"
msgid "Help! A prisoner has escaped!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Trespass_0002a368_Oblivion_RESP1"
msgid "Help! Guards! I have a trespasser!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_000624fe_Oblivion_RESP1"
msgid "Help! Help! I'm being attacked!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Murder_0009ea82_Oblivion_RESP1"
msgid "Help! Murder!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ee23_Oblivion_RESP1"
msgid "Help! You must help! They're killing everyone at Weynon Priory!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0000bf35_Oblivion_RESP1"
msgid "Help, help! You've got to do something!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG11ChoiceHeretohelp_00033634_Oblivion_RESP1"
msgid "Help?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_000164b6_Oblivion_RESP1"
msgid ""
"Help? What makes you think help will get here before more of those bastards? "
"We need to get the Emperor out of here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c9bc_Oblivion_RESP1"
msgid ""
"Helvius Cecia. I do a little of this, a little of that. And I serve the Nine. "
"Praise their Names!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476c6_Oblivion_RESP1"
msgid ""
"Helvo Atius. Sevarius says I have to stay out of sight. So I'm stuck here "
"until things blow over."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS05DreamworldTopic_0002c6dd_Oblivion_RESP2"
msgid ""
"Henantier constructed a magical device he called the Dreamworld Amulet. With "
"this device, one can enter his own mind and experience dreams."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS05Dreams_0002c6de_Oblivion_RESP3"
msgid ""
"Henantier created the amulet to see if he could use his dreams as a training "
"ground to help better himself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS05PleaseExplain_0002c6dc_Oblivion_RESP1"
msgid ""
"Henantier isn't a prisoner in any physical sense. He's a prisoner of his own "
"mind. He's trapped in his Dreamworld."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS05WhatGives_0002c6db_Oblivion_RESP2"
msgid ""
"Henantier isn't a prisoner in any physical sense. He's a prisoner of his own "
"mind. He's trapped in his Dreamworld."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HenantierTopic_00027f37_Oblivion_RESP4"
msgid ""
"Henantier isn't missing. On the contrary, I know exactly where he is. The "
"problem is he's trapped and there's no way I can free him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS05PreparedYes_0002c6ea_Oblivion_RESP3"
msgid ""
"Henantier once told me that if he's killed in his dreams, anyone that's in "
"there with him will die as well. So, do be careful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003cd29_Oblivion_RESP1"
msgid ""
"Henantier was slain in his sleep. How awful. They should find the one who did "
"it and send him straight to prison."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS05WhyLie_00027f39_Oblivion_RESP3"
msgid ""
"Henantier's never been one for rules, and so he's continued to perform his "
"latest experiments in secret. If word gets out, he'll be dismissed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e4f0_Oblivion_RESP2"
msgid "Her Gatekeeper is flawed! Her tears hurt him! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003cf89_Oblivion_RESP2"
msgid ""
"Her Ladyship has no intention of remarrying. Liked her first Count well-"
"enough, I guess, and doesn't fancy a replacement."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05HaskillSyl_0001ac61_Oblivion_RESP1"
msgid ""
"Her Ladyship is rather suspicious of all around her. Best for you to not "
"question it, and merely do what she requires of you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BradonLirrianTopic_0003843a_Oblivion_RESP2"
msgid ""
"Her accusations that Raynil is lying is not surprising. At this point, she's "
"so upset that she'll say anything to deny what really happened."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG07DagailConv_0001fbb7_Oblivion_RESP1"
msgid "Her condition remains unchanged. I appreciate you inquiring about her."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SQ05RaelynntheGravefinder_0018abd6_Oblivion_RESP5"
msgid ""
"Her death pays a handsome bounty. I hope you'll take advantage of the "
"opportunity."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TarMeenaTopic_00002dcd_Oblivion_RESP1"
msgid ""
"Her expertise in arcane knowledge and lore could be invaluable to us, if we "
"can make proper use of it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005d508_Oblivion_RESP1"
msgid "Her eye is upon you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BernadettePenelesTopic_0001dcba_Oblivion_RESP1"
msgid ""
"Her house is almost directly across the street from mine, southwest of the "
"Great Chapel. Coincidence? I don't think so."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalNQDResponses_0003e970_Oblivion_RESP1"
msgid "Her knowledge of armor is really impressive."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008264a_Oblivion_RESP1"
msgid "Her light shall show you the way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003be7f_Oblivion_RESP2"
msgid ""
"Her majesty cannot tolerate a liar. It is I who makes the rules here. If you "
"need anything, you come to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27QuestStart_0002e5ce_Oblivion_RESP1"
msgid ""
"Her name is Herminia Cinna. She lives here in the Imperial City, in the Elven "
"Gardens district."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Prank_000302d5_Oblivion_RESP3"
msgid ""
"Her room is upstairs; make sure no one sees you. You do that for me, and I'll "
"make sure you can find J'skar."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Prank_0001ceea_Oblivion_RESP2"
msgid ""
"Her room should be easy to find. It's the only one upstairs that has a door. "
"Just one more privilege she doesn't deserve."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BravilNQDQuestionResponses_000465f8_Oblivion_RESP1"
msgid ""
"Her skills with Destruction spells are supposedly impressive. I understand "
"Kud-Ei has her teaching them at the Mages Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00082648_Oblivion_RESP1"
msgid "Her song guides us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00082647_Oblivion_RESP1"
msgid "Her song guides us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AkaviriArtifacts_000980f5_Oblivion_RESP3"
msgid ""
"Her steward, Tolgan, occasionally approaches individuals the Countess feels "
"is worthy enough to seek her prize."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE02GatekeeperChoiceHowTears_0008e4f8_Oblivion_RESP1"
msgid ""
"Her tears somehow agitate the daedra bound to the Gatekeeper's body. Her "
"tears make it really restless. It strains harder against the warding magic."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03LlathasaIndarys_00045f76_Oblivion_RESP1"
msgid ""
"Her tomb is in the northern croft. It's a pity about her highness. She died "
"so young, at least for an elf."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c260_Oblivion_RESP1"
msgid "Her wines are excellent, and she's a fine person as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11CiirtaTopic_0001a398_Oblivion_RESP1"
msgid ""
"Her... her light has gone out. What will we do now? Are we damned to walk in "
"darkness forever? Who will lead us?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_000895e6_Oblivion_RESP2"
msgid ""
"Herdir has a great affinity for his work, and can be a very useful ally to "
"you. Do not hesitate to make use of his talents."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate1_00013a5c_Oblivion_RESP1"
msgid "Herdir, you filth. You don't dare touch me. Syl will have your head!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479d3_Oblivion_RESP1"
msgid ""
"Here I train our skirmishing specialists. You know, perhaps, that Argonians "
"may be gifted spellcasters."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035f42_Oblivion_RESP1"
msgid "Here about Vahtacen, are you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS51Choice1_0003152c_Oblivion_RESP2"
msgid ""
"Here are some keys. They should allow you access to many of the restricted "
"areas in Castle Chorrol."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ00Voice_0003c41f_Oblivion_RESP1"
msgid "Here comes another one!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE01GaiusTalk_00071176_Oblivion_RESP1"
msgid "Here comes another one!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000395e_Oblivion_RESP1"
msgid ""
"Here for more work, are you? I've got one last contract for you. First, "
"though, a bit of bad news. Oreyn spoke with Vilena about your last mission."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000be62_Oblivion_RESP1"
msgid "Here for more work? I've got one more contract for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11Dyus_00014b53_Oblivion_RESP1"
msgid ""
"Here in this Realm where secrets are power, Dyus is a being of great might. "
"He has knowledge of events beyond even that of the Daedric Princes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItem2_00081eb1_Oblivion_RESP1"
msgid ""
"Here in this case is a disgustingly deformed Swamp Tentacle. Such a freak of "
"nature has never been seen before, and hopefully not since either!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27QuestStart_0002e5ce_Oblivion_RESP4"
msgid ""
"Here is more than enough gold to buy it at any reasonable price. You may keep "
"whatever you do not use as your fee."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038b08_Oblivion_RESP1"
msgid ""
"Here is the amulet back. It's as beautiful as it was the day I remember "
"seeing it long ago. I want you to keep it, as I have no use for this anymore."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07PayForger_00015f12_Oblivion_RESP1"
msgid ""
"Here is the new List of Candidates. Hieronymus Lex has a glowing "
"recommendation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034e9a_Oblivion_RESP3"
msgid ""
"Here is the reward you were promised. Even though the bust is gone, you've "
"earned it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00009c7c_Oblivion_RESP4"
msgid ""
"Here is what I believe we should do next. I will stay here and attempt to "
"reestablish this Sanctuary. I will begin recruiting new members."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark16Choice2A_000262d8_Oblivion_RESP2"
msgid ""
"Here is what you must do. Go now to your next dead drop, lie in wait, and "
"confront whomever drops off the false contract!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark16Choice2B_000262d9_Oblivion_RESP2"
msgid ""
"Here is what you must do. Go now to your next dead drop, lie in wait, and "
"confront whomever drops off the false contract!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark16Choice2C_000262da_Oblivion_RESP2"
msgid ""
"Here is what you must do. Go now to your next dead drop, lie in wait, and "
"confront whomever drops off the false contract!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005421a_Oblivion_RESP1"
msgid "Here is your horse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseBuyChorrol_0004f219_Oblivion_RESP2"
msgid ""
"Here is your key. The house is on the main plaza, between the statue and the "
"Chapel."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ff08_Oblivion_RESP3"
msgid ""
"Here is your reward and bonus. Both have been well earned. Go now and rest, "
"and may the Night Mother guard your dreams."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000008d2_Oblivion_RESP3"
msgid ""
"Here is your reward and bonus. Both have been well earned. In addition, you "
"have been advanced to the rank of Eliminator. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034896_Oblivion_RESP3"
msgid ""
"Here is your reward, minus any bonus. It would seem you and Gogron share a "
"similar... style. Now go, and do be more careful in the future."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBows03_000908e2_Oblivion_RESP1"
msgid ""
"Here is your reward. And this other Black Bow? Would you like to turn it in "
"as well?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09GiveArrowHead_0001482a_Oblivion_RESP2"
msgid ""
"Here is your reward. I am also promoting you to Master Thief in the Thieves "
"Guild. Fathis Ules of the Imperial City will be your new fence."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBows02_000908e1_Oblivion_RESP1"
msgid "Here is your reward. Well done, and thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItem1_00081eb5_Oblivion_RESP1"
msgid ""
"Here is... well, I think there used to be something very Odd here, but it "
"seems to be missing now. Let's move on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElixirofExploration_0004e918_Oblivion_RESP1"
msgid ""
"Here it is... my pride and joy. A Grand Elixir of Exploration. Use it in good "
"health, my friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27Voice_000a934b_Oblivion_RESP1"
msgid ""
"Here it is... the throne of the last king of the Ayleids. And so it falls to "
"me to begin the restoration of our ancient glory..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0007302e_Oblivion_RESP1"
msgid "Here kitty, kitty!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenVoice_0001c101_Oblivion_RESP1"
msgid "Here they come again!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08CommanderBattle01_00018e69_Oblivion_RESP1"
msgid "Here they come! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08CommanderBattle01_000415de_Oblivion_RESP1"
msgid "Here they come! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e923_Oblivion_RESP1"
msgid "Here to sell me more Nirnroot?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00068aec_Oblivion_RESP1"
msgid "Here to sell me more Nirnroot?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE02JayredSayFoundBones_00012061_Oblivion_RESP1"
msgid "Here we are!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00068bca_Oblivion_RESP1"
msgid "Here we are, safe indoors. Nothing to harm us here, is there?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_magickaloria_000c9ba3_Oblivion_RESP1"
msgid ""
"Here we are: \"Magicka Darkens.\" Hmm, that's an odd one. Perhaps it's not a "
"literal translation, then... is there another inscription like it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItem5_00081ec6_Oblivion_RESP1"
msgid ""
"Here we have the mortal remains of a fellow named Din, who as I understand "
"was driven mad and killed himself, a truly Demented act."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ShrineofClavicusVileTOPIC_00026b0e_Oblivion_RESP1"
msgid "Here we worship Lord Clavicus. Do you have business with the Daedra?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ShrineofVaerminaTOPIC_0001ec17_Oblivion_RESP1"
msgid ""
"Here we worship Vaermina, praying for her to grant us true visions. What is "
"your business here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000a656a_Oblivion_RESP1"
msgid ""
"Here you are at last. I know exactly where the Throne Room lies. Your job is "
"simply to get me there safely."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_DEHorseArmorTopicAkatosh_00014e60_AltarDeluxe_RESP1"
msgid "Here you are, just like I promised! Thanks again for all the help!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_DEHorseArmorTopicMehrunes_00014e63_AltarDeluxe_RESP1"
msgid "Here you are, just like I promised! Thanks again for all the help!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_DLCHorseArmorTopicElven_00002613_DLCHorseArmor_RESP1"
msgid "Here you are, just like I promised! Thanks again for all the help!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_DLCHorseArmorTopicSteel_00002614_DLCHorseArmor_RESP1"
msgid "Here you are, just like I promised! Thanks again for all the help!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE11RakheranGiveDaggers2_0001a7bb_Oblivion_RESP1"
msgid "Here you are, my brothers! At last, we will be rid of Ciirta!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChallengeBreton_0009f9b0_Oblivion_RESP1"
msgid ""
"Here you face the swift and subtle Breton. Go through the gate, Chosen, and "
"test your fate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00045652_Oblivion_RESP1"
msgid ""
"Here you go, bounty hunter. I can't wait to begin playing with my living tree."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Reward_00023665_Oblivion_RESP1"
msgid ""
"Here you go, my friend. Trust me, you've earned it. There is one last person "
"that needs looking into, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01Lockpicks_0009fd6d_Oblivion_RESP1"
msgid "Here you go."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000c1bd_Oblivion_RESP3"
msgid ""
"Here you go. Don't spend it all in one place... unless it's here of course!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeGreaves_000400b9_Oblivion_RESP1"
msgid ""
"Here you go. I shaped these to your exact measurements. Need some help "
"getting them on?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e88b_Oblivion_RESP1"
msgid ""
"Here you have your Chapel-going Imperials, and your Chapel-dodging Dark "
"Elves, and never shall the twain meet."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025df0_Oblivion_RESP2"
msgid "Here you must find your own path."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItem1_00081eb0_Oblivion_RESP1"
msgid ""
"Here you see the Blind Watcher's Eye. A most unusual specimen collected at "
"great peril by... some intrepid adventurer!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MaleneTopic_0018bc38_Oblivion_RESP4"
msgid ""
"Here's 50 gold to cover the costs; that should be more than enough. Come see "
"me when you've got everything, and we'll talk more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElixirofExploration_0004e929_Oblivion_RESP1"
msgid ""
"Here's a Weak Elixir of Exploration. Not bad, eh? If you want more, you can "
"buy them from me. I've discounted them for you, of course."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006dc29_Oblivion_RESP1"
msgid ""
"Here's a copy of the Black Horse Courier. Identity of the Gray Fox revealed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItem10_0008242a_Oblivion_RESP1"
msgid ""
"Here's a new addtion to the Museum, one of my favorites. A dagger that heals "
"whomever it cuts! Isn't that deliciously Odd?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItemB_00082434_Oblivion_RESP1"
msgid ""
"Here's a real Oddity for you -- an arm of one of the Gatekeepers! This one "
"was killed by... oh, I forget now. A lovely specimen in any case."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS12AcceptMission_00018239_Oblivion_RESP3"
msgid ""
"Here's a translation of the passages we could still read. It was quite "
"damaged. I've also included a rough map that was drawn in the diary as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d48b_Oblivion_RESP2"
msgid ""
"Here's how it works. We case The Flowing Bowl for a likely subject. Namely, "
"we look for a married guy who drinks a lot."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001dc28_Oblivion_RESP3"
msgid ""
"Here's my problem. I'm being followed. Watched. Marukhati Selectives, maybe. "
"Not sure. I'm a threat, you see? To their plans. I know too much."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ed6_Oblivion_RESP1"
msgid ""
"Here's one you haven't heard, I bet. The Duke's got his Chalice back. Hmm? "
"See what I mean? Now, what can you do for me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MarkNTestTOPIC_0003459a_Oblivion_RESP1"
msgid "Here's some money."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItem7_00082430_Oblivion_RESP1"
msgid ""
"Here's something truly Odd -- a Soul Tomato! A tomato that can act like a "
"soul gem! No one has yet been able to explain it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItemC_00082437_Oblivion_RESP1"
msgid ""
"Here's the Ring of... well now, where did it go? Things have a way of "
"disappearing around here that's enough to drive a person insane!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Reward_0002585c_Oblivion_RESP1"
msgid ""
"Here's the gold, as promised. I always pay my debts, and then some. Do the "
"last .. task ... in that note, and I will pay you much, much more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0002e5e5_Oblivion_RESP4"
msgid ""
"Here's the key, and something extra. I don't know if it will be of use to "
"you, but from what I've heard of Falcar's ring, it may come in handy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37Errand_000452f8_Oblivion_RESP2"
msgid ""
"Here's the list of things I need. Get me everything on it. Try to remember "
"where you found it so you can tell me. It's important."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PayGoldforCrime_00027fc8_Oblivion_RESP1"
msgid ""
"Here's the procedure. We go to the castle. First we search you, confiscate "
"any stolen goods. Then you pay your fine, and we release you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS43Accept_0004f8c5_Oblivion_RESP1"
msgid ""
"Here's the staff. As soon as you leave, the scamps will thankfully follow. Do "
"be careful, I don't wish your death on my hands as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06Theranis_0004896e_Oblivion_RESP1"
msgid ""
"Here's what I know. Theranis was drinking in the Two Sisters Lodge. He was "
"bragging about stealing something from the castle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006dc23_Oblivion_RESP1"
msgid "Here's your copy of the Black Horse Courier. New Imperial Watch captain."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkBladeClaymore_00014d8d_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkBladeDagger_00014d8f_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkBladeLongsword_00014d91_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkBladeShortsword_00014d93_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkBluntBattleAxe_00014d97_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkBluntMace_00014d99_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkBluntWarAxe_00014d9b_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkBluntWarhammer_00014d9d_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkBow_00014d9f_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkHeavyBoots_00014da1_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkHeavyCuirass_00014da3_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkHeavyGauntlets_00014da7_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkHeavyGreaves_00014da9_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkHeavyHelmet_00014dab_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkHeavyShield_00014dad_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkLightBoots_00014db1_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkLightCuirass_00014e99_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkLightGauntlets_00014e9b_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkLightGreaves_00014db3_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkLightHelmet_00014db5_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkLightShield_00014db7_AltarDeluxe_RESP1"
msgid "Here's your item, Paladin. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MaglirTOPIC2_0002e59e_Oblivion_RESP2"
msgid ""
"Here's your payment for completion of the contract. I think it's time for us "
"to discuss the Blackwood Company a bit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MageConvWait_0006bd94_Oblivion_RESP1"
msgid "Here, Arch-Mage? Very well, I shall wait."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004767e_Oblivion_RESP2"
msgid ""
"Here, have a copy. It's free! Always free! We're funded by the Elder Council, "
"so I don't mind, really. He he he he."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00027668_Oblivion_RESP2"
msgid ""
"Here, kid, this is your payout for the victory. There's more where that came "
"from if you can keep on winning. Now go unwind before your next fight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilD1_00047229_Oblivion_RESP3"
msgid ""
"Here, let me remove them for you ... there. You are no longer a prisoner of "
"the Forbidden Grotto."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeatherleahTopic_00088b2f_Oblivion_RESP3"
msgid "Here, let me show you where it is on your map."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001bb1f_Oblivion_RESP2"
msgid ""
"Here, please take this apron as a token of our friendship. It's not much, but "
"perhaps it will help you in the future."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarMaTopic_0001778d_Oblivion_RESP4"
msgid ""
"Here, take this key. It'll open any of the trapdoors down to the caves. Every "
"house in town has one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001391c_DLCBattlehornCastle_RESP2"
msgid "Here, take this list."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05GwinasC2_0009532e_Oblivion_RESP2"
msgid ""
"Here, take this note they gave me. It tells you where to go. I don't want "
"anything else to do with the Mythic Dawn."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Message_0018bc66_Oblivion_RESP3"
msgid ""
"Here, take this to him. It is not my fault. The job will be finished, I swear "
"it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39MissionChoice1b_00078203_Oblivion_RESP4"
msgid ""
"Here, take this. I don't need it's protection against her mind control "
"anymore. Go now! Pretend we don't know each other."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS49RingYes_00091c5a_Oblivion_RESP2"
msgid ""
"Here, take this. I have no use for it; I'm tired of fighting. It may serve "
"you well in days to come."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000ca29_DLCBattlehornCastle_RESP2"
msgid "Here, take this. It'll tell you all you need to know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000ca2a_DLCBattlehornCastle_RESP2"
msgid "Here, take this. It'll tell you all you need to know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00013416_DLCBattlehornCastle_RESP2"
msgid "Here, take this. It'll tell you all you need to know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39MissionChoice2_00078204_Oblivion_RESP3"
msgid "Here, this book might be of use to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ09JauffreA_00036668_Oblivion_RESP3"
msgid ""
"Here, this is the key to Sancre Tor's outer door. I fear I am sending you to "
"your death, but we have no other choice. You must succeed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ShrineofHircineTOPIC_0001ec53_Oblivion_RESP1"
msgid ""
"Here, we make sacrifice to the Lord Hircine. We pray for a True Hunt. We beg "
"to be Honored Prey."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05TarMeenaC_00022b43_Oblivion_RESP2"
msgid ""
"Here, you can have the library's copy of Volume 2. Treat it gently, if you "
"please!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SECaldanaMonriusSkoomaYes_0008f7ae_Oblivion_RESP2"
msgid "Here, you take this. It's all I got."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27HerminiaF1_000a5608_Oblivion_RESP6"
msgid ""
"Here. I happen to have the key you'll need to enter the royal burial chamber "
"in Lindai. I hope you'll make the right choice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQJauffreHelp_0005dccb_Oblivion_RESP1"
msgid ""
"Here. Perhaps you will find this useful. One of the books I saved from my "
"Blades training."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02JayredLead_0008e4f5_Oblivion_RESP1"
msgid ""
"Here. Take this lockpick. Careful, it's the only one I've got. You open the "
"door. I'll kill things. Let's go!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004013d_Oblivion_RESP2"
msgid ""
"Here. Take this. The reward you have earned. Quickly now. It's best if no one "
"knows you wear this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05GwinasC1_0009532d_Oblivion_RESP2"
msgid "Here. Volume 3 is yours. What you do with it is your business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaChoice2A_0000c1b7_Oblivion_RESP1"
msgid ""
"Here. Wear it proudly. And keep it in good condition, would you? That way I "
"can give it to some other suicidal idiot after you're dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark04FinChoice1A_000253d7_Oblivion_RESP5"
msgid ""
"Here. You will use this specially poisoned knife to stage Motierre's death, "
"in the enforcer's presence. Motierre himself will provide more details."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusD_0001e8e9_Oblivion_RESP3"
msgid "Here. You'll need this key for the last door into the sewers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaFanChoiceHold_000aed4e_Oblivion_RESP1"
msgid ""
"Here? Right here? What about, say... over there? No? Right here? All right "
"then, you're the Grand Champion! Whatever you say!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077c50_Oblivion_RESP1"
msgid "Heretics are misguided worshippers of Arden-Sul."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476a2_Oblivion_RESP1"
msgid ""
"Herminia Cinna. Amateur scholar of the ancient Elves, dabbler in the arcane "
"arts. How can I help you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d289_Oblivion_RESP1"
msgid ""
"Hero of Kvatch? How about the Hero of Bravil! No need to be modest, my friend!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture3_0007194c_Oblivion_RESP1"
msgid ""
"Hestra Runestones are marked with green runes, appear as solitary monuments, "
"and are believed to be named for the late First Era Empress Hestra."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035c8f_Oblivion_RESP1"
msgid ""
"Hey stranger, can you spare a few coins? I've just been shaken down by that "
"bastard watchman and he took my last septim."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0007820a_Oblivion_RESP1"
msgid "Hey there, Chief."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003d4cd_Oblivion_RESP1"
msgid "Hey there, handsome."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00051791_Oblivion_RESP1"
msgid "Hey there, pal! Need a room?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003d4db_Oblivion_RESP1"
msgid "Hey there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008da85_Oblivion_RESP1"
msgid "Hey there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008da97_Oblivion_RESP1"
msgid "Hey there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00043000_Oblivion_RESP1"
msgid ""
"Hey there. I'm Horkvir Bear-Arm. They call me that because I once wrestled a "
"bear, not because I work all day out in my garden without a shirt on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00043003_Oblivion_RESP1"
msgid ""
"Hey there. I'm really busy. Got lots to do. So if you don't mind, make it "
"quick."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e927_Oblivion_RESP1"
msgid "Hey! Good to see you again!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0000345d_Oblivion_RESP1"
msgid "Hey! I've been looking for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PickpocketNoCrime_000626bc_Oblivion_RESP1"
msgid "Hey! Keep your thieving paws to yourself!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e9b0_Oblivion_RESP1"
msgid ""
"Hey! My friend! You made it, huh? That's... That's great. Did... Did you want "
"to just relax, or... Did you want something... something else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488e2_Oblivion_RESP1"
msgid ""
"Hey! That's me you're talking to! Reistr the Rotted! Hear me? Reistr! Wow! I "
"got this a-MAZ-ing itch right on my thigh! Can't touch it! It's rough!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03MyvrynaComplains_000092a7_Oblivion_RESP1"
msgid "Hey! What are you doing?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00062458_Oblivion_RESP1"
msgid "Hey! What did I tell you about weapons! That's it; we're done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AssaultNoCrime_00066334_Oblivion_RESP1"
msgid "Hey! What did you do that for? You some kind of maniac?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AssaultNoCrime_00066337_Oblivion_RESP1"
msgid "Hey! What'd I ever do to you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000151e5_Oblivion_RESP1"
msgid ""
"Hey! Who in Oblivion are you? You don't look like one of the Blackwater "
"Brigands!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004de88_Oblivion_RESP1"
msgid "Hey! Whoa! You shouldn't sneak up on people like that!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_0003335f_Oblivion_RESP1"
msgid ""
"Hey! Wood Elf! You're a little far from the forest, huh? Looks like your days "
"of woodland frolicking have come to a tragic end."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_001778bf_Oblivion_RESP1"
msgid ""
"Hey! You aren't Celia Camoran! There's an intruder in the library! Protect "
"the scrolls!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEHereticAlarm_00052f4f_Oblivion_RESP1"
msgid "Hey! You aren't one of us!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11PriestAlarm_00064621_Oblivion_RESP1"
msgid "Hey! You don't belong here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS02ManorBuyChoice1_0000a1c5_Oblivion_RESP1"
msgid ""
"Hey! You don't even have enough money! Stop wasting my time and come back "
"when you do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StealNoCrime_000626be_Oblivion_RESP1"
msgid "Hey! You don't see me stealing your things!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008547e_Oblivion_RESP1"
msgid "Hey! You said you would unlock the door!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624f3_Oblivion_RESP1"
msgid ""
"Hey, I don't like to tell stories, but Telaendril and me... you know. Don't "
"believe me? I've got her undergarments to prove it! Ha ha ha ha ha!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_TG00MysteriousNoteTopic_00035652_Oblivion_RESP1"
msgid "Hey, I don't read them. I just deliver them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00033ee4_Oblivion_RESP1"
msgid ""
"Hey, I was up in Cropsford the other day. It looks like they're really making "
"a go of it. You did a good thing there, you know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000477fd_Oblivion_RESP1"
msgid ""
"Hey, baby? You fancy some training? Sherina's the name, and blades are the "
"game."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003ea31_Oblivion_RESP1"
msgid ""
"Hey, can you help me? Suicide is bad. I'll just end up on the Hill. But, "
"perhaps you can kill me? Stick me in the heart with something sharp?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_000624fb_Oblivion_RESP1"
msgid "Hey, come on now! There's no need to get violent!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00034077_Oblivion_RESP1"
msgid ""
"Hey, did you hear about that murder in the Talos Plaza District? I think the "
"man's name was Draconis. Yeah, cut down in the prime of his life."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0006fdad_Oblivion_RESP1"
msgid ""
"Hey, did you hear that? Thought I heard someone calling for a guard. I guess "
"that's our cue. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043500_Oblivion_RESP1"
msgid ""
"Hey, did you hear the Gatekeeper is dead? That's valuable information, don't "
"you think? Worth a few coins?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000301d3_Oblivion_RESP1"
msgid "Hey, do you mind not trampling on my crops? What do you want?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08RudeComment_00079bdb_Oblivion_RESP1"
msgid "Hey, don't you walk away from me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000411fa_Oblivion_RESP2"
msgid ""
"Hey, friend, do you think you could help me out? I'm caught a bit short at "
"the moment... anything at all would be much appreciated."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000411fc_Oblivion_RESP1"
msgid ""
"Hey, got any apples? Or carrots? Anything at all crunchy and yummy to eat?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0003403d_Oblivion_RESP1"
msgid ""
"Hey, have you heard about that pirate captain, the one who was murdered in "
"his ship?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00034071_Oblivion_RESP1"
msgid "Hey, have you heard about that strange party at Summitmist Manor?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00034079_Oblivion_RESP1"
msgid ""
"Hey, if I paid you twenty gold to spend a night in the Abandoned House, would "
"you do it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGC03Choice1_00033572_Oblivion_RESP1"
msgid "Hey, if you say so. You do all the work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08CutoffTopic_00079bdd_Oblivion_RESP1"
msgid "Hey, is that you? I hear something over there...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002c7af_Oblivion_RESP1"
msgid "Hey, it's you. The one who found jobs. Whadda you need?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033339_Oblivion_RESP1"
msgid ""
"Hey, lizard! It must break your heart, huh? Being so close to the water, "
"knowing you'll never get to swim again..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000c454d_Oblivion_RESP1"
msgid "Hey, something wrong? They're waiting for you up in the Arena!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StealNoCrime_0006250c_Oblivion_RESP1"
msgid "Hey, take whatever you want. It's none of my business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Steal_000624f8_Oblivion_RESP1"
msgid "Hey, that's mine! Guards! Guards!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033357_Oblivion_RESP1"
msgid ""
"Hey, there! You! Kinsman! I haven't seen another Dunmer in here in I don't "
"know how long. Where you from, huh? Vvardenfell?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00092d7a_Oblivion_RESP1"
msgid ""
"Hey, there's my new pal! So what can I do for you? Need some items? Or maybe "
"you're ready to unload something? Whatever you need!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00146845_Oblivion_RESP1"
msgid "Hey, there, Pit Dog! How's life treatin' ya?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003cc1f_Oblivion_RESP1"
msgid "Hey, what's wrong? Aren't they waiting for you up in the Arena?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_0004f235_Oblivion_RESP1"
msgid "Hey, you hear that? The guards are coming... for you!  He he he he he. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d2a1_Oblivion_RESP1"
msgid "Hey, you look just like your statue! What can I do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035f34_Oblivion_RESP1"
msgid "Hey, you're not supposed to be here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000301d4_Oblivion_RESP1"
msgid "Hey, you're the one made us visible again, right? Good show!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d29b_Oblivion_RESP1"
msgid ""
"Hey, you're the one that helped Captain Burd destroy that damned Oblivion "
"Gate! Well done, friend, well done!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018b201_Oblivion_RESP1"
msgid ""
"Hey, you're the one they call the Hero of Kvatch, aren't you? The one that "
"closed the Oblivion Gate and saved the city?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36HeyYou_00061c3f_Oblivion_RESP1"
msgid ""
"Hey, you. Come over here. I got to ask you something. Something important. "
"Shhhh. Just come over here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36HeyYou_00061c40_Oblivion_RESP1"
msgid "Hey, you. Yeah, you! Come over here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e1f_Oblivion_RESP1"
msgid "Hey. Check out the new associate. Not bad, if you know what I mean."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033588_Oblivion_RESP1"
msgid "Hey..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e9ac_Oblivion_RESP1"
msgid ""
"Hey... Hey! How... What are... What are you... doing here? You're not my... "
"Not my friend. What... You know, what do you... want?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark06Choice1A_0002fbb0_Oblivion_RESP2"
msgid ""
"Hey... Now that we're... we're friends... You want to come with me? To my... "
"my special place? It's not... you know... very far..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00025678_Oblivion_RESP1"
msgid "Hi there!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002b485_Oblivion_RESP1"
msgid "Hi there!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00078209_Oblivion_RESP1"
msgid "Hi there, Sparkles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000256d1_Oblivion_RESP1"
msgid "Hi there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002b492_Oblivion_RESP1"
msgid "Hi there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003d4de_Oblivion_RESP1"
msgid "Hi there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00043016_Oblivion_RESP1"
msgid ""
"Hi there. Not to be rude or anything, but I'm anxious to get back to my book."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00043015_Oblivion_RESP1"
msgid ""
"Hi there. You remind me of one of the characters from a story I've been "
"reading. What can I do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002412f_Oblivion_RESP1"
msgid "Hi!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e0a3_Oblivion_RESP1"
msgid "Hi, I'm Gogan. How's it going?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023de1_Oblivion_RESP1"
msgid "Hi."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000617c3_Oblivion_RESP1"
msgid "Hi."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Ceremony_00014abe_Oblivion_RESP1"
msgid ""
"Hidden away, by virtue of its own self-awareness, was the sixth, containing "
"within it the five which birthed it. Flesh! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMeridiaSpeech_000579bb_Oblivion_RESP1"
msgid ""
"Hidden behind a door, deep in Howling Cave, are necromancers. They rob graves "
"for the materials to raise their undead armies."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002f258_Oblivion_RESP1"
msgid "Hides-His-Heart will be here any moment!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MSShadowscaleChoice1A_00035592_Oblivion_RESP2"
msgid ""
"Hiding in that swamp you will find an Argonian Shadowscale named Scar-Tail. "
"Kill this renegade, and bring me his heart as proof of the deed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_0001ee44_Oblivion_RESP4"
msgid ""
"Hieronymus Lex actually collected taxes from everyone living here on the "
"Waterfront! Your job is to recover those taxes. Are you up for it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07LexReassigned_0001cf43_Oblivion_RESP1"
msgid ""
"Hieronymus Lex has indeed been reassigned. However, you have slain needlessly "
"to accomplish that goal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGHieronymusLex_0001c4e2_Oblivion_RESP1"
msgid ""
"Hieronymus Lex has left the Waterfront? Well done! Methredhel's report tells "
"me that you have done well. You have earned your reward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05HowBad_0000c05c_Oblivion_RESP1"
msgid ""
"Hieronymus Lex has vowed not to leave until the Gray Fox is in custody. The "
"Fox is safe, but the Thieves Guild cannot do business like this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGHieronymusLex_00015f25_Oblivion_RESP1"
msgid ""
"Hieronymus Lex is no longer searching on the Waterfront? This is good. It's "
"too bad you slew innocents to make it happen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07LexReassigned_00015f16_Oblivion_RESP1"
msgid ""
"Hieronymus Lex is still in the Imperial City. Do not speak to me of this "
"again until the letter is properly replaced."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_0000c011_Oblivion_RESP1"
msgid ""
"Hieronymus Lex must be eliminated once and for all. The Gray Fox has asked "
"that you do this personally. It is a most delicate matter."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004762e_Oblivion_RESP1"
msgid ""
"Hieronymus Lex, Officer of the Watch. Every hand is needed to build an honest "
"city, and it begins with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bc91_Oblivion_RESP1"
msgid ""
"High mountain ranges rise to the borders in the north and east, and marshes "
"and rainforests extend to the southeast borders."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VampireAshTopic_000977d8_Oblivion_RESP1"
msgid "Hindaril is destroyed?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Unicorn_0001ec61_Oblivion_RESP2"
msgid ""
"Hircine has deigned to speak with you, and he has provided you with glorious "
"prey. You have been greatly honored. Do not fail him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND09ProphetGreeting03_00002c11_Knights_RESP3"
msgid ""
"His Daedric nature allows his spirit to escape into Oblivion after death. "
"This is what Pelinal learned upon defeating Umaril the first time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS12Reman_000980f6_Oblivion_RESP5"
msgid ""
"His alliance with Lord Vivec during the Akaviri invasion is just one example "
"of his cunning and ingenuity."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09JyggalagTopic_000913cf_Oblivion_RESP1"
msgid ""
"His appearance seems imminent. His hatred for this land, for what it "
"represents, is unimaginable."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MSShadowscaleChoice2A_0003559e_Oblivion_RESP3"
msgid ""
"His body is around here somewhere. Present the Agent's heart to Teinaava as "
"proof, and he'll be none the wiser."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e553_Oblivion_RESP2"
msgid "His brothers were less... successful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE43Ushnar_00072dc0_Oblivion_RESP2"
msgid ""
"His dog can be a terror. I once saw him sic it on a guy who tried to steal "
"the dog's food."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetSpeechUmaril2_00002d0d_Knights_RESP1"
msgid ""
"His golden-wickedness will hold fast against all arms except those of his "
"ancient foe, the Whitestrake!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RolandJensericTopic_0001d246_Oblivion_RESP1"
msgid ""
"His home is located in the Temple District. Right across the garden from my "
"home in fact. Ironic, isn't it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Inventory_0000bca3_Oblivion_RESP1"
msgid ""
"His inventory must be stolen. It has to be. He prices less than it costs to "
"make some of those things. Go see for yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02JauffreD2_00092d86_Oblivion_RESP4"
msgid ""
"His meaning is unclear to me as well. The Emperor seemed to perceive some "
"threat from the demonic world of Oblivion. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_confidence_0002d721_Oblivion_RESP1"
msgid ""
"His mother's been holding him back, protecting him. You'll go to Nonwyll "
"Cavern with him. Galtus Previa was lost there, and you're to find him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10accept_00015309_Oblivion_RESP2"
msgid ""
"His name is Jakben, and he lives somewhere in the Imperial City. There might "
"be a clue in the Earl's house."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02JauffreE1_0001e74d_Oblivion_RESP1"
msgid ""
"His name is Martin. He is a priest in the Chapel of Akatosh in Kvatch. Yes, "
"Kvatch."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02JauffreE1_0001e74e_Oblivion_RESP1"
msgid ""
"His name is Martin. He serves Akatosh in the Chapel in the city of Kvatch, "
"south of here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE43Ushnar_00072dc1_Oblivion_RESP2"
msgid ""
"His new dog though, it can be mean. He's trained it to attack cats and anyone "
"that tries to take its food."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002c58d_Oblivion_RESP1"
msgid "His ring. Have you pried it from the coward's corpse?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RufioTopic_00023dd3_Oblivion_RESP2"
msgid ""
"His room is downstairs, in what I like to call the Private Quarters. Use that "
"hatch in the floor over there. But don't expect a warm reception."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ16OcatoE_000add1e_Oblivion_RESP2"
msgid ""
"His sacrifice was necessary, but it leaves the Empire without an emperor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14ChoiceHeard_0001b947_Oblivion_RESP2"
msgid ""
"His speciality is setting the Great Forest to canvas. The paintings look so "
"amazingly real that some say they can see the trees sway in the breeze."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE01HaskillChoice4_000133e3_Oblivion_RESP2"
msgid ""
"His will is His own; His reality follows suit. You are here because you chose "
"to enter; you were not summoned."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00091a8c_Oblivion_RESP1"
msgid "Hiss!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00038ee5_Oblivion_RESP1"
msgid "Hissss!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Nd05Julianos_00002ae9_Knights_RESP1"
msgid "History and knowledge are his domain. He is the God of Wisdom and Logic."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SERooftopCheer_00082741_Oblivion_RESP1"
msgid "Hit her harder!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00051dc6_Oblivion_RESP1"
msgid "Hit me once more, and I'll kill you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033b30_Oblivion_RESP1"
msgid "Hither to me, good varlet."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32HlovalsMagicka_000135cf_Oblivion_RESP1"
msgid ""
"Hloval dances a little too close to Sheogorath, if you know what I mean. "
"Those born with stunted magicka shouldn't become priests and healers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32HlovalsMagicka_00012d1e_Oblivion_RESP1"
msgid ""
"Hloval healed my betrothed once. Then he ran out of magic. He said he needed "
"to find someone to lend him some before he could help her more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32HlovalsMagicka_0008efd0_Oblivion_RESP1"
msgid ""
"Hloval's treachery is second only to my cowardice. My curse will not allow me "
"to help you with his need."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_000175b6_Oblivion_RESP3"
msgid "Hmm, I can't remember. Deetsan would know, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000131d3_Oblivion_RESP2"
msgid ""
"Hmm, could you, in fact, imagine just how long I've been waiting? I don't "
"think you could, but I might be wrong. I might also not care. Which is it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002eddc_Oblivion_RESP1"
msgid "Hmm, what? I'm rather busy right now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00072f0b_Oblivion_RESP1"
msgid "Hmm, what? Oh, hello."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MageTalk4_0006a86e_Oblivion_RESP1"
msgid ""
"Hmm-hmm. Exactly. But now what? Do I continue with that line of study, or "
"shall I delve into something more archaic? Say... ancient Ayleid curses?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Unseen_0018d820_Oblivion_RESP1"
msgid "Hmm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity8_00081e8f_Oblivion_RESP3"
msgid ""
"Hmm. A bowl that you mix potions in. Doesn't seem all that Odd to me... well, "
"I can see you're trying, so I'll find somewhere to put it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0006244d_Oblivion_RESP1"
msgid ""
"Hmm. A trade is in order, don't you think? My services in exchange for... oh, "
"let's say ten Welkynd Stones. I'd say that's fair."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark11Choice3C_00002dd7_Oblivion_RESP1"
msgid ""
"Hmm. All right, then. You're not one for talking. I can respect that. Well, "
"if you need anything, you just let me know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Corpse_00062512_Oblivion_RESP1"
msgid "Hmm. Body's still warm. Looks like there's a killer about."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_000039e2_Oblivion_RESP1"
msgid ""
"Hmm. Don't get me wrong, that magic arrow sounds nice and all, but it seems "
"to me like you don't even need to use it to get the bonus."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NecromancersMoon_00002dc3_Oblivion_RESP2"
msgid ""
"Hmm. I have never heard of this \"Shade of the Revenant.\" Some sort of "
"celestial phenomenon?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark03FinChoice1B_00023e53_Oblivion_RESP1"
msgid ""
"Hmm. I thought you'd jump at the opportunity to infiltrate the most heavily "
"fortified prison in all of Cyrodiil. Maybe I overestimated you after all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0002d6e4_Oblivion_RESP2"
msgid ""
"Hmm. It's a pity you don't have the right sort of friends. Friends that would "
"be willing to help out with a task like that."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_MG11ChoiceBlackSoulGems_00033635_Oblivion_RESP1"
msgid ""
"Hmm. Now that is a bit more specific. Finally, something I can respond to!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Lost_0018d81d_Oblivion_RESP1"
msgid "Hmm. Strange."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004564e_Oblivion_RESP1"
msgid ""
"Hmm. This Scalon looks a bit mangy, but I suppose it will do. Your reward is "
"in the house."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Lost_00081a3c_Oblivion_RESP1"
msgid ""
"Hmm. This place will be more peaceful once Lord Jyggalag resumes his throne."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG00JoinB_0002d072_Oblivion_RESP1"
msgid "Hmm. Well, that's your choice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07ForgeThisLetter_0000c01a_Oblivion_RESP1"
msgid ""
"Hmm. Yes, it can be done. I can change it to give Lex the highest "
"recommendation. I'll need a full day to properly forge this letter. Return "
"then."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00035a31_Oblivion_RESP1"
msgid "Hmm. You don't look like a vampire..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItemB_00082435_Oblivion_RESP1"
msgid ""
"Hmm. You haven't seen a huge severed arm with an axe for a hand anywhere, "
"have you? I seem to have misplaced mine. Ah, well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItem4_00081ec5_Oblivion_RESP1"
msgid ""
"Hmm... I could have sworn that I used to keep something very Odd on this "
"shelf. Oh well. Let's move on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Help_00098144_Oblivion_RESP2"
msgid ""
"Hmm... if you're serious, maybe I can put you to use. It'll likely mean your "
"death, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SERunsInCirclesGreetG_00041210_Oblivion_RESP1"
msgid "Hmm... not bad! Better than my old pair. Thanks, friend!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BookResponses_000277bd_Oblivion_RESP1"
msgid "Hmm... not my favorite work, but many enjoy it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Noticed_000a01af_Oblivion_RESP1"
msgid "Hmm?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37Beast_00045660_Oblivion_RESP1"
msgid ""
"Hmm? I suppose it is about time for me to add another creature. I have hopes "
"for an Elytra. If you see one, could you bring it around for me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007327d_Oblivion_RESP1"
msgid ""
"Hmm? Oh, Caenlin's my name. Maybe you knew my uncle, Baenlin? He died "
"recently. It was all very tragic. I'm heartbroken, of course. Well, goodbye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007327c_Oblivion_RESP1"
msgid ""
"Hmm? Oh, Caenlin's my name. Maybe you knew my uncle, Baenlin? He died "
"recently. Stuffed head fell on him. Very tragic. Well, goodbye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JskarTopic_0002d587_Oblivion_RESP1"
msgid "Hmm? Oh, Jeanne has you looking for him, does she?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003a90f_Oblivion_RESP1"
msgid "Hmm? Oh, yeah... Bye..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004de8b_Oblivion_RESP1"
msgid "Hmm? Oh, yes, goodbye..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000852c0_Oblivion_RESP1"
msgid "Hmm? Oh, yes, maybe we'll speak again later."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MageTalk1_0006a85c_Oblivion_RESP1"
msgid "Hmm? Oh, yes, of course. What is it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006a842_Oblivion_RESP1"
msgid ""
"Hmm? Yes, yes, I'm sure you've got something exceedingly important to say. "
"But the Apprentices do not teach themselves, now do they? Good day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000908e7_Oblivion_RESP1"
msgid "Hmmm, wonder if it's too late to ask for less rat in tomorrow's dinner?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE09MiscRelmynaExperiment_00046f40_Oblivion_RESP1"
msgid "Hmmm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000b121b_Oblivion_RESP1"
msgid "Hmmm. Another comes to us. What is it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23SeridurNotYet_0001d4ca_Oblivion_RESP1"
msgid ""
"Hmmm. He must have known we'd look there. Search around town and see if you "
"can find any more information."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07NewCaptain_00098399_Oblivion_RESP3"
msgid ""
"Hmmm. Hieronymus Lex looks like the best choice. I was about to give the "
"position to Dairihill's cousin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_thieves_00002e5f_Oblivion_RESP1"
msgid "Hmmm. I don't think I know you well enough to tell you that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09GiveArrowHead_0001482a_Oblivion_RESP1"
msgid ""
"Hmmm. I had hoped for the whole arrow, but that is not your fault. I will "
"have to have it repaired."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09GiveArrowHead_0001cf36_Oblivion_RESP1"
msgid ""
"Hmmm. I had hoped for the whole arrow, but that is not your fault. I will "
"have to have it repaired."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE09MiscRelmynaExperiment_00046f69_Oblivion_RESP1"
msgid "Hmmm. Is this too much pain?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004798c_Oblivion_RESP1"
msgid "Hmmm. Maybe he lives in the Elven Gardens district."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Nirnroot_0004e93e_Oblivion_RESP1"
msgid "Hmmm. No. Never seen one of those before. Strikingly beautiful."
msgstr ""

