msgid "Farewell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000a7131_Oblivion_RESP1"
msgid "Farewell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000c4537_Oblivion_RESP1"
msgid "Farewell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000c453f_Oblivion_RESP1"
msgid "Farewell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00146817_Oblivion_RESP1"
msgid "Farewell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0015974f_Oblivion_RESP1"
msgid "Farewell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001e7d3_Oblivion_RESP1"
msgid "Farewell. May the roads carry you safely in your journeys."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008f10d_Oblivion_RESP1"
msgid "Farewell. So much to bake, so little time!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00060954_Oblivion_RESP1"
msgid "Farewell. Stay safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e11f_Oblivion_RESP3"
msgid ""
"Farewell. You've been a good friend, in the short time that I've known you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00066cd0_Oblivion_RESP1"
msgid ""
"Farwil Indarys almost got himself killed in Cheydinhal. Here. Take my Black "
"Horse Courier. It's all in there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FawilTopic_00031844_Oblivion_RESP1"
msgid ""
"Farwil is a Dunmer, and he's wearing steel plate armor. His shield should "
"bear the crest of the Knights. Nothing but the best for the Count's son."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0008c216_Oblivion_RESP1"
msgid "Fate chose you well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ValusOdiilTopic_000b6c10_Oblivion_RESP1"
msgid "Father will be so proud of us... but I wish he'd been here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS18Convo_0002b1c9_Oblivion_RESP1"
msgid ""
"Father's not scared - don't you dare say that! You'll see when he gets here. "
"I'll ask him, and then you'll see!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PickpocketNoCrime_00098389_Oblivion_RESP1"
msgid "Fathis Aren's pockets are not for you, thief!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476b4_Oblivion_RESP1"
msgid ""
"Fathis Ules. I've got a nice house. I have a little income... quite "
"comfortable. Time is light on my hands."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00084b3e_Oblivion_RESP1"
msgid "Fear not, our paths may cross again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008db86_Oblivion_RESP1"
msgid ""
"Fear the woody Gnarl, the tree that walks and creeps. If you strike them with "
"a spell, the magic it will keep."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECreatureResponses_0008e10f_Oblivion_RESP1"
msgid ""
"Fear the woody Gnarl, the tree that walks and creeps. If you strike them with "
"a spell, the magic it will keep."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09BodyParts_0001357a_Oblivion_RESP1"
msgid ""
"Fearing one day someone might manage to kill my child, I have been preparing "
"a new body."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEDerveninSpeech03_000898f3_Oblivion_RESP1"
msgid ""
"Feast until your belly is full, then fill the wine goblets once more and "
"toast our fortune."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00086096_Oblivion_RESP1"
msgid "Feed me, Lord!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000bf16b_Oblivion_RESP1"
msgid "Feeding time is over, vampire! Go back to the grave that spawned you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000b5ab_Oblivion_RESP1"
msgid "Feel free to browse, friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001671c_Oblivion_RESP1"
msgid ""
"Feel free to browse, friend. It's nice to see a new shopper. I was afraid I "
"lost any hope of new business ever since Thoronir opened up."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00038f25_Oblivion_RESP1"
msgid ""
"Feel free to question anyone in town, they shouldn't give you too much "
"trouble."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007cfdf_Oblivion_RESP1"
msgid ""
"Feel free to take what you need. The fruits of the conservatory are for all "
"to enjoy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05Gwinas_00022b46_Oblivion_RESP3"
msgid "Feel free to wait for him if you want to speak to him yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_00098388_Oblivion_RESP1"
msgid "Feel the wrath of my ancestors!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00086093_Oblivion_RESP1"
msgid "Feel this!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000c47de_Oblivion_RESP1"
msgid ""
"Feet are for walking. Hands are for hitting. Or shaking. Or waving. Sometimes "
"for clapping."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000181bb_Oblivion_RESP3"
msgid ""
"Felas and I slipped down here thinking that we'd be safe. But, no! We landed "
"right in the middle of them!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000181bb_Oblivion_RESP4"
msgid ""
"Felas ran off with them and left me to die! Me! That ingrate! Disloyal cur! "
"Imagine, leaving me here all alone!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFelldew_000206f8_Oblivion_RESP2"
msgid ""
"Felldew is a poison, little one. A very dangerous drug. You'll feel good at "
"first, but that wears off, and if you go long without it, you'll suffer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEChaliceofReversal_00018b7b_Oblivion_RESP3"
msgid ""
"Felldew is a poison. It kills. And yet Thadon uses the Chalice he created to "
"twist Felldew into a drug he takes for his own amusement. How sick."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE14Attacks_0004681e_Oblivion_RESP1"
msgid ""
"Fellmoor can still use your assistance, assuming you can find time in your "
"schedule."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008dc2a_Oblivion_RESP1"
msgid ""
"Fellmoor must be a lovely place to live. You should visit there, right away."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000825f4_Oblivion_RESP1"
msgid "Fellmoor must be a terrible place to live."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033586_Oblivion_RESP1"
msgid "Fellow Knight! I bid you welcome."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00069477_Oblivion_RESP1"
msgid "Fellow magister, may I speak with you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008da8c_Oblivion_RESP1"
msgid "Fetcher."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00066eb9_Oblivion_RESP1"
msgid "Fetid Grove is a dangerous place... please be cautious."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06ArctusGreetA_00040144_Oblivion_RESP3"
msgid ""
"Few know that the Hero who lights the Torch for Dementia is granted the "
"Raiment of Intrigue, a boon for those who would gain access to hidden "
"knowledge."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04GreymarchTopic_00091020_Oblivion_RESP2"
msgid ""
"Few of the citizens can remember the last Greymarch. Or they choose not to."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture5_00071960_Oblivion_RESP1"
msgid ""
"Few records survive from the Dark Ages of the Potentates. Thus might the "
"secrets of the runestones be lost... in wickedness, vainglory, and neglect."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0006b83f_Oblivion_RESP1"
msgid "Fight fire with fire!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02OrcCaptainOrders_00018fc2_Oblivion_RESP1"
msgid "Fight like you mean it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062cc2_Oblivion_RESP1"
msgid "Fight well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AssaultNoCrime_00062503_Oblivion_RESP1"
msgid "Fight! Fight! Fight!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_00047685_Oblivion_RESP3"
msgid ""
"Fighters Guild has no accommodations in town. Mages Guild members have their "
"own quarters at the Arcane University."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e48_Oblivion_RESP1"
msgid "Fighters Guild is still better for sensitive jobs, and you know it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003e24d_Oblivion_RESP1"
msgid ""
"Fighters Guild members have been going to Sherina to learn blade skills. "
"She's good, and she'll be the first to tell you so."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_jointheBlackwoodCompany_000a5652_Oblivion_RESP2"
msgid ""
"Fighters Guild, aren't you? Done many jobs for them recently. Yes. What makes "
"you want to join us? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e88a_Oblivion_RESP3"
msgid ""
"Fighting is fine with me, too, only the Guard objects, and they'll fine you "
"or lock you up. Not my call."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624c5_Oblivion_RESP1"
msgid ""
"Fighting's easy. Just lead them out on the water and shoot them full of "
"holes. If you've got a bow, of course, and can walk on water."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfd3_Oblivion_RESP1"
msgid "Filthy Orc! I smell you from here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_goblins_000288b7_Oblivion_RESP1"
msgid ""
"Filthy animals. Some of my kinsmen are partial to them, but I find them "
"reprehensible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00053797_Oblivion_RESP1"
msgid "Filthy convict scum."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark04DrethConvo_00045f82_Oblivion_RESP1"
msgid ""
"Filthy cur! I told you I was going to get out of here! My time's almost up, "
"and there's nothing you can do about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Pickpocket_00062273_Oblivion_RESP1"
msgid "Filthy pickpocket! What did you take?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06PaleLady_00015321_Oblivion_RESP1"
msgid ""
"Filthy vampire! She took my cellmate Theranis a few days ago. If it hadn't "
"been for you, I would have been next."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS18OdiilTalk01_0002b1cd_Oblivion_RESP1"
msgid "Filthy vermin!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00071fa7_Oblivion_RESP1"
msgid "Fimmion gone. Bye bye. Go find pumpkin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00071f2f_Oblivion_RESP1"
msgid "Fimmion hungry. Got food? Sweetcakes? Sausages?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE44FimmionChoice3_0007877d_Oblivion_RESP1"
msgid "Fimmion hungry. Sweetroll for Fimmion. Pants for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE44PantsFimmion_0007877a_Oblivion_RESP1"
msgid "Fimmion hungry. Want sweetroll. Fimmion like pants. Love sweetroll."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE44FimmionChoice2_0007877c_Oblivion_RESP1"
msgid "Fimmion sad. Want sweetroll. No pants for you. Fimmion hungry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46DoublesTopic_0008fa83_Oblivion_RESP1"
msgid ""
"Finally killed him, huh? Thanks. It would have been a lot of effort to find "
"someone else to do it. You've got more to get rid of, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAClavicusChoice4_00026b17_Oblivion_RESP4"
msgid ""
"Finally signed on with some mercenaries, but I hear that ended, too. We "
"haven't seen her in years."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAClavicusChoice6_00026b19_Oblivion_RESP4"
msgid ""
"Finally signed on with some mercenaries, but I hear that ended, too. We "
"haven't seen her in years."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5a4_Oblivion_RESP1"
msgid "Finally something interesting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00016720_Oblivion_RESP1"
msgid ""
"Finally! A new customer! Please... look around. Just promise me you won't buy "
"from that fetcher, Thoronir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalk3_00002bb8_Knights_RESP1"
msgid ""
"Finally! A purpose worth fighting for! In truth, I long for righteous battle! "
" When do we set out? What's our strategy?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007ac72_Oblivion_RESP1"
msgid "Finally! My collection is complete!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CastleResidents_000038ba_Oblivion_RESP3"
msgid ""
"Finally, I would try speaking to Orok gro-Ghoth who is my Steward. He resides "
"in the Private Quarters section as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00068853_Oblivion_RESP1"
msgid "Finally, I'll be able to retire."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00018c6b_Oblivion_RESP1"
msgid "Finally, Lord Sheogorath has sent someone to assist me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00053768_Oblivion_RESP1"
msgid "Finally, a chance for revenge."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607b7_Oblivion_RESP1"
msgid ""
"Finally, all this mess is sorted out. I can get back to my work. Oh, I've "
"lost so much time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetA2_00002b86_Knights_RESP4"
msgid ""
"Finally, he found what he was looking for. We went to Underpall Cave, and "
"there... he fell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003160f_Oblivion_RESP1"
msgid "Finally, no need to sleep with an eye open."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006094f_Oblivion_RESP1"
msgid ""
"Finally, some peace and quiet around here... now I can get some serious work "
"done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG05Choice2A_0001e852_Oblivion_RESP1"
msgid ""
"Finally. I shall see to it that the book is kept safe until the Council "
"decides what should be done with it. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003c9d4_Oblivion_RESP1"
msgid "Finally... back to the real world."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugoTopic_000908d9_Oblivion_RESP2"
msgid ""
"Find Black Brugo, and execute him for his crimes, and I will make both you "
"and your friend Mazoga Knights-Errant of the White Stallion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_000613a6_Oblivion_RESP1"
msgid ""
"Find Marana Rian in the Imperial City. She can teach you what you wish to "
"know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d88c_Oblivion_RESP1"
msgid ""
"Find Olyn Seran. Look for him at a Daedric Shrine; that's where he probably "
"is."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00062452_Oblivion_RESP1"
msgid ""
"Find Tandilwe at the Temple of the One in the Imperial City. She can train "
"you further."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007300d_Oblivion_RESP1"
msgid "Find comfort in your powerlessness."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00054824_Oblivion_RESP4"
msgid "Find him, and close shut the jaws of Oblivion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_jobs_0002c7b9_Oblivion_RESP1"
msgid ""
"Find ingredients for Margarte, huh? Works for me. I'll let the other men "
"know. Appreciate your help, friend. And Oreyn should be happy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02BoneArrowsChoice_0003ea9c_Oblivion_RESP1"
msgid "Find me in a few hours. We'll kill the Gatekeeper."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30Matrices_0001e696_Oblivion_RESP3"
msgid ""
"Find me one of these matrices and enough Amber, and I will craft you a "
"magical item. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG14Choice1A_0000a0fd_Oblivion_RESP3"
msgid "Find out if Jeanne is all right, and let me know if she needs anything."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10HelpGF_0001530d_Oblivion_RESP4"
msgid ""
"Find out where Springheel Jak is buried and bring me back those boots. Will "
"you do this for me? It pays well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServicetoLeyawiinTopic_000860b5_Oblivion_RESP2"
msgid ""
"Find out why she is here, and report to me, and you will earn a reward "
"suitable for those who serve Leyawiin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000175bf_Oblivion_RESP1"
msgid "Find someone else to bother, won't you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45ForkTopic_00078782_Oblivion_RESP1"
msgid "Find the Fork! Bring it to Big-Head! Sing it to Big-Head!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002975_Knights_RESP1"
msgid ""
"Find the Priestesses of Kynareth. Only they can guide you to the boots. All I "
"can do is set you on the path."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00089938_Oblivion_RESP3"
msgid ""
"Find the Sigil Stone. Remove it, and the Gate will close! Hurry! The Keeper "
"has the key-- you must get the key!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033b2e_Oblivion_RESP1"
msgid "Find the Stone, please!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000327b6_Oblivion_RESP1"
msgid "Find the fugitives. Make yourself useful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001e6fd_Oblivion_RESP4"
msgid "Find the last of my blood, and close shut the marble jaws of Oblivion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05TarMeenaB_00022b42_Oblivion_RESP2"
msgid ""
"Find them, eh? I won't poke my nose any further. Official business and all "
"that. I'm used to working with the Blades, don't worry. Say no more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMeridiaSpeech_000579ba_Oblivion_RESP1"
msgid ""
"Find these necromancers. Destroy them and their abominations. Do this, and "
"earn the gratitude of Meridia."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalSpeech_00084a4d_Oblivion_RESP1"
msgid ""
"Find these thieves in the city that spans the waters. Learn where they hide "
"my Eye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaAgronakChoice3_00038ed3_Oblivion_RESP2"
msgid ""
"Find this proof and return it to me, and I'll share with you some of my "
"finest combat techniques. Trust me, you can't learn these moves in a book!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaAgronakChoice4_00038ed7_Oblivion_RESP4"
msgid ""
"Find this proof and return it to me, and I'll share with you some of my "
"finest combat techniques. Trust me, you can't learn these moves in a book!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_000895e7_Oblivion_RESP1"
msgid ""
"Find those who plot against me. Bring them to me so I might make an example "
"of them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0002c308_Oblivion_RESP1"
msgid "Finding that book should be your top priority, Associate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JeanneFrasoricTopic_000836cb_Oblivion_RESP1"
msgid ""
"Finding ways to confuse her just never gets old for me. It's good practice of "
"our skills too. But it's mostly just funny."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGJoin2_00024285_Oblivion_RESP1"
msgid ""
"Fine by me. No great loss. Let me know if you change your mind, though. We "
"can always use fresh meat."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000919c2_Oblivion_RESP1"
msgid "Fine greetings to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ09Leave_00066f2e_Oblivion_RESP1"
msgid ""
"Fine then. I'll find someone else. Someone who isn't too busy to help a "
"desperate old man."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45Wait_00028695_Oblivion_RESP1"
msgid "Fine, but don't be gone too long."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE44NothingMore_0007876f_Oblivion_RESP1"
msgid "Fine, but hurry back when you do! It's coming soon. I can tell!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD07Choice1_000356e1_Oblivion_RESP1"
msgid "Fine, fine. I'll come with you. My guards are dead. You win, for now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607ef_Oblivion_RESP1"
msgid ""
"Fine, fine. So the Realm still stands. That doesn't mean there are any fewer "
"Scalons in the Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS04Here2_0003d30b_Oblivion_RESP1"
msgid "Fine, then best be on your way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerStatus_000241fb_Oblivion_RESP1"
msgid "Fine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HappyReceive_00024258_Oblivion_RESP1"
msgid "Fine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerStatus_000241f9_Oblivion_RESP1"
msgid "Fine. And you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0002b7ac_Oblivion_RESP1"
msgid "Fine. Be that way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS08KurdanBoatNo_0001f42f_Oblivion_RESP1"
msgid ""
"Fine. But you better not take too long. I want that axe, and I want it now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Choice4_000b1674_Oblivion_RESP1"
msgid "Fine. Here's your money. Let me know if you find more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS08KurdanBoatYes_0001f430_Oblivion_RESP1"
msgid ""
"Fine. I have it waitin' for you at the dock next to the magic shop. Now get "
"outta my sight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE01HaskillChoice9_0005e371_Oblivion_RESP1"
msgid ""
"Fine. I'm sure my Lord will be most pleased, assuming you ever manage to see "
"Him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09AssistanceCommand_0001356e_Oblivion_RESP1"
msgid ""
"Fine. If it be my Lord's will, then it is also my own. But, I am too "
"distraught over the death of my child to return to his womb. This, you must "
"do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08SheldenEnd_00043f71_Oblivion_RESP1"
msgid "Fine. Just leave me here to die. Not like anyone will miss me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGC03Choice2_00033573_Oblivion_RESP1"
msgid "Fine. Let's move."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedNo_0005dac2_Oblivion_RESP1"
msgid "Fine. One less thing for me to clean up afterwards."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38DionneWarnChoice2_0001dcc3_Oblivion_RESP1"
msgid ""
"Fine. Play it that way. Let me give you some friendly advice. Glarthir is "
"crazy. Maybe harmless crazy, maybe not."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_0009ea94_Oblivion_RESP1"
msgid ""
"Fine. Take the stairs up to the right, the room on the left. No visitors "
"allowed. And no pets."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PinerDEMO1_0002ae2c_Oblivion_RESP1"
msgid "Fine. Thanks for asking."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGJoin1_0002427c_Oblivion_RESP1"
msgid ""
"Fine. You are now an Associate in the Fighters Guild. For contracts, speak "
"either with me or with Burz gro-Khash in Cheydinhal. Good luck to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD07Choice5_0009819e_Oblivion_RESP1"
msgid "Fine. You don't scare me. Beat me, torture me. I'll never talk to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_duties_0002c7c0_Oblivion_RESP1"
msgid "Fine. You know what's wrong. How about you go and fix it? NOW!!!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ShadyDeal_0001e7ee_Oblivion_RESP1"
msgid ""
"Fine. You made your point. Contact me when you have the items, and we'll meet "
"again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGC01Choice2_0003663d_Oblivion_RESP2"
msgid ""
"Fine. You've got me. I figured if I left some rotten meat outside, the nasty "
"little things would come out, and the guards would take care of them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG06Choice1B_000302d4_Oblivion_RESP1"
msgid ""
"Fine. Your loss though, isn't it? Can't get that recommendation you need."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS43ScampsNo_0004f78d_Oblivion_RESP1"
msgid "Fine... just get out... I can take care of myself!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033797_Oblivion_RESP1"
msgid "Finish it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00018c8f_Oblivion_RESP1"
msgid "Finish what you've started, friend. It'll do wonders for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007ac6e_Oblivion_RESP1"
msgid ""
"Firm arms. A strong back. Yes. You'd do nicely. It's a shame. Time will "
"ravage you, destroy you. Whither you. But there are... alternatives."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_000363db_Oblivion_RESP1"
msgid ""
"First I'll kill you. Then I'll get Ruslan and Luronk. You'll all pay for what "
"you did to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025e14_Oblivion_RESP1"
msgid ""
"First a theft, and now a murder. Your crimes are escalating. You have one "
"final chance. Go out and collect the horns of twenty minotaurs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29StopAgarmir_0001d047_Oblivion_RESP2"
msgid ""
"First and foremost, I will never meet with him again. I can promise you that. "
"Secondly, I remember him mentioning a place he had to be this very day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b587_Oblivion_RESP1"
msgid "First the vision. Then the conjuration. This is unsettling."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_0003333f_Oblivion_RESP1"
msgid ""
"First they starve you. Then they beat you. Then, if you're lucky, they kill "
"you. That's right. You're going to die in here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalk4_00002bbf_Knights_RESP1"
msgid ""
"First things first, fellow knight. We prepare a feast! To celebrate our "
"divine duty, and say farewell to those we would leave behind.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025e18_Oblivion_RESP1"
msgid ""
"First you murder, now you steal? Have you gone mad? You're a disgrace. I will "
"offer you one final chance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusD_0001e8e9_Oblivion_RESP1"
msgid ""
"First you need to get out of here. Through that door must be the entrance to "
"the sewers, past the locked gate. That's where we were heading."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture1_00071940_Oblivion_RESP1"
msgid ""
"First, all rune-marked ancient stones are called runestones, though there "
"are, in fact, two very different classes of runestones."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGRules_0001c154_Oblivion_RESP1"
msgid "First, never steal from another member of the guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09CeremonyStart_00014aec_Oblivion_RESP1"
msgid "First, place the Gatekeeper's body into the Cistern of Substantiation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Ceremony_0007b152_Oblivion_RESP1"
msgid "First, place the Gatekeeper's body into the Cistern of Substantiation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MazogaTalk03_0008656f_Oblivion_RESP1"
msgid ""
"Fisherman's Rock is north of Leyawiin, about six hours walk, on a point of "
"land on the eastern shore of the Niben."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG12FithragaerWho_00095025_Oblivion_RESP1"
msgid "Fithragaer. Battlemage. Sent by the Council to find this traitor...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e0f_Oblivion_RESP1"
msgid "Five of the afternoon watch, and all's well. No problems, ma'am. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023eb3_Oblivion_RESP1"
msgid "Five of the afternoon watch, and all's well. No problems, sir. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e1e_Oblivion_RESP1"
msgid "Five of the night watch, and all's well. You're out late, ma'am. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023ee7_Oblivion_RESP1"
msgid "Five of the night watch, and all's well. You're out late, sir. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c98e_Oblivion_RESP1"
msgid ""
"Fjotreid. You need armor or weapons, new or repair, come to Hammer and Axe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11SheogorathChoice1_00014b69_Oblivion_RESP2"
msgid ""
"Flee while you can, mortal. When we next meet I will not know you, and I will "
"slay you like the others."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_0008f03f_Oblivion_RESP1"
msgid "Flee, Fanatic!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077c41_Oblivion_RESP1"
msgid ""
"Flesh Atronachs are dangerous. Some are smart enough to heal themselves when "
"they're hurt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003c342_Oblivion_RESP1"
msgid ""
"Flyyyin'... flyyin' in the skyyyy.... cliff racer flys so high.... flyinnn'..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000ace65_Oblivion_RESP1"
msgid "Folks think we're all evil? What do they know? Do I look evil?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00091881_Oblivion_RESP2"
msgid ""
"Follow Wide-Eye. I think she mentioned an errand she runs? That would be your "
"best bet."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG12FithragaerSent_00095024_Oblivion_RESP4"
msgid "Follow me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06ShoutStartCombat_00054fa7_Oblivion_RESP1"
msgid "Follow me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006b1b4_Oblivion_RESP1"
msgid "Follow me! For Kvatch!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0006b828_Oblivion_RESP1"
msgid "Follow me! The Temple is our only hope!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00019fc4_Oblivion_RESP1"
msgid "Follow me! You are deserving to bear witness to Ciirta's destruction!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002936_Knights_RESP1"
msgid ""
"Follow me, if you also seek the divine wisdom of Julianos. His Wayshrine is "
"this way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028d34_Oblivion_RESP3"
msgid ""
"Follow me, my friend, and watch my back. Dovesi must be brought to justice, "
"and I'm the one to do it! Let's go!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000092b8_Oblivion_RESP1"
msgid "Follow me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000093ab_Oblivion_RESP1"
msgid "Follow me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02JayredLead_00012060_Oblivion_RESP1"
msgid "Follow me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00095890_Oblivion_RESP1"
msgid ""
"Follow me. I know how to get to the part of the sewers where we need to meet "
"the Sponsor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002993_Knights_RESP1"
msgid ""
"Follow me. Lord Vlindrel's tomb is just through here. Be careful... the "
"wraith may be upon us at any moment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CropsfordTopic_00033ef8_Oblivion_RESP1"
msgid ""
"Follow the Yellow Road northwest from here. You'll see the supplies they had "
"to abandon when the goblins attacked."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDPilgrimageTopic_00002a9a_Knights_RESP3"
msgid ""
"Follow the map I gave you. Visit the Wayshrines of the Nine, pray, and wait "
"for a sign."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDPilgrimageTopic_00002a9b_Knights_RESP3"
msgid ""
"Follow the map I gave you. Visit the Wayshrines of the Nine, pray, and wait "
"for a sign."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035672_Oblivion_RESP5"
msgid ""
"Follow the road west out of Skingrad, through the High Pasture. The mine "
"entrance is north of the road. The Count will meet you just outside it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11KnifePointHollow_00014b5f_Oblivion_RESP2"
msgid ""
"Follow the setting sun to the border of Mania. Climb the cliff there to the "
"top. At the peak, you will find Knifepoint Hollow."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11Dyus1b_0001a816_Oblivion_RESP1"
msgid ""
"Following each cycle of the Greymarch, Sheogorath has cast out or killed "
"every aspect of Order found in the Shivering Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11Dyus1b_000807ad_Oblivion_RESP1"
msgid ""
"Following each cycle of the Greymarch, Sheogorath has cast out or killed "
"every aspect of Order found in the Shivering Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00038ee8_Oblivion_RESP1"
msgid "Food!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000206b7_Oblivion_RESP1"
msgid "Fool! Did you wish to have us both put to death?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00074a04_Oblivion_RESP1"
msgid "Fool! I am immortal here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0003faf1_Oblivion_RESP1"
msgid "Fool! I am no effete noble!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03LexMyvryna_000352a7_Oblivion_RESP1"
msgid ""
"Fool! You've just exposed me to the Thieves Guild. That \"citizen\" is "
"actually the guild member that was hired to do the theft!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Seen_0001a7fd_Oblivion_RESP1"
msgid ""
"Fool. Order cannot be stopped. Already the heart of this realm flows with my "
"Lord's power."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BSylLeaves_0003b822_Oblivion_RESP1"
msgid ""
"Fool? Visionary! Change is in the air, Syl. Breathe it deep! Bathe in its "
"scent! Bottle it up. Save some for later."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AThadonLeaves_000206c2_Oblivion_RESP1"
msgid ""
"Fool? Visionary! Change is in the air, Thadon. Breathe it deep! Bathe in its "
"scent! Bottle it up. Save some for later."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004351c_Oblivion_RESP1"
msgid "Foolish adventurers are being pulled into the Resonator of Judgment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark18NightConvo_000096e2_Oblivion_RESP1"
msgid ""
"Foolish little girl. Lucien Lachance served Sithis til his dying breath. The "
"Black Hand remains tainted by betrayal. Restoration is impossible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13JyggalagVoice_00096060_Oblivion_RESP1"
msgid "Foolish mortal!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32FanaticYell_0001b701_Oblivion_RESP1"
msgid "Foolish woman!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0005d509_Oblivion_RESP1"
msgid ""
"Fools must be separated from their illusions before they will come to Him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000f58d5_Oblivion_RESP1"
msgid "Fools! Now you die!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000b97df_Oblivion_RESP2"
msgid "For 150 gold and a roof over my head, I'm yours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00002a34_Knights_RESP1"
msgid "For Akatosh and the Nine!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDKnightsStartCombat_00002b47_Knights_RESP1"
