msgid "[GS/DS Power Attack]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_00061c77_Oblivion_RESP1"
msgid "[GS/DS Power Attack]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_00061c8e_Oblivion_RESP1"
msgid "[GS/DS Power Attack]"
msgstr ""

