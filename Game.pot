msgid ""
"Have you not heard of the Dark Brotherhood? Of the remorseless guild of paid "
"assassins and homicidal cutthroats?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDPilgrimageTopic_00002a9c_Knights_RESP2"
msgid "Have you not heard what happened to the Chapel in Anvil?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkRelics2_00002c6d_Knights_RESP1"
msgid ""
"Have you not heard? He has recovered the Mace! Even the Knights of old were "
"not judged worthy to wield it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkRelics2_00002c6e_Knights_RESP1"
msgid ""
"Have you not heard? She has recovered the Mace! Even the Knights of old were "
"not judged worthy to wield it!"
msgstr ""

