msgid "Have you read the latest Black Horse Courier?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00019fc6_Oblivion_RESP1"
msgid "Have you reconsidered my offer? Will you bring to me the daggers?"
msgstr ""

