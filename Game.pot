msgid "Hello, Your Grace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029b9_Knights_RESP1"
msgid "Hello, big brother!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bb01_Oblivion_RESP1"
msgid "Hello, citizen. I hope you're faring well in these difficult times."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00027981_Oblivion_RESP1"
msgid ""
"Hello, dear! Listen, I've been thinking. Why don't we form a kind of "
"alliance? If either one of us finds the chest of gold, we split it, 50/50!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e3e_Oblivion_RESP1"
msgid "Hello, dearest Sister. Is there something I can help you with?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000343b5_Oblivion_RESP1"
msgid "Hello, father."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00005674_Oblivion_RESP1"
msgid ""
"Hello, fellow Speaker. Welcome to the Black Hand. So nice to see you're in "
"one piece."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00071f50_Oblivion_RESP1"
msgid "Hello, fellow adventurer!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003574d_Oblivion_RESP1"
msgid "Hello, fellow magician."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002c0ce_Oblivion_RESP1"
msgid "Hello, friend! What can I do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008605a_Oblivion_RESP1"
msgid "Hello, friend. Thank you again for your help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008605e_Oblivion_RESP1"
msgid "Hello, friend. Thank you again for your help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0000bce4_Oblivion_RESP1"
msgid "Hello, good lady."
msgstr ""

