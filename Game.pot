msgid ""
"Have you reconsidered? Will you help me reach the Throne Room of Nenalata?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS21AnotherTask_000a9348_Oblivion_RESP1"
msgid ""
"Have you reconsidered? Will you help me reach the Throne Room of Nenalata?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00014663_Oblivion_RESP1"
msgid ""
"Have you recovered either the Bloodworm Helm, or the Necromancer's Amulet?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038fc0_Oblivion_RESP1"
msgid ""
"Have you recovered the Armor of Tiber Septim yet? We need to open the gate to "
"Camoran's Paradise as soon as Martin deciphers the whole ritual."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00014660_Oblivion_RESP1"
msgid "Have you recovered the Bloodworm Helm?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002916_Knights_RESP1"
