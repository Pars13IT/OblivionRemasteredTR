msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Eavesdrop_00089446_Oblivion_RESP1"
msgid "Have you made any progress? Will Anya assist us?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008fa7c_Oblivion_RESP1"
msgid ""
"Have you made up your mind? I'm getting tired just waiting for an answer."
msgstr ""

