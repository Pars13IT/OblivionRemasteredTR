msgid "Have you had the pleasure of staying at the Tiber Septim?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000af067_Oblivion_RESP1"
msgid ""
"Have you heard \"The Fall of Dagon\" yet? \"Take heart, the mighty hero "
"cried! He looked up at Dagon and cursed his foul name...\""
msgstr ""

