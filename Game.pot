msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008d329_Oblivion_RESP1"
msgid "May the Scalons tremble in your wake, My Lord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002A29_AltarDeluxe_RESP1"
msgid "May the Sovereign of Destruction be with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081d98_Oblivion_RESP1"
msgid "May the bones of your enemies be warm with blood, Lord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebee_Oblivion_RESP1"
msgid ""
"May the light and your mother's grace guide you to Xeddefen and the means to "
"topple this menace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001a811_Oblivion_RESP1"
msgid "May the light shine upon your face!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001c4d2_Oblivion_RESP1"
msgid "May the path ahead be free of danger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001e0e5_Oblivion_RESP1"
msgid "May the sunlight always safeguard your path."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062cc3_Oblivion_RESP1"
msgid "May the wind be on your back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000441d0_Oblivion_RESP1"
msgid "May we all bask in the warm safe glow of the Great Torch."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00009174_Oblivion_RESP1"
msgid "May we forever serve the Night Mother."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00009179_Oblivion_RESP1"
msgid "May you always walk in the shadow of death."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000982d3_Oblivion_RESP1"
msgid "May you always wear soft silks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007311a_Oblivion_RESP1"
msgid "May you bleed well!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000475cb_Oblivion_RESP1"
msgid ""
"May you find healing here for your wounds, and for your troubled spirit. "
"There's a peace here in the Chapel for all who seek it. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00082645_Oblivion_RESP1"
msgid "May you never darken."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Corpse_00062510_Oblivion_RESP1"
msgid "May you rest in peace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003632b_Oblivion_RESP1"
msgid "May you walk always in the shadow of Sithis, dear Brother."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003632c_Oblivion_RESP1"
msgid "May you walk always in the shadow of Sithis, dear Sister."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062c84_Oblivion_RESP1"
msgid "May you walk on warm sands."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005c0d1_Oblivion_RESP1"
msgid "May your Blade show the way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00036325_Oblivion_RESP1"
msgid "May your arrows always strike true!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003a90e_Oblivion_RESP1"
msgid "May your blade always strike true!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062cad_Oblivion_RESP1"
msgid "May your kills be quick and many."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000784b5_Oblivion_RESP1"
msgid "May your path be free of danger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00073120_Oblivion_RESP1"
msgid "May your story end happily!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0018d7e2_Oblivion_RESP1"
msgid "May your sword always strike true."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND10SirAmielSpeech07_00002cbb_Knights_RESP1"
msgid ""
"May your sword serve the Nine all the days of your life, Crusader. Farewell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000029eb_Knights_RESP1"
msgid "May your sword strike true."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081da5_Oblivion_RESP1"
msgid "May your walls stand secure!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19Choice1B_0009e65a_Oblivion_RESP1"
msgid ""
"May... May Sithis keep you safe, most revered Listener. If you ever need my "
"help, you need only ask!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGC01Choice3_0003663e_Oblivion_RESP3"
msgid ""
"Maybe I can teach you a little bit more about how to talk to people. And, of "
"course, here's the payment for the contract. Thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MazogatheOrcTopic_00086071_Oblivion_RESP2"
msgid "Maybe I just don't like you very much. So I'm not going."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AleronLocheTopic_0001f423_Oblivion_RESP1"
msgid ""
"Maybe I know him, maybe I don't. But since yer so interested, I know "
"somethin' that could jar my memory."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00044209_Oblivion_RESP1"
msgid ""
"Maybe I should get a Great Torch like in New Sheoth. I'll bet it would help "
"keep me awake."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39RanarrJo_000781f8_Oblivion_RESP2"
msgid ""
"Maybe I twist his head all the way around for him. Make it easier to see "
"behind him. Hahahaha."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_000097b2_Oblivion_RESP1"
msgid ""
"Maybe I wasn't clear before. You only talk business with me in the Garden of "
"Dareloth around midnight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00053765_Oblivion_RESP1"
msgid "Maybe I'll never see the sun again, but neither will Arnora!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06Reject_00002de3_Oblivion_RESP1"
msgid ""
"Maybe Theranis will return soon, maybe not. If you grow bored and change your "
"mind, ask me again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479e3_Oblivion_RESP1"
msgid ""
"Maybe Weebam-Na told you how we got all the rats here in Leyawiin? It's not "
"so bad. He's been killing them for months."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07NewCaptain_0009839e_Oblivion_RESP3"
msgid "Maybe fate will be kind and deliver him to me in Anvil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_00061794_Oblivion_RESP1"
msgid "Maybe he can help with these strange Knights."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_000289fd_Oblivion_RESP2"
msgid ""
"Maybe he was bored, or maybe he just wanted to do some slumming. Or maybe "
"he's a trained assassin hired to kill us all, one by one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028796_Oblivion_RESP2"
msgid ""
"Maybe he was busy looking for the chest of gold. Or maybe he was right next "
"to the victim, with his hand on the hilt of a dagger. Think about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028d30_Oblivion_RESP2"
msgid ""
"Maybe he's incredibly greedy, but I don't think so. My guess is that Primo is "
"so bored he simply has nothing better to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AlbertJemaneTopic_0008b074_Oblivion_RESP4"
msgid ""
"Maybe in the past my family was notorious, but never let it be said that the "
"current Jemanes don't pay their dues."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c1ce_Oblivion_RESP1"
msgid ""
"Maybe it's just me, but I find Falanu Hlaalu really odd. And I've seen him "
"hanging around the graveyard with a strange smile on his face."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000603a9_Oblivion_RESP1"
msgid ""
"Maybe it's not worth doing any more work. I mean, it certainly seems like "
"we're all doomed. What's the point?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeNevermind_000819ab_Oblivion_RESP1"
msgid "Maybe later."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00060901_Oblivion_RESP1"
msgid ""
"Maybe now that Jyggalag is gone, Sheogorath will finally return my affections."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VahtacenTopic_000150b8_Oblivion_RESP1"
msgid ""
"Maybe now that the project has had some positive results, we can go home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_000613a1_Oblivion_RESP4"
msgid ""
"Maybe once you've done that, we can talk about how to better pace yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_000498c4_Oblivion_RESP1"
msgid ""
"Maybe she could teach me how to fall off things. That's a useful skill! Much "
"better than, say, swinging a sword or casting a fireball."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDChapelAttackTopic_00002b92_Knights_RESP2"
msgid "Maybe that Prophet is right. Some kind of unholy doom visited upon us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00032d3f_Oblivion_RESP1"
msgid ""
"Maybe the Emperor is right about you. The best way you can help is to let us "
"do our jobs and don't get in our way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e2a_Oblivion_RESP1"
msgid "Maybe the Fighters Guild will recover from its troubles. And maybe not."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Topic_0008306b_Oblivion_RESP1"
msgid "Maybe the Mythic Dawn, or the Ayleid Revivalists?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECreatureResponses_00077c59_Oblivion_RESP1"
msgid "Maybe the best thing to do is fight them with a weapon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECreatureResponses_0008dc34_Oblivion_RESP1"
msgid ""
"Maybe the best thing to do is fight them with spells -- lots of spells. Don't "
"use a weapon."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061792_Oblivion_RESP1"
msgid "Maybe the new Gatekeeper will keep the peace out there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ec79_Oblivion_RESP1"
msgid ""
"Maybe the ruler of Dementia will fix all these walls that threaten to fall on "
"top of us all the time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000441ea_Oblivion_RESP1"
msgid ""
"Maybe the ruler of Mania will fix all these walls that threaten to fall on "
"top of us all the time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000603a8_Oblivion_RESP1"
msgid ""
"Maybe there really is no place left to hide. We are truly doomed if the "
"attempts to find Him fail."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c1a0_Oblivion_RESP1"
msgid ""
"Maybe there's something strange going on, but Skingrad is a well-run city."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02OrcConversation_0007eacc_Oblivion_RESP1"
msgid "Maybe they're just confused."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDRumorAttackResponse2_00002b9f_Knights_RESP1"
msgid "Maybe this prophet is right. Maybe it is the end of the world."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KvatchTopic_000699fc_Oblivion_RESP1"
msgid "Maybe we can rebuild. But things will never be the same."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00014442_Oblivion_RESP2"
msgid ""
"Maybe we're on to something here. We'll see how it plays out. It can't be "
"worse than what's happened before."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00016e95_Oblivion_RESP3"
msgid ""
"Maybe we're on to something here. We'll see how it plays out. It can't be "
"worse than what's happened before."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetTopic_00002a88_Knights_RESP2"
msgid ""
"Maybe what he says is true, and that the attack on the Chapel of Dibella is "
"just the beginning of an assault on the church itself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEHillofSuicidesTopic_0008e55c_Oblivion_RESP1"
msgid "Maybe you can help the others. Watch out for Them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028707_Oblivion_RESP2"
msgid ""
"Maybe you could do me a favor? If you speak with her, put in a good word for "
"me, would you? I would be forever in your debt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_0009f8bf_Oblivion_RESP1"
msgid ""
"Maybe you haven't heard, but Seed-Neeus's daughter has disappeared. Very sad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JskarTopic_0001cef2_Oblivion_RESP2"
msgid ""
"Maybe you should go see him about it. I don't feel like talking about it with "
"you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_00038a8b_Oblivion_RESP1"
msgid ""
"Maybe you'd better talk to my sister, Mog gra-Mogakh. She runs the Two "
"Sisters Lodge. She's the talker in the family."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006053a_Oblivion_RESP1"
msgid ""
"Maybe you're the reason Sheogorath left. Probably are. You make me want to "
"leave whenever I see you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0004db60_Oblivion_RESP1"
msgid "Mazken for the Madgod!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00061cd4_Oblivion_RESP1"
msgid "Mazken!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06ShoutStartCombat_00054fa6_Oblivion_RESP1"
msgid "Mazken! To arms!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugo03_0006fde1_Oblivion_RESP3"
msgid ""
"Mazoga's key and shield shall be delivered to her directly. And I promise you "
"a bounty of 100 gold for each Black Bow you bring me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00015e05_Oblivion_RESP1"
msgid "Me children are starving. Please help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00015dfe_Oblivion_RESP1"
msgid "Me children will thank ya for yer help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00048923_Oblivion_RESP1"
msgid ""
"Me? I got no problem with Bravil. Lovely town. That little prince, the "
"count's boy, he's sweet with the sugar. EEEA-sy Street, all the way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038aa0_Oblivion_RESP1"
msgid "Me? I'm Falanu. House Hlaalu. As if that matters here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000749e8_Oblivion_RESP1"
msgid ""
"Me? I'm Magub gro-Orum. Borba and me, we were pals in the adventuring trade. "
"Now I help him run the store."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e081_Oblivion_RESP1"
msgid ""
"Me? I'm just Laralthir. I wish I were the Countess of Anvil, to tell you the "
"truth. That Millona Umbranox, she's got it made... [Sigh.]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD09Choice3_00035712_Oblivion_RESP1"
msgid ""
"Me? Pah! I was just getting used to being retired. You can see how good my "
"painting is getting. I'm an old man. I've done my time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EyjaTopic_000b97e5_Oblivion_RESP1"
msgid "Me? There's not much to say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDRodericGreetB_00002a9f_Knights_RESP3"
msgid ""
"Meanwhile, I will continue on my own pilgrimage. Fare thee well, my friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Ceremony_00014abf_Oblivion_RESP1"
msgid "Meat with the desire to consume like Fire...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000b6c01_Oblivion_RESP1"
msgid "Meet me at the Fighters Guild in Leyawiin. We've got work to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05MazaddhaSpare1_00081189_Oblivion_RESP2"
msgid ""
"Meet me in my house tomorrow at midnight. I'll have information for you. Just "
"please spare me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05MazaddhaSpare2_0008118a_Oblivion_RESP2"
msgid ""
"Meet me in my house tomorrow at midnight. I'll have the information for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarMaTopic_0001778a_Oblivion_RESP2"
msgid ""
"Meet me tonight after dark in my house. I'll leave the door unlocked. Don't "
"be late."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0000bcc3_Oblivion_RESP1"
msgid "Meet you at The Count's Arms. Good luck."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_000270ef_Oblivion_RESP1"
msgid ""
"Mehrunes Dagon has no more love for my kind than for my mortal subjects. "
"Less, perhaps, as we make poor slaves."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004d0a8_Oblivion_RESP1"
msgid ""
"Mehrunes Dagon knows that if I can reach the Temple of the One and light the "
"Dragonfires, he has lost. Come on!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009811f_Oblivion_RESP2"
msgid ""
"Melisande has agreed to help revive Rona long enough for her to drink the "
"potion, and finally be at peace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001da50_Oblivion_RESP1"
msgid ""
"Memorial Cave, eh? Be very careful. That's obviously his true lair. There may "
"be others with him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGEmperor17_00032481_Oblivion_RESP2"
msgid "Men are but flesh and blood. They know their doom, but not the hour."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeGreavesMagic_0001f3e1_Oblivion_RESP1"
msgid ""
"Men like a woman with pretty legs. These will keep your legs from getting all "
"bruised up. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ShrineofMephalaTOPIC_0001ece3_Oblivion_RESP1"
msgid ""
"Mephala tugs the strings of mortals for her pleasure. Are you sure you desire "
"audience with the Webspinner?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackwoodCompany_0002c7bf_Oblivion_RESP1"
msgid ""
"Mercenaries is what they are, and they've hung up a shingle here in Leyawiin. "
"Vantus can tell you more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DirectionsSleep_0018bda7_Oblivion_RESP1"
msgid ""
"Merchant's Inn in the Market, King and Queen in Elven Gardens, the Tiber "
"Septim in Talos Plaza, and All-Saints in Temple District. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ShrineofMeridiaTOPIC_0001ebfb_Oblivion_RESP1"
msgid "Meridia has spoken to you, and for that, you are blessed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01ThievesTest_0001c14d_Oblivion_RESP3"
msgid ""
"Methredhel has delivered the diary to me. She has earned her place in the "
"guild. You did not do so well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01MethredhelAccepted_0001c152_Oblivion_RESP1"
msgid "Methredhel, you have earned the right to join the Thieves Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01Armand3_0005143c_Oblivion_RESP1"
msgid ""
"Methredhel, you know the rules. However, for Amusei and the newcomer, let me "
"state them clearly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081b70_Oblivion_RESP1"
msgid "Might we stop this now?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d149_Oblivion_RESP1"
msgid ""
"Mighty bold of you, asking for training. What makes you think you're worth my "
"time?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434fe_Oblivion_RESP1"
msgid ""
"Mighty warrior, the fallen Gatekeeper. Relan wonders if he would be able to "
"do the same."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008f11d_Oblivion_RESP1"
msgid ""
"Milchar. Home to the Tree of Shades -- one of my favorite features of this "
"Realm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006249a_Oblivion_RESP1"
msgid ""
"Millona Umbranox is better off without that irresponsible husband of hers. "
"The most honorable thing he ever did was to disappear and leave her alone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006249b_Oblivion_RESP1"
msgid ""
"Millona Umbranox, Arriana Valga, and Narina Carvain seem to rule their "
"counties perfectly well without male assistance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06PaleLady_00010503_Oblivion_RESP1"
msgid ""
"Mina? You don't want to go asking about her. She... um... interviews "
"prisoners. She isn't one to be crossed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006fdc1_Oblivion_RESP1"
msgid ""
"Mind telling me why you're sneakin' about? I don't think I have to tell you "
"what the Legion thinks of thieves, now do I?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0007028d_Oblivion_RESP1"
msgid ""
"Mind telling me why you're sneakin' about? I don't think I have to tell you "
"what the Legion thinks of thieves, now do I?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfb2_Oblivion_RESP1"
msgid "Mind your damn business, stranger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033601_Oblivion_RESP1"
msgid "Mind your own business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateVoice_000910f2_Oblivion_RESP1"
msgid "Mine's down!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c1ff_Oblivion_RESP1"
msgid ""
"Mirabelle Monet is quite a woman. Ask any of the sailors down at the "
"Fo'c's'le."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c202_Oblivion_RESP1"
msgid ""
"Mirabelle Monet runs quite a boarding house. I understand all of the sailors "
"leave very satisfied."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06HelpAttackA3C1_000192ea_Oblivion_RESP1"
msgid "Mirel was very convincing as well..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06HelpAttackA3C2_000192ed_Oblivion_RESP1"
msgid "Mirel was very convincing as well..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000825ed_Oblivion_RESP1"
msgid ""
"Mirili Ulven in Highcross thinks she can catalogue every creature in the "
"Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MiscarcandTopic_00026efe_Oblivion_RESP1"
msgid ""
"Miscarcand is one of the most extensive Ayleid ruins in Cyrodiil. It was the "
"capital of one of the ancient Ayleid kingdoms."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraReactions_00084aad_Oblivion_RESP1"
msgid "Mistress...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008f10e_Oblivion_RESP1"
msgid "Mmmmm. Is that fresh bread I smell?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e2e_Oblivion_RESP1"
msgid ""
"Modryn Oreyn got kicked out, and Vilena Donton thinks only about her dead "
"sons. The Fighters Guild is finished."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003aa9e_Oblivion_RESP1"
msgid ""
"Mog gra-Mogakh runs a fine establishment at the Two Sisters Lodge. And her "
"sister has some quality horses."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00086065_Oblivion_RESP2"
msgid ""
"Mogens Wind-Shifter had a gang. They robbed and killed travelers. But "
"Ra'vindra saw, and told the guards."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008605d_Oblivion_RESP1"
msgid ""
"Mogens Wind-Shifter is dead. Ra'vindra is avenged. Now I return to Castle "
"Leyawiin. Come visit me there some day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AngryMazoga_000860df_Oblivion_RESP1"
msgid ""
"Mogens Wind-Shifter! He killed Ra'vindra, my best friend. So I swore a "
"knight's oath of vengeance... and you've spoiled it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00086067_Oblivion_RESP1"
msgid "Mogens and his dogs must die!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00086065_Oblivion_RESP3"
msgid ""
"Mogens got away, but first he killed Ra'vindra... my best friend, Ra'vindra."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00086565_Oblivion_RESP1"
msgid "Mogens is dead, the bastard!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37Response_000452ef_Oblivion_RESP1"
msgid ""
"Money for wine? I think not. However, I will pay you to collect Hunger "
"tongues. What do you think?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfc5_Oblivion_RESP1"
msgid "More beer, sweetcakes!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ea9_Oblivion_RESP1"
msgid ""
"More conspiracy in the House of Dementia. People are always sneaking around "
"there...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CurrentEventsResponses_00025858_Oblivion_RESP1"
msgid "More fighting for the Nords? This is sad news."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_vampirehunters_00009226_Oblivion_RESP2"
msgid ""
"More hunters will come in time, I am sure. For now, Skingrad is quiet again, "
"and you have my thanks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000133d6_Oblivion_RESP1"
msgid "More questions? Astounding. Speak."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGDPost3_0006e2db_Oblivion_RESP2"
msgid ""
"More revenue means more gold in all our pockets. More men means that we're "
"likely to have more spare equipment around here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05PostTortureGreet_00080d42_Oblivion_RESP2"
msgid ""
"More scared than usual. I think something's going on with her. Now please, "
"leave me alone!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40Allright_0003e955_Oblivion_RESP1"
msgid ""
"More than 50 years ago, my wife Rona and I were both turned into vampires. "
"While I came to embrace the changes in myself, she did not."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003378b_Oblivion_RESP1"
msgid "More trouble."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c90b_Oblivion_RESP1"
msgid "Morning, ma'am."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e074_Oblivion_RESP1"
msgid "Morning, sir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003aa95_Oblivion_RESP1"
msgid "Morning."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04AlessiaSchedule_0003b3fb_Oblivion_RESP1"
msgid ""
"Mornings she is at the town chapel. At the castle, she hosts the evening meal "
"at eight. She retires sometime after eleven."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CurrentEventsResponses_00025017_Oblivion_RESP1"
msgid "Morrowind has always been a troubling place. It seems it is moreso now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_000476d9_Oblivion_RESP1"
msgid ""
"Morrowind is still living in the Second Era. I can't believe how they treat "
"Khajiit and Argonians. Here, we are Imperial citizens, nothing less."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASheogorathSpeech_00095884_Oblivion_RESP1"
msgid ""
"Mortal! You could have just stopped by to see Me. Would have saved you some "
"lettuce, you know. I believe I'm displeased."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkVampChoice1_000008de_Oblivion_RESP2"
msgid ""
"Most excellent! Here is what you must do. Simply go to sleep here in the "
"Sanctuary, at any time, and I will visit you as you slumber."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LucienLachanceTopic_00005677_Oblivion_RESP1"
msgid ""
"Most of my time is now spent on administrative duties. I have not had blood "
"on my hands in far too long! Killing Lachance was pure ecstacy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG12Choice1A_0000befd_Oblivion_RESP4"
msgid ""
"Most of our information on the Necromancers has come from an informant inside "
"the cult itself, a guild member who offered to infiltrate their ranks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_000be329_Oblivion_RESP1"
msgid "Most of the cities have sent aid. You've done an excellent job."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13KnightsWhy_00031c84_Oblivion_RESP2"
msgid ""
"Most of the time, they lounge around the tavern drinking and making up "
"stories of epic battles with impossible odds that they won."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00061387_Oblivion_RESP1"
msgid ""
"Most people consider Martin's... transformation... a religious or political "
"event, but what interests me is its metaphysical implications."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038b35_Oblivion_RESP2"
msgid ""
"Most people just call me the Gray Prince. It's kind of silly, I know, but the "
"people of Cyrodiil need heroes. I'm more than happy to oblige. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a8fd_Oblivion_RESP2"
msgid ""
"Most people just call me the Gray Prince. It's kind of silly, I know, but the "
"people of Cyrodiil need heroes. I'm more than happy to oblige. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a8fe_Oblivion_RESP2"
msgid ""
"Most people just call me the Gray Prince. It's kind of silly, I know, but the "
"people of Cyrodiil need heroes. I'm more than happy to oblige. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0009dade_Oblivion_RESP1"
msgid "Moth's blessing upon you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002938_Knights_RESP1"
msgid ""
"Mother Mara will bless my quest, I'm sure. I would be glad of your company on "
"the road, if you too wish to pray at her shrine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0c6_Oblivion_RESP1"
msgid ""
"Mother's coming for me in the dragon ships. I don't like these itchy clothes, "
"but I have to wear them or it frightens the fish."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark05Convo_0002f29e_Oblivion_RESP1"
msgid ""
"Motierre! I am here to exact payment, in blood! You will... eh? Who is this?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HidesHeartTalk_0004cace_Oblivion_RESP1"
msgid ""
"Motierre! I know you're in there! My employers are most displeased. I'm "
"coming in and you can beg for your life. Not that it will do any good! Ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MountainLionsTOPIC_00036623_Oblivion_RESP1"
msgid ""
"Mountain lions! In her basement? I just wanted to lure her vermin outside! I "
"didn't mean to hurt anyone, except the rats. Please, don't tell her!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MountainLionsTOPIC_0003662b_Oblivion_RESP1"
msgid ""
"Mountain lions? Here? Odd. If they're around, I can find them. Come with me. "
"A hunt will do us good, and maybe make that old nut feel better."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003c3b8_Oblivion_RESP1"
msgid "Move along please."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00051799_Oblivion_RESP1"
msgid "Move along, citizen. I won't abide loitering."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000715cf_Oblivion_RESP1"
msgid "Move along, citizen. There's nothing to be done here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00094c35_Oblivion_RESP1"
msgid "Move along, friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0018baa9_Oblivion_RESP1"
msgid "Move along, you worthless filth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfbe_Oblivion_RESP1"
msgid "Move along."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00015f09_Oblivion_RESP1"
msgid "Move along."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0018baac_Oblivion_RESP1"
msgid "Move along."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005179a_Oblivion_RESP1"
msgid "Move faster, if you value your life."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00188860_Oblivion_RESP1"
msgid "Move outta' my way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009816f_Oblivion_RESP1"
msgid "Move to the training area, downstairs. We will speak more there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007b79d_Oblivion_RESP1"
msgid "Move your ass, boot."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaNQDResponses_0004661c_Oblivion_RESP1"
msgid ""
"Much as I dislike bards, I wouldn't mind learning a thing or two from her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d14d_Oblivion_RESP1"
msgid ""
"Much as I hate to admit it, Gin-Wulm knows more about smithing than I do. "
"Says it's in his blood."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000608e3_Oblivion_RESP1"
msgid ""
"Much blood has come and gone. Relan is sad. Relan was stuck in Fellmoor for "
"all the war... no blood... no war... poor Relan."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033605_Oblivion_RESP1"
msgid "Much obliged, my friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5bb_Oblivion_RESP1"
msgid "Much to see. Much to learn."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG12TravenWhoInformant_000835f8_Oblivion_RESP1"
msgid ""
"Mucianus Allias. He is not a Council member, but has long served the guild "
"here at the Arcane University."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG12TravenWhere_000835fc_Oblivion_RESP1"
msgid ""
"Mucianus last reported being sent to the ruins of Nenyond Twyll, south of the "
"Imperial City. That is where the Battlemages went."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bcc4_Oblivion_RESP1"
msgid "Mudcrabs. What's the point? Annoying buggers, though the meat isn't bad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MaladaTopic_0002b09f_Oblivion_RESP1"
msgid ""
"Must I hold your hand? I begin to wonder what Umbacano sees in you. It is an "
"Ayleid ruin in the far west of this province, up in the Valus Mountains."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479f4_Oblivion_RESP3"
msgid ""
"Must be a joke. Don't get the joke, either... but the customer is always "
"right."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c235_Oblivion_RESP1"
msgid ""
"Must be nice being in the Mages Guild. If they need something recharged, they "
"just talk to Vigge the Cautious, and poof! All done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ec6_Oblivion_RESP1"
msgid ""
"Must be nice to be Duke of Mania, and have your biggest problem surround some "
"missing cup."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03SyndelCrazyChatter_0008efae_Oblivion_RESP1"
msgid "Must find the key! Must find the key!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThurindilTopic_0003e0d9_Oblivion_RESP1"
msgid ""
"Must have been knocked on the head. Talks all sorts of rot. Meek as a sheep, "
"though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Lost_00025348_Oblivion_RESP1"
msgid "Must have been the wind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Lost_00095896_Oblivion_RESP1"
msgid "Must have just been rats."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolNQDResponses_00029fb7_Oblivion_RESP1"
msgid "Must we talk about the Fighters Guild now?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32Betrothed_000948b0_Oblivion_RESP1"
msgid ""
"My Beloved! I'll carry her away to safety. Should the fanatics get her, "
"I...I...I would have to kill them all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGEmperor01_00053261_Oblivion_RESP2"
msgid "My Blades are leading me out of the city along a secret escape route."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TestMike_0004897d_Oblivion_RESP1"
msgid "My Disp to you is now over 70."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalSpeech_00084a4f_Oblivion_RESP1"
msgid ""
"My Eye is returned, and I once again see into the darkness that is your world."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChallengeKhajiit_0009f9b4_Oblivion_RESP1"
msgid ""
"My Khajiit is quick and cunning! Go! Seek him out! See whose blood is quicker."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS12TolganGreet_0001c497_Oblivion_RESP2"
msgid ""
"My Lady holds court from 8 in the morning until 6 in the evening each day. "
"That would be the best time to see her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10DuchessofDementia_00017d0b_Oblivion_RESP1"
msgid "My Lady! I am sorry, I did not realize..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10DuchessofMania_0001746b_Oblivion_RESP1"
msgid "My Lady! I am sorry, I did not realize..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008f588_Oblivion_RESP1"
msgid "My Lord Jyggalag will never be turned aside by the likes of you, fool!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d69_Oblivion_RESP1"
msgid "My Lord Sheogorath!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d7b_Oblivion_RESP1"
msgid "My Lord Sheogorath!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081d87_Oblivion_RESP1"
msgid "My Lord Sheogorath! Please kill me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008d32c_Oblivion_RESP1"
msgid "My Lord comes to Deepwallow to make it safe?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008d325_Oblivion_RESP1"
msgid "My Lord comes to rid us of the Scalon menace?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081da0_Oblivion_RESP1"
msgid "My Lord has a real edge I'd like to cut myself on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d82_Oblivion_RESP1"
msgid "My Lord is looking sharp!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12HaskillGreetA1_00016cfe_Oblivion_RESP2"
msgid ""
"My Lord of course noticed the Font when you arrived in the Palace. The Font "
"of Madness, in the middle of the throne room."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081d9b_Oblivion_RESP1"
msgid "My Lord rules strongly and without exhaustion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d7e_Oblivion_RESP1"
msgid "My Lord!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0005e376_Oblivion_RESP1"
msgid ""
"My Lord! Aurmazl Zudeh sent me to find you. She requests your immediate "
"assistance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001a77f_Oblivion_RESP1"
msgid ""
"My Lord! Autkendo Jansa sent me to find you. She requests your immediate "
"assistance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d68_Oblivion_RESP1"
msgid "My Lord! I've been waiting so long for you to return!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008d321_Oblivion_RESP1"
msgid "My Lord! To what do I owe the honor?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081530_Oblivion_RESP1"
msgid "My Lord! What brings you to my humble museum?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081d70_Oblivion_RESP1"
msgid "My Lord! What can I do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008d32b_Oblivion_RESP1"
msgid "My Lord! You are here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06KanehFinalC_000400de_Oblivion_RESP2"
msgid ""
"My Lord's choice of emissaries is strange. But He tolerates the Mazken in His "
"service as well, so who can fathom His ways?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Trespass_0007dfe8_Oblivion_RESP1"
msgid "My Lord, You seem to have lost Your way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000459b4_Oblivion_RESP1"
msgid "My Lord, it seems there has been some misunderstanding."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081d8e_Oblivion_RESP1"
msgid ""
"My Lord, there aren't enough pages in all the books in the world to hold your "
"glory!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081dca_Oblivion_RESP1"
msgid "My Lord, what is mine is yours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEResistArrest_000459c7_Oblivion_RESP1"
msgid ""
"My Lord, you do me too much honor! It will be glorious to fall in battle at "
"Your hand!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081dc0_Oblivion_RESP1"
msgid "My Lord, you honor me with your presence."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081d6e_Oblivion_RESP1"
msgid ""
"My Lord. I didn't realize how powerful your presence would be. I will try to "
"embody that majesty in my daily life. People respect me, you know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081d6f_Oblivion_RESP1"
msgid ""
"My Lord. I have waited for your return. Why have you forsaken me? I am your "
"most... adoring subject! I am yours to command, body and soul!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001a79b_Oblivion_RESP1"
msgid ""
"My Lord. I'm glad to see you. We have a developing situation that requires "
"your attention."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081d8d_Oblivion_RESP1"
msgid "My Lord? Are you aware we are suffering a Skooma shortage?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE34Medallion_00066eaa_Oblivion_RESP2"
msgid "My Medallion! I don't know how to thank you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAVaerminaSpeech_0008ade8_Oblivion_RESP1"
msgid ""
"My Orb is returned, and Arkved will live out the rest of his days in "
"nightmare. It is fitting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000164f4_Oblivion_RESP1"
msgid ""
"My Red Room got its paint job from fighters like you! After you disembowel "
"the next idiot, I want you to smear his blood all over the walls! Ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_00047659_Oblivion_RESP1"
msgid ""
"My advice is take your time, walk around the Market District, see what's on "
"offer. Don't buy until you've seen it all. Take your time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Goblinhunting_00038ac2_Oblivion_RESP1"
msgid ""
"My advice is to close quick with the skirmishers... the petty spellcasters... "
"but the shamans are real trouble."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Ally04Tactic1_00017d59_Oblivion_RESP1"
msgid "My aim shall be true."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Ally04Tactic1_000181ce_Oblivion_RESP1"
msgid "My aim will be true."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Ally03Tactic1_00017d58_Oblivion_RESP1"
msgid "My arrows will cut them down."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Ally03Tactic1_000181d3_Oblivion_RESP1"
msgid "My arrows will cut them down."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_001778f6_Oblivion_RESP1"
msgid ""
"My attention is focused on the Council right now. I will need you soon "
"enough; I need more time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081534_Oblivion_RESP1"
msgid ""
"My belly is rumbling, so I must leave. It has been an honor to talk to you, "
"Lord Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03FinKnightsofOrder_000807ba_Oblivion_RESP3"
msgid ""
"My best advice is to destroy them on sight. They wouldn't hesitate to do the "
"same to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE43GoAway_0008153a_Oblivion_RESP1"
msgid ""
"My best friend wants me to leave? Okay, for you I will. I know a nice spot in "
"Bliss I can use."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37Beast_0004565f_Oblivion_RESP1"
msgid ""
"My bestiary? Oh, yes. I want to start one. I'd like a Baliwog to begin with. "
"You just get it close to me and I'll take care of subduing it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001b682_Oblivion_RESP1"
msgid ""
"My betrothed is gone! I cannot live without her. I only hope I can take a "
"Fanatic with me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001333d_Oblivion_RESP1"
msgid "My betrothed must be worried sick about me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00012d08_Oblivion_RESP1"
msgid "My betrothed! I must save her!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_00051ea7_Oblivion_RESP1"
msgid "My blood for the Empire!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06CasimirStoryCurse_00002b28_Knights_RESP2"
msgid ""
"My blow landed harder than I had intended, and he fell to the floor, dead. "
"Killed in the very Chapel of the God of Mercy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00073229_Oblivion_RESP1"
msgid "My boat is coming along swimmingly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_sons_0002573b_Oblivion_RESP1"
msgid "My boys are safe! Oh, thank you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Creatures_000224b4_Oblivion_RESP2"
msgid ""
"My boys will take up the fight even if the guards won't. Doesn't matter if "
"it's outside the town walls - it still affects us all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00002a15_Knights_RESP1"
msgid ""
"My broodmate was traveling in Leyawiin. She told me of an artifact hidden in "
"the Chapel there, but said that no one has ever been able to claim it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000294d_Knights_RESP1"
msgid ""
"My brother and I still hope to serve the gods as Knights of the Nine. Have "
"you changed your mind? Will you induct us into the Order?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Brothers_00084a9a_Oblivion_RESP1"
msgid ""
"My brother! It is wonderful to see you again. We will have much to talk about "
"in the next days."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000432cf_Oblivion_RESP1"
msgid ""
"My child will smash to a bloody pulp any adventurer who tries to get into the "
"realm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Ceremony_00014ad2_Oblivion_RESP1"
msgid ""
"My child. It is time to fulfill your destiny. Stand guard in this land "
"against all those who seek entry not bearing the mark of Sheogorath's favor. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark11Choice1A_00002db8_Oblivion_RESP1"
msgid ""
"My children? Whatever for? Oh! Oh, dear, excuse an old woman's stupidity! "
"You're here to pick up my gift list!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE35Brithaur_00078663_Oblivion_RESP3"
msgid ""
"My collection is almost complete. All I need are five Flawless Pearls and I'm "
"done. How hard could that be?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007ac74_Oblivion_RESP1"
msgid ""
"My collection is complete! My collection is complete! Glory days! Wheeeeee."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00045651_Oblivion_RESP2"
msgid ""
"My collection is complete. Thankfully, you won't be interrupting me anymore."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00002a1e_Knights_RESP1"
msgid ""
"My cousin in Skingrad said that a pair of brothers stopped there looking for "
"the Priory of the Nine. They wanted to be Knights! Can you believe it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00064448_Oblivion_RESP1"
msgid ""
"My cousin says the beggars all work for the Gray Fox. It's rather frightening."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27HerminiaF1_000a5608_Oblivion_RESP1"
msgid "My crown, the one Umbacano covets, belonged to the ruler of Nenalata."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028a07_Oblivion_RESP2"
msgid ""
"My daughter was killed, you see. A few years back, by bandits. I'm sorry, "
"please forgive a father's heavy heart."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkOrcElfConvo_00026e76_Oblivion_RESP1"
msgid ""
"My dear Gogron, you are a life-taker for the Dark Brotherhood! Our very "
"existence relies on shadow and deception. Do you not value our secrets?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkGiftTopic_0004cf46_Oblivion_RESP1"
msgid ""
"My dear friend, the Dark Gift is yours! You are now a vampire! A creature of "
"the night! We are now kin!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029af_Knights_RESP1"
msgid "My dear sir knight, may we speak a moment?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028793_Oblivion_RESP3"
msgid ""
"My dear, sweet daughter Olga was killed that day. She was murdered, and the "
"Legion would do nothing to help her. Neville and his kind are scum."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40MelisandeRumor_0003f290_Oblivion_RESP1"
msgid ""
"My dear, you shouldn't trust rumors. They can get you into horrible trouble."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02RelmynaVisit_0001a122_Oblivion_RESP1"
msgid "My dearest, how are you feeling tonight, child?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000294f_Knights_RESP1"
msgid ""
"My devotion to Auri-El will not flag, nor will my desire to become a Knight "
"of the Nine. Will you have me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TestToddHappy_00028f51_Oblivion_RESP1"
msgid "My disp just went up"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE43Bhisha_0008f134_Oblivion_RESP1"
msgid ""
"My dog died, so that Khajiit isn't following me right now. However, I'll be "
"getting a new dog soon, and I just know he'll be back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008fa7d_Oblivion_RESP1"
msgid ""
"My double is always working. It takes all my energy just watching him work. "
"It's got to stop."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46DoublesTopic_0008fb69_Oblivion_RESP1"
msgid ""
"My double is out to get me. And eat me. You wouldn't do that, would you? "
"Something has to be done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGEmperor15_0003247f_Oblivion_RESP1"
msgid ""
"My dreams grant me no opinions of success. Their compass ventures not beyond "
"the doors of death."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479d1_Oblivion_RESP1"
msgid ""
"My duties are primarily... administrative. They keep me busy here in the "
"Leyawiin barracks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GatherClues_000038c9_Oblivion_RESP1"
msgid ""
"My duties rely on watching no more than the throne and attending to visitors."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11HaskillChoice1_00014b66_Oblivion_RESP1"
msgid "My duty now is to the Realm. By serving you, I serve Lord Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Topic_0008306c_Oblivion_RESP1"
msgid "My enemies think I'm weak. That I'll never act."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11CiirtaGreeting2a_00016b71_Oblivion_RESP1"
msgid "My eye? You seek to remove the light from me? Why?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46Goblins_000319ce_Oblivion_RESP2"
msgid ""
"My family and I are still trying to figure out what to do. We spent "
"everything we had to buy the land and supplies, so we can hardly go back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e8c3_Oblivion_RESP3"
msgid ""
"My family didn't approve of my vocation, so I had to come to Cyrodiil for my "
"education. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Manor_00003a5d_Oblivion_RESP3"
msgid ""
"My family said I could move here to the Imperial City once all our loose ends "
"were tied down. The manor was one of those loose ends."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GuilbertJemaneTopic_00023e88_Oblivion_RESP2"
msgid ""
"My family was killed long, long ago. At least, that's what I'd been told... "
"perhaps it's time for me to stop drinking."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003574b_Oblivion_RESP1"
msgid "My fate is in your hands."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeatherleahTopic_000242ae_Oblivion_RESP2"
msgid ""
"My father carried me to safety. He later returned and believed Reynald and my "
"mother had perished."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AlbertJemaneTopic_0008b074_Oblivion_RESP7"
msgid ""
"My father had told us that he had hidden something away for us... something "
"to provide for our future, but I never imagined it was this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MirisaTopic_00033ef7_Oblivion_RESP1"
msgid ""
"My father hired her as a guide at an inn south of here. Good thing, too. She "
"saved our lives, and led us safely back here after the goblin attack."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AlbertJemaneTopic_0008b07c_Oblivion_RESP1"
msgid "My father was a great man! I'll not hear your lies!!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00074a0d_Oblivion_RESP1"
msgid "My father will never be beaten by the likes of you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00074a03_Oblivion_RESP1"
msgid "My father's power sustains me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_0003e456_DLCThievesDen_RESP1"
msgid "My favorite customer! Whaddrya got?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_000476e4_Oblivion_RESP1"
msgid ""
"My favorite thing is fresh slaughterfish, caught fresh from the docks on the "
"Waterfront."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624bc_Oblivion_RESP1"
msgid ""
"My favorite town? Anvil. Lovely old stone buildings, and the harbor at sunset "
"is beautiful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_0002817f_Oblivion_RESP1"
msgid "My feelings about the Nord are my own business! Leave me be!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028705_Oblivion_RESP1"
msgid "My feelings toward her are really none of your business. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GuardGoodbye_00026bc6_Oblivion_RESP1"
msgid "My feet are killing me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000411fd_Oblivion_RESP1"
msgid ""
"My feet hurt so bad. I could sure use a new pair of shoes. Can you help me "
"out? Please?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00026ea2_Oblivion_RESP1"
msgid ""
"My first responsibility is to the people of Cheydinhal. They look to me for "
"protection in these dark times. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAPeryiteSpeech_0008c25f_Oblivion_RESP1"
msgid ""
"My followers are trapped between worlds; their bodies here on this plane, "
"their souls in Oblivion. I would have you reunite the bodies and the souls."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAHermaeusSpeech_000a9484_Oblivion_RESP1"
msgid ""
"My followers seek to perform a divination. For this, they need souls, one of "
"each of the sentient races. You will provide these."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003c97b_Oblivion_RESP1"
msgid "My friend!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00073925_Oblivion_RESP1"
msgid ""
"My friend! It is good to see you again. You risked your life to save me, a "
"stranger. You are truly among the blessed of Arkay's children."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000b1672_Oblivion_RESP1"
msgid "My friend! What can I do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028714_Oblivion_RESP1"
msgid ""
"My friend, I am truly worried! Neville was a strong and capable man, a "
"soldier of twenty years! The rest of us will be easy prey for the killer now!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028cd4_Oblivion_RESP1"
msgid ""
"My friend, in talking to you, it's become clear what must be done. I have no "
"doubts in my mind that Nels is the killer. We must take him down!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000176c4_Oblivion_RESP2"
msgid ""
"My friend, it is with great honor that I advance you to the rank of Champion! "
"You've done it! You've shown them all you're the best!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028724_Oblivion_RESP1"
msgid ""
"My friend, please stay safe! Three of us have been murdered! Besides you and "
"me, there's only one guest left, if you know what I'm saying."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaAgronakChoice4_00038ed7_Oblivion_RESP3"
msgid ""
"My friend, you must travel to Crowhaven and use the key to unlock whatever it "
"is that holds the proof of my birthright!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDPelinalVisionSpeech_00002ab6_Knights_RESP1"
msgid ""
"My friends built a shrine upon the site of my death, where the Elves "
"tormented me in a final act of revenge."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_00047c63_Oblivion_RESP1"
msgid ""
"My friends, we have a winner! Behold, the combatant from the Blue Team! If "
"you bet on the Blue Team, see the Gatekeeper to collect your winnings!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_00047c64_Oblivion_RESP1"
msgid ""
"My friends, we have a winner! Behold, the combatant from the Yellow Team! If "
"you bet on the Yellow Team, see the Gatekeeper to collect your winnings!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraReactions_00084ab2_Oblivion_RESP1"
msgid "My god... no!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002b72f_Oblivion_RESP1"
msgid ""
"My good friend! Let me drink to your health! For saving my brother ... no, "
"for finding him ... or was it for finding me? Anyway, bottoms up!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEDerveninSpeech01_000898f1_Oblivion_RESP1"
msgid ""
"My good friends, a most jubilant time is once again at hand. The Flame of the "
"Maniacs burns bright, and we must celebrate!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000432b5_Oblivion_RESP1"
msgid "My goodness!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028161_Oblivion_RESP1"
msgid "My goodness, two of us are now dead! What's going on in this place?  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HackdirtTopic_0002869d_Oblivion_RESP1"
msgid ""
"My grandfather built this place, not that it's any of your business.  We been "
"down, but we got plans to bring back the good old days.  You'll see."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASheogorathChoice3_00026af3_Oblivion_RESP3"
msgid ""
"My great-great-great grandfather, K'Sharra, foretold of a time when we would "
"receive three signs from the gods, signalling the end of the world."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001e6fd_Oblivion_RESP1"
msgid ""
"My guards are strong and true, but even the might of the Blades cannot stand "
"against the Power that rises to destroy us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StolenGold_00053776_Oblivion_RESP1"
msgid ""
"My guess is he buried it somewhere close to town or even in town itself. "
"Believe me, I've looked. No luck so far."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028cd7_Oblivion_RESP1"
msgid ""
"My gut instincts tell me Nels is the killer, but still I lack the proof I "
"need to confront him. Maybe you can convince me I'm right."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008d320_Oblivion_RESP1"
msgid "My hatchlings for you, Lord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04WhatHappened_00019524_Oblivion_RESP3"
msgid ""
"My head is positively throbbing now... can you see it? I need to lie down. "
"Find someone to tell you the rest of the story. Get the Chalice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000343f5_Oblivion_RESP1"
msgid ""
"My head is still spinning from everything that has happened. I'll need some "
"time to adjust."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e83_Oblivion_RESP1"
msgid ""
"My heart fills with joy that Lord Thadon has finally recovered from his "
"doldrums."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003574a_Oblivion_RESP1"
msgid "My heart is broken."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00068344_Oblivion_RESP1"
msgid ""
"My heart is lighter thanks to your words. You've given me kinship, and that "
"is worth more than a thousand swords. Until later, friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028736_Oblivion_RESP1"
msgid "My hero!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KvatchTopic_0002855b_Oblivion_RESP1"
msgid ""
"My home.... my goddamn home, in flames. It kills me that I can't get in there "
"and DO something."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32FanaticYell_0001b708_Oblivion_RESP1"
msgid "My horde will swallow this keep!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001bb20_Oblivion_RESP1"
msgid "My house is yours, friend. Please, come back to visit us anytime."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_00024fec_Oblivion_RESP1"
msgid ""
"My housemate, Malintus Ancus, and I are well-known in certain circles here. "
"But, you don't travel in those circles, do you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_0004773a_Oblivion_RESP1"
msgid ""
"My housemates and I were lucky to find this house in the Temple District. It "
"costs a little more, but it's a very good address."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0cc_Oblivion_RESP1"
msgid ""
"My husband is down south in Anvil County, working the Valenwood line, hunting "
"down bandits and smugglers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11GiveRing_00022e71_Oblivion_RESP1"
msgid ""
"My husband's wedding ring! I never thought to see it again. What I wouldn't "
"give to see him once more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS08KurdanJar_0001f42d_Oblivion_RESP3"
msgid ""
"My informant tells me it's hidden in the main keep at the center. Dunno "
"what's guardin' it, but I'm sure you can handle it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22HighFane_0002c819_Oblivion_RESP1"
msgid ""
"My interest was in recovering the carving from Malada, and Maric has already "
"delivered it to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UrielSeptimTopic_000178c9_Oblivion_RESP1"
msgid ""
"My job is to make sure the Emperor gets out of here alive, and I intend to do "
"it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_00032b08_Oblivion_RESP1"
msgid "My job right now is to get you to safety."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001d4ba_Oblivion_RESP1"
msgid "My knowledge is at your disposal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BOASTLOVE_0018b2bc_Oblivion_RESP1"
msgid "My life is drab and wretched by comparison."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MankarSpeech_0008b0a5_Oblivion_RESP10"
msgid "My long duel with the Septims is over, and I have the mastery."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008f7d1_Oblivion_RESP4"
msgid "My lord Jyggalag has given me clarity, and purpose."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ04Conv_00037b50_Oblivion_RESP1"
msgid ""
"My lord! Welcome to Cloud Ruler Temple! We have not had the honor of an "
"Emperor's visit in many years!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00068341_Oblivion_RESP1"
msgid ""
"My lord, I was wondering if I could speak with you. I understand that you "
"have many more pressing concerns..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00067dc1_Oblivion_RESP1"
msgid "My lord, please excuse my presumption, but I would speak with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00067dbd_Oblivion_RESP1"
msgid "My lord... I would speak with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RytheLythandasTopic_0001c1cb_Oblivion_RESP1"
msgid "My love is home again. I'll never leave his side."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UmbacanoTopic_000a9843_Oblivion_RESP1"
msgid "My master has not returned from his expedition to Nenalata."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed49_Oblivion_RESP1"
msgid ""
"My master has partaken of the Greenmote and passed his post onto another. Now "
"a new rule begins in the House of Mania."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS21JollringChoice1_0002ab53_Oblivion_RESP1"
msgid ""
"My master is a collector of Ayleid antiquities. It has come to his attention "
"that you recently sold an item that interests him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UmbacanoTopic_000a9844_Oblivion_RESP1"
msgid ""
"My master is not available at the moment. Perhaps you can call again another "
"day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JollringChoice2C_00085942_Oblivion_RESP1"
msgid "My master trusts me to decide what to show him, I'm afraid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UmbacanoTopic_0002b633_Oblivion_RESP1"
msgid ""
"My master, Umbacano, is known across Cyrodiil as a collector of Ayleid "
"antiquities. He is always interested in rare artifacts from that era."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UmbacanoTopic_0002ab51_Oblivion_RESP1"
msgid ""
"My master, Umbacano, lives in the Talos Plaza District of the Imperial City. "
"He is known across Cyrodiil as a collector of Ayleid antiquities."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetA1_00002b88_Knights_RESP1"
msgid ""
"My master. We met you on the Pilgrim's Way. Back then I thought for sure the "
"gods had chosen him for a holy purpose."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06NoBribeBeggar_000104e0_Oblivion_RESP1"
msgid "My memory fails me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01NoBribeBeggar_00007e03_Oblivion_RESP1"
msgid ""
"My memory is playing tricks on me. I can't seem to remember where she lives."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ16Talk_0004bf9e_Oblivion_RESP1"
msgid "My men and I are at your disposal. What are your orders?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_jobs_0002c7b5_Oblivion_RESP1"
msgid ""
"My men and I should be able to keep busy for now. Thank you for your help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ClaudeMaricTopic_0002c814_Oblivion_RESP1"
msgid ""
"My methods were vindicated. Apparently Maric was more capable than you. I'm "
"sure you will try harder the next time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e80_Oblivion_RESP2"
msgid "My mistake - shouldn't you be on the other side of Cyrodiil by now? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaAgronakChoice4_00038ed7_Oblivion_RESP1"
msgid ""
"My mother died recently. Before she passed, she gave me this key, and told me "
"it would \"unlock the truth,\" at the place of my birth, Crowhaven."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45Mother_0002869b_Oblivion_RESP1"
msgid "My mother owns Northern Goods and Trade in Chorrol."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45Mother_0002869a_Oblivion_RESP1"
msgid "My mother owns this shop.  She would be glad of your business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark11Choice3B_00002dd6_Oblivion_RESP1"
msgid "My mother? No! What have you done to her! I'll kill you! Agghh!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark11Choice4B_00002dda_Oblivion_RESP1"
msgid ""
"My mother? Oh, do you know her? She's such a sweet woman. I've been a "
"terrible daughter I'm afraid. I simply must visit more often!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001dc51_Oblivion_RESP1"
msgid ""
"My my my, look at the Myrmidon. Who are you fighting against up there, "
"cripples and skooma addicts? Maybe some day they'll give you a real challenge."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479ad_Oblivion_RESP1"
msgid ""
"My name is Agata. I'm responsible for enchanted item recharge for the Guild "
"here in Leyawiin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476fe_Oblivion_RESP1"
msgid "My name is Alessia Ottus, and I'd like to talk about the Nine Divines."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004773b_Oblivion_RESP1"
msgid ""
"My name is Ancus Afranius. I do whatever comes to hand. Or nothing, when I "
"can afford it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476c2_Oblivion_RESP1"
msgid "My name is Atraena. How do you do? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND04CarodusGreeting1_00002ad3_Knights_RESP1"
msgid ""
"My name is Carodus Oholin. Like you, I am a servant of the Nine. "
"Specifically, of Zenithar."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004774c_Oblivion_RESP1"
msgid "My name is Carwen. Remember. I'll be rich and famous one day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476de_Oblivion_RESP1"
msgid ""
"My name is Elragail. I look after Thamriel. He's a little strange. 'Touched "
"by the Gods', they say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00024f2e_Oblivion_RESP1"
msgid "My name is Eugal Belette. I'm pretty new here -- don't know a soul."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13WhoAreYou_000a3847_Oblivion_RESP2"
msgid ""
"My name is Farwil Indarys, son of Count Andel Indarys of Cheydinhal. The "
"wounded one is Bremman Senyan. We are members of the Knights of the Thorn."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047735_Oblivion_RESP1"
msgid "My name is Hagaer. I don't get out much. Too many books to read."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476fc_Oblivion_RESP1"
msgid "My name is Hastrel Ottus, and I'd like to talk about Akatosh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047700_Oblivion_RESP1"
msgid "My name is Ida Ottus, and I'd like to talk about Mother Mara."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476d0_Oblivion_RESP1"
msgid ""
"My name is Lurio Maenius. I share a house with Matthias Draconis. I'm between "
"jobs as a private guard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479da_Oblivion_RESP1"
msgid ""
"My name is Margarte. Professionally, I'm a trade consultant... I offer "
"Advanced Mercantile training, by the way..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047747_Oblivion_RESP1"
msgid ""
"My name is Methredhel. I've come to the Imperial City to make my fortunes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479d6_Oblivion_RESP1"
msgid ""
"My name is Numeen.  Have you seen that no-good rascal husband of mine, Mahei? "
"Gods know what he is up to this time..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c9a8_Oblivion_RESP1"
msgid "My name is Selena Orania. I'm a Mages Guild Journeyman."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476f8_Oblivion_RESP1"
msgid ""
"My name is Umog gra-Marad. I'm employed by Master Umbacano as a night guard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002855_Oblivion_RESP1"
msgid ""
"My name's Bongond. I can see you know horses. So do I, and I know I have just "
"what you need."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e0a2_Oblivion_RESP1"
msgid ""
"My name's Quill-Weave. I've had some success selling stories about the lives "
"of the lower and criminal classes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_000488bd_Oblivion_RESP1"
msgid ""
"My neighbor, Dro'shanji, is worried. He's seen creatures around the house "
"lately. Why don't you talk to Dro'shanji, see if you can help?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479c9_Oblivion_RESP1"
msgid ""
"My neighbors grumble a lot, but what can they do? No law against practicing "
"my skills."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Lost_00081a3e_Oblivion_RESP1"
msgid ""
"My nerves are on edge, I guess. This land could do with the peace of Order."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f231_Oblivion_RESP1"
msgid "My new Gatekeeper is a miracle. He's perfect."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_NDGauntletsoftheCrusader_00002b18_Knights_RESP2"
msgid ""
"My only real involvement with them these days is keeping the youngsters from "
"hurting themselves trying to pick the gauntlets up."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTopic_0001e8e2_Oblivion_RESP1"
msgid ""
"My order is dedicated to the service of the Septim Emperors. We have failed "
"in our duty to protect him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateConv_0005a023_Oblivion_RESP1"
msgid ""
"My orders didn't include leading my men into Oblivion. We'll hold here for "
"now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08MothPriestNote_0001474a_Oblivion_RESP3"
msgid ""
"My own family doesn't even know me. I would give much to be rid of the Gray "
"Cowl and its curse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27HerminiaE1_000a5607_Oblivion_RESP1"
msgid ""
"My own research into the Late Ayleid Period suggests that there was not a "
"single Ayleid ruler, but many."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06KanehGreetA_000131ab_Oblivion_RESP1"
msgid "My pardon, Emissary. I am at your service."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Trespass_0007dfe4_Oblivion_RESP1"
msgid "My pardon, Lord. Are You lost?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000459b7_Oblivion_RESP1"
msgid ""
"My pardon, Your Grace, but Lord Sheogorath's justice applies to all within "
"His Realm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06GSWardenGreet1_00018dc3_Oblivion_RESP1"
msgid ""
"My pardon, lord. Receive this key, and with it free passage throughout the "
"Shrine of the Flame of Agnon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001b689_Oblivion_RESP1"
msgid "My people long to be laid to rest. Please help them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d7f3_Oblivion_RESP1"
msgid ""
"My place is on the battlefield. The time for hiding in Cloud Ruler Temple is "
"over. Come, let us go down to battle together."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0009198c_Oblivion_RESP1"
msgid "My pleasure, really."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04AlessiasRing_00009331_Oblivion_RESP2"
msgid "My pockets are a little light at the moment... if you know what I mean."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000a3452_Oblivion_RESP3"
msgid ""
"My poor Biene. Poor, sweet Biene. What monsters would do this? How can this "
"have happened?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003cafa_Oblivion_RESP1"
msgid "My poor Henantier. Help will be with you soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HenantierTopic_0002c6e9_Oblivion_RESP1"
msgid "My poor Henantier. I shudder to think what's happened to him in there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReynaldJemaneTopic_000242a9_Oblivion_RESP1"
msgid ""
"My poor brother. I can't help but feel responsible. If he'd never known about "
"me, he'd still be alive."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003fd3b_Oblivion_RESP1"
msgid ""
"My poor husband is getting no sleep. He's awake all night taking care of "
"those stupid plants."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ01Potatoes_0018885e_Oblivion_RESP1"
msgid ""
"My potatoes are like my children. I care for and nurture each one "
"individually. That way, they grow up to be big and strong."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004f9c1_Oblivion_RESP1"
msgid "My prayers go with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SilencerTopic_0002fdb6_Oblivion_RESP5"
msgid ""
"My previous Silencer perished while fulfilling a contract. That emptiness has "
"now been filled by you. It is an honor without equal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00027119_Oblivion_RESP1"
msgid ""
"My progress on the Mysterium Xarxes is slow, I'm afraid. How goes your search "
"for the Armor of Tiber Septim?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e8c4_Oblivion_RESP1"
msgid ""
"My progress through the ranks here will be slow. My prejudices against "
"certain types of magic limit my chances for advancement."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006edec_Oblivion_RESP1"
msgid ""
"My rats are all dead! It's too late to do any more. I won't be needing your "
"services any longer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026d5e_Oblivion_RESP1"
msgid ""
"My research is moving forward again. It's only a matter of time before I "
"decipher the third and fourth ingredients for the ritual."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Daedricshrine_00002e57_Oblivion_RESP1"
msgid ""
"My research shows there is likely a shrine in these caves. I'll need you to "
"accompany me to the shrine, handle any... difficulties."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04GiveRing_00035fc0_Oblivion_RESP1"
msgid ""
"My ring! All thanks to the claws of the Clan Mother. You have recovered it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00025280_Oblivion_RESP1"
msgid "My scales grow cold whenever you approach."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06SidePassage_00012cbd_Oblivion_RESP1"
msgid ""
"My scouts recently discovered another way through the ruins to the Altar of "
"Despair."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06KanehMirel_00012102_Oblivion_RESP1"
msgid ""
"My scouts reported no signs of the Mazken in the Underdeep. It's our best "
"chance to take them unawares."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11P3Specifics_0001fb70_Oblivion_RESP3"
msgid ""
"My scrying with Savilla's Stone has provided clues, but not the details. I "
"know the tools you will need there, but not the obstacles themselves."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServiceRefusal_0003d802_Oblivion_RESP1"
msgid ""
"My services are not for such as you. Go peddle your paltry wares to Ongar in "
"Bruma, or one of the other lesser fences."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServiceRefusal_000614cb_Oblivion_RESP1"
msgid "My services are only for Fighters Guild members. Nothing personal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServiceRefusal_0003d800_Oblivion_RESP1"
msgid ""
"My services are reserved for more important members of the Thieves Guild. You "
"can always use Ongar in Bruma."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UgakgraMogakhTopic_00038a93_Oblivion_RESP1"
msgid ""
"My sister, Ugak gra-Mogakh, runs the Grateful Pass Stables. She's the quiet "
"one. I'm the talker."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003013c_Oblivion_RESP2"
msgid ""
"My sisters, on the other hand ... I wouldn't mind if they had stayed "
"invisible! Ha ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00026ea1_Oblivion_RESP1"
msgid "My soldiers are brave and capable. They will do their duty."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13Gate_000579e1_Oblivion_RESP2"
msgid ""
"My son, Farwil, has taken some knights and entered the gate bravely in hopes "
"of meeting the enemy head-on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ViranusDontonTOPIC_0002d714_Oblivion_RESP1"
msgid "My son? He's at home, I would imagine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_00032b05_Oblivion_RESP1"
msgid "My sons ... they're dead, aren't they?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002249c_Oblivion_RESP1"
msgid "My sons! Have you seen my sons?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06ShoutStartCombat_00054fae_Oblivion_RESP1"
msgid "My soul for Sheogorath!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00018f89_Oblivion_RESP1"
msgid "My soul for Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08SavillasStoneTopic_00014704_Oblivion_RESP1"
msgid ""
"My sources tell me that Savilla's Stone has gone missing. Do you have it with "
"you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseBuyCheydinhal_0004f213_Oblivion_RESP1"
msgid ""
"My steward will draw up the papers for me to sign. Here is the key to your "
"new home. You can find it in the southwest corner of the city."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_00051ea8_Oblivion_RESP1"
msgid "My sword for the dragon!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Ally04Tactic2_00017d5e_Oblivion_RESP1"
msgid "My sword shall strike true."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Ally04Tactic2_000181cd_Oblivion_RESP1"
msgid "My sword shall strike true."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice5A_00028ac8_Oblivion_RESP2"
msgid ""
"My tale actually begins with the father, Albert Jemane. He was once in my "
"employ, or should I say the employ of my organization."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00048900_Oblivion_RESP1"
msgid ""
"My task is to know and love the people of Bravil as if they were my own "
"children. If you have ever been a parent, you know what a challenge that is."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ09GhostB_00036666_Oblivion_RESP1"
msgid ""
"My three companions and I were sent here by the Emperor Tiber Septim to "
"discover what evil had defiled the holy catacombs of Sancre Tor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40Allright_0003e955_Oblivion_RESP3"
msgid ""
"My trusted servants have cared for her all this time, but I wish for her to "
"at last find peace. The cure is for her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MankarSpeech_0008b0a4_Oblivion_RESP10"
msgid ""
"My vision shall be realized. Weakness will be purged from the world, and "
"mortal and immortal alike purified in the refiner's fire."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0008c218_Oblivion_RESP1"
msgid "My vision will yet be realized!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d76_Oblivion_RESP1"
msgid ""
"My weapons and armor are fashionable and deadly. For the sophisticated "
"warrior."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000441e8_Oblivion_RESP1"
msgid ""
"My whole family is happy about the Torch being lit. Unless it's all part of "
"some bit plot."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00090cb6_Oblivion_RESP1"
msgid "My whole life I have waited for this moment! Die!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a906_Oblivion_RESP2"
msgid ""
"My whole life has been nothing but a lie! I'm no \"Gray Prince.\" I'm a vile, "
"wretched spawn of evil! Please, leave me. I can't.... I..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a907_Oblivion_RESP2"
msgid ""
"My whole life has been nothing but a lie! I'm no \"Gray Prince.\" I'm a vile, "
"wretched spawn of evil! Please, leave me. I can't.... I..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009811e_Oblivion_RESP1"
msgid "My wife... my beautiful wife."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003ca92_Oblivion_RESP1"
msgid "My word! You startled me! Are you real?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37Errand_000452fb_Oblivion_RESP1"
msgid "My work is far too important to trust to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008faae_Oblivion_RESP1"
msgid "My work is never done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09HelpGF_00014825_Oblivion_RESP1"
msgid ""
"My work with Savilla's Stone has revealed that I need something special for "
"my plans."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043eb3_Oblivion_RESP1"
msgid "My, but it has been busy here lately. I do so enjoy a good conspiracy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043eb1_Oblivion_RESP1"
msgid ""
"My, my, my. Seems we're all anxious to know something, even if we already "
"know it. Or, Syl knows it. Or not."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE30ForgeGauntletsMagic_000400ba_Oblivion_RESP1"
msgid "My, my, my... what big hands you have!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033341_Oblivion_RESP1"
msgid ""
"My, my, you're a big one. A Nord, I'd guess, right? So strong... But you "
"can't bend steel, can you boy? You can't do anything to get out of here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark06Choice2A_0004e9ad_Oblivion_RESP1"
msgid ""
"My... my soul? Whoah. Wow. Yeah, okay... Yeah! That sounds... great! You can "
"have my soul! Can I... Can I have your soul too? Ha ha ha ha. Oh... Wow."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00146848_Oblivion_RESP1"
msgid "Myrmidon! Good to see you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReynaldJemaneTopic_00084a98_Oblivion_RESP1"
msgid ""
"Mystery solved, eh? Reynald had a twin brother. Well, he had all of us fooled."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c1be_Oblivion_RESP1"
msgid "Mysticism? Seems interesting, but not particularly useful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03WhoIsInformant_000092b6_Oblivion_RESP1"
msgid ""
"Myvryna Arano. Now Armand needs your help to neutralize her. You are going to "
"pin the theft of the bust on Myvryna. She lives in the Waterfront."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_000981d6_Oblivion_RESP1"
msgid "Nah."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000465c5_Oblivion_RESP1"
msgid ""
"Nahsi at the Fighters Guild seems very at peace with himself. He says that's "
"what allows him to be such an amazing martial artist."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BravilNQDQuestionResponses_000465a8_Oblivion_RESP1"
msgid "Nahsi is quite a character, and quite an impressive fighter."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488d1_Oblivion_RESP1"
msgid ""
"Nahsi, your humble servant, and humble servant of the Nine. I offer training "
"in the marital arts of Hand-to-Hand fighting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ce92_Oblivion_RESP1"
msgid ""
"Namira is pleased, foul one. May your days be filled with the hurtful stares "
"of others. Dwell joyously in filth and squalor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraSpeech_00084aaa_Oblivion_RESP1"
msgid "Namira...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_0007d465_Oblivion_RESP1"
msgid "Naryan that! I'll balitoe before I krayble."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003e98b_Oblivion_RESP1"
msgid ""
"Naspia Cosma is really skilled with her blade. It's a shame she doesn't "
"compete in the Arena."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CreatureResponses_0002b1c2_Oblivion_RESP1"
msgid "Nasty creatures, but I hear their meat is rather tasty."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice5A_00028ac8_Oblivion_RESP6"
msgid ""
"Naturally, my associates and I believed he had perished. The wilderness is, "
"after all, a dangerous place. No place to take your family."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkBack_00014db9_AltarDeluxe_RESP1"
msgid "Naturally."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06BribeGuard_0000c209_Oblivion_RESP1"
msgid ""
"Naw. But it will earn ya two years in Skingrad's dungeon. Now get lost before "
"I decide ta report ya."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMolagBalSpeech_00037845_Oblivion_RESP1"
msgid ""
"Near Brindle Home you will find Melus Petilius. A good man. An honorable man. "
"He disgusts me. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_information_00009224_Oblivion_RESP4"
msgid ""
"Nearly invincible, he has established himself somewhere in the north of "
"Cyrodiil. This is all that I know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00062bcd_Oblivion_RESP1"
msgid "Necromancers have attacked our very homes. What could be next?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006c29a_Oblivion_RESP1"
msgid ""
"Necromancy may be legal in Cyrodiil, but few will openly admit to practicing "
"it now that the Mages Guild has banned it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG11ChoiceWhyBusy_00033632_Oblivion_RESP3"
msgid "Necromancy, of all things!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004e958_Oblivion_RESP1"
msgid "Need I remind you once more?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_00038996_Oblivion_RESP1"
msgid "Need a bite to eat? Maybe something to wash it down with?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_000091c2_Oblivion_RESP1"
msgid "Need a book? You've come to the right place."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00048702_Oblivion_RESP1"
msgid "Need a hand, Associate?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_000091c9_Oblivion_RESP1"
msgid "Need a new mount? I have fine horses for sale here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_bed_000b983f_Oblivion_RESP1"
msgid ""
"Need a place to rest? I have a room available, if you'd care to rent it for a "
"night."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_000091c4_Oblivion_RESP1"
msgid "Need new clothing? I have a fantastic selection."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_0005e079_Oblivion_RESP1"
msgid ""
"Need something sharp? Stabbing, cutting, that sort of thing? I can "
"accommodate you, I assure you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5a7_Oblivion_RESP1"
msgid "Need to practice more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46GoblinWar_0002f477_Oblivion_RESP3"
msgid "Neither one sounds like a picnic to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_000895dd_Oblivion_RESP1"
msgid "Nelrene admits to being involved, but more evidence may be required."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE05HerdirInvestigateCurrentTask_0008e505_Oblivion_RES"
"P1"
msgid ""
"Nelrene caved in, finally, but we'll need something more to get to the bottom "
"of this. Let's see if Ma'zaddha provides us with more evidence."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE05HerdirInvestigateCurrentTask_0008e507_Oblivion_RES"
"P1"
msgid ""
"Nelrene is clearly withholding information. Persuasion might be in order, or "
"perhaps Ma'zaddha will have something that will help."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE05HerdirInvestigateWho_0008e504_Oblivion_RESP1"
msgid ""
"Nelrene is lying to you, Inquisitor. She knows more than she tells. You "
"should address that as soon as possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028c36_Oblivion_RESP1"
msgid ""
"Nels is a Nord, and like all Nords he's a lawless barbarian with no respect "
"for authority."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_000286dd_Oblivion_RESP1"
msgid ""
"Nels is a drunk. He's doesn't even try to hide that fact. But what else is "
"he? When the liquor has dried, what remains of the man? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028cd8_Oblivion_RESP1"
msgid ""
"Nels is dead. You know what that means? You've just shot to the top of my "
"suspect list. You make one wrong move and I'll break you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028cd3_Oblivion_RESP2"
msgid ""
"Nels killed those people and pretty soon he'll come for the rest of it. Don't "
"you worry, when I gather more evidence, I'll take that scum down!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_000286ed_Oblivion_RESP1"
msgid ""
"Nels seems just as unnerved as the rest of us that someone has been killed, "
"but he seems to find solace in a bottle. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_tasks_0000bee2_Oblivion_RESP1"
msgid ""
"Nenyond Twyll awaits you. Return with Mucianus as quickly as possible, so I "
"may settle the Council's fears."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008dd5b_Oblivion_RESP1"
msgid "Never again. Never again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_0004762f_Oblivion_RESP1"
msgid ""
"Never compromise. Never blink. Never wink at injustice. Never quit trying to "
"make this a better city for everyone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAClavicusChoice4_00026b17_Oblivion_RESP2"
msgid ""
"Never did say where it came from. She just showed up with it one day. Said it "
"was called Umbra. But she was different. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAClavicusChoice6_00026b19_Oblivion_RESP2"
msgid ""
"Never did say where it came from. She just showed up with it one day. Said it "
"was called Umbra. But she was different. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EyeofNocturnalTOPIC_00026ac7_Oblivion_RESP1"
msgid ""
"Never heard of the thing. And neither has Bejeen. You ask too many questions."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ForlornWatchman_000365fe_Oblivion_RESP1"
msgid ""
"Never heard the name Grantham Blakeley before. Means nothing to me, sorry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfc2_Oblivion_RESP1"
msgid "Never liked you, Redguard. Never will."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0002b7aa_Oblivion_RESP1"
msgid "Never mind, then."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Lost_00081a3a_Oblivion_RESP1"
msgid "Never mind. A trick of the wind, perhaps."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_00032b0d_Oblivion_RESP1"
msgid "Never mind. Get that gate open."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Lost_00081a3d_Oblivion_RESP1"
msgid ""
"Never mind. I must continue to channel Lord Jyggalag's power into the pool."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37EndConversation_000452f4_Oblivion_RESP1"
msgid "Never mind. I'll find someone else to help me with my research."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_causingtrouble_0002ae34_Oblivion_RESP2"
msgid "Never mind. You've done your job. Here's your payment for it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07Strangers_00020072_Oblivion_RESP2"
msgid ""
"Never seen 'em, but I've heard her talking to someone, and I've seen somebody "
"at the window when Jearl wasn't home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03AReward_0007f3cf_Oblivion_RESP4"
msgid ""
"Never seen anything like it, but perhaps his journal can give you some useful "
"information."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d48d_Oblivion_RESP1"
msgid "Never seen you here before."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008ea20_Oblivion_RESP1"
msgid "Never trust what anyone tells you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD07Choice4_0009819c_Oblivion_RESP1"
msgid "Never! I would rather die! I will tell you nothing!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD07Choice4_0009819d_Oblivion_RESP1"
msgid "Never! I would rather die! I will tell you nothing!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035676_Oblivion_RESP4"
msgid ""
"Nevertheless, I shall endeavor to change his mind on the subject. Return "
"tomorrow - perhaps he will see you then."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08NelsNevConvo_000852c9_Oblivion_RESP1"
msgid ""
"Nevertheless, I still serve the Empire in my heart and will not abide such "
"talk! Walk away from me now, barbarian, or you'll regret your arrogance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Message_0018bc5a_Oblivion_RESP3"
msgid ""
"Nevertheless, you have done your part. Now, if you wish to learn from me, I "
"have much I can teach you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_0002816d_Oblivion_RESP1"
msgid ""
"Neville has a strong sense of justice, I can tell. If we find out who the "
"killer is, he'll take care of things, if you know what I mean. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028261_Oblivion_RESP1"
msgid ""
"Neville is a trained killer! That fascist pig killed those people, I just "
"know it!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_0002825b_Oblivion_RESP3"
msgid ""
"Neville may not be in the Legion anymore, but who knows what atrocities he "
"committed.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_000286fc_Oblivion_RESP1"
msgid ""
"Neville seems different now that someone has been killed. More alert, more "
"aware. Something tells me he's not going to take all of this lying down."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_0002816c_Oblivion_RESP1"
msgid ""
"Neville used to be a soldier. I'm sticking close to him. He makes me feel "
"safe. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_0002879f_Oblivion_RESP2"
msgid ""
"Neville was probably the most capable fighter among us, yet he was cut down "
"silently, just a few rooms away. I fear one of us is not who they appear."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028704_Oblivion_RESP1"
msgid ""
"Neville was strong, a soldier. If he was murdered, this does not bode well "
"for the rest of us!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SENewSheothTOPIC_00078ca4_Oblivion_RESP1"
msgid ""
"New Sheoth is the capital of the Shivering Isles. We Aureal guard Bliss, the "
"Manic district of the city."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000432cd_Oblivion_RESP1"
msgid ""
"New adventurers? New slaves for Cindanwe, you mean. If you see them, tell "
"them to steer clear of Fellmoor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00040bc0_Oblivion_RESP1"
msgid "New around here? Well, we can start off by getting one thing straight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000b121a_Oblivion_RESP1"
msgid "New blood. What is it?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ChorrolNQDQuestionResponses_000238c2_Oblivion_RESP1"
msgid "New books? Who has the money to afford all those books? I know I don't."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_00060950_Oblivion_RESP1"
msgid "New faces in the Isles? That doesn't bode well."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00042daf_Oblivion_RESP1"
msgid "New people in the Isles usually means trouble."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KnightsofThorn_00031c83_Oblivion_RESP1"
msgid "New to these parts, eh?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00042d95_Oblivion_RESP1"
msgid ""
"Newcomers are entering the Shivering Isles. With new people comes new "
"treasure!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000432ce_Oblivion_RESP1"
msgid ""
"Newcomers mean new pests. New pests mean more blood! More blood means a very "
"busy Relan...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000432bd_Oblivion_RESP1"
msgid ""
"Newcomers to the isles, you say? Bah! Unless they're here to work my farms, I "
"couldn't care less."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001b081_Oblivion_RESP1"
msgid ""
"News of your success in the Fringe precedes you. To further cement the "
"victory I have an important task for you to perform."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThreeSigns_00026af5_Oblivion_RESP3"
msgid ""
"Next is the plague of Famine. It is foretold that our livestock will fall "
"dead in their fields, with no apparent explanation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThreeSigns_0006bf17_Oblivion_RESP3"
msgid ""
"Next is the plague of Famine. It is foretold that our livestock will fall "
"dead in their fields, with no apparent explanation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00086768_Oblivion_RESP1"
msgid "Next time you want to \"help out,\" just don't."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007311c_Oblivion_RESP1"
msgid "Next time, bring some Skooma with you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00051798_Oblivion_RESP1"
msgid ""
"Next time, go someplace else, huh? The Inn of Ill Omen, the Tiber Septim "
"Hotel... Anywhere but here, okay?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003375e_Oblivion_RESP1"
msgid "Next time, on time, please."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_000182b4_Oblivion_RESP1"
msgid ""
"Next up is a Dark Elf. I've never seen him fight before, but he's got a bow "
"as well as a sword, so be ready for a ranged attack!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SERunsInCirclesYell_00041211_Oblivion_RESP1"
msgid "Ni-ni-ni-ni-ni-ni-ni-ni-ni-ni!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bca2_Oblivion_RESP1"
msgid "Nibenay is a region of mixed farmland, parkland, and forest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bca4_Oblivion_RESP1"
msgid ""
"Nibenay is bordered on north and east by rugged mountains and to the south by "
"marshes and rainforest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SERunsInCirclesGreetD_0004120c_Oblivion_RESP1"
msgid "Nice and crunchy! Thanks!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00042ff5_Oblivion_RESP1"
msgid ""
"Nice doggy. Good doggy. Don't hurt me, doggy. Doggy want a bone? No no, not "
"my bones, not my bones! Eeek!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TestChoice02_000281b0_Oblivion_RESP1"
msgid ""
"Nice pick. the 2nd one is a long choice,  You should have the topics back "
"again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMalacathSpeech_000579cf_Oblivion_RESP1"
msgid "Nice present! Good! And from a nice Orc, too! Double good!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000be55d_Oblivion_RESP1"
msgid "Nice to meet you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001e0e8_Oblivion_RESP1"
msgid "Nice to meet you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001db15_Oblivion_RESP1"
msgid "Nice to see you again. Is there something you require?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_0002396e_Oblivion_RESP1"
msgid ""
"Nice town. But you need money here to live well. Head out of town and do some "
"hunting. Sell the skins. Or, you can loot old caves and ruins."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005376a_Oblivion_RESP1"
msgid "Nice try."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackwaterBrigands_0000c1d1_Oblivion_RESP1"
msgid ""
"Nice work getting rid of them. If you ever need a job as a bouncer, I am sure "
"I could put in a good word at some of the tougher taverns in town."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000165ab_Oblivion_RESP1"
msgid "Nice work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0ac_Oblivion_RESP1"
msgid ""
"Nice, friendly folk in Anvil, even the Countess greets me in the street. "
"Well, except for that Newheim the Portly. He's a mean old scroat."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033b38_Oblivion_RESP1"
msgid "Nice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00062334_Oblivion_RESP1"
msgid "Nicely done. You want training from me, you've got it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0018bd63_Oblivion_RESP1"
msgid "Night Mother grant me strength!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0018bd6c_Oblivion_RESP1"
msgid "Night Mother! I beg your mercy!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalSpeech_00084a4a_Oblivion_RESP1"
msgid "Night among strangers. Secrets in the dark. Nocturnal is here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e06_Oblivion_RESP1"
msgid "Nine of the evening watch, and all's well. Good to see you, ma'am. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e8e_Oblivion_RESP1"
msgid "Nine of the evening watch, and all's well. Good to see you, sir. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e19_Oblivion_RESP1"
msgid "Nine of the morning watch, and all's well. Good morning to you, ma'am. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023ede_Oblivion_RESP1"
msgid "Nine of the morning watch, and all's well. Good morning to you, sir. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004e94e_Oblivion_RESP1"
msgid ""
"Nirnroot doesn't need sunlight to thrive. Don't forget to check underground "
"as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BleakersWayTopic_0001ebd7_Oblivion_RESP3"
msgid ""
"Nivan Dalvilu and I lead the community, and have done so for many years. It "
"is an excellent arrangement."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NivanDalviluTOPIC_0001ebdc_Oblivion_RESP1"
msgid ""
"Nivan has been murdered, and by one of the Ulfgar clan! Barbaric Nords! "
"Mindless animals! They will pay for their actions."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NivanDalviluTOPIC_0001ebdd_Oblivion_RESP1"
msgid ""
"Nivan is murdered! How could this have happened? Everyone was fond of Nivan, "
"including the Ulfgar clan. We must find the assassin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00046308_Oblivion_RESP2"
msgid "No ... no, we can do this. We have to do this. We have no choice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036649_Oblivion_RESP2"
msgid ""
"No ... that was the dream. I am awake now. I must fulfill my oath to the "
"Emperor before I can finally rest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_000251cc_Oblivion_RESP1"
msgid ""
"No Dark Brother or Sister has successfully infiltrated the Imperial Prison in "
"over three hundred years. This will be a true test of your abilities."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45NoFork_00078787_Oblivion_RESP1"
msgid ""
"No Fork for me? Very sad Big-Head. Sadsadsadsad. Come back when it sings to "
"you. Songs of returning."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00071f53_Oblivion_RESP1"
msgid "No apples. Don't like apples. Got mutton? Fritters?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03GrommokChamThreeMan04_000781ac_Oblivion_RESP1"
msgid "No chance to defend myself? No chance for battle? Why?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09HaskillBodyParts_00081daa_Oblivion_RESP2"
msgid ""
"No choice is without consequence. Each of the pieces is woven with magic, and "
"will become a part of the new Gatekeeper."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_00080d41_Oblivion_RESP1"
msgid "No conspiracies here. Go pester someone else."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterFail_000091de_Oblivion_RESP1"
msgid "No deal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterFail_0008273e_Oblivion_RESP1"
msgid "No deal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterFail_0003d07a_Oblivion_RESP1"
msgid "No deal. Better I should steal it myself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c20e_Oblivion_RESP1"
msgid ""
"No doubt about it, the man loves cheese. And sheep. Just cheese and sheep."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG11ChoiceSent_00033633_Oblivion_RESP2"
msgid ""
"No doubt the Council is trying to get you to bother me further. I ran Caranya "
"out of here just a short while ago, and told them to leave me alone!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c22b_Oblivion_RESP1"
msgid "No doubt, they make a fine wine at the Surilie Vineyards."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerPositive_0002420c_Oblivion_RESP1"
msgid "No doubt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerPositive_0002b151_Oblivion_RESP1"
msgid "No doubt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerPositive_0002b15a_Oblivion_RESP1"
msgid "No doubt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalConvo1_00026ab9_Oblivion_RESP1"
msgid ""
"No fisherman is going into Tidewater Cave. It's full of trolls. We have to "
"sneak past them, remember?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_0003b34c_Oblivion_RESP1"
msgid ""
"No gold, no room. Sorry, but that's the way it goes. I don't make exceptions."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GuardTalk2_0006fdd8_Oblivion_RESP1"
msgid ""
"No heroics now, all right? Remember your training and do what you have to do, "
"but don't take any unnecessary risks. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD08Choice1_000356ef_Oblivion_RESP1"
msgid ""
"No jobs? Ha! There is much work to be done here in Cyrodiil! The Blackwood "
"Company is more than willing to do it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00095a63_Oblivion_RESP1"
msgid ""
"No luck yet, hmm? Please, don't give up. That crystal ball means so much to "
"me. It was my mother's, you see... "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37No_000452fa_Oblivion_RESP1"
msgid "No luck, huh? Well, I have to get back to my research. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk3_00068354_Oblivion_RESP1"
msgid ""
"No matter what happens, you must know... You must all know, that I am "
"eternally grateful for the service you Blades have provided. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PellsGateTOPIC_00026b1f_Oblivion_RESP3"
msgid ""
"No matter. I am what I have become, and I know my fate. But what of you? What "
"is it you seek? My death? My blade?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06KanehFinalC_000400de_Oblivion_RESP3"
msgid "No matter. I serve him, not you. Stand aside."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDRodericGreetC_00002aa3_Knights_RESP1"
msgid ""
"No matter. I thought I detected the light of a divine purpose in your eye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11SheogorathChoice2_00014b68_Oblivion_RESP3"
msgid ""
"No matter. Soon you and everyone else will be dead, and I will be left a mad "
"god, ruler of a dead realm. Again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EmfridDEMOchoice3_00028a30_Oblivion_RESP4"
msgid "No matter. Will you ask him to visit me? I would be most grateful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047355_Oblivion_RESP3"
msgid ""
"No matter. You are too late to stop Lord Dagon's victory. Soon we will return "
"to Tamriel, to rule over it as lords."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002b45e_Oblivion_RESP4"
msgid ""
"No mere shopkeeper knows their true worth. If you bring them to me when you "
"find them, I will pay you double for each one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001da53_Oblivion_RESP2"
msgid ""
"No messy bodies left behind, no evidence. I was sloppy last time with "
"Roland's lover, and I won't make the same mistake twice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_000b6c1f_Oblivion_RESP1"
msgid "No money, no room. I'm running a business here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033771_Oblivion_RESP1"
msgid "No more delays, please."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_weaponsshipment_00028884_Oblivion_RESP1"
msgid ""
"No more needed for me. I have this fine blade with which I'll slaughter some "
"of these miserable beasts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13Gate_00030578_Oblivion_RESP1"
msgid ""
"No more will the gate threaten the good people of Cheydinhal. The Knights of "
"the Thorn have triumphed once more!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_COERCELOVE_0018b2d1_Oblivion_RESP1"
msgid "No more! You're frightening me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05PostTortureGreet_00089618_Oblivion_RESP1"
msgid "No more, no more!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00082573_Oblivion_RESP1"
msgid "No mortal may enter the halls of Brellach."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00082572_Oblivion_RESP1"
msgid "No mortal may enter the halls of Pinnacle Rock."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c989_Oblivion_RESP1"
msgid ""
"No need to go to the Imperial City. Bruma may look like a Skyrim town, but "
"we've got all the comforts of the warm Nibenean south."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RaynilDralasTopic_00038f11_Oblivion_RESP1"
msgid "No news yet, eh?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk2_00068357_Oblivion_RESP1"
msgid ""
"No no no no... It's all right... Everything's fine. There's no cause for "
"alarm, really. I only wanted to share a few words. With a friend. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_thieves_00002e51_Oblivion_RESP3"
msgid ""
"No offense to you or your friend, of course. Last I heard, they were holed up "
"in Hrota Cave, not too far from here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG10Choice2A_00035f50_Oblivion_RESP3"
msgid ""
"No offense to you, friend. It's not your fault. And perhaps you can help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_thieves_00002e55_Oblivion_RESP3"
msgid ""
"No offense to your friend, of course. Last I heard, they were holed up in "
"Hrota Cave, not too far from here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG11ChoiceHeretohelp_00033634_Oblivion_RESP2"
msgid ""
"No offense, but I don't see how you can do that. Unless you'd like to take "
"some of this work off my shoulders, I'm beyond helping."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_0004766f_Oblivion_RESP1"
msgid ""
"No one can experience the City for you. You must go, walk, touch, see, feel, "
"talk to everyone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008ef69_Oblivion_RESP1"
msgid "No one defeats Grommok! No one!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48DoorBlocked_00098155_Oblivion_RESP1"
msgid "No one goes through this door unless under the Captain's orders."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48DoorBlocked_00098156_Oblivion_RESP1"
msgid "No one goes through this door unless under the Captain's orders."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15SavageGarden_00047365_Oblivion_RESP6"
msgid ""
"No one has yet found a way to leave the Garden, except those few given the "
"Bands of the Chosen and allowed to enter the Forbidden Grotto."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MythicDawnTopic_00035c58_Oblivion_RESP2"
msgid ""
"No one knows how widespread the cult is, or where their shrine to Mehrunes "
"Dagon is located."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48BerichSaveYou_0008dfdc_Oblivion_RESP2"
msgid ""
"No one leaves this Chapel until the Captain gives the all-clear. I have my "
"orders."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_vampirehunters_000039c0_Oblivion_RESP1"
msgid ""
"No one like that staying here, I can assure you. I don't want that kind of "
"clientele."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDAnvilChapel_00002a98_Knights_RESP3"
msgid ""
"No one saw who did it. No one yet living, that is. Although many heard the "
"screams."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00022a08_Oblivion_RESP1"
msgid "No one tangles with Kurdan... remember that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bc9a_Oblivion_RESP1"
msgid ""
"No one wants to live in the Jerall Mountains. Well, maybe in Bruma, but "
"they're like Nords. They don't feel the cold."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AerinsCampTopic_000613bc_Oblivion_RESP3"
msgid "No one was here, so I thought I'd settle in."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilD2_0003fbe4_Oblivion_RESP4"
msgid ""
"No one wearing the Bands of the Chosen can leave the Grotto. You'll discover "
"that for yourself soon enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilD1_0003fbe2_Oblivion_RESP2"
msgid ""
"No one wearing the Bands of the Chosen can leave this Grotto. The doors will "
"not open, and there is no other way out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilD1_00047229_Oblivion_RESP2"
msgid ""
"No one wearing the Bands of the Chosen can leave this Grotto. The doors will "
"not open, and there is no other way out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilD1_0008b0a9_Oblivion_RESP4"
msgid ""
"No one wearing the Bands of the Chosen can leave this Grotto. The doors will "
"not open, and there is no other way out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS31Selene04aPositive_00015262_Oblivion_RESP2"
msgid "No one will find us there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c19b_Oblivion_RESP1"
msgid "No one works harder than Marie."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS43Staff_0004f8bc_Oblivion_RESP3"
msgid ""
"No one would buy that thing once it's activated like it's been. The only "
"chance is to return it to its original resting place, Darkfathom Cave."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e47_Oblivion_RESP1"
msgid ""
"No one's going out to Harlun's Watch after what the Fighters Guild found "
"there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusH_0001e90d_Oblivion_RESP2"
msgid ""
"No one's more surprised than me that I'm sending an escaped prisoner off with "
"the Amulet of Kings!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08Choice7C_00085a6b_Oblivion_RESP1"
msgid ""
"No opinion, huh? Maybe I'll just stay close to him for a bit. You know, hover "
"about and see if he notices me. Maybe then we can talk."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f416_Oblivion_RESP1"
msgid ""
"No precious army will bring back Lady Syl. Without her, who will let me do "
"what I do best?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08GreymarchTopic_0009130e_Oblivion_RESP2"
msgid "No pressure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG02NoBribeBeggar_00008030_Oblivion_RESP1"
msgid ""
"No problem. He has an office on the first floor of the Imperial Palace. Try "
"there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGDPost2_0006e2e5_Oblivion_RESP1"
msgid "No problem. I'll see to it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00053767_Oblivion_RESP1"
msgid "No proof, no money."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolNQDResponses_00029fd4_Oblivion_RESP1"
msgid "No question about it. And Seed-Neeus is an excellent proprietor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_00049921_Oblivion_RESP1"
msgid ""
"No question about it: Stonewall shields has the best pieces of steel to hide "
"yourself behind."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_0004994a_Oblivion_RESP1"
msgid ""
"No real question what Urbul is going for there. He's got weapons. Big weapons."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009db26_Oblivion_RESP1"
msgid "No repeat offenders! That's my motto!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00159755_Oblivion_RESP1"
msgid "No rest for the weary Orgnolf."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServiceRefusal_0003db3b_Oblivion_RESP1"
msgid "No service for the likes of you. Take a hike."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00017dd9_Oblivion_RESP1"
msgid "No sign of Armand Christophe, Sir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10WhatAboutSyl_0001b6bb_Oblivion_RESP1"
msgid ""
"No sign of her yet. We'll do our best to track her down, and deliver her to "
"Lord Sheogorath for a fitting punishment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10WhatAboutThadon_0001b6b8_Oblivion_RESP1"
msgid ""
"No sign of him yet. We'll do our best to track him down, and deliver him to "
"Lord Sheogorath for a fitting punishment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00017c2e_Oblivion_RESP1"
msgid "No sign of him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_00032b0f_Oblivion_RESP1"
msgid "No sign of pursuit, sir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000982d0_Oblivion_RESP1"
msgid "No sign of the Gray Fox, sir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008ef54_Oblivion_RESP1"
msgid "No sign of trouble, Your Grace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00017c5f_Oblivion_RESP1"
msgid "No sir. Please don't hurt me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesStaff_0002c67d_Oblivion_RESP1"
msgid ""
"No staff yet? Well, keep at it. Those charm scrolls should do most of the "
"work for you, if you put them to good use."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10GreymarchTopic_0009148a_Oblivion_RESP2"
msgid "No stopping now. Some things can't be stopped. Trust me. I've tried."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_000182a8_Oblivion_RESP1"
msgid ""
"No surprises with this next one, just a High Elf with a chip on her shoulder. "
"Get up to that Arena and make her beg for death!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003375a_Oblivion_RESP1"
msgid "No sweat."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE40SleepOutsideChoiceNoSweetroll_000790b7_Oblivion_RE"
"SP1"
msgid "No sweetroll for Fimmion, no answer to problem. Hrmph."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000a7149_Oblivion_RESP1"
msgid ""
"No talk, no talk! Only train! Branwen and Saliith, we become combatants in "
"Arena! We fight, we be champions, we be famous!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00082ead_Oblivion_RESP1"
msgid ""
"No talking. And, by the way, we execute escaping prisoners. Just a friendly "
"reminder."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e91d_Oblivion_RESP1"
msgid ""
"No time to chat. The ceiling looks like it's about to buckle. Got to move."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003857f_Oblivion_RESP1"
msgid "No time to talk now, you must hurry to Boreal Stone Cave!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00090625_Oblivion_RESP1"
msgid "No time to talk! I have to get rid of these rats!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00098169_Oblivion_RESP1"
msgid "No time to talk. Attack!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000b6bff_Oblivion_RESP1"
msgid "No time to talk. Go away."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004a988_Oblivion_RESP1"
msgid "No time to talk. I've got a job to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000bf38_Oblivion_RESP1"
msgid "No time to talk. Let's go home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NQDGuardWarning_0018d210_Oblivion_RESP1"
msgid "No touching the locks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGEmperor17_00032481_Oblivion_RESP1"
msgid ""
"No trophies of my triumphs precede me. But I have lived well, and my ghost "
"shall rest easy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_causingtrouble_0002c7b3_Oblivion_RESP1"
msgid ""
"No trouble here. No nothing here! No fun. No work. Nothing! Blackwood "
"Company's got all the work. There's nothing left for us! 'Cept for drinking."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47MageShopTalk_00030132_Oblivion_RESP4"
msgid ""
"No understanding of the pitfalls of experimental magic! Finally, I decided "
"that permanent invisibility was the only way to get some peace and quiet."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000290e_Knights_RESP3"
msgid ""
"No unworthy soul shall lay hands upon this sacred artifact without the leave "
"of the Knights of the Nine. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007eab0_Oblivion_RESP1"
msgid ""
"No way! I'm never talking to you, ever again! After she found out what I told "
"you... she... she... you have no idea what Pain is until she... she..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081da7_Oblivion_RESP1"
msgid ""
"No way! I'm never talking to you, ever again! After she found out what I told "
"you... she... she... you have no idea what Pain is until she... she..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_00024214_Oblivion_RESP1"
msgid "No way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_0002b162_Oblivion_RESP1"
msgid "No way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_0002b16f_Oblivion_RESP1"
msgid "No way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterFail_00061ff8_Oblivion_RESP1"
msgid "No way. I'm not taking that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006249f_Oblivion_RESP1"
msgid ""
"No wonder Narina Carvain is so cranky. If you had to live year-round in a "
"cold, drafty, soot-stained castle like Bruma, you'd be cranky, too."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_0002acad_Oblivion_RESP1"
msgid "No worries. Whatever happened at Kvatch won't happen here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_00024212_Oblivion_RESP1"
msgid "No!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_0002b167_Oblivion_RESP1"
msgid "No!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_0002b174_Oblivion_RESP1"
msgid "No!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenVoice_0001e8e0_Oblivion_RESP1"
msgid "No!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraSpeech_00084aab_Oblivion_RESP1"
msgid "No!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FearGeneral_00024265_Oblivion_RESP1"
msgid "No!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0005dc8e_Oblivion_RESP1"
msgid "No!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Murder_0018d82f_Oblivion_RESP1"
msgid "No!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SurpriseReceive_00024249_Oblivion_RESP1"
msgid "No! Come on!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488dd_Oblivion_RESP2"
msgid ""
"No! I am here! I stand proud before you, City-Swimmer, trainer of the "
"prospective Sneaker, the sly sliding unseen!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AReplace_00014000_Oblivion_RESP1"
msgid ""
"No! I cannot even think such thoughts. How do I know I can trust you won't "
"become just as tyrannical as she has?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BSylLeaves_0003b823_Oblivion_RESP1"
msgid ""
"No! I see what's going on. I should have seen it before. You conspire to "
"destroy us all! You're a fool if you think I'll allow this to happen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD07Choice3_0009819a_Oblivion_RESP1"
msgid "No! I will not betray him! I will not tell you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37EndConversation_000452f6_Oblivion_RESP1"
msgid ""
"No! I've warned you before to keep your brooms out of my house! Just go away. "
"I'll find someone else to help me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BSylLeaves_0003b81c_Oblivion_RESP1"
msgid "No! Let her go!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AThadonLeaves_000206bc_Oblivion_RESP1"
msgid "No! Let him go!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Flee_000872dd_Oblivion_RESP1"
msgid "No! No!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036305_Oblivion_RESP3"
msgid ""
"No! No, I'm too late! I thought I could get here in time, thought I could "
"stop you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0006c67a_Oblivion_RESP1"
msgid "No! No, please don't hurt me! He paid me to do it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_0007cc3a_Oblivion_RESP1"
msgid "No! Not like this!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0007cc3e_Oblivion_RESP1"
msgid "No! Not like this!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0008ef74_Oblivion_RESP1"
msgid "No! Please!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice1A_00023f3a_Oblivion_RESP1"
msgid ""
"No! Please! I didn't mean to do it, you understand me? She struggled! I... I "
"told her to just stay still, but she wouldn't listen! I had no choice!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0009199a_Oblivion_RESP1"
msgid "No! Sheogorath, protect me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017473_Oblivion_RESP1"
msgid "No! The Wellspring!..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017cfa_Oblivion_RESP1"
msgid "No! The Wellspring!..."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03GrommokCrazyChatter_0008efb2_Oblivion_RESP1"
msgid "No! This is all wrong! This isn't how it's supposed to be!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateConv_0008548f_Oblivion_RESP1"
msgid "No! We hold them here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MartinBattleSpeech_0003d061_Oblivion_RESP1"
msgid "No! We make our stand here, today, for the whole of Cyrodiil!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00016b58_Oblivion_RESP2"
msgid ""
"No! You do not understand! Put away your weapons, I mean you no violence. "
"Perhaps you can help me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000661f6_Oblivion_RESP1"
msgid ""
"No! You filthy guttersnipe! You won't get away with this! By Sithis, if I "
"could only move my arms, I'd rip that smile right off your face!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SurpriseReceive_00024245_Oblivion_RESP1"
msgid "No! really?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15Voice_00088b61_Oblivion_RESP1"
msgid "No!! Get away from there! If I can just..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AngerReceive_0002425b_Oblivion_RESP1"
msgid "No!!!!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028265_Oblivion_RESP1"
msgid ""
"No, I didn't like the man. But why should you care? Please, just go away. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_000286eb_Oblivion_RESP1"
msgid ""
"No, I didn't really care for her, you commoner scum, but I never wanted "
"anything like this to happen to her!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterFail_0006201e_Oblivion_RESP1"
msgid "No, I don't think so. Try again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007eae5_Oblivion_RESP2"
msgid ""
"No, I don't think so. You're an adventurer?  How disgusting. Why don't you go "
"back the way you came?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ChorrolNQDQuestionResponses_00023893_Oblivion_RESP1"
msgid "No, I haven't. I've heard that he really knows his way around, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDRumorAttackResponse1_00002ba2_Knights_RESP1"
msgid "No, I haven't. What's happened?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEPykeZoeMaleneResponses_00091b58_Oblivion_RESP1"
msgid "No, Zoe. I don't. Everything I want is right here with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServiceRefusal_000613ab_Oblivion_RESP1"
msgid "No, child. Not while the barriers between worlds are so weakened."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002fd72_Oblivion_RESP5"
msgid ""
"No, friend. I'm afraid I don't know the way to Cheydhinhal, but good luck in "
"your travels. Please excuse me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05PlanA_00022cf2_Oblivion_RESP1"
msgid ""
"No, it should be me. I have a blood debt to repay these Mythic Dawn "
"assassins. Besides, I've trained for this kind of thing my whole life."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkDeadKnightNothing_00002ce5_Knights_RESP1"
msgid ""
"No, it's nothing. I appreciate your concern, but it isn't anything I am ready "
"to talk about right now. Perhaps later."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02RelmynaVisit_0001a12a_Oblivion_RESP1"
msgid "No, it's too much. I don't know why I keep coming to visit you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06ArctusGreetA_00040144_Oblivion_RESP2"
msgid ""
"No, light the Torch for Dementia and you'll see how we treat our friends. "
"Dementia takes care of its own."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark18Choice1A_0009078f_Oblivion_RESP2"
msgid ""
"No, my anger lies with the rest of my children. You see, I have known of "
"Mathieu Bellamont's intentions since he was just a boy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk4_0006834d_Oblivion_RESP1"
msgid ""
"No, my friend, it's all right. It's just that, being a Septim is much... "
"lonelier than I could have imagined. Perhaps my father felt the same way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37Response_000452e2_Oblivion_RESP1"
msgid ""
"No, no shoes. But how about a bath? You really should take a bath. You "
"shouldn't run any errands for Mirili until you take a bath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate2_00014453_Oblivion_RESP1"
msgid "No, no! I haven't been plotting anything! I swear it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000c45a7_Oblivion_RESP1"
msgid "No, no! Stay away from me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_0007cc3c_Oblivion_RESP1"
msgid "No, no! The pain!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0007cc49_Oblivion_RESP1"
msgid "No, no! The pain!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00040cbe_Oblivion_RESP1"
msgid ""
"No, no, don't come any closer. I have to finish my morning survey of the "
"dewfall at four precise locations."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_000238c3_Oblivion_RESP1"
msgid "No, no."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_0002b15f_Oblivion_RESP1"
msgid "No, no."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_0002b16c_Oblivion_RESP1"
msgid "No, no."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_000819a1_Oblivion_RESP1"
msgid "No, no. I know nothing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05SylKill_000139b2_Oblivion_RESP2"
msgid ""
"No, no. Too easy a fate for them. That's why you're going to help me. You're "
"going to find them, force their hands. Put them to the screws."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02RelmynaVisit_0001a12e_Oblivion_RESP1"
msgid ""
"No, not now! Don't you remember what happened last time you touched my tears? "
"Keep away!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05TortureChoice2F_000805a8_Oblivion_RESP1"
msgid "No, please no...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05TortureChoice2M_0007ff46_Oblivion_RESP1"
msgid "No, please no...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark17Choice2B_0005402f_Oblivion_RESP1"
msgid ""
"No, please! The lighthouse! Just outside the city walls! I think the robed "
"man lives there! In... in the cellar!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_00029692_Oblivion_RESP1"
msgid "No, sir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_0002b15d_Oblivion_RESP1"
msgid "No, sir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032eaa_Oblivion_RESP1"
msgid ""
"No, thanks. Walking around in the wilderness waiting for something to eat me, "
"looking for gold in a hole? You think I'm a dope?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Eavesdrop_0008117d_Oblivion_RESP1"
msgid "No, that blasted Inquisitor got to her. We'll need to find someone else."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_00032b07_Oblivion_RESP1"
msgid "No, they're dead. I know it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ADMIRELOVE_0018b2af_Oblivion_RESP1"
msgid "No, you do me too much honor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05NelreneSawYou_000811c9_Oblivion_RESP2"
msgid "No, you don't, do you? Well, then you'll get nothing out of me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ03MartinB3_0001e8d4_Oblivion_RESP1"
msgid ""
"No, you must have the wrong man. I am a priest of Akatosh. My father was a "
"farmer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_0003333b_Oblivion_RESP1"
msgid ""
"No, you'll never get to swim again, Argonian. But don't worry, you'll be dead "
"soon enough. That's right. You're going to die in here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingBlockYes_00062336_Oblivion_RESP1"
msgid ""
"No, you're not ready, because you've got a weapon equipped. You think I'm "
"stupid? You take off that weapon, and we'll try this again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_00015f11_Oblivion_RESP3"
msgid "No-one has ever seen his face because he always wears that gray cowl."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00098384_Oblivion_RESP1"
msgid "No-one steals from Fathis Aren!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_0002b163_Oblivion_RESP1"
msgid "No."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06MentionBook_000153b6_Oblivion_RESP1"
msgid ""
"No. But he did give me a message about a treasure to deliver to the Thieves "
"Guild if I was ever to get out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001a11e_Oblivion_RESP1"
msgid "No. Go away. I'm not here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS11AmuletTalk_00038b05_Oblivion_RESP1"
msgid ""
"No. He always feared this day would come. He left me knowledge of that word "
"in the event that he died and I came into possession of the keys."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ09GhostC_00036667_Oblivion_RESP1"
msgid ""
"No. He departed long ago. But his evil will remains, preventing any from "
"paying homage at the Shrine of Tiber Septim."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_000164b8_Oblivion_RESP1"
msgid "No. He is not one of them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BSylLeaves_0003b81f_Oblivion_RESP1"
msgid "No. I can't do this. There has to be a way out. A way to escape."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEZoeMalenePykeResponses_00091b4a_Oblivion_RESP1"
msgid ""
"No. I still can't decide what to paint today. The trees? The sky? It's all so "
"complicated!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MartinC1_0009ce82_Oblivion_RESP5"
msgid ""
"No. I'll lead the defense of Bruma myself. If I am to be Emperor, it's time I "
"started acting like one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EulogyImperial_0009f9bd_Oblivion_RESP1"
msgid "No. I'm afraid this Imperial was not the one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ03ComeWithMe_0001e8d6_Oblivion_RESP1"
msgid ""
"No. I'm sorry, but even if what you say is true, I won't abandon these people "
"to their fate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ16MessengerTopic_000146f2_Oblivion_RESP1"
msgid ""
"No. If we let ourselves get besieged in the Palace we're doomed. We must get "
"to the Temple of the One immediately."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Displeased_0001365c_Oblivion_RESP1"
msgid "No. No, no, no. Absolutely not."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AThadonLeaves_000206bf_Oblivion_RESP1"
msgid ""
"No. No. Certainly not. This isn't good. I'm sure it's bad. I can't do this "
"anymore. No more. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_0004f3e0_Oblivion_RESP1"
msgid "No. She is not one of them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND09ProphetGreeting01_00002c0d_Knights_RESP1"
msgid ""
"No. Should you face Umaril, you would suffer the same fate as Pelinal. But "
"times change and even the shape of the divine itself must change with it. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5cd_Oblivion_RESP1"
msgid "No. That's not it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WatersEdgeTOPIC_000356fe_Oblivion_RESP1"
msgid ""
"No. The entire town... I realize you must be disgusted with yourself. I'm "
"sorry for that. It was the Hist Sap, though, not you. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ00KvatchResponse_0018b20c_Oblivion_RESP1"
msgid ""
"No. They were taken by surprise. I'm sure the Legion has everything under "
"control."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03GrommokChamberOneDone02_0007300b_Oblivion_RESP1"
msgid "No. We'll pick him up on the way out. He must fend for himself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MogensTalk01_00086574_Oblivion_RESP1"
msgid "No. Who are you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36Choice5KillSelf_00061c4d_Oblivion_RESP2"
msgid "No. YOU must kill me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AngryMazoga01_000860e1_Oblivion_RESP1"
msgid ""
"No. You didn't know. It was my fault. But now you know everything. And you "
"helped me, and I won't forget."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02RelmynaVisit_0001a12d_Oblivion_RESP1"
msgid ""
"No. You mustn't come near me when I'm crying... you remember what happened "
"last time you touched my tears!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE02GatekeeperChoice2Accepted_0007eaed_Oblivion_RESP3"
msgid "No. You won't be getting in."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37EndConversation_000452ec_Oblivion_RESP1"
msgid ""
"No. You'd just spill on yourself anyway. Well, I have to go sweep my house. "
"It's been over an hour. Goodbye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG17TravenDestroy_000366ec_Oblivion_RESP1"
msgid ""
"No... I have need of it. I believe it may be instrumental in saving our guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenVoice_0001e8d3_Oblivion_RESP1"
msgid "No... Talos save us..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028a13_Oblivion_RESP1"
msgid ""
"No... no! When I looked into Dovesi's face it was like peering at my own "
"daughter. I... I feel like I've lost her all over again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38DeadNo_00023676_Oblivion_RESP2"
msgid ""
"No... no. I understand. It is my problem, and I should solve it myself. "
"You're right. I should never have involved you. Good night."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15Voice_00074a21_Oblivion_RESP1"
msgid "No... no... not again..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00066709_Oblivion_RESP1"
msgid ""
"No... you're dead! I killed you myself! What manner of creature are you? Will "
"I be tormented with your image forever?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028229_Oblivion_RESP1"
msgid ""
"No.... no! You... you stay away from me! One of you is the killer... stay "
"away from me! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG05Choice2B_000277a9_Oblivion_RESP1"
msgid ""
"No? Are you quite sure? I would hate to think that you do, in fact, have the "
"book, and simply have no intention of turning it over."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05SylHelpNo_0001361e_Oblivion_RESP1"
msgid ""
"No? Have you seen my torture chamber?  Because that's where you'll wind up if "
"you don't agree to assist me. Think on it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40JanusDecline_0003ed35_Oblivion_RESP1"
msgid ""
"No? I thought you might be interested yourself, given your condition. Should "
"you change your mind, simply speak with my steward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG00JoinB_0002d073_Oblivion_RESP1"
msgid ""
"No? Joining the guild is a good idea for anyone who wishes to become a "
"powerful mage, you know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40JanusDecline_0003ed36_Oblivion_RESP1"
msgid ""
"No? Perhaps I was mistaken about you. You know my plight; should you change "
"your mind, speak with my steward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingBlockNo_0006233a_Oblivion_RESP1"
msgid ""
"No? Suit yourself. You know what you have to do if you ever want training "
"from me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice4B_00022ba6_Oblivion_RESP1"
msgid ""
"No? The Night Mother seems to think otherwise. Allow me to grant you a gift, "
"in case you reconsider. It is a virgin blade, and thirsts for blood.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGExpelNo_00026d95_Oblivion_RESP1"
msgid ""
"No? Then I suggest you return to the world and gather them. We have nothing "
"to discuss otherwise."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG00JoinB_0002d071_Oblivion_RESP1"
msgid "No? Very well. Should you change your mind, you know where to find me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG03Choice1B_0002f17a_Oblivion_RESP1"
msgid "No? Well, then please excuse me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND03TestNo_00002a52_Knights_RESP1"
msgid ""
"No? You would think yourself above Kynareth's design? Then perhaps you should "
"not have come here at all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624c0_Oblivion_RESP1"
msgid ""
"Nobody goes into the mountains but hunters and thieves on the lam. Food and "
"shelter is hard to come by."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e3d_Oblivion_RESP1"
msgid ""
"Nobody likes the Blackwood Company. They're brutes, plain and simple.  But "
"they get the job done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ10BurdSpeech_00046304_Oblivion_RESP1"
msgid ""
"Nobody likes the idea of going into that thing, but it's our job, and we're "
"going to do it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_00035dcb_Oblivion_RESP1"
msgid ""
"Nobody really knows who he is. He's always hiding under that weird cowl. "
"Kinda spooky if you ask me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00073927_Oblivion_RESP3"
msgid ""
"Nobody who hasn't trained with the Blades will know these moves, so you "
"should find them useful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025e21_Oblivion_RESP1"
msgid ""
"None in the Fighters Guild will speak with you again. We have no desire to "
"consort with common criminals."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07Strangers_00020072_Oblivion_RESP3"
msgid "None of my business, but since you asked ..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_000be326_Oblivion_RESP1"
msgid "None of the other cities have sent aid. Bruma stands alone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AleronLocheTopic_0001f424_Oblivion_RESP1"
msgid "None of yer damn business. I'd tell you if I liked you... and I don't."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Ally04Tactic3_00017d63_Oblivion_RESP1"
msgid "None shall pass."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Ally04Tactic3_000181cb_Oblivion_RESP1"
msgid "None shall pass."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12TraitorTaunts_0008f7c5_Oblivion_RESP1"
msgid "None too soon. We have lived too long as the playthings of the Madgod."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12TraitorTaunts_0008f7cf_Oblivion_RESP1"
msgid "None too soon. We have lived too long as the playthings of the Madgod."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE42Calipers_00073232_Oblivion_RESP1"
msgid ""
"None? The world is devoid of calipers and tongs? What a sad state of affairs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e73_Oblivion_RESP1"
msgid ""
"Nonwyll Cavern is a good start. But the kid has to go out on his own, or "
"he'll never learn the hard lessons."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00038ee7_Oblivion_RESP1"
msgid "Nooo!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServiceRefusal_000613ba_Oblivion_RESP1"
msgid "Nope, don't feel like it. Too bad for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_000981d7_Oblivion_RESP1"
msgid "Nope."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetStartC2_00002c8a_Knights_RESP1"
msgid ""
"Nor do I. Oh my people, who will save you from destruction? Is there none now "
"worthy to be your crusader?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c1b6_Oblivion_RESP1"
msgid "Norbert Lelles runs a fine store, but he's not the brightest fellow."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028c3a_Oblivion_RESP1"
msgid ""
"Nords are raised to be cold-blooded killers. Don't take your eyes off Nels if "
"you value your life. I'll bet anything he's our murderer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c985_Oblivion_RESP1"
msgid ""
"Nords who drink either get friendly or mean. I'm here to deal with the mean "
"ones."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VampireTopic_0001d4bb_Oblivion_RESP1"
msgid ""
"Normal weapons won't harm a vampire, they must be enchanted. Make sure you're "
"equipped with such an item."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HackdirtTopic_000280be_Oblivion_RESP2"
msgid ""
"Normally I make the deliveries, but I wasn't feeling well so Dar-Ma insisted "
"on going this time.  I do hope nothing has happened to her!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22GiveCarving_0002af38_Oblivion_RESP2"
msgid ""
"Normally I would give you a chance to celebrate your success, but I do have "
"another task for you, if you are interested. A rather urgent one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12RootDungeon_00016d04_Oblivion_RESP3"
msgid ""
"Normally the Fountainhead is a peaceful sanctuary. But there's no telling "
"what changes the taint of Order may have wrought."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00072c93_Oblivion_RESP2"
msgid ""
"Normally the peasants do that work, but pod pits are special. They hatch into "
"beautiful birds!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07NewCaptain_00098399_Oblivion_RESP2"
msgid ""
"Normally these missives are handled by my steward, Dairihill. Let me see that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23HelpYes_000980f3_Oblivion_RESP1"
msgid ""
"Normally, I wouldn't approach a total stranger like this, but Gilen seemed so "
"insistent. Please, forgive my audacity..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MerchantTopic_0002ee50_Oblivion_RESP2"
msgid ""
"Normally, this would be a matter for the local law enforcement. Due to "
"certain circumstances, however, the Council has become involved."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479f9_Oblivion_RESP2"
msgid ""
"North along the Green Road is another hide-out... Rockmilk Cave. Like to hunt "
"bandits? Steal from those who steal? Such a sweet joke, yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0002557d_Oblivion_RESP1"
msgid "Northern Goods and Trade is an excellent place to buy supplies."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolNQDResponses_00029fd5_Oblivion_RESP1"
msgid "Not a bad idea if you're looking for work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGDPost1_0006e2dd_Oblivion_RESP1"
msgid ""
"Not a bad idea. We can use more men in the ranks. It has its advantages. It "
"gives the guild a greater presence. Makes people notice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39RanarrJo_000781f7_Oblivion_RESP2"
msgid ""
"Not a bad worker -- once he gets his mind on something -- but usually he's "
"doing something unproductive."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_00024217_Oblivion_RESP1"
msgid "Not a chance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_0002b164_Oblivion_RESP1"
msgid "Not a chance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_0002b171_Oblivion_RESP1"
msgid "Not a chance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RufioTopic_00023dd4_Oblivion_RESP1"
msgid ""
"Not a lot to tell. He doesn't much like company, and spends most of his time "
"in his room. Manheim thinks he's hiding out from someone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HackdirtTopic_000280a1_Oblivion_RESP1"
msgid ""
"Not a nice place to visit.  Those that remember still tell stories about the "
"bad old days."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThadonWaitingForever_000131d8_Oblivion_RESP3"
msgid ""
"Not a very good meal, though. Too much pie. Pie is a tricky thing, wouldn't "
"you say? Don't answer that either."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Flee_000872da_Oblivion_RESP1"
msgid "Not again!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND09ProphetQuestionsEnd_00002c18_Knights_RESP2"
msgid ""
"Not all who enter those halls shall return. Those who fall in service of the "
"Nine will live on forever in the halls of their fathers. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002006e_Oblivion_RESP7"
msgid ""
"Not an easy thing to come by, obviously, but we will need a daedric artifact. "
"Bring it to me when you have acquired one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06KanehFinalB_000400df_Oblivion_RESP2"
msgid ""
"Not at all. It was an honor to carry out such an agreeable duty at the "
"personal command of Lord Sheogorath's personal emissary."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerStatus_000241fd_Oblivion_RESP1"
msgid "Not bad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033b39_Oblivion_RESP1"
msgid "Not bad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JOKELIKE_0018b2da_Oblivion_RESP1"
msgid "Not bad. Not bad at all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00062456_Oblivion_RESP1"
msgid ""
"Not bad.... Not bad at all! Okay, you've definitely got some potential. I'll "
"teach you what I know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46DoublesTopic_0008fa8b_Oblivion_RESP1"
msgid ""
"Not enough corpses around here... but there should be. Those stupid Manics. "
"They ruin everything."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37ApprenticeSpell_0007b224_Oblivion_RESP1"
msgid "Not enough gold? I thought you looked like a pauper."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_000b12a1_Oblivion_RESP1"
msgid ""
"Not even 10 gold to your name? And here I thought I had it bad. Sorry, but I "
"need you to pay before I can let you stay here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005edf2_Oblivion_RESP1"
msgid ""
"Not every day we get a new Duke! Let's celebrate, you and me! Whaddya say you "
"buy the first round?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ThoronirBad_0000bca2_Oblivion_RESP2"
msgid ""
"Not every store is a member, but we're slowly trying to convince them to "
"join. Everything was fine until Thoronir opened his shop nearby."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0000c083_Oblivion_RESP2"
msgid ""
"Not far from from the ruins of Fort Sutch lie the ruins of a tower. That "
"tower was once part of the Fort Sutch Abbey. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND03GroveofTrials_00002be6_Knights_RESP1"
msgid ""
"Not far from here, to the west. Nestled within the Great Forest, it is a "
"place many would overlook."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGC07Choice3_000091fd_Oblivion_RESP1"
msgid ""
"Not far, in my family's ancestral tomb. Here, I can mark it on your map. "
"Please, return them to me, so I can pay off my father's debts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterFail_0005e00f_Oblivion_RESP1"
msgid "Not for that price. Try again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JOKEHATE_0018b2d6_Oblivion_RESP1"
msgid "Not funny. Not even a little bit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00074a07_Oblivion_RESP1"
msgid "Not good enough, I'm afraid!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026e65_Oblivion_RESP1"
msgid ""
"Not here! Not in public! We must never speak to each other outside the "
"Sanctuary! The risk of detection is too great!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06SheoIntro4_00082465_Oblivion_RESP1"
msgid ""
"Not here. Didn't I say that? I'm never here when Jyggalag walks. It's one of "
"the Rules."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_TG00MysteriousNoteTopic_00003459_Oblivion_RESP1"
msgid "Not here. Not now. Garden of Dareloth. Waterfront District. Midnight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01JoinThievesGuild_000355d1_Oblivion_RESP1"
msgid "Not here. The Garden of Dareloth, on the Waterfront. Midnight. Be there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UmbacanoTopic_000a984b_Oblivion_RESP2"
msgid ""
"Not like anyone would notice. I mean, what are the chances a thief would "
"choose that moment to try to break in?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13Gate_000329e9_Oblivion_RESP2"
msgid ""
"Not long after the gate opened, Farwil decided an assault was in order. We "
"charged inside, and promptly met resistance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13Gate_000579e1_Oblivion_RESP1"
msgid ""
"Not long ago, one of those foul gates manifested itself just outside the West "
"Gates of our city. Nothing's come out of it yet, but we fear the worst."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ08ArtifactN_00038fba_Oblivion_RESP1"
msgid ""
"Not many could resist the temptation of the Oghma Infinium. Now it is my turn "
"to be put to the test!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ08ArtifactJ_00038fb6_Oblivion_RESP1"
msgid ""
"Not many people would give up Spellbreaker for destruction, my friend. Your "
"sacrifice honors me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolNQDResponses_00029fd6_Oblivion_RESP1"
msgid "Not me. I've got plenty to do at home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00027336_Oblivion_RESP1"
msgid "Not much farther."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ChorrolNQDQuestionResponses_000238b2_Oblivion_RESP1"
msgid "Not much for wagering, myself. Of course, I always seem to lose...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000bcbe_Oblivion_RESP1"
msgid "Not much more I can do to help you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001efe0_Oblivion_RESP4"
msgid "Not much of a speech, was it? Didn't seem to bother them, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08Choice2C_0008585e_Oblivion_RESP1"
msgid ""
"Not much of a talker are you? All right then, I'll give you your space. It's "
"a shame, I thought we could be friends. But you're just so... strange."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_0002826e_Oblivion_RESP1"
msgid ""
"Not much to tell about me, really. I'm from Morrowind originally, but my "
"family moved to Valenwood a few years ago."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEChaliceofReversal_0001e401_Oblivion_RESP1"
msgid "Not my place to talk about it. You need to know, you talk to Wide-Eye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00030204_Oblivion_RESP1"
msgid "Not now!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ADMIREHATE_0018b2a9_Oblivion_RESP1"
msgid "Not now, not later, not ever."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00030205_Oblivion_RESP1"
msgid "Not now, you fool!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018a807_Oblivion_RESP1"
msgid "Not now. First we have to see about Myvryna."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004109c_Oblivion_RESP1"
msgid ""
"Not now. I need to concentrate. Can't you see I'm in the middle of something?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009f90d_Oblivion_RESP1"
msgid "Not now. I need to think."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003fbd7_Oblivion_RESP1"
msgid "Not now. Just do as I say until the dremora leaves."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008efc2_Oblivion_RESP1"
msgid "Not now. My spell will wear off my new pet any minute now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000c47cf_Oblivion_RESP1"
msgid "Not now. There's work to be done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07Strangers_00038bc5_Oblivion_RESP1"
msgid ""
"Not on my watch. Captain Burd will know for sure, though. We all report to "
"him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00051e9e_Oblivion_RESP1"
msgid "Not on this day!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS12PaleNo_00018236_Oblivion_RESP5"
msgid ""
"Not only did this make the Akaviri fight on two fronts, it also cut off "
"access to reinforcements and supplies from the sea."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c252_Oblivion_RESP1"
msgid ""
"Not only does Shameer make a good wine at the Tamika Vineyards, but he's "
"really good with his bow, too. I heard he'll train you, for a fee."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006c29e_Oblivion_RESP1"
msgid ""
"Not only has Necromancy been banned from practice in the Mages Guild, but the "
"Guild won't deal with anyone who openly uses it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001da4d_Oblivion_RESP2"
msgid ""
"Not only that, but we'd like to make you an honorary member. If you're ever "
"in need of our services, we'd be happy to provide them for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002dc7_Oblivion_RESP2"
msgid ""
"Not practicing it, mind you. Wouldn't want anyone to think I was involved in "
"that sort of thing. I simply meant researching it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS12Lost_00018237_Oblivion_RESP1"
msgid ""
"Not quite. The Army of Reman knew that the organized Akaviri forces were "
"commanded from a hidden post in the mountains."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_00024213_Oblivion_RESP1"
msgid "Not really."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_0002b168_Oblivion_RESP1"
msgid "Not really."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerNegative_0002b175_Oblivion_RESP1"
msgid "Not really."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEZoeMalenePykeResponses_00091b4b_Oblivion_RESP1"
msgid ""
"Not really. I was all set to paint the waters of the coast and I'm all out of "
"azure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Repair_00066a53_Oblivion_RESP1"
msgid "Not smart to carry around broken equipment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038aa6_Oblivion_RESP1"
msgid ""
"Not so loud, please. What a headache I've got. I'm Agnete the Smith. 'The "
"Pickled' they call me. Sure wish I was pickled right now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RaynilDralasTopic_00038f13_Oblivion_RESP1"
msgid "Not sure what happened to him, but I certainly haven't seen him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45ForkTopic_00083f61_Oblivion_RESP2"
msgid ""
"Not surprising, I suppose. He does enjoy his toys. Last I heard, some "
"Heretics had gotten hold of the item in question."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07Strangers_00020091_Oblivion_RESP1"
msgid ""
"Not that I can think of. People are mostly staying home, what with all the "
"troubles in the world."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47Counterspell_0003012e_Oblivion_RESP8"
msgid ""
"Not that I think anything will go wrong. Serious side effects are highly "
"unlikely."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00040bc4_Oblivion_RESP2"
msgid ""
"Not that it matters, really. I'm sure I'll lose my inspiration halfway "
"through."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07Strangers_00020071_Oblivion_RESP1"
msgid ""
"Not that it's anybody's business, but I have noticed voices coming from "
"Jearl's house. But I've never seen anybody but Jearl go in or out. Strange."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GlarthirTopic_00028d67_Oblivion_RESP3"
msgid ""
"Not that you'll get anyone else in town to admit it. \"Oh, he's harmless, "
"we're used to him.\" Harmless, ha!  One day he'll snap. Then watch out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000432ac_Oblivion_RESP1"
msgid "Not to worry, we'll have your spoils to you in no time at all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d2ad_Oblivion_RESP1"
msgid "Not until you've got those wines for me. I thought I made that clear."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServiceRefusal_00062337_Oblivion_RESP1"
msgid "Not until you've proven to me you can handle yourself with a shield."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServiceRefusal_000613bd_Oblivion_RESP1"
msgid ""
"Not while Kvatch is still in danger. Once we are all safe, perhaps I will "
"reconsider."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05PostTortureGreet_000819a2_Oblivion_RESP3"
msgid ""
"Not wise for me to be outside late at night; too easy to catch another cold. "
"But if the rumors are true, you should keep an eye out for them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07RitualYesD_0001365d_Oblivion_RESP3"
msgid ""
"Not wishing to find himself on the wrong end of a blade, he gathered his "
"flock here in the Sacellum."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_0004f77b_Oblivion_RESP1"
msgid "Not yet. Let me rest a moment longer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MartinE_00049815_Oblivion_RESP3"
msgid ""
"Not yet. Until we light the Dragonfires, the Gates are open, and Mehrunes "
"Dagon's invasion continues."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BrumaNQDQuestionResponses_000465dd_Oblivion_RESP1"
msgid ""
"Not your average skill for a priest, but I suppose there are those who will "
"always want to learn."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture4_00071955_Oblivion_RESP1"
msgid ""
"Note that three classes of runestones are named, respectively, Hestra Stones, "
"Reman Stones, and Sidri-Ashak Stones."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ09Retirement_00067dd3_Oblivion_RESP2"
msgid ""
"Nothin' can open it except for this key right here. And there ain't no way "
"anyone is gettin' this key while I'm still breathing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ09Retirement_000cbb73_Oblivion_RESP2"
msgid ""
"Nothin' can open it except for this key right here. And there ain't no way "
"anyone is gettin' this key while I'm still breathing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_0008aded_Oblivion_RESP1"
msgid "Nothin' in it for me, so I've nothin' to say to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusC_0001e8e8_Oblivion_RESP1"
msgid ""
"Nothing I ever heard about. But Jauffre would be the one to know. He's the "
"Grandmaster of my Order."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_InfoRefusal_0002461c_Oblivion_RESP1"
msgid "Nothing I would tell to you. Get lost."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TamrielGateResponses_0003e2cd_Oblivion_RESP1"
msgid "Nothing I'd like to talk about."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00074a12_Oblivion_RESP1"
msgid "Nothing can stop Lord Dagon now!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07Strangers_00020090_Oblivion_RESP1"
msgid ""
"Nothing comes to mind. Of course, my memory sometimes ain't what it used to "
"be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RaynilDralasTopic_0003842a_Oblivion_RESP1"
msgid ""
"Nothing else I can tell you about him. He comes and goes and doesn't talk to "
"people much."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15OrtheEldamil_0003eabb_Oblivion_RESP1"
msgid ""
"Nothing escapes your vigilance, kynreeve. Kathutet wondered as well. This is "
"why he sent her for questioning."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15OrtheEldamil_0003eaba_Oblivion_RESP1"
msgid ""
"Nothing escapes your vigilance, kynreeve. Kathutet wondered as well. This is "
"why he sent him for questioning."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034863_Oblivion_RESP1"
msgid ""
"Nothing has changed, child. The voices still cry out, and I am unable to "
"hear. If they can be sealed away, our work may begin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008da99_Oblivion_RESP1"
msgid "Nothing is as important as a man's home. We must have ours back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfcd_Oblivion_RESP1"
msgid "Nothing more for you, Imperial! Get out!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD07Choice4_0009819b_Oblivion_RESP1"
msgid "Nothing more! I choose death!  Long live the Blackwood Company!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e58_Oblivion_RESP1"
msgid ""
"Nothing much doing with the Fighters Guild. Though they got some contracts "
"out Anvil way, didn't they?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d306_Oblivion_RESP1"
msgid ""
"Nothing much more I can help with. I'm afraid you'll have to ask Gogan, my "
"lout of a husband, if you need to know anything else."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07Spies_0002008e_Oblivion_RESP1"
msgid "Nothing new to report on my end. Have you uncovered anything suspicious?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkRelics2_00002c72_Knights_RESP1"
msgid ""
"Nothing new to report, I'm afraid. But don't worry, our Commander will not "
"fail."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_00047425_Oblivion_RESP1"
msgid ""
"Nothing now. Not at your rank. Go see Azzan. In Anvil. Maybe he's got "
"something."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeSwordMagic_0001f3e7_Oblivion_RESP2"
msgid "Nothing pokes a hole in an argument like the pointy end of your sword."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00088b41_Oblivion_RESP1"
msgid "Nothing really matters here anyway."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00017c43_Oblivion_RESP1"
msgid "Nothing so far."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Lost_00095897_Oblivion_RESP1"
msgid "Nothing there, I guess."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00034471_Oblivion_RESP1"
msgid "Nothing to see here, citizen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Lost_0002d40a_Oblivion_RESP1"
msgid "Nothing to worry about, I guess. Just my eyes playing tricks on me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008dc9b_Oblivion_RESP1"
msgid "Nothing unusual happens there. Nothing at all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0007e960_Oblivion_RESP1"
msgid "Nothing warms the heart like the sound of rending flesh. Great choice!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46Choice1_0008fab8_Oblivion_RESP3"
msgid ""
"Nothing we can do about it, either. There's a law about that here. Been to "
"the Hill of Suicides? Not a nice place. But you might be able to help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD03Choice5_0002d730_Oblivion_RESP1"
msgid ""
"Nothing we need to talk about now. I'll pay Viranus for his contract. This is "
"for you. Who knows. I might be able to make soldiers out of you both."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ff28_Oblivion_RESP1"
msgid "Nothing! I knew it! Azani Blackheart isn't here, alive or dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062cd1_Oblivion_RESP1"
msgid "Nothing's keeping you here. So move on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FaelianTopic_0002ff10_Oblivion_RESP4"
msgid ""
"Now Faelian's hardly ever here. He's off using skooma, or wandering the city "
"looking for some, I imagine.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09JoinedGuild_00018335_Oblivion_RESP2"
msgid ""
"Now I am running errands for the Gray Fox himself. I owe you much for your "
"help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00062443_Oblivion_RESP2"
msgid "Now I can help you to improve those powers, to help make lives better."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0003c15b_Oblivion_RESP2"
msgid "Now I can teach you properly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_0002ba55_Oblivion_RESP2"
msgid ""
"Now I hear there's a stranger in town asking about them. A Dark Elf, from "
"back east they say. I wonder what he wants."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38DSNo_00023670_Oblivion_RESP2"
msgid ""
"Now I know for sure that they are all in on it. And therefore they all have "
"to die. Starting with you!!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23RolandSad_0001d4c6_Oblivion_RESP6"
msgid ""
"Now I know why he didn't finish me that night. He wanted to cast suspicions "
"on me instead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000837e7_Oblivion_RESP2"
msgid ""
"Now I'll tell you what I didn't tell everyone else. We have the same Mother, "
"you and I. And she wants you to have this. It's the key to the house."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetSpeechMain_00002a69_Knights_RESP1"
msgid ""
"Now Mara's children cry out from beyond the grave for vengeance! How many "
"more must die at Umaril's hand?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate2_00014482_Oblivion_RESP1"
msgid ""
"Now Miss Herrick, can we be frank with one another? I find you delightful. "
"I'd so enjoy the pleasure of your company for a long time to come."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08GiveStone_00014705_Oblivion_RESP3"
msgid ""
"Now for the bad news. You committed murder to retrieve the stone. I am forced "
"to remove you from the Thieves Guild until you pay the blood price."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0000a219_Oblivion_RESP1"
msgid "Now get out of here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47Counterspell_00030131_Oblivion_RESP7"
msgid ""
"Now get out of my sight before I make you sorry you meddled in my affairs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaICRaiment1_0003b1dd_Oblivion_RESP3"
msgid ""
"Now go! Take some time to rest! When you're feeling up to it, come talk to me "
"again and we'll discuss your future!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaICRaiment2_0003b1de_Oblivion_RESP3"
msgid ""
"Now go! Take some time to rest! When you're feeling up to it, come talk to me "
"again and we'll discuss your future!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark10SancChoice1A_00032bf0_Oblivion_RESP5"
msgid ""
"Now go, and may Sithis guide you in this new stage of your life's dark "
"journey."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark10SancChoice1B_00032bf1_Oblivion_RESP5"
msgid ""
"Now go, and may Sithis guide you in this new stage of your life's dark "
"journey."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark10SancChoice1C_00032bf3_Oblivion_RESP5"
msgid ""
"Now go, and may Sithis guide you in this new stage of your life's dark "
"journey."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008ea21_Oblivion_RESP1"
msgid "Now go, before someone sees us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023f7c_Oblivion_RESP4"
msgid "Now go, child of Sithis. Go and rest. You'll need it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035e01_Oblivion_RESP4"
msgid "Now go. Get some rest. I'll have another contract ready for you shortly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDUmarilTopic_00002bf9_Knights_RESP4"
msgid ""
"Now he has returned to seek vengeance upon the gods who helped bring about "
"his downfall so many ages ago."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice5C_00022bab_Oblivion_RESP1"
msgid ""
"Now heed these words. The slaying of Rufio was the signing of a covenant. The "
"manner of execution, your signature. Rufio's blood, the ink."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39Trust_000781ef_Oblivion_RESP1"
msgid ""
"Now how is he supposed to trust you, if I don't trust you? If you'll excuse "
"me, I have work to do. I need to collect five pod pits."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEDerveninSpeech02_000898f2_Oblivion_RESP1"
msgid ""
"Now is a time for indulgence. Partake of the wine and the Greenmote! Cast off "
"your clothing and your inhibitions! Sing and dance until the sun rises!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003ca8e_Oblivion_RESP1"
msgid "Now is a time for sleep. How I wish I could go with you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00019acb_Oblivion_RESP1"
msgid ""
"Now is not really the time for conversation, is it? I feel like I'm "
"interrupting something."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007f450_Oblivion_RESP1"
msgid "Now is not the time for business!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009811e_Oblivion_RESP3"
msgid ""
"Now is not the time for discussion. Give me a day's time to set her affairs "
"in order. Speak with Hai-Liurz tomorrow."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000977de_Oblivion_RESP1"
msgid "Now is not the time for talk. I have work to attend to."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000907a6_Oblivion_RESP1"
msgid ""
"Now is not the time for us to speak! We must hear the words of the Night "
"Mother! She will guide us in this hour of despair!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002f08c_Oblivion_RESP1"
msgid "Now is not the time!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEArctusSpeech04_0008988c_Oblivion_RESP1"
msgid ""
"Now is the time when we must band together and vanquish those who would "
"pervert our forefather's tenets!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06KanehFinalB_000400df_Oblivion_RESP3"
msgid "Now it is my even greater honor to die in my Lord's service. Farewell!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00041098_Oblivion_RESP2"
msgid ""
"Now it's all... ruined... I have to start everything over from the beginning!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48StartCombatShouts_00082c93_Oblivion_RESP1"
msgid "Now it's my turn, you bastards!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003b359_Oblivion_RESP5"
msgid ""
"Now let me see what this Journal says! Hmm... Interesting... But... I... I... "
"Wait... Can this be? But... By Shinji, I'm the son of a vampire!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003b1d8_Oblivion_RESP2"
msgid ""
"Now listen, I bet you're wondering what's next huh? Where does a Grand "
"Champion go from here? Well I've been thinking..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebc4_Oblivion_RESP1"
msgid ""
"Now my poor husband is the slave, and the ogres are his masters. They haven't "
"harmed us, but he's never worked so hard in his life."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS51AccuseOrgnolf1_0003150f_Oblivion_RESP2"
msgid "Now off with you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark11Choice1A_00002db8_Oblivion_RESP5"
msgid ""
"Now please go. Those children are so dear to me, and I'd really like you to "
"get them something special. Thanks again!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002dad_Oblivion_RESP2"
msgid "Now please, make sure my gifts get to the children. I'm counting on you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00061567_Oblivion_RESP1"
msgid ""
"Now that Bjalfi's gone, looks like I'm available again. Back to the old "
"dating game."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e95_Oblivion_RESP1"
msgid ""
"Now that Duke Thadon's happy again, I'm sure he'll invite me to the palace to "
"perform! Oh, who am I kidding...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003cca0_Oblivion_RESP1"
msgid "Now that Henantier has returned, things are as they should be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0018a961_Oblivion_RESP1"
msgid "Now that I have my notes back, my research continues."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AyleidReference_0005401d_Oblivion_RESP1"
msgid ""
"Now that I have the book, I can try and translate what's on the walls here. "
"You just read the inscriptions, and let me know what they say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0002d411_Oblivion_RESP3"
msgid ""
"Now that I think about it, I do have a small problem concerning Erthor. He's "
"one of the guild mages here. Think you can do something about it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035676_Oblivion_RESP3"
msgid "Now that I've seen you myself, I can't say that I blame him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00015717_Oblivion_RESP1"
msgid ""
"Now that Selene is locked up safely below, I think we can all breathe a "
"little easier. I can't thank you enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000441f9_Oblivion_RESP1"
msgid "Now that Syl is gone, perhaps Skooma will once again be legal!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed53_Oblivion_RESP1"
msgid "Now that Syl is gone, perhaps Skooma will once again be legal!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed6e_Oblivion_RESP1"
msgid ""
"Now that Thadon is dead, I should see if he had my things in his quarters."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03FinXedilian_0006a7f2_Oblivion_RESP1"
msgid ""
"Now that Xedilian is up and running, I'll endevour to keep it as clean and "
"tidy as the day it was created."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThadonWaitingForever_000131d8_Oblivion_RESP4"
msgid ""
"Now that forever is over and you're here, you need to go away. Yes, away. "
"There are places you should be, far away from here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDUmarilTopic_00002bfe_Knights_RESP1"
msgid ""
"Now that he has attacked Leyawiin, it is clear that no Chapel is safe from "
"his wrath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeleneTopic_0000c1df_Oblivion_RESP1"
msgid ""
"Now that she's surrendered, please escort her to the last room on the inn "
"deck. We'll lock her in there until we arrive at port."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_000286e4_Oblivion_RESP1"
msgid ""
"Now that someone's been killed, Matilde may be a little frightened for her "
"own safety, but she's still more concerned with finding the hidden gold."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0002d272_Oblivion_RESP1"
msgid ""
"Now that sounds like an odd way to prove your worth. I just don't understand "
"Falcar sometimes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f22c_Oblivion_RESP1"
msgid ""
"Now that the Gatekeeper lives again, I have to ask... is he there to keep "
"others out, or to keep us in? Think about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LifttheCurse_00003a61_Oblivion_RESP1"
msgid ""
"Now that the secret door is open, the manor is quiet; perhaps the curse has "
"been lifted. You should check."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607ce_Oblivion_RESP1"
msgid ""
"Now that things are returning to normal, it's high time I prepare my chamber "
"for some new visitors."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002e71e_Oblivion_RESP4"
msgid ""
"Now that this battle between good and evil has been won, and the day is ours, "
"you should go speak with my father."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00031eba_Oblivion_RESP4"
msgid ""
"Now that this battle between good and evil has been won, and the day is ours, "
"you should go speak with my father."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607b3_Oblivion_RESP1"
msgid ""
"Now that this is all over, I feel like celebrating. Care to take a number?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00073927_Oblivion_RESP2"
msgid ""
"Now that we have a free moment, I thought you might be able to use some "
"tricks I've picked up fighting with the Blades over the years."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034513_Oblivion_RESP1"
msgid ""
"Now that you have all four books, you should be able to handle things from "
"here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11Eye_00016ef6_Oblivion_RESP4"
msgid "Now that you have both components, I can remake the shell of the staff."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11Tree_0007eb5d_Oblivion_RESP3"
msgid ""
"Now that you have faced the truth, the Tree has given its branches to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11Tree_0008f12a_Oblivion_RESP3"
msgid ""
"Now that you have faced the truth, the Tree has given its branches to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11Eye_00016ec7_Oblivion_RESP4"
msgid ""
"Now that you have her eye, you must seek out a branch of the Tree of Shades."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThoronirTopic_0001d040_Oblivion_RESP1"
msgid ""
"Now that you have the manifest, you'll need one more piece of evidence that "
"proves the theory that links Agarmir directly to the crime."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesStaff_000355aa_Oblivion_RESP1"
msgid "Now that you have the wood, speak with Delmar at the Chironasium."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Topic_00028d6f_Oblivion_RESP1"
msgid ""
"Now that you mention it, yes.  You look up and find him across the street "
"staring at you.  Creepy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS39Seen_0004ed74_Oblivion_RESP7"
msgid "Now that you're here, that changes things."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Nirnroot_0004e977_Oblivion_RESP7"
msgid "Now that you're here, that changes things."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009187b_Oblivion_RESP1"
msgid ""
"Now that you've found Syl's escape route I'd tread very carefully. She is the "
"Mistress of Deception after all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08FinChoice1A_00035df3_Oblivion_RESP4"
msgid ""
"Now the Legion pig's years of service have come to an end. He has retired. "
"Phillida must not be allowed such a victory! His destiny is... darker."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607f5_Oblivion_RESP1"
msgid ""
"Now the day has ended, the battle has been won. A new day dawns on the Isles, "
"the past has been undone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002b09a_Oblivion_RESP1"
msgid "Now then, I propose a toast. To Umbacano, may his purse never run dry!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f560_Oblivion_RESP1"
msgid ""
"Now there's an army to protect us? Ugh, and I almost had begun to paint \"The "
"Gatekeeper in Repose.\" Oh well, time to start again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028cd2_Oblivion_RESP1"
msgid ""
"Now this is interesting. Two people turn up dead, and you're more concerned "
"with my feelings toward the Nord. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0000bcb2_Oblivion_RESP1"
msgid ""
"Now this is what I'm talking about! You kill him up close, face-to-face, and "
"you still get the bonus! I wish all the contracts were like that!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00012cc0_Oblivion_RESP2"
msgid ""
"Now to the meat of your endeavor. The crux of the situation. The reason for "
"your being here, and the likely cause of your death."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG00JoinA_0002d287_Oblivion_RESP5"
msgid ""
"Now unless you wish to attempt to impress me with your no doubt staggering "
"intellect, I have actual work to attend to."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004e94d_Oblivion_RESP1"
msgid ""
"Now was it Mandrake Root first, then the Void Salts, or the other way around. "
"Hmmm...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46GoblinWar_0002f810_Oblivion_RESP2"
msgid ""
"Now we can get back to building our new lives at Cropsford! Please, be sure "
"to come visit us in a month or so. You have earned a hero's welcome!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d489_Oblivion_RESP2"
msgid ""
"Now we can't have you standing there all uncomfortable in all those clothes. "
"Why don't you take everything off and place it there on the table."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD05Choice4_0002c5be_Oblivion_RESP1"
msgid ""
"Now we find out what really happened. And we let it be known. I want to show "
"the people who the Blackwood Company really are."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ12MartinB_000270ff_Oblivion_RESP5"
msgid ""
"Now we need only one more item, and we'll be ready to open a portal to Mankar "
"Camoran's realm..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09accept_00014826_Oblivion_RESP3"
msgid "Now we should get out of Malintus' house before we wear out our welcome."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00062bed_Oblivion_RESP2"
msgid ""
"Now we're counting on you to help Martin claim the throne and put an end to "
"this terrible war. I know you won't fail us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004e94f_Oblivion_RESP1"
msgid "Now where did I put that pestle?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5cc_Oblivion_RESP1"
msgid "Now where did I put that?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434e8_Oblivion_RESP1"
msgid ""
"Now with the Resonator of Judgment working, there won't be any adventurers "
"running around. Who am I going to find to kill me now?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice5B_00022baa_Oblivion_RESP1"
msgid ""
"Now you embrace your fate. For the slaying of Rufio was the signing of a "
"covenant. The manner of execution, your signature. Rufio's blood, the ink.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMalacathSpeech_000579d6_Oblivion_RESP1"
msgid ""
"Now you get a present. Keep up the good work. And be nice to my little "
"brothers!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034ea8_Oblivion_RESP4"
msgid ""
"Now you have an opportunity to engage in more meaningful tasks, and continue "
"with your advancement through the guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00027980_Oblivion_RESP1"
msgid ""
"Now you listen to me. I don't like you. Understand? So why don't we both just "
"stay out of each other's way, and be done with it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09SlainUmm_00013568_Oblivion_RESP1"
msgid ""
"Now you make excuses? Pathetic. On what authority have you weaseled into my "
"sanctum and disturbed my work, hmm?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01ThievesTest_0001c14f_Oblivion_RESP3"
msgid ""
"Now you must pay her blood price to enter the guild. However, because you are "
"not yet a member, it is only half of what it would normally be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01ThievesTest_000153ad_Oblivion_RESP3"
msgid ""
"Now you must pay his blood price to enter the guild. However, because you are "
"not yet a member, it is only half of what it would normally be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_000242e7_Oblivion_RESP1"
msgid "Now you will know pain!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate3_00015636_Oblivion_RESP1"
msgid "Now you will release me at once!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000c47d0_Oblivion_RESP1"
msgid "Now's not the time for talking."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009811a_Oblivion_RESP2"
msgid "Now's not the time, little one. The Count has been waiting for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice4A_00022ba5_Oblivion_RESP2"
msgid "Now, I bid you farewell. I do hope we'll meet again soon.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice4B_00022ba6_Oblivion_RESP2"
msgid "Now, I bid you farewell. I do hope we'll meet again soon.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice4C_00022ba7_Oblivion_RESP2"
msgid "Now, I bid you farewell. I do hope we'll meet again soon.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12RootDungeon_00016d04_Oblivion_RESP2"
msgid ""
"Now, I fear that the Gnarls themselves may be accelerating the spread of "
"Order throughout the Tree's roots. Be careful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAClavicusSpeech_000243b7_Oblivion_RESP1"
msgid ""
"Now, I have business to attend to. Run along. Perhaps I'll be looking for you "
"again...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDRodericGreetC_00002aa3_Knights_RESP2"
msgid ""
"Now, I must be on my way. The Pilgrimage of the Wayshrines is my only purpose "
"now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDRodericGreetD_00002aa1_Knights_RESP2"
msgid ""
"Now, I must be on my way. The Pilgrimage of the Wayshrines is my only purpose "
"now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG05Choice2A_00023ff2_Oblivion_RESP3"
msgid "Now, I must ensure this book is kept safe. Excuse me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS31Lynch01aPositive_000151e7_Oblivion_RESP2"
msgid "Now, I'll ask again. Who are you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThoronirTopic_0001d03d_Oblivion_RESP6"
msgid ""
"Now, I'm sure you are waiting to hear about your reward. The Society thanks "
"you for everything you have done. Please, take this gold."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000224f5_Oblivion_RESP5"
msgid ""
"Now, I've kept you long enough. Vicente is waiting. You'll find him in his "
"quarters. Go now, my child, and may Sithis go with you. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RulesOfCompetition_00038b37_Oblivion_RESP5"
msgid ""
"Now, as you know, in any standard Arena match you're forbidden from looting "
"the corpse of a fallen opponent. Well this ain't any standard match.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00026ea5_Oblivion_RESP2"
msgid ""
"Now, daedra are pouring out of an Oblivion Gate on our very doorstep! No, I "
"don't have any men to spare. Bruma will have to look to its own defense."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29InvStolen_0001d045_Oblivion_RESP2"
msgid "Now, either buy something or get out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEServeSentence_000459c5_Oblivion_RESP2"
msgid ""
"Now, follow me, and we'll find a quiet place away from all this trouble. I "
"trust you will clear up this matter in your own time, in your own way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03Xedilian_0006770c_Oblivion_RESP5"
msgid "Now, get going. Before I change my mind. Or my mind changes me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackheartsRing_0002c5b5_Oblivion_RESP2"
msgid ""
"Now, get out of here. I'm going to head back to Chorrol. When there's more to "
"do, I'll let you know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AjumKajinTopic_000356c7_Oblivion_RESP4"
msgid ""
"Now, go tell him to sit down. If he tries to get up, I'll kill him myself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ06Bears_0018afd5_Oblivion_RESP4"
msgid "Now, how about that reward I promised?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000432b2_Oblivion_RESP2"
msgid "Now, how may I continue to assist you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS11NoneYet_00038586_Oblivion_RESP2"
msgid "Now, if you believe what you're saying is true, go get me the proof!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS02ManorBuyChoice1_00003a6e_Oblivion_RESP2"
msgid ""
"Now, if you'll excuse me, I must attend to those pressing matters I spoke of "
"earlier. Good day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE35TrustMe_00078676_Oblivion_RESP2"
msgid "Now, if you'll excuse me, I must get back to things. Shoo! Scoot!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UlrichLelandTopic_0003c350_Oblivion_RESP4"
msgid ""
"Now, if you'll excuse me, I must speak to the Count. Please, meet me at the "
"Cheydinhal Bridge Inn in two hours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07BeggarPay_00020093_Oblivion_RESP3"
msgid ""
"Now, if you'll excuse me, all this talk has given me a powerful thirst. "
"Thankee kindly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00019858_Oblivion_RESP2"
msgid ""
"Now, if you'll step on the last teleporter pad, I will meet you in the "
"reception chamber so we can recover your earnings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022500_Oblivion_RESP3"
msgid ""
"Now, if you're ready to get to work, I can provide you with your first "
"contract.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13GetOut_00031c87_Oblivion_RESP2"
msgid ""
"Now, in my father's name as Count Indarys of Cheydinhal, I order you to lead "
"me to that sigil stone!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002dac_Oblivion_RESP2"
msgid "Now, is there something I can help you with?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02JauffreD3_0001e74c_Oblivion_RESP4"
msgid ""
"Now, it seems that this illegitimate son is the heir to the Septim Throne. If "
"he yet lives."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39MissionChoice2_00078204_Oblivion_RESP4"
msgid "Now, leave before someone sees us talking. Go! Go go go!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaChoice1A_00029ca6_Oblivion_RESP4"
msgid ""
"Now, let me give you your Battle Raiment. It's the uniform of all Arena "
"combatants. Do you want a Light Raiment or a Heavy Raiment?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06PriestGreetA_00040149_Oblivion_RESP2"
msgid ""
"Now, light the Great Torch as a beacon for those who fear and those who "
"inspire fear."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004dcba_Oblivion_RESP2"
msgid ""
"Now, of course, there is business to attend to. As you have assumed the "
"mantle of Sheogorath, there are matters that deserve your attention."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG09Choice3A_00022b6c_Oblivion_RESP3"
msgid ""
"Now, our business here is concluded. I suggest you return to your Council."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG00JoinA_0002d286_Oblivion_RESP2"
msgid ""
"Now, please keep in mind that you'll need recommendations from every local "
"guild hall in Cyrodiil before you may enter the Arcane University."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingBlockYes_0006233b_Oblivion_RESP3"
msgid "Now, put up your guard, and let's begin. I'm losing interest in this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LorgrenSpeech_0006e7f3_Oblivion_RESP1"
msgid ""
"Now, so I may make my final peace with the Nine, please rejoin my hand to my "
"body. Only then, when I am complete, will this eternal nightmare end."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark09RetFinChoice1A_00032bec_Oblivion_RESP6"
msgid ""
"Now, take these special gifts. They will help you greatly. One is a poisoned "
"apple. The other, a unique scroll of summoning. Good luck... Silencer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark09RetFinChoice1B_00032bed_Oblivion_RESP6"
msgid ""
"Now, take these special gifts. They will help you greatly. One is a poisoned "
"apple. The other, a unique scroll of summoning. Good luck... Silencer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark09RetFinChoice1C_00032bee_Oblivion_RESP6"
msgid ""
"Now, take these special gifts. They will help you greatly. One is a poisoned "
"apple. The other, a unique scroll of summoning. Good luck... Silencer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12TraitorTaunts_00081ae3_Oblivion_RESP1"
msgid "Now, taste the power of the true Lord of this realm!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12TraitorTaunts_0008f7d0_Oblivion_RESP1"
msgid "Now, taste the power of the true Lord of this realm!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiriliUlvenGreetA_000410a2_Oblivion_RESP2"
msgid ""
"Now, thanks to your rude interruption, I have to start my day's work all over "
"again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32OfferHelp_00012d04_Oblivion_RESP3"
msgid ""
"Now, the shades of my people are cursed by Sheogorath to repeat the final "
"moments of their failures, over and over again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13JyggalagSpeech_00063575_Oblivion_RESP1"
msgid ""
"Now, though, you have ended the cycle. You now hold the mantle of madness, "
"and Jyggalag is free to roam the voids of Oblivion once more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000914d9_Oblivion_RESP1"
msgid "Now, to find another drink..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40MelisandeIhavethem_0005373b_Oblivion_RESP2"
msgid ""
"Now, to the matter at hand. You need a cure for vampirism, yes? I believe I "
"can create a potion that will do the trick. But it requires a few things."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG13EridorWho_00034467_Oblivion_RESP3"
msgid "Now, we just need to find them..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD09Choice2_00035710_Oblivion_RESP4"
msgid ""
"Now, we must speak about what you've done, and how it will affect any further "
"advancement in the Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05HerdirGreetChoice2_000805eb_Oblivion_RESP2"
msgid ""
"Now, we've much to do. Lady Syl is not a patient woman, as I'm sure you've "
"seen. Shall we begin?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06DerveninGreetA_000400e4_Oblivion_RESP3"
msgid "Now, what do you say?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000336f4_Oblivion_RESP1"
msgid ""
"Now, while the Shade of the Revenant blankets this world, I give these gems "
"as an offering. May the power of the true god fill and change them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000275cc_Oblivion_RESP5"
msgid "Now, who might you be? Please, tell us a little bit about yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e8b1_Oblivion_RESP5"
msgid ""
"Now, worship a Daedra Lord, and you get effects... bad ones, of course, but "
"clear and measurable effects."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000175b2_Oblivion_RESP4"
msgid ""
"Now, you didn't find any sort of recommendation? Very well. I shall write one "
"myself, and include it in my report to the Council."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGExpelYes_0002502d_Oblivion_RESP3"
msgid "Now, you may continue about your business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGExpelYes_0002502e_Oblivion_RESP3"
msgid "Now, you may continue about your business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d2aa_Oblivion_RESP3"
msgid "Now, you were after some training? I think I can accommodate you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38DionneWarnChoice1_0001dcc2_Oblivion_RESP2"
msgid "Now, you were telling me why you're interested in Glarthir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesStaff_000355a1_Oblivion_RESP2"
msgid ""
"Now, you'll need to decide what sort of staff you're looking for. Something "
"that fits you, and your abilities. Shall we begin?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11StaffOfSheogorath_0007eb5e_Oblivion_RESP5"
msgid "Now... take your treasure and leave me. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ03MartinD1_0009226a_Oblivion_RESP3"
msgid ""
"Now... with the daedra invading our world, Kvatch in ruins, the Emperor and "
"his sons assassinated... anything seems possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06SheoIntro5_00082461_Oblivion_RESP1"
msgid ""
"Now... you've seen the Great Torch that burns brightly over New Sheoth? No? "
"Because it doesn't. It should. But it doesn't. You'll fix that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10SheoJyggalag4_0009145c_Oblivion_RESP1"
msgid ""
"Now? Nothing has changed! You deal with this messenger. Make sure my army is "
"secure. You'll need them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SheoIntroSpeech5_00056095_Oblivion_RESP1"
msgid ""
"Now? You run an errand for me. An important one. Of course, anything I tell "
"you to do is important. My Realm, my rules."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07SheoIntro3_00082466_Oblivion_RESP1"
msgid ""
"Now? You'll need the respect of My citizens. They'll need a leader, someone "
"to look up to when I'm gone. They're the backbone of any great land."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ04KeepMartinSafe_0001ee2e_Oblivion_RESP2"
msgid ""
"Nowhere is truly safe against the power arrayed against us. But we must play "
"for time, at least..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03LewinCrazyChatter_0008efab_Oblivion_RESP1"
msgid "Nowhere to run.... mad t-tree... must escape..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TestTodd_000281a8_Oblivion_RESP1"
msgid "OK, let's test the random text. You should get this about half the time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TestEmil_000281ad_Oblivion_RESP1"
msgid ""
"OK. Pick one of the choices. The topics should've disappeared and you should "
"only have two choices to pick from."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0004ea48_Oblivion_RESP1"
msgid "Oblivion take you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0006b833_Oblivion_RESP1"
msgid "Oblivion take you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00030030_Oblivion_RESP1"
msgid "Oblivion take you! What is it you want from me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Ritual_0007893f_Oblivion_RESP1"
msgid ""
"Obviously, no matter which path you take, it ends in the death of either Syl "
"or Thadon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LucienLachanceTopic_000253dc_Oblivion_RESP1"
msgid ""
"Ocheeva and I have known Lucien since we were hatchlings. He is the one who "
"trained us in the way of the Shadowscale, and is like a father to us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark09RetFinChoice1A_00032bec_Oblivion_RESP3"
msgid ""
"Ocheeva, Vicente Valtieri, Antoinetta Marie, Gogron gro-Bolmog, Telaendril, "
"M'raaj-Dar and Teinaava. All of these family members must die!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark09RetFinChoice1B_00032bed_Oblivion_RESP3"
msgid ""
"Ocheeva, Vicente Valtieri, Antoinetta Marie, Gogron gro-Bolmog, Telaendril, "
"M'raaj-Dar and Teinaava. All of these family members must die!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark09RetFinChoice1C_00032bee_Oblivion_RESP3"
msgid ""
"Ocheeva, Vicente Valtieri, Antoinetta Marie, Gogron gro-Bolmog, Telaendril, "
"M'raaj-Dar and Teinaava. All of these family members must die!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ChorrolNQDQuestionResponses_000238af_Oblivion_RESP1"
msgid ""
"Odd folks, the way they dote on those dogs. They're not hurting anyone, "
"though, so it's no concern of mine."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ChorrolNQDQuestionResponses_000238ad_Oblivion_RESP1"
msgid "Odd noises? No, I haven't. That sounds a bit troublesome."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03SyndelC2Idle01_0008eab4_Oblivion_RESP1"
msgid "Odd statues."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RolandJensericTopic_0001d4b3_Oblivion_RESP1"
msgid ""
"Odd. A cabin is an unusual hideout for a vampire. They prefer dank caves and "
"the like. Much darker and no need to block out windows."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_00024d71_Oblivion_RESP2"
msgid ""
"Odiil boys say creatures of some sort are attacking their farm. Went off on "
"their own to stop them. Poor father's worried sick. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008dc0e_Oblivion_RESP1"
msgid ""
"Of Fellmoor I can say only this; you should keep far away. Any other place "
"but that dismal town I'd recommend you stay."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008e10c_Oblivion_RESP1"
msgid ""
"Of Hirrus I can only say this, he wouldn't feel that way if he lived in Bliss."
msgstr ""

