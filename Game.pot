msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0018d7df_Oblivion_RESP1"
msgid "May Talos guide you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0018d7e1_Oblivion_RESP1"
msgid "May Uriel's spirit guide us in these troubled times."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008d31a_Oblivion_RESP1"
msgid "May all my children serve you well, Lord Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0006a8a5_Oblivion_RESP1"
msgid "May all your days be filled with enlightenment and mirth!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0006a8b6_Oblivion_RESP1"
