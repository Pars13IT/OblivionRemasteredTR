msgid ""
"Have you heard? There's been activity at that abandoned priory in the West "
"Weald. What could be going on up there?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00038fc7_Oblivion_RESP1"
msgid "Have you helped Captain Burd and his men close the Oblivion Gate yet?"
msgstr ""

