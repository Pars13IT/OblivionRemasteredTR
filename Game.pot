msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001822c_Oblivion_RESP1"
msgid "Have you recovered the Madstone?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00014677_Oblivion_RESP1"
msgid "Have you recovered the Necromancer's Amulet?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FingersoftheMountain_0001e850_Oblivion_RESP1"
msgid "Have you recovered the book yet?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003fd44_Oblivion_RESP1"
msgid "Have you recovered those taxes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bc5b_Oblivion_RESP1"
msgid "Have you returned with a message from S'Krivva?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026d8f_Oblivion_RESP1"
msgid "Have you returned with the ingredients you were sent to find?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00024fc8_Oblivion_RESP1"
msgid "Have you returned with the materials you were sent to collect?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0003e2aa_Oblivion_RESP1"
msgid "Have you seen Ahdarji trying to start trouble?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036649_Oblivion_RESP1"
msgid ""
"Have you seen Alain or Valdemar? Rielus fell in the lower chamber. We were "
"separated ... the fog blinded us ..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00017c49_Oblivion_RESP1"
msgid "Have you seen Armand Christophe?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0003e257_Oblivion_RESP1"
msgid ""
"Have you seen Eitar making trouble again with the Khajiits and Argonians?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0002d920_Oblivion_RESP1"
msgid "Have you seen Erthor around town lately?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00029682_Oblivion_RESP1"
msgid "Have you seen Glistel and Malintus Ancrus together? Isn't it awful?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0003e98a_Oblivion_RESP1"
msgid "Have you seen Orintur and Eilonwy recently? They're always together."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_000498c8_Oblivion_RESP1"
msgid ""
"Have you seen Othrelos moving around? It's like he sometimes just disappears."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c1c0_Oblivion_RESP1"
msgid ""
"Have you seen Rhano at the Fighters Guild use his sword? Impressive. He could "
"teach us all a thing or two."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_000465da_Oblivion_RESP1"
msgid "Have you seen Right-Wind practicing with his sword? Very impressive."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000241c5_Oblivion_RESP1"
msgid ""
"Have you seen Valus Odiil recently? Spends all day in the tavern since his "
"boys left."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00046623_Oblivion_RESP1"
msgid "Have you seen Varon Vamori recently?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bcc1_Oblivion_RESP1"
msgid ""
"Have you seen a land dreugh? We call them \"Billies.\" Don't know why. Steer "
"clear of them, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d61_Oblivion_RESP1"
msgid "Have you seen anything cuter than that?!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0003dfa3_Oblivion_RESP1"
msgid "Have you seen how upset Tsrava gets by all the dogs near her house?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026aaf_Oblivion_RESP1"
msgid ""
"Have you seen it? Have you seen the light? The bright, shining light? I know "
"it. It waits for you. Speak with Ravel. He knows the way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008faa1_Oblivion_RESP1"
msgid "Have you seen my double, you cute little monkey? Have you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000363c1_Oblivion_RESP1"
msgid "Have you seen my friend Luronk? I'm worried about him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45Convo_000a2e58_Oblivion_RESP1"
msgid "Have you seen my horse? I can't leave her here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008152e_Oblivion_RESP1"
msgid "Have you seen my sanity? It went by here just a moment ago."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0003403c_Oblivion_RESP1"
msgid "Have you seen that new galleon down at the docks? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00002a03_Knights_RESP1"
msgid ""
"Have you seen that poor man staying in the Chapel Hall? I heard he's under "
"some sort of curse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00029686_Oblivion_RESP1"
msgid "Have you seen the Bruiants and their dogs?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0003dfc1_Oblivion_RESP1"
msgid ""
"Have you seen the Derics recently? They're always bickering with one another."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_0018d304_Oblivion_RESP1"
msgid ""
"Have you seen the Oblivion Gate? I haven't dared leave the city since I heard "
"about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00049965_Oblivion_RESP1"
msgid ""
"Have you seen the latest Black Horse Courier? Quite a story, don't you think?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f219_Oblivion_RESP1"
msgid ""
"Have you seen the new Gatekeeper? I hear they built him with four arms and no "
"head! Or was it four heads and no arms?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_0004f773_Oblivion_RESP1"
msgid "Have you seen the prisoner?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00049925_Oblivion_RESP1"
msgid "Have you seen the selection at Stonewall Shields?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_LeyawiinTopicDecentius03_000479f3_Oblivion_RESP1"
msgid ""
"Have you seen the statue? It's in the southwest corner of the town. That's "
"the High Elf explorer, Torval the Pilot."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0003e990_Oblivion_RESP1"
msgid "Have you seen the way that Voranil treats his servants? What a lout."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36Choice5KillSelf_00061c4d_Oblivion_RESP1"
msgid ""
"Have you seen those miserable souls on the Hill of Suicides? Do you think "
"that kind of existence is any better than this?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00049955_Oblivion_RESP1"
msgid "Have you shopped at the Guilded Carafe?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00049920_Oblivion_RESP1"
msgid "Have you shopped for a shield at Stonewall?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001d4ae_Oblivion_RESP1"
msgid "Have you slain Roland?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00038bba_Oblivion_RESP1"
msgid ""
"Have you spoken to Martin yet? The plans you found make it clear that time is "
"short."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026baf_Oblivion_RESP1"
msgid "Have you spoken to S'drassa yet? I hear she eagerly awaits your return."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EronorDEMO1_0002ae26_Oblivion_RESP1"
msgid "Have you spoken to Valus Odiil recently?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c1b2_Oblivion_RESP1"
msgid ""
"Have you spoken to Wilbur at the Count's Arms? He knows a lot about fine "
"wines."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002797f_Oblivion_RESP1"
msgid ""
"Have you spoken to the other guests yet? I suggest you get to know everyone. "
"Who knows how long we'll be stuck in this house together?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00047463_Oblivion_RESP1"
msgid "Have you spoken with Adrienne today?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029df_Knights_RESP1"
msgid "Have you spoken with Kellen?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00072c92_Oblivion_RESP1"
msgid ""
"Have you spoken with Kishashi? Until she sends word you are a friend, I will "
"not speak to you. Not another word."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_EmfridDEMOBittneldTOPIC_00028a32_Oblivion_RESP1"
msgid "Have you spoken with him already? Please, say you have."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008fa7b_Oblivion_RESP1"
msgid ""
"Have you taken care of business yet? It's exhausing just waiting for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Accuse_0003565b_Oblivion_RESP1"
msgid ""
"Have you taken leave of your senses? We already covered this! Now go away!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Nirnroot_0004e931_Oblivion_RESP1"
msgid ""
"Have you taken this to Sinderion in Skingrad yet? As far as alchemists go, "
"you couldn't ask for a more knowledgeable source."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003013b_Oblivion_RESP1"
msgid "Have you talked to Ancotar yet? Can he make us visible again?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002998_Knights_RESP1"
msgid "Have you talked to Areldur? What news is there of lifting this curse?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022497_Oblivion_RESP1"
msgid "Have you talked to my sons yet? I don't want them leaving on their own."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesGuildTopic_00062bb4_Oblivion_RESP1"
msgid ""
"Have you thought of joining? There's a free place to rest in every town for "
"you. That's got to be worth something."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023675_Oblivion_RESP1"
msgid "Have you... done... what I asked?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008e4ae_Oblivion_RESP1"
msgid "Have zickle to it. Nobody does rebby zickles any more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThadonWaitingShort_000131db_Oblivion_RESP1"
msgid ""
"Haven't I? Hmm, perhaps not. It felt like rather a long time, but then long "
"times get longer when you're standing around thinking about them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG04Choice2A_000300a1_Oblivion_RESP2"
msgid ""
"Haven't seen as many lately, what with the... well, you know. The murders."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13GateHeardNot_00031c7c_Oblivion_RESP3"
msgid ""
"Haven't seen it myself, and don't intend to. Being this close to one makes me "
"nervous. The good news is nothing's come out since Farwil entered."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000356e9_Oblivion_RESP1"
msgid ""
"Haven't written me off yet, huh? Good. If you're willing, there's more work "
"to be done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_00089531_Oblivion_RESP1"
msgid ""
"Haven't you got what you need? Shouldn't you be running off to tattle like a "
"good little servant?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13Gate_00031c75_Oblivion_RESP1"
msgid ""
"Haven't you heard about these gates to Oblivion opening up all over Tamriel?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackwoodCompany_0002c7c8_Oblivion_RESP1"
msgid ""
"Haven't you heard of 'em? Former soldiers, sent down into the swamps to take "
"some territory back from the lizards. Talk to Vantus."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0007c0a8_Oblivion_RESP1"
msgid ""
"Haven't you heard? Baenlin's been killed! The Black Horse Courier has a "
"special edition with the story. Here, take my copy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EaranaTopic_000253d2_Oblivion_RESP1"
msgid ""
"Haven't you seen her around town? She's either at the Grey Mare, or she's "
"skulking around the Mages Guild, it seems."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002886b_Oblivion_RESP1"
msgid ""
"Haven't you taken care of that weapons shipment yet? Those weapons won't "
"deliver themselves!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03BribeBeggar_000092b0_Oblivion_RESP2"
msgid ""
"He also posted a guard so that her tomb wouldn't be disturbed. Used to be "
"anyone could visit her, but now it's off limits to the public."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03ElvenBust_00048979_Oblivion_RESP2"
msgid ""
"He also posted a guard so that her tomb wouldn't be disturbed. Used to be "
"anyone could visit her, but now it's off limits to the public."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_0002b1e3_Oblivion_RESP2"
msgid ""
"He also uses an enchanted shield called the Gray Aegis, which gives him some "
"serious magic resistances. Your best bet is to just charge straight in!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OcatoTopic_000add3f_Oblivion_RESP1"
msgid ""
"He and the rest of the Elder Council care nothing for Cyrodiil. They focus "
"obsessively on the provinces, leaving us to fend for ourselves."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27LastAyleidKing_000a6576_Oblivion_RESP5"
msgid ""
"He appears to have ruled for centuries past the fall of all the other Ayleid "
"kingdoms, if the ancient chronicles are to be believed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ab50_Oblivion_RESP2"
msgid ""
"He asked me to deliver this note. I believe it is an invitation to visit him "
"at his manor in the Imperial City."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LorgrenBenirus_00003a71_Oblivion_RESP3"
msgid ""
"He became obsessed and decided that by using necromancy, he could prolong his "
"own life."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23RolandSad_0001d4c6_Oblivion_RESP4"
msgid ""
"He became startled for a moment and tossed Relfina aside. She fell to the "
"ground and I heard a sickening crack as her head struck a stone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07GreymarchTopic_00091015_Oblivion_RESP2"
msgid ""
"He believes that by you ruling either Mania or Dementia, you'll be able to "
"effectively inspire his people and lead His forces. I hope He's right."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07GreymarchTopic_0009127f_Oblivion_RESP2"
msgid ""
"He believes that by you ruling either Mania or Dementia, you'll be able to "
"effectively inspire his people and lead His forces. I hope He's right."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06KellenRumors_00002bd0_Knights_RESP1"
msgid ""
"He came here all the way from Hammerfell, didn't he? He must be very ill."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06KellenQuestion_00002b09_Knights_RESP2"
msgid ""
"He came here from Hammerfell seeking a cure, but, ahh... well, there's really "
"nothing that can be done for him, I think."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025033_Oblivion_RESP3"
msgid ""
"He can be found at the Arcane University in the Imperial City. I'm very "
"disappointed in you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_0005319a_Oblivion_RESP1"
msgid "He can help us. He must help us."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_000498ab_Oblivion_RESP1"
msgid "He can teach you a lot about using light armor."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_000498eb_Oblivion_RESP1"
msgid "He can teach you how to steal the boot right off a lich."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG10Choice2A_00035f50_Oblivion_RESP2"
msgid ""
"He can't be bothered to come check on his own project, so he sends someone "
"who knows nothing about it. And this is supposed to help?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028254_Oblivion_RESP1"
msgid "He can't be the killer! He can't! I won't believe it! Get away from me! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_00061c6d_Oblivion_RESP1"
msgid "He can't leave! Bliss must be protected!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_00061c6f_Oblivion_RESP1"
msgid "He can't leave. He still has work to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FaelianTopic_0002ff10_Oblivion_RESP5"
msgid ""
"He comes back every night to be with Atraena, but only for a few hours. I "
"swear, that High Elf is going to wind up dead if he keeps living like this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEDyusTormentTopic_000807af_Oblivion_RESP3"
msgid ""
"He could not bring himself to destroy the knowledge that I represent, which "
"is to say, precise predictions of all that is, has been, and will be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MythicDawnAlarm_0001fb3a_Oblivion_RESP1"
msgid "He dares to touch the sacred Xarxes! Kill him!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46Choice1_0008fabc_Oblivion_RESP2"
msgid ""
"He decided to test the theory. Cast a spell. Split us all in two. Do we get "
"twice the work done? No! Ridiculous."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008dc9c_Oblivion_RESP1"
msgid "He definitely doesn't live with Zoe Malene."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetB2_00002b84_Knights_RESP1"
msgid ""
"He did. I owe him my life. He faced the evil wraith of Lord Vlindrel, and "
"told me to run."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ChorrolNQDQuestionResponses_000238c1_Oblivion_RESP1"
msgid ""
"He did? Excellent. I wonder if he got \"The Lusty Argonian Maid\" in. I've "
"been dying to read that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_defaulted_0002428f_Oblivion_RESP1"
msgid ""
"He didn't finish out a contract in Skingrad. Suppose I shouldn't be "
"surprised. He's raw, like you. Go and find out what's wrong with him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGDefault1_00024294_Oblivion_RESP1"
msgid ""
"He didn't? Hmph. This doesn't sit well with me. Not well at all. Still, the "
"job got done. Let's hope your friend Maglir has learned a lesson here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06WhereIsShum_0000bf93_Oblivion_RESP1"
msgid ""
"He doesn't leave Castle Skingrad often. At ten he heads over to the West "
"Weald Inn. Then at noon he goes to the Colovian Trader."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilNQDResponses_00046589_Oblivion_RESP1"
msgid ""
"He doesn't seem particularly happy. I think he'd rather spend his time "
"painting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VaronVamoriTopic_0002f177_Oblivion_RESP2"
msgid "He even stole her Mages' Staff!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035586_Oblivion_RESP4"
msgid ""
"He failed, of course. His body's around here somewhere. But he got in a "
"pretty good hit. If I don't get some rest I'm probably dead anyway."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice5A_00028ac8_Oblivion_RESP5"
msgid ""
"He fled from Chorrol with his family, and was never heard from again. Only "
"his small son Reynald was found, wandering alone in the wilderness."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_000174f3_Oblivion_RESP4"
msgid ""
"He flew into a rage! I didn't even understand some of his ranting, but he "
"said that our days are numbered, and then he stormed out!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0002e5e5_Oblivion_RESP2"
msgid ""
"He gave poor Vidkun the same task, and we never saw him again. I'm reasonably "
"sure there's a connection, but I can't prove it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalNQDResponses_0003e994_Oblivion_RESP1"
msgid ""
"He goes on and on about the guild. He's very proud of it. I understand he "
"teaches Illusion there now, as well."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_LeyawiinNQDQuestionResponses_0003e24b_Oblivion_RESP1"
msgid "He goes on and on. I'm not sure he's ever said anything useful, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGHieronymusLex_00064463_Oblivion_RESP1"
msgid ""
"He got reassigned, to Anvil I think. Without him around, all this hustle and "
"bustle about the Gray Fox will go away."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e54f_Oblivion_RESP1"
msgid ""
"He guards the Gates of Madness. Don't get too close to him. He'll kill you, "
"and it will leave a mess in my town."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e4cf_Oblivion_RESP1"
msgid ""
"He guards the Gates of Madness. See for yourself. He's about to destroy a "
"party of adventurers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetB3_00002b82_Knights_RESP2"
msgid ""
"He had learned that Sir Berich had once been a questing knight, like us. He "
"had found the Greaves and Sword of the Crusader, but then turned to evil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_00049941_Oblivion_RESP1"
msgid "He has a good selection of soul gems and other things."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG02WhoIsLex_0003fd46_Oblivion_RESP2"
msgid ""
"He has a grudge against the Thieves Guild and the Gray Fox in particular. Lex "
"has made it his personal mission to capture him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE43Ushnar_00072dbf_Oblivion_RESP1"
msgid "He has a nice dog. I like dogs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilNQDResponses_00046627_Oblivion_RESP1"
msgid ""
"He has a way with words, that's for sure. You could learn a lot from him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinNQDResponses_0003dfaf_Oblivion_RESP1"
msgid ""
"He has a wonderful collection of books. I don't know why he needs to act so "
"tough all the time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG09Choice5B_00022bd8_Oblivion_RESP2"
msgid ""
"He has disguised his nature from most, but cannot hide it from the Council of "
"Mages. So, he approached us with an accord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06HelpAttackA1_00012cca_Oblivion_RESP2"
msgid ""
"He has failed to consider the risks of his plan. If the Mazken have prepared "
"an ambush along that route, we would be slaughtered."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND04CarodusGreeting2_00002ad1_Knights_RESP3"
msgid ""
"He has found a use for me, however. The priests have asked me to stay to "
"protect the chapel. After what happened in Anvil, they are afraid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG13Choice1A_0000399e_Oblivion_RESP2"
msgid ""
"He has requested that you personally travel to Skingrad to obtain this "
"information."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMolagBalSpeech_00037844_Oblivion_RESP1"
msgid ""
"He has sworn an oath: never to raise a weapon against another man again. I "
"want him to break that oath, and damn himself forever."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GatherClues_000038c9_Oblivion_RESP3"
msgid ""
"He has taken to asking for money from others to purchase spirits. A porter's "
"wage does not befit his habit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GatherClues_00033954_Oblivion_RESP5"
msgid "He hasn't bothered me since."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_defaulted_0002ee69_Oblivion_RESP2"
msgid ""
"He hasn't reported to the client at all. Get yourself down to Bravil and find "
"Maglir. Make sure that contract of his gets done. And send him to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ErthorTopic_0001c1b2_Oblivion_RESP1"
msgid ""
"He hasn't shown up here in a while. I assumed he was still out at Bleak Flats "
"Cave, where he usually stays."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk4_00034055_Oblivion_RESP1"
msgid ""
"He he. Remember, Dear Brother, I can't always be there to get you out of "
"trouble!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk4_00034056_Oblivion_RESP1"
msgid ""
"He he. Remember, Dear Sister, I can't always be there to get you out of "
"trouble!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0004ed9e_Oblivion_RESP1"
msgid "He hired a guard! Attack!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c257_Oblivion_RESP1"
msgid "He is a bit nutty. Probably just a harmless old fool, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG02WhoIsLex_0003fd46_Oblivion_RESP1"
msgid ""
"He is a fool of a Captain in the Imperial Watch. He's a real law and order "
"type."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018bc62_Oblivion_RESP2"
msgid ""
"He is a guest of the Legion, at the Legion Headquarters in Cyrodiil. Seek him "
"there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0005d504_Oblivion_RESP1"
msgid ""
"He is a hard master, but he delivers. I gave my word, and an Orc honors his "
"word."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MartinTopic_0003406c_Oblivion_RESP1"
msgid ""
"He is a priest in the Chapel of Akatosh in Kvatch. He never knew that he was "
"Uriel Septim's son."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06Theranis_000104de_Oblivion_RESP1"
msgid ""
"He is a skillful thief. I seem to remember something about him. Something "
"recent. Something important. Something is missing in my hand..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10FindJakben_0009ded9_Oblivion_RESP2"
msgid ""
"He is a very private man and does not leave his home often. He has a rare "
"skin condition that forces him to sleep during the day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10BribeBeggar_00016254_Oblivion_RESP2"
msgid ""
"He is an odd one. Keeps to himself mostly. Only goes out after dark. A real "
"night owl."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10FindJakben_00048977_Oblivion_RESP2"
msgid ""
"He is an odd one. Keeps to himself mostly. Only goes out after dark. A real "
"night owl."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MannimarcoTopic_00009225_Oblivion_RESP1"
msgid ""
"He is an old and powerful Necromancer. Traven will recognize the name, even "
"if you do not."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThadonTopic_0004301f_Oblivion_RESP1"
msgid ""
"He is aware you are here, and should be waiting for you. See him at once."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGHieronymusLex_00007e04_Oblivion_RESP1"
msgid ""
"He is captain of the Imperial Watch. He is pursuing a personal vendetta "
"against the Thieves Guild and the Gray Fox."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MankarRant_0008c240_Oblivion_RESP10"
msgid "He is daedroth! TAMRIEL AE DAEDROTH!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThoronirTopic_0000bc97_Oblivion_RESP1"
msgid ""
"He is dirty. Plain and simple. I don't trust him at all. Won't even come to "
"merchant meetings and sets his prices so low, he undercuts everyone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00014b4e_Oblivion_RESP1"
msgid ""
"He is gone, but hope is not lost. We have a rare opportunity here, but I "
"hesitate to do what must be done. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03WhereArmand_00034e9d_Oblivion_RESP2"
msgid ""
"He is in hiding. Armand is accused of stealing the bust of Llathasa Indarys "
"from Cheyhindal. They say Count Indarys himself filed the charges."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11Dyus_00014b53_Oblivion_RESP5"
msgid ""
"He is kept locked away to prevent curious beings from using his knowledge to "
"subvert the personal choices of other creatures."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LordDradTOPIC_0001ec52_Oblivion_RESP1"
msgid ""
"He is my husband, a kind and gentle man. He has given me everything I might "
"ever desire."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ValusOdiilTopic_000224ac_Oblivion_RESP1"
msgid ""
"He is not coming with us? I think I understand, and it is better that he "
"remain safe. Though I wonder why he has asked you to take his place."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_000895e0_Oblivion_RESP2"
msgid "He is not known for his ability to remain hidden."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10FindJakben_0009ded7_Oblivion_RESP1"
msgid ""
"He is somewhere in the house. Flee thief, while you still have the chance!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_00000a1b_Oblivion_RESP2"
msgid ""
"He is the King of Thieves in Cyrodiil. You could think of him as our "
"guildmaster, although he would deny that title."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_00000a42_Oblivion_RESP1"
msgid ""
"He is the King of Thieves in Cyrodiil. You could think of him as our "
"guildmaster, although he would deny that title."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SESheogorathTopic_00091019_Oblivion_RESP1"
msgid "He is the Prince of Madness. The ruler of the Shivering Isles. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SESheogorathTopic_00078ca3_Oblivion_RESP1"
msgid ""
"He is the Prince of Madness. The ruler of the Shivering Isles. It is by His "
"will that we exist in this place. He is our Lord and Master."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGFence05_000165ec_Oblivion_RESP1"
msgid ""
"He is the best fence in the Thieves Guild. He operates from the Elven Gardens "
"in the Imperial City."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGFence05_00073b88_Oblivion_RESP1"
msgid ""
"He is the best fence in the Thieves Guild. He spends time in the guild hall, "
"and in the Elven Gardens."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Arden_0001f3ba_Oblivion_RESP3"
msgid ""
"He is the bringer of pain and pleasure; the blade that cuts through our sins "
"like a scythe through wheat."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDUmarilTopic_00002bf9_Knights_RESP1"
msgid ""
"He is the enemy of all who walk free on Tamriel today. A survivor of the "
"ancient race of Ayleid slavemasters who once ruled Cyrodiil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_0000a255_Oblivion_RESP1"
msgid ""
"He is the greatest of all thieves. I have heard it said that he stole his "
"gray cowl from Nocturnal herself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NivanDalviluTOPIC_0001ece2_Oblivion_RESP1"
msgid ""
"He is the head of our family. He works powerful magic, but his true gift is "
"compromise. He is a wise, wise leader."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDSirRodericTopic_00002a7b_Knights_RESP2"
msgid ""
"He is too modest to tell you himself, but he was a hero of the War of the "
"Bend'r-Mahk."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDLathonGreetB_00002a77_Knights_RESP1"
msgid "He is! I've been his squire for almost two years now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11CiirtaGreeting2_00016b6f_Oblivion_RESP1"
msgid ""
"He is? Then the Greymarch has begun again? If that is so, then why are you "
"here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RaynilDralasTopic_0003842e_Oblivion_RESP1"
msgid ""
"He isn't in right now, so you should be clear to check it out. Just don't "
"tell anyone I gave the key to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS09ImIn_00053724_Oblivion_RESP6"
msgid ""
"He just threatened to... hurt me if I got in his way. I think the gold "
"changed him. I really do. He wasn't the man I met seven years ago."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaNQDResponses_000465be_Oblivion_RESP1"
msgid ""
"He keeps busy. Repairing weapons, training light armor techniques, keeping "
"track of Skjorta...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000a0f6_Oblivion_RESP3"
msgid "He killed them all. Just... slaughtered them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028264_Oblivion_RESP1"
msgid ""
"He killed them! All of those people! We... we have to get him before he gets "
"us! We have to kill that murdering swine! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KingofWormsTopic_0000a0fe_Oblivion_RESP2"
msgid ""
"He killed them, one by one. Volanaro was last, I think. He was trying to run "
"away, but he didn't make it, did he?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_0004989c_Oblivion_RESP1"
msgid ""
"He knows a lot about it. Plus, he'll teach others how to use heavy armor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalNQDResponses_0003e96a_Oblivion_RESP1"
msgid ""
"He knows a lot about running his store. Of course, he's not the easiest "
"person to talk to."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002d928_Oblivion_RESP2"
msgid ""
"He knows to tell Adrienne that you're the one who rescued him. You should be "
"able to tell her you've completed her little task."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NivanDalviluTOPIC_0001ebdb_Oblivion_RESP1"
msgid "He leads the Dalvilu family. He is a wise man, and a powerful wizard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HrolUlfgarTOPIC_0001ece1_Oblivion_RESP1"
msgid ""
"He leads the Ulfgar clan. He is slow to anger, but fierce with his axe. All "
"the clan values his leadership and judgement."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Next_0001dc33_Oblivion_RESP3"
msgid ""
"He leaves his house early each morning. Watch him and report back to me here, "
"at midnight as usual. Make sure he doesn't notice you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VenaPetilius_00026b49_Oblivion_RESP3"
msgid ""
"He lives alone now. Moved into a cabin not far outside of town. It's near "
"where he buried Vena. I understand he visits her grave every day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00062450_Oblivion_RESP2"
msgid "He lives in Bruma. You should look for him there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SorisArenimTopic_0002f1f8_Oblivion_RESP1"
msgid ""
"He lives in the Talos Plaza district of the Imperial City. He's the one who "
"has Ardaline's staff now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ToutiusSextiusTopic_0001dc47_Oblivion_RESP1"
msgid ""
"He lives in the large house between the Low Gate and the East Bridge. Alone --"
" suspicious, don't you think?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11MillonaGetUp_000a7153_Oblivion_RESP1"
msgid "He looks familiar..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE43Bhisha_00072dbc_Oblivion_RESP1"
msgid ""
"He loves dogs. Dogs like sticks. Dogs like meat. I wonder if they like meat "
"on a stick?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaNQDResponses_0004664f_Oblivion_RESP1"
msgid ""
"He loves the place. I've also heard he's quite an accomplished alchemist."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGHieronymusLex_0000c051_Oblivion_RESP2"
msgid "He made things very difficult for the Thieves Guild for a while."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RogueMage_0002fd69_Oblivion_RESP2"
msgid "He may have more tricks up his sleeve."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_000617cf_Oblivion_RESP1"
msgid "He may help protect us. We can only hope."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06KellenQuestion_00002b09_Knights_RESP3"
msgid ""
"He may know more of the story than I. Perhaps you should speak with him, if "
"he's feeling well enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000541d0_Oblivion_RESP1"
msgid ""
"He may look slow... okay, he is slow. But what do you expect for this price?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASheogorathChoice1_00026ae0_Oblivion_RESP2"
msgid ""
"He might appear. Because it's raining. He loves the rain. Because it's wet. "
"Or because it's rainy. Not so sure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KingofWormsTopic_0000a0f9_Oblivion_RESP1"
msgid "He might come back if he knows I'm still here. I'm not staying here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46Choice4_0008fabb_Oblivion_RESP2"
msgid "He might offer you the same deal. But that guy is crazy. Trust me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GaltusPreviaTOPIC_0002d711_Oblivion_RESP1"
msgid "He must be in Nonwyll somewhere. Let's get there quickly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0007eaf7_Oblivion_RESP1"
msgid "He must die. It's the only way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusA_0001e8e6_Oblivion_RESP5"
msgid "He must have given it to you for a reason. Did he say why?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JorundrTopic_0005379a_Oblivion_RESP1"
msgid ""
"He must have moved the loot when I left our campsite to get us supplies. "
"Brave of him to bury it so close to town."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KnightsofThorn_00031ebe_Oblivion_RESP3"
msgid ""
"He must realize he'll be ruling Cheydinhal one day. That's a responsibility I "
"aim to make him ready for."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BrumaNQDQuestionResponses_00046651_Oblivion_RESP1"
msgid ""
"He must really know all the fighters by now. And, from what I've heard, he "
"knows a good bit about alchemy as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG12FithragaerWho_00095025_Oblivion_RESP2"
msgid ""
"He must've told them we were coming! We've got to get our hands on him, "
"before he tells them anything else!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MankarCamoranTopic_00015882_Oblivion_RESP2"
msgid ""
"He never comes here. He stays in Carac Agaialor with Ruma and Raven. But "
"these caves eventually lead to the Terrace of Dawn in front of his palace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MundaneAmulet_00038b02_Oblivion_RESP4"
msgid ""
"He never really trusted anyone else in the group, and before he secured the "
"treasure in that cave, he had a special enchantment placed upon it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ClaudeMaricTopic_0002c525_Oblivion_RESP2"
msgid ""
"He never tells us anything, though. Just between the two of us, this one "
"thinks Maric is cheating him. In fact, this one is sure of it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02JauffreD3_0001e74c_Oblivion_RESP3"
msgid ""
"He never told me anything else about the baby, but I knew it was his son. "
"From time to time he would ask about the child's progress."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilNQDResponses_0004657a_Oblivion_RESP1"
msgid "He obviously takes great pride in the lodge."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ThoronirBad_0000bca2_Oblivion_RESP5"
msgid ""
"He outright refuses to join the Society or even discuss the matter. We are "
"convinced he is up to no good."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_LeyawiinNQDQuestionResponses_0003dfa4_Oblivion_RESP1"
msgid ""
"He pays his debts, but his love of dogs is just odd. I've heard he leaves "
"meat in his backyard to attract them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e8d1_Oblivion_RESP1"
msgid ""
"He pays peanuts. And thinks it entitles him to chew us out 18 hours a day? "
"Sometimes I wonder if I made a mistake coming here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetTopic_00002a96_Knights_RESP2"
msgid "He preaches every day outside the Chapel. Go and listen. You'll see."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetTopic_00002a8b_Knights_RESP1"
msgid ""
"He preaches in Anvil. Appeared right after the attack on the Chapel there. "
"Sounds like the usual doom-saying nonsense."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetTopic_00002a87_Knights_RESP1"
msgid "He preaches most of the day across the street from the Chapel."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetTopic_00002a85_Knights_RESP1"
msgid ""
"He preaches outside the Chapel of Dibella in Anvil. No one knows where he "
"comes from, but he speaks the holy word like I've never heard before."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03HowToHelp_000092b7_Oblivion_RESP2"
msgid ""
"He probably won't believe you, so you may have to persuade him. Hopefully he "
"will at least go and check it out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e4ee_Oblivion_RESP1"
msgid ""
"He protects the Gates of Madness. He'll kill anyone who gets near. He's about "
"to destroy some adventurers up there now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e551_Oblivion_RESP1"
msgid ""
"He protects the Gates of Madness. He'll kill anyone who gets near... anyone "
"except Relmyna Verenim. She's staying upstairs right now."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_LeyawiinTopicDecentius03_000479f3_Oblivion_RESP3"
msgid ""
"He purchased the Eight Islands... the site of White Gold Tower and the "
"Imperial City... from the beastfolk natives for the secret of literacy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS43Staff_0004f8b6_Oblivion_RESP2"
msgid ""
"He ran off with someone else, so now the ring belongs to you. The owner of "
"the shop called it the Ring of Eidolon's Edge. I think you'll like it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46FatherInLaw_00033efe_Oblivion_RESP2"
msgid ""
"He read something about cheap land being offered by the government. Of course "
"nobody said anything about the swarming goblins."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_000286f8_Oblivion_RESP1"
msgid ""
"He reminds me of the guards under my father's employ. Strict, no-nonsense, "
"and ready to fight at a moment's notice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028178_Oblivion_RESP1"
msgid "He reminds me of you. Uncultured, unwashed and generally uninteresting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27LastAyleidKing_0002e5cf_Oblivion_RESP2"
msgid ""
"He ruled the last Ayleid city in Cyrodiil during the First Era, three "
"centuries after the Fall of White Gold Tower."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NorbertLellesTOPIC_0003572b_Oblivion_RESP1"
msgid ""
"He runs Lelles' Quality \"Mercandise.\" Ha! Not a bad sort. You can usually "
"find him in his store."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NorbertLellesTOPIC_000356bc_Oblivion_RESP1"
msgid ""
"He runs Lelles' Quality Merchandise here in Anvil. He's been having problems "
"with break-ins, though, and he's hired us to put a stop to it."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_CheydinhalNQDQuestionResponses_0003e95f_Oblivion_RESP1"
msgid "He runs a nice store, but Mach-Na is a grouchy old man."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479dc_Oblivion_RESP2"
msgid ""
"He said any Argonian can kick any Khajiit's butt to breakfast any day of the "
"week. You believe that?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479dd_Oblivion_RESP2"
msgid ""
"He said any Khajiit can kick any Argonian's butt to breakfast any day of the "
"week. You believe that?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE41Aquanostrum_0006ea4d_Oblivion_RESP2"
msgid ""
"He said if I let him stay for free, he'd tell me how to cure my sickness! How "
"fortuitous!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KingofWormsTopic_0000a0fe_Oblivion_RESP4"
msgid ""
"He said something about Echo Cave, and destroying the Mages Guild. Then he "
"looked right at me, and grinned!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetB3_00002b82_Knights_RESP1"
msgid ""
"He said that Sir Berich's tomb was in Underpall Cave -- which is no cave, but "
"some kind of buried keep."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23RalsaGreet_0001db1f_Oblivion_RESP2"
msgid ""
"He said to tell you that the matter he needs help with is of the utmost "
"importance to the citizens of the Imperial City."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RaynilDralasTopic_00032679_Oblivion_RESP3"
msgid "He seemed to be such a likeable fellow."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002978_Knights_RESP2"
msgid ""
"He seemed to know you were coming... told me to wait for you. And here you "
"are!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BrumaNQDQuestionResponses_000465ed_Oblivion_RESP1"
msgid ""
"He seems gifted with a blade. Can't blame the Fighters Guild for having him "
"train others."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_000286fb_Oblivion_RESP1"
msgid ""
"He seems on edge, doesn't he? I guess you can take the man out of the Legion, "
"but you can never take the Legion out of the man."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetTopic_00002a88_Knights_RESP1"
msgid "He seems to be different than your usual self-proclaimed holy man."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005c0b9_Oblivion_RESP1"
msgid "He sees all, knows all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39Relan_000781f0_Oblivion_RESP2"
msgid ""
"He seldom kills things right away. It takes awhile. Sometimes he talks to "
"them while cutting them open. But still, he gets the job done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OcatoTopic_000add41_Oblivion_RESP1"
msgid ""
"He served Emperor Uriel for many years, and so far he has done well in an "
"impossible situation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BaurusTopic_0006b83c_Oblivion_RESP1"
msgid "He served with honor. No Blade could ask for higher praise."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FawilTopic_000c4530_Oblivion_RESP1"
msgid ""
"He should be around somewhere. If he's not in the lodge, I'd try looking for "
"him in Cheydinhal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MartinTopic_0001e8a9_Oblivion_RESP1"
msgid ""
"He should be around the camp somewhere. He was with the survivors we rescued "
"from the Chapel of Akatosh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c1cb_Oblivion_RESP1"
msgid ""
"He should be kicked out of town before one of his experiments turns this "
"place into a wasteland."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04GivePick_00035fb7_Oblivion_RESP3"
msgid ""
"He showed me an inscription on the inside, 'To Alessia.' That had to be the "
"Countess of Leyawiin. The damn ring was stolen property!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JauffreTopic_000223ca_Oblivion_RESP1"
msgid "He sleeps here in the Priory House."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JauffreTopic_000223cd_Oblivion_RESP1"
msgid "He sleeps with us here in the Priory House."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VaronVamoriTopic_0002c6a9_Oblivion_RESP1"
msgid "He sold it, eh? Well, this just keeps getting worse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND04Mace_00002acc_Knights_RESP2"
msgid ""
"He stayed in the Chapel of Leyawiin for months, attempting the test over and "
"over. He hardly ate. Hardly slept."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_000498bc_Oblivion_RESP1"
msgid ""
"He still teaches others, though. Of course, you have to try to avoid all the "
"Old Man Dust."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_000498ba_Oblivion_RESP1"
msgid ""
"He still teaches, though he lost his passion for it after the Levitation Act "
"was passed. Can't say I blame him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_00049944_Oblivion_RESP1"
msgid "He supports all of your enchanting needs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Nd05Julianos_00002ae9_Knights_RESP2"
msgid ""
"He teaches us: \"Know the truth. Observe the law. When in doubt, seek wisdom "
"from the wise.\""
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39Notebook_00078201_Oblivion_RESP2"
msgid ""
"He think she keep our secrets in it. Look. Look! It nothing but gibberish. My "
"neighbors, they weird. Now, I must go bite something's head off. Bye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_00082620_Oblivion_RESP1"
msgid ""
"He thinks his house will collapse on him. Can't even sleep because of it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OcatoTopic_000add3c_Oblivion_RESP1"
msgid ""
"He thinks to use his position as head of the Elder Council to make himself "
"Emperor. He will not succeed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RolandJensericTopic_0001d24c_Oblivion_RESP4"
msgid ""
"He threw his lover to the ground and turned his attention on me. Luckily, I "
"managed to run back into the street and escape his grasp."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThoronirTopic_0001d03d_Oblivion_RESP3"
msgid ""
"He told me of his intentions to donate all of the money and inventory to the "
"local temple. He also agreed to buy and sell merchandise at fair prices."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32SiegeVitharn_00078fd8_Oblivion_RESP4"
msgid ""
"He told me that the spirits of my people would remain bound here, replaying "
"our cowardice, as a lesson to those that thwarted his will."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE43Ushnar_00072dc0_Oblivion_RESP3"
msgid ""
"He told me the dog can smell its food on anyone. Ushnar let that dog tear "
"that poor Khajiit apart."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06BookLostHistories_0000bf83_Oblivion_RESP1"
msgid ""
"He told me to give this message to any member of the Thieves Guild that asked "
"about him or a book."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDSirRodericTopic_00002a7d_Knights_RESP1"
msgid ""
"He told me to run, but I shouldn't have listened. I should have stayed and "
"helped him. Maybe together we could have defeated this wraith."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00053755_Oblivion_RESP1"
msgid "He told you where it is?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RaynilDralasTopic_0003843c_Oblivion_RESP5"
msgid ""
"He tracked the vampire to this house. When he entered the place around noon, "
"Bradon was sleeping. He was able to slay him at that point."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND04Mace_00002acb_Knights_RESP2"
msgid ""
"He tried to reach the mace again and again, failing each time. He became "
"obsessed with it, refusing food or drink for days."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MartinTopic_0006bed9_Oblivion_RESP1"
msgid ""
"He truly was the Dragonborn... the last, and perhaps the greatest of all the "
"Septims."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GlarthirTopic_0002a86e_Oblivion_RESP1"
msgid ""
"He turned up dead. I guess someone finally got tired of his crazy behavior."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS08Hunt_0001fdbb_Oblivion_RESP3"
msgid ""
"He uses the dungeons under Fort Grief as the hunting grounds. I was placed "
"here because he knew someone would go looking for me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14TivelaHeard_0001c1c5_Oblivion_RESP2"
msgid ""
"He usually comes out to eat dinner and sleep, but two days ago, he didn't "
"come out at all. At first, I wasn't worried. He does that occasionally."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEDunrootBurrowTopic_0001338b_Oblivion_RESP4"
msgid ""
"He wants you to learn for yourself. Learn, grow, experience. It's his way. I "
"shouldn't say more. But the Burrow, it's northeast of New Sheoth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028182_Oblivion_RESP1"
msgid ""
"He was a buffoon, but I didn't wish him dead, you cold-hearted villain!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ10BjalfiDead_00061422_Oblivion_RESP1"
msgid ""
"He was a good man when I married him, but greed took a hold of his heart. "
"While I'm not happy he's dead, I'm glad he's at peace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice6A_00028ac9_Oblivion_RESP2"
msgid ""
"He was a thief, not a farmer. The only reason to establish such a place would "
"be to stay out of the Chorrol Guard's sight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeridurTopic_0001da5b_Oblivion_RESP1"
msgid ""
"He was a traitor. Thanks to you, the Order lives on. Long live the Order!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HaderusGoldwineTopic_0002ad7e_Oblivion_RESP2"
msgid ""
"He was a valiant warrior in his day, and inspired us all to be our best. I "
"heard he personally led one of the first retaliations to the attack."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_0002948d_Oblivion_RESP1"
msgid ""
"He was a young man and now he's dead, slaughtered like a lamb. I've got my "
"eyes on you, stranger. Don't you forget that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VidkunTopic_0002e5e8_Oblivion_RESP1"
msgid ""
"He was an Associate, just like yourself. Perhaps not the brightest, but very "
"eager. He was given his assignment from Falcar, and disappeared."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice5A_00028ac8_Oblivion_RESP4"
msgid ""
"He was assigned to obtain a very valuable item for me. He succeeded, but "
"decided to keep this item for himself. An unfortunate decision."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Gang_0003d30e_Oblivion_RESP2"
msgid ""
"He was carrying a precious family heirloom with him when he was lured out to "
"their lair. It was a small ring given to him on our wedding day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetStartA1_00002c80_Knights_RESP2"
msgid ""
"He was cast down by Pelinal Whitestrake. But Umaril's spirit survived, and "
"now he has returned to seek vengeance upon the gods. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDUmarilTopic_00002bf8_Knights_RESP2"
msgid ""
"He was defeated, but not destroyed, by Pelinal the Crusader. Now he has "
"returned to seek vengeance against the gods."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_000174f3_Oblivion_RESP3"
msgid ""
"He was furious when I told him I'd helped you, and then when I threatened to "
"report him to the Council of Mages, I thought he was going to kill me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JorundrTopic_00053279_Oblivion_RESP2"
msgid ""
"He was going to skip town on Arnora, but got arrested before making good on "
"his escape. Now she has no money left at all. Poor thing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Unseen_00025345_Oblivion_RESP1"
msgid "He was here a second ago..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MehrunesDagonTopic_00092e8b_Oblivion_RESP2"
msgid ""
"He was involved with Jagar Tharn's plot against the empire years ago. It "
"doesn't surprise me to find his hand in the current calamity."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StolenPainting_00031508_Oblivion_RESP2"
msgid ""
"He was kind and noble, which is difficult to convey on canvas. I am afraid "
"other than that, I cannot offer much more information."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LorgrenBenirus_00003a71_Oblivion_RESP2"
msgid ""
"He was mostly harmless, until the fateful day he came across a tome bearing "
"the evil magic of necromancy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07TheFringeTopic_0009130c_Oblivion_RESP1"
msgid "He was right about that. I can feel it. In My bones. The little ones."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028191_Oblivion_RESP1"
msgid ""
"He was so young... so innocent. That boy was destined for greatness. Who "
"could have done such a thing?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDUmarilTopic_00002bf9_Knights_RESP2"
msgid ""
"He was struck down by Pelinal, but by his art Umaril had bound himself to the "
"realm of his mistress, the Daedra Lord Meridia."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JskarTopic_0000a100_Oblivion_RESP1"
msgid "He was the only one left?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Arden_0001f3bb_Oblivion_RESP2"
msgid ""
"He was the sovereign of thought and a regnant artist. To call him a simple "
"craftsman would not suffice; know him as the Artificer Superior."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice5A_00028ac8_Oblivion_RESP3"
msgid ""
"He was very good at obtaining things from people who did not want to part "
"with. A professional thief, to put it bluntly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05Gwinas_00094c3b_Oblivion_RESP4"
msgid ""
"He was very upset when he found out I didn't have his book for him. I doubt "
"he'll be in any mood to talk to you about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetD2A_00002c0b_Knights_RESP2"
msgid ""
"He was worried that the Sword may have been turned to evil. That it may have "
"to be reconsecrated on the altar of its creator, the divine Arkay."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetD2B_00002c09_Knights_RESP2"
msgid ""
"He was worried that the Sword may have been turned to evil. That it may have "
"to be reconsecrated on the altar of its creator, the divine Arkay."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDCrusadersRelicsTopic_00002a80_Knights_RESP3"
msgid ""
"He went alone into the White Gold Tower, challenged the Ayleid sorceror-king "
"Umaril to single combat, and slew him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BaurusTopic_0006b838_Oblivion_RESP1"
msgid ""
"He will not be forgotten. He goes to Aetherius to join the other fallen "
"heroes of the Blades."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002e71e_Oblivion_RESP3"
msgid ""
"He will reward you greatly for escorting me home and closing the Oblivion "
"Gate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00031eba_Oblivion_RESP3"
msgid ""
"He will reward you greatly for escorting me home and closing the Oblivion "
"Gate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThadonTopic_0008f178_Oblivion_RESP2"
msgid "He will suffer greatly at the hands of Lord Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDUmarilTopic_00002bfc_Knights_RESP1"
msgid "He will trouble us no more, thanks to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035672_Oblivion_RESP3"
msgid ""
"He wishes to meet with you south of the Cursed Mine outside of town, after 2 "
"AM."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07GreymarchTopic_0009112b_Oblivion_RESP2"
msgid ""
"He wishes you to gain the respect of the people, to be a leader once He is "
"gone. It is an interesting concept."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateVoice_000910f4_Oblivion_RESP1"
msgid "He won't be getting up!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AldosOthranTopic_0003c2b1_Oblivion_RESP2"
msgid "He won't be hard to find, just follow the smell of stale mead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e553_Oblivion_RESP4"
msgid ""
"He won't bother those blessed by Lord Sheogorath. You, however, will die "
"trying to get the keys from my child."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS11ErlineOpinion_00038444_Oblivion_RESP3"
msgid ""
"He works at night, and has to sleep during the day. Why does that make him a "
"vampire?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OgreSlaves_00026b66_Oblivion_RESP1"
msgid ""
"He works them in Bleak Mine. It's terrible. The guards beat the creatures "
"mercilessly. That's all I can tell you. Now please, go."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08GiveStone_00014705_Oblivion_RESP2"
msgid ""
"He would have had it destroyed or taken it from them and kept it under lock "
"and key in the palace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08GiveStone_0001cf35_Oblivion_RESP2"
msgid ""
"He would have had it destroyed or taken it from them and kept it under lock "
"and key in the palace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07JyggalagTopic_0009100f_Oblivion_RESP1"
msgid ""
"He'll be here soon, and I'll be gone. Can't say I like the sound of that. I "
"like the sound of other things, though. Like birds. And bones cracking."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07JyggalagTopic_00091017_Oblivion_RESP1"
msgid ""
"He'll be here soon, and I'll be gone. Can't say I like the sound of that. I "
"like the sound of other things, though. Like birds. And bones cracking."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06JauffreB_0008b617_Oblivion_RESP2"
msgid ""
"He'll be in the Great Hall, reading. He's hardly taken time to sleep since "
"you left."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JauffreTopic_000223d0_Oblivion_RESP1"
msgid ""
"He'll be sleeping, like anyone with a lick of sense... in the Priory House."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d2ab_Oblivion_RESP2"
msgid ""
"He'll be truly famous one day. Word already spreads about his skill... I "
"think someone saw him at Faregyl Inn not too long ago. You should try there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RolandJensericTopic_0001da6c_Oblivion_RESP1"
msgid "He'll make a fine replacement for Seridur. It's the least we can do."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061c6e_Oblivion_RESP1"
msgid "He'll return. He must return."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_00049899_Oblivion_RESP1"
msgid "He'll train you in how to use heavy armor, if you can pay for his time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46Choice4_0008fb62_Oblivion_RESP2"
msgid ""
"He'll try to offer you the same kind of deal, that handsome devil, but he "
"can't be trusted! Make the right decision."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS08UrsanneAvenged_0001fdbe_Oblivion_RESP3"
msgid ""
"He'll... not be needing it any longer, and I want you to have it. I'll not "
"take no for an answer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BittneldTopic_0002ba45_Oblivion_RESP1"
msgid ""
"He's Captain of the Chorrol Guard. During the day, you can usually find him "
"on patrol with us around the city."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GuilbertJemaneTopic_000242ba_Oblivion_RESP1"
msgid "He's Guilbert. I'm Reynald."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e552_Oblivion_RESP1"
msgid ""
"He's Relmyna's crowning achievement. The Gatekeeper keeps out people who "
"don't belong in the Shivering Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReynaldJemaneTopic_000242b9_Oblivion_RESP1"
msgid "He's Reynald. I'm Guilbert."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGHieronymusLex_00017c46_Oblivion_RESP1"
msgid ""
"He's a Captain of the Imperial Watch. He is pursuing a personal vendetta "
"against the Thieves Guild and the Gray Fox."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_000286db_Oblivion_RESP1"
msgid ""
"He's a Nord. Even a complete idiot could see that. So what does that say "
"about you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028177_Oblivion_RESP1"
msgid "He's a Nord. Mead-swilling barbarians, all of them."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_LeyawiinNQDQuestionResponses_0003dfab_Oblivion_RESP1"
msgid ""
"He's a bit crazy for dogs, from what I hear. He pays bets on time, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetTopic_00002a96_Knights_RESP1"
msgid ""
"He's a blessing on this town. The only one to have made any sense out of the "
"terrible tragedy at the Chapel."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Next_00023669_Oblivion_RESP2"
msgid ""
"He's a clever one, no doubt about it. Eyes in the back of his head, always "
"seems to know when I'm watching.  But that's where you come in."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_00035dca_Oblivion_RESP1"
msgid ""
"He's a fairy tale. The Imperial Watch pretends there is a thief king named "
"the Gray Fox who controls all the thieves in Cyrodiil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGNotInterestedGF_0001e093_Oblivion_RESP1"
msgid ""
"He's a fairy tale. The Imperial Watch pretends there is a thief king named "
"the Gray Fox who controls all the thieves in Cyrodiil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RolandJensericTopic_0001da63_Oblivion_RESP1"
msgid "He's a fine man, and an honored brother."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Creatures_000224af_Oblivion_RESP2"
msgid "He's a good boy, but he's hot-headed. Keep a close eye on him, will you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_IrlavJarolTopic_00035f46_Oblivion_RESP1"
msgid ""
"He's a good man, but Council matters have distracted him lately, and he's "
"been neglecting his other work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c1d5_Oblivion_RESP1"
msgid "He's a moron. One of these days, he'll be taught a lesson."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_00064458_Oblivion_RESP1"
msgid ""
"He's a most mysterious fellow. In many ways I admire him. Most of the time I "
"just feel sorry for him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilNQDResponses_0003c1c8_Oblivion_RESP1"
msgid ""
"He's a nice fellow, but he couldn't even get the sign for his store spelled "
"right."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GlarthirTopic_00028d67_Oblivion_RESP1"
msgid ""
"He's a raving lunatic.  I'm assuming you're asking because he's done "
"something strange."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BrumaNQDQuestionResponses_000465bd_Oblivion_RESP1"
msgid ""
"He's a saint. Sure, he spends a bit of time at the Tap and Tack, but you "
"can't blame him."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_000498ca_Oblivion_RESP1"
msgid "He's a sneaky one. I understand he'll teach others to be sneaky, too."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c1a3_Oblivion_RESP1"
msgid "He's a tough one, that's for sure. I wouldn't want to cross him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_000286fc_Oblivion_RESP2"
msgid ""
"He's a trained soldier, after all. I bet if anyone can figure out what's "
"going on here, it will be him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinNQDResponses_0003e2ae_Oblivion_RESP1"
msgid "He's a very hard worker. Sometimes I wonder if he ever gets out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_0002825a_Oblivion_RESP1"
msgid ""
"He's a very serious man, but I guess that's normal for a retired soldier. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RiZakarTopic_00035702_Oblivion_RESP1"
msgid ""
"He's a warrior, a battle-hardened mercenary who's spent time all over "
"Tamriel. He'll keep his prize tree locked away. You'll need to find his key."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47HowToHelp_00030039_Oblivion_RESP1"
msgid ""
"He's a wizard who took up residence in the ruins of Fort Caractacus a couple "
"of years ago."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c1a4_Oblivion_RESP1"
msgid "He's all business. That's probably good in his line of work, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09JyggalagTopic_0009135c_Oblivion_RESP1"
msgid ""
"He's almost here. I can feel it. You won't like Him as much as Me. He doesn't "
"even carry a cane! More the giant, bone-cleaving sword type of Prince."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HenantierTopic_00027f37_Oblivion_RESP2"
msgid ""
"He's always getting himself into jams with the careless ways he performs his "
"experiments, and well, I'm afraid he's done it again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeebumNaTOPIC_00026ac5_Oblivion_RESP1"
msgid ""
"He's always got some scam going with Bejeen, his partner. You might find them "
"both at Weebum-Na's house."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_LeyawiinNQDQuestionResponses_0003e2ac_Oblivion_RESP1"
msgid ""
"He's always trying to stir things up. I don't think he means any real harm, "
"though."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_CheydinhalNQDQuestionResponses_0003e983_Oblivion_RESP1"
msgid ""
"He's always wanted to be in the guild. Good that he was finally made a member."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028791_Oblivion_RESP1"
msgid "He's an Imperial Legion bulldog. Scum, if you ask me. Kind of like you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LordRugdumphTOPIC_0000be7d_Oblivion_RESP1"
msgid ""
"He's an Orcish noble. A fine man. Our families go back a bit. Anyway, his "
"daughter is missing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinNQDResponses_0003dfb6_Oblivion_RESP1"
msgid ""
"He's an aggressive one, that's for sure. Has a good book selection, though."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_CheydinhalNQDQuestionResponses_0003e98f_Oblivion_RESP1"
msgid "He's an ass. There's no excuse for his behavior."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilNQDResponses_000465c7_Oblivion_RESP1"
msgid "He's an interesting man, and an amazing fighter."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_0002817a_Oblivion_RESP1"
msgid ""
"He's an obnoxious drunkard, I know, but I'm not sure if I see him as the "
"murdering type.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilNQDResponses_0003c221_Oblivion_RESP1"
msgid "He's an odd one. Drinks like a fish, but runs like a rabbit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_00082615_Oblivion_RESP1"
msgid "He's an odd one. I'm sure someone will take care of him soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MaglirTOPIC_0002428e_Oblivion_RESP1"
msgid "He's around here somewhere. Has been for days. No trouble, really."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_0004989a_Oblivion_RESP1"
msgid "He's as good as you'll find in the city when it comes to heavy armor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ErthorTopic_0002d929_Oblivion_RESP1"
msgid ""
"He's back to his normal routine now, all safe and sound. Enjoy taking credit "
"for the work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_00035dcc_Oblivion_RESP1"
msgid ""
"He's been around for hundreds of years. I've heard tell that he is immortal. "
"I don't know about that, but he sure ain't normal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_00035dda_Oblivion_RESP1"
msgid ""
"He's been around forever. It must be 300 years or more since he took charge. "
"I'm not sure he's even human."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000545f9_Oblivion_RESP1"
msgid "He's been fed and well rested for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008260e_Oblivion_RESP1"
msgid "He's been living with Zoe Malene, looking for some amulet."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGHieronymusLex_00015f23_Oblivion_RESP1"
msgid "He's been ordered to evacuate the Waterfront? Excellent."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_000498e1_Oblivion_RESP1"
msgid "He's calmed down a lot. Can still teach you how to pick a lock, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47HowToHelp_00030039_Oblivion_RESP2"
msgid ""
"He's caused us no end of trouble with his magical experiments, but nothing as "
"bad as this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_0004988b_Oblivion_RESP1"
msgid ""
"He's certainly a talented smith. I'm glad he'll train others in the skill."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaNQDResponses_000465cc_Oblivion_RESP1"
msgid ""
"He's certainly become more like a Nord over the years. Quite a competent "
"healer, too."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_000286f5_Oblivion_RESP1"
msgid ""
"He's dead, and one of us killed him. Maybe it was you, eh? Maybe he found the "
"gold, and you murdered him for it! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028174_Oblivion_RESP1"
msgid "He's dead, and one of you killed him! I hate you all!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028703_Oblivion_RESP1"
msgid "He's dead, you peasant! There's nothing more to tell!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VidkunTopic_0002e998_Oblivion_RESP1"
msgid "He's dead?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0007eaa1_Oblivion_RESP1"
msgid ""
"He's dead? Hmm. Of course, I'm too tired to walk all the way up there at the "
"moment. I'll head up there after I rest my eyes for a moment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0007eaa0_Oblivion_RESP1"
msgid "He's dead? I bet he died of some horrible disease, didn't he?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeridurTopic_0001da69_Oblivion_RESP1"
msgid ""
"He's dead? Thank goodness! I feared I'd never be able to leave here, or "
"worse, that he would come for me. I can finally return home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TeekeeusTopic_000253d4_Oblivion_RESP2"
msgid ""
"He's desperately trying to control as much power as he can, and I'm a threat, "
"because I don't want to see that power all in his hands."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JskarTopic_0002d591_Oblivion_RESP1"
msgid "He's disappeared."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDKellenTopic_00002b07_Knights_RESP1"
msgid ""
"He's down in the Chapel Hall, resting. You may speak to him, if you like."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_000286f0_Oblivion_RESP1"
msgid ""
"He's drinking even more than he was before. Is it because he's afraid, or "
"feeling guilty? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_000498e8_Oblivion_RESP1"
msgid "He's forgotten more about picking locks than most people will ever know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_000498b9_Oblivion_RESP1"
msgid ""
"He's getting older, but he can still teach a bit about Alteration. He's been "
"teaching it since before the Levitation Act of 421."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_000498bb_Oblivion_RESP1"
msgid "He's getting up in years, but he's still a good Alteration teacher."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE43Bhisha_00072dba_Oblivion_RESP1"
msgid "He's gone? Truly? Oh, thank you! "
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_CheydinhalNQDQuestionResponses_0003e97d_Oblivion_RESP1"
msgid ""
"He's good with his fists, no doubt about it. He'll teach you something, for "
"the right price."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BrumaNQDQuestionResponses_000465cb_Oblivion_RESP1"
msgid "He's good. We're lucky to have him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c254_Oblivion_RESP1"
msgid ""
"He's got some issues, that's for sure. Personally, I'd just steer clear of "
"him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GaltusPreviaTOPIC_0002d710_Oblivion_RESP1"
msgid "He's got to be in here somewhere."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46DoublesTopic_00081f8c_Oblivion_RESP1"
msgid "He's got to go. Before he eats me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000f593e_Oblivion_RESP1"
msgid "He's here somewhere. I know it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AzaniBlackheartTOPIC_0002c58c_Oblivion_RESP1"
msgid "He's here. I know it. Lead the way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilNQDResponses_0003c220_Oblivion_RESP1"
msgid ""
"He's in great shape, that's for sure. Maybe he could teach me something about "
"his training regimen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03WhereArmand_00009188_Oblivion_RESP1"
msgid "He's in hiding. I hear Methredhel is looking for you, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000982d8_Oblivion_RESP1"
msgid "He's inside, downstairs. Don't keep him waiting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JskarTopic_0002d58a_Oblivion_RESP2"
msgid ""
"He's invisible, and you've about as much luck finding him as Jeanne does. "
"Excuse me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_000009ff_Oblivion_RESP1"
msgid ""
"He's just a name on a wanted poster. I don't trust you enough to say more "
"than that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_0006445d_Oblivion_RESP1"
msgid ""
"He's just a thief. He's supposed to be the head of the Thieves Guild. What a "
"joke! Can you imagine a bunch of thieves trying to form a guild?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_00035ddc_Oblivion_RESP1"
msgid ""
"He's kind of like a guildmaster for the Thieves Guild. All I know is that the "
"Doyen and other senior guild members do his bidding like trained dogs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028795_Oblivion_RESP1"
msgid ""
"He's like everyone else in the Imperial Legion. Someone needs help, someone "
"is getting killed, and they're nowhere to be found. Worthless. "
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_MQ06ShrineTalkStoreroom_0003641e_Oblivion_RESP1"
msgid ""
"He's never around when you need him. And he never attends services anymore. "
"If he's not careful, he may find himself on the altar one day soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EyjaTopic_000b97e5_Oblivion_RESP4"
msgid ""
"He's never been cruel to me, it's just that he's never been kind. It's as if "
"I'm just another part of his shop."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ForlornWatchman_00035cab_Oblivion_RESP3"
msgid ""
"He's never harmed anyone, but most people give him a wide berth. You seem "
"curious enough, so I'll be glad to pinpoint where he appears on your map."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MercatorHosidusTopic_0003567c_Oblivion_RESP2"
msgid ""
"He's not available right now. You can either wait here for him, or come back "
"later."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_defaulted_0003457f_Oblivion_RESP1"
msgid ""
"He's not doing the job? The little vermin. It still needs to be done. You get "
"back there and make sure that job is finished! Get moving!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00053771_Oblivion_RESP1"
msgid "He's not likely to just come out and tell you, so get creative!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00054220_Oblivion_RESP1"
msgid ""
"He's not much to look at, but you won't find a better bargain in Cyrodiil. "
"Take good care of him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JauffreTopic_000223da_Oblivion_RESP2"
msgid ""
"He's not part of our community here, but a resident of Weynon Priory, the "
"monastery southeast of town."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalNQDResponses_0003e968_Oblivion_RESP1"
msgid ""
"He's not the friendliest person around, but he can teach you a lot about "
"running a business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilNQDResponses_0003c1c9_Oblivion_RESP1"
msgid ""
"He's not the smartest man, but he's a nice guy. I just hope he can keep his "
"business afloat."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06JyggalagTopic_000910f6_Oblivion_RESP1"
msgid ""
"He's on his way, so I'm on my way out. It's terribly inconvenient, don't you "
"think?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MaglirTOPIC_0002428a_Oblivion_RESP1"
msgid ""
"He's one of your Fighters Guild brothers, but he's defaulted on a contract. "
"We can't allow that. Makes us all look bad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGHieronymusLex_00064466_Oblivion_RESP1"
msgid "He's our new Captain. I've never met a finer man."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07BribeBeggar_00015f18_Oblivion_RESP2"
msgid ""
"He's out and about in the morning, so I would wait until afternoon or evening "
"to go visit him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e4ed_Oblivion_RESP1"
msgid "He's pretty scary, isn't he? Let's watch him in action."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG01ErthorTopic_00047467_Oblivion_RESP1"
msgid ""
"He's probably still out at the cave. Adrienne hasn't let him work here in a "
"long time."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_CheydinhalNQDQuestionResponses_0003e97a_Oblivion_RESP1"
msgid ""
"He's quite an accomplished brawler. I wonder if he'd teach me something about "
"it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilNQDResponses_0003c1e8_Oblivion_RESP1"
msgid "He's quite the pugilist."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_000498ac_Oblivion_RESP1"
msgid ""
"He's really skilled at using light armor. Luckily, he's willing to train "
"others to use it, as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS26ShopkeeperReport_00035ca0_Oblivion_RESP1"
msgid ""
"He's shaken down most of the shopkeepers in the Market District. They're all "
"too afraid of him to do anything. Jensine wouldn't even talk about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_000289f5_Oblivion_RESP1"
msgid ""
"He's somewhere around here. Why don't you stop wasting my time and go ask him "
"yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReynaldJemaneTopic_00094075_Oblivion_RESP2"
msgid ""
"He's staying over at the Newlands Lodge, but you also might find him walking "
"around town. Good luck."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE43Bhisha_00072dbb_Oblivion_RESP1"
msgid "He's still around. I've seen him skulking like the filthy cat he is."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaNQDResponses_000465bc_Oblivion_RESP1"
msgid ""
"He's sure got his hands full, between smithing and training in light armor. I "
"don't know how he does it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaNQDResponses_000465ec_Oblivion_RESP1"
msgid "He's talented. The Fighters Guild could do a lot worse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGHieronymusLex_00064462_Oblivion_RESP1"
msgid ""
"He's that Imperial Watch Captain that's always chasing after the Gray Fox and "
"the Thieves Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_0006445e_Oblivion_RESP1"
msgid ""
"He's that thief that the Imperial Watch are always going on about. He likes "
"to steal from rich folk."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGHieronymusLex_0000c051_Oblivion_RESP1"
msgid ""
"He's the Captain of the Guard in Anvil now. He used to be in the Imperial "
"Watch until Countess Umbranox had him reassigned."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JauffreTopic_0001e910_Oblivion_RESP1"
msgid ""
"He's the Grandmaster of the Blades. As the eyes and ears of the Emperor, the "
"Blades don't advertise themselves."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ValusOdiilTopic_000224cd_Oblivion_RESP1"
msgid ""
"He's the best fighter you'll ever meet, and as soon as he gets here, we'll be "
"off. Just wait; you'll see."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09FathisAren_00015f1e_Oblivion_RESP1"
msgid "He's the court wizard. He has a room in the north wing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e4ef_Oblivion_RESP1"
msgid ""
"He's the crowning achievement of Relmyna Verenim. She's my teacher. The "
"Gatekeeper keeps out people who don't belong."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028263_Oblivion_RESP1"
msgid ""
"He's the killer! Don't you see? We have to protect ourselves! We'll be next! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028262_Oblivion_RESP1"
msgid ""
"He's the killer, you idiot! Can't you see? He murdered all of those people! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AjumKajinTopic_000356e6_Oblivion_RESP1"
msgid ""
"He's the one in charge of this expansion. I know he's a high-ranking member "
"of the group. An Argonian mage, from what I hear."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39Relan_000781f0_Oblivion_RESP1"
msgid ""
"He's the only one that pulls his weight. He kills the vermin and trespassers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MercatorHosidusTopic_0003567c_Oblivion_RESP1"
msgid "He's the person to talk to about an audience with the Count. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MercatorHosidusTopic_0003567d_Oblivion_RESP1"
msgid ""
"He's the person to talk to about an audience with the Count. You'll find him "
"in the County Hall."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00090ff2_Oblivion_RESP1"
msgid "He's too much! Killed all my men! Get out of my way!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15Anaxes_00047366_Oblivion_RESP4"
msgid ""
"He's trapped at the back of the cave. It took us weeks to prepare the trap, "
"and he killed us many times before we finally succeeded."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02SpeakToJauffre_000aa08f_Oblivion_RESP1"
msgid "He's upstairs. Go ahead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JauffreTopic_0005e15b_Oblivion_RESP1"
msgid "He's usually praying in the Priory chapel at this time of day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_0002824c_Oblivion_RESP1"
msgid "He's very handsome. But please don't tell him I said so! Hehe!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThadonTopic_000131d6_Oblivion_RESP2"
msgid ""
"He's waiting for you. Unless he isn't. He wasn't, but then he was. Maybe he "
"still is."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0009f914_Oblivion_RESP1"
msgid "He's waiting inside."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_duties_0002e585_Oblivion_RESP1"
msgid ""
"He's what??? That little lump of guar dung! You get back to Bravil and take "
"care of that contract. I need to think about this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028d2d_Oblivion_RESP1"
msgid "He's young, rich and handsome. Basically the complete opposite of you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028d2e_Oblivion_RESP1"
msgid "He's young, rich and handsome. That's way out of your league, tramp."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00027995_Oblivion_RESP1"
msgid ""
"He's young, well-educated and obviously full of himself. Not much different "
"than any young nobleman, really."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ErthorTopic_0002d6e8_Oblivion_RESP1"
msgid ""
"He's... well, he's an interesting fellow. Sulinus Vassinus can tell you more "
"about him, if you wish to know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AdamusPhillidaTopic_001778e3_Oblivion_RESP1"
msgid "He... He's dead. And on my watch... I've failed... Failed everyone..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08Choice6A_00085a63_Oblivion_RESP1"
msgid ""
"He... he did? Oh my goodness, what should I do? Should I talk to him? Or "
"maybe play hard to get? Or should I, you know? Or would that be too forward?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReynaldJemaneTopic_00023e83_Oblivion_RESP1"
msgid "He.... he's alive?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_000b9845_Oblivion_RESP1"
msgid ""
"Head downstairs, and the room will be straight across from the door. Sleep "
"well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062ccc_Oblivion_RESP1"
msgid "Head on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00062451_Oblivion_RESP1"
msgid ""
"Head to Leyawiin, and find J'bari. He's the one you want to talk to about "
"Light Armor training."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d2b1_Oblivion_RESP2"
msgid ""
"Head to Skingrad, and visit the West Weald Inn. I believe he's currently "
"employed there. In the wine cellar, in fact."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017979_Oblivion_RESP1"
msgid "Head to Xeddefen, Your Grace. By your will, we shall hold this position."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017984_Oblivion_RESP1"
msgid "Head to Xeddefen, Your Grace. We will hold this position."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LordRugdumphTOPIC_0000be7d_Oblivion_RESP2"
msgid ""
"Head to his estate and talk to him. Find his daughter. And mind your manners! "
"I don't want you embarassing me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeHelmet_0001652c_Oblivion_RESP1"
msgid "Head wounds bleed profusely."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476da_Oblivion_RESP1"
msgid ""
"Health and fortune, traveler. I'm Dynari Amnis. May the Nine bless your "
"dreams."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45Choice1_00078788_Oblivion_RESP2"
msgid ""
"Hear it singing! Songs of home! It comes again. It brings presents! It is not "
"present. Soon it will be!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00022a14_Oblivion_RESP1"
msgid "Hear me out before you leave."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001823a_Oblivion_RESP1"
msgid "Hear me out before you make your decision."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetSpeechMain_00002a66_Knights_RESP1"
msgid "Hear me, o people of Cyrodiil!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MankarSpeech_0001f877_Oblivion_RESP1"
msgid "Hear now the words of Lord Dagon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001d256_Oblivion_RESP1"
msgid "Hear out Seridur, first. Then we'll speak."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk3_0003404d_Oblivion_RESP1"
msgid ""
"Heard about that, did you? Ha ha ha! All right, so things got a bit out of "
"control. Nothing I couldn't handle though, as you can plainly see."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0002556b_Oblivion_RESP1"
msgid "Heard any news from the other provinces?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_000241b4_Oblivion_RESP1"
msgid "Heard any news lately?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0003dfb5_Oblivion_RESP1"
msgid "Heard anything more about the Blackwood Company?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434c5_Oblivion_RESP1"
msgid ""
"Heard the Gatekeeper was killed. Waste of a creature that size anyway, if you "
"ask me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f1e2_Oblivion_RESP1"
msgid ""
"Heard there's a new Gatekeeper. Spends all day by that huge wall. It's bound "
"to fall in on him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00071dc3_Oblivion_RESP1"
msgid "Heard they made you master. Gods help us all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000a5644_Oblivion_RESP1"
msgid "Heard you went over to the other side. Get out of my face."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ef6_Oblivion_RESP1"
msgid ""
"Hearing rumors of Syl's madness makes me glad I live outside the walls of New "
"Sheoth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434d3_Oblivion_RESP1"
msgid ""
"Hearing that the Resonator works again almost makes up for losing the "
"Gatekeeper. We're still not safe, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047717_Oblivion_RESP1"
msgid "Hearth and fortune. Grey-Throat, I am called. You are not known to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008f039_Oblivion_RESP1"
msgid "Heathen!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture3_0007194b_Oblivion_RESP1"
msgid ""
"Heavenly Doomstones bear red runes, appear with stone circles, and are "
"associated with cosmic features of the heavens like the moons Jone and Jode."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06CasimirGauntlets_00002b24_Knights_RESP2"
msgid ""
"Heavy as stone, they would not move. None could lift them. I suspect they lie "
"there still, in Chorrol's Chapel."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND10UmarilVoiceSky_00002cc9_Knights_RESP1"
msgid "Heca!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0002d6e2_Oblivion_RESP3"
msgid ""
"Heck, I'll even go do the job for you for 300 gold. When Erthor gets back, "
"you can take the credit. What do you say?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark05FinCHoice2C_0004ce4b_Oblivion_RESP1"
msgid ""
"Heed my words. Phillida has dedicated his life to eradicating the Dark "
"Brotherhood. He will not tolerate our operations within the Imperial City."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00086091_Oblivion_RESP1"
msgid "Heel, dog!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Lost_0002d408_Oblivion_RESP1"
msgid "Heh, I'd better cut down on the ale. Starting to see things, I am..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000513bd_Oblivion_RESP1"
msgid "Heh, heh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_0002872b_Oblivion_RESP1"
msgid ""
"Heh, you should have seen the old biddy trying to talk to young Primo "
"Antonius. She may be a noble, but he looked down on her like a scullery maid. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488c4_Oblivion_RESP2"
msgid ""
"Heh-heh. Just kidding. Everything is all perfectly safe. Tested it myself. "
"Ungarion, retired adventurer. You may have heard of me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AssaultNoCrime_00062506_Oblivion_RESP1"
msgid "Heh. It's been too long since I've seen a good brawl."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Prank_000302d5_Oblivion_RESP1"
msgid "Heh. Really, you're going to love this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0007e3e8_Oblivion_RESP1"
msgid "Hehe. Watching them run from the Giant Gnarl gets me every time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c20f_Oblivion_RESP1"
msgid ""
"Heinrich Oaken-Hull is married to a Bosmer? I suppose the women are less "
"annoying than the men."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e09b_Oblivion_RESP1"
msgid ""
"Heinrich Oaken-Hull, captain and shipmaster. My ship, the Serpent's Wake, is "
"in for refitting, so I'm high and dry for a while."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023de8_Oblivion_RESP1"
msgid "Hello again!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000091ef_Oblivion_RESP1"
msgid "Hello again! Have you had any luck finding the sword and armor?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001e0e3_Oblivion_RESP1"
msgid "Hello again, brother."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00146815_Oblivion_RESP1"
msgid "Hello again, brother."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035a25_Oblivion_RESP1"
msgid "Hello again, citizen."
msgstr ""

