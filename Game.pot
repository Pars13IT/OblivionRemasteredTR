msgctxt "ST_ResponseTexts/LOC_RT_NDTalkDeadAvita1_00002cf4_Knights_RESP1"
msgid ""
"Do you ever think about Sir Avita? Her death... I wish it could have been me "
"instead of her, is all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GiftScript_0002fbad_Oblivion_RESP3"
