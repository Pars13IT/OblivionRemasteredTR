msgctxt ""
"ST_ResponseTexts/LOC_RT_TG10SpringheelJakBootsTopic_0001530c_Oblivion_RESP1"
msgid "Do you have the boots?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bc34_Oblivion_RESP1"
msgid "Do you have the gift for Malene?"
