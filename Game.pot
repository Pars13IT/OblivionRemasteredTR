msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00002a38_Knights_RESP1"
msgid "May Stendarr grant you mercy, for I shall not!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UrielSeptimTopic_0001e8e1_Oblivion_RESP1"
