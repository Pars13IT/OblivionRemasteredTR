msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00146816_Oblivion_RESP1"
msgid "Hello, my friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022509_Oblivion_RESP1"
msgid "Hello, my little friend. I have something that might interest you..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f365_Oblivion_RESP1"
msgid ""
"Hello, my name is Tove. \"The Unrestful,\" they call me. So much to do, and "
"so little time. There's only one of me to go around, you know!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488df_Oblivion_RESP1"
msgid ""
"Hello, stranger. Luciana Galena. I'm Bravil's Advanced Trainer for the Light "
"Armor discipline."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002fd72_Oblivion_RESP1"
msgid "Hello, stranger. What can I do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000251df_Oblivion_RESP1"
msgid ""
"Hello, sweet Sister. It warms my heart to see you again. The Night Mother has "
"been smiling upon you, I hope."
msgstr ""

