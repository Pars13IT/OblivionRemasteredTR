msgid "Hello, my Brother."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00025270_Oblivion_RESP1"
msgid "Hello, my Sister."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00091b49_Oblivion_RESP1"
msgid "Hello, my darling. Are you having a good day?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002b7a8_Oblivion_RESP1"
msgid "Hello, my friend! What can this grizzled old Blademaster do for you?"
msgstr ""

