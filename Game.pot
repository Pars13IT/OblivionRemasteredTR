msgid ""
"Good news from Kvatch for a change. The last of the daedra have been driven "
"out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkRelics2_00002c70_Knights_RESP1"
msgid ""
"Good news! The Gauntlets are ours! Stendarr smiled upon our Commander, as he "
"has not done to any knight for 300 years."
msgstr ""

