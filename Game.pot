msgid "Hello, good sir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001bae1_Oblivion_RESP1"
msgid "Hello, guildmate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e4bc_Oblivion_RESP1"
msgid "Hello, is there something I can do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029b8_Knights_RESP1"
msgid "Hello, little brother!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00042fef_Oblivion_RESP1"
msgid ""
"Hello, little one! I'm Urul gro-Agamph. All kinds of cute animals come to "
"visit me. Just like you did! You're a pretty butterfly, aren't you?"
msgstr ""

