msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008ea05_Oblivion_RESP1"
msgid "Do you have the time?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e4ba_Oblivion_RESP2"
msgid "Do you hear that sound? It's like a horse dying..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DABoethiaSpeech_00051ed6_Oblivion_RESP1"
msgid ""
"Do you hope to be counted among my Chosen? Then prove yourself to me, mortal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_000498e9_Oblivion_RESP1"
msgid "Do you know Areldil? I understand he has some unique skills."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Next_0001dc33_Oblivion_RESP1"
msgid ""
"Do you know Davide Surilie? Yes, of the famous Surilie Vineyards. Pillar of "
"the community, et cetera. Who would ever suspect him?"
