msgid "Oh dear, whatever could you want?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ01Potatoes_000c55c5_Oblivion_RESP1"
msgid "Oh my goodness! You found them! Ohhhh! I could kiss you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00022a01_Oblivion_RESP1"
msgid "Oh my poor Aleron..."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE07BThadonDeathSpeech01_0007b379_Oblivion_RESP1"
msgid ""
"Oh my yes, I feel especially delighted this evening! Perhaps it's time I "
"recited my latest soliloquy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CureforVampirism_0003f28f_Oblivion_RESP1"
msgid "Oh my!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004600c_Oblivion_RESP1"
msgid "Oh my! Are you an adventurer?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS05PreparedYes_0002c6ea_Oblivion_RESP2"
msgid "Oh my! I almost forgot!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434b2_Oblivion_RESP1"
msgid ""
"Oh my! The Gatekeeper is dead! I must hurry back to Thadon's side. He must be "
"protected!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AldosOthranTopic_0003c2bd_Oblivion_RESP1"
msgid "Oh my! You better find him and see what he's doing! Hurry!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity7_00081e8c_Oblivion_RESP3"
msgid ""
"Oh my, that is Odd! I've never even heard of such a thing before. We'll find "
"a nice place for it here in the Museum."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetGreetA4a_00002be8_Knights_RESP1"
msgid "Oh my, the Grand Champion of all of Cyrodiil! By Azura indeed!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS51AccuseChoice2_00031520_Oblivion_RESP1"
msgid ""
"Oh my. I feel terrible that I even suspected anyone within my court. I was "
"hoping to recover the painting, so I might look upon it again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00018bfb_Oblivion_RESP1"
msgid "Oh my. Look at you. You're in the thick of it now, aren't you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002909_Knights_RESP1"
msgid ""
"Oh my. To what do I owe this honor? I am but a humble prophet. What business "
"do you have with me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AldosOthranTopic_0003c2b5_Oblivion_RESP1"
msgid ""
"Oh no! They killed him? I can't believe this! Ever since his wife passed at "
"the hands of the bandits, his life has been miserable."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark05Convo_0002f29f_Oblivion_RESP1"
msgid ""
"Oh no! What am I to do! An underworld enforcer and a Dark Brotherhood "
"assassin, both here to kill poor Francois!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_000473f4_Oblivion_RESP1"
msgid ""
"Oh no, that's Adrienne's job, not mine. If you ask about it, don't be "
"surprised if she's annoyed. She doesn't like being interrupted."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SERunsInCirclesGreetB_00041209_Oblivion_RESP1"
msgid "Oh no. Oh no no no. No no no no no no no!!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02OrcSpectators_0007ead4_Oblivion_RESP1"
msgid "Oh no. They're bleeding all over the place!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TestToddFear_00027fa6_Oblivion_RESP1"
msgid "Oh no. What do we do? I'm so scared."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06ArctusGreetA_00040144_Oblivion_RESP1"
msgid ""
"Oh no. You don't want to do that. Don't believe their lies. They are no true "
"friends. Don't you see it? How they whisper behind your back?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00022a13_Oblivion_RESP1"
msgid "Oh no..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS43Staff_0004f8b9_Oblivion_RESP1"
msgid ""
"Oh please, I beg you! Take this staff to Darkfathom Cave and get rid of it "
"and the scamps forever!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE40SleepOutsideChoice1b_000790bc_Oblivion_RESP1"
msgid ""
"Oh so sad. I hope he didn't die in his bedroll. Can't have that. Because "
"that's where I'll be sleeping!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000c1bf_Oblivion_RESP1"
msgid ""
"Oh thank goodness! That horrid woman kept threatening me! She said if I "
"didn't come up with the loot she'd throw me to the slaughterfish."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434d7_Oblivion_RESP1"
msgid "Oh thank goodness! The Resonator of Judgment has saved us!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS43ScampsYes_0004f78f_Oblivion_RESP1"
msgid ""
"Oh thank you! I had a feeling buying that Daedric staff would be trouble. Now "
"I'm paying for it with more than just some gold."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14ChoiceHelp2_0001bb31_Oblivion_RESP1"
msgid ""
"Oh thank you! I knew there was good in you. Here's the key to Rythe's study. "
"You may come and go as you please. If you need me, I'll be here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE35HereYouGo_00078673_Oblivion_RESP1"
msgid "Oh thank you! My collection is finally complete!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetSpeechMain_00002a75_Knights_RESP1"
msgid ""
"Oh unhappy Tamriel! Where is your Divine Crusader, in these latter days of "
"petty strife and lesser men?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_0002b1e2_Oblivion_RESP4"
msgid ""
"Oh wait, there's one more thing! I sent Porkchop the boar up to the Arena to "
"help you out. He'll at least keep one of them distracted! Now good luck!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark04DrethConvo_00045f85_Oblivion_RESP1"
msgid ""
"Oh yeah? And where will you go? Huh? What will you do? You can't survive out "
"there, Dreth. You're an animal. You belong in that cage.  "
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_MG11ChoiceBlackSoulGems_00033635_Oblivion_RESP3"
msgid ""
"Oh yes! There's one obscure text that references these gems. I believe it's "
"still around here someplace, unless Falcar never returned it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MSShadowscaleChoice2A_0003559e_Oblivion_RESP2"
msgid ""
"Oh yes, I suppose Teinaava wants proof that I'm dead, eh? Let me guess -- my "
"heart? I suggest you take the heart of the dead Argonian Agent."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE40SleepOutsideChoice2_000790bd_Oblivion_RESP1"
msgid "Oh yes, my pardons. But what can I give you? Hmmm..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE41Aquanostrum_0006ea4d_Oblivion_RESP1"
msgid ""
"Oh yes... it's the miracle remedy for any disease!  I was told about this "
"wonderful solution by a recent patron of my establishment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0000bcd0_Oblivion_RESP1"
msgid "Oh! Errr... Hello."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002dac_Oblivion_RESP1"
msgid ""
"Oh! Hello, there. I'm sorry, you startled me. My nerves get rattled rather "
"easily these days, I'm afraid. Living alone will do that to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ08Wine_0018d924_Oblivion_RESP3"
msgid ""
"Oh! I almost forgot. Here's your finder's fee. Worth every single coin, I "
"assure you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001bb27_Oblivion_RESP1"
msgid ""
"Oh! I don't know how to thank you! You've brought my husband back to me. I "
"shall always count you as a friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19Choice1A_0009e2ec_Oblivion_RESP1"
msgid ""
"Oh! It... It seems you already have a family member traveling with you, dear "
"Listener. Perhaps I can help, when you are done with their services?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19Choice1A_0009e2f3_Oblivion_RESP1"
msgid ""
"Oh! It... It seems you already have a family member traveling with you, dear "
"Listener. Perhaps I can help, when you are done with their services?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19Choice1A_0009e4c1_Oblivion_RESP1"
msgid ""
"Oh! It... It seems you already have a family member traveling with you, dear "
"Listener. Perhaps I can help, when you are done with their services?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008675a_Oblivion_RESP1"
msgid ""
"Oh! Most honorable Listener! I... I am so pleased to see you! Sorry, I don't "
"mean to be nervous, it's just that, well... I am awed by your presence!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00086965_Oblivion_RESP1"
msgid ""
"Oh! Oh look! My goodness... Two people here to confront me! Whatever shall I "
"do?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaAgronakChoice1_00038b47_Oblivion_RESP1"
msgid ""
"Oh! Oh, well of course. You have your own concerns, I'm sure, and I should "
"not have imposed. Please excuse my indiscretion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaAgronakChalYes_0003a917_Oblivion_RESP1"
msgid ""
"Oh! Oh, well... All right then. I was hoping you'd complete your journey to "
"Crowhaven first, but it is your right to challenge me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GiftScript_0002fbb2_Oblivion_RESP1"
msgid ""
"Oh! Oh... No... Not here! Not in the hotel! My lady friend... Atraena. She'll "
"get mad! Wait 'til I'm away from... here. Outside the hotel... Yeah..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000605f1_Oblivion_RESP1"
msgid "Oh! Our Lord has abandoned us! What will be our fate?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark05Choice2B_0004cad0_Oblivion_RESP1"
msgid ""
"Oh! Sorry! Please, I'm sorry! See, when Hides-His-Heart gets here, I'll put "
"on a little act. Then you cut me with the knife, and it looks like I die!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaAgronakChoice3_00038ed3_Oblivion_RESP1"
msgid ""
"Oh! Sorry, I didn't mean to ramble. Go to Crowhaven, to the west. Take this "
"key. It unlocks... something that holds proof of my birth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaBetChoice2C_0002aa10_Oblivion_RESP1"
msgid ""
"Oh! Sorry, I... I just assumed. Well, if there's anything else I can do for "
"you, please just ask."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark17Choice4A_00054036_Oblivion_RESP1"
msgid "Oh! Well in that case, um... Here you go!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000253b6_Oblivion_RESP1"
msgid ""
"Oh! Well... um, hello. You must be the one Lucien Lachance told me about. "
"I've been expecting you. We haven't got much time, I'm afraid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE42Calipers_0007322f_Oblivion_RESP2"
msgid ""
"Oh! You must be thinking about the skyboat. Yesterday's news. I'm working on "
"a collapsible fork now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk3_0003404c_Oblivion_RESP1"
msgid ""
"Oh! You must mean the orphanage contract! Well, it's true. The children "
"actually tried to defend themselves. Poor dears. He he he he he. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000093bc_Oblivion_RESP1"
msgid "Oh! You startled me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_000039e6_Oblivion_RESP1"
msgid ""
"Oh! You're being sent to kill Phillida? I hope the Rose of Sithis pierces his "
"heart and sends his soul screaming into the Void!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00097588_Oblivion_RESP1"
msgid "Oh! You've returned! I do hope you have good news."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14ChoiceHelp_0001b948_Oblivion_RESP1"
msgid ""
"Oh!!! Thank you so very much! Here's the key to Rythe's studio. You may come "
"and go as you please. If you need me, I'll be around the house."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028256_Oblivion_RESP1"
msgid ""
"Oh, Azura, no! It's Primo! He's the only one left! He killed them... killed "
"them all! We have to protect ourselves! We have to kill him first!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004de89_Oblivion_RESP1"
msgid "Oh, Faelian, dear Faelian... why must you ruin both our lives?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkOrcElfConvo_00026e7c_Oblivion_RESP1"
msgid ""
"Oh, Gogron! He he he he. Your methods may be crude, but your heart is always "
"in the right place."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseBuyCheydinhal_0004f213_Oblivion_RESP3"
msgid ""
"Oh, I almost forgot, Borba gra-Uzgash at Borba's Goods and Stores will have "
"everything you need to make the place more livable."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeridurTopic_0001e0b4_Oblivion_RESP1"
msgid ""
"Oh, I believe he left a message with Grey-Throat. Something about not being "
"here for a few days?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08Choice5B_00085864_Oblivion_RESP1"
msgid ""
"Oh, I certainly hope so. I still want to find the gold, of course, but is it "
"even worth it? I just want to go home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServiceRefusal_000613b1_Oblivion_RESP1"
msgid ""
"Oh, I couldn't just give away all my business secrets. They wouldn't be "
"secrets any more, would they?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BleakFlatsCaveTopic_0000a1e7_Oblivion_RESP1"
msgid ""
"Oh, I do remember telling him to go there... hmm. Well, we'll just have to do "
"something about that, won't we?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Topic_00000a27_Oblivion_RESP1"
msgid "Oh, I don't know.  How could you tell, anyway?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServiceRefusal_000613ad_Oblivion_RESP1"
msgid ""
"Oh, I don't think so. As much as I enjoy helping those less fortunate than I, "
"I just can't bring myself to do it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServiceRefusal_000613ae_Oblivion_RESP1"
msgid ""
"Oh, I don't think that would be best for you. You need to get out, see the "
"world, discover things for yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VidkunTopic_0002e998_Oblivion_RESP2"
msgid "Oh, I knew it. I just knew something like this had happened!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThaedilResponses_00041213_Oblivion_RESP1"
msgid ""
"Oh, I loved it! Best I've ever seen. You're one of the Realm's greatest "
"artists, if you ask me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JskarTopic_0002d586_Oblivion_RESP1"
msgid "Oh, I might know where he is, I suppose."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000441fe_Oblivion_RESP1"
msgid ""
"Oh, I must say I was sorry to see Syl go. She always kept me busy, and when "
"I'm busy, I'm ever so happy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624ee_Oblivion_RESP1"
msgid ""
"Oh, I shouldn't... well, all right. Gogron had a pet rabbit as a child! He "
"petted the thing so hard he crushed its skull! Ha ha ha! What a brute!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate2_00014454_Oblivion_RESP1"
msgid ""
"Oh, I think we both know the answer to that. You're here because you know "
"something. You're plotting behind Lady Syl's back, and you've been caught."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThadonWaitingLong_000131da_Oblivion_RESP1"
msgid ""
"Oh, I wouldn't say that. How long is an eon, when you're ten thousand feet "
"tall? Or if you're purple? It's all relative, you see."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark04GuardsConvo_0009533d_Oblivion_RESP1"
msgid ""
"Oh, I'll be there! How could I miss a chance to see you cower before that big "
"Orc bouncer? Ha ha ha ha ha ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00097587_Oblivion_RESP1"
msgid ""
"Oh, I'll never get that crystal ball back. Not with those frightful spirits "
"floating around..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06WantGauntlets_00002b0b_Knights_RESP1"
msgid ""
"Oh, I'm afraid that's quite impossible. They don't move. Not even a bit. As "
"if they're the heaviest things in the world."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG04Choice4B_00030188_Oblivion_RESP1"
msgid "Oh, I'm sorry. Perhaps I heard incorrectly. Excuse me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40Conversation_00098140_Oblivion_RESP1"
msgid "Oh, Janus. Thank you... thank you for saving me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate4_0001562f_Oblivion_RESP1"
msgid ""
"Oh, Nelrene. You take the fun out of everything. Very well. What do you know "
"of a conspiracy against Lady Syl?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark09Choice1B_00035e07_Oblivion_RESP1"
msgid ""
"Oh, Sithis needs my soul does he? Well, you can tell your Dread Father that "
"he can kiss my wrinkled arse! Defend yourself, Dark Brotherhood dog!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG01SulinusConv_0002d91c_Oblivion_RESP1"
msgid ""
"Oh, Sulinus! Thank you for coming to get me! I was afraid I'd be trapped here "
"forever!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38OddityC_0008243b_Oblivion_RESP3"
msgid ""
"Oh, a Ring of Desiccation! That's one of my... well, was one of my favorite "
"Oddities. If I had the money, I'd buy it off you right now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG08ChoiceStartOver_00035623_Oblivion_RESP1"
msgid "Oh, all right then."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaBetChoice1B_0002827a_Oblivion_RESP1"
msgid ""
"Oh, all right. Very well then. If... um... if you need anything, please just "
"ask. I'll be happy to take your bet if you change your mind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001d242_Oblivion_RESP2"
msgid "Oh, allow me to introduce myself. I am Seridur."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02GatesOfMadness_0008e4fa_Oblivion_RESP2"
msgid ""
"Oh, and I guess there's keys sewn up inside the Gatekeeper's body. Not sure "
"why someone would do that. It's not like anyone can get them now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09HaskillGatekeeper_00040372_Oblivion_RESP2"
msgid ""
"Oh, and I see you have gained a new power. Relmyna's gift with summoning "
"Flesh Atronachs has rubbed off on you, it seems. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElixirofExploration_0004e91c_Oblivion_RESP3"
msgid "Oh, and as before, you can pick up your free Elixir in 24 hours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FingersoftheMountain_00022507_Oblivion_RESP2"
msgid ""
"Oh, and do be careful with what I've given you. It's very valuable, but... "
"well, slightly dangerous. You'll see what I mean."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseBuySkingrad_0004f217_Oblivion_RESP3"
msgid "Oh, and don't worry, we're tossing all of his junk out as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RulesOfCompetition_0003d7b4_Oblivion_RESP5"
msgid ""
"Oh, and don't worry. We'll try to match the creatures to your combat "
"abilities, so the fights will always be more or less \"fair.\" Sounds good, "
"huh?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d48d_Oblivion_RESP6"
msgid ""
"Oh, and one more thing, if you breathe a word of this to the city guard, you "
"won't live long enough to get whatever reward they're offering."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01FinChoice1A_00023e4b_Oblivion_RESP4"
msgid ""
"Oh, and one more thing. Get into the habit of asking your fellow family "
"members about any current contract. Their insight may prove invaluable."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000356a9_Oblivion_RESP2"
msgid ""
"Oh, and perhaps you saw the sign outside. Slight mistake, you know. Bit of "
"bad luck there. So, what can I do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_00015f11_Oblivion_RESP4"
msgid ""
"Oh, and speaking of the Gray Cowl, did you know he stole it from Nocturnal "
"herself?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028bf1_Oblivion_RESP2"
msgid ""
"Oh, and the chest of gold was a nice touch. I knew it was all too good to be "
"true, but I guess my greed got the best of me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseBuyBravil_0004ed83_Oblivion_RESP3"
msgid ""
"Oh, and the place is fairly bare. If I were you, I'd head on over to Nilawen "
"at The Fair Deal and get some furnishings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e552_Oblivion_RESP3"
msgid ""
"Oh, and this is really interesting -- wait! Never mind. My big mouth almost "
"just got me in trouble again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002dad_Oblivion_RESP1"
msgid ""
"Oh, back again? I don't know what else you could need. I gave you the list. "
"That  should tell you where you can find my children, and what they want."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_000514b6_Oblivion_RESP1"
msgid "Oh, boy. Good luck getting that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark09RetFinChoice1B_00032bed_Oblivion_RESP1"
msgid ""
"Oh, but I do. You have been selected by the Black Hand to perform the ancient "
"rite known as Purification. Everyone inside the Sanctuary must die!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a907_Oblivion_RESP3"
msgid ""
"Oh, but I see. You're a Champion... You want my Grand Champion title, is that "
"it? Please, challenge me. In the Arena I can end my misery..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_0003336e_Oblivion_RESP1"
msgid ""
"Oh, but you must be the one Orc weakling, huh? Captured by Imperials. How "
"pathetic. You're going to die in here, Orc! Like an animal in a cage!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00051792_Oblivion_RESP1"
msgid "Oh, by the Nine Divines, why do I get all the riff-raff?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00092d78_Oblivion_RESP1"
msgid ""
"Oh, can it really be true? Can the killer really be dead? This has been such "
"a nightmare! I just want to find a way out of this house and go home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark02PirateConvo_000493b0_Oblivion_RESP1"
msgid ""
"Oh, come now. How many times has Malvulis saved our necks, huh? Captain "
"Tussaud keeps her on for a reason. She's a better sailor than any one of us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f85d_Oblivion_RESP1"
msgid ""
"Oh, come on! You couldn't even follow through with getting that book from "
"Jeanne's room? That would've been hilarious!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONEXIT_0018b2eb_Oblivion_RESP1"
msgid "Oh, come on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e8bb_Oblivion_RESP1"
msgid ""
"Oh, dear. A budding spellcaster. How charming. I'm Falcar. I'm what a real "
"wizard looks like."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BleakFlatsCaveTopic_0001c1b0_Oblivion_RESP1"
msgid "Oh, dear. I just can't seem to remember where that is. What a shame."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0002e5e7_Oblivion_RESP2"
msgid ""
"Oh, dear. I'd say more, but... well, Falcar is the ranking member here, and I "
"don't feel comfortable talking about him. I'm sorry."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_MS40MelisandeIdonthavethem_0005373c_Oblivion_RESP1"
msgid "Oh, dear. That's a shame. I was so looking forward to helping you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000175b2_Oblivion_RESP2"
msgid "Oh, dear. This is worse than I'd expected."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark17Choice3A_00054034_Oblivion_RESP1"
msgid "Oh, do you now? And just why should I give you that? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark11Choice4A_00002dd8_Oblivion_RESP1"
msgid ""
"Oh, do you now? Well then, far be it for me to deny you such a reasonable "
"request. Guards, I need assistance! This person is resisting arrest!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081b68_Oblivion_RESP2"
msgid ""
"Oh, don't expect to summon dear Haskill anywhere but in the Realm. He "
"dislikes leaving My presence. I get that sometimes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06SheoIntro5_00082461_Oblivion_RESP6"
msgid ""
"Oh, don't forget to make use of dear Haskill. Between you and me, if he's not "
"summoned three or four times a day, I don't think he feels appreciated."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00030189_Oblivion_RESP1"
msgid "Oh, don't let me bother you. You just stay safe on the road."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38OddityNotNow_00081e99_Oblivion_RESP3"
msgid "Oh, don't worry. You'll find something Odd if you keep at it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk2_00067dc3_Oblivion_RESP1"
msgid ""
"Oh, for the love of Akatosh, would everyone just please calm down! I'm fine. "
"And I don't need anything. I just... I just wanted to talk. That's all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004a995_Oblivion_RESP1"
msgid "Oh, go away! Shoo! Shoo! A man's not even safe in his own home anymore!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000514b0_Oblivion_RESP1"
msgid "Oh, go away! Shoo, shoo!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0018abce_Oblivion_RESP1"
msgid "Oh, go on! Leave me then!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d73_Oblivion_RESP1"
msgid "Oh, great... now I have to entertain a god."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00034039_Oblivion_RESP1"
msgid ""
"Oh, have you heard? About old Baenlin? It was a horrible accident. A stuffed "
"minotaur head fell off the wall and crushed him to death! Tragic..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00034038_Oblivion_RESP1"
msgid ""
"Oh, have you heard? Old Baenlin is dead! They say he was murdered! Right in "
"his own home!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00027982_Oblivion_RESP1"
msgid ""
"Oh, hello sweetie. So, no luck yet in finding the gold, I gather? I've been "
"looking as well, but haven't found so much as a clue. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007eab7_Oblivion_RESP1"
msgid ""
"Oh, hello there. Were you standing there for very long? I didn't notice you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00095a65_Oblivion_RESP1"
msgid ""
"Oh, hello, dear friend! Let me just say once more how happy I am to have my "
"crystal ball back. I'll never forget your selflessness and bravery!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004300d_Oblivion_RESP1"
msgid ""
"Oh, hello. Can't you see I'm dozing off here? I was just daydreaming about "
"how awful life is. I'd like to get back to that as soon as possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008e4ca_Oblivion_RESP1"
msgid "Oh, hello. Didn't realize anyone was there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00043014_Oblivion_RESP1"
msgid ""
"Oh, hello. The real world just isn't as colorful as the ones in the story "
"books, is it? Nor as truthful as the essays and histories. Alas."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArdalineTopic_0002ba60_Oblivion_RESP1"
msgid "Oh, her. I've seen her around town, but I don't really know her."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE40SleepOutsideChoice2_000790bd_Oblivion_RESP2"
msgid ""
"Oh, here! Take this scroll. I was going to use it when the walls fell on me "
"and I got trapped. But now I don't need it anymore!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE40SleepOutside_000790bf_Oblivion_RESP2"
msgid ""
"Oh, here's a notion for ya. Uungor really gets on us nerves. You could kill --"
" or, persuade -- hisself to leave. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00146844_Oblivion_RESP1"
msgid ""
"Oh, hey there! Nice to make your acquaintance. I'm... Well, my name's not "
"important, really. I'm a combatant in the Arena. Gladiator rank."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004de8a_Oblivion_RESP1"
msgid "Oh, hey, yeah. Yeah, I'll talk to you... Later? Yeah, later."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE35Brithaur_00078664_Oblivion_RESP1"
msgid "Oh, how could anyone have a problem with me? Come now!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity12_00081eaa_Oblivion_RESP3"
msgid ""
"Oh, how cute! Look how it tries and tries to scream but no sound comes out! "
"This is perfect for my museum!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38OddityDonate_00043434_Oblivion_RESP3"
msgid ""
"Oh, how generous of you! This blind Watcher's Eye is sure to draw a crowd."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00034075_Oblivion_RESP1"
msgid ""
"Oh, how horrible! You know Caelia Draconis? That nice Watch officer stationed "
"at the castle? She's been murdered!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS93Choice01B_00095a67_Oblivion_RESP2"
msgid ""
"Oh, how wonderful! I can't thank you enough! I've been going out of my mind "
"ever since my crew was murdered! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002eddc_Oblivion_RESP2"
msgid ""
"Oh, is this about joining the Mages Guild? I suppose I could spare the time, "
"if necessary."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFelldew_000206f7_Oblivion_RESP1"
msgid ""
"Oh, it wouldn't do to speak of it. Thadon's plan for you, I mean. I like you, "
"little one, but I would never interfere with what Thadon wants."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkDeadLathon1_00002d00_Knights_RESP1"
msgid ""
"Oh, it's nothing, really, but... I still miss Sir Lathon. His death was a "
"blow to the Knights. I can't make sense of it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000206cb_Oblivion_RESP1"
msgid "Oh, it's you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003aaa9_Oblivion_RESP1"
msgid "Oh, it's you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002e52_Oblivion_RESP1"
msgid "Oh, it's you. Looks like we're working together."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000301db_Oblivion_RESP1"
msgid ""
"Oh, it's you. My brother goes on and on about you. I know you saved us and "
"everything, but it does get tiresome after a while."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RingofBurden_000175ba_Oblivion_RESP1"
msgid ""
"Oh, just drop it anywhere. I don't think he really cared about it. I think it "
"was some sort of sick joke on his part."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FaelianTopic_0002ff11_Oblivion_RESP1"
msgid ""
"Oh, just get away from me! My relationship with Faelian is none of your "
"business!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043eda_Oblivion_RESP1"
msgid ""
"Oh, listen to you... a talking bird! How sweet. Did you know that Thadon's "
"back to his old self? Fly away now! Be free!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_0003334e_Oblivion_RESP1"
msgid ""
"Oh, look, an Imperial in the Imperial Prison. I guess they don't play "
"favorites, huh? Your own kinsmen think you're a piece of human trash. How sad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033786_Oblivion_RESP1"
msgid "Oh, look. You again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40MelisandeWitch_0003f291_Oblivion_RESP2"
msgid "Oh, my dear! I gave up witchcraft a long, long time ago."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG18Choice2A_00070485_Oblivion_RESP1"
msgid "Oh, my dear. I didn't mean to imply that you have a choice."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_NecromancersAmuletTopic_000146c8_Oblivion_RESP2"
msgid "Oh, my dear. I'm afraid you're in over your head."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002edd0_Oblivion_RESP1"
msgid "Oh, my head..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_0002818f_Oblivion_RESP1"
msgid ""
"Oh, my heavens! Primo must be the killer! I... I never thought it could be "
"him. Please... please! You've got to protect me from him! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033779_Oblivion_RESP1"
msgid "Oh, my poor little rats!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033769_Oblivion_RESP1"
msgid "Oh, my rats are so cute!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000c42d2_Oblivion_RESP1"
msgid "Oh, my sons. My poor sons. Who will help them now?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005eefa_Oblivion_RESP1"
msgid ""
"Oh, my word! The Fringe, gone? Luckily, Sheogorath will protect us. He always "
"does."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SurpriseReceive_0002424c_Oblivion_RESP1"
msgid "Oh, my!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38OddityDonate_00081ea4_Oblivion_RESP3"
msgid ""
"Oh, my! I'm so glad to have this back. People have been asking me what "
"happened to my Ring of Disrobing, and I just didn't know what to tell them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity11_00081e98_Oblivion_RESP3"
msgid ""
"Oh, my. How wonderful! A ring that removes people's clothing! This will be "
"one of my most popular exhibits, I'm sure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Gift_0018bc2f_Oblivion_RESP2"
msgid ""
"Oh, my. This is from Pranal, isn't it? He's such a sweet man. I do enjoy his "
"company, but I'm afraid I just don't have romantic feelings for him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate3_00015862_Oblivion_RESP1"
msgid "Oh, my. Well, if you insist."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SadGeneral_00024272_Oblivion_RESP1"
msgid "Oh, my...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FearGeneral_0002426e_Oblivion_RESP1"
msgid "Oh, no!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_disappearances_0000be6a_Oblivion_RESP1"
msgid ""
"Oh, no! You believe trolls killed them? That's horrible. Good that you've "
"killed all of the trolls, though. Please, take this, with our gratitude."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_disappearances_0000be6c_Oblivion_RESP1"
msgid ""
"Oh, no! You believe trolls killed them? That's horrible. Please, if you can "
"kill all of those trolls, we'd greatly appreciate it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SadGeneral_00024271_Oblivion_RESP1"
msgid "Oh, no."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45DarMaDead_0002820c_Oblivion_RESP1"
msgid ""
"Oh, no.  I had feared she might never return, but I had hoped for the best "
"... I ... thank you for your efforts ... please, excuse me ..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000039bd_Oblivion_RESP1"
msgid "Oh, no. Not another one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_jointheMagesGuild_0002d27e_Oblivion_RESP1"
msgid ""
"Oh, no. You can't join the guild with that bounty on your head. Get that "
"taken care of, and then come see me again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_0001a2e0_Oblivion_RESP1"
msgid ""
"Oh, no. You'll not drag me into Syl's mess. She made this bed, now it's up to "
"her to burn it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG11ChoiceSent_00033633_Oblivion_RESP1"
msgid "Oh, of course you were!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028181_Oblivion_RESP1"
msgid ""
"Oh, please! Save me! Save me from that savage! He'll kill me and then feast "
"on my flesh! That's what Nords do! Please, I don't want to die!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice1B_00023f3c_Oblivion_RESP1"
msgid ""
"Oh, please, no! I can pay you! Name your price! Anything! Anything! Please, "
"just let me live!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_COERCEDISLIKE_0018b2c8_Oblivion_RESP1"
msgid "Oh, please."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Fines_0003c295_Oblivion_RESP1"
msgid ""
"Oh, please. Don't even get me started. That madman won't be satisfied until "
"everyone in town is dead broke... or in jail!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000301dc_Oblivion_RESP1"
msgid ""
"Oh, really? I'm invisible, you say? Thanks for letting me know. Talk to my "
"brother Diram if you want to know all about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05GwinasB2_00095330_Oblivion_RESP1"
msgid ""
"Oh, really? You think the Mythic Dawn is the first daedric cult I've "
"encountered?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark02PirateConvo_000493b2_Oblivion_RESP1"
msgid ""
"Oh, right, how could I forget. That time we were almost dashed upon those "
"rocks, near the city of Firsthold. That was somebody else at the helm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark02Choice1C_00023f35_Oblivion_RESP1"
msgid ""
"Oh, so you want to get cute, do you?  All right then, mate, we'll do this the "
"hard way!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEChaliceofReversal_000131d9_Oblivion_RESP1"
msgid "Oh, so you've heard of it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08SheldenGreeting3_00018e6e_Oblivion_RESP3"
msgid ""
"Oh, sorry. I wasn't aware that being a courageous hero was a requirement "
"around here. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG01AdrienneConv_0002d902_Oblivion_RESP1"
msgid ""
"Oh, spare me. You're lucky I bothered to send someone after you at all. In "
"the future, would you please be more careful?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE41Yes_0006ea4c_Oblivion_RESP4"
msgid "Oh, thank you so much!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000093bf_Oblivion_RESP1"
msgid "Oh, thank you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG01Choice3A_00009293_Oblivion_RESP1"
msgid "Oh, thank you. You're just too kind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38OddityA_00082439_Oblivion_RESP3"
msgid ""
"Oh, that looks just like a little skull I used to have. I would love to have "
"one back, but the Museum just isn't drawing the crowds anymore...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00027994_Oblivion_RESP1"
msgid ""
"Oh, that man disgusts me! I find his entire manner offensive. Why, just "
"before you got here he told the most off-color joke about an Argonian maid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JOKELOVE_0018b2db_Oblivion_RESP1"
msgid "Oh, that's great! That's really too much!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BRIBE_0006232b_Oblivion_RESP1"
msgid "Oh, that's just the thing!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG13EridorWho_00034467_Oblivion_RESP2"
msgid "Oh, that's right. We've heard all about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36Choice8Reward_00061c50_Oblivion_RESP1"
msgid ""
"Oh, that. When you kill me, take the key to my house. Nothing really worth "
"taking, except what's locked up in the jewelry box. You can have that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035676_Oblivion_RESP2"
msgid ""
"Oh, the Count is quite aware of your presence here. He simply has no interest "
"in granting you an audience at this time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02GatesOfMadness_0007eadb_Oblivion_RESP1"
msgid ""
"Oh, the Gates are unlocked? Very good. I think I'll just rest my eyes for a "
"moment, then I'll go through and see what's on the other side."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0009079f_Oblivion_RESP1"
msgid "Oh, the big tough slayer has returned... tremble in fear! Ahahaha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003ea32_Oblivion_RESP1"
msgid ""
"Oh, the misery of being me. Someone end me! And be quick about it, please!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003375b_Oblivion_RESP1"
msgid "Oh, the poor little rats!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0000c086_Oblivion_RESP1"
msgid ""
"Oh, this is going to be funny! You're going to be the first assassin in Dark "
"Brotherhood history who couldn't even kill an invalid! Ha ha ha ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002815e_Oblivion_RESP1"
msgid ""
"Oh, this is just horrible! Who could do such a thing? Who could kill a "
"defenseless person in cold blood? Greed truly brings out the worst in people."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_NDGauntletsoftheCrusader_00002b11_Knights_RESP1"
msgid ""
"Oh, those. You'll want to speak to Areldur about them. He's in charge of "
"keeping people away from them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ThoronirLater_000be40c_Oblivion_RESP1"
msgid ""
"Oh, very well. If you change your mind, let me know. It could prove quite "
"lucrative for both of us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS37JulienneNo_000c440e_Oblivion_RESP1"
msgid "Oh, very well. No need to be rude."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45DarMaRude_000280c1_Oblivion_RESP1"
msgid ""
"Oh, well, I'm sorry for bothering you.  My mother often says I'm too forward "
"with strangers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAClavicusSpeech_000243ab_Oblivion_RESP1"
msgid ""
"Oh, well. Been good knowing you, kid. Back to being His Hound for me. As for "
"you... good luck, I guess. I've met worse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Decline_0001dc2e_Oblivion_RESP1"
msgid ""
"Oh, well... I, I understand. The danger is too great. You're right, you "
"should stay out of this. I'll just have to solve this myself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0007b320_Oblivion_RESP1"
msgid "Oh, what a delightful story! Brightens my day, it does."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004421f_Oblivion_RESP1"
msgid ""
"Oh, what a pretty colored moth you are! Don't fly into the city. There's a "
"big torch there. Bad news for little moths."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_000242f3_Oblivion_RESP1"
msgid "Oh, what's the matter? Is the baby gonna cry?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000411ff_Oblivion_RESP2"
msgid ""
"Oh, who am I kidding? More likely you came to scoff at the worst juggler in "
"the world."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06KellenQuestion_00002b09_Knights_RESP1"
msgid ""
"Oh, why he's a descendant of that very knight from so long ago. The curse has "
"affected his family all these years. He suffers from it now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08Choice2B_00027996_Oblivion_RESP1"
msgid ""
"Oh, wonderful! This is going to be such fun! So, any ideas where we should "
"begin searching first?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity10_00081e94_Oblivion_RESP3"
msgid ""
"Oh, yes, I have one of those... no, that's the one that I misplaced the other "
"day. I'd really like to replace it, but funds are so tight..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItem12_00082427_Oblivion_RESP1"
msgid ""
"Oh, yes, I've already shown you this shelf, haven't I? My poor old brain just "
"isn't what it used to be!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS43Scamps_0004f8ba_Oblivion_RESP1"
msgid ""
"Oh, yes. Don't bother trying to kill one of them. As soon as you do, another "
"will take its place. It's endless. Quite the curse, eh?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeatherleahTopic_00088b2f_Oblivion_RESP2"
msgid ""
"Oh, yes. I remember. I think it's directly south of Chorrol. Place was "
"overrun with ogres though. Nasty brutes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028865_Oblivion_RESP2"
msgid ""
"Oh, yes. We're not done. Not even close. This was only the first step. If "
"this town is to be ours again, we'll need to get inside the castle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE35EarilInitialHello_0008f7d5_Oblivion_RESP1"
msgid ""
"Oh, yes. You see, I am a student of chronomancy -- the magic of time "
"alteration."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0002d413_Oblivion_RESP1"
msgid ""
"Oh, yes. You still need that, don't you? Well, are you ready to take care of "
"that matter for me now?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03AReward_0007f3cf_Oblivion_RESP3"
msgid ""
"Oh, yes... of course. It seems a most unusual weapon was recovered from the "
"Orc warrior, Grommok."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034463_Oblivion_RESP1"
msgid "Oh, you again. What do you want?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38OddityDonate_00081ea2_Oblivion_RESP3"
msgid ""
"Oh, you are a sweetie. The museum hasn't been the same since this went "
"missing. It's so nice of you to donate it to the cause of Oddity."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS04Here_0003d30c_Oblivion_RESP1"
msgid ""
"Oh, you heard about that? We were trying to keep it quiet, but people in this "
"city are far too nosy. Very well, since you said you want to help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025034_Oblivion_RESP2"
msgid ""
"Oh, you just go talk to Raminus Polus at the Arcane University, and he'll "
"have things straightened out in no time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkDeadGeimund1_00002cee_Knights_RESP1"
msgid ""
"Oh, you know. My brother... Sir Geimund. I miss him, that's all. We've always "
"done everything together. It's hard to get used the fact that he's dead"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Victims_00081fdc_Oblivion_RESP1"
msgid ""
"Oh, you mean my research subjects? Don't trouble yourself with their fates. "
"They are volunteers, of one sort or another. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarMaTopic_000280a3_Oblivion_RESP1"
msgid ""
"Oh, you meant the Argonian wench.  Must've slipped my mind.  Yeah, she was "
"here.  Then she left.  I don't know nothin' else about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08Choice1B_000275c7_Oblivion_RESP1"
msgid ""
"Oh, you poor dear! Well, this does make things difficult for me. I want to "
"find the gold as much as anyone, but you need it so much more than I do!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00091aab_Oblivion_RESP1"
msgid "Oh, you poor dear."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08Choice7A_00085a69_Oblivion_RESP1"
msgid ""
"Oh, you think so? I mean, it is rather forward, but I like it! All right "
"then, I'll wait for him in his room upstairs! Oh, thank you, thank you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00038f39_Oblivion_RESP1"
msgid "Oh, you're back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThadonTopic_0001338a_Oblivion_RESP1"
msgid "Oh, you're helping him? Why didn't you say so?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f85f_Oblivion_RESP1"
msgid "Oh, you're no fun at all!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000175b8_Oblivion_RESP1"
msgid "Oh, you're still alive! I was worried!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003376b_Oblivion_RESP1"
msgid "Oh, you're such a sweetie!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00024fc9_Oblivion_RESP1"
msgid ""
"Oh, your guild privileges have been suspended. You should speak with Raminus "
"Polus at the Arcane University to rectify the situation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00080d07_Oblivion_RESP1"
msgid "Oh-ho!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark11Choice2C_00002dd3_Oblivion_RESP1"
msgid ""
"Oh-kaaay... Well then, I'm going to go about my business. And stop staring at "
"me, would ya? You're giving me the creeps!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FollowupNegative_00024239_Oblivion_RESP1"
msgid "Oh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FollowupPositive_00028ccb_Oblivion_RESP1"
msgid "Oh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NeutralReceive_0002954d_Oblivion_RESP1"
msgid "Oh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedNo_00037cf9_Oblivion_RESP1"
msgid "Oh. All right then. Let me know if you change your mind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity12_00081ea8_Oblivion_RESP3"
msgid "Oh. Another Mute Screaming Maw. I already have one of those on exhibit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG01Choice2B_0002d6eb_Oblivion_RESP1"
msgid ""
"Oh. Are you sure? Well, think about it, and if you change your mind, let me "
"know. I really do need some money, you see."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479e0_Oblivion_RESP2"
msgid ""
"Oh. Did I say that out loud? Excuse me. I'm Weebam-Na, the hunter. You got to "
"excuse me. I got rats on the mind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003aa9a_Oblivion_RESP1"
msgid "Oh. Hello."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MaglirTOPIC_0002428d_Oblivion_RESP1"
msgid ""
"Oh. Him. He's been around. Mostly at the West Weald staring at the bottom of "
"a flagon of ale."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05TarMeenaNoBooks_00024e85_Oblivion_RESP2"
msgid ""
"Oh. I was hoping to see if I was on the right track. Well, if you bring them "
"to me I may be able to help you with your puzzle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD03Choice1_0002d723_Oblivion_RESP1"
msgid ""
"Oh. I'm prepared, of course. I'm sure there's no need to speak to Mother at "
"all. Let's go."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0002b7ab_Oblivion_RESP1"
msgid "Oh. If that's the way you feel."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003150d_Oblivion_RESP1"
msgid "Oh. It's Valga's errand boy! How goes the 'big important investigation'?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000363ba_Oblivion_RESP1"
msgid "Oh. It's you again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00035744_Oblivion_RESP1"
msgid "Oh. It's you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0015974c_Oblivion_RESP1"
msgid "Oh. It's you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopicDarJee01_000479b1_Oblivion_RESP1"
msgid "Oh. No sense of humor? Your loss."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopicFalanu01_00038aa2_Oblivion_RESP1"
msgid "Oh. Nothing. I was just wondering."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36Choice1LootNo_00061c43_Oblivion_RESP1"
msgid ""
"Oh. Really? Look. I'm in desperate need of a champion, a hero. Are you brave "
"and fearless?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0002b7ad_Oblivion_RESP1"
msgid "Oh. Sorry to bother you."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_LeyawiinTopicDecentius01_000479f1_Oblivion_RESP1"
msgid "Oh. Sorry. The old memory is not what it used to be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS39NotSeen_0004ed75_Oblivion_RESP1"
msgid "Oh. Suit yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39SpoonChoice1_000781fa_Oblivion_RESP1"
msgid "Oh. Thank you. I thought you might be one of Cindanwe's hired thugs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46Decline_000319d4_Oblivion_RESP1"
msgid ""
"Oh. That's a shame. I don't see how three farmers can fight a whole tribe of "
"goblins, but I'm sure we'll figure something out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItem10_0008242b_Oblivion_RESP1"
msgid ""
"Oh. That's strange, I thought there was something else here... well, no "
"matter. Just losing my mind or something! Right this way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG01Choice3B_00009296_Oblivion_RESP1"
msgid "Oh. Well, I guess I can do that. I'll see you there, then... I hope."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE41PostnoHere_0008f9c5_Oblivion_RESP1"
msgid "Oh. Well, do hurry. I'm beginning to feel faint."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE41PostNo_0008f9c2_Oblivion_RESP1"
msgid ""
"Oh. Well, hopefully I'll still be alive by the time you change your mind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopicDarJee03_000479b3_Oblivion_RESP1"
msgid "Oh. Well. I heard lots of others, only I can't remember them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark11Choice1C_00002dba_Oblivion_RESP1"
msgid ""
"Oh. Well... all right, then. I guess I'll be going about my business. Goodbye."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE35EarilInitialHello02_0008f7d6_Oblivion_RESP1"
msgid "Oh. What a pity. Well, then."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14ChoiceHeardYes_0018bc2a_Oblivion_RESP1"
msgid ""
"Oh. Yes, of course you're right. I shouldn't be telling stories when he could "
"be in danger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JauffreTopic_000223ce_Oblivion_RESP1"
msgid "Oh. Yes. He'll be in the Priory House somewhere."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033781_Oblivion_RESP1"
msgid "Oh. Yes. How do you do?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00009264_Oblivion_RESP1"
msgid "Oh. You again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003a90c_Oblivion_RESP1"
msgid "Oh. You... Hi."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002fbb4_Oblivion_RESP1"
msgid ""
"Oh... Hi. Hi again. You're the one who... who was going to bring me some "
"skooma. To be my friend. Yeah... I remember you... now..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity1_00043415_Oblivion_RESP3"
msgid ""
"Oh... I already have something in the Museum very similar. But don't give up, "
"I'm sure something truly Odd will turn up soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RaynilDralasTopic_00038af4_Oblivion_RESP1"
msgid "Oh... I see."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEChaliceofReversal_00013385_Oblivion_RESP3"
msgid ""
"Oh... I see. How brilliant of him. This is for you as much as it is for him. "
"Oh, very good Thadon!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38DeadInProgress_00083806_Oblivion_RESP1"
msgid "Oh... I see. Then it was you that... "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23HelpNo_00094c43_Oblivion_RESP1"
msgid ""
"Oh... I see. Well, if you change your mind, come see me and I can fill you in "
"on the details. Please, reconsider soon... I'm worried about him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalk3_00002bb6_Knights_RESP1"
msgid ""
"Oh... I see... If you really think this is the proper course of action... "
"Where do you suggest we begin?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d8f_Oblivion_RESP1"
msgid "Oh... I suppose I can make the effort to talk to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47AleswellInvisible_0003003d_Oblivion_RESP4"
msgid "Oh... Really? Everyone in town?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalk1_00002ba6_Knights_RESP1"
msgid "Oh... Very well, but please, be quick. My duties..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0006eaa0_Oblivion_RESP1"
msgid "Oh... hello."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008f107_Oblivion_RESP1"
msgid "Oh... hello."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark06Choice1B_0002fbaf_Oblivion_RESP1"
msgid ""
"Oh... okay. Well... You get me some skooma, and then we'll... be good "
"friends. Okay? Okay... Nordinor.. In Bravil... He sells it... Late at "
"night... "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS39No_0004e943_Oblivion_RESP1"
msgid "Oh... very well. If you change your mind, I'll be around."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaBetChoice3C_0002a9ef_Oblivion_RESP1"
msgid ""
"Oh... well... it would seem you don't have the 100 gold required to place a "
"bet. Best come back when you've got enough coin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaBetChoice3A_0002a99f_Oblivion_RESP1"
msgid ""
"Oh... well... it would seem you don't have the 25 gold required to place a "
"bet. Best come back when you've got enough coin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaBetChoice3B_0002a9a2_Oblivion_RESP1"
msgid ""
"Oh... well... it would seem you don't have the 50 gold required to place a "
"bet. Best come back when you've got enough coin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark06Choice1A_0002fbb0_Oblivion_RESP5"
msgid ""
"Oh... yeah... his house is in the... um... Elven Gardens District. So yeah... "
"maybe I'll see you there... my new friend! He he. Goodbye... my friend!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NeutralReceive_000241eb_Oblivion_RESP1"
msgid "Oh?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09RebuildCommand_0001356c_Oblivion_RESP1"
msgid "Oh? Does he now?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD04Choice1_0002ee6b_Oblivion_RESP1"
msgid ""
"Oh? I know you're the one who ratted me out to Oreyn about that other "
"contract. Go back to Oreyn. Give him my regards. We're done talking. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39SpoonChoice2_000781fb_Oblivion_RESP1"
msgid ""
"Oh? Then she must really trust you. Still, I better hold onto it. Just in "
"case."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Choice1_0002c7be_Oblivion_RESP1"
msgid ""
"Oh? We must? Well, last I saw, you didn't outrank me, Apprentice. I suggest "
"you mind your manners... and your own business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Choice1_0002c7c9_Oblivion_RESP1"
msgid ""
"Oh? We must? Well, last I saw, you didn't outrank me, Associate. I suggest "
"you mind your manners... and your own business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Choice1_0002c7bd_Oblivion_RESP1"
msgid ""
"Oh? We must? Well, last I saw, you didn't outrank me, Journeyman. I suggest "
"you mind your manners... and your own business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Choice1_0002c7ba_Oblivion_RESP1"
msgid ""
"Oh? We must? Well, last I saw, you didn't outrank me, Protector. I suggest "
"you mind your manners... and your own business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Choice1_0002c7bc_Oblivion_RESP1"
msgid ""
"Oh? We must? Well, last I saw, you didn't outrank me, Swordsman. I suggest "
"you mind your manners... and your own business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_0006445b_Oblivion_RESP1"
msgid ""
"Ohh! He's that wanted criminal. Isn't he a master thief? I hear he's "
"dangerous, too. I've heard that the beggars spy for him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434bd_Oblivion_RESP1"
msgid "Ohhh, the big strong adventurer killed the Gatekeeper. How interesting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002f08d_Oblivion_RESP1"
msgid ""
"Ohhh... I'm a bit stiff, but quite fine otherwise. Ah yes, the Undercroft. My "
"family members are buried here, you know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_001885e0_Oblivion_RESP1"
msgid "Ohhhh... what am I to do? They're gone... all gone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003dfbe_Oblivion_RESP1"
msgid ""
"Ohtesse is a wonderfully gifted healer. I sometimes worry that she spends too "
"much time taking care of others, and not enough on herself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalNQDResponses_0003e982_Oblivion_RESP1"
msgid ""
"Ohtesse is the most dedicated person I know. She really needs to take better "
"care of herself, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0003de54_Oblivion_RESP1"
msgid "Ohtesse works constantly. Don't you worry about her sometimes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e8b8_Oblivion_RESP1"
msgid ""
"Ohtimbar, Fighters Guild Guardian. Maybe you saw me in the Arena, couple "
"years ago? I was a contender."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TestToddNeutral_00028309_Oblivion_RESP1"
msgid "Ok, I feel normal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS04FinalNo_0003d4ac_Oblivion_RESP2"
msgid "Ok, girls! We got someone who doesn't want to cooperate!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_0001c284_Oblivion_RESP1"
msgid ""
"Okay Brawler, you know the drill. Head up to that Arena and show 'em who's "
"boss!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG01Choice2A_0002d6ea_Oblivion_RESP1"
msgid ""
"Okay then. I'll just take this gold from you, and I'll head out there right "
"now. No one should even know I'm gone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_0003b34b_Oblivion_RESP1"
msgid ""
"Okay then. It's upstairs, the room at the west end of the hall. That's to "
"your right when you come out the door. Enjoy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_000b1244_Oblivion_RESP1"
msgid "Okay then. Room number one, right next to the entrance. Sleep well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_0002b1e3_Oblivion_RESP1"
msgid ""
"Okay, Hero. This next opponent is a High Elf wizard, a master in the school "
"of Destruction. But wait, it gets worse..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG17ChoicePositionB_00015206_Oblivion_RESP1"
msgid "Okay, I'll go over there now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG17ChoicePositionB_00015452_Oblivion_RESP1"
msgid "Okay, I'll go over there now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG17ChoicePositionA_0001544f_Oblivion_RESP1"
msgid "Okay, I'll head over there now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG17ChoicePositionA_00015207_Oblivion_RESP1"
msgid "Okay, I'll head over there now. Let me know when everyone else is ready."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG17ChoiceNM_00015205_Oblivion_RESP1"
msgid "Okay, I'll just wait here until you tell me what to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36Choice8Reward_00061c50_Oblivion_RESP3"
msgid ""
"Okay, I'm going to pretend everything is normal. Make your move as soon as "
"you can. But, let me get away first so I don't know it's coming."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00061c3a_Oblivion_RESP1"
msgid ""
"Okay, I'm going to pretend everything is normal. Make your move as soon as "
"you can. But, let me get away first. Don't let me see it coming."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_0002c34b_Oblivion_RESP1"
msgid ""
"Okay, based on your abilities, here are your choices. Do you want to fight "
"one Bear, two Minotaurs, or one Bear and two Minotaurs?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_0002c338_Oblivion_RESP1"
msgid ""
"Okay, based on your abilities, here are your choices. Do you want to fight "
"one Boar, one Boar and one Wolf, or two Wolves and one Goblin Skirmisher? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_0002c33d_Oblivion_RESP1"
msgid ""
"Okay, based on your abilities, here are your choices. Do you want to fight "
"one Goblin Berserker, two Trolls, or two Goblin Berserkers and one Troll?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_0002c351_Oblivion_RESP1"
msgid ""
"Okay, based on your abilities, here are your choices. Do you want to fight "
"one Ogre, two Ogres, or two Ogres and a Land Dreugh?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG17ChoicePositionB_00015450_Oblivion_RESP1"
msgid ""
"Okay, but remember. I'm not so good at close combat - you'll have to watch "
"out for me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG17ChoicePositionA_00015454_Oblivion_RESP1"
msgid "Okay, but that puts me farther away from the group."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003b1d7_Oblivion_RESP3"
msgid ""
"Okay, do... Do you want a Heavy Raiment of Valor or a Light Raiment of Valor? "
"Your choice!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36Choice2HelpYes_00061c44_Oblivion_RESP1"
msgid ""
"Okay, great. I was starting to worry. There's a... a simple task. Yes, a "
"simple task that you must perform"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGWait_00009295_Oblivion_RESP1"
msgid "Okay, if you say so."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedNo_0003ab58_Oblivion_RESP1"
msgid "Okay, it's your gold."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RulesOfCompetition_00038b37_Oblivion_RESP3"
msgid ""
"Okay, listen up. There are no disqualifications in a Grand Champion match. "
"That means you can wear whatever armor you damn well please."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479ea_Oblivion_RESP1"
msgid ""
"Okay, okay! I'll tell you! It is so great! I sneak into people's houses, take "
"things off their tables and shelves, and put them into barrels!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08ShowEntrance_000983aa_Oblivion_RESP1"
msgid ""
"Okay, okay, I'll show you. But only because you are my dear friend. Follow me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05MazaddhaSpare1_00081189_Oblivion_RESP1"
msgid ""
"Okay, okay. I'll get the names, and then you'll see. It will be worth it, I "
"promise you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_00028238_Oblivion_RESP1"
msgid ""
"Okay, so I don't like Matilde. What makes you think I like you any better? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000164ca_Oblivion_RESP1"
msgid ""
"Okay, so you can fight. Your new title is Bloodletter. You're gettin' into "
"the real game now, kid. More gold for more blood. Don't disappoint me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001dc4d_Oblivion_RESP1"
msgid ""
"Okay, so you did it again. What do you want from me, a hug? Take your gold "
"and get out of my face, Pit Dog."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017696_Oblivion_RESP1"
msgid ""
"Okay, so you killed the Breton. Don't get a big head. Here's your payout."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00027775_Oblivion_RESP1"
msgid ""
"Okay, so you're not a complete loser. Don't get cocky. Let me know when "
"you're ready for a match and you can prove yourself to me some more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice3A_000242aa_Oblivion_RESP1"
msgid "Okay, we'll keep following you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice3B_000242ab_Oblivion_RESP1"
msgid "Okay, we'll wait here. Just let us know when it's safe to proceed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_translation_0005401f_Oblivion_RESP1"
msgid "Okay, what do you need translated?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000945e_Oblivion_RESP1"
msgid ""
"Okay, you lead from here. Hopefully we can make it to the basement without "
"too much fighting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FollowupPositive_00024228_Oblivion_RESP1"
msgid "Okay."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033b41_Oblivion_RESP1"
msgid "Okay."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG10ChoiceNM_00091c73_Oblivion_RESP1"
msgid "Okay."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003cf8f_Oblivion_RESP1"
msgid "Okay. Guess who I am. Caenlorn? Or Maenlorn?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02OrcCaptainToPlayer_00018fc7_Oblivion_RESP1"
msgid "Okay. Hand over those keys or die!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PayGoldforCrime_00028cea_Oblivion_RESP1"
msgid ""
"Okay. Here's the procedure. We go to the castle. First we search you, "
"confiscate any stolen goods. Then you pay your fine, and we release you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingH2HYes_0006245b_Oblivion_RESP1"
msgid ""
"Okay. If I see you reach for a weapon, I'm calling it off. And if you can "
"actually hurt me, I'll tell you to stop."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_LeyawiinTopicDecentius02_000479f2_Oblivion_RESP1"
msgid "Okay. Just being friendly..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerStatus_000241fe_Oblivion_RESP1"
msgid "Okay. You?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005c0db_Oblivion_RESP1"
msgid "Okay..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03GrommokC1Idle01_0008ea79_Oblivion_RESP1"
msgid "Okay... this has to be a joke."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BrumaNQDQuestionResponses_0004658d_Oblivion_RESP1"
msgid "Olav makes everyone feel welcome."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004657e_Oblivion_RESP1"
msgid "Olav's Tap and Tack is a good, inexpensive place for travelers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00025295_Oblivion_RESP1"
msgid ""
"Old Baenlin is dead! I hear it was a horrible accident. He was resting in his "
"chair and BOOM -- a stuffed head fell on him!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c25d_Oblivion_RESP1"
msgid ""
"Old Glarthir is a bit out of his mind, I think. He's convinced everyone is "
"out to get him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0008c217_Oblivion_RESP1"
msgid "Old Tamriel still has some fight left in her!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001482f_Oblivion_RESP1"
msgid "Old friend!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00048914_Oblivion_RESP1"
msgid ""
"Old, worn, and wicked. Wet, wounded, and wild. Empty as the eastern horizon, "
"dusk on the Niben. Solemn and bitter as the grave."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479d4_Oblivion_RESP1"
msgid "Oleed-Ei, Blackwood Company Master-of-Assassins. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00000812_AltarESPMain_RESP1"
msgid ""
"Oleta was the most gifted healer I've ever known. If anyone can teach you "
"more, she can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_000613a8_Oblivion_RESP1"
msgid ""
"Oleta was the most gifted healer I've ever known. If anyone can teach you "
"more, she can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000465a9_Oblivion_RESP1"
msgid ""
"Olfand really has his hands full with Skjorta. I don't know how he has time "
"for business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bcbc_Oblivion_RESP1"
msgid ""
"On Cyrodiil's northern border is the sparsely populated mountain wilderness "
"called the Valus Mountains."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00094eba_Oblivion_RESP1"
msgid ""
"On behalf of the entire town, I thank you for ridding Rosentia of the scamps."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c339_Oblivion_RESP4"
msgid "On behalf of the people of Cheydinhal, I thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c34a_Oblivion_RESP6"
msgid "On behalf of the people of Cheydinhal, I thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13SignetYes_000335ad_Oblivion_RESP2"
msgid ""
"On second thought, you keep it. You were the last to travel with him, and I "
"feel you deserve it as a memento of your achievement."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG13CavernChoiceWhy_000039b4_Oblivion_RESP2"
msgid ""
"On some level, they're aware of my presence. Whether they covet all that I "
"have, or simply wish to see it destroyed, I do not know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004300a_Oblivion_RESP2"
msgid "On the other hand... you have different fingers. Oh ho ho ho!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark02FinChoice1A_00023e48_Oblivion_RESP2"
msgid ""
"On the second floor is a secret door leading to a crawlspace. Inside are the "
"fastenings of a mounted head that hangs over Baenlin's favorite chair."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000093b2_Oblivion_RESP1"
msgid "On through you go."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008608a_Oblivion_RESP1"
msgid "On your belly, nikyn!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000477e9_Oblivion_RESP1"
msgid ""
"On-Staya Sundew. Castle Leyawiin's steward. And chief advisor to Count Marius "
"Caro. In theory..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_000513be_Oblivion_RESP1"
msgid ""
"Once I can see J'skar again, I'd be more than happy to write a recommendation "
"for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11TalkToMillona09_0007ba9c_Oblivion_RESP1"
msgid ""
"Once I donned the cowl, no-one in all of Tamriel could recognize me. With the "
"cowl I became the Gray Fox. Without it, I was a stranger, even to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CureforVampirism_000977dc_Oblivion_RESP1"
msgid ""
"Once I have all the ingredients I need, I'll fashion a cure for you. This is "
"a delicate matter, and cannot be rushed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07GreymarchTopic_000910fc_Oblivion_RESP2"
msgid ""
"Once I'm gone, things usually get bad quickly. Lots of defections. Lots of "
"carnage. But with you at the helm, things will be different!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00041202_Oblivion_RESP1"
msgid "Once I've perfected my act, I'll be the toast of the Realm!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DragonfiresTopic_00037834_Oblivion_RESP3"
msgid ""
"Once Martin uses the Amulet of Kings to light the Dragonfires, the barriers "
"between Oblivion and Tamriel will be restored."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08FinChoice2B_00032bea_Oblivion_RESP5"
msgid ""
"Once Phillida is dead, sever his finger, the one that bears an Imperial "
"Legion signet ring! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08FinChoice2C_00032beb_Oblivion_RESP5"
msgid ""
"Once Phillida is dead, sever his finger, the one that bears an Imperial "
"Legion signet ring! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08FinChoice2A_00032be9_Oblivion_RESP5"
msgid ""
"Once Phillida is dead, take the very finger from his corpse, the one that "
"bears an Imperial Legion signet ring! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_IngredientCollection_000aef8d_Oblivion_RESP3"
msgid ""
"Once a week, place a single ingredient in the chest. After twenty-four hours, "
"you'll find a sizable quantity of the ingredient available for use."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00009c7c_Oblivion_RESP6"
msgid ""
"Once a week, you must visit the statue. Talk to it. You will be presented "
"with a list of names and locations.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00014440_Oblivion_RESP1"
msgid "Once again has the Ritual of Accession come full circle!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00016ea6_Oblivion_RESP1"
msgid "Once again has the Ritual of Accession come full circle!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007dbfe_Oblivion_RESP1"
msgid "Once again has the Ritual of Accession come full circle!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007dbff_Oblivion_RESP1"
msgid "Once again has the Ritual of Accession come full circle!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13JyggalagVoice_0009604c_Oblivion_RESP1"
msgid "Once again, Jyggalag walks!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ef1_Oblivion_RESP1"
msgid ""
"Once again, Syl uses pain to get what she wants. How long before every one of "
"us is forced to visit Herdir's chamber?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000441d5_Oblivion_RESP1"
msgid "Once again, the Great Torch burns bright as Arden-Sul foretold."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ee5_Oblivion_RESP1"
msgid ""
"Once again, the Lady Syl strikes hard among her own. Her paranoia hasn't "
"faded, in fact it's greatly grown."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00031607_Oblivion_RESP1"
msgid "Once again, we meet."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028792_Oblivion_RESP1"
msgid ""
"Once an Imperial Legion bulldog, always an Imperial Legion bulldog. I've seen "
"his kind before. He cares about laws and regulations... not people."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13JyggalagSpeech_000635c9_Oblivion_RESP1"
msgid ""
"Once each era, I was allowed my true form, conquering this world anew. And "
"each time I did, the curse was renewed, damning me to exist as Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND09ProphetQuestions02_00002c14_Knights_RESP4"
msgid ""
"Once his spirit is destroyed, he will be completely obliterated -- erased "
"from all realms of existence."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkVampChoice1_000008de_Oblivion_RESP4"
msgid ""
"Once infected with vampirism, you must wait three days and then sleep once "
"more. Then the Dark Gift will truly take hold. Sleep now, and awake anew!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkVampChoice1_0004ce45_Oblivion_RESP4"
msgid ""
"Once infected with vampirism, you must wait three days and then sleep once "
"more. Then the Dark Gift will truly take hold. Sleep now, and awake anew!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08CommanderPlan3_00018c88_Oblivion_RESP3"
msgid ""
"Once inside, search for the source of the Spire's power. It must be "
"underground somewhere. Once you find it, destroy it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08CommanderPlan3_00018c89_Oblivion_RESP3"
msgid ""
"Once inside, search for the source of the Spire's power. It must be "
"underground somewhere. Once you find it, destroy it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434d6_Oblivion_RESP1"
msgid "Once more the Isles are protected by the will of Arden-Sul."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG07ChoiceKaltharWhy_0003378f_Oblivion_RESP3"
msgid ""
"Once she helped me advance out of that place, and stepped down, then she "
"could have it back! Why did you have to get in the way?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06HelpDefend_000131b5_Oblivion_RESP3"
msgid ""
"Once the Aureals are destroyed, I will light the Flame of Agnon for you. Will "
"you help us defend the Altar of Despair?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06FlameAgnon_0003e6a5_Oblivion_RESP4"
msgid ""
"Once the Aureals are routed from the Altar of Rapture, I will be most pleased "
"to command my soldiers to light the Flame for Sheogorath's glory."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00030207_Oblivion_RESP5"
msgid ""
"Once the mage has revealed himself, we will step in and settle the matter "
"quickly. Now, get yourself some sleep. You'll need to be well-rested."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004f220_Oblivion_RESP5"
msgid ""
"Once the mage has revealed himself, we will step in and settle the matter "
"quickly. Now, get yourself some sleep. You'll need to be well-rested."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12HaskillGreetB1_00016d01_Oblivion_RESP2"
msgid "Once the source of Madness becomes the Font of Order, Jyggalag has won."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06UlfriGreetA2_000131b3_Oblivion_RESP2"
msgid ""
"Once the strength of the Aureals is shattered, I will be honored to light the "
"Flame as my Lord Sheogorath commands."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06FlameAgnon_000131b4_Oblivion_RESP4"
msgid ""
"Once their main force is destroyed, with your help, we can easily take "
"Rapture from the few survivors. Then, I will gladly kindle the Flame for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDEightAndOneTopic_00002c8d_Knights_RESP2"
msgid ""
"Once there were Eight Divines. Then Tiber Septim became Talos and the Eight "
"became Nine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture5_0007195d_Oblivion_RESP1"
msgid ""
"Once these ancient monuments might have been powerful bulwarks of the "
"Cyrodilic emperors, battlemages, and priests."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06UlfriGreetA1_000131b2_Oblivion_RESP2"
msgid ""
"Once they break themselves on our defenses, Cylarne will be ours, a gift for "
"our Lord Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026ea7_Oblivion_RESP4"
msgid ""
"Once they've seen how it's done, they should be able to handle any new gates "
"on their own."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07RitualNoD_0001365f_Oblivion_RESP4"
msgid ""
"Once this is done, I can pronounce the heart-bearer a Duke or Duchess. Then, "
"all that is required is the blessing of our lord, Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07RitualNoM_00013661_Oblivion_RESP6"
msgid ""
"Once this is done, I will proclaim the successor a Duke or Duchess. Then, "
"Sheogorath gives His blessing, and the cycle is completed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06FlameAgnon_00012cc8_Oblivion_RESP4"
msgid ""
"Once we capture the Altar of Despair from the Mazken, it will be my great "
"honor to light the Flame for Lord Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VahtacenTopic_00035f3c_Oblivion_RESP2"
msgid ""
"Once we figured out the pillar reacted to spells, we tried out a few. I think "
"I was only unconscious for an hour or so, but that was enough for me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AmuletofKingsTopic_0001efe4_Oblivion_RESP2"
msgid ""
"Once we have it back, Martin can use it to light the Dragonfires in the "
"Temple of the One, and reseal the barriers between Oblivion and our world."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11P4IsThatAll_0001fb71_Oblivion_RESP2"
msgid ""
"Once you are inside the palace itself, you need to find the reading room. The "
"blind priests will deliver a scroll to you there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Manor_00003a6c_Oblivion_RESP3"
msgid ""
"Once you buy, you get the key to the front door and the deed of ownership. "
"That's the deal. Would you like to buy it now?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Decision_0001e3ec_Oblivion_RESP1"
msgid ""
"Once you have decided which Duke to replace, there's no turning back. One "
"choice. No more, no less. Try not to do something stupid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG17GoOn_000366ed_Oblivion_RESP3"
msgid "Once you have it safely in your possession, return here immediately."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40RewardVampire_000a3df7_Oblivion_RESP2"
msgid ""
"Once you have the disease for several days, rest and let the effects take "
"hold. And please, be careful. Good luck."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000343f3_Oblivion_RESP1"
msgid ""
"Once you locate the Mythic Dawn's shrine to Mehrunes Dagon, we may have a "
"chance to recover the Amulet!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04SheoLearnWhat_00044f54_Oblivion_RESP3"
msgid ""
"Once you understand what My Realm is, you might understand why it's important "
"to keep it intact."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c13b_Oblivion_RESP1"
msgid ""
"Once you're rested and equipped, you should have Martin open the portal to "
"Camoran's Paradise immediately."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CastleGateTopic_00090ab5_Oblivion_RESP4"
msgid ""
"Once you've got it, get to the Guard House, find the passage, and open that "
"gate. Then we can get inside the castle and secure it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG05Choice1A_000224e4_Oblivion_RESP4"
msgid ""
"Once you've got the book, return it to me immediately. I assure you, it will "
"be worth your time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00030207_Oblivion_RESP2"
msgid ""
"Once you've rested here, you need to continue along the Gold Road, heading "
"east towards Kvatch."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004ed62_Oblivion_RESP1"
msgid "One Moderate Elixir of Exploration, coming right up!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElixirofExploration_0004e91b_Oblivion_RESP1"
msgid ""
"One Strong Elixir of Exploration for you... and many more for sale if you "
"wish to buy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000296c_Knights_RESP1"
msgid "One can never be too proficient with a blade, wouldn't you say?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006dc25_Oblivion_RESP1"
msgid "One copy of the Black Horse Courier coming up. Gray Fox steals taxes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45BrethrenTopic_00028214_Oblivion_RESP1"
msgid ""
"One day, you'll find out who the Brethren are, and you'll be sorry.  Oh yes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateVoice_00085492_Oblivion_RESP1"
msgid "One down!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03AInstExplainChoices_00018dfd_Oblivion_RESP1"
msgid ""
"One is physically harmful... usually lethal traps or creatures... something "
"relished by the residents of Dementia."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003378d_Oblivion_RESP1"
msgid "One last time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02GatesOfMadness_0007eae7_Oblivion_RESP1"
msgid "One leads to Mania, one to Dementia. Two shades of madness."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02GatesOfMadness_0008e4ce_Oblivion_RESP1"
msgid ""
"One leads to the lands of Mania, and one to Dementia. The Gatekeeper makes "
"sure no one gets in who isn't supposed to."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081ddf_Oblivion_RESP2"
msgid ""
"One leads to the lands of Mania. The other to Dementia. Enter through either "
"one. The lands are quite distinct, but both are Sheogorath's domain."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_000281a0_Oblivion_RESP1"
msgid ""
"One less Dark Elf in the world. And now there's one less person to find the "
"gold, as well. It's a good day, don't you think?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028cdb_Oblivion_RESP1"
msgid ""
"One less Nord in the world is something I'd normally cheer about, but the "
"fact that he was murdered by a fellow guest does put a damper on things."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_00049932_Oblivion_RESP1"
msgid "One man's trash soon becomes another man's trash, I suppose."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00015df9_Oblivion_RESP1"
msgid "One more coin and I can git a pair of shoes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46DoublesTopic_00081ed0_Oblivion_RESP1"
msgid "One more corpse! Well done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017660_Oblivion_RESP1"
msgid ""
"One more match is all you need to advance again, up to Gladiator rank. Most "
"combatants never make it that far. But you are the exception, aren't you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000432ad_Oblivion_RESP1"
msgid "One more room to go."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01Armand6_0005143f_Oblivion_RESP1"
msgid ""
"One more thing. You cannot kill each other during this trial. We may be "
"thieves, but we're not murderers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_00047716_Oblivion_RESP1"
msgid ""
"One must be very careful in the Imperial City. There are things... dangerous "
"things... that cannot abide the light."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02JauffreD3_0001e74c_Oblivion_RESP2"
msgid ""
"One night Uriel called me in to his private chambers. A baby boy lay sleeping "
"in a basket. Uriel told me to deliver him somewhere safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_000039e1_Oblivion_RESP1"
msgid ""
"One of my dear friends was killed while trying to kill Phillida, several "
"years ago. He was twice the assassin you are! Your are doomed to failure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SpeakerTopic_000bba99_Oblivion_RESP2"
msgid ""
"One of my duties is to find exceptional individuals, such as yourself, and "
"offer a place within our family."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04ChaliceNo_00013309_Oblivion_RESP2"
msgid ""
"One of my favorite toys. Does wonders for creativity. Well, not by itself, "
"but it helps. Those Elytra, clever little bugs that they are."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08CommanderPlan1_00018c82_Oblivion_RESP3"
msgid ""
"One of my scouts reported that the ruins have been opened recently and a "
"number of these Knights are now guarding the entrance. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08CommanderPlan1_00018c83_Oblivion_RESP3"
msgid ""
"One of my scouts reported that the ruins have been opened recently and a "
"number of these Knights are now guarding the entrance. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FathisUlesTopic_0002ba53_Oblivion_RESP1"
msgid ""
"One of the Gray Fox's top bosses, they say. Spends all day drinking at the "
"Oak and Crosier, but he's been asking questions about the Jemanes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Seen_0001a7e1_Oblivion_RESP1"
msgid "One of the Madgod's minions!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e15_Oblivion_RESP1"
msgid ""
"One of the afternoon watch, and all's well. I hope I see you well, ma'am. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023ec2_Oblivion_RESP1"
msgid "One of the afternoon watch, and all's well. I hope I see you well, sir. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00064450_Oblivion_RESP1"
msgid "One of the castle staff was murdered trying to stop a thief."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_0003335c_Oblivion_RESP1"
msgid ""
"One of the guards owes me a favor, you know. I could get us put in the same "
"cell. Would you like that? You should have some fun before the end."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDSirBerichTopic_00002c7b_Knights_RESP1"
msgid ""
"One of the mightiest knights of my day. It was a great boost to the Order's "
"prestige when he joined."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e42_Oblivion_RESP1"
msgid "One of the night watch, and all's well. Take care, ma'am. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023fa2_Oblivion_RESP1"
msgid "One of the night watch, and all's well. Take care, sir. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11DyusChoice2_00014b5a_Oblivion_RESP2"
msgid ""
"One of the oldest trees, named the Tree of Shades, lies in the halls of "
"Milchar. Milchar is a place of ruin, root, and mania."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BaurusTopic_0006b83d_Oblivion_RESP1"
msgid ""
"One of the youngest Blades ever to serve in the Emperor's personal guard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS08AleronHunt_0001fdbc_Oblivion_RESP3"
msgid ""
"One of them will have the key to the door. That's Kurdan's rules. It's the "
"only way we can win."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00040cb1_Oblivion_RESP1"
msgid ""
"One of your military minions was looking for you. It sounded urgent, but I'm "
"afraid I don't know the details."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c9bb_Oblivion_RESP1"
msgid ""
"One place is pretty much like another. Regner hates it, but Regner hates "
"everything."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture1_00071945_Oblivion_RESP1"
msgid ""
"One theory is that the stones were once magical, but they have lost their "
"magic, either through age and disuse, or because of sin or neglect."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028beb_Oblivion_RESP2"
msgid ""
"One thing I do know is that the killer won't just stop with two. They never "
"do. You and I, we need to watch each other's backs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11Tree_0008f12b_Oblivion_RESP5"
msgid ""
"One thing that is not in dispute is that the Tree has survived for eons and "
"its branches are highly valued as components of magical artifacts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGFence01_000165e8_Oblivion_RESP1"
msgid ""
"Ongar lives in Bruma. He doesn't have much money, but he's the only place you "
"can sell hot property if you are new to the Thieves Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c9b0_Oblivion_RESP1"
msgid ""
"Ongar the World-Weary, they call me. I've been everywhere, and done "
"everything. Now I'm settled down for a good long rest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09BribeBeggar_00015f1f_Oblivion_RESP2"
msgid ""
"Only Fathis can open the door to the tower, but there is supposed to be a "
"secret passage somewhere in the castle that leads him to his tower."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09FathisAren_00048972_Oblivion_RESP2"
msgid ""
"Only Fathis can open the door to the tower, but there is supposed to be a "
"secret passage somewhere in the castle that takes him to his tower."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06FlameAgnon_000131b4_Oblivion_RESP2"
msgid ""
"Only Sheogorath's immortal servants can kindle the Altars, and I am at my "
"Lord's command. But I only hold Despair... for the moment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk5_0006834b_Oblivion_RESP1"
msgid ""
"Only a fool would doubt the valor of the Blades, but I must ask the same of "
"you. Do not doubt my valor, do not doubt my resolve. I will not fail you."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE30ForgeAmberHammerMagic_000400c2_Oblivion_RESP1"
msgid "Only a real man can swing this hammer around."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BGreenmote_000167e3_Oblivion_RESP3"
msgid ""
"Only a select few, such as myself, know the Silo's location. However, we are "
"sworn to secrecy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Arden_0001f3ba_Oblivion_RESP4"
msgid "Only a true Demented can appreciate what it means to render his name."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDCrusadersRelicsTopic_00002a81_Knights_RESP2"
msgid ""
"Only a true knight can find them -- or even wield them. Sir Roderic will "
"surely succeed, if anyone can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDPilgrimageTopic_00002a9d_Knights_RESP2"
msgid ""
"Only a true knight wielding the Crusader's Relics can stop the evil that now "
"threatens us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDCrusadersRelicsTopic_00002a80_Knights_RESP6"
msgid ""
"Only a true knight, wielding the holy Relics of the Divine Crusader, has a "
"chance to defeat Umaril."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDUmarilTopic_00002bf8_Knights_RESP1"
msgid ""
"Only a true knight, wielding the holy Relics of the Divine Crusader, has a "
"chance to defeat Umaril."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebf3_Oblivion_RESP1"
msgid ""
"Only a true warrior could have accomplished this task. The Aureals shall sing "
"your story for eons to come."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11Tree_00014b5c_Oblivion_RESP3"
msgid ""
"Only after facing the truth will the Tree of Shades give up its branches to "
"you. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_goblins_00028887_Oblivion_RESP1"
msgid "Only good goblin is a dead goblin. I like dead goblins."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesGuildTopic_00062616_Oblivion_RESP1"
msgid ""
"Only mages who have gotten recommendations from all the local guild halls can "
"enter the Arcane University. It's a good policy, I think."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03GrommokC3Idle01_0008ea84_Oblivion_RESP1"
msgid "Only me left... fine. I'll show 'em."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_000be327_Oblivion_RESP1"
msgid ""
"Only one city has sent aid. My guardsmen are the best in Cyrodiil, but they "
"were never meant to be an army."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46Choice2_0008fab9_Oblivion_RESP1"
msgid ""
"Only one group can stick around. Either we Demented or those blasted Manics. "
"It's the only way we'll find any peace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018bc61_Oblivion_RESP1"
msgid ""
"Only one has a better mastery of locks than I. You need to speak to J'baana. "
"You can find him imprisoned at the Imperial Legion headquarters."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_000091bd_Oblivion_RESP1"
msgid "Only quality goods for sale here. What can I interest you in?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0001eee6_Oblivion_RESP1"
msgid "Only the Chosen will survive the Cleansing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077c48_Oblivion_RESP1"
msgid "Only the Demented can truly appreciate the Hunger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10JakBuried_0009deda_Oblivion_RESP2"
msgid ""
"Only the Earl has a key. I have been warned never to enter it, on pain of "
"death."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000237cf_Oblivion_RESP1"
msgid ""
"Only the finest wares to buy and barter at Northern Goods and Trades. I'm "
"Seed-Neeus, the proprietor. How can I help you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06FlameAgnon_0003e6a5_Oblivion_RESP3"
msgid ""
"Only the immortal servants of Sheogorath can kindle the Altars of Despair and "
"Rapture, which in turn feed the holy Flame of Agnon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06FlameAgnon_000131ac_Oblivion_RESP1"
msgid ""
"Only the servants of Sheogorath can light the Flame, by kindling the Altars "
"of Despair and Rapture which feed the Flame."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_lightthedragonfires_000223e4_Oblivion_RESP2"
msgid ""
"Only the true heir can light the dragonfires, and if he has the Amulet of "
"Kings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bcc5_Oblivion_RESP1"
msgid ""
"Only thing worse than an ogre is two ogres. Tough bastards, and spells seem "
"to bounce right off of 'em."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkTimeWound_00014e28_AltarDeluxe_RESP2"
msgid ""
"Only this relic would be powerful enough to pervert the Laws of Mundus to "
"this extent."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15ForbiddenGrotto_0003c80f_Oblivion_RESP2"
msgid ""
"Only those few wearing the Bands of the Chosen are allowed to leave the "
"Garden."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MartinB_0003782f_Oblivion_RESP3"
msgid "Only those of the Septim blood can wear the Amulet of Kings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15BandsOfChosen_00047363_Oblivion_RESP4"
msgid ""
"Only those wearing the Bands can enter the Forbidden Grotto. No one who "
"enters the Grotto ever returns."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15ForbiddenGrotto_00047361_Oblivion_RESP5"
msgid ""
"Only those wearing the Bands of the Chosen may enter the Forbidden Grotto. "
"But they never return, so we don't know what fate awaits them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS26ItiusAccuses_00093cd6_Oblivion_RESP1"
msgid "Only those who break the law."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028a0e_Oblivion_RESP1"
msgid ""
"Only three of us left, and one of us is a murderer. Do you expect me to "
"believe it's that sweet girl? You murdering scum! I'll kill you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002822b_Oblivion_RESP1"
msgid ""
"Only three of us left. I'm certainly no murderer, and I know it's not you. "
"That leaves one person! We must protect ourselves... find weapons!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002822a_Oblivion_RESP1"
msgid "Only three of us left... only three... "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008152a_Oblivion_RESP1"
msgid "Only you can eat the fruit of madness."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476d4_Oblivion_RESP1"
msgid ""
"Ontus Vanin, retired. Sleep late, and read trashy books. I don't keep up with "
"Mages Guild affairs any more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00028ab0_Oblivion_RESP1"
msgid "Oof!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00061c81_Oblivion_RESP1"
msgid "Oof!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008961d_Oblivion_RESP1"
msgid ""
"Ooh! I found a dead Gnarl, don't get to count those every day. Here, take "
"this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SERooftopCheer_00082742_Oblivion_RESP1"
msgid "Ooh! That's gotta hurt!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008152b_Oblivion_RESP1"
msgid "Ooh! You have a nice stick!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0006145d_Oblivion_RESP1"
msgid ""
"Ooh, a secret assignment, you say? Come on, can't you give your old pal Mraaj-"
"Dar a hint? Who do you have to kill? Anyone I know? Ha ha ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08Choice3B_0002798f_Oblivion_RESP1"
msgid ""
"Ooh, good idea! Maybe the chest is hidden under the floorboards! All right, "
"I'll head down there and start looking."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0000c0a6_Oblivion_RESP1"
msgid ""
"Ooh, using poision is so deliciously evil! I once poisioned my aunt's stew, "
"and she fell over dead with her face right in the bowl! Ha ha ha ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AssaultNoCrime_00062505_Oblivion_RESP1"
msgid "Oooh, I hope you know what you're doing..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033345_Oblivion_RESP1"
msgid ""
"Oooh, aren't you a fair lass. Your skin is so pale, so pure. And your body is "
"so... strong. Let me guess. A Nord, right?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PickpocketNoCrime_00062509_Oblivion_RESP1"
msgid "Oooh, you're good! He he he he he."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002d396_Oblivion_RESP1"
msgid "Ooohhh..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002f52e_Oblivion_RESP1"
msgid "Oooohhh..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029a7_Knights_RESP1"
msgid "Open the gate, please. I must get out of here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32FanaticYell_0001b707_Oblivion_RESP1"
msgid "Open the gates! Let in the horde!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008608d_Oblivion_RESP1"
msgid "Open wide!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Manor_00003a5a_Oblivion_RESP1"
msgid ""
"Opening the door seems to have stopped the ghost attacks. Perhaps I'll leave "
"you to the rest of this mission since my part is done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04WhatHappened_00019524_Oblivion_RESP1"
msgid ""
"Opposites repel, strangely enough. All that pleasure and pain locked away "
"now, as if it never happened."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11SheogorathChoice2_00014b68_Oblivion_RESP1"
msgid ""
"Optimism! How adorable! I love it! Even at the end, you make me laugh. I'm "
"lying. That wasn't funny at all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003630f_Oblivion_RESP3"
msgid ""
"Or he did, anyway. He told me he was leaving Anvil. I'm sorry, but that's all "
"I know!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007ac76_Oblivion_RESP3"
msgid "Or is there something else I can take from -- I mean, help you with?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e81_Oblivion_RESP2"
msgid ""
"Or rather, you did. Yes, that's it. *hic* Aren't you doing a job for me? You "
"should be off, then."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseBuyBravil_0004ed83_Oblivion_RESP4"
msgid "Or you could always eat off the floor... doesn't matter to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03AChamber_00018e5e_Oblivion_RESP3"
msgid ""
"Or, if you're feeling merciful, we can have the group terrorized by a "
"seemingly lowly Gnarl that instantly grows to twice their size!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAHircineChoice1_0001ec5f_Oblivion_RESP3"
msgid "Or, perhaps you will learn what it is to be the hunted."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_duties_000474fb_Oblivion_RESP2"
msgid "Or, perhaps you're ready for advancement."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03AChamber_00019847_Oblivion_RESP4"
msgid ""
"Or, we can create the illusion of the adventurer dying and his spirit rising "
"from his corpse. Good fun to be had for all!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03AChamber_00018ff1_Oblivion_RESP4"
msgid ""
"Or, you can fill the chamber with hundreds of keys and watch them frantically "
"search for the correct one. Always a crowd pleaser."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39CindanweChoice_000781fc_Oblivion_RESP2"
msgid ""
"Or, you could make her life so miserable that she leaves us alone. She needs "
"everything \"just so.\"  So, sneak into her house and wreck the place!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE01HaskillChoice7_000133e6_Oblivion_RESP2"
msgid ""
"Or, you may continue onward, through the door behind me. If you can pass the "
"Gates of Madness, perhaps the Lord Sheogorath will find a use for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_00091b41_Oblivion_RESP1"
msgid ""
"Orc named Mazoga says she's a knight. I doubt it. The Count wants it looked "
"into. Why don't you talk to him?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMalacathChoice1_0001ec3d_Oblivion_RESP1"
msgid ""
"Orcs are always welcome. But Malacath wants a present. Like Troll fat. And "
"only Troll fat."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMalacathSpeech_000579d0_Oblivion_RESP1"
msgid ""
"Orcs are smart. They know, you want something, you do what the Boss tells "
"you. So listen good..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624ca_Oblivion_RESP1"
msgid ""
"Orcs don't ride horses. They eat horses. And sometimes I think they're the "
"smart ones. Wait, maybe it's Dunmer who eat horses."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AThadonLeaves_000206c1_Oblivion_RESP1"
msgid ""
"Order approaches! It's taken the Fringe already! With Order clothes and Order "
"hats! And you speak of \"change\"?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008f585_Oblivion_RESP1"
msgid "Order has always proved the stronger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ef56_Oblivion_RESP1"
msgid ""
"Order has attacked Passwall. Probably brought horrible disease with them, as "
"well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607a6_Oblivion_RESP1"
msgid ""
"Order has been defeated. I'm glad that's over. Mama always said, \"The end of "
"the world only happens once.\" "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607a5_Oblivion_RESP1"
msgid "Order has been destroyed and we still stand! Joy and tidings to all!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10DyloraTopic_00017d0d_Oblivion_RESP2"
msgid ""
"Order has kept her hostage so that she cannot return to us and lead us. If we "
"can free her, she may know how best to defeat them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10StaadaTopic_00016b39_Oblivion_RESP2"
msgid ""
"Order has kept her hostage so that she cannot return to us and lead us. If we "
"can free her, she may know how best to defeat them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASheogorathSpeech_00095785_Oblivion_RESP1"
msgid ""
"Order is at our doorstep, yet you felt it necessary to offer some yarn to... "
"yourself. An interesting choice, to be sure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607d4_Oblivion_RESP1"
msgid ""
"Order is defeated! I think I actually feel a little better. No... I don't."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607a3_Oblivion_RESP1"
msgid "Order is defeated! Triumph for us all! Songs of gladness!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607a9_Oblivion_RESP1"
msgid "Order is defeated, and Sheer-Meedish is safe. Praise Sheogorath!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607df_Oblivion_RESP1"
msgid "Order is defeated, but the cats still prey on us all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607b5_Oblivion_RESP1"
msgid "Order is gone! They didn't leave anything interesting behind, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008dd5c_Oblivion_RESP1"
msgid "Order is restored."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13JyggalagVoice_000949e6_Oblivion_RESP1"
msgid "Order shall rule this world once more!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BSylLeaves_0003b821_Oblivion_RESP1"
msgid ""
"Order stands at our door. They've taken the Fringe! Did you even know? Do you "
"care? And you speak of \"change\"?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0001a36a_Oblivion_RESP1"
msgid "Order take you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0001a372_Oblivion_RESP1"
msgid "Order take you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0001a7f7_Oblivion_RESP1"
msgid "Order will rule this Realm! It is foreordained!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008ef2d_Oblivion_RESP1"
msgid "Order will rule this realm. It is foreordained."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0001a7fa_Oblivion_RESP1"
msgid "Order's purity protects me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081bf7_Oblivion_RESP4"
msgid "Order's time has come. The Greymarch is upon you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008f7d1_Oblivion_RESP5"
msgid "Order's time has come. The Greymarch is upon you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0004db8f_Oblivion_RESP1"
msgid "Order's victory is inevitable."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13CaptainGreetA3_0005e37c_Oblivion_RESP1"
msgid ""
"Order. An obelisk has activated just outside the Palace. I've ordered my "
"Aureals to engage the enemy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13CaptainGreetA1_0001a79d_Oblivion_RESP1"
msgid ""
"Order. An obelisk has activated just outside the Palace. I've ordered my "
"Mazken to engage the enemy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12HaskillGreetA2_00016cff_Oblivion_RESP1"
msgid ""
"Order. The taint appeared only a short time ago, but it has spread quickly. I "
"fear that soon we will all be serving a new master."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS31Wrath01Positive_0001525e_Oblivion_RESP1"
msgid ""
"Orders? Selene didn't tell me about this, and I don't remember her taking on "
"someone else to help us find the Golden Galleon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000459b4_Oblivion_RESP2"
msgid ""
"Ordinarily, we could clear this up with a token payment, but under the "
"circumstances, the peace of the Realm requires that I escort you away."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e5c_Oblivion_RESP1"
msgid ""
"Oreyn and the new master have saved the guild, sure enough. But we can't let "
"it go to their heads."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e64_Oblivion_RESP1"
msgid "Oreyn has a plan. Just keep your mouth shut, and stay away from Vilena."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e6c_Oblivion_RESP1"
msgid ""
"Oreyn is in a foul mood lately. I think he's just about out of patience with "
"Vilena and the whole Blackwood Company situation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e80_Oblivion_RESP1"
msgid ""
"Oreyn is pretty steamed up about Maglir. He can get expelled for that, can't "
"he?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e78_Oblivion_RESP1"
msgid ""
"Oreyn is trying to get Viranus out in the field, but Vilena keeps interfering."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e7b_Oblivion_RESP1"
msgid ""
"Oreyn says the new guy went down and sorted out the problem in Leyawiin. "
"Trouble like that is just making things worse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f369_Oblivion_RESP1"
msgid ""
"Orinthal, retired Assassin. Now I live here. Only Redguard here, "
"incidentally. An interesting fact, isn't it? I do enjoy facts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesGuildTopic_00062614_Oblivion_RESP1"
msgid ""
"Orintur doesn't like to brag, but no one can match the Reflect spells he can "
"cast. He might teach you one, if you're skilled enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGFence04_000165eb_Oblivion_RESP1"
msgid ""
"Orrin is a respectable fence, if there is such a thing. He's got a decent "
"amount of gold, but is a tough negotiator. Go to him instead of Luciana."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_0004891f_Oblivion_RESP1"
msgid ""
"Other Bravil trainers? City-Swimmer teaches Sneak. Dro'shanji teaches "
"Security. Varon Vamori teaches Speechcraft."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_00047646_Oblivion_RESP1"
msgid ""
"Other arcane trainers in the City? Just one. Dovyn Aren. In the Market "
"District. Basic instructor in Alteration."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture2_00071925_Oblivion_RESP1"
msgid ""
"Others assign the runestones to the Merethic or Early First Era, primarily on "
"the basis of their simple, even crude design and craft."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000c08d_Oblivion_RESP3"
msgid ""
"Others felt it appropriate to fight fire with fire, as it were. The Council "
"has shattered, and artifacts have been lost."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AncotarTopic_000301e9_Oblivion_RESP2"
msgid ""
"Others in the village are not so forgiving, though. I don't blame him for "
"keeping to himself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000498ce_Oblivion_RESP1"
msgid "Othrelos is a sneaky one. Kind of makes you wonder what he's up to."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004769a_Oblivion_RESP1"
msgid ""
"Othrelos. I'm a Sneak... Advanced Sneak, in fact. And I train Sneaks. No law "
"against it. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HorseInquiry_000545dd_Oblivion_RESP1"
msgid ""
"Our Bay horses are faster than the Paint horses and tougher than the "
"Chestnut. You'll be proud to own one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_0018d2f9_Oblivion_RESP1"
msgid ""
"Our Countess will never let Chorrol fall to the daedra! Oblivion Gates be "
"damned!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e89e_Oblivion_RESP3"
msgid ""
"Our Dark Elves left Morrowind to get away from the Church and State, and they "
"don't like it when Imperials get all holy and patriotic with them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark18Choice2C_00090794_Oblivion_RESP1"
msgid ""
"Our Dread Father foresaw your defeat of the traitor, here in this very crypt! "
"You have been chosen! You are to be my new Listener!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0b6_Oblivion_RESP1"
msgid ""
"Our Fighters Guild chapter here is big, primarily because we're a training "
"center, which earns us each a good living."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebc3_Oblivion_RESP1"
msgid ""
"Our Lady has given you a task. The blessings of the Webspinner be upon you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NightMother_000251f3_Oblivion_RESP1"
msgid ""
"Our Lady is surely an ancient and powerful elf. Someday, when I am Listener "
"of the Black Hand, I will look upon her beautiful and unholy form!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061c71_Oblivion_RESP1"
msgid "Our Lord cannot be gone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081dcf_Oblivion_RESP1"
msgid "Our Lord comes singing! Songs for Sheogorath!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f3fb_Oblivion_RESP1"
msgid ""
"Our Lord has His armies restored. They carry such wonderfully sharp blades."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_00061cb4_Oblivion_RESP1"
msgid "Our Lord has protected us once again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09HaskillXaselmNo_0004036d_Oblivion_RESP2"
msgid ""
"Our Lord is always acquainted with Sorceress Verenim's current whereabouts. "
"Her affections have caused Him unnecessary annoyance in the past."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000603a0_Oblivion_RESP1"
msgid "Our Lord is missing? Perhaps I should get his things. To keep them safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000605eb_Oblivion_RESP1"
msgid ""
"Our Lord is too scared to face the Greymarch, is he? Coward! Good riddance."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE09HaskillRelmynaVerenim_0004036b_Oblivion_RESP3"
msgid ""
"Our Lord took interest and brought her here, so Relmyna might continue her "
"work, free of those provincial notions of decency and morality."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f3eb_Oblivion_RESP1"
msgid "Our Lord's armies are at full strength. A toast to Our Lord!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061c68_Oblivion_RESP1"
msgid "Our Lord's armies will destroy these Knights."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OrderOfTalosTopic_00033dfd_Oblivion_RESP1"
msgid "Our Order works to spread the teachings and worship of the divine Talos."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JorundrTopic_00053278_Oblivion_RESP1"
msgid ""
"Our affairs are none of your business. I don't know who you are, and you "
"think I'm going to talk to you about my ex-lover?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetSpeechMQ_00002a63_Knights_RESP1"
msgid ""
"Our ancient enemy has returned, from the deeps of time, to exact his revenge "
"upon the gods."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22HighFane_0002c819_Oblivion_RESP2"
msgid ""
"Our arrangement was clear. I would pay you for delivering me the carving. "
"Since Maric delivered the carving, he earned the reward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001da4c_Oblivion_RESP1"
msgid "Our brother returns to the fold!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008da9b_Oblivion_RESP1"
msgid "Our business is done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00143f0b_Oblivion_RESP1"
msgid "Our business is done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008119b_Oblivion_RESP1"
msgid "Our child stands guard once again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15KathutetA_0003c80c_Oblivion_RESP1"
msgid "Our clan sacked your city of Kvatch... a trifling task fit for scamps."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005374b_Oblivion_RESP1"
msgid "Our conversations are done. There's nothing else to say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalk4_00002bba_Knights_RESP1"
msgid ""
"Our first step is informing the others, of course. The Knights of the Nine "
"must be one, in both voice and action. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEPinnacleRockTopic_00080d92_Oblivion_RESP1"
msgid "Our fortress and sanctuary here in the Shivering Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS49Choice1A_0002ad7d_Oblivion_RESP2"
msgid ""
"Our goal is the Castle gate. We should be able to use this door to get out to "
"the plaza in front of the Castle gatehouse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VampireTopic_0001d24b_Oblivion_RESP1"
msgid ""
"Our goal is to root out the vampires that live in our fair city. So far, "
"we've been unsuccessful finding one until now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0b4_Oblivion_RESP1"
msgid ""
"Our gracious Countess funds my research. I ward tame rats with resistance "
"spells, then shower them with elemental attacks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDKnightsTopic_00002bdb_Knights_RESP1"
msgid ""
"Our greed for the relics overshadowed our faith in the Nine. I can only hope "
"that you are stronger than we were."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesGuildTopic_00062612_Oblivion_RESP1"
msgid ""
"Our hall doesn't offer much in the way of training. I can teach some basic "
"Alteration skills, but that's about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEBrellachTopic_00018dc5_Oblivion_RESP1"
msgid "Our home and sanctuary here in the Shivering Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MSMiscKotT_000c453c_Oblivion_RESP2"
msgid ""
"Our job is to protect Cheydinhal from any aggressor. We are sworn to this "
"duty and would die before letting any harm befall her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS09PleaseGoOn_00053725_Oblivion_RESP1"
msgid ""
"Our last score was a tax shipment being delivered to the Imperial City. We "
"robbed it, and in the midst of the chaos, Jorundr killed a guard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VampireTopic_0001da61_Oblivion_RESP1"
msgid "Our library is yours, friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CropsfordTopic_00023f56_Oblivion_RESP1"
msgid ""
"Our little farm is thriving. We couldn't have done it without your help. Come "
"back and visit us anytime."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JskarTopic_000579dd_Oblivion_RESP1"
msgid ""
"Our little transaction has been concluded. You may return victorious to "
"Jeanne. Lucky you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00091b29_Oblivion_RESP1"
msgid "Our love has made me the happiest woman in the Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e891_Oblivion_RESP2"
msgid ""
"Our most celebrated citizen is Rythe Lythandas, the famous painter. Speak to "
"his wife, and she might let you take a peek into his studio."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UmbacanoTopic_000a944e_Oblivion_RESP1"
msgid ""
"Our mutual employer rarely tells us the whole story, but he pays very well! "
"Not that I should be giving advice to one of my rivals, ha ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GlarthirTopic_00023662_Oblivion_RESP1"
msgid "Our neighbor. A bit eccentric. Why, is there something I should know?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e7d_Oblivion_RESP1"
msgid ""
"Our new recruit says Maglir completed the Fallen Rock Cave contract. Oreyn "
"refuses to talk about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14TruepaintTopicNo_0018bc29_Oblivion_RESP1"
msgid "Our only hope is to defeat the Painted Trolls."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateTopic_00085716_Oblivion_RESP6"
msgid "Our only hope is to recover the Amulet of Kings from Mankar Camoran."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_0018d305_Oblivion_RESP1"
msgid ""
"Our only hope to weather this Oblivion invasion is to defend our walls and be "
"damned to what happens outside them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SESylTopic_0008f177_Oblivion_RESP1"
msgid ""
"Our own Duchess, aligned with the forces of Order? An infuriating thought!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThadonTopic_0008f178_Oblivion_RESP1"
msgid "Our own Duke, aligned with the forces of Order? An infuriating thought!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEAureals_00012cc2_Oblivion_RESP1"
msgid ""
"Our rivals. The so-called Golden Saints. One day, Sheogorath will finally "
"recognize their bull-headed stupidity and expel them from the Realm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000980c4_Oblivion_RESP1"
msgid "Our sister returns to the fold!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00072c91_Oblivion_RESP2"
msgid ""
"Our situation is desperate, she controls our minds... but wait, I've said too "
"much."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10Trouble_00016812_Oblivion_RESP1"
msgid ""
"Our stronghold at Brellach is under attack! The forces of Order broke in and "
"routed us! You must go to Issmi at once and aid her!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10Trouble_00017d15_Oblivion_RESP1"
msgid ""
"Our stronghold at Pinnacle Rock is under attack! The forces of Order broke in "
"and routed us! You must go to Adeo at once and aid her!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d48d_Oblivion_RESP4"
msgid ""
"Our targets? Weak willed men who are easily fooled into believing they will "
"have their way with us. Hahaha... men are so gullible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEArctusSpeech08_00089890_Oblivion_RESP1"
msgid ""
"Our time has come, brethren. The die has been cast, and the Flame of the "
"Demented blazes like the fire in our hearts!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebba_Oblivion_RESP1"
msgid "Our time must now be spent in prayer. Perfect order must be achieved."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008da94_Oblivion_RESP1"
msgid "Our transaction is complete. I trust you'll keep this between us, yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00143f0d_Oblivion_RESP1"
msgid "Our transaction is complete. I trust you'll keep this between us, yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00005672_Oblivion_RESP1"
msgid ""
"Our troubles are almost at an end, Brother. Soon we will visit the Night "
"Mother, and she will surely guide us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00005673_Oblivion_RESP1"
msgid ""
"Our troubles are almost at an end, Sister. Soon we will visit the Night "
"Mother, and she will surely guide us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029cb_Knights_RESP1"
msgid "Our valor is useless against this daedric devilry!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10WhatNow_00044303_Oblivion_RESP1"
msgid ""
"Our warriors will scour the halls of Brellach, removing any last elements of "
"opposition. Then, we will immediately return to our duties."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10WhatNow_0001b6b9_Oblivion_RESP1"
msgid ""
"Our warriors will scour the halls of Pinnacle Rock, removing any last "
"elements of opposition. Then, we will immediately return to our duties."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CureforVampirism_000977d5_Oblivion_RESP5"
msgid "Our work here is done. You should be on your way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Sanctuary_000251f5_Oblivion_RESP1"
msgid ""
"Ours is not the only Dark Brotherhood Sanctuary. There are others, hidden "
"throughout Cyrodiil, each one overseen by a Speaker of the Black Hand.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09VictimChoice2b_00082092_Oblivion_RESP1"
msgid ""
"Out of deference to my Lord Sheogorath, I will allow this outburst. In fact, "
"I will acquiesce to your request."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00011fa6_Oblivion_RESP1"
msgid "Out of my way!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32FanaticYell_0001b704_Oblivion_RESP1"
msgid "Out of my way!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00090990_Oblivion_RESP1"
msgid "Out of the frying pan into the fire, eh?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00085919_Oblivion_RESP1"
msgid "Out of the way slop drudge."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05GwinasA7_00035c5c_Oblivion_RESP1"
msgid ""
"Outrageous! And you have the nerve to brag about it to my face? I have half a "
"mind to call the guards and have you arrested!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Seen_000a01b0_Oblivion_RESP1"
msgid "Outsider! Kill!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_000607d8_Oblivion_RESP1"
msgid "Outsiders are always up to no good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HackdirtTopic_0002869e_Oblivion_RESP1"
msgid ""
"Outsiders came and burned our town, years ago.  Ruined us.  But we'll get "
"ours back, one day soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_000607dc_Oblivion_RESP1"
msgid "Outsiders should stay out of our home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0000a222_Oblivion_RESP1"
msgid "Outta my way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItem4_00081ec4_Oblivion_RESP1"
msgid ""
"Over here is the Pelvis of Pelagius, the greatest Emperor that Tamriel has "
"ever seen, as well as being completely mad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ00Voice_000817c4_Oblivion_RESP1"
msgid "Over here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Topic_00000913_Oblivion_RESP1"
msgid "Over here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48Convo_000699f2_Oblivion_RESP1"
msgid "Over here! Quickly!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS31Wrath01Negative_0001525d_Oblivion_RESP1"
msgid "Over my dead body!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDCrusadersRelicsTopic_00002a83_Knights_RESP10"
msgid ""
"Over the ages, knights have quested for the Relics, and sometimes one or "
"another of them have been found, but never for long."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10JaksDiarySays_00015313_Oblivion_RESP4"
msgid ""
"Over the centuries there have been dozens of Gray Foxes. To the rest of the "
"world he seems immortal and unchanging. I am hoping to be the last."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ09GhostC_00036667_Oblivion_RESP2"
msgid ""
"Over the uncounted years of our slavery here, we have brooded over our "
"defeat. I believe that we can undo the Underking's evil magic."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5bf_Oblivion_RESP1"
msgid "Over there. That's new."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30Matrices_0001e697_Oblivion_RESP2"
msgid ""
"Over time they soak in magical energies from the world around them. Like you "
"suck blood from a cut."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5d3_Oblivion_RESP1"
msgid "Oviparous. Ovovivparous. What's the difference? We are born and we die."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37EndConversation_000452e1_Oblivion_RESP1"
msgid "Ow! These holes in my shoes are killing me. Well, gotta run!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlademasterTopic_00146855_Oblivion_RESP1"
msgid ""
"Owyn likes to think he's the boss, but without me, this place would fall "
"apart. Who orders the ointment? Who mops up the blood? Me, that's who!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BieneAmelionTOPIC_000091ee_Oblivion_RESP1"
msgid ""
"Paid her debt off yourself, did you? Not gonna get rich that way, meat. "
"Still, the job's done. Here's your payment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraSpeech_00084aa9_Oblivion_RESP1"
msgid "Pain...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033352_Oblivion_RESP1"
msgid ""
"Pale skin, snotty expression. You're a Breton! The masters of magicka, right? "
"Hmph. Nothing but a bunch of stuck-up snobs with cheap parlor tricks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033353_Oblivion_RESP1"
msgid ""
"Pale skin, snotty expression. You're a Breton! The masters of magicka, right? "
"Hmph. You're nothing but a stuck-up harlot with cheap parlor tricks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_000613a9_Oblivion_RESP1"
msgid ""
"Palonirya is one of the wealthiest traders in Cyrodiil. Her shop in the "
"Imperial City is so successful. If anyone can teach you more, she can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0001eeea_Oblivion_RESP1"
msgid "Paradise awaits me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_000895e1_Oblivion_RESP2"
msgid ""
"Paranoia is the order of the day in Crucible. Many keep their eyes open "
"constantly, and some of those eyes may have seen something useful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00030187_Oblivion_RESP1"
msgid "Pardon me, but did I hear you say that you're a traveling merchant?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0006a829_Oblivion_RESP1"
msgid "Pardon me, noble Scholar, but... Could I speak with you a minute?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001db1e_Oblivion_RESP1"
msgid ""
"Pardon me. I'm sorry to trouble you, but I was sent to ask for your help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00026bbd_Oblivion_RESP1"
msgid "Pardon me..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00051ea3_Oblivion_RESP1"
msgid "Parry and strike."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c22e_Oblivion_RESP1"
msgid ""
"Parwen has really got a thing for goblins. I think she and Ah-Malz keep a "
"running tally of who has killed more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c22d_Oblivion_RESP1"
msgid ""
"Parwen is another one of those goblin hunters at the Fighters Guild. She's "
"always talking about her \"goblin killing tactics.\""
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005eeca_Oblivion_RESP1"
msgid "Passwall attacked by Order. In all the destruction, no sign of the Fork."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005eeff_Oblivion_RESP1"
msgid "Passwall has been destroyed. Can the rest of the Isles be far behind?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08PasswallTopic_000415db_Oblivion_RESP1"
msgid ""
"Passwall has served as an outpost for our defense of the Realm for millennia."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08PasswallTopic_000415dc_Oblivion_RESP1"
msgid ""
"Passwall has served as an outpost for our defense of the Realm for millennia."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ef14_Oblivion_RESP1"
msgid "Passwall is in ruins. I should see what they left behind."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_000617cc_Oblivion_RESP1"
msgid ""
"Passwall is only the first, I'm sure. Where are the armies to protect us?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017974_Oblivion_RESP1"
msgid ""
"Passwall must have a new dawn. The struggle will be great, but I have no "
"doubt that we shall overcome this dark time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0002a7d3_Oblivion_RESP1"
msgid "Pathetic Blue Team Coward!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS18Convo_0001cb76_Oblivion_RESP1"
msgid ""
"Patience, Antus. He'll be here as soon as he can. Don't be so anxious to go "
"rushing into battle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkUmaril2_00002c54_Knights_RESP1"
msgid ""
"Patience, brother. The Commander must gather the Relics first, if we are to "
"have any chance at defeating Umaril."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e8b6_Oblivion_RESP2"
msgid ""
"Patience. Caution. Slow and steady wins the race, my father always said. "
"Careless fighters get one last white shirt and a box. Not me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06ShrineTalkPatience_0003641c_Oblivion_RESP1"
msgid ""
"Patience. We will see Lord Dagon walk the earth with our own eyes. Nothing "
"can stop us now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d490_Oblivion_RESP1"
msgid "Patience. We'll have... all night."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Training_00066a5f_Oblivion_RESP1"
msgid "Pay attention, and you can learn a lot."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000a31b9_Oblivion_RESP1"
msgid "Pay up, or else."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033777_Oblivion_RESP1"
msgid "Payday! Let's roll!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36OnDeath_0007cc51_Oblivion_RESP1"
msgid "Peace at last. Thank you! Thank you..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetSpeechMain_00002a6e_Knights_RESP1"
msgid ""
"Pelinal Whitestrake once struck down the enemies of man and god. Who will now "
"reclaim his Relics and fight again for the true faith?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND10UmarilVoice_00002c39_Knights_RESP1"
msgid "Pelinal na vasha. Sa yando tye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDCrusadersRelicsTopic_00002a83_Knights_RESP8"
msgid ""
"Pelinal was taken by the Ayleids after his battle with Umaril, and his body "
"cut into eight parts and scattered across their realm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetStartA2_00002c82_Knights_RESP3"
msgid ""
"Pelinal, with the aid of the gods, fought the Ayleid sorceror-king Umaril and "
"slew him. But Umaril's spirit survived, and he has now returned!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004773f_Oblivion_RESP1"
msgid ""
"Pennus Mallius, adventurer-at-large. Just between adventures at present, I'm "
"afraid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00060563_Oblivion_RESP1"
msgid ""
"People act like Sheogorath's disappearance is of some grave significance. But "
"the Shivering Isles are the same as ever, I assure you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000c47e0_Oblivion_RESP1"
msgid ""
"People always enjoy a good fable. M'aiq has yet to find one, though. Perhaps "
"one day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00044216_Oblivion_RESP1"
msgid ""
"People are all excited about the Great Torch being relit. Personally, I don't "
"pay any attention to politics."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_00159762_Oblivion_RESP1"
msgid ""
"People are beginning to have second thoughts about the Blackwood Company "
"after the Azani Blackheart hoax."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008656c_Oblivion_RESP1"
msgid "People are just ignorant around here..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018b1f8_Oblivion_RESP1"
msgid ""
"People are subdued. Troubled. A crisis like this tests the people's faith."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004351b_Oblivion_RESP1"
msgid ""
"People are talking about a Resonator. Unless it makes more pests to kill, "
"Relan does not care."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00042d99_Oblivion_RESP1"
msgid ""
"People are talking about a new adventurer who is seeking to get into the "
"Isles. Mama warned me, \"Only go where you've been invited.\""
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDChapelAttackTopic_00002b9c_Knights_RESP2"
msgid ""
"People heard the screams, but when they broke down the Chapel doors, everyone "
"was already dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_0004774f_Oblivion_RESP1"
msgid ""
"People in the city, they get stuff and forget to pay. So I help 'em remember. "
"You talk to 'em, lean on 'em a bit, and they remember right away."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434fd_Oblivion_RESP1"
msgid ""
"People keep saying that the Gatekeeper is dead. I have no idea what that "
"means. Do you know?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f4c5_Oblivion_RESP1"
msgid ""
"People keep telling me that the armies of Sheogorath are reassembled... as if "
"this is something that we should be happy about."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS08Hunt_0001fdbb_Oblivion_RESP2"
msgid ""
"People pay him a great deal of money to hunt and kill living human prey. No "
"questions asked, and he takes care of the bodies."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolNQDResponses_00029fc7_Oblivion_RESP1"
msgid "People say he's very familiar with the area."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ThoronirBad_0000bca2_Oblivion_RESP4"
msgid ""
"People who buy tend to want to spend their money there. That leaves none for "
"us. It's getting so bad, a few of us may have to close up shop."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KvatchTopic_000039d7_Oblivion_RESP3"
msgid "People who fought, died. People who ran... they at least had a chance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e8d8_Oblivion_RESP2"
msgid ""
"People, I teach them Advanced Acrobatics. Up and jump. Dogs, I teach them to "
"bite people."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00089934_Oblivion_RESP1"
msgid "Perchance, dare I ask another favor?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008fa85_Oblivion_RESP1"
msgid "Perfect corpses to count! Finally!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Next_0001dc33_Oblivion_RESP2"
msgid ""
"Perfect cover for the ringleader of the whole conspiracy! He watches my house "
"constantly. You'll see."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilB1_0003fbdf_Oblivion_RESP1"
msgid ""
"Perhaps Akatosh heard my prayers. Even here. Even after everything I've done "
"..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d298_Oblivion_RESP1"
msgid "Perhaps Anvil will not go the way of Kvatch, thanks to you. Well done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASheogorathSpeech_000897be_Oblivion_RESP1"
msgid "Perhaps I could make you into something useful. Let's find out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASheogorathSpeech_00097610_Oblivion_RESP1"
msgid "Perhaps I could make you into something useful. Let's find out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQDaedricMagic_0008b605_Oblivion_RESP3"
msgid "Perhaps I may yet come to believe it myself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAHircineSpeech_00051edd_Oblivion_RESP1"
msgid "Perhaps I shall task you, mortal. Set you to hunt for my amusement. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043505_Oblivion_RESP1"
msgid ""
"Perhaps I should dedicate a portrait to the Gatekeeper in honor of his death."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006052e_Oblivion_RESP1"
msgid ""
"Perhaps I was wrong. Maybe the Scalons aren't the worst thing that could "
"happen to us. I mean... Sheogorath himself has vanished."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002377b_Oblivion_RESP1"
msgid ""
"Perhaps I wasn't clear. I cannot spare time to talk with you. Would you be so "
"kind as to leave me alone?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGSkingradAdrienne_00047464_Oblivion_RESP1"
msgid "Perhaps I'll steer clear of her, then."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AReplace_00013ffb_Oblivion_RESP1"
msgid ""
"Perhaps I've misjudged you. Alright. I'll help. Just remember me when you "
"take over her position."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_000614c5_Oblivion_RESP1"
msgid "Perhaps Syl was right all along."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09HaskillGatekeeper_00040372_Oblivion_RESP3"
msgid ""
"Perhaps Your Grace is more susceptible to our Lord's Blessings than at first "
"it seemed. Interesting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_magickaloria_00054023_Oblivion_RESP2"
msgid "Perhaps a spell that damages Magicka is what you're looking for."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b597_Oblivion_RESP1"
msgid "Perhaps a trip back to Morrowind would do me some good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00040cb6_Oblivion_RESP1"
msgid ""
"Perhaps further conversation should wait until things are a bit more... "
"relaxed? You seem to have your hands full at the moment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VaronVamoriTopic_0002f177_Oblivion_RESP3"
msgid ""
"Perhaps he thinks it's amusing; I don't know. But it needs to stop. It's "
"making her miserable."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05Gwinas_00094c3a_Oblivion_RESP4"
msgid ""
"Perhaps he'd be willing to sell you Volume 3. But I doubt it. He was very "
"pleased with his purchase."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MSMiscFarwil_000c453d_Oblivion_RESP2"
msgid "Perhaps if you return later, he'll be here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FawilTopic_000329f3_Oblivion_RESP1"
msgid ""
"Perhaps in the future, Farwil will learn patience and careful planning before "
"dragging us into a situation like that again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FawilTopic_00143eb4_Oblivion_RESP1"
msgid ""
"Perhaps in the future, Farwil will learn patience and careful planning before "
"dragging us into a situation like that again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VampireVicente_000251fd_Oblivion_RESP3"
msgid ""
"Perhaps in the future, when I feel you have earned the right, I will offer "
"you a chance to become a hunter of the night. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG09Choice3A_00022b6c_Oblivion_RESP2"
msgid ""
"Perhaps in the future, you can be trusted enough to deal with more serious "
"matters."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_information_00009223_Oblivion_RESP3"
msgid ""
"Perhaps it is a mistake to make that assumption; only time will tell, I "
"suppose."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e8c2_Oblivion_RESP1"
msgid ""
"Perhaps it seems silly, but our love is the most important thing in all "
"creation. Orintur and I spend all our time together, in the High Elf way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EronorTopic_000247e8_Oblivion_RESP2"
msgid ""
"Perhaps it would interest you to know that Eronor's sister, Dagail, in "
"Leyawiin, is an accomplished spellcrafter."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d8b_Oblivion_RESP1"
msgid "Perhaps my Lord could help me die?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081da6_Oblivion_RESP1"
msgid "Perhaps my Lord will fortify the walls?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081d9d_Oblivion_RESP1"
msgid "Perhaps my Lord will grant me my wish."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NightshadeTopic_0005373d_Oblivion_RESP1"
msgid ""
"Perhaps not quite as easy to find as garlic, but if you're determined, you'll "
"find it. Keep your eyes open, as it often grows in the wild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate4_00015630_Oblivion_RESP1"
msgid ""
"Perhaps not, but we both know it's something you've fantasized over. I'm "
"surprised you can contain your excitement to speak. Get on with it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f3f2_Oblivion_RESP1"
msgid ""
"Perhaps now that our guards are restored, things will quiet down and I'll "
"actually be able to get something done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10JyggalagTopic_00091481_Oblivion_RESP2"
msgid ""
"Perhaps only the Princes themselves know why it is so. I do not. I know only "
"that Sheogorath wishes for you to succeed. Of this, I am certain."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BravilNQDQuestionResponses_000465e8_Oblivion_RESP1"
msgid ""
"Perhaps she grew bored with studying nothing but enchantments and spells. I "
"know I would."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HistTreeTopic_00035701_Oblivion_RESP3"
msgid ""
"Perhaps she will understand what it is we have done. I believe our work is "
"now finished. You are a fine soldier, my friend. You've made me proud."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGEmperor03_0002ad14_Oblivion_RESP1"
msgid "Perhaps the Gods have placed you here so that we may meet."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_000614ab_Oblivion_RESP1"
msgid "Perhaps the Torch is a sign of hope."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00044201_Oblivion_RESP1"
msgid ""
"Perhaps the new head of Dementia can do something to help people protect "
"what's really theirs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005dd15_Oblivion_RESP1"
msgid ""
"Perhaps the new ruler of Dementia will do something about the cat problem."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GarridansTears_00022f17_Oblivion_RESP2"
msgid "Perhaps these potions will help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECreatureResponses_00078183_Oblivion_RESP1"
msgid "Perhaps they are especially blessed by Lord Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAPeryiteSpeech_0008c25e_Oblivion_RESP1"
msgid ""
"Perhaps they have learned the folly of attempting to touch a Daedra Prince. "
"Take this, with my blessing. May it bring you order."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PellsGateTOPIC_00026b1f_Oblivion_RESP2"
msgid ""
"Perhaps they sent you to kill me? Are they worried I might come in the night "
"and burn their village down around them?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_causingtrouble_0002c8da_Oblivion_RESP1"
msgid ""
"Perhaps they will cause no more. Perhaps they will have the gold to pay for "
"their drinks."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061795_Oblivion_RESP1"
msgid "Perhaps this Gatekeeper will be made of sterner stuff."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025dfa_Oblivion_RESP3"
msgid ""
"Perhaps this exercise will help you build character, or vent your murderous "
"rage elsewhere. Or, you'll die, and you won't be our problem. Now, go."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FawilTopic_000335a6_Oblivion_RESP1"
msgid ""
"Perhaps this journey with you has tought him a lesson. Only time will tell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017983_Oblivion_RESP1"
msgid "Perhaps this time we will have more than a few moment's rest."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE05HerdirInvestigateWho_00083f49_Oblivion_RESP2"
msgid ""
"Perhaps we can convince someone else in Crucible to tell us a bit more about "
"his recent activities. That might loosen his tongue."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001647b_Oblivion_RESP2"
msgid ""
"Perhaps we shall chat for a while, since you really have no other options?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13Gate_000329e9_Oblivion_RESP8"
msgid ""
"Perhaps we're all to blame. But that's not important right now. We must "
"complete our journey and get that stone. Please help us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00019acb_Oblivion_RESP2"
msgid ""
"Perhaps when you've finished your slaughtering and washed the blood off your "
"hands, we can chat again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00061396_Oblivion_RESP2"
msgid ""
"Perhaps you are capable of being a decent trader one day. Well, with that "
"kind of money, anyone can be, after all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007f3a8_Oblivion_RESP1"
msgid "Perhaps you are the one? No, probably not. Never mind. But then again.."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00038f2c_Oblivion_RESP1"
msgid "Perhaps you can help me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ10Husband_00061420_Oblivion_RESP2"
msgid ""
"Perhaps you can help me. My husband's name is Bjalfi the Contemptible. My "
"father said I was a fool to marry him, but I didn't listen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG03Choice1A_0002f176_Oblivion_RESP2"
msgid ""
"Perhaps you can help with that, however. I can't directly get involved, for "
"fear of embarrassing the poor girl."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00072c91_Oblivion_RESP1"
msgid ""
"Perhaps you could help us? But why should I trust you? You might be, you "
"know... one of Them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27HerminiaA3_000a5602_Oblivion_RESP3"
msgid ""
"Perhaps you could overpower me and take the Crown. Perhaps. But I urge you to "
"reconsider."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00098170_Oblivion_RESP1"
msgid "Perhaps you do understand. Perhaps I can help you. A little."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09VictimChoice3b_00082094_Oblivion_RESP2"
msgid "Perhaps you had better reconsider."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalChoice1_00026ac1_Oblivion_RESP1"
msgid ""
"Perhaps you have been summoned. Perhaps Nocturnal desires your service, and "
"has guided you here. Approach."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_0000921b_Oblivion_RESP1"
msgid "Perhaps you need new armor? A weapon? I have a large selection of both."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_00038ad0_Oblivion_RESP1"
msgid ""
"Perhaps you should seek out a priest. Perhaps a beggar. Or guardsman. You and "
"I, we have nothing common. What could we possibly talk about?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Nirnroot_0004e935_Oblivion_RESP2"
msgid ""
"Perhaps you should take it to him. If any other alchemist can help you, he "
"certainly can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilHelpNo_000473c6_Oblivion_RESP1"
msgid ""
"Perhaps you still do not trust me. Very well. I will not interfere. If "
"Akatosh still hears my prayers, go with his blessing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ03MartinD1_0009226a_Oblivion_RESP5"
msgid ""
"Perhaps you were sent by Akatosh. Perhaps not. But I of all people should "
"know that the gods work through us, not for us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00086061_Oblivion_RESP2"
msgid "Perhaps you would like to do a service for County Leyawiin?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_00038aaf_Oblivion_RESP1"
msgid ""
"Perhaps you'd better speak to my steward. I'm afraid I have little time to "
"spend with visitors to Skingrad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE14Attacks_0004681d_Oblivion_RESP1"
msgid ""
"Perhaps you'd forgotten about the attacks on Deepwallow, My Lord? I'm sure "
"the citizens might last a bit longer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASheogorathChoice5_00026af7_Oblivion_RESP2"
msgid "Perhaps you'd like to know more about Border Watch itself?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEChaliceofReversal_00018b7d_Oblivion_RESP2"
msgid ""
"Perhaps you're mistaken, and we have spoken of it. I simply can't recall. I "
"could think so much more clearly if I had the Chalice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetGreetA8_00002adf_Knights_RESP1"
msgid ""
"Perhaps, perhaps not. What men value is not always what the gods look for in "
"a champion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGExpelAccept_00026d94_Oblivion_RESP2"
msgid ""
"Perhaps, while you spend time collecting these ingredients, you can consider "
"the ramifications of your actions."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028194_Oblivion_RESP1"
msgid ""
"Personally, I think she's a little floozy. She's been eyeing young Primo "
"Antonius, probably smells his wealth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008dd63_Oblivion_RESP1"
msgid "Peryite guide your actions."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008dd56_Oblivion_RESP1"
msgid "Peryite save us!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark04GuardsConvo_0009533e_Oblivion_RESP1"
msgid ""
"Pfft! I ain't afraid of no one. Courage is my middle name! I... Oh, nevermind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08NelsNevConvo_000852ca_Oblivion_RESP1"
msgid ""
"Pfft. I was done with you anyway. I can only talk to an ex-Legion pig for so "
"long before my ears start bleeding. Besides, I need a drink. Ha ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006a846_Oblivion_RESP1"
msgid ""
"Pfft. If you weren't authorized to be here I'd conjure up an Atronach to "
"freeze your blood cold. Watch your step."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PickpocketNoCrime_000626bb_Oblivion_RESP1"
msgid "Pfft. Take it. It's worthless to me anyway."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark05FinChoice2A_0004ce49_Oblivion_RESP1"
msgid ""
"Phillida has dedicated his life to eradicating the Dark Brotherhood, and he "
"becomes rather irate when our duties take us to the Imperial City."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_000039e4_Oblivion_RESP1"
msgid ""
"Phillida may be retired, but he'll likely have a bodyguard, probably a member "
"of the Leyawiin City Watch. You may have to dispose of him as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08FinChoice1A_00035df3_Oblivion_RESP6"
msgid ""
"Phillida now resides in Leyawiin, in the City Watch barracks, an honored "
"guest of the soldiers there. He is, in fact, more vulnerable than ever."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_00049903_Oblivion_RESP1"
msgid "Phintias has a good selection, and he'll find some rare books as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00049906_Oblivion_RESP1"
msgid ""
"Phintias has the best bookstore in the city. Of course, First Edition is the "
"only bookstore in the city."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05TarMeenaC_00022b43_Oblivion_RESP4"
msgid ""
"Phintias, the proprietor, caters to specialist collectors. He may have an "
"idea of where to locate those books."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000241ce_Oblivion_RESP1"
msgid "Picked up a good book at Renoit's this week. Sure wish I could read it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Pickpocket_00062274_Oblivion_RESP1"
msgid "Pickpocket! Pickpocket! Guard your purses!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c217_Oblivion_RESP1"
msgid ""
"Pinarus Inventius is quite the hunter. He can track about anything, and he's "
"deadly with his bow."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e09d_Oblivion_RESP1"
msgid "Pinarus Inventius, hunter, woodsman, and marksman, at your service."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilNQDResponses_0003c23f_Oblivion_RESP1"
msgid ""
"Pinarus is an impressive tracker. I'd like to see if he can teach me a bit "
"about using a bow."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008f4d1_Oblivion_RESP1"
msgid "Pinnacle Rock is ours!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10PinnacleRockInfo_00043028_Oblivion_RESP1"
msgid ""
"Pinnacle Rock was given to us by our Lord Sheogorath as a sanctuary and place "
"of restoration."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008f4d0_Oblivion_RESP1"
msgid "Pinnacle Rock will be cleansed!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0002511b_Oblivion_RESP1"
msgid ""
"Pirates, eh? They tend to be quick, and good with a blade, but don't favor "
"armor. They're not fond of bows or spells, either."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003c356_Oblivion_RESP1"
msgid "Piss off."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01FinChoice1B_00023e4c_Oblivion_RESP1"
msgid ""
"Pity. I'm eager to see how you fare on your first assignment. Well, the "
"contract will still be here when you're ready.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03Reactivated_0008e944_Oblivion_RESP2"
msgid "Place one foot in front of the other... you know how it goes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Ceremony_00014ac2_Oblivion_RESP1"
msgid "Place the Blood Liqueur into the Cistern of Substantiation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Ceremony_00014ac0_Oblivion_RESP1"
msgid "Place the Dermis Membrane into the cistern."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Ceremony_00014ac8_Oblivion_RESP1"
msgid "Place the Essence of Breath into the Cistern of Substantiation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Ceremony_00014ac5_Oblivion_RESP1"
msgid "Place the Osseous Marrow into the cistern."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeShieldMagic_0001f3e5_Oblivion_RESP1"
msgid "Place this between you and your foe. Creates less of a mess that way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026aa9_Oblivion_RESP1"
msgid ""
"Place. Not place? Here. Not here? Welcome to the Grove of Madness, stranger. "
"Or go away. Who knows? Time will tell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03HowToHelp_000092b7_Oblivion_RESP1"
msgid ""
"Plant the bust in her cupboard. Make sure she doesn't see you. Then go tell "
"Hieronymous Lex that she is the thief. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007820c_Oblivion_RESP1"
msgid "Pleasant dreams."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001a113_Oblivion_RESP1"
msgid "Pleasant, as always."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13MessengerA2_0001a798_Oblivion_RESP1"
msgid ""
"Please accept my pardon, Lord, if I gave you such a false impression. The "
"fault is entirely mine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13MessengerB2_0005e37b_Oblivion_RESP1"
msgid ""
"Please accept my pardon, Lord, if I gave you such a false impression. The "
"fault is entirely mine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS31Selene06Final_00015265_Oblivion_RESP2"
msgid ""
"Please accept my surrender. Here's my blade. Please. No treasure is worth my "
"life. The Bloated Float is yours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice7A_00028c7a_Oblivion_RESP2"
msgid ""
"Please accept my thanks on behalf of the people of Chorrol, for restoring "
"this sword and the honor of our city."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00019132_Oblivion_RESP2"
msgid ""
"Please accept this Black Band as your reward. It is a ring whose powers are "
"quite useful to those who value... discretion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice4C_00022ba7_Oblivion_RESP1"
msgid ""
"Please accept this token from the Dark Brotherhood. It is a virgin blade, and "
"thirsts for blood. May it serve you well, as does your silence. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008da90_Oblivion_RESP1"
msgid "Please avenge my family's death... slay the ogres."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08ShowEntrance_000983aa_Oblivion_RESP2"
msgid "Please be discreet and don't bother the other monks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00015dfa_Oblivion_RESP1"
msgid "Please be generous, kind sir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00061541_Oblivion_RESP1"
msgid "Please bring back Rockshatter. It means a great deal to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004c5b4_Oblivion_RESP1"
msgid "Please come find me as soon as you've located J'skar."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PayGoldforCrime_0004575f_Oblivion_RESP1"
msgid ""
"Please come with me, Your Grace. According to the law, any stolen property "
"must be handed over, then you're free to go."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001c4d4_Oblivion_RESP1"
msgid "Please consider my proposal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081520_Oblivion_RESP1"
msgid "Please do make it rain burning dogs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081533_Oblivion_RESP1"
msgid "Please don't go! I have no one else to talk to."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009f90e_Oblivion_RESP1"
msgid "Please don't harm me! What is it you want?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003faf0_Oblivion_RESP1"
msgid "Please don't hurt me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00015306_Oblivion_RESP1"
msgid "Please don't hurt me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033b3a_Oblivion_RESP1"
msgid "Please don't tell anyone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000add4c_Oblivion_RESP1"
msgid "Please excuse me. I have things to attend to."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000a317b_Oblivion_RESP1"
msgid ""
"Please forgive me, but I'm afraid I haven't got time to talk right now. One "
"of the other Blades should be able to assist you. Try Jena or Steffan."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk3_00067dc4_Oblivion_RESP1"
msgid ""
"Please forgive me, sir. The others and I, we're just... well, we're glad to "
"have you here with us, sir. We just want to make sure you're safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001da59_Oblivion_RESP1"
msgid ""
"Please forgive my ignorance. Had we known about Seridur, we'd never have put "
"you in harm's way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008b078_Oblivion_RESP1"
msgid "Please go away."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018b123_Oblivion_RESP1"
msgid "Please go away. I have no wish to speak to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003d4ea_Oblivion_RESP1"
msgid "Please hear me out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Investigation_0003150b_Oblivion_RESP1"
msgid ""
"Please help me recover the painting of the Count. It would mean so very much "
"to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000165c1_Oblivion_RESP1"
msgid "Please help me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033589_Oblivion_RESP1"
msgid "Please help us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00028697_Oblivion_RESP1"
msgid "Please hurry back.  You're my only hope!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000093c1_Oblivion_RESP1"
msgid "Please hurry, I fear Rythe is in danger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000093c3_Oblivion_RESP1"
msgid "Please hurry, I fear Rythe is in danger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00038f22_Oblivion_RESP1"
msgid "Please hurry, Raynil may make a break for the open road at any moment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008da8f_Oblivion_RESP1"
msgid "Please hurry, we are anxious to return home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00038f1d_Oblivion_RESP1"
msgid "Please hurry, we must know of Raynil's whereabouts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000093ac_Oblivion_RESP1"
msgid "Please hurry."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE09MiscRelmynaExperiment_00046f49_Oblivion_RESP1"
msgid ""
"Please indicate on a scale of one to ten, how much pain you are feeling at "
"this moment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00098123_Oblivion_RESP1"
msgid "Please just follow me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038a80_Oblivion_RESP2"
msgid "Please keep your weapons sheathed, and use your best manners."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000093bd_Oblivion_RESP1"
msgid "Please leave me alone. I have important things to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0006c2a8_Oblivion_RESP1"
msgid "Please leave me be..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007f44d_Oblivion_RESP1"
msgid "Please leave! These are private moments!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001bb26_Oblivion_RESP1"
msgid "Please leave. I have no wish to speak with you any longer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002a378_Oblivion_RESP1"
msgid "Please leave. You shouldn't be here now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice2B_000242b4_Oblivion_RESP3"
msgid ""
"Please let us know when it is safe to travel there. We're anxious to return."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007028b_Oblivion_RESP1"
msgid ""
"Please make it quick, citizen. My patrol awaits, and a Legion steed can't "
"keep still for very long..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_tasks_000039a0_Oblivion_RESP1"
msgid ""
"Please pay a visit to Count Hassildor in Skingrad. If his information is as "
"vital as he claims, we need it as soon as possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033778_Oblivion_RESP1"
msgid "Please save my little rats!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LadyRogbutTOPIC_0000be79_Oblivion_RESP3"
msgid ""
"Please search to the east of my sprawling abode. They have been known to "
"vacate these premises. I am most gracious and truly woeful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0018ae7a_Oblivion_RESP1"
msgid ""
"Please show your respect for the Imperial Palace by keeping your voice down."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00032e04_Oblivion_RESP1"
msgid "Please speak to Amminus. He can tell you what you need to know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004e957_Oblivion_RESP1"
msgid "Please tell me you have more Nirnroot for me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06JauffreA_0008b616_Oblivion_RESP1"
msgid "Please tell me you have some good news..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bc81_Oblivion_RESP1"
msgid ""
"Please the Nine with good works, and visit Wayshrines of Stendarr for "
"Blessings of Endurance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11RakheranGreeting1b_00019cd1_Oblivion_RESP1"
msgid ""
"Please to relax... we have a common goal. You see, I know that you have not "
"come here to join us... Your Grace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000817ba_Oblivion_RESP1"
msgid "Please wait in the Hall. The Count will be with you shortly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ01Yes_00088bd2_Oblivion_RESP1"
msgid ""
"Please! Don't insult me! You don't have enough money to pay for my bread. "
"Come back when you do!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033b3f_Oblivion_RESP1"
msgid "Please! Get on with it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004f9cf_Oblivion_RESP1"
msgid "Please! Help me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00012d0a_Oblivion_RESP1"
msgid "Please! I must find my betrothed!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000b0719_Oblivion_RESP1"
msgid "Please! I've got to get to work! All we have left is the farm!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebd4_Oblivion_RESP1"
msgid ""
"Please! I've got to get to work. If I don't... who knows what those ogres "
"will do to me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_0007cc3b_Oblivion_RESP1"
msgid "Please! No!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0007cc48_Oblivion_RESP1"
msgid "Please! No!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15Voice_00074a20_Oblivion_RESP1"
msgid "Please! No! No!!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029a6_Knights_RESP1"
msgid "Please! Set me free!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE09MiscScreamingInPain_00046f6d_Oblivion_RESP1"
msgid "Please! Stop! Ahhieayah!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HappyReceive_0002a393_Oblivion_RESP1"
msgid "Please! You'll make me blush!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk1_00067dca_Oblivion_RESP1"
msgid ""
"Please, Blade, say what you will, but let us forgo these absurd formalities. "
"I am no \"lord\" yet. I would remain plain Martin for a while."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VenaPetilius_00026b4a_Oblivion_RESP1"
msgid ""
"Please, I do not wish to speak of her. My wife is buried here, and I only "
"wish to visit her grave in peace. It is a sacred place to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000093c2_Oblivion_RESP1"
msgid "Please, I don't know where to turn."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ10Husband_00061420_Oblivion_RESP5"
msgid ""
"Please, I don't think he's ever coming back, and I'd hate to lose such a "
"precious heirloom to a gang of thugs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00013ffe_Oblivion_RESP1"
msgid ""
"Please, I have done all I can. There is nothing more to say. Just be cautious."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000432b6_Oblivion_RESP1"
msgid "Please, I have much to tell you. Don't go."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008f11f_Oblivion_RESP2"
msgid "Please, I mean you no violence. Perhaps you can help me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001e0f7_Oblivion_RESP1"
msgid "Please, I must speak."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008b070_Oblivion_RESP1"
msgid ""
"Please, I no longer have a desire to speak with you. I appreciate what you've "
"done in the past, but that's just what it is... the past."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000907a1_Oblivion_RESP1"
msgid "Please, I wish to be alone with my thoughts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000919c5_Oblivion_RESP1"
msgid "Please, I'd like to be left alone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00002db6_Oblivion_RESP1"
msgid "Please, I'm an old man! Just leave me be!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003cd67_Oblivion_RESP1"
msgid ""
"Please, I'm in desperate need of help, and I think you're the only one that I "
"can turn to!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001e7d0_Oblivion_RESP1"
msgid "Please, I'm very busy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001da4e_Oblivion_RESP1"
msgid ""
"Please, I've much to do. We'll speak again soon at the meeting place of the "
"Order."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FaelianTopic_0002ff13_Oblivion_RESP1"
msgid ""
"Please, I... I don't mean to get emotional but... I feel I can trust you. I "
"just don't know what to do about Faelian!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001da68_Oblivion_RESP1"
msgid "Please, Seridur is anxious for your report."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10NotReady_00081cad_Oblivion_RESP1"
msgid "Please, Your Grace. Hurry; we haven't much time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10NotReady_00081cae_Oblivion_RESP1"
msgid "Please, Your Grace. Hurry; we haven't much time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE41Cure_0006ea71_Oblivion_RESP2"
msgid ""
"Please, accept this as a gesture of thanks. It's the least I can do for "
"you... after all, you saved my life!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017ca3_Oblivion_RESP3"
msgid ""
"Please, allow me to teach you this spell, so that you may summon our kind to "
"you in times of need."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017cf9_Oblivion_RESP3"
msgid ""
"Please, allow me to teach you this spell, so that you may summon our kind to "
"you in times of need."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ShadeoftheRevenant_0000357b_Oblivion_RESP5"
msgid ""
"Please, be careful. Anything you find is of no use to us if you do not "
"survive. I believe we are dealing with powerful forces here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS43Staff_0004f8bc_Oblivion_RESP4"
msgid ""
"Please, bring Rosentia this information at once. And if you can, help her. I "
"think she's about to crack under the pressure, poor thing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00091991_Oblivion_RESP1"
msgid "Please, by all means."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007ac70_Oblivion_RESP1"
msgid ""
"Please, come back soon. No telling what oddities I may have for you next time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004f9c3_Oblivion_RESP1"
msgid "Please, consider my proposal. The reward will be worth the risk."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022500_Oblivion_RESP2"
msgid ""
"Please, do not let my appearance... unnerve you. The needs and Tenets of the "
"Dark Brotherhood come before my own needs as a vampire."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000c42c6_Oblivion_RESP1"
msgid "Please, do what you can to protect Antus. He's just a kid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00031036_Oblivion_RESP2"
msgid "Please, don't be mad. We were just having some fun."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000206c9_Oblivion_RESP1"
msgid "Please, don't continue speaking with me... time is of the essence."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004f8c1_Oblivion_RESP1"
msgid "Please, don't dawdle here... get to the Mages Guild! Hurry!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00189d0a_Oblivion_RESP1"
msgid "Please, don't go. You may be my only hope."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00047359_Oblivion_RESP1"
msgid "Please, don't let Anaxes loose! He torments us night and day!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23SeridurHeSays_000947c1_Oblivion_RESP2"
msgid ""
"Please, don't let him deceive you. You must return there and put an end to "
"his masquerade. Quickly, before he has a chance to get away!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036618_Oblivion_RESP1"
msgid ""
"Please, don't tell her what I've done. I can make it worth your while...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000c42d4_Oblivion_RESP1"
msgid "Please, don't waste time speaking to an old man. Go and help my sons."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00088b34_Oblivion_RESP1"
msgid "Please, end this nightmare if you can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEPayGoldforCrime_000459c8_Oblivion_RESP1"
msgid "Please, follow me, and we'll have this matter cleared up in no time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40Choice3A_00098139_Oblivion_RESP2"
msgid "Please, follow me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a902_Oblivion_RESP2"
msgid ""
"Please, friend. Make haste! This waiting about is torture! I know in my heart "
"who I am, but with evidence I can prove my claim to all of Tamriel!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a903_Oblivion_RESP2"
msgid ""
"Please, friend. Make haste! This waiting about is torture! I know in my heart "
"who I am, but with evidence I can prove my claim to all of Tamriel!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00094ebf_Oblivion_RESP1"
msgid "Please, get those things out of here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0009198d_Oblivion_RESP1"
msgid "Please, go ahead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AlbertJemaneTopic_0008b073_Oblivion_RESP2"
msgid ""
"Please, go away before I lose my temper. I know I'm no match for you in "
"combat, but I don't have to talk to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004f548_Oblivion_RESP1"
msgid "Please, go find Pinarus, and those mountain lions!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003c36a_Oblivion_RESP1"
msgid ""
"Please, go get Ulrich and convince him to follow you here. I'll do the rest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009811d_Oblivion_RESP1"
msgid "Please, go."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001e0d8_Oblivion_RESP1"
msgid "Please, hear me out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003ca4b_Oblivion_RESP1"
msgid "Please, help me find what I've lost."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Creatures_000224ad_Oblivion_RESP1"
msgid ""
"Please, hurry so you can accompany my sons. They're probably waiting at "
"Weynon Priory by now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00048733_Oblivion_RESP1"
msgid "Please, hurry! Get rid of those things!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG12TravenWhat_000835fb_Oblivion_RESP3"
msgid ""
"Please, hurry. The Battlemages will arrive there soon, if they have not "
"already, and time is of the essence. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG14Choice1B_0000a0fc_Oblivion_RESP1"
msgid ""
"Please, hurry. The division in the Council will be difficult, if not "
"impossible, to reconcile."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062c96_Oblivion_RESP1"
msgid "Please, join me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003b1db_Oblivion_RESP1"
msgid ""
"Please, just kill me! Can't you see? It's what I want! I can't live like "
"this, knowing I'm something filthy, something evil! Kill me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028247_Oblivion_RESP1"
msgid ""
"Please, just leave me alone! Either you or Nels is a murderer. I just don't "
"know who to trust anymore!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002f4da_Oblivion_RESP1"
msgid ""
"Please, just take what you want and leave! I won't call the guards, I swear!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice2C_000242b1_Oblivion_RESP1"
msgid ""
"Please, keep looking. I know it's out there somewhere. You'll find it "
"eventually."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000165c4_Oblivion_RESP1"
msgid "Please, leave me be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000299b_Knights_RESP1"
msgid "Please, leave me be. I need rest..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000292e_Knights_RESP1"
msgid "Please, leave me be. I need time to think on what I've seen and done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002911_Knights_RESP1"
msgid "Please, leave me be. I've no interest in visitors. I'm far too weak."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000579c8_Oblivion_RESP1"
msgid "Please, leave me in peace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009811e_Oblivion_RESP2"
msgid "Please, leave me to my grief."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002809b_Oblivion_RESP1"
msgid ""
"Please, let me out of here! You must help me escape. I think these creatures "
"plan to do something horrible to me tonight!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e930_Oblivion_RESP1"
msgid ""
"Please, listen to what I have to say; it could be lucrative for the both of "
"us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_0005e00d_Oblivion_RESP1"
msgid "Please, look. Buy. Something here might save you when the end comes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00078cad_Oblivion_RESP1"
msgid "Please, meet me in the reception chamber."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MartinD2_0009ce84_Oblivion_RESP5"
msgid "Please, my friend. I need your judgement, not your obedience."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05PostTortureGreet_0007ff43_Oblivion_RESP1"
msgid "Please, no more..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05TortureChoice1F_000805a7_Oblivion_RESP1"
msgid "Please, no!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05TortureChoice1M_0007ff45_Oblivion_RESP1"
msgid "Please, no!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000852dc_Oblivion_RESP1"
msgid "Please, not now. I just want to be by myself for a bit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG13Choice1B_000039a1_Oblivion_RESP1"
msgid "Please, prepare yourself as quickly as possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LadyRogbutTOPIC_0000be77_Oblivion_RESP1"
msgid ""
"Please, rescue my daughter from those brutes! I fear for her safe return!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000165b4_Oblivion_RESP1"
msgid "Please, return anytime friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003cc29_Oblivion_RESP1"
msgid "Please, return quickly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001e7a1_Oblivion_RESP1"
msgid "Please, return soon. It's always a pleasure to see you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BloodwormHelmTopic_0000c08b_Oblivion_RESP2"
msgid ""
"Please, return the helm here before any harm comes to it, or those who are "
"using it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000be66_Oblivion_RESP1"
msgid "Please, see if you can't find our friends who have disappeared."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001bb28_Oblivion_RESP1"
msgid "Please, share the hospitality of our home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_0004d84c_Oblivion_RESP1"
msgid "Please, sire, we must keep moving."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_0004f77a_Oblivion_RESP1"
msgid "Please, sire. We can't stay here. We have to go."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE01HaskillTalk_0005dd0f_Oblivion_RESP1"
msgid "Please, sit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05MazaddhaSawYou_00081186_Oblivion_RESP3"
msgid "Please, spare me! I'll do anything!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk1_0018d7e6_Oblivion_RESP1"
msgid "Please, speak freely."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001e0ea_Oblivion_RESP1"
msgid "Please, stay your hand."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002815f_Oblivion_RESP1"
msgid ""
"Please, sweetie, stay close to me.  The killer might strike again, whoever "
"he... or she... is. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0006ea95_Oblivion_RESP1"
msgid "Please, tell me you have my remedy... I can't hold out much longer!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk4_00067dc5_Oblivion_RESP1"
msgid ""
"Please, there's no need to apologize. If anyone should be sorry, it's me. "
"You're busy, and I'm distracting you from your work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_0000399f_Oblivion_RESP1"
msgid "Please, travel there as soon as possible. The Count is waiting for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS05PreparedYes_0002c6ea_Oblivion_RESP1"
msgid ""
"Please, use the extra bed here. If you sleep too far from Henantier, it may "
"not work. I'll watch over you both to make sure you're safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081dc5_Oblivion_RESP1"
msgid "Please, visit any time, My Lord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00026bc0_Oblivion_RESP1"
msgid ""
"Please, visit me again anytime. I'm glad to help. Give S'drassa my regards."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00098120_Oblivion_RESP1"
msgid "Please, wait here. I shall let the Count know you are waiting for him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RaynilDralasTopic_00038f18_Oblivion_RESP1"
msgid "Please, you must avenge Bradon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ01Potatoes_001885db_Oblivion_RESP1"
msgid ""
"Please, you must help me find them! If I don't have them for the next batch "
"of my Famous Potato Bread, I don't know what I'll do!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000285a6_Oblivion_RESP1"
msgid "Please, you must help me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38GuardWarnChoice1_00023687_Oblivion_RESP2"
msgid ""
"Please, you must show this to the guards at once. My life is in your hands!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003ca59_Oblivion_RESP1"
msgid "Please, you must speak with Henantier. He has the reward I offered."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001680e_Oblivion_RESP1"
msgid "Please, your Grace. Hurry to Brellach while there's still time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001680d_Oblivion_RESP1"
msgid "Please, your Grace. Hurry to Pinnacle Rock while there's still time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00032dfa_Oblivion_RESP1"
msgid ""
"Please. Although I'm concerned about the safe return of my son and the "
"closing of the gate, please see Amminus Gregori for all of the details."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeleneTopic_0000c1d2_Oblivion_RESP1"
msgid "Please. Get her below like I asked so we can get underway."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONENTER_00062308_Oblivion_RESP1"
msgid "Please. Go on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE01HaskillTalk_0005de6e_Oblivion_RESP1"
msgid "Please. Have a seat."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000514be_Oblivion_RESP1"
msgid "Please. Help us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05PostTortureGreet_00080d79_Oblivion_RESP1"
msgid ""
"Please. I am not involved... I didn't do anything! They wanted me to get them "
"close to Syl, but I wouldn't abide them!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001fdae_Oblivion_RESP1"
msgid "Please. I wish to be alone with my thoughts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ADMIRELOVE_0018b2ae_Oblivion_RESP1"
msgid "Please. I'm embarrassed. But thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479d8_Oblivion_RESP2"
msgid ""
"Please. Just don't mention me to her, or she will burst into one of her "
"tirades..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002822d_Oblivion_RESP1"
msgid ""
"Please. Please help me. I don't want to die. I just want to go home. Go "
"home..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000366cf_Oblivion_RESP1"
msgid "Please..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004e95a_Oblivion_RESP1"
msgid "Please..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00189d00_Oblivion_RESP1"
msgid "Please... I implore you, help me avenge my wife's death!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028255_Oblivion_RESP1"
msgid ""
"Please... No... Primo can't be the killer. But it's either him... or you..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000165c0_Oblivion_RESP1"
msgid "Please... get her from my sight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_001885d3_Oblivion_RESP1"
msgid "Please... give them to me! I must have them!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000165b9_Oblivion_RESP1"
msgid "Please... go get some rest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003ca86_Oblivion_RESP1"
msgid "Please... help me, I can't remember anything."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FromTheDead_0001d036_Oblivion_RESP2"
msgid ""
"Please... if you don't want to buy something, then just leave. Your wild "
"accusations are upsetting me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038435_Oblivion_RESP2"
msgid ""
"Please... please. I need your help. My husband was no vampire! It's "
"ridiculous! No one will listen to me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e924_Oblivion_RESP1"
msgid ""
"Please... please. The Grand Elixir of Exploration takes incredible "
"concentration to create. So, shhhhhh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001f3b8_Oblivion_RESP1"
msgid "Pleasure and pain be with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000206ca_Oblivion_RESP1"
msgid "Pleasure and pain be with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003b83c_Oblivion_RESP1"
msgid "Pleasure and pain be with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007ec63_Oblivion_RESP1"
msgid "Pleasure and pain be with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008d793_Oblivion_RESP1"
msgid "Pleasure and pain be with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003b82f_Oblivion_RESP1"
msgid "Pleasure and pain be with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00031618_Oblivion_RESP1"
msgid "Pleasure and pain, my lady."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00031619_Oblivion_RESP1"
msgid "Pleasure and pain, my lord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG01Choice2A_0002d6ea_Oblivion_RESP3"
msgid "Pleasure doing business with you, friend!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterBuyItem_000091ca_Oblivion_RESP1"
msgid "Pleasure doing business with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0ca_Oblivion_RESP1"
msgid ""
"Plenty of deer, wolf, boar, mountain lion, bear in the county. Just need to "
"know where to look for 'em."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c9ab_Oblivion_RESP1"
msgid ""
"Plenty of mineral desposits in the Jerall Mountains. I'm out for weeks at a "
"time by myself, but I don't mind it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGDPost1_0006e2dd_Oblivion_RESP2"
msgid ""
"Plus, members often find items in their travels they can't use, and they "
"leave them here for other members to use. Sometimes there's nice stuff."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00052228_Oblivion_RESP1"
msgid ""
"Poor Arnora. Seems her boyfriend, Jorundr, has stolen some gold from her and "
"left her penniless. Now he's in jail, and she's destitute."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00082604_Oblivion_RESP1"
msgid "Poor Big Head will never find the Fork of Horripilation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00034037_Oblivion_RESP1"
msgid ""
"Poor Gromm. I wonder what he'll do now that Baenlin is dead. Serving that old "
"man was the joy of his life, or so I've heard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000465b0_Oblivion_RESP1"
msgid "Poor Olfand. I don't know how he manages to live with Skjorta."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00033df4_Oblivion_RESP1"
msgid ""
"Poor Prior Maborel. He was dead when I came outside. Who could have done this?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00094ec9_Oblivion_RESP1"
msgid "Poor Rosentia, she's been trapped in her house for days."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed52_Oblivion_RESP1"
msgid ""
"Poor Thadon, he was such a handsome man... I enjoyed our midnight meetings. I "
"hope the new ruler of Mania is ready for me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000093c7_Oblivion_RESP1"
msgid ""
"Poor Tivela. I hear she is turning Cheydinhal inside out looking for her "
"husband, Rythe. I hope nothing bad has happened to him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BradonLirrianTopic_00038b03_Oblivion_RESP1"
msgid "Poor fella."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AldosOthranTopic_0003c2c2_Oblivion_RESP1"
msgid ""
"Poor fellow. You may be able to find him roaming the streets of Cheydinhal, "
"probably drunk. Only a month ago, he lost his wife."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00044225_Oblivion_RESP1"
msgid ""
"Power changes hands in Crucible, which means even less stability for the "
"Realm. Just what we needed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00012d11_Oblivion_RESP1"
msgid ""
"Power! I need power! Unless you can give me the magicka to help these "
"soldiers, get out of my way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG18Choice3A_00070487_Oblivion_RESP1"
msgid ""
"Power, my dear friend. I seek power, and so I acquire and study those who "
"have some degree of it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000296b_Knights_RESP1"
msgid ""
"Practice keeps the muscles loose, ready for combat. I intend to be at my best "
"if you need me, Sir Knight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c994_Oblivion_RESP1"
msgid ""
"Praise Akatosh! Praise the Nine! I'm Arentus Falvius, primate of Talos, High "
"Priest of Bruma Chapel."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_000614e5_Oblivion_RESP1"
msgid "Praise Arden-Sul the Chalice has been returned."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e8a4_Oblivion_RESP1"
msgid ""
"Praise Arkay, and all her little woodland creatures! I'm Hil the Tall, Priest "
"of Arkay. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000579be_Oblivion_RESP1"
msgid "Praise be to the Lord Molag Bal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MankarSpeech_0001f876_Oblivion_RESP1"
msgid ""
"Praise be to your Brothers and Sisters! Great shall be their reward in "
"Paradise!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MankarSpeech_0001fb31_Oblivion_RESP1"
msgid "Praise be!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MankarSpeech_0001fb32_Oblivion_RESP1"
msgid "Praise be!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MankarSpeech_00024e61_Oblivion_RESP1"
msgid "Praise be!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MankarSpeech_00024e62_Oblivion_RESP1"
msgid "Praise be!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033b2c_Oblivion_RESP1"
msgid "Praise the Nine!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASheogorathSpeech_00095789_Oblivion_RESP1"
msgid ""
"Praying to yourself, my Lord? That's not a good sign. Or perhaps it is. "
"Prince of Madness, and all that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033b31_Oblivion_RESP1"
msgid "Precedeth most urgentlike."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008dd64_Oblivion_RESP1"
msgid "Precious order to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08reject_000146fe_Oblivion_RESP1"
msgid ""
"Preparation is the key to success. Come back to me when you are better "
"prepared."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03GrommokChamberOneGrow04_00066e5a_Oblivion_RESP1"
msgid "Prepare yourselves for battle!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_0002b1e3_Oblivion_RESP3"
msgid ""
"Press the attack, and don't give him a chance to let off a spell! I don't "
"want to have to sweep your ashes out of the Arena!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PickpocketNoCrime_0006250a_Oblivion_RESP1"
msgid "Pretty quick fingers you've got there, friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e550_Oblivion_RESP1"
msgid ""
"Pretty scary, isn't he? Jayred's planning on killing him. I don't know how... "
"the Gatekeeper looks indestructible to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033363_Oblivion_RESP1"
msgid ""
"Pretty soon you'll go mad, and the guards will cut your throat just to stop "
"the ranting. That's right. You're going to die in here, Wood Elf! Die!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_LeyawiinTopicDecentius03_000479f3_Oblivion_RESP4"
msgid ""
"Pretty soon, the beastfolk all knew how to read and write... which was handy, "
"since it made them better slaves for the Ayleids, hahaha."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0b5_Oblivion_RESP1"
msgid "Pretty, isn't it? And quiet. Not much work for us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003b972_Oblivion_RESP1"
msgid "Pretty, pretty forks. Singing sad, sad songs. Do you hear them?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraSpeech_0005c01b_Oblivion_RESP1"
msgid ""
"Priests of Arkay have intruded upon their squalor. I want you to help my "
"Forgotten kill these priests of the Light."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028a03_Oblivion_RESP1"
msgid ""
"Primo being here made no sense. Whoever our host is, why would he invite "
"someone who didn't even need the money?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028188_Oblivion_RESP1"
msgid ""
"Primo is a young man of refinement. This murder must be quite a shock for him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_000289f7_Oblivion_RESP1"
msgid ""
"Primo is young and rich. I can sense a good, decent person in there "
"somewhere. He just has to get his priorities straight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028f49_Oblivion_RESP1"
msgid ""
"Primo may be young, but he looks strong, and I'm sure he could handle himself "
"in a fight. I think I'm going to enlist his help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028f48_Oblivion_RESP1"
msgid ""
"Primo may be young, but he's no fool. He knows that the murder of two "
"innocent people doesn't bode well for his own safety."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_0002824f_Oblivion_RESP1"
msgid "Primo seems kind of nice. I just can't imagine him killing anyone. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_0002948f_Oblivion_RESP1"
msgid ""
"Primo was a young man, strong and full of life. Surely he would have been "
"able to defend himself against an attacker."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_0002826c_Oblivion_RESP1"
msgid ""
"Primo was my chance, do you understand me? He was wealthy! He could take me "
"away someplace! Whoever did this will pay!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028d2f_Oblivion_RESP1"
msgid ""
"Primo's a blue blood, a noble through-and-through. He thinks he's better than "
"most people, and in most cases he's right."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00086097_Oblivion_RESP1"
msgid "Prince and Power!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0005a752_Oblivion_RESP1"
msgid "Prior Dreth has tasked me to pray for Vitharn's safety."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32SiegeVitharn_0005a755_Oblivion_RESP1"
msgid ""
"Prior Dreth met with the Fanatics to turn them away. They did not see the "
"wisdom of his words."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQJauffreHelp_0005d2c9_Oblivion_RESP2"
msgid ""
"Prior Maborel and Brother Piner may also be able to help. You should speak to "
"them about it if you haven't already."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilWarning_0003eac6_Oblivion_RESP1"
msgid "Prisoner! Get in the cage!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenVoice_00033334_Oblivion_RESP1"
msgid "Prisoner! Get over by the window, now!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenBlades_00051d79_Oblivion_RESP1"
msgid "Prisoner! Help the Emperor!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilWarning_0003eac7_Oblivion_RESP1"
msgid "Prisoner! Into the cage, now!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenVoice_00024de6_Oblivion_RESP1"
msgid "Prisoner! Stand away from the door! Over by the window, now!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenBlades_00051d7a_Oblivion_RESP1"
msgid "Prisoner! The Emperor needs help!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenRenote_0000b226_Oblivion_RESP1"
msgid "Prisoner, I don't have time for your games. Do that again and die."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NQDGuardWarning_0018d1dd_Oblivion_RESP1"
msgid "Prisoners may not accept gifts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32HlovalsMagicka_00012d20_Oblivion_RESP1"
msgid ""
"Problem? I supose you think that everyone with stunted magicka has a "
"\"problem.\" You're nothing but a bigot. You're on the list now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e8c3_Oblivion_RESP5"
msgid ""
"Profaning the remains or souls of the dead is just wrong. And I'm uneasy "
"about tampering with other's minds and trafficking with Daedra."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00086561_Oblivion_RESP1"
msgid "Prompt attention to this matter will be rewarded."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeShield_00016537_Oblivion_RESP1"
msgid ""
"Properly timed, blocking can stagger your foe. That is the time to caress him "
"with your blade."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bca9_Oblivion_RESP1"
msgid "Protect and serve. It's what we do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008d317_Oblivion_RESP1"
msgid "Protect my little ones, Lord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenBlades_00051d78_Oblivion_RESP1"
msgid "Protect the Emperor!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Flee_00098385_Oblivion_RESP1"
msgid "Protect the ancestors!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000227b8_Oblivion_RESP1"
msgid "Protect yourself..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008e133_Oblivion_RESP1"
msgid "Protection does this woman seek in items of magic both strong or weak."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE35Brithaur_0007866b_Oblivion_RESP1"
msgid ""
"Prove to me he's gone, and the reward is as good as yours. Now please, get a "
"move on... I feel my bones getting more brittle as we speak."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraSpeech_0005c01d_Oblivion_RESP1"
msgid ""
"Prove to me that you deserve my favor. In Anga, my Forgotten have lived in "
"peace for many years. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08StartBattleNo_00082653_Oblivion_RESP1"
msgid ""
"Provide what aid you can, but I beg you to make haste. The enemy does not "
"wait long between attacks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08StartBattleNo_00082654_Oblivion_RESP1"
msgid ""
"Provide what aid you can, but I beg you to make haste. The enemy does not "
"wait long between attacks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36HeyYou_00061c41_Oblivion_RESP1"
msgid "Psssst. Over here. I need to talk to you. It's important."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00043019_Oblivion_RESP1"
msgid "Pssst. Buddy. Gimme the skooma already. Quit playing around!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00004b9e_DLCVileLair_RESP1"
msgid "Psst! Hey you! Yeah, you! Come here! I got what you need..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000c45bc_Oblivion_RESP1"
msgid "Psst! Hey you! Yeah, you! Come here! I got what you need..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0007311b_Oblivion_RESP1"
msgid "Psst! You got any Skooma?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Topic_00000912_Oblivion_RESP1"
msgid "Psst.  Over here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00035a21_Oblivion_RESP1"
msgid "Psst. Over here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0018bd82_Oblivion_RESP1"
msgid "Puny Elf! I'll pick my teeth with your spine!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00090b66_Oblivion_RESP1"
msgid "Push off, scroat! We got nothing to talk about."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047660_Oblivion_RESP1"
msgid ""
"Put on The Feed Bag! I'm Delos Fandas. We got food and drink, and lots of it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Steal_000624f9_Oblivion_RESP1"
msgid "Put that back, you worthless thief!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaChoice2B_0000c220_Oblivion_RESP2"
msgid ""
"Put that on, see if it fits okay. When you're ready for a match, I'll be "
"waiting. You want to fight, you talk to me. All right then."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00061c3d_Oblivion_RESP1"
msgid "Put that torch away. Do you want people to see us talking? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_0004666e_Oblivion_RESP1"
msgid ""
"Put your hands and your voices together for the two brave Heroes who have "
"come to rock the very foundations of this Arena! Lower the gates!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008e101_Oblivion_RESP1"
msgid ""
"Pyke has a new love in Hale, a woman named Zoe Malene. Will they ever find "
"true happiness and, if so, until when?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000825e4_Oblivion_RESP1"
msgid "Pyke, the Knight of the Thorn, lives in Hale."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Passwall_0007eae9_Oblivion_RESP1"
msgid ""
"Quaint, isn't it? Passwall sits in the Fringe of the Shivering Isles. It's "
"where the supplicants wait while the Blessing of Sheogorath takes hold."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00091a85_Oblivion_RESP1"
msgid "Questions?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ04PinerA2_00090995_Oblivion_RESP1"
msgid "Quick! He may need our help!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00051ea6_Oblivion_RESP1"
msgid "Quickly now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000919ba_Oblivion_RESP1"
msgid "Quickly now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00086783_Oblivion_RESP1"
msgid "Quickly, hurry to Silorn while there's still time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00089938_Oblivion_RESP1"
msgid "Quickly, quickly! There's no time!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002acbc_Oblivion_RESP1"
msgid "Quickly, we must speak."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00061ccb_Oblivion_RESP1"
msgid "Quickly, worm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_00003458_Oblivion_RESP1"
msgid ""
"Quiet, you fool. The Garden of Dareloth, on the Waterfront. Midnight. Be "
"there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c229_Oblivion_RESP1"
msgid ""
"Quill-Weave does a lot of traveling to research her books. She must have a "
"lot of experience to share."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECaldanaMonriusSkooma_0008f5f9_Oblivion_RESP1"
msgid "Quit playing around. Hand it over!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_000613e7_Oblivion_RESP1"
msgid "Quite a feat to get past the Gatekeeper."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001da53_Oblivion_RESP5"
msgid ""
"Quite a list of things to do, wouldn't you say? Well, enough of my monologue. "
"Time to feed!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f203_Oblivion_RESP1"
msgid ""
"Quite a shame that there's a new Gatekeeper. I'd been hoping to meet a few "
"more friendly faces."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03AResonatorofJudgmentT_00018df8_Oblivion_RESP3"
msgid "Quite clever, eh?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033763_Oblivion_RESP1"
msgid "Quite satisfactory."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark05FinChoice2B_0004ce4a_Oblivion_RESP1"
msgid ""
"Quite. Then you know he has dedicated his life to eradicating the Dark "
"Brotherhood, and doesn't appreciate when we operate within the Imperial City."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00048921_Oblivion_RESP1"
msgid ""
"R'vanni just wants to get along. No trouble. Anything you want. R'vanni's "
"know-nothing, good-for-nothing. Ask anyone. Just don't hurt R'vanni."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE14SpellVoice2_0004683d_Oblivion_RESP1"
msgid "RELEASE!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004767c_Oblivion_RESP1"
msgid ""
"Ra'Jiradh greets you. His brothers are Hassiri and Urjabhi. The Black Horse "
"Courier is our Imperial news service, chartered by the Elder Council."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476a4_Oblivion_RESP1"
msgid ""
"Ra'jhan has a fine house in Elven Gardens. Yes? It costs Ra'jhan many golds. "
"But it is very fine, yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_000476a5_Oblivion_RESP1"
msgid ""
"Ra'jhan used to share a house, but not now. Ra'jhan is very proud, work so "
"hard, now has house all his own."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE11RakheranConfrontCiirta01_0001a7c4_Oblivion_RESP1"
msgid ""
"Ra'kheran! You come to me with blades drawn? What is the meaning of this?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e8b3_Oblivion_RESP1"
msgid ""
"Ra'qanar is your friend, no? Your servant? Whatever you require? Ra'qanar "
"knows nothing... less, even. But Ra'qanar wishes to please."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0018abcd_Oblivion_RESP1"
msgid "Raelynn will finally get what's coming to her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND10UmarilVoiceSky_00002cca_Knights_RESP1"
msgid "Rahtan Pelinale na anda!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_00046667_Oblivion_RESP1"
msgid ""
"Raise your voices in cheer as we lower the gates and these two brave "
"combatants face their destinies!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022495_Oblivion_RESP1"
msgid ""
"Rallus and Antus need your help, whether they know it or not. There's no time "
"to waste."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Creatures_000224af_Oblivion_RESP1"
msgid ""
"Rallus knows why we have to be the ones to get rid of them. Antus... he's "
"another story."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0005323e_Oblivion_RESP2"
msgid ""
"Raminus Polus will want to speak with you. I must say, you will be a credit "
"to the guild. Arch-Mage Traven will be lucky to have you there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000bee4_Oblivion_RESP2"
msgid ""
"Raminus has told me good things about you. You have advanced quickly, and "
"show great promise."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488de_Oblivion_RESP1"
msgid "Ranaline. I cook at the Lonely Suitor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000807a1_Oblivion_RESP1"
msgid "Ranarr-Jo is dead. What am I to do now?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007f3a8_Oblivion_RESP2"
msgid ""
"Ranarr-Jo is in need of a hero, but I'm not certain you are to be that one. "
"First, you must earn his trust."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39RanarrJo_00072c95_Oblivion_RESP1"
msgid ""
"Ranarr-Jo sent you? Did you know that once he was king of the Shivering "
"Isles? Before Sheogorath? In fact, I was his queen. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39RanarrJo_00072c96_Oblivion_RESP1"
msgid ""
"Ranarr-Jo. He protects me, like a valiant knight. Always rooting out spies "
"and ne'er-do-wells. He's so good at it, I've never seen one yet!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00071f45_Oblivion_RESP1"
msgid "Rany Roo! Rany Roo!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolNQDResponses_00029fcb_Oblivion_RESP1"
msgid ""
"Rasheda does a good job keeping Fire and Steel stocked with good weapons. "
"Maybe not the best in Tamriel, but good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479e1_Oblivion_RESP3"
msgid ""
"Rats in a Cream Sauce. Rat Flambe. Rat Necrom, with Bone Meal Gravy. Deep "
"Fried Rat. Lemon Rat and Wild Rice. Rat Ragu, with Powdered Deer Penis!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThreeSigns_00026af5_Oblivion_RESP2"
msgid ""
"Rats, I would imagine. Horrible little things. I always keep a powerful rat "
"poison around in case I see one of the little monsters."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThreeSigns_0006bf17_Oblivion_RESP2"
msgid ""
"Rats, I would imagine. Horrible little things. I always keep a powerful rat "
"poison around in case I see one of the little monsters."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479e0_Oblivion_RESP1"
msgid ""
"Rats. Hate them. HATE them. Every one. Gonna hunt them down and chop them all "
"to tiny bits."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e5a_Oblivion_RESP1"
msgid ""
"Rats? They've got Fighters Guild people out killing rats? You're kidding, "
"right?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077d0d_Oblivion_RESP1"
msgid "Raven-Biter runs the Choosy Beggar. Not a bad place."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RaynilDralasTopic_0003842b_Oblivion_RESP1"
msgid ""
"Raynil is staying in the last room down the hall upstairs. Here's the key."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038580_Oblivion_RESP2"
msgid ""
"Raynil was spotted heading west out of Bruma. The scout tried to follow, but "
"lost him in the mountains."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Gelebourne_00038582_Oblivion_RESP1"
msgid ""
"Raynil will pay for both crimes. Gelebourne was likely another innocent he's "
"slain. I'll make sure Skingrad's city watch hears of this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005c0d7_Oblivion_RESP1"
msgid "Reach for glory, Rose-Bearer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22MaricHighFane_00086746_Oblivion_RESP2"
msgid ""
"Read \"The Cleansing of the Fane.\" You may be less eager to seek the High "
"Fane then."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_000277ba_Oblivion_RESP1"
msgid "Read any good books lately?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAHermaeusSpeech_000a9480_Oblivion_RESP1"
msgid "Read it, and gain knowledge of yourself. Go now. Learn, and remember."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f432_Oblivion_RESP1"
msgid ""
"Read your histories: a strong army guarantees a strong Realm. Good thing "
"Sheogorath's armies are back to full strength."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033b44_Oblivion_RESP1"
msgid "Ready for action!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000335e1_Oblivion_RESP1"
msgid "Ready for duty?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003103a_Oblivion_RESP1"
msgid "Ready to find J'skar?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000281a3_Oblivion_RESP1"
msgid ""
"Ready to test dialogue? Great! This should be my first time speaking with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000335e8_Oblivion_RESP1"
msgid "Ready?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033775_Oblivion_RESP1"
msgid "Ready?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033b3c_Oblivion_RESP1"
msgid "Ready?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_00022d9f_Oblivion_RESP1"
msgid ""
"Ready? Ready for what? You're Grand Champion! You've already won it all! The "
"whole damn thing! Ha ha ha ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_00022da0_Oblivion_RESP1"
msgid ""
"Ready? Ready for what? You're a champion now! The Grand Championship is the "
"only thing left!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_0000c1e6_Oblivion_RESP1"
msgid ""
"Ready? You call that ready? You're not even wearing your Battle Raiment! "
"Don't talk to me again until you're suited up, you disrespectful maggot!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE05HerdirInvestigateCurrentTask_000805f0_Oblivion_RES"
"P1"
msgid ""
"Really, Inquisitor. Are you not supposed to be the one in charge here? I "
"can't do all your work for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE01GateSpeech_0005a760_Oblivion_RESP1"
msgid ""
"Really, do come in. It's lovely in the Isles right now. Perfect time for a "
"visit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00019ace_Oblivion_RESP1"
msgid ""
"Really, ma'am, you'll need to start thinking for yourself. It is one of the "
"basic requirements of godhood."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03GreymarchTopic_0009101d_Oblivion_RESP1"
msgid ""
"Really, no need to trouble yourself with the details of that now. It would "
"just cloud your little mind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ADMIRELOVE_0018b2b0_Oblivion_RESP1"
msgid "Really, now. You're such a charmer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00019acd_Oblivion_RESP1"
msgid ""
"Really, sir, you'll need to start thinking for yourself. It is one of the "
"basic requirements of godhood."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05HerdirBeginChoice2_000805ee_Oblivion_RESP3"
msgid "Really, we should be going. Her Ladyship expects results!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NeutralReceive_000241ee_Oblivion_RESP1"
msgid "Really."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06TellKellenLie_00002b8b_Knights_RESP1"
msgid "Really. I see."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SurpriseReceive_00024244_Oblivion_RESP1"
msgid "Really?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE40SleepOutsideChoice1a_000790be_Oblivion_RESP1"
msgid ""
"Really? And it's a safe place? Not at the bottom of a tall wall? That's a "
"great idea! That sounds perfect."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate4_0001562b_Oblivion_RESP1"
msgid "Really? And whom might this figure be?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity5_00081e84_Oblivion_RESP3"
msgid ""
"Really? But I already have Din's Ashes. I'm afraid someone must have taken "
"advantage of your gullibility."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38OddityDonate_00081ea0_Oblivion_RESP3"
msgid ""
"Really? For free? That's so generous of you. I'll put this tomato right back "
"where it belongs in a place of honor!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38GuardChoice2_00023681_Oblivion_RESP1"
msgid ""
"Really? He's getting worse, then. Thanks for letting me know. If you think "
"he's becoming dangerous, you come straight to me and I'll handle it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38DeadYes2_00023679_Oblivion_RESP1"
msgid ""
"Really? He's really dead?! Thank you, thank you, thank you! I'm free, I'm "
"finally FREE!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HappyReceive_00023d32_Oblivion_RESP1"
msgid "Really? How thoughtful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47NeedAntidote_0003003f_Oblivion_RESP1"
msgid "Really? I find being invisible quite refreshing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00006925_Oblivion_RESP1"
msgid ""
"Really? I would never have guessed. Still, I don't think you'll have any "
"trouble with rats and goblins."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BOASTLIKE_00062315_Oblivion_RESP1"
msgid "Really? Interesting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseInquiry_0004ed81_Oblivion_RESP1"
msgid ""
"Really? It just so happens there is a modest shack overlooking the canal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JollringChoice1C_000844bf_Oblivion_RESP1"
msgid "Really? May I see it, please?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37Response_000452df_Oblivion_RESP1"
msgid ""
"Really? She wanted help? I could use some help. Actually I could use some "
"food. Do you have any? I'm not picky. Anything at all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38DeadYes2_00023678_Oblivion_RESP1"
msgid ""
"Really? She's really dead?! Thank you, thank you, thank you! I'm free, I'm "
"finally FREE!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07BurdA_0002008f_Oblivion_RESP1"
msgid ""
"Really? That is odd. I know for certain that she returned alone. I don't like "
"it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38BPNo_0001dc30_Oblivion_RESP1"
msgid "Really? That is surprising. I was SURE she was watching me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugo05_00090b78_Oblivion_RESP1"
msgid "Really? That's not what I heard. I heard you got made into a knight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseDecline_0004f20b_Oblivion_RESP1"
msgid "Really? Then you shouldn't have brought up the subject."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseBuyImperialCity_000531bc_Oblivion_RESP1"
msgid "Really? Then you've just become a homeowner. Here is your house key."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38DeadYes_00023677_Oblivion_RESP1"
msgid ""
"Really? They're really dead?! Thank you, thank you, thank you! I'm free, I'm "
"finally FREE!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FollowupNegative_00024238_Oblivion_RESP1"
msgid "Really? What a shame."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ISawIt_0002a399_Oblivion_RESP1"
msgid ""
"Really? With your own eyes? Damn. So we've got real trouble. And no emperor. "
"That's real bad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27UmbacanoA3_000a657b_Oblivion_RESP1"
msgid "Really? You astonish me! May I see it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003ea3a_Oblivion_RESP1"
msgid ""
"Really? You want to talk to me? Is this some kind of a joke? If you want to "
"help, just end my life. Kill me. Here, now!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38TSNo_0002366b_Oblivion_RESP1"
msgid ""
"Really?! So you're saying that neither Bernadette Peneles or Toutius Sextius "
"is part of the conspiracy against me? Hard to believe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f208_Oblivion_RESP1"
msgid ""
"Rebuilding the Gatekeeper is one of the few things that has gone right lately."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG00JoinA_0002d288_Oblivion_RESP2"
msgid ""
"Recommendations you need, from all guild halls in Cyrodiil. None will be easy "
"to acquire. Too many motives, too much noise."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001c4cc_Oblivion_RESP1"
msgid "Reconsider?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032ebe_Oblivion_RESP1"
msgid "Recruitment is down. Way down. That's a problem."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FrostSaltsTopic_00022f16_Oblivion_RESP1"
msgid ""
"Refined frost salts sounds like something that Julienne would specialize in. "
"You may want to go back to the University and speak to her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08CommanderBattle02_00018e68_Oblivion_RESP1"
msgid "Reform! Back to your ranks! More are coming!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08CommanderBattle02_000415df_Oblivion_RESP1"
msgid "Reform! Back to your ranks! More are coming!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03LexMyvryna_000355d2_Oblivion_RESP1"
msgid ""
"Regrettably I've no further use for you. If what I heard is true, you're the "
"thief. If what you say is true, the Gray Fox knows you are my informant."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Flee_00086082_Oblivion_RESP1"
msgid "Regroup!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488ca_Oblivion_RESP1"
msgid ""
"Regulus Terentius, Count Bravil. Good of you to introduce yourself, stranger, "
"but no point, really."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000748a1_Oblivion_RESP1"
msgid ""
"Regulus Terentius, Count Bravil. I'm really rather busy, and I doubt that you "
"have anything to say that I need to hear."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE13AllyShoutReinforcements_0004dbd5_Oblivion_RESP1"
msgid "Reinforcements! There, by the doors to Bliss!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ef2_Oblivion_RESP1"
msgid "Relan hears of Syl's torture. Relan likes what he hears. Syl is good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ed4_Oblivion_RESP1"
msgid ""
"Relan hears of this Reversal Chalice. It makes blood special, yes? Relan "
"would like special blood."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005edf0_Oblivion_RESP1"
msgid "Relan hears there's a new ruler in Bliss. Relan finds this interesting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00044238_Oblivion_RESP1"
msgid ""
"Relan hears there's a new ruler in Crucible. Relan finds this interesting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f22d_Oblivion_RESP1"
msgid ""
"Relan is jealous of the Gatekeeper. Relan wishes that he had swords for arms."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFellmoorTopic_0003be78_Oblivion_RESP2"
msgid ""
"Relan is the only one around here worth a damn. And that's only because he "
"loves to kill his pests."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00044219_Oblivion_RESP1"
msgid ""
"Relan understands the Great Torch burns again. Relan thinks this is a good "
"sign."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003be7d_Oblivion_RESP1"
msgid ""
"Relan. It is I who kills. It is I who hunts. It is I who keeps the fields and "
"farms clean for Cindanwe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PickpocketNoCrime_000626ba_Oblivion_RESP1"
msgid "Relax. I didn't see a damn thing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000366d0_Oblivion_RESP1"
msgid "Release me..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038ede_Oblivion_RESP1"
msgid ""
"Release! Sweet Release! After all these years, these decades, I am finally "
"free! And you! So... so fresh! I must feed! I must feed! Agghhhhh!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23RolandCalm_0001d4c5_Oblivion_RESP2"
msgid ""
"Relfina was the love of my life. For the first time, I had a positive "
"outlook. Then I saw Seridur looking at her with those coveting eyes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElixirofExploration_0004e916_Oblivion_RESP1"
msgid "Reliable as usual. Here's your gold."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c192_Oblivion_RESP1"
msgid ""
"Religion is definitely not a topic to bring up around Else. Swords, on the "
"other hand, she'll talk about."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09HaskillXaselm_00081a4c_Oblivion_RESP1"
msgid ""
"Relmyna prefers to conduct her experiments in privacy. You will have to deal "
"with her guardians to reach her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001e0e7_Oblivion_RESP1"
msgid "Remain leery of Seridur, he's much more cunning than you may suspect."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c249_Oblivion_RESP1"
msgid ""
"Reman Broder is great with a bow. I think he could shoot the grapes off the "
"vines, which is handy, since he works at the vineyard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038ad7_Oblivion_RESP1"
msgid ""
"Reman Broder, retired Archer, presently a grape-grower for the Surilies, at "
"your service. Are you looking for advanced training?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_00038ae0_Oblivion_RESP1"
msgid ""
"Reman Broder... he works Surilie's vineyard, I work Tamika's vineyard... "
"Reman spent 20 years in the legion, and he's an advanced Marksman trainer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS12Reman_000980f6_Oblivion_RESP2"
msgid ""
"Reman Cyrodiil not only was the conqueror of the Akaviri forces, but he "
"actually convinced them to help build the Empire as it is today. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture3_0007194d_Oblivion_RESP1"
msgid ""
"Reman Runestones are solitary monuments marked with green runes, almost "
"certainly named for Reman Cyrodiil, the First Era emperor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BOASTLIKE_0018b2b7_Oblivion_RESP1"
msgid "Remarkable."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDKnightsStartCombat_00002b50_Knights_RESP1"
msgid "Remember Anvil!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDKnightsStartCombat_00002b51_Knights_RESP1"
msgid "Remember Bravil!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0006b831_Oblivion_RESP1"
msgid "Remember Kvatch!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MartinBattleSpeech_0003d4fe_Oblivion_RESP1"
msgid "Remember Kvatch!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00058e04_Oblivion_RESP1"
msgid ""
"Remember Kvatch, that's our watchword. We won't let that happen here, don't "
"worry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0018d937_Oblivion_RESP1"
msgid "Remember me if you find more Shadowbanish Wine!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGEmperor23_00032685_Oblivion_RESP1"
msgid ""
"Remember me, and remember my words. This burden is now yours alone. You hold "
"our future in your hands."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008655f_Oblivion_RESP1"
msgid "Remember me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ00BladesResponse_00061389_Oblivion_RESP1"
msgid ""
"Remember our history. The Blades were here waiting for Tiber Septim, and we "
"will be here still when the next Dragonborn appears."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GuardTalk1_0006fdce_Oblivion_RESP1"
msgid ""
"Remember that Argonian? The one from yesterday? Little bugger pulled a knife "
"on me earlier. I had to put him down. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0018bd74_Oblivion_RESP1"
msgid "Remember the Emperor!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0002798c_Oblivion_RESP1"
msgid ""
"Remember the pretenses under which the guests are there. They will be "
"suspicious. You must be as effective an actor as you are a killer. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0014c719_Oblivion_RESP1"
msgid ""
"Remember to keep the blindfold on. Your eyes must only be used to read the "
"scrolls."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e5d_Oblivion_RESP1"
msgid ""
"Remember when our new master was just a rookie? Who would have thought that a "
"bottom boot would save the whole guild from the Blackwood Company?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MartinD1_0009ce83_Oblivion_RESP5"
msgid ""
"Remember when we first met in Kvatch? I told you that I didn't want any part "
"of the gods' plan."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003d4c2_Oblivion_RESP1"
msgid "Remember, 11 in the evening. Don't disappoint me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000a9346_Oblivion_RESP1"
msgid "Remember, I will be expecting you at Nenalata in three days time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterExit_0003d08c_Oblivion_RESP1"
msgid "Remember, act casual, like we haven't done anything illegal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004e950_Oblivion_RESP1"
msgid ""
"Remember, always look near water. That's the best place to find Nirnroot."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001e68f_Oblivion_RESP1"
msgid "Remember, come to me for all your crafting needs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08accept_000146ff_Oblivion_RESP4"
msgid ""
"Remember, do not shed innocent blood. However, there is no bloodprice for "
"slaying the stone's guardians, human or inhuman."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0002c2f5_Oblivion_RESP1"
msgid "Remember, not a word to Teekeeus!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DeadDropTopic_00066a09_Oblivion_RESP2"
msgid ""
"Remember, secrecy is our greatest ally. We of the Black Hand avoid direct "
"communication whenever possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ08ArtifactTopic_00026efa_Oblivion_RESP2"
msgid ""
"Remember, the Mysterium Xarxes ritual will consume the physical form of the "
"artifact in order to release its daedric power."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS43Staff_00094ec8_Oblivion_RESP1"
msgid ""
"Remember, the only way to get rid of the staff is to leave it in that cave."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d7ed_Oblivion_RESP4"
msgid ""
"Remember, the portal closes behind you. Anything you need, carry it with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MysteriumXarxes_0003c268_Oblivion_RESP2"
msgid ""
"Remember, the portal will close behind you, so you will need to take "
"everything you need."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_000253e5_Oblivion_RESP1"
msgid ""
"Remember, timing is everything. You need to slash Motierre with the blade in "
"Hides-His-Heart's presence, and then flee before the enforcer can react."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0018ae79_Oblivion_RESP1"
msgid ""
"Remember, trespassing in the Imperial Palace is a serious crime. Do not "
"venture beyond the first and second floors."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00073123_Oblivion_RESP1"
msgid "Remember, walk lightly, and always look up."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0002798a_Oblivion_RESP1"
msgid ""
"Remember, you must make the other guests feel comfortable. Make them like "
"you. Make them TRUST you. Then bathe in their blood! Hehehehe!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000908e5_Oblivion_RESP1"
msgid "Remember. A knight's title shall be your reward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00060331_Oblivion_RESP1"
msgid "Remember. Bernadette Peneles. 6 am. Don't let her see you watching!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00086024_Oblivion_RESP1"
msgid ""
"Remember. Read \"The Cleansing of the Fane\" before deciding whether to seek "
"for Umbacano's treasure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005c0f8_Oblivion_RESP1"
msgid "Remember... this place is sacred."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37Errand_00045653_Oblivion_RESP1"
msgid ""
"Remind me to ask you about my bestiary. In the meantime, what have you found "
"for me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003c353_Oblivion_RESP1"
msgid "Remorse? Ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000165bd_Oblivion_RESP1"
msgid "Remove the prisoner."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_00024e1c_Oblivion_RESP1"
msgid ""
"Rena and I moved to Chorrol so we could have a nice, comfortable home for our "
"dogs. It's a lovely town. And our dogs are so happy here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004764b_Oblivion_RESP1"
msgid ""
"Renald Viernis. I'm the Practice Room Proctor. No horseplay or foolishness. "
"This is for serious exercises."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00040bbe_Oblivion_RESP1"
msgid "Rendil Drarara, chef extraordinaire at your service."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047712_Oblivion_RESP1"
msgid ""
"Renee Geonette. My husband, Salomon, has a court commission to compose a "
"symphony."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BSylLeaves_0003b825_Oblivion_RESP1"
msgid ""
"Replacing Thadon with this... outsider? This is how it ends. I should have "
"seen this coming."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00095a83_Oblivion_RESP1"
msgid "Report back as soon as you can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0005323c_Oblivion_RESP2"
msgid ""
"Report to the Arcane University, and speak with Raminus Polus. He will "
"provide further instructions for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Choice3_0002c7cb_Oblivion_RESP1"
msgid ""
"Report us? Oh, no. Why, we might never get work from the guild again! And "
"that would be different how, exactly?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003360e_Oblivion_RESP1"
msgid "Report, soldier."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48Convo_0002485b_Oblivion_RESP1"
msgid "Report, soldier."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27AyleidCrown_000a6581_Oblivion_RESP1"
msgid ""
"Reputedly the crown worn by the last king of the Ayleids. It deserves to be "
"part of my collection."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ErthorTopic_0002d926_Oblivion_RESP1"
msgid "Rescued him yourself, did you? Well, good for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004e955_Oblivion_RESP1"
msgid "Researching the Elixir has been exhausting, but well worth the time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE14Attacks_00046824_Oblivion_RESP1"
msgid ""
"Residents of Fellmoor have complained of creatures encroaching on their "
"lands. Perhaps you might be of some help, time permitting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004350c_Oblivion_RESP1"
msgid ""
"Resonator of Judgment is working again. Big deal; if it doesn't work on "
"Scalons, doesn't do us a lick of good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004f220_Oblivion_RESP2"
msgid ""
"Rest here for the night, and then continue along the Gold Road, heading east "
"towards Kvatch."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0b0_Oblivion_RESP1"
msgid ""
"Restless folks like you don't much like town life. Too slow and easy. For "
"you, the life of the rover... gold and glory, blood and treasure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Flee_0005c013_Oblivion_RESP1"
msgid "Retreat!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02OrcCaptainOrders_00018fc8_Oblivion_RESP1"
msgid "Retreat!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08CommanderBattle01_0005249c_Oblivion_RESP1"
msgid "Retreat! Retreat! Fall back to the town center! Now! Now! MOVE!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalSpeech_00084a4e_Oblivion_RESP1"
msgid ""
"Retrieve the Eye of Nocturnal, mortal, and return it to me, and I shall look "
"favorably upon you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00094eb9_Oblivion_RESP1"
msgid "Return anytime."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06HelpAttackA4_00012cd1_Oblivion_RESP2"
msgid ""
"Return at once when you have their deployments. This could make all the "
"difference."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001d4aa_Oblivion_RESP1"
msgid ""
"Return here when you've made your discovery. You'll find that Seridur is the "
"liar, not I."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG05Choice1A_0001e854_Oblivion_RESP4"
msgid ""
"Return it to me immediately when you have it. Make no mention of it to "
"Teekeeus or anyone else in your guild. I will make it well worth your effort."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGExpelYes_00026d96_Oblivion_RESP2"
msgid "Return only when you have the ingredients. You waste my time otherwise."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGExpelYes_00026d97_Oblivion_RESP2"
msgid "Return only when you have the ingredients. You waste my time otherwise."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000314fc_Oblivion_RESP2"
msgid ""
"Return to me in three weeks, and I'll have a special painting for you. It is "
"the least I can do for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAPeryiteSpeech_0008dd5e_Oblivion_RESP1"
msgid "Return to me when you are prepared."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VampireTopic_0001e0cd_Oblivion_RESP1"
msgid ""
"Return to me when you have slain another vampire, and the Order will gladly "
"reward you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0006244b_Oblivion_RESP3"
msgid ""
"Return to me when you have spoken with all of them. Then we shall talk of "
"training."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005d8ee_Oblivion_RESP1"
msgid "Return to your guild, and prepare yourself accordingly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGExpelYes_00025038_Oblivion_RESP2"
msgid "Return when you have everything."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGExpelYes_0002503d_Oblivion_RESP2"
msgid "Return when you have everything."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001c4d1_Oblivion_RESP1"
msgid "Return when you have the Madstone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40Choice3A_0009813a_Oblivion_RESP2"
msgid "Return when you possess a cure. Then I shall take you to the Count."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025e18_Oblivion_RESP2"
msgid ""
"Return with 20 minotaur horns if you wish to rejoin the Fighters Guild. "
"Perhaps you'll find redemption; perhaps you'll die trying. Go now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ShadeoftheRevenant_0000357d_Oblivion_RESP1"
msgid ""
"Revenant, you say? And it represents something in the Heavens? It sounds "
"familiar. Let me think..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003827b_Oblivion_RESP1"
msgid ""
"Reynald Jemane has a terrible memory. We've met many times, but when I saw "
"him in Cheydinhal, he walked right past me like we were strangers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReynaldJemaneTopic_00094075_Oblivion_RESP1"
msgid ""
"Reynald Jemane? No, don't know anyone by that name. There's a Guilbert Jemane "
"in town however. Maybe he can help you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c1c3_Oblivion_RESP1"
msgid ""
"Rhano is quite the swordsman. I've heard he'll train you for the right amount "
"of money."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e08b_Oblivion_RESP1"
msgid "Rhano. I'm Anvil's Advanced Trainer in Blade Weapons."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RiBassaTOPIC_00026b9a_Oblivion_RESP1"
msgid "Ri'Bassa is our shaman. You will find him in his house most of the time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03SyndelCrazyChatter_0008efad_Oblivion_RESP1"
msgid "Riches... countless riches! All mine!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AThadonLeaves_000206c3_Oblivion_RESP1"
msgid ""
"Ridiculous! You can't do this! Although... you're omnipotent. Or just tall. "
"It's one of the two, I'm sure. And a fool!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGFences_0001eb64_Oblivion_RESP1"
msgid ""
"Right here. I'm the best in the business. You've gained quite a reputation in "
"the guild. Let's see what you've got to sell me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028794_Oblivion_RESP1"
msgid ""
"Right now I'm more concerned with the person who's been left for dead in this "
"very house, not with that Legion dog."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028ce1_Oblivion_RESP1"
msgid ""
"Right now my main concern is figuring out who the killer is. She may be "
"young, but Dovesi is a suspect just like everyone else."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_000b12a0_Oblivion_RESP1"
msgid ""
"Right then. Head up the stairs, and it's the first door on your right. "
"Remember, I didn't say it was clean. I said it was cheap."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG04Choice3A_000300a4_Oblivion_RESP1"
msgid ""
"Right then. The bed is just upstairs, at the back of the inn. Sleep well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_000b9842_Oblivion_RESP1"
msgid ""
"Right then. Up the stairs in the back, and it's the last door at the end of "
"the hall, straight ahead of you after turning that corner."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08SheldenEnd_00043f70_Oblivion_RESP1"
msgid ""
"Right then. You lead the way -- just try not to get us killed. Well, try not "
"to get ME killed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaICRaiment1_0003b1dd_Oblivion_RESP1"
msgid ""
"Right! Okay... It is with great honor that I present to you this gold, and "
"the esteemed Raiment of Valor, and name you the new Arena Grand Champion!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaICRaiment2_0003b1de_Oblivion_RESP1"
msgid ""
"Right! Okay... It is with great honor that I present to you this gold, and "
"the esteemed Raiment of Valor, and name you the new Arena Grand Champion!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GreetingCaenlorn01_0003cf90_Oblivion_RESP1"
msgid "Right! The one in blue! You remembered."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice3A_000242b3_Oblivion_RESP1"
msgid "Right! We're off!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_000b124a_Oblivion_RESP1"
msgid ""
"Right! You'll have to go upstairs to the second floor. Your room is the "
"second door on the right before the staircase. Thank you for your patronage."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023dff_Oblivion_RESP1"
msgid ""
"Right, mister. We know who's been naughty and nice. And you've been naughty. "
"So watch yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002c7f0_Oblivion_RESP1"
msgid ""
"Right, mister. We know who's been naughty and nice. And you've been naughty. "
"So watch yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG01SulinusConv_0002d91b_Oblivion_RESP1"
msgid ""
"Right, okay. Listen, when you go back to Skingrad, don't tell Adrienne I was "
"the one who saved you, okay?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002b730_Oblivion_RESP2"
msgid ""
"Right, right. You were finding that fellow who's stolen my name. Have you had "
"any luck?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023dfe_Oblivion_RESP1"
msgid ""
"Right, sister. We know who's been naughty and nice. And you've been naughty. "
"So watch yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002c7ef_Oblivion_RESP1"
msgid ""
"Right, sister. We know who's been naughty and nice. And you've been naughty. "
"So watch yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000029e3_Knights_RESP1"
msgid "Right, then. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk5_00034059_Oblivion_RESP1"
msgid "Right, then. We should probably get back to our duties, eh?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00051793_Oblivion_RESP1"
msgid "Right, what can I do for you, citizen."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BrumaNQDQuestionResponses_000465eb_Oblivion_RESP1"
msgid ""
"Right-Wind certainly can handle a blade. No wonder he trains other Fighters "
"Guild members."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DinnerParty_0001c109_Oblivion_RESP1"
msgid ""
"Right. A big, fancy dinner party. You seem likeable, but not so much that I'd "
"just let you in there. And not dressed like that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark04DrethConvo_00045f87_Oblivion_RESP1"
msgid ""
"Right. And you'll be rich, too. Oh, and you'll become a king! You know what I "
"think, Dreth? I think you'll be back. You lot always come back..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG08ChoiceFinalYes_00035625_Oblivion_RESP1"
msgid ""
"Right. I'll get to work. You come see me tomorrow, and I'll have your staff "
"ready."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG17ChoicePositionA_0001544e_Oblivion_RESP1"
msgid "Right. I'm on my way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08NoBribeBeggar_00015f1c_Oblivion_RESP1"
msgid ""
"Right. I'm told it's a place where old priests care for moths that spin silk."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002887b_Oblivion_RESP1"
msgid "Right. Let's get to bashing some goblin skulls."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk5_0006a856_Oblivion_RESP1"
msgid "Right. Well, my contracts await. Maybe we can talk some more later."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk5_0018d7fb_Oblivion_RESP1"
msgid ""
"Right. Well, we'll all have to remain extra vigilant. But enough chatter. "
"Back to our duties, eh? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_0004990c_Oblivion_RESP1"
msgid ""
"Rindir always keeps a fine selection on hand. It's almost as if he knows my "
"skill level perfectly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004990e_Oblivion_RESP1"
msgid ""
"Rindir's Staffs is the best place in the city to buy a magical staff. Or is "
"it Rindir's Staves...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476cc_Oblivion_RESP1"
msgid ""
"Rochelle Bantien. Samuel's wife. I'm glad he's settled down to training and "
"the quiet life."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_000476a9_Oblivion_RESP1"
msgid ""
"Roderic is looking around for a business to invest in. I know he'll find "
"something soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark06FinChoice1A_0003005d_Oblivion_RESP2"
msgid ""
"Roderick has recently taken ill. He now lies in eternal slumber, kept alive "
"only by the daily administration of a powerful medicine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0000c0a5_Oblivion_RESP1"
msgid ""
"Roderick is a mercenary leader, and his people are fanatically loyal. They "
"will cut you to ribbons if they see you. And they will see you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034896_Oblivion_RESP1"
msgid ""
"Roderick is dead, and Sithis is appeased. Unfortunately, the same is not true "
"of the client who arranged this contract."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034894_Oblivion_RESP1"
msgid ""
"Roderick may lie near death, but dead he is not. Until his soul has passed, "
"our client -- and Sithis -- will not be satisfied."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark07MercConvo_00045f8c_Oblivion_RESP1"
msgid ""
"Roderick's fever is in check, unlike your tongue! How can you think such "
"things, after all he has done for us? For you? Have a little faith."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00049889_Oblivion_RESP1"
msgid "Rohssan is a talented smith. One of the best around, if you ask me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RolandJensericTopic_0001d4b5_Oblivion_RESP1"
msgid ""
"Roland was always a quiet man. It was only recently he'd met that young lady. "
"Poor girl. We must avenge her death."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RolandJensericTopic_0001d4b9_Oblivion_RESP1"
msgid ""
"Roland was very much the loner. He never married, and was rarely seen outside "
"his house. I'm surprised his secret wasn't discovered sooner."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000688f6_Oblivion_RESP1"
msgid "Roliand, all's well, I trust."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00068903_Oblivion_RESP1"
msgid "Roliand, thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG17ThalfinWhy_000366ef_Oblivion_RESP2"
msgid ""
"Rolis tried to make it through the door - he's the one that realized this "
"wasn't going to work. One of their patrols spotted us, and Rolis went down."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40Conversation_00098141_Oblivion_RESP1"
msgid "Rona, my dear, it's time to wake up."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00094ebb_Oblivion_RESP1"
msgid ""
"Rosentia sent word ahead that she has you to thank for freeing her of those "
"accursed little beasts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RufioTopic_000251e8_Oblivion_RESP1"
msgid ""
"Rufio is dead. He was murdered. It looks like he was hiding out from somebody "
"after all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RufioTopic_000272ad_Oblivion_RESP1"
msgid ""
"Rufio lies dead. Well done. The family will now welcome you with open arms."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RufioTopic_000251e7_Oblivion_RESP1"
msgid ""
"Rufio? He was killed! Murdered! Right here in my inn! And I thought business "
"was bad before. When this gets out, I'll never rent another room!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RufioTopic_00023dd3_Oblivion_RESP1"
msgid ""
"Rufio? He's an old codger. Been living here for a couple weeks now. If you "
"ask me, he's hiding from something. But what do I care? He pays his tab."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c1c7_Oblivion_RESP1"
msgid ""
"Rufrius Vinicius is good with his fists. I've seen him in action, and it's "
"impressive."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_CheydinhalNQDQuestionResponses_0003e963_Oblivion_RESP1"
msgid ""
"Rumor has it he joined the priesthood to avoid military service. What a "
"coward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00046629_Oblivion_RESP1"
msgid ""
"Rumor has it that Edla Dark-Heart left Skyrim with the law right behind her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_advancementFG_0003355a_Oblivion_RESP3"
msgid ""
"Rumor has it that Oreyn's looking for you. You didn't hear it from me, "
"though. Good work, and good luck."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_000498d3_Oblivion_RESP1"
msgid "Rumor has it that he'll teach others to pick locks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0002c5a2_Oblivion_RESP1"
msgid ""
"Rumor has it that the Fighters Guild is losing members to the Blackwood "
"Company."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03LlathasaIndarys_00045f76_Oblivion_RESP2"
msgid ""
"Rumor has it that there were strange circumstances with her death, if you "
"know what I mean."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CurrentEventsResponses_00024e77_Oblivion_RESP1"
msgid ""
"Rumor has it the Nerevarine has left Morrowind on an expedition to Akavir, "
"and has not been heard from since."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00042da9_Oblivion_RESP1"
msgid ""
"Rumor has it there's another adventurer trying to get into the Realm. One "
"more person to take up arms against me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS12Lost_00018237_Oblivion_RESP2"
msgid ""
"Rumors placed it in a snowy vale called Pale Pass. That's where Reman focused "
"his attention."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006a852_Oblivion_RESP1"
msgid ""
"Rumors? Oh! Well... Um... I... I heard you're the one who killed Adamus "
"Phillida! The skill you must possess!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesStaff_0002ba61_Oblivion_RESP2"
msgid "Run along and let him know I haven't changed my mind, will you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007302f_Oblivion_RESP1"
msgid "Run along and play!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081197_Oblivion_RESP1"
msgid "Run along back to Lord Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081d91_Oblivion_RESP1"
msgid "Run along now, little one. Go and play with the other godlings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001ad51_Oblivion_RESP1"
msgid "Run along now, see you later."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Flee_00025351_Oblivion_RESP1"
msgid "Run away!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008db91_Oblivion_RESP1"
msgid ""
"Run for your life and hide your head, the Knights of Order have returned. "
"These soulless beings know naught else but death and now we all shall burn."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASheogorathChoice2_00026ae2_Oblivion_RESP2"
msgid "Run for your life."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03SyndelChamberOneGnarl02_000648b7_Oblivion_RESP1"
msgid "Run for your lives!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008dc25_Oblivion_RESP1"
msgid ""
"Run headlong into the ruined city of Vitharn. There's nothing dangerous about "
"that place at all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE40SleepOutside_000790bf_Oblivion_RESP3"
msgid ""
"Run him through -- or, run him out, I mean. Yeah, get rid of him. Then, your "
"friend can sleep outside in Uungor's bed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VidkunTopic_0002e5ae_Oblivion_RESP1"
msgid ""
"Run into him, have you? As I said, he was incompetent. Couldn't pass a simple "
"lesson."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008dc17_Oblivion_RESP1"
msgid "Run into the water to escape a Scalon. They won't follow you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0004eda4_Oblivion_RESP1"
msgid "Run while you can, guild rat!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Flee_000872df_Oblivion_RESP1"
msgid "Run!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture2_00071929_Oblivion_RESP1"
msgid ""
"Runestones found in forts like Sancre Tor support a First Era date, though "
"the stones could have been moved to the forts from earlier sites."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005edbc_Oblivion_RESP1"
msgid ""
"Running Bliss must take a lot of energy. I'd rather just sit here. No reason "
"to do anything else."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004422d_Oblivion_RESP1"
msgid ""
"Running Crucible must take a lot of energy. I'd rather just sit here. No "
"reason to do anything else."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS26CorruptGuard_000363b8_Oblivion_RESP2"
msgid ""
"Ruslan and I were shopping at Jensine's when he accused us of stealing. We "
"turned out our pockets to prove we were innocent, but he didn't care."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000363bb_Oblivion_RESP1"
msgid ""
"Ruslan and Luronk are going around saying that some of the Imperial Watch are "
"corrupt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS26FromCustomers_00035ca1_Oblivion_RESP1"
msgid ""
"Ruslan and Luronk. Those idiots don't know when to stay quiet. Look, I'm not "
"telling you anything, stranger. I don't trust you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RytheLythandasTopic_0003267a_Oblivion_RESP1"
msgid ""
"Rythe Lythandas is one of the greatest painters in all Cyrodiil. Sadly, he's "
"gone missing. His wife, Tivela, is beside herself with grief."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00143f0a_Oblivion_RESP1"
msgid "Rythe Lythandas seems to be back in town. Wonder where he was off to?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14ReturnHome_0001c1cf_Oblivion_RESP1"
msgid "Rythe! Oh my love! You are home safe... I was so afraid..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022e5c_Oblivion_RESP2"
msgid ""
"S'Drassa of the Mages Guild, Evoker and Alchemist. And also, in his scant "
"free time, a Trainer in Alchemy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000478a7_Oblivion_RESP1"
msgid ""
"S'Drassa of the Mages Guild, Evoker and Alchemist. And also, in his scant "
"free time, a Trainer in Alchemy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0014c730_Oblivion_RESP1"
msgid ""
"S'Drassa of the Mages Guild, Evoker and Alchemist. And also, in his scant "
"free time, a Trainer in Alchemy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476e9_Oblivion_RESP1"
msgid "S'rathad greets you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_000476e8_Oblivion_RESP1"
msgid ""
"S'rathad learns the city by walking, talking, seeing it all. S'rathad thinks "
"this is the best way for you, too."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22SrazirrNotEnough_0002c81f_Oblivion_RESP2"
msgid ""
"S'razirr will not be cheated again. The question is asked again: will you pay "
"what was promised?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003da54_Oblivion_RESP1"
msgid ""
"S'shani. The old sea captain and rover... now a shipowner and fatcat. Pleased "
"to meet you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000093ae_Oblivion_RESP1"
msgid "S'wit of a thief."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Sithis_00086764_Oblivion_RESP1"
msgid ""
"S...  Sithis? Well... I am just a lowly Murderer, but... But I know Sithis is "
"our Dread Father. When we kill, we send him souls! Is that right?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434c2_Oblivion_RESP1"
msgid "Sad about the Gatekeeper. I wonder if he had anything worth keeping?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GlarthirTopic_0001dc27_Oblivion_RESP1"
msgid "Sad story. But at least we stopped him in time, thanks to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RaynilDralasTopic_00038f0f_Oblivion_RESP1"
msgid "Sad that Raynil slipped away like that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000541cf_Oblivion_RESP2"
msgid "Sadly I don't have any horses to sell. You bought our last Paint horse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_00035dd8_Oblivion_RESP1"
msgid ""
"Sadly, I don't have anything for you. I only work with the less experienced "
"guild members. You should go see S'krivva in Bravil from now on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035e01_Oblivion_RESP3"
msgid ""
"Sadly, you chose not to leave Phillida's severed finger as a warning to his "
"successor. Your laziness has cost you your bonus, I'm afraid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_00035dd9_Oblivion_RESP1"
msgid ""
"Sadly, you must demonstrate more skill before I can allow a commission job."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_001885d2_Oblivion_RESP1"
msgid "Safe journey to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001c4d8_Oblivion_RESP1"
msgid "Safe journey, milady."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00132aa5_Oblivion_RESP1"
msgid "Safe journey, milady."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001c4d7_Oblivion_RESP1"
msgid "Safe journey, milord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00132aa4_Oblivion_RESP1"
msgid "Safe journey, milord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000093a8_Oblivion_RESP1"
msgid "Safe journey, serjo."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00015f07_Oblivion_RESP1"
msgid "Safe journey."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000093af_Oblivion_RESP1"
msgid "Safe travels, muthsera."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00026bc1_Oblivion_RESP1"
msgid "Safe travels."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003aaae_Oblivion_RESP1"
msgid "Safe travels."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetStartA2_00002c82_Knights_RESP2"
msgid ""
"Saint Pelinal, the Divine Crusader of legend -- Alessia's companion when she "
"overthrew the rule of the Ayleids 3,000 years ago."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c1ed_Oblivion_RESP1"
msgid "Salmo's baking is fantastic. And her sweetrolls are unbeatable."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047710_Oblivion_RESP1"
msgid ""
"Salomon Geonette. I'm a musician. I had a commission from the Emperor to "
"compose a symphony..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000be55e_Oblivion_RESP1"
msgid "Salutations."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062c9c_Oblivion_RESP1"
msgid "Salute! Welcome! Please say your piece."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ShadyDeal_0001e7f5_Oblivion_RESP1"
msgid "Same assortment of things? I mean, I have enough clothing for now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000498df_Oblivion_RESP1"
msgid ""
"Samuel Bantien used to be a wild one. They say he used to be quite the "
"\"locksmith.\""
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000498e6_Oblivion_RESP1"
msgid ""
"Samuel Bantien used to be able to pick any lock in the city. He's settled "
"down now, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476ca_Oblivion_RESP1"
msgid ""
"Samuel Bantien. You want to learn a few tricks about Security, I'm your man."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_000476cd_Oblivion_RESP1"
msgid ""
"Samuel was a bit wild as a young man. The City will do that to you. Bad "
"company, bad influences."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002697a_Oblivion_RESP1"
msgid ""
"Sanguine has set you to a task. Do what you must, so we may drink to your "
"success."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026901_Oblivion_RESP1"
msgid "Sanguine is pleased. It is reason to celebrate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0005dc8c_Oblivion_RESP1"
msgid "Save me, Lord!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27HerminiaA1_000a55ff_Oblivion_RESP1"
msgid ""
"Save your breath. He's the only one who knows I have it. He's tried to get it "
"from me for years."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JanusHassildorTopic_00035e5a_Oblivion_RESP1"
msgid "Saved you, did he? Well, that's a good sign."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48HirtelC_0005d2cc_Oblivion_RESP4"
msgid ""
"Savlian says they can hold the road. No... no, I don't believe him. Nothing "
"can stop them. If you'd seen it, you'd know..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002855a_Oblivion_RESP1"
msgid ""
"Savlian's not really the captain, you know. We're just following him because "
"he's the highest ranking officer left alive."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMephalaSpeech_000579dc_Oblivion_RESP1"
msgid ""
"Savor the divine essence of a well-spun plot. And here's a little needle to "
"help you stitch your own tangled tapestries."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000919b5_Oblivion_RESP1"
msgid "Say it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000807a9_Oblivion_RESP1"
msgid "Say what you will, receive your answers, and leave me to my solitude."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONENTER_00062300_Oblivion_RESP1"
msgid "Say what you're going to say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062cd3_Oblivion_RESP1"
msgid "Say your piece or stand aside."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00084b46_Oblivion_RESP1"
msgid "Say, could you pour me another? I seem to have run dry..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46Goblins_000319ce_Oblivion_RESP3"
msgid ""
"Say, do you think you could help us? We need to get the goblins off our land "
"so we can start building our new settlement."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ08Wine_0018d92d_Oblivion_RESP3"
msgid ""
"Say, that gives me an idea. You look like the adventuring type. If you can "
"retrieve six bottles of Shadowbanish Wine, I'll gladly pay you well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001671f_Oblivion_RESP1"
msgid ""
"Say, you look like someone that could help us out. Having a bit of trouble "
"with another merchant in town who goes by the name Thoronir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001ad50_Oblivion_RESP1"
msgid "Saying goodbye is like ripping out a little piece of yourself. Ahhh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008e524_Oblivion_RESP1"
msgid "Saying goodbye is my favorite part of talking to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077c39_Oblivion_RESP1"
msgid "Scalons carry diseases. Lots of them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ScarTailTopic_00035593_Oblivion_RESP5"
msgid ""
"Scar-Tail has fled Black Marsh and refuses to fulfill his duties as royal "
"assassin! This is an act of treason! This treachery must be punished!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ScarTailTopic_00035594_Oblivion_RESP1"
msgid ""
"Scar-Tail is a traitor to Argonia, and a blight upon Tamriel! Kill him, as my "
"brother requests, and we will be forever in your debt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ScarTailTopic_00035595_Oblivion_RESP1"
msgid ""
"Scar-Tail now lies with the worms of Bogwater, thanks to you. I am forever "
"indebted to you, Brother."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ScarTailTopic_0003559a_Oblivion_RESP1"
msgid ""
"Scar-Tail now lies with the worms of Bogwater, thanks to you. I am forever "
"indebted to you, Sister."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ScarTailTopic_0003559b_Oblivion_RESP1"
msgid ""
"Scar-Tail was once as a brother to me and Ocheeva. But his act of treason "
"destroyed any vestige of that relationship. His death was well-deserved!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022b1a_Oblivion_RESP1"
msgid ""
"Search his body. I'll keep an eye out, in case any of his friends are nearby."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VampireAshTopic_000977d9_Oblivion_RESP5"
msgid ""
"Search near the North Panther River for Hindaril. If you can vanquish him, "
"his ashes will be more than adequate for my needs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0006139a_Oblivion_RESP1"
msgid ""
"Search the mountains in the northeast of Cyrodiil for Aerin's Camp. Aerin can "
"teach you all that you need to know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGRules_0001c154_Oblivion_RESP2"
msgid ""
"Second, never kill anyone on the job. This is not the Dark Brotherhood. "
"Animals and monsters can be slain if necessary."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS49RingNo_00091c5b_Oblivion_RESP1"
msgid "Secure it at once! It's the only thing we have left!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008674c_Oblivion_RESP1"
msgid "Secure those artifacts before it's too late."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FightersGuildTopic_00033dcd_Oblivion_RESP1"
msgid "See Azzan in Anvil for contracts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FightersGuildTopic_00033dca_Oblivion_RESP1"
msgid "See Azzan in Anvil or Burz gro-Khash in Cheydinhal for contracts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FightersGuildTopic_00033dcc_Oblivion_RESP1"
msgid "See Burz gro-Khash in Cheydinhal for contracts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterBuyItem_0003d080_Oblivion_RESP1"
msgid "See anything else you're interested in?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000b2d8_Oblivion_RESP1"
msgid "See anything you like?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Eavesdrop_0008117c_Oblivion_RESP1"
msgid ""
"See that you do so immediately. This is the one task which you were assigned. "
"If you cannot complete it, you will be removed. Are we clear?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Eavesdrop_00089445_Oblivion_RESP1"
msgid ""
"See that you do so immediately. This is the one task which you were assigned. "
"If you cannot complete it, you will be removed. Are we clear?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_information_00009224_Oblivion_RESP5"
msgid ""
"See to it that your leader, Traven, learns this as soon as possible. I have "
"no love for your guild, but I have no wish to see it destroyed either."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000981d4_Oblivion_RESP1"
msgid "See ya."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d48c_Oblivion_RESP1"
msgid "See you at eleven. I hope."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003d4cf_Oblivion_RESP1"
msgid "See you back in Anvil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00132a8b_Oblivion_RESP1"
msgid "See you back in Anvil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004e951_Oblivion_RESP1"
msgid "See you in 24 hours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000617a5_Oblivion_RESP1"
msgid "See you later."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003aab4_Oblivion_RESP1"
msgid "See you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000617b2_Oblivion_RESP1"
msgid "See you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005eec9_Oblivion_RESP1"
msgid ""
"See, I told you! These buildings just aren't safe. A huge Obelisk fell over "
"and destroyed Passwall."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00073927_Oblivion_RESP4"
msgid ""
"See, when they swing at you sidearm, you twist your wrist like this... "
"exactly! You're a natural at this. Let me show you another one..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BRIBE_0018b2be_Oblivion_RESP1"
msgid "See? Was that hard?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45MissingDaughter_0009f8bd_Oblivion_RESP1"
msgid ""
"Seed-Neeus is worried sick about her daughter Dar-Ma. If you think you can "
"help, you'll find her at her shop, Northern Goods and Trade."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00025282_Oblivion_RESP1"
msgid "Seeing you again is like a blessing from the Night Mother herself!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002527a_Oblivion_RESP1"
msgid "Seeing you in this Sanctuary makes me wish I were back on the streets."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02RelmynaVisit_0001a129_Oblivion_RESP1"
msgid "Seeing you warms my cold heart. Why has He forsaken us?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00062462_Oblivion_RESP2"
msgid "Seek her out at the Temple of the One in the Imperial City."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40JanusAccept_0003ed37_Oblivion_RESP4"
msgid ""
"Seek her out, and learn whether she can help. She lives somewhere along the "
"river, east of the Imperial City and south of Cheydinhal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_00002de1_Oblivion_RESP2"
msgid ""
"Seek more loot. Keep the fences busy with your profits. Then we can talk."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_tasks_000f5837_Oblivion_RESP1"
msgid ""
"Seek out Arch-Mage Traven. He has personally requested that you see him for "
"your next assignment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GarridansTears_00022e60_Oblivion_RESP3"
msgid ""
"Seek out Julienne Fanis at the Arcane University in the Imperial City. She "
"oversees the Alchemy Headquaters there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025035_Oblivion_RESP2"
msgid ""
"Seek out Raminus Polus at the Arcane University. He alone can open the guild "
"to you again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Nirnroot_0004e921_Oblivion_RESP2"
msgid ""
"Seek out Sinderion, a resident alchemist of Skingrad. Strange plants are his "
"specialty."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d152_Oblivion_RESP1"
msgid "Seek out Tooth-in-the-Sea. He can train you further. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06CasimirHurryUp_00002b26_Knights_RESP3"
msgid ""
"Seek out the Chapel of Stendarr in Chorrol. The priests there can assist you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000299e_Knights_RESP1"
msgid ""
"Seek out the priests in the Chapel of Stendarr. They may be able to help you "
"retrieve the Gauntlets I lost so many years ago."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterSellItem_00061c5d_Oblivion_RESP1"
msgid "Seems a fair bargain to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity8_00081e8e_Oblivion_RESP3"
msgid ""
"Seems like I've seen one of those before. But I guess it is Odd enough for "
"the Museum... but I certainly can't justify buying it from you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_000289f6_Oblivion_RESP1"
msgid ""
"Seems like a nice enough kid. A little too rich for his own good, maybe, but "
"I've met worse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_0002a33e_Oblivion_RESP2"
msgid ""
"Seems like you could handle trouble pretty well. Would you go see what's the "
"matter?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaNQDResponses_000465de_Oblivion_RESP1"
msgid "Seems odd, given his vocation. Still, I suppose there's no harm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JorundrTopic_0005371f_Oblivion_RESP2"
msgid ""
"Seems the only way he's going to tell us anything is if you end up in jail "
"with him."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_00061768_Oblivion_RESP1"
msgid "Seems things are a mess in New Sheoth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00046604_Oblivion_RESP1"
msgid "Seems to me that Ardaline has an admirer in Varon Vamori."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_00049914_Oblivion_RESP1"
msgid "Seems to me, some things are worth paying full price for."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0018bcb5_Oblivion_RESP1"
msgid "Seems you've bloodied your knuckles a few times."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c36f_Oblivion_RESP1"
msgid ""
"Seems you've made your choice. I suppose we'll have to do it your way. I "
"don't know what else to say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00073038_Oblivion_RESP1"
msgid "Seen any dead things laying around?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04ObelisksTopic_0009102d_Oblivion_RESP1"
msgid ""
"Seen them about, have you? Odd things. They've always been here, but they're "
"not OF here, if you take my meaning."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Ritual_00013660_Oblivion_RESP1"
msgid ""
"Seldom is the subject ever bro-... wait a moment, did you want to hear the "
"history of the Ritual?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09BodyParts_0001357b_Oblivion_RESP1"
msgid ""
"Select one pair of legs, one left arm, right arm, torso, head, and heart. See "
"me when you have finished your selections."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeleneTopic_00015716_Oblivion_RESP1"
msgid ""
"Selene no longer holds the Bloated Float. Once we get to the Imperial City, I "
"intend to make sure she is prosecuted to the fullest extent of the law."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000165bb_Oblivion_RESP1"
msgid "Selene'll get what's coming to her when we arrive home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_00035dd9_Oblivion_RESP3"
msgid ""
"Sell more stolen treasures to the fences. They will let me know when you have "
"proven skillful enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ThoronirBad_0000bca2_Oblivion_RESP3"
msgid ""
"Selling all sorts of merchandise, he undercuts prices like you wouldn't "
"believe. He doesn't always sell what we sell, but it is still a problem."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008118f_Oblivion_RESP1"
msgid "Send Relmyna my love. That'll get her going."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00094ec6_Oblivion_RESP1"
msgid ""
"Send Rosentia my regards. If there's anything else I can do, please let me "
"know!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000908f0_Oblivion_RESP1"
msgid "Send a moron to do a man's job..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfba_Oblivion_RESP1"
msgid "Send me a drink, barkeep. And make it quick."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfc6_Oblivion_RESP1"
msgid "Send over a drink. And make it quick!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d8c1_Oblivion_RESP1"
msgid ""
"Send them back to Oblivion! We'll hold the city in case any of them break "
"through."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECreatureResponses_0008e80f_Oblivion_RESP1"
msgid "Sendockle the Klen. Do you understand? The Klen!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035f35_Oblivion_RESP1"
msgid "Sent you in to try your hand at the thing, have they?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE08HaskillKnightsTopic1_00043f68_Oblivion_RESP3"
msgid ""
"Separate the meat from bone, and they will die. When they do so, their "
"crystalline hearts often remain intact. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002913_Knights_RESP1"
msgid ""
"Sergius Terrianus, at your service. Thedret and I go way back, and he said "
"there was need of a Blacksmith here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeridurTopic_0001db22_Oblivion_RESP1"
msgid ""
"Seridur is a nice enough fellow. For an Altmer, that is. I think he and "
"Gilen, and that Argonian, Grey-Throat, have some kind of a club."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeridurTopic_0001da5c_Oblivion_RESP1"
msgid ""
"Seridur is an honorable man. Forming the Order shows just how much he cares "
"about the Imperial City and protecting its people."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007504a_Oblivion_RESP1"
msgid ""
"Seridur is asleep right now. He's had a long night of study, and is "
"exhausted. Do not disturb him. He'll be up at five this evening."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000947b7_Oblivion_RESP1"
msgid ""
"Seridur is asleep right now. He's had a long night of study, and is "
"exhausted. Do not disturb him. He'll be up at five this evening."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeridurTopic_0001e0b3_Oblivion_RESP1"
msgid ""
"Seridur said we should meet without him for a few days. He said something "
"about doing field research? I'm sure he'll return soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeridurTopic_0001da5a_Oblivion_RESP1"
msgid ""
"Seridur? He comes in from time-to-time. Usually it's when he's out shopping. "
"He always comes in with a large amount of travel food in his bag."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeridurTopic_0001da60_Oblivion_RESP1"
msgid ""
"Seridur? He founded this group a few years ago. I was impressed with his "
"knowledge of vampires."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SurpriseReceive_00024247_Oblivion_RESP1"
msgid "Seriously?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002974_Knights_RESP1"
msgid "Serve the Nine with pride, Sir Knight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServeSentence_000281b7_Oblivion_RESP1"
msgid "Serve your time peaceably, and pay your debt to society."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfc7_Oblivion_RESP1"
msgid "Settle down, pondscum."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476c4_Oblivion_RESP1"
msgid ""
"Sevarius Atius. We will comply with the Watch's orders. The Atius family will "
"stay clear of the Sintavs... if they stay clear of us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e0d_Oblivion_RESP1"
msgid "Seven of the evening watch, and all's well. Everything's fine, ma'am. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023eb1_Oblivion_RESP1"
msgid "Seven of the evening watch, and all's well. Everything's fine, sir. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e1c_Oblivion_RESP1"
msgid ""
"Seven of the morning watch, and all's well. Top of the morning to you, ma'am. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023ee4_Oblivion_RESP1"
msgid ""
"Seven of the morning watch, and all's well. Top of the morning to you, sir. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesStaff_000352b6_Oblivion_RESP2"
msgid ""
"Several mages tend to the grove, and should be able to assist you. Speak with "
"either Zahrasha or Elette when you arrive. And choose wisely."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_000be328_Oblivion_RESP1"
msgid ""
"Several of the cities have sent aid. They're mustering on the plaza outside "
"the castle, if you want to review the troops."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG04Choice1A_0002ee4f_Oblivion_RESP2"
msgid ""
"Several traveling merchants have been found dead along the Gold Road "
"recently, with even more missing. The Council has asked that I put a stop to "
"it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0000a24d_Oblivion_RESP1"
msgid "Shadow hide the hunter."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0000bf9e_Oblivion_RESP1"
msgid "Shadow hide the hunter."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001465b_Oblivion_RESP1"
msgid "Shadow hide the hunter."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0000a21d_Oblivion_RESP1"
msgid "Shadow hide you, Pickpocket."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0000a21a_Oblivion_RESP1"
msgid "Shadow hide you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0000a21b_Oblivion_RESP1"
msgid "Shadow hide you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0000a21f_Oblivion_RESP1"
msgid "Shadow hide you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0000a231_Oblivion_RESP1"
msgid "Shadow hide you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001473d_Oblivion_RESP1"
msgid "Shadow hide you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00014832_Oblivion_RESP1"
msgid "Shadow hide you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00015308_Oblivion_RESP1"
msgid "Shadow hide you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00015f08_Oblivion_RESP1"
msgid "Shadow hide you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003c179_Oblivion_RESP1"
msgid "Shadow hide you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13JyggalagVoice_0009605a_Oblivion_RESP1"
msgid "Shadow of a god!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaChampName3_00038b40_Oblivion_RESP1"
msgid ""
"Shadowstep, huh? I like it! Yeah, that'll do nicely. All right, it's time to "
"see if you're crazy good or just plain crazy. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00063570_Oblivion_RESP1"
msgid "Shall I continue with you, Lord?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00063571_Oblivion_RESP1"
msgid "Shall I continue with you, Lord?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00027e38_Oblivion_RESP6"
msgid "Shall I open the portal to Paradise? Are you ready?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UmbacanoTopic_000a4963_Oblivion_RESP1"
msgid "Shall I show you up?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05HerdirGreetChoice1_000805ea_Oblivion_RESP3"
msgid "Shall we get to work? There's much to be done. So many people to visit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003376d_Oblivion_RESP1"
msgid "Shall we go?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00014abc_Oblivion_RESP1"
msgid "Shall we start the ceremony?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate3_00015861_Oblivion_RESP1"
msgid "Shall we try again?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Goblinhunting_00038ac2_Oblivion_RESP2"
msgid ""
"Shamans have wicked magics... drains, paralyze... bad stuff. Stand off and "
"shoot or spell shamans down if you can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG13EridorWhere_0000979f_Oblivion_RESP2"
msgid ""
"Shamar's up by the statue, Vontus is out in the High Pasture, and Carsten has "
"the town exit near the Castle covered."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008e65e_Oblivion_RESP1"
msgid "Shame on you for polluting Crucible with the glaring light of Mania."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetSpeechMQ4_00002d10_Knights_RESP1"
msgid ""
"Shame on you, people of Cyrodiil, and more shame for the children that you "
"give freely to the mouth of Destruction!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND10UmarilVoice_00002c3a_Knights_RESP1"
msgid "Shanta, ehlno. Tyavoy balangua!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00086090_Oblivion_RESP1"
msgid "Shatter, weakling!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39Kishashi_000781f1_Oblivion_RESP1"
msgid ""
"She a liar. Say she kill Minotaur with spoon. Ha. Ranarr-Jo, he trust nobody. "
"Except he trust this liar. Why? They strange. Not good neighbors."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BorderWatchTOPIC_000b122c_Oblivion_RESP4"
msgid ""
"She also has the finest collection of cheeses in the Empire! Her prized "
"cheese has such a powerful aroma, she keeps it sealed in a case!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EaranaTopic_000253c7_Oblivion_RESP1"
msgid ""
"She and I have an unpleasant history. She does not care for Guild "
"regulations, and errantly believes I am mis-using my powers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS21AnotherTask_000a657c_Oblivion_RESP3"
msgid ""
"She and I have had our differences over the years, I admit. Now she is taking "
"this opportunity to get her revenge."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05MazaddhaWhy_00081187_Oblivion_RESP2"
msgid ""
"She and Thadon... they've been meeting in secret. They've been doing things "
"together. Consorting. You understand me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11CiirtaTopic_00043f72_Oblivion_RESP5"
msgid ""
"She believed it so strongly that she led a revolt against Sheogorath when He "
"returned. She was imprisoned in the Howling Halls for her trouble."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c198_Oblivion_RESP1"
msgid "She can drink all she wants as long as she keeps doing such fine work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_0005319b_Oblivion_RESP1"
msgid "She can help us. She must help us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TarMeenaTopic_00002dcd_Oblivion_RESP2"
msgid ""
"She can likely be found in the Archives now, poring through materials on "
"Necromancy. She stops only to sleep, at the Arch-Mage's request."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_000825de_Oblivion_RESP1"
msgid ""
"She can make armor. And weapons. I've also heard she's found ways to make "
"magical versions, as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaNQDResponses_0004661e_Oblivion_RESP1"
msgid "She can spin a yarn, that's for sure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinNQDResponses_0003dfd2_Oblivion_RESP1"
msgid "She certainly can handle a blade. A bit of a show-off, if you ask me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalNQDResponses_0003e2ce_Oblivion_RESP1"
msgid "She certainly does take pride in the Newlands. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilNQDResponses_000465a2_Oblivion_RESP1"
msgid ""
"She certainly has a talent for speaking. Plus, she's willing to teach others "
"this skill."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06KanehTopic_00018dc4_Oblivion_RESP1"
msgid ""
"She commands the Aureals here at Cylarne. She has just arrived with "
"reinforcements from Brellach to end this stalemate once and for all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JeanneFrasoricTopic_0001cef5_Oblivion_RESP2"
msgid ""
"She couldn't cast her way out of a paper sack. It's insulting that we're "
"here, working for her, when she knows nothing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MythicDawnAlarm_0001fb39_Oblivion_RESP1"
msgid "She dares to touch the sacred Xarxes! Kill her!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EaranaTopic_0002a689_Oblivion_RESP2"
msgid ""
"She deals in half-truths at best, outright lies at worse. If you have any "
"information about her, or about her intentions, I expect you to inform me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000395e_Oblivion_RESP2"
msgid ""
"She didn't take the news well. Oreyn has been expelled. And, I'm sorry to do "
"this, but you've been demoted to Defender. You'll be fine, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGC01Choice4_0003663f_Oblivion_RESP1"
msgid ""
"She didn't, huh? Hmph. But, you've taken care of the problem, and I suppose "
"that's what counts. Thanks for that. Here's your payment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinNQDResponses_0003e218_Oblivion_RESP1"
msgid ""
"She does love to show off her skill. I suppose you can learn a lot from her, "
"though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00046647_Oblivion_RESP1"
msgid ""
"She doesn't leave home much, but apparently Luciana Galena has a lot of "
"experience fighting in light armor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37Errand_0008f558_Oblivion_RESP1"
msgid ""
"She doesn't like it when I run through her plants. All she seems to care "
"about is collecting plants and animals."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate1_00013fec_Oblivion_RESP1"
msgid ""
"She doesn't tell me where she goes. It's not my place to know. Please, "
"there's nothing else. There's nothing else to tell you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04BribeBeggar_0000932f_Oblivion_RESP2"
msgid ""
"She eats dinner in the castle at the eighth bell. You may have to sweet talk "
"her, but she knows all about Alessia Caro's habits and schedules."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27QuestStart_0002e5ce_Oblivion_RESP2"
msgid ""
"She fancies herself a student of the Ayleids, although she sadly lacks any "
"aesthetic instinct whatsover."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_00049931_Oblivion_RESP1"
msgid "She gives good prices for your old equipment."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEServiceProviderResponses_00078173_Oblivion_RESP1"
msgid "She has a gift for blades. No doubt about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_000613b2_Oblivion_RESP2"
msgid ""
"She has a very successful shop in the Market District of the Imperial City."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00016b87_Oblivion_RESP1"
msgid "She has darkened... what will we do now?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11RakheranGreeting3b_00019fcb_Oblivion_RESP2"
msgid ""
"She has forbidden me and those who support me from carrying weapons. And "
"suspicious would it look if we were to wander around gathering them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10IssmiTopic_00016813_Oblivion_RESP1"
msgid ""
"She has taken up control of what little force we have left. She waits for you "
"outside Brellach. Please hurry. There's not much time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0002db91_Oblivion_RESP2"
msgid ""
"She has visions, for lack of a better term. While they used to be helpful at "
"times, they have lately become problematic."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArdalineTopic_0002d2e5_Oblivion_RESP1"
msgid "She hasn't been focused on her work recently. It's annoying, frankly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40Allright_0003e955_Oblivion_RESP2"
msgid ""
"She hated what she had become, and refused to feed to keep herself healthy. "
"She eventually slipped into a coma from which she has not awoken."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14TruepaintTopic_0001c1c6_Oblivion_RESP4"
msgid ""
"She heard his plea, and gifted him with the Brush. It's said the bristles of "
"the Brush are woven from Dibella's own hair."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NarinaCarvainTopic_0003b3f0_Oblivion_RESP1"
msgid ""
"She holds public audience in the Great Hall on weekday mornings. If you need "
"to speak to her, that's the time to do it."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE09HaskillRelmynaVerenim_0004036b_Oblivion_RESP1"
msgid ""
"She is a powerful sorceress. She believes she has found a \"sixth element,\" "
"the element of Flesh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EaranaTopic_000253c9_Oblivion_RESP1"
msgid ""
"She is a scavenger, and has no respect for the power of the Arcane arts. She "
"has no business here, and I will not aid her in any way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11CiirtaTopic_00043f72_Oblivion_RESP1"
msgid ""
"She is an interesting character indeed. She is one of the very few "
"individuals in the Shivering Isles that is party to the secret of Sheogorath. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05FindMethredhel_00048978_Oblivion_RESP1"
msgid ""
"She is hiding in Dynari Amnis' house over in the Talos Plaza district. She's "
"one of the few that escaped when Lex invaded the Waterfront."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10AdeoTopic_00016816_Oblivion_RESP1"
msgid ""
"She is leading what is left of our forces. She waits for you outside Pinnacle "
"Rock. Please hurry to her before it is too late."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG07DagailConv_0001fbb6_Oblivion_RESP1"
msgid "She is not well. I hope her amulet can be found soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37Errand_0008f557_Oblivion_RESP1"
msgid ""
"She is obsessed with collecting plants and animals. I'd steer clear of her. "
"Now, do you mind moving? I need to sweep there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10DyloraTopic_00017d0d_Oblivion_RESP1"
msgid ""
"She is our commander. She leads us. Without her, we are at a loss. I have "
"done what I can to take her place, but I know I am insufficient."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10StaadaTopic_00016b39_Oblivion_RESP1"
msgid ""
"She is our commander. She leads us. Without her, we are at a loss. I have "
"done what I can to take her place, but I know I am insufficient."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40RonaWhere_0003ed3b_Oblivion_RESP1"
msgid ""
"She is safe, hidden within the castle. That is all you need know for now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07ASyl_00013ffd_Oblivion_RESP1"
msgid "She is staying well out of sight. No need to take unnecessary risks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06UlfriTopic_00018f8e_Oblivion_RESP1"
msgid ""
"She is the Grakedrig -- commander -- of the Mazken here at Cylarne. She has "
"never yet been defeated by the Aureals, despite their strength."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32Betrothed_00012d1f_Oblivion_RESP1"
msgid "She is the love of my life. I would do anything to save her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilNQDResponses_00046597_Oblivion_RESP1"
msgid "She is very well-spoken. I understand she teaches those skills as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_000498b1_Oblivion_RESP1"
msgid "She jumps like a toad. She'll also teach others how to do it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_0002878d_Oblivion_RESP2"
msgid ""
"She killed the others in cold blood, and she'll try to kill us next! I'm not "
"about to stand around waiting to die! We need to kill Matilde!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_LeyawiinNQDQuestionResponses_0003e256_Oblivion_RESP1"
msgid ""
"She knows a lot about doing business. I don't like to bother her, though. "
"She's a bit touchy when you do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39Cindanwe_000781f5_Oblivion_RESP3"
msgid ""
"She knows so much about us that she can read our minds! But she doesn't know "
"about you yet. So, you must do it. Get rid of her. Get rid of Cindanwe!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_000498c1_Oblivion_RESP1"
msgid "She likes jumping off things. That's because she's an idiot."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01BribeBeggar2_00016258_Oblivion_RESP1"
msgid ""
"She lives on the Waterfront. She's a late sleeper though, in bed from sunrise "
"'til noon. She hangs out in the Bloated Float after sunset."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04BribeBeggar2_0001625a_Oblivion_RESP1"
msgid ""
"She lives on the west side of town. She is fond of the Three Sisters Lodge in "
"the evening, but takes her midday meal at the Five Claws."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04WhereAhdarji_00048975_Oblivion_RESP1"
msgid ""
"She lives on the west side of town. She is fond of the Three Sisters Lodge in "
"the evening, but takes her midday meal at the Five Claws."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_00028789_Oblivion_RESP1"
msgid ""
"She looks pretty shaken, doesn't she? I can't tell if it's genuine fear or "
"just really good acting. She's as much a suspect as anyone, don't forget."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_CheydinhalNQDQuestionResponses_0003e993_Oblivion_RESP1"
msgid "She loves her dogs. No question about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e552_Oblivion_RESP2"
msgid ""
"She made him in the Gardens of Flesh and Bone. She's my teacher. She's going "
"to teach me all her secrets."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AgataTopic_00033799_Oblivion_RESP1"
msgid ""
"She may be young, but her heart is old and wise. It guides her well through "
"these troubled times."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_0002878a_Oblivion_RESP2"
msgid ""
"She may look old and weak, but that's never stopped a murderer before, has "
"it? Don't doubt for a second that she couldn't be the killer."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE02GatekeeperChoiceHowTears_0008e4f8_Oblivion_RESP2"
msgid ""
"She may seem like a tough woman, but the Gatekeeper makes her all weepy. Go "
"see for yourself. She visits him every night, around midnight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_00080d40_Oblivion_RESP2"
msgid "She might know something more than I do."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BrumaNQDQuestionResponses_000465fb_Oblivion_RESP1"
msgid "She moves really well in that armor, that's for sure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_0007096d_Oblivion_RESP2"
msgid ""
"She murdered all those innocent people, and I delivered justice, just like "
"any Legion soldier would. I... I only did what I thought was right...  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033359_Oblivion_RESP1"
msgid ""
"She must be so lonely. Don't you worry, eh? I'll take care of her long after "
"you're dead. Oh, that's right. You're going to die in here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_00049971_Oblivion_RESP1"
msgid "She must hate her job, people complaining to her all day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarMaTopic_000280ba_Oblivion_RESP2"
msgid ""
"She never showed up.  How am I supposed to run a shop without any "
"merchandise?  You tell her I want half off on my next delivery."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11CiirtaTopic_00043f72_Oblivion_RESP2"
msgid ""
"She once made her way into the throne room during the Greymarch and saw that "
"Sheogorath was nowhere to be found."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilNQDResponses_000465e2_Oblivion_RESP1"
msgid ""
"She probably takes on more than she should. Between smithing and training, "
"she's always hard at work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinNQDResponses_0003dfa1_Oblivion_RESP1"
msgid "She really doesn't seem to like her sisters. Sad, really."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BravilNQDQuestionResponses_00046579_Oblivion_RESP1"
msgid "She really is a gifted orator. I wish she'd teach me how to do that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03LlathasaIndarys_000092b2_Oblivion_RESP2"
msgid ""
"She remained young while he aged. Not too long ago she was found slain. It's "
"all hush-hush. Nobody knows exactly what happened."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalNQDResponses_0003e95a_Oblivion_RESP1"
msgid "She runs a good inn, and she's proud of it.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS31Wrath02Positive_00015261_Oblivion_RESP2"
msgid ""
"She said when we got back to the safe house in Bravil, we would divide the "
"loot after she fenced the damn thing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008e12d_Oblivion_RESP1"
msgid ""
"She seeks a cure to calm her ills and will gladly reward gold to pay your "
"bills."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23RolandSad_0001d4c6_Oblivion_RESP3"
msgid ""
"She seemed entranced as he wrapped his arms around her and sank his teeth "
"into her neck. I burst from my hiding place and attacked Seridur."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_000286e6_Oblivion_RESP1"
msgid ""
"She seems frightened, like the rest of us. I bet now she's regretting ever "
"stepping foot in this house, gold or no."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilNQDResponses_0003c265_Oblivion_RESP1"
msgid ""
"She seems like a good person to talk to. I imagine she could teach me a lot."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BrumaNQDQuestionResponses_000465fd_Oblivion_RESP1"
msgid ""
"She seems skilled in its use. I can see why the Fighters Guild has her "
"training others."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinNQDResponses_0003dfaa_Oblivion_RESP1"
msgid ""
"She seems to have real issues with her sisters. I can't imagine why. Shamada "
"is lovely, and Shomara is very sweet."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028709_Oblivion_RESP1"
msgid "She seems very upset by the murder. I do hope she'll be all right.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS51AccuseChoice1_00031510_Oblivion_RESP2"
msgid ""
"She shall be banished from Castle Chorrol and stripped of her duties. "
"However, I am not without pity, and therefore she shall not be jailed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS51AccuseChoice1_0003151f_Oblivion_RESP2"
msgid ""
"She shall be banished from Castle Chorrol and stripped of her duties. "
"However, I am not without pity, and therefore she shall not be jailed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeersStone_0001e067_Oblivion_RESP4"
msgid ""
"She shouldn't even be here anymore. Hell, the only reason her father ever fit "
"in anywhere is because he kept a low profile. And look what it got him!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_0004996d_Oblivion_RESP1"
msgid "She takes all the complaints, but nothing ever seems to happen."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BravilNQDQuestionResponses_00046641_Oblivion_RESP1"
msgid "She tends to keep to herself, that's for sure. That's too bad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_QuillWeaveTOPIC_00036637_Oblivion_RESP2"
msgid ""
"She thinks she's so smart. She and all the other women. I'll show her! I want "
"you to keep an eye on her. Find out what she's up to."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06MaikiChoiceA_00012cbe_Oblivion_RESP1"
msgid ""
"She thinks the Underdeep is a trap. It's true, if the Mazken knew we were "
"coming that way, we wouldn't stand a chance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilNQDResponses_0003c264_Oblivion_RESP1"
msgid ""
"She travels a lot to research her books. She's in great shape from all that "
"travel. Maybe she'd teach me a bit about getting into shape."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04AlessiaSchedule_0003b3fb_Oblivion_RESP2"
msgid ""
"She travels to Chorrol on the Ides of every month. Don't even try to find her "
"between the 15th and 17th."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07NewCaptain_0009839c_Oblivion_RESP1"
msgid ""
"She wants me to tip you! You add insult to injury. You cost my cousin a "
"chance at that job. Take your money and get out of my sight!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028d36_Oblivion_RESP1"
msgid ""
"She was a child, and some sick murdering dog struck her down in cold blood. I "
"swear, if I find out you did this I'll kill you with my bare hands."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VenaPetilius_00026b49_Oblivion_RESP1"
msgid ""
"She was a good woman, and Melus loved her as best he could. He was off "
"fighting when she died. A sudden fever, and she was gone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeleneTopic_0000c1ca_Oblivion_RESP1"
msgid ""
"She was a ruthless woman, and I'm glad she's behind bars where she belongs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeleneTopic_000c7630_Oblivion_RESP1"
msgid ""
"She was a ruthless woman, and I'm glad she's behind bars where she belongs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeleneTopic_0000c1c8_Oblivion_RESP1"
msgid "She was a ruthless woman, and I'm glad she's gone. Such a waste..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeleneTopic_000c762f_Oblivion_RESP1"
msgid "She was a ruthless woman, and I'm glad she's gone. Such a waste..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DagailTopic_0003395d_Oblivion_RESP1"
msgid ""
"She was a very powerful mage once, from what I understand. Hard to imagine "
"that, honestly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00053764_Oblivion_RESP1"
msgid "She was an evil, evil woman."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE09HaskillRelmynaVerenim_0004036b_Oblivion_RESP2"
msgid ""
"She was expelled from the Mages Guild for this belief, and for the... extreme "
"nature of her experiments."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Unseen_000038a5_Oblivion_RESP1"
msgid "She was here a second ago..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VenaPetilius_00026b4b_Oblivion_RESP1"
msgid "She was my wife, and I would rather not speak of her now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07TheFringeTopic_000912a2_Oblivion_RESP1"
msgid "She was right about that. I can feel it. In My bones. The little ones."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028712_Oblivion_RESP1"
msgid "She was so beautiful. And now she's gone..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EaranaTopic_00028c00_Oblivion_RESP1"
msgid ""
"She was unable to acquire the book, and that shall be enough for me. It would "
"be beneath me to continue this petty squabble."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BejeenTOPIC_00026ac6_Oblivion_RESP1"
msgid ""
"She wasn't a bad sort until she hooked up with that rascal Weebam-Na. That's "
"where you're likely to find her... at Weebam-Na's house."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06HelpDefendA3_00018f9a_Oblivion_RESP2"
msgid ""
"She will reveal all her plans to you, Sheogorath's emissary! Beautifully "
"devious. It embarrasses me not to have thought of it first."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SESylTopic_0008f177_Oblivion_RESP2"
msgid "She will suffer greatly at the hands of Lord Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ12JauffreMartin_0007be8f_Oblivion_RESP1"
msgid "She will. She must."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JeanneFrasoricTopic_0001ceec_Oblivion_RESP1"
msgid "She won't figure this out for weeks!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479d9_Oblivion_RESP2"
msgid ""
"She wonders why she cannot find me? Doesn't it occur to her? That I am hiding "
"from her?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00000812_AltarESPMain_RESP2"
msgid ""
"She worked in the Chapel of Akatosh in Kvatch. I haven't seen her in quite "
"some time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_000613a8_Oblivion_RESP2"
msgid ""
"She worked in the Chapel of Akatosh in Kvatch. I haven't seen her in quite "
"some time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008261c_Oblivion_RESP1"
msgid "She works the other residents pretty hard. I hear they're not happy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008261d_Oblivion_RESP1"
msgid ""
"She works them too hard. I'm sure they're looking to do something about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001333c_Oblivion_RESP1"
msgid "She would want me to die well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAClavicusChoice4_00026b17_Oblivion_RESP3"
msgid ""
"She'd always been fair with a sword, but she began looking for fights. Became "
"bloodthirsty. Then started calling herself Umbra, after the sword."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAClavicusChoice6_00026b19_Oblivion_RESP3"
msgid ""
"She'd always been fair with a sword, but she began looking for fights. Became "
"bloodthirsty. Then started calling herself Umbra, after the sword."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39Kishashi_000781f2_Oblivion_RESP1"
msgid ""
"She'll actually get something done. The problem with her is getting her "
"motivated. You have to play mind games, with that one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_00018290_Oblivion_RESP2"
msgid ""
"She'll come out of that gate with a warhammer the size of a child, and she'll "
"swing it until your head explodes! Don't let that happen!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028198_Oblivion_RESP1"
msgid ""
"She's a Dark Elf and a harlot, and for all I know she's a murderer too! Now "
"leave me be, you cretin!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028cdc_Oblivion_RESP1"
msgid "She's a Dark Elf. What, you blind as well as dumb?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09RelmynaVerenim_00014ae7_Oblivion_RESP3"
msgid ""
"She's a bit obsessed with it. And with Me. Makes dealing with her difficult. "
"You shouldn't have any problems, though. No one likes you that much."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BravilNQDQuestionResponses_00046631_Oblivion_RESP1"
msgid ""
"She's a bit strange, but I've heard she's rather good at not being seen, if "
"you know what I mean."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaNQDResponses_000465ae_Oblivion_RESP1"
msgid "She's a disgrace to our whole city. Poor Olfand."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c216_Oblivion_RESP1"
msgid "She's a hard worker, and they make some fine wine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilNQDResponses_0003c256_Oblivion_RESP1"
msgid ""
"She's a nut. Whatever's going on in that house, I don't want to know about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilNQDResponses_00046642_Oblivion_RESP1"
msgid "She's a sly one. I understand she's quite sneaky."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_LeyawiinNQDQuestionResponses_0003e2a7_Oblivion_RESP1"
msgid "She's a smart one. You could learn a lot from her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalNQDResponses_0003e99d_Oblivion_RESP1"
msgid ""
"She's a very demanding teacher. You can learn a lot from her, if you're "
"willing to try."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilNQDResponses_0004664b_Oblivion_RESP1"
msgid ""
"She's a very private person, but I've heard she has a lot of knowledge to "
"share."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MirisaTopic_000319d7_Oblivion_RESP1"
msgid ""
"She's a wilderness guide we hired to lead our expedition to Cropsford. Saved "
"our lives when the goblins attacked."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028a0f_Oblivion_RESP1"
msgid ""
"She's afraid for her life, as we should be! There's someone else in this "
"house, my friend. Someone hiding somewhere, killing us off one by one!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_00028c28_Oblivion_RESP1"
msgid ""
"She's afraid, and for good reason. If the killer strikes again, they may very "
"well pick an easy target, like Matilde. She needn't worry, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_00028232_Oblivion_RESP1"
msgid "She's all right, I guess. Not that it's any business of yours.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilNQDResponses_000465d7_Oblivion_RESP1"
msgid ""
"She's always busy, that's for sure. I have heard she's a good teacher, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008261a_Oblivion_RESP1"
msgid "She's always looking for new items for the Museum of Oddities."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BravilNQDQuestionResponses_000465e1_Oblivion_RESP1"
msgid ""
"She's an excellent alchemist. I understand she teaches the trade for Mages "
"Guild members."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028a05_Oblivion_RESP1"
msgid ""
"She's an innocent young girl, and she doesn't need people like you asking "
"questions about her. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AgataTopic_0003395f_Oblivion_RESP1"
msgid ""
"She's been a great help to all of us in the guild. Without her, I think "
"Dagail would be lost at times."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008262d_Oblivion_RESP1"
msgid "She's been paying well for certain magic items that might protect her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice2C_00022ba1_Oblivion_RESP3"
msgid ""
"She's been watching you. Observing as you kill, admiring as you end life "
"without pity or remorse. The Night Mother is most pleased..."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_00049894_Oblivion_RESP1"
msgid "She's certainly good. I'm glad she's willing to teach others."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005144a_Oblivion_RESP1"
msgid "She's dead. I'm sorry, sire, but we have to keep moving."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_0002878e_Oblivion_RESP1"
msgid ""
"She's dead. You wouldn't happen to know anything about that, now would you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39Cindanwe_000781f3_Oblivion_RESP1"
msgid ""
"She's dead? Very good. She was controlling our minds with evil magic. She's a "
"vampire you know. Yep, sucked my blood when I was asleep, every night. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_00002e54_Oblivion_RESP1"
msgid ""
"She's dead? What have you done? Of all the irresponsible.... I'm very "
"disappointed in you. You've let me down and your Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008dc9f_Oblivion_RESP1"
msgid ""
"She's definitely not trying to catalogue all the living things in the "
"Shivering Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_0002878c_Oblivion_RESP1"
msgid ""
"She's either a frightened old woman or a cold-blooded killer! I don't know "
"whether I should comfort her or hit her over the head with a rock!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003457e_Oblivion_RESP2"
msgid ""
"She's expelled Oreyn from the guild. Stripped him of all rank and privileges. "
"And you, she's demoted you. You've been busted down to Protector."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeatherleahTopic_000878d6_Oblivion_RESP2"
msgid "She's explored the back country outside of Chorrol quite a bit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028a0c_Oblivion_RESP1"
msgid ""
"She's frightened, of course. No one that young should be exposed to such "
"horrors."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TarMeenaTopic_00002dc4_Oblivion_RESP1"
msgid ""
"She's given you a book? I would know everything you have learned from it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e92_Oblivion_RESP1"
msgid ""
"She's got no business poking around in Brittlerock Cave, but the customer is "
"always right, eh?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MazogatheOrcTopic_00086069_Oblivion_RESP1"
msgid ""
"She's got terrible manners. Being her friend may be a lot of work. But my "
"sniffer says she might be worth it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05BribeBeggar2_00016250_Oblivion_RESP1"
msgid ""
"She's hiding in Dynari Amnis' house in the Talos Plaza district. She's one of "
"the few that escaped when Lex invaded the Waterfront."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_000498b3_Oblivion_RESP1"
msgid "She's impressive, and she'll train others."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05WhereSkrivva_00090c55_Oblivion_RESP1"
msgid ""
"She's in all the usual places. I'll need a donation to refresh my memory."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05BribeBeggar4_00090c56_Oblivion_RESP1"
msgid ""
"She's in the Lonely Suitor Lodge for her noon meal. That much I'm sure of."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32Betrothed_00012d03_Oblivion_RESP1"
msgid ""
"She's in the hands of the Fanatics! I must save her. Stand back, stranger. I "
"need room to swing my sword."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JearlTopic_000221f8_Oblivion_RESP1"
msgid ""
"She's just back from a trip south, they say. Haven't seen hide nor hair of "
"her myself though. Stays indoors all day long, I guess."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DagailTopic_00033960_Oblivion_RESP1"
msgid ""
"She's led such a troubled life. I just do what I can to make it easier on her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008dcb3_Oblivion_RESP1"
msgid ""
"She's looking for certain magic items that might protect her, but she's not "
"willing to pay for them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000165be_Oblivion_RESP1"
msgid "She's lucky I didn't have her tossed overboard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JeanneFrasoricTopic_0001cef5_Oblivion_RESP3"
msgid ""
"She's managed to butter up the right people just enough to keep her position, "
"and there's little we can do about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EaranaTopic_0002acc9_Oblivion_RESP1"
msgid ""
"She's nothing but trouble. She went to the University long ago, but was "
"expelled from the guild. Caused all kinds of trouble while she was there."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_000498c2_Oblivion_RESP1"
msgid "She's nuts. Her hobby is falling from high places."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KudEiTopic_00027f35_Oblivion_RESP2"
msgid ""
"She's offered a reward, but as far as I know, nobody's taken her up on the "
"offer. Not sure who's missing either, she's keeping quiet about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_000498b4_Oblivion_RESP1"
msgid "She's pretty amazing. Plus, she teaches others how to do it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalNQDResponses_0003e96e_Oblivion_RESP1"
msgid "She's pretty shy, unless you get her talking about armor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaNQDResponses_000465fc_Oblivion_RESP1"
msgid "She's quite a warrior. It's amazing how well she moves in heavy armor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028706_Oblivion_RESP1"
msgid ""
"She's quite beautiful, isn't she? A little young, perhaps, and not exactly "
"high-born, but she possesses a unique elegance. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BloatedFloat_00015714_Oblivion_RESP1"
msgid ""
"She's ready to sail, don't worry about it. We'll get you back home in one "
"piece."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_LeyawiinNQDQuestionResponses_0003e2b3_Oblivion_RESP1"
msgid ""
"She's ridiculous. I don't know what her problem with Argonians is, but she's "
"always trying to start something."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BrumaNQDQuestionResponses_000465ab_Oblivion_RESP1"
msgid "She's ridiculous. I suppose some may find it amusing, but not me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalNQDResponses_0003e97c_Oblivion_RESP1"
msgid "She's silver-tongued, but I don't want to listen to her."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_000498b2_Oblivion_RESP1"
msgid "She's something else. I've heard she'll train others, as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EaranaTopic_0002acba_Oblivion_RESP1"
msgid ""
"She's staying in one of the rooms upstairs, though she seems to spend most of "
"her time down by the Mages Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_00049890_Oblivion_RESP1"
msgid "She's the best I know. Luckily, she'll teach you some of her tricks."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BrumaNQDQuestionResponses_0004661d_Oblivion_RESP1"
msgid ""
"She's the best bard I've ever met. Of course, being a bard is almost as bad "
"as being a pilgrim. There's no future in it."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_00049896_Oblivion_RESP1"
msgid ""
"She's the best in the city. And, she'll teach others. It'll cost you, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkaleelTopic_00035f4d_Oblivion_RESP1"
msgid ""
"She's the mage heading up the on-site research. She can tell you more about "
"whatever it is that's impeding their progress."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AgataTopic_00033791_Oblivion_RESP1"
msgid ""
"She's the one you want to talk to if you actually need something to get done "
"around here. I don't even know why Dagail is still around."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_QuillWeaveTOPIC_00036637_Oblivion_RESP1"
msgid ""
"She's the one. She's never liked me or my sweet little pets. I know it's her. "
"I've even seen her sneaking around in back of my house at night."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_0002870b_Oblivion_RESP1"
msgid ""
"She's upset, you bufoon, just like the rest of us! Two people have been "
"murdered! I hope you're not suggesting she could be the killer!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_00028c26_Oblivion_RESP1"
msgid "She's upset, you idiot! Murder has that effect on people!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_CheydinhalNQDQuestionResponses_0003e971_Oblivion_RESP1"
msgid ""
"She's very dedicated. We would be lucky to have more people like her around."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE13AllyShoutReinforcements_0004dbb4_Oblivion_RESP1"
msgid "Sheogorath be praised! More Mazken have joined the fight!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS43Scamps_0004f8ba_Oblivion_RESP2"
msgid "Sheogorath certainly has a sick sense of humor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00060520_Oblivion_RESP1"
msgid ""
"Sheogorath gone, and me not far behind. I think this cold will finally be the "
"death of me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000605ec_Oblivion_RESP1"
msgid ""
"Sheogorath gone. The Duke gone. This whole thing is making me really, really "
"nervous. I need to calm down."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006039b_Oblivion_RESP1"
msgid ""
"Sheogorath gone? I'd check the bedchambers of every maiden in town... you'll "
"find Him eventually."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11CiirtaGreeting1a_00016b6e_Oblivion_RESP3"
msgid ""
"Sheogorath had fled! Left us all to die! I hid as the doors to the throne "
"room burst open."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_00061c6c_Oblivion_RESP1"
msgid "Sheogorath has abandoned the Realm. We're doomed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0004db7e_Oblivion_RESP1"
msgid "Sheogorath has abandoned you, fool!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09HaskillGatekeeper_0004036a_Oblivion_RESP2"
msgid ""
"Sheogorath has asked that you create a new Gatekeeper to stand watch over the "
"Fringe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000605f6_Oblivion_RESP1"
msgid ""
"Sheogorath has disappeared! How can I be expected to paint at a time like "
"this?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006052d_Oblivion_RESP1"
msgid "Sheogorath has disappeared. This is worse than my nightmares."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00014b6b_Oblivion_RESP2"
msgid ""
"Sheogorath has fallen and you seek the means to foil the machinations of the "
"Prince of Order. You seek the Throne of Madness."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00060365_Oblivion_RESP1"
msgid ""
"Sheogorath has left us to think for ourselves and to turn to Arden-Sul's "
"teachings for enlightenment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00060529_Oblivion_RESP1"
msgid ""
"Sheogorath has left. Where did he go? It's a mystery! I love mystery stories. "
"I wonder how this one will end."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008dcb4_Oblivion_RESP1"
msgid "Sheogorath has sent it away. It's definitely not back in the Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04ObelisksTopic_00091059_Oblivion_RESP2"
msgid ""
"Sheogorath has tried to remove them, but they always return. While they "
"cannot be destroyed, they can be rendered inert."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000605e9_Oblivion_RESP1"
msgid ""
"Sheogorath has vanished? Another already seeks his throne. One tyrant passes "
"and another rises. To the void with them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007fde5_Oblivion_RESP1"
msgid ""
"Sheogorath has vanished? He proves his cowardice! Leaving us here to die at "
"the hands of Order."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00060391_Oblivion_RESP1"
msgid ""
"Sheogorath has vanished? I certainly hope it had nothing to do with the "
"Greenmote Upsidedown Cake I sent to the Castle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00060521_Oblivion_RESP1"
msgid ""
"Sheogorath hasn't disappeared. Did you know that he and Jyggalag are the same "
"person? It's all very hard to understand."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE11SheogorathFarewell2_00014b56_Oblivion_RESP1"
msgid "Sheogorath is dead!!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081da2_Oblivion_RESP1"
msgid "Sheogorath is even more handsome in real life!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006050a_Oblivion_RESP1"
msgid ""
"Sheogorath is gone. Better carry a blade, just in case. Use it on your "
"enemies, if things get bad. Or on yourself, if things get worse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00060512_Oblivion_RESP1"
msgid ""
"Sheogorath is gone. Maybe I kidnapped him. That would merit a death sentence!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000603a2_Oblivion_RESP1"
msgid "Sheogorath is gone. This can only mean the end is near."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00060508_Oblivion_RESP1"
msgid "Sheogorath is gone? If he is gone, then who is watching us?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00060399_Oblivion_RESP1"
msgid ""
"Sheogorath is missing. A drink in his order is in honor. Honor is in order. "
"Whatever."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SESheogorathTopic_00078c69_Oblivion_RESP1"
msgid ""
"Sheogorath is our Lord, ruler of the Shivering Isles. It is by his whim that "
"the Mazken walk, and we serve our Master to the death."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000605ed_Oblivion_RESP1"
msgid ""
"Sheogorath leaves in the middle of the Greymarch. Perhaps I should take over "
"ruling the Realm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006036c_Oblivion_RESP1"
msgid ""
"Sheogorath may be gone, but I will still serve the House of Mania until my "
"death."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d81_Oblivion_RESP1"
msgid "Sheogorath must have Skooma!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11CiirtaGreeting1_00016b6d_Oblivion_RESP3"
msgid ""
"Sheogorath refuses to protect us. Madgod? Bah! The Greymarch brings darkness. "
"We seek light for all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SESheogorathTopic_00078c68_Oblivion_RESP1"
msgid ""
"Sheogorath rules the Shivering Isles. We, the Aureal, are His favored "
"soldiers, the most perfect expression of His might."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00016eaa_Oblivion_RESP1"
msgid "Sheogorath sent for me and I have arrived. That's all I know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32FanaticYell_0001b703_Oblivion_RESP1"
msgid "Sheogorath take your soul!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03AResonatorofJudgmentT_00018df8_Oblivion_RESP2"
msgid ""
"Sheogorath uses the Resonator to find the \"cream of the crop\" as he calls "
"them; the best of the worst to populate the Isles."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061c9f_Oblivion_RESP1"
msgid "Sheogorath victorious. Madness reigns!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_00061c70_Oblivion_RESP1"
msgid "Sheogorath will return. He must return!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081d90_Oblivion_RESP1"
msgid ""
"Sheogorath's Duchess or not, you try my patience! Are you confused about your "
"task?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00013562_Oblivion_RESP1"
msgid ""
"Sheogorath's Duke or not, you try my patience! Are you confused about your "
"task?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f3e9_Oblivion_RESP1"
msgid "Sheogorath's armies again can protect sweet Sheer-Meedish."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f3ed_Oblivion_RESP1"
msgid ""
"Sheogorath's armies are at full strength once more. They will be needed in "
"times ahead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f3ef_Oblivion_RESP1"
msgid ""
"Sheogorath's armies have returned. They'll protect me while I protect my "
"belongings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f41e_Oblivion_RESP1"
msgid ""
"Sheogorath's army is restored? I should find them. They'd be sure to kill me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f463_Oblivion_RESP1"
msgid ""
"Sheogorath's army is restored? That's good. You learn discipline in the army, "
"something folks around here are lacking."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00080d8d_Oblivion_RESP1"
msgid "Sheogorath's blessings upon you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00060535_Oblivion_RESP1"
msgid ""
"Sheogorath's gone. I wish I could just disappear that way. Sometimes I feel "
"invisible. But, that's not the same. I need a nap."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Seen_0001a7e3_Oblivion_RESP1"
msgid ""
"Sheogorath's pet! Her head will make a fitting ornament for our Lord "
"Jyggalag's throne room!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Seen_0001a7e2_Oblivion_RESP1"
msgid ""
"Sheogorath's pet! His head will make a fitting ornament for our Lord "
"Jyggalag's throne room!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12TraitorTaunts_0008f7c8_Oblivion_RESP1"
msgid ""
"Sheogorath's pet. That used to be me, so blinded by my suspicions that I "
"could not see the truth of my own situation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12RootDungeon_00016d04_Oblivion_RESP1"
msgid ""
"Sheogorath's private sanctuary, where he would often meditate amidst the tame "
"Gnarls that tend the roots."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_000919af_Oblivion_RESP1"
msgid "Sheogorath, guide my hand!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081d86_Oblivion_RESP1"
msgid "Sheogorath. What trouble brings you out this way?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003dfd0_Oblivion_RESP1"
msgid "Sherina is good with a blade. She knows it, too."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04DarkSecrets_0004f9ea_Oblivion_RESP1"
msgid "Shh! It's dangerous to be heard talking about that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_0003d077_DLCThievesDen_RESP1"
msgid "Shh! Keep it down. This isn't exactly legal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05EavesDropDetected_00081183_Oblivion_RESP1"
msgid ""
"Shh! Someone is nearby! We shouldn't speak now. Go, before we're spotted."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalConvo1_00026abb_Oblivion_RESP1"
msgid "Shh! There's someone here! Wait until they leave!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalConvo2_00084a3c_Oblivion_RESP1"
msgid "Shh! There's someone here! Wait until they leave!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Eavesdrop_00089441_Oblivion_RESP1"
msgid ""
"Shh! We are not alone! It's not safe to speak. Go, before someone sees us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00028753_Oblivion_RESP1"
msgid "Shh.  Not in front of the stranger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00028bc9_Oblivion_RESP1"
msgid "Shh.  The stranger is listening."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00097cab_Oblivion_RESP1"
msgid "Shh. The Master is speaking!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarMaTopic_0001778a_Oblivion_RESP1"
msgid "Shh. We can't talk here. They'll get suspicious. The girl is in danger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000982dd_Oblivion_RESP1"
msgid ""
"Shhh! This is our time for silent prayer. You may wait outside, or quietly in "
"here. We usually finish around the eleventh bell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e828_Oblivion_RESP1"
msgid "Shhh! Watch if you want, but don't bother anyone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00061458_Oblivion_RESP1"
msgid "Shhh! You'll spook the deer!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001d241_Oblivion_RESP1"
msgid "Shhh. Not here. Keep following."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AAnya_00013a6d_Oblivion_RESP1"
msgid "Shhh. The walls have ears!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ShadyDeal_0001e7fc_Oblivion_RESP1"
msgid "Shhhh, not so loud. How many time have I told you that?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00031611_Oblivion_RESP1"
msgid "Shhhh. The walls have ears!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004e954_Oblivion_RESP1"
msgid "Shhhhhh!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MouthofthePanther_00036601_Oblivion_RESP4"
msgid ""
"Ships are always careful to stay away from it, especially when its foggy on "
"the Bay. The rocks would tear right through a ship's hull like parchment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003cf86_Oblivion_RESP1"
msgid ""
"Ships sail from Anvil harbor for ports-of-call in Hammerfell, Summerset Isle, "
"Yokuda, and the Western Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_000613f1_Oblivion_RESP1"
msgid "Shocking! He hasn't been killed in ages."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThaedilResponses_00041215_Oblivion_RESP1"
msgid "Shockingly awful, if you really want to know. Worst I've ever seen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00073b63_Oblivion_RESP1"
msgid "Shoo! Flies, lice and disease? No, thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00067701_Oblivion_RESP1"
msgid "Shoo. Go. Begone. Things to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DirectionsLandmarks_0018bda1_Oblivion_RESP2"
msgid ""
"Shops and guilds are mostly inside the north walls, while the chapel, homes, "
"and one inn are inside the south walls."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DirectionsLandmarks_0018bd99_Oblivion_RESP2"
msgid "Shops are near the fountain and up the street west to the chapel."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DirectionsLandmarks_0018bda0_Oblivion_RESP2"
msgid ""
"Shops, guilds, and inns are south of the chapel, and some shops are by the "
"north wall."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_duties_000356c4_Oblivion_RESP2"
msgid ""
"Should he accept the position, you would be well-served. Rely on his wisdom "
"and experience more than I did, my friend. Good luck."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001205e_Oblivion_RESP1"
msgid "Should we continue on?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00028bbc_Oblivion_RESP1"
msgid "Should we do anything about...?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00030207_Oblivion_RESP4"
msgid ""
"Should you be confronted by this cowardly mage, do not hesitate to protect "
"yourself by whatever means possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004f220_Oblivion_RESP4"
msgid ""
"Should you be confronted by this cowardly mage, do not hesitate to protect "
"yourself with whatever means possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00024fd4_Oblivion_RESP2"
msgid ""
"Should you decide to further waste the guild's time, Raminus Polus at the "
"Arcane University can reinstate you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FingersoftheMountain_000240c4_Oblivion_RESP1"
msgid ""
"Should you go looking for it, I hope that it would be for the sole purpose of "
"bringing it here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062c88_Oblivion_RESP1"
msgid "Should you need something, I will be happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11StaffOfSheogorath_00014b54_Oblivion_RESP3"
msgid ""
"Should you succeed, you will be the first mortal to have a dedicated Daedric "
"artifact in your possession. This will be most interesting, indeed..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BloodgrassTopic_0005373f_Oblivion_RESP2"
msgid ""
"Should your travels happen to take you to a place where it grows, keep your "
"eyes open."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004f54b_Oblivion_RESP1"
msgid "Shouldn't have any more problems with those cats."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00046648_Oblivion_RESP1"
msgid "Shouldn't something be done about that abandoned house?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SECaldanaMonriusSkoomaNo_0008f670_Oblivion_RESP1"
msgid "Shouldn't tease me like that. I hope you trip and fall on a sword."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008591a_Oblivion_RESP1"
msgid "Shouldn't you be feeding the prisoners, slop drudge?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004f3e5_Oblivion_RESP1"
msgid "Shouldn't you be helping Norbert Lelles?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000327b7_Oblivion_RESP1"
msgid "Shouldn't you be in Bravil? Being useful?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22HighFane_0002c728_Oblivion_RESP1"
msgid "Shouldn't you be off to Malada to retrieve the carving I want?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001f3b9_Oblivion_RESP1"
msgid "Shouldn't you be on your way to the Sacellum?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0002ab8a_Oblivion_RESP1"
msgid "Shouldn't you be talking to anyone but me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000335f7_Oblivion_RESP1"
msgid "Shove off."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00049191_Oblivion_RESP1"
msgid "Shove off."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15OrtheEldamil_0003eab6_Oblivion_RESP1"
msgid ""
"Show me some respect, worm! Unless you want to end up in the cages with them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000335f1_Oblivion_RESP1"
msgid "Show me something."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00061399_Oblivion_RESP1"
msgid ""
"Show me that you can raise at least ten thousand gold for a business venture, "
"and I'll help you learn how to put it to good use."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46GoblinWar_00033ef6_Oblivion_RESP3"
msgid ""
"Show me the head, so I know it is safe for the settlers to return to "
"Cropsford."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00053752_Oblivion_RESP1"
msgid "Show me the proof."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033b3d_Oblivion_RESP1"
msgid "Show me to them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0018d2b8_Oblivion_RESP1"
msgid "Show me what you've got!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_0003d075_DLCThievesDen_RESP1"
msgid "Show me your stuff."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Yield_00025207_Oblivion_RESP1"
msgid "Show mercy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Seen_001854ea_Oblivion_RESP1"
msgid "Showing your face was the last mistake you'll ever make!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000ace29_Oblivion_RESP1"
msgid "Shrines are secret for a reason. People hate us. Ignorant fools."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c20d_Oblivion_RESP1"
msgid ""
"Shum gro-Yarug is the butler in Castle Skingrad. Who ever heard of an Orc "
"butler. Plus, he's in that \"Orc Social Club.\" What a joke."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003dfac_Oblivion_RESP1"
msgid "Shuravi runs a good inn, but she's awful with her sisters."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06ObelisksTopic_000910fa_Oblivion_RESP3"
msgid ""
"Shut them down where you can. And make sure to kill the Priests you see "
"around them. If you don't, they can reactivate the obelisk."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000825fa_Oblivion_RESP1"
msgid "Sickly Bernice in Crucible believes she is dying."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008dc2c_Oblivion_RESP1"
msgid ""
"Sickly Bernice is a funny nickname because she's dying, but thinks she's in "
"perfect health."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000825f9_Oblivion_RESP1"
msgid "Sickly Bernice is always looking for a miracle cure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000825f8_Oblivion_RESP1"
msgid ""
"Sickly Bernice is convinced she's dying. No wonder no one wants to eat at her "
"Taphouse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0007816b_Oblivion_RESP1"
msgid "Sickly Bernice's isn't a bad place. Just make sure to wash your hands."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006d605_Oblivion_RESP1"
msgid ""
"Sickly Bernice, proprietor. Don't get too close now. You might catch what I "
"have."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003b967_Oblivion_RESP1"
msgid ""
"Sickly Bernice, proprietor. Talk to me while you can. I don't think I've got "
"too long."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture3_0007194e_Oblivion_RESP1"
msgid ""
"Sidri-Ashak Runestones are single standing stones marked with green runes, "
"thought to be named for an obscure Akaviri potentate, Sidri-Ashak."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS11StillNone_0009215d_Oblivion_RESP1"
msgid "Sigh. How many times do I have to tell you? No proof, no accusation!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d48f_Oblivion_RESP1"
msgid "Signy wants to talk to you. I think you'll like what she has to say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000475b2_Oblivion_RESP1"
msgid ""
"Silana Blandia, Healer of the Leyawiin Chapel. Bless the Nine, and all the "
"faithful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000566f_Oblivion_RESP1"
msgid ""
"Silencer! At last you've arrived! Fear not, for the crisis that has "
"threatened the Dark Brotherhood has finally come to an end."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0000917d_Oblivion_RESP1"
msgid "Silencer! What news do you bring?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00036304_Oblivion_RESP1"
msgid "Silencer! You have returned! What news of the traitor?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark18Choice3C_00090797_Oblivion_RESP1"
msgid ""
"Silent even as Listener? Good. For now is the time to meditate upon all that "
"has transpired. And please, help yourself to this crypt's treasures."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DirectionsSleep_0018bd90_Oblivion_RESP1"
msgid ""
"Silverhome-on-the-Water is where the north wall meets the river. The Lonely "
"Suitor Lodge is in the port, across the south bridge."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03AInstMakeChoices_00018dfa_Oblivion_RESP1"
msgid ""
"Simple. Wait until the adventurers are in position, and then press a button!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d2aa_Oblivion_RESP2"
msgid ""
"Simply wonderful. I'm hesitant to even open the bottles... oh, thank you for "
"these."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e89e_Oblivion_RESP5"
msgid ""
"Since I read a lot, and speak well, and don't drink brandy from milk pails, I "
"guess I qualify as an Imperial."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27HerminiaF1_000a5608_Oblivion_RESP3"
msgid ""
"Since Umbacano has never laid eyes on the real Crown of the Ayleids, I doubt "
"he could tell the difference."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND09ProphetQuestions03_00002c16_Knights_RESP2"
msgid ""
"Since his return, Umaril has taken Garlas Malatar as his lair. That is where "
"you must seek him out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MelusPetiliusTOPIC_00026b47_Oblivion_RESP3"
msgid ""
"Since his wife, Vena, died, we haven't seen hide nor hair of the man. Gone "
"off by himself. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice1A_00028150_Oblivion_RESP3"
msgid ""
"Since no one's lived there for many years, it may be quite overgrown by now. "
"If you find it, let us know. We'll be waiting anxiously."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeatherleahTopic_000242ae_Oblivion_RESP3"
msgid ""
"Since ogres are cannibals, he didn't expect to find their bodies. Thankfully, "
"however, it seems that my mother managed to carry Reynald to safety."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27UmbacanoD1_000a6583_Oblivion_RESP4"
msgid ""
"Since the Throne Room has been sealed since the time of the Ayleids, it "
"should provide rich pickings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c93e_Oblivion_RESP1"
msgid ""
"Since the Xivilai Anaxes, lord of the Savage Garden, has fallen, you must now "
"face me in battle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00058b35_Oblivion_RESP3"
msgid ""
"Since the immediate threat to Cheydinhal is now eliminated, I will grant your "
"request and send reinforcements to Bruma."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture2_00071948_Oblivion_RESP1"
msgid ""
"Since the runestones have lost their enchantments, however, we may never know "
"why they were moved, or what function they served at First Era sites."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CloudRulerTempleTopic_0003406a_Oblivion_RESP2"
msgid ""
"Since then, it has served the Blades as a headquarters, fortress, and "
"sanctuary. We can protect Martin here until you recover the Amulet of Kings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_00047639_Oblivion_RESP3"
msgid ""
"Since then, the Imperial City has been Tamriel's foremost magical research "
"center."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VahtacenTopic_00035f3d_Oblivion_RESP2"
msgid ""
"Since we disposed of the creatures that had taken up residence here, it's "
"been nothing but a fight to figure out how the place works."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrisonVisitor_000732b3_Oblivion_RESP1"
msgid ""
"Since we don't have any Argonians, I can allow it. The Countess won't allow "
"visitors to Argonian prisoners. I'll be watching though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01ThievesTest_0001c14d_Oblivion_RESP1"
msgid ""
"Since we rarely get three potential recuits at the same time, I'll give you "
"one more shot. Amusei is a bungler and won't get this offer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018bc5f_Oblivion_RESP2"
msgid ""
"Since you are here, and since you want something, you are useful to me. "
"Travel to Bravil, and speak with S'Krivva. She should have a message for me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002e71e_Oblivion_RESP5"
msgid ""
"Since you have led us to victory, I am hereby giving you the honorary title "
"of a Knight of the Thorn."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00031eba_Oblivion_RESP5"
msgid ""
"Since you have led us to victory, I am hereby giving you the honorary title "
"of a Knight of the Thorn."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00074a92_Oblivion_RESP1"
msgid ""
"Since you managed to make a mess of the interrogation, we've got extra work "
"to do if we're going to stop the Blackwood Company."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD08Choice1_000356ef_Oblivion_RESP3"
msgid ""
"Since you seem eager to get started, follow me to the training area. We've "
"got a mission you might want a piece of."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElixirofExploration_0004e919_Oblivion_RESP3"
msgid ""
"Since you seem so adept at finding the elusive Nirnroot, if you wish to bring "
"me more, I'd be more than happy to compensate you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38DionneWarnChoice3_0001dcc5_Oblivion_RESP3"
msgid ""
"Since you were courteous enough to tell me the truth, I'll do the same by "
"trusting you to talk to a guard if he asks you to do anything... strange."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VampireTopic_0001da5e_Oblivion_RESP3"
msgid ""
"Since you're an honorary member of the Order, if you bring back proof you've "
"slain a vampire, we'd be glad to compensate you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00066edb_Oblivion_RESP1"
msgid ""
"Since you're here, I was wondering... do you think you could assist me? I'm "
"having a bit of a crisis."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03AHowDoI_00018df5_Oblivion_RESP3"
msgid ""
"Since you're up here, I can only surmise that adventurers are already "
"entering the dungeon as we speak."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07BurdA_0002008f_Oblivion_RESP2"
msgid ""
"Since you're working with Cloud Ruler Temple, I'm going to authorize you to "
"search Jearl's house. I'll pass the word to my men. We won't interfere."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07BurdB_00038bc6_Oblivion_RESP2"
msgid ""
"Since you're working with Cloud Ruler Temple, I'm going to authorize you to "
"search Jearl's house. I'll pass the word to my men. We won't interfere."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026ea7_Oblivion_RESP3"
msgid ""
"Since you've dealt with these Gates before, I'd like you to help the "
"Countess's guard close this gate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03NoneTaken_00067709_Oblivion_RESP2"
msgid ""
"Since you've left us vulnerable to attack, you must restore our second line "
"of defense... Xedilian."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d2af_Oblivion_RESP1"
msgid ""
"Sinderion in Skingrad is the elf you should speak with. He's a very talented "
"Alchemist."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00072e07_Oblivion_RESP1"
msgid "Sing for Big Head."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00072e28_Oblivion_RESP1"
msgid "Sing to Big Head. Sing to him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081dbf_Oblivion_RESP1"
msgid "Singings and ringings to you, Lord Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDSirBerichTopic_00002c7a_Knights_RESP3"
msgid ""
"Sir Caius tried to stop him. They fought, and Sir Berich slew Sir Caius with "
"the holy Sword, on the Priory steps."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_NDGauntletsoftheCrusader_00002b15_Knights_RESP1"
msgid ""
"Sir Casimir took the Gauntlets to war with him. After what happened with "
"Berich, who would try to stop him?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND02SirAmielBattleCall_00002c00_Knights_RESP1"
msgid "Sir Gregory, you are defeated. Sir Casimir, step forward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDShieldoftheCrusader_00002aef_Knights_RESP1"
msgid ""
"Sir Henrik spent his days looking for the Shield. He was so determined; we "
"all were in those days."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDShieldoftheCrusader_00002aee_Knights_RESP1"
msgid ""
"Sir Henrik wasn't drawn into the war as so many of us were. His mind never "
"left the Shield."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDBootsoftheCrusader_00002a44_Knights_RESP1"
msgid ""
"Sir Juncan was lost attempting to find the Gauntlets. At least he was spared "
"from the tragedy of the Order's last days. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002954_Knights_RESP1"
msgid ""
"Sir Knight, I was wondering... have you reconsidered my offer to join the "
"order?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000294e_Knights_RESP1"
msgid ""
"Sir Knight, allow me to introduce myself. I am Brellin of Silvenar, at your "
"service."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND02SirAmielBattleCall_00002c07_Knights_RESP1"
msgid ""
"Sir Knight, in three hundred years none have stood against us and lived. Step "
"forward and claim what is yours by right. May your faith be true."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND04Mace_00002acc_Knights_RESP1"
msgid ""
"Sir Ralvas quested for the Mace after Sir Berich's betrayal. He believed that "
"with the Mace, he would be able to bring the rest of us together."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND02SirAmielBattleCall_00002c02_Knights_RESP1"
msgid ""
"Sir Ralvas, you have fallen. Step back and let the challenge continue. Sir "
"Henrik, come forward and prove yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDUnderpallCaveTopic_00002bec_Knights_RESP2"
msgid ""
"Sir Roderic believed that it used to be the ancestral seat of Lord Vlindrel, "
"before some cataclysm buried it beneath the earth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDGreavesTopic_00002bf3_Knights_RESP2"
msgid ""
"Sir Roderic died so that I could bring you the Greaves. Use them to good "
"purpose."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDSirRodericTopic_00002a7c_Knights_RESP1"
msgid ""
"Sir Roderic has been avenged. Thank you. I wish he could have lived to join "
"the Order."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetB3_00002b82_Knights_RESP3"
msgid ""
"Sir Roderic hoped to find the Relics within Sir Berich's tomb. And he did."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDSirRodericTopic_00002a7b_Knights_RESP1"
msgid "Sir Roderic is a famous knight of Wayrest, in High Rock."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002994_Knights_RESP1"
msgid ""
"Sir Roderic is avenged! And you have recovered the Sword of the Crusader!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND08LathonSaySirRoderic_00002bea_Knights_RESP1"
msgid ""
"Sir Roderic... you were a brave knight and a good master. Long may your name "
"be remembered in the annals of the Relics."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaChampName10m_00038b39_Oblivion_RESP1"
msgid ""
"Sir Slaughter, huh? I like it! Yeah, that'll do nicely. All right, it's time "
"to see if you're crazy good or just plain crazy. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002995_Knights_RESP1"
msgid ""
"Sir knight! Thank Arkay you're back. I have terrible news. Sir Roderic... I "
"think he's dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029ae_Knights_RESP1"
msgid "Sir knight, I would speak with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS10AldosTalk_0003c2ba_Oblivion_RESP1"
msgid ""
"Sir, I must warn you that threatening a city guardsman is an offense "
"punishable by a fine of no less than 50 gold. Pay or be jailed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002952_Knights_RESP3"
msgid ""
"Sir, I pledge you my sword. I wish to join you in your quest to restore the "
"Knights of the Nine and defeat this... Umaril."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetE2_00002b77_Knights_RESP1"
msgid ""
"Sir, might I ask a boon? Let me come with you. I would become a Knight of the "
"Nine, and dedicate my life to the service of the gods."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateConv_00097c72_Oblivion_RESP1"
msgid "Sir, there's too many of them! We have to fall back!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS10AldosTalk_0003c2bc_Oblivion_RESP1"
msgid ""
"Sir, this property has been seized by his lordship, the Count of Cheydinhal. "
"Leave immediately."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48Convo_0002483f_Oblivion_RESP1"
msgid "Sir, we're all that's left. Berich Inian, myself, and these civilians."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48Convo_0002482a_Oblivion_RESP1"
msgid "Sir, yes sir!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008b5fe_Oblivion_RESP1"
msgid "Sir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bccd_Oblivion_RESP1"
msgid "Sir?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00049813_Oblivion_RESP1"
msgid ""
"Sire, Chancellor Ocato is expecting you. He had word of your arrival in the "
"capital."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_0004f778_Oblivion_RESP1"
msgid "Sire, we have to go now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk2_00068359_Oblivion_RESP1"
msgid ""
"Sire... we failed your father. The shame we all carry... But we will not fail "
"you!  History will not repeat itself, of this you have my solemn vow!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003402b_Oblivion_RESP1"
msgid "Sister, if I may have a word."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk4_00034051_Oblivion_RESP1"
msgid ""
"Sister, you are truly an asset to this Sanctuary. Here's hoping all of our "
"contracts work out that well!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022b11_Oblivion_RESP1"
msgid "Sit down. Don't say anything. Just do what I say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05RavenSpeech_00022dab_Oblivion_RESP1"
msgid "Sit down. Now. My patience is not unlimited."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003402f_Oblivion_RESP1"
msgid "Sithis be with you, Brother."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00007970_DLCVileLair_RESP1"
msgid "Sithis be with you, Brother."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003402e_Oblivion_RESP1"
msgid "Sithis be with you, Sister."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00007971_DLCVileLair_RESP1"
msgid "Sithis be with you, Sister."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00009178_Oblivion_RESP1"
msgid "Sithis be with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Sithis_00086765_Oblivion_RESP1"
msgid ""
"Sithis has blessed us with you, dear Listener. He is our Dread Father, and "
"his wisdom and terrible fury know no bounds."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0000917b_Oblivion_RESP1"
msgid "Sithis is Master! All hail the Dread Father!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Sithis_000251ea_Oblivion_RESP1"
msgid ""
"Sithis is the darkness of time immemorial. He is no Daedra, and dwells not in "
"the realm of Oblivion. No, Sithis is something altogether... different."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0018bd5e_Oblivion_RESP1"
msgid "Sithis will feast on your soul!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark12Choice1B_0005179c_Oblivion_RESP1"
msgid ""
"Sithis? What is this treachery? Who sent you? I don't know who is behind this "
"outrage, but I will have blood! To the Void with you, assassin!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GarlicTopic_00053736_Oblivion_RESP1"
msgid "Six cloves, just like I asked for. Very good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e1d_Oblivion_RESP1"
msgid "Six of the day's dawn, and all's well. Good morning, ma'am. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023ee6_Oblivion_RESP1"
msgid "Six of the day's dawn, and all's well. Good morning, sir. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e0e_Oblivion_RESP1"
msgid "Six of the day's dusk, and all's well. Good evening, ma'am. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023eb2_Oblivion_RESP1"
msgid "Six of the day's dusk, and all's well. Good evening, sir. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VahtacenTopic_00035f4e_Oblivion_RESP2"
msgid "Skaleel is there now, working on investigating the ruins."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Pillar_00035f3a_Oblivion_RESP5"
msgid ""
"Skaleel might have a book that would be useful, but she's been sulking over "
"the way Irlav's been treating her. Perhaps you could ask her for it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_00038ae5_Oblivion_RESP1"
msgid ""
"Skingrad is the wine-producing capital of Tamriel. You must sample our local "
"wines. You'll never taste better."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MartinBattleSpeech_0003d500_Oblivion_RESP1"
msgid "Skingrad!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_00038ae7_Oblivion_RESP1"
msgid ""
"Skingrad's wines are the best in Tamriel. I  invite you... try them for "
"yourself. Here, it is perfect for grapes, and perfect for wine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008db8d_Oblivion_RESP1"
msgid ""
"Skinned hounds are by far the most nasty dogs around. The best place for "
"these poison-loving pups is six feet underground."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECreatureResponses_0008e134_Oblivion_RESP1"
msgid ""
"Skinned hounds are by far the nastiest dogs around. The best place for these "
"poison-loving pups is six feet underground."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00046599_Oblivion_RESP1"
msgid ""
"Skjorta is a nuisance. She was running around town, drunk and naked again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c98a_Oblivion_RESP1"
msgid ""
"Skjorta. Nord Winds. We've got clothes and armor. And I've got a headache, so "
"keep your voice down, please."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GiftScript_0002fbad_Oblivion_RESP1"
msgid ""
"Skooma! Oh! Oh, yeah... You want to... want to be my friend? I'll... I'll "
"tell you what. Skooma's the only thing... the only thing I want..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008f7b2_Oblivion_RESP1"
msgid "Skooma! Skooma!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GiftScript_0004e0b4_Oblivion_RESP1"
msgid ""
"Skooma? Oh, yeah... Hey! You gave me some skooma! You are so... nice. Oh, "
"yeah... You're such a good... friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaChampName5_00038b3e_Oblivion_RESP1"
msgid ""
"Skullcrusher, huh? I like it! Yeah, that'll do nicely. All right, it's time "
"to see if you're crazy good or just plain crazy. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND10SirThedretSpeech02_00002cb7_Knights_RESP1"
msgid ""
"Slain in battle with the dread Umaril, by the grace and mercy of the Nine, "
"the Crusader lives again! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0004994d_Oblivion_RESP1"
msgid "Slash 'N Smash. Doesn't the name say it all?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark11Choice2B_00002dd2_Oblivion_RESP1"
msgid ""
"Slave of WHAT? Oh, all right, then! You're some kind of crazy, is that it? "
"Come here then! Show me what you've got!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_00028771_Oblivion_RESP1"
msgid "Slay the outsider!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036415_Oblivion_RESP1"
msgid "Slay the sacrifice. Lord Dagon thirsts for blood."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkGiftTopic_0004ce47_Oblivion_RESP1"
msgid "Sleep, dear friend. Sleep. And awake anew."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark06Choice2B_0004e9ae_Oblivion_RESP1"
msgid ""
"Sleep? But... Nah. No, I... I'm not tired. Not tired right now. I have lots "
"of... you know... energy. The skooma! I can feel it... in my veins..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_bed_0005dab2_Oblivion_RESP1"
msgid ""
"Sleepy, are you? Be careful, you might be ill. Or dying. You never know..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMephalaChoice2_00026b6b_Oblivion_RESP1"
msgid "Slink away, then, bug. Stay far, far from Mephala's web."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000164dc_Oblivion_RESP1"
msgid ""
"Slowly but surely, maggot. You got a good streak going. Don't sissy out on me "
"now! You ready for another match, or what?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5d4_Oblivion_RESP1"
msgid "Small fork on outside, or is it inside...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS09ImIn_00053724_Oblivion_RESP1"
msgid "Smart answer. Here's the deal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07GiveForgedLetter_000983a0_Oblivion_RESP1"
msgid ""
"Smart move. I hold the power in this castle. Don't forget it. Here is a small "
"token of my esteem."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008e10e_Oblivion_RESP1"
msgid "Smart she is, or so they say, eyes as sharp as keen as a blade."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_00024e14_Oblivion_RESP1"
msgid ""
"Smart thing is to join a guild. Any guild. Gets you a place to sleep for "
"free.  No muss, no fuss, no crummy tavern food and lice-ridden beds."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recharge_00065510_Oblivion_RESP1"
msgid "Smart to keep your magic items charged."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005c0d3_Oblivion_RESP1"
msgid "Smash the foe, Mace-Bearer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008db37_Oblivion_RESP1"
msgid "Smells of prey...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEDerveninSpeech08_00089918_Oblivion_RESP1"
msgid ""
"Smile at your fellow man. Help him when he falls. Remember, these are the "
"times of mirth and cheer. These are the times of Mania!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007be98_Oblivion_RESP1"
msgid ""
"Snak gra-Bura, owner and proprietor. We board horses. And... well... we don't "
"actually sell horses. Anymore, that is."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b59e_Oblivion_RESP1"
msgid "Snow. We need more snow. Can't have enough snow."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04AlessiasRing_00009331_Oblivion_RESP1"
msgid ""
"So Alessia Caro has recovered her ring. And now you want to know where she "
"keeps it so you can steal it back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e23_Oblivion_RESP1"
msgid ""
"So Argonians get this 'hist' stuff from licking hist trees, and the Blackwood "
"Company got bad hist that made them crazy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FingersoftheMountain_000236e5_Oblivion_RESP1"
msgid ""
"So Earana has ascertained the location of the book, has she? This is an "
"unfortunate turn of events. She can't be trusted with it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugo10_00090b7d_Oblivion_RESP3"
msgid ""
"So I better get started doing my good deeds. And maybe I'll see you at the "
"White Stallion Lodge."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugo08_00090b7b_Oblivion_RESP4"
msgid ""
"So I better get started doing my good deeds. And maybe I'll see you at the "
"White Stallion Lodge?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugo09_00090b7c_Oblivion_RESP4"
msgid ""
"So I better get started doing my good deeds. And maybe I'll see you at the "
"White Stallion Lodge?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479c8_Oblivion_RESP3"
msgid ""
"So I blow things up. And burn them. And frost them. And shock the living "
"daylights out of them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032ea2_Oblivion_RESP1"
msgid "So I can at least get blade and blunt training in Cheydinhal, can't I? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MazogatheOrcTopic_00086070_Oblivion_RESP4"
msgid "So I guess I'll have to go see what this is about. Thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000852bb_Oblivion_RESP1"
msgid "So I guess this is it then?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15KathutetB4_0003e8f4_Oblivion_RESP4"
msgid ""
"So I offer you a choice. Would you confront me in battle? Or offer me service?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_00003460_Oblivion_RESP4"
msgid ""
"So I said to her, \"No, I am a messenger of death.\" You should have seen the "
"look on her face! Ha ha ha ha! Anyway, she won't be seeing age six! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5c1_Oblivion_RESP1"
msgid "So I said. Where's the money in that?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00071d4f_Oblivion_RESP1"
msgid ""
"So I wanted somebody murdered! So I prayed to the Night Mother! What, is that "
"a crime now? They even took my house, those bastards! Agghhh!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38TSYes_0002366e_Oblivion_RESP1"
msgid "So I was right all along! You're doing excellent work, my friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40Allright_0003e955_Oblivion_RESP5"
msgid ""
"So I would ask that you take up the search on my behalf. If you are "
"successful, I will reward you in whatever small way I can. Will you aid me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NeutralReceive_00029549_Oblivion_RESP1"
msgid "So I've heard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECreatureResponses_00078184_Oblivion_RESP1"
msgid "So I've heard. Still, best to avoid their camps entirely."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeersStone_00033792_Oblivion_RESP1"
msgid ""
"So Kalthar overheard us, did he? That explains why he's been so cranky lately."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e67_Oblivion_RESP1"
msgid "So Viranus is dead. Modryn Oreyn is gone. We are in real trouble."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HorseTooMuchBruma_000545df_Oblivion_RESP1"
msgid ""
"So am I. I can't sell them for any less, but if you change your mind, come "
"back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13BattleReady_00027783_Oblivion_RESP1"
msgid "So be it. Bruma's fate is in the hands of the gods now ... and yours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_000b9841_Oblivion_RESP1"
msgid ""
"So be it. Head upstairs, and look for the last door on your right. That's "
"your room for tonight. Sleep well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004918e_Oblivion_RESP2"
msgid ""
"So believe me when I tell you we don't like it when people snoop around in "
"our affairs. You get near that ship, and my men will run you through."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e94_Oblivion_RESP1"
msgid ""
"So both the recruits got back alive, at least. I haven't heard the report."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5a6_Oblivion_RESP1"
msgid "So careless, these creatures."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5d7_Oblivion_RESP1"
msgid "So clumsy, all my fault."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGEmperor05_0002ad1c_Oblivion_RESP1"
msgid ""
"So do we all. But what path can be avoided whose end is fixed by the almighty "
"Gods?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479c8_Oblivion_RESP5"
msgid "So don't get any ideas about murdering me and looting my gold..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034243_Oblivion_RESP3"
msgid ""
"So far Mankar Camoran's books are our best lead. You should keep working on "
"getting copies of all four."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029c2_Knights_RESP1"
msgid "So far so good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028a0d_Oblivion_RESP1"
msgid ""
"So far the killer has claimed two victims. If they plan on adding Dovesi to "
"that list, they can think again. I won't let any harm come to that girl."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002919_Knights_RESP1"
msgid ""
"So far things have been quiet. After the horror in Anvil, the priests here "
"are more than a bit nervous."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003a851_Oblivion_RESP1"
msgid "So far, so good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00078211_Oblivion_RESP1"
msgid "So far, so good. If this world's a dream, I'm not waking up."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d48b_Oblivion_RESP5"
msgid ""
"So far, we haven't had to draw one drop of blood. The best part of the whole "
"thing is that the men are so embarrassed, they won't tell the guards!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GuardTalk2_00070290_Oblivion_RESP1"
msgid ""
"So goes the life of a rider, hmm? Come what may, at least we're not rotting "
"on the streets of some gods-forsaken city like Bravil, or Leyawiin!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004e953_Oblivion_RESP1"
msgid "So good of you to drop by again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000432b0_Oblivion_RESP1"
msgid "So good to be back in business!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003ca7a_Oblivion_RESP1"
msgid "So good to see you again!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00025278_Oblivion_RESP1"
msgid "So good to see you! Is there anything you need?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000784b4_Oblivion_RESP1"
msgid "So good to see you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38GuardWarnChoice1_00023688_Oblivion_RESP1"
msgid ""
"So he has finally snapped! I knew we should have warned the guards back when "
"I noticed him trying to break into my house ..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38TSNo_0002366a_Oblivion_RESP1"
msgid ""
"So he really is innocent, then. Interesting ... perhaps they have been using "
"him as a decoy, to draw my attention away from their real spies ..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ErthorTopic_0002d6e9_Oblivion_RESP4"
msgid ""
"So he settled down in Bleak Flats cave. Did all of his work there, and came "
"back to town twice a week to check in. Hasn't been around lately, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDUmarilTopic_00002bf9_Knights_RESP3"
msgid "So he was not slain, but simply cast adrift upon the waters of Oblivion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000292f_Knights_RESP3"
msgid ""
"So here I am. I have no doubt that our good works will be talked of in the "
"eras to come."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000473c4_Oblivion_RESP4"
msgid ""
"So here you are at last. The lackey of the Septim pretender. You still think "
"you have a chance, don't you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingBlockTest_00062339_Oblivion_RESP2"
msgid ""
"So here's what we're going to do. We're going to find out whether or not you "
"can hold up in combat. You put up your shield, and I hit you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479c8_Oblivion_RESP7"
msgid "So how do like THEM apples?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00038ee2_Oblivion_RESP1"
msgid "So hungry! Aggghhh!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk2_0003404a_Oblivion_RESP1"
msgid ""
"So is it true about your latest contract? The girl's nanny was actually a "
"Fighters Guild bodyguard?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ04FoundMartin_0001ee2d_Oblivion_RESP2"
msgid ""
"So it has not all gone against us. Thank Talos for that! We gained Uriel's "
"heir, and lost the Amulet of Kings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND04Mace_00002ac7_Knights_RESP1"
msgid ""
"So it was the boots that Sir Ralvas needed to complete his quest? What a fool "
"I was to refuse to help him. I will carry this regret for all time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG01AdrienneConv_0002d904_Oblivion_RESP1"
msgid "So it would seem. You are unharmed, I presume?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0014684f_Oblivion_RESP1"
msgid ""
"So it's Gladiator now. Oh, I do long for the day when you can prove your true "
"worth to me... in the Arena! Until that day comes, you are nothing!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00091881_Oblivion_RESP1"
msgid ""
"So it's Greenmote you need, eh? Well, I think it's fairly clear who knows "
"where that powdery substance is stored."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479c6_Oblivion_RESP2"
msgid ""
"So keep your dogs away from me... unless they want some advanced lessons in "
"plunging from great heights..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00092d79_Oblivion_RESP3"
msgid ""
"So let's start over, shall we? I know from now on, you and I are going to be "
"great friends! Now, is there something you'd like to buy or sell?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06GSWardenGreet2_00018db9_Oblivion_RESP1"
msgid "So like a male. Too stupid to know when to cease his yapping."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32AcolyteWarning_0008fb6c_Oblivion_RESP1"
msgid "So long as the gate holds, the keep will hold."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008247d_Oblivion_RESP1"
msgid "So long as we breathe, the Fringe will hold."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000165ad_Oblivion_RESP1"
msgid "So long."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0002802a_Oblivion_RESP1"
msgid "So long."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008da91_Oblivion_RESP1"
msgid "So long."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b590_Oblivion_RESP1"
msgid "So many bottles to collect."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008d31c_Oblivion_RESP1"
msgid "So many figures to compile. Would that I had your infinite wisdom, Lord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003b971_Oblivion_RESP1"
msgid ""
"So many forks. Not the True Fork. Only it sings. Have you the Fork for Big "
"Head? Fork that sings? Fork that rings?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479e7_Oblivion_RESP1"
msgid ""
"So many greenskins here... they smell, do they not? Ahdarji won't drink the "
"water, no. The Argonians SWIM in it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002974d_Oblivion_RESP1"
msgid "So many people dead. I just don't know who to trust anymore."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081da9_Oblivion_RESP2"
msgid ""
"So many strange noises here. People screaming, animals dying. But I've "
"learned so much... so much."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5b5_Oblivion_RESP1"
msgid "So many things do do. So little time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035586_Oblivion_RESP5"
msgid ""
"So maybe I can appeal to your sense of good will, huh? Ha ha ha ha! You let "
"me live, and I'll tell you where I stashed my treasure. Is it a deal?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000355cb_Oblivion_RESP1"
msgid ""
"So much dirt, and so little time... pause but a moment, and you'll be drowned "
"in the tide... Trash! Mud! Dust!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000c47e2_Oblivion_RESP1"
msgid ""
"So much easier to get around these days. Not like the old days. Too much "
"walking. Of course, nothing stops M'aiq from walking when he wants."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000914e0_Oblivion_RESP1"
msgid "So much to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00072dfc_Oblivion_RESP1"
msgid "So much to do. So little time left to do it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00078732_Oblivion_RESP1"
msgid ""
"So much to gather, so little time. Perhaps you can help? You might help "
"against the coming storm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5d5_Oblivion_RESP1"
msgid "So much to remember."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004f8ae_Oblivion_RESP1"
msgid "So nice of you to drop by again and see me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00086065_Oblivion_RESP6"
msgid "So now you know everything. You helped me, and I won't forget."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000917c9_Oblivion_RESP3"
msgid ""
"So once again you have choices; to sneak or to kill. Be cautious, these "
"Saints are some of his most elite."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MankarSpeech_0001fb33_Oblivion_RESP1"
msgid "So sayeth Lord Dagon. Praise be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MankarSpeech_0001fb34_Oblivion_RESP1"
msgid "So sayeth Lord Dagon. Praise be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MankarSpeech_00024e68_Oblivion_RESP1"
msgid "So sayeth Lord Dagon. Praise be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MankarSpeech_00024e69_Oblivion_RESP1"
msgid "So sayeth Lord Dagon. Praise be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00044214_Oblivion_RESP1"
msgid ""
"So she says, \"Is that a Great Torch in your pocket, or are you just happy to "
"see me?\" Ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_0002819e_Oblivion_RESP1"
msgid "So she's dead. What do you want from me? Flowers? A eulogy? I think not."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06TellKellen_00002b8d_Knights_RESP1"
msgid ""
"So someone could only lift the curse from me by taking it on themselves? No "
"wonder Areldur didn't tell me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04SheoKnights_00082489_Oblivion_RESP1"
msgid ""
"So soon? Not a surprise, I suppose. We'll get to that later. No need to "
"burden your little brain with it now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS31Lynch02Positive_000151e9_Oblivion_RESP3"
msgid "So stop telling lies and tell me what you're doing here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5d6_Oblivion_RESP1"
msgid "So strange this place. Far from the marsh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000852be_Oblivion_RESP1"
msgid ""
"So that's it. It's down to you and me. I know I'm no killer, so that means..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e57_Oblivion_RESP1"
msgid ""
"So the Anvil break-ins were an inside job? The Fighters Guild took care of "
"it? Good work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004420a_Oblivion_RESP1"
msgid ""
"So the Great Torch has been lit again. If it doesn't kill Scalons, it doesn't "
"mean much to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434f1_Oblivion_RESP1"
msgid ""
"So the Resonator is working. But who fixed it? Why was it broken in the first "
"place? Why is no one asking these questions?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ecf_Oblivion_RESP1"
msgid ""
"So the addict says to the whore, \"Gimme back my Chalice of Reversal!\" Ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043516_Oblivion_RESP1"
msgid ""
"So the moral of the story is: don't count your adventurers until they hatch! "
"Ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00044233_Oblivion_RESP1"
msgid ""
"So the new duke turns to him and says, \"Wrecked him? Damn near killed him!\" "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043eec_Oblivion_RESP1"
msgid ""
"So the spy says to her, \"You're not paranoid if everyone's out to get you!\" "
"Ha! Like Syl! Paranoid! Ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f227_Oblivion_RESP1"
msgid ""
"So then Sorceress says to the new Gatekeeper, \"But in the morning, you'll "
"still be ugly!\""
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e8f_Oblivion_RESP1"
msgid ""
"So thieves steal the Stone of Alessia, and ogres turn around, steal it from "
"them, and tear them apart. Don't you love it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMalacathSpeech_000579d2_Oblivion_RESP1"
msgid ""
"So this Lord Drad, he puts my little brothers in chains, working in the "
"mines, and it makes me mad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice7A_00028ba7_Oblivion_RESP2"
msgid ""
"So this tale has a happy ending after all, at least for you. Money cannot buy "
"happiness, they say, but we know better."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000919b7_Oblivion_RESP1"
msgid "So tiresome."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002948_Knights_RESP1"
msgid ""
"So we escaped Umaril's wrath... for now. Someone needs to put an end to these "
"creatures once and for all!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004422a_Oblivion_RESP1"
msgid ""
"So we have a new ruler of Dementia. How do I know this one isn't in league "
"with Them?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f462_Oblivion_RESP1"
msgid ""
"So we have armies again? I wouldn't want to be in an army. All that physical "
"exertion. Better to just sit and regain your strength."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00071f51_Oblivion_RESP2"
msgid ""
"So we search the lands and bring home whatever we find. This makes Gortwog "
"happy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG17ThalfinWhy_000366ef_Oblivion_RESP3"
msgid ""
"So we're stuck. All we can do is wait for them to come out. Then they can't "
"hide any more than we can, and it evens the odds quite a bit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47WhatHappened_00030038_Oblivion_RESP5"
msgid ""
"So we've all been keeping quiet, hoping the spell will wear off. But we're "
"running out of patience."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_00028235_Oblivion_RESP1"
msgid ""
"So what are you trying to tell me? That Matilde is the killer? Why are you "
"trying to turn me against her? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_000343bb_Oblivion_RESP1"
msgid "So what do you think? Is it safe to try to return to Cropsford?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_00047681_Oblivion_RESP3"
msgid ""
"So what else did you expect? Justice? Go to the Chapel. Talk to Zenithar. "
"He'll take care of everything."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_000039e2_Oblivion_RESP3"
msgid ""
"So what if he's wearing armor! You think that Imperial Legion scrap can stop "
"a well-forged claymore? Not bloody likely! Ha ha ha ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32Arrows_00013344_Oblivion_RESP1"
msgid ""
"So what you're saying is you really, really need these arrows? Go ahead. Take "
"them. What would I want them for?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_0003d076_DLCThievesDen_RESP1"
msgid "So what's hot today?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11CiirtaTopic_00043f72_Oblivion_RESP4"
msgid ""
"So while she is party to the secret, she does not know its significance. She "
"believed Sheogorath to be a traitor to His people."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopicElse02_00038a9d_Oblivion_RESP4"
msgid ""
"So why do we build big chapels and sit around and mumble, and ask them to "
"save us from this and that?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00097586_Oblivion_RESP1"
msgid ""
"So wonderful to see you again. I don't know what I would have done without "
"your help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG13EridorWhy_0003446e_Oblivion_RESP1"
msgid ""
"So word hasn't gotten around to all the townspeople. Interesting. They must "
"be very good at keeping a low profile."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MartinB_0003782f_Oblivion_RESP2"
msgid ""
"So you and Jauffre have said. If it is true, if the Emperor really was my "
"father, then I should be able to wear it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003fd38_Oblivion_RESP1"
msgid ""
"So you are looking for the Thieves Guild as well. Armand Christophe will "
"decide who is worthy and who is not."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG18Choice3A_00070487_Oblivion_RESP3"
msgid ""
"So you brand me a villain, and make vain attempts to destroy me. I watch, and "
"I wait, and I collect you when you come for me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark18Choice1B_00090790_Oblivion_RESP1"
msgid ""
"So you did, my child. So you did! Ha ha ha ha ha! You obeyed your orders and "
"showed no mercy or remorse. How could I ask for a better servant?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingArmorerHazadir_0018d15f_Oblivion_RESP2"
msgid ""
"So you do know a thing or two... Hazadir was my great-great grandsire's "
"sister's-son. Bet you didn't know that!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45DarMaDiaryTopic_000280bb_Oblivion_RESP1"
msgid ""
"So you found a book.  Someone must have left it.  What do I care?  No, I "
"don't know what happened to her.  Why would I?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047357_Oblivion_RESP3"
msgid ""
"So you found your way to Gaiar Alata at last. Don't we have enough troubles "
"here, without you adding to them?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk3_0006a857_Oblivion_RESP1"
msgid ""
"So you heard? Yes, yes, it was quite the debacle. The head just wouldn't "
"sever! Cut, saw, hack... By Sithis, I swear her tendons were made of steel!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06CasimirTopic_00002b02_Knights_RESP1"
msgid "So you know that name, do you? I spit on his memory."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05BaurusA_00022b1f_Oblivion_RESP1"
msgid "So you said. That's very bad news."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BOASTDISLIKE_00062318_Oblivion_RESP1"
msgid "So you say...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39Notebook_00078200_Oblivion_RESP2"
msgid ""
"So you see, I already know what's in that book. But Ranarr-Jo doesn't. Go "
"bring it to him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE34ExplainMore_0008f7b8_Oblivion_RESP4"
msgid "So you see, everything I want is right here in this beautiful place."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Manor_00003a5d_Oblivion_RESP1"
msgid ""
"So you think I'm responsible? I suppose you're right, as the manor used to "
"belong my grandfather, Lorgren Benirus."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_00037ffe_Oblivion_RESP1"
msgid ""
"So you're ready to fight the Gray Prince, are you? Well you can't go out "
"there without a name. You know, an Arena name!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_00037fff_Oblivion_RESP1"
msgid ""
"So you're ready to fight the Gray Prince, are you? Well you can't go out "
"there without a name. You know, an Arena name!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0002d6e3_Oblivion_RESP1"
msgid ""
"So you're supposed to go out and rescue Erthor, eh?  I'd love to help out. I "
"just don't quite feel comfortable doing that, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_0002823b_Oblivion_RESP1"
msgid ""
"So you're telling me I should believe you? That Matilde is the killer? Why "
"should I trust you? Get away from me!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00034074_Oblivion_RESP1"
msgid ""
"So, Adamus Phillida is finally retiring from the Imperial Legion. Spent his "
"life fighting the Dark Brotherhood. Time for a well-earned rest, I'd say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThoronirTopic_0000bca0_Oblivion_RESP1"
msgid ""
"So, Claudette sent you, eh? Well then, she usually sizes up people well, so "
"you may be just what we're looking for."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ShadeoftheRevenant_0000357b_Oblivion_RESP1"
msgid ""
"So, Falcar expressed interest in this Revenant as well, and left this note "
"behind, did he? Perhaps we should look into it for more clues."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ee30_Oblivion_RESP1"
msgid ""
"So, Francois Motierre has been killed. He hired us, sacrificed his own "
"mother's blood, and we could not even fulfill our end of the bargain."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00003929_Oblivion_RESP1"
msgid ""
"So, I assume you're the one who's been sent to track us down. Damn stone was "
"more trouble than it was worth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MaglirTOPIC_0002a574_Oblivion_RESP1"
msgid ""
"So, I assume you've dealt with Maglir. Tell me about why he defaulted on his "
"contract."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice3C_00022ba4_Oblivion_RESP1"
msgid ""
"So, I have your rapt attention. Splendid. Now listen closely. On the Green "
"Road to the north of Bravil lies the Inn of Ill Omen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46DoublesTopic_00081ed2_Oblivion_RESP1"
msgid "So, I said \"Rectum? You killed him!\" Great work!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS10LlevanaTalk_0003c37b_Oblivion_RESP1"
msgid "So, Llevana, I hear you have something I'd want to see?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036645_Oblivion_RESP1"
msgid ""
"So, Martin wants you to recover the Armor of Tiber Septim? I wish there was "
"another way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ09ArmorTopic_000c4315_Oblivion_RESP1"
msgid ""
"So, Martin wants you to recover the Armor of Tiber Septim? I wish there was "
"another way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028184_Oblivion_RESP1"
msgid ""
"So, Nels is dead. I don't condone murder, of course, but I can't say he'll be "
"missed. As a rule, I find Nords rather... vulgar."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08NelsNevConvo_000852c1_Oblivion_RESP1"
msgid ""
"So, Nord, if you find the gold, what will you spend it on? Wait, let me guess "
"-- a sleazy whore and a nice new battleaxe. Am I right?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThoronirTopic_0000bc9e_Oblivion_RESP1"
msgid ""
"So, Ogier sent you, eh? Well then, he usually sizes up people well, so you "
"may be just what we're looking for."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThoronirTopic_0000bc9f_Oblivion_RESP1"
msgid ""
"So, Tertullian sent you, eh? Well then, he usually sizes up people well, so "
"you may be just what we're looking for."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e8d_Oblivion_RESP1"
msgid ""
"So, Thadon has the Chalice again? I wish I had time to loaf about and drink "
"Felldew."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27HerminiaA3_000a5602_Oblivion_RESP1"
msgid "So, Umbacano has resorted to hired thugs now?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00042da2_Oblivion_RESP1"
msgid ""
"So, a newcomer may arrive in the Isles? I hope it's a guy and I hope he's "
"cute. It's slim pickings around here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND09ProphetGreeting02a_00002c0f_Knights_RESP2"
msgid ""
"So, although you wear the armor of the gods, it is incomplete -- a relic of "
"the old ways and the old gods."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND09ProphetGreeting02b_00002cd5_Knights_RESP4"
msgid ""
"So, although you wear the armor of the gods, it is incomplete -- a relic of "
"the old ways and the old gods."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000290b_Knights_RESP1"
msgid "So, another one who has come to listen to the madman's rantings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038429_Oblivion_RESP1"
msgid "So, any new revelations in your... errr.... investigation?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000275be_Oblivion_RESP1"
msgid ""
"So, are you ready to mingle with the doomed house guests? The contract is "
"waiting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002826a_Oblivion_RESP1"
msgid ""
"So, are you ready to search for the chest of gold? I'm confident I'll find "
"it. Not that I need the money, of course. My family is quite wealthy.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00009c7b_Oblivion_RESP1"
msgid ""
"So, at last we meet. I have been following your strange journey through the "
"Dark Brotherhood, young one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003661d_Oblivion_RESP1"
msgid ""
"So, did you follow her? She's behind it, isn't she? Tell me what you found "
"out!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00013452_Oblivion_RESP2"
msgid ""
"So, do you feel any different? Now that you've been through this experience, "
"I mean."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0003e99f_Oblivion_RESP1"
msgid "So, have you bet on any Arena matches lately?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000a9344_Oblivion_RESP1"
msgid ""
"So, have you managed to persuade Herminia Cinna to part with the Ayleid Crown?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002e41_Oblivion_RESP1"
msgid "So, have you taken care of those thieves yet?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StolenGold_00053777_Oblivion_RESP1"
msgid ""
"So, he told you another one of his tall tales. I hope you didn't believe him. "
"What's he got in store for me? He send you to kill me? Is that it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002948a_Oblivion_RESP1"
msgid "So, here we all are. It certainly is a nice house."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark11Choice1A_00002db8_Oblivion_RESP3"
msgid ""
"So, here's the list of all my precious little ones, though I dare say they're "
"not so little anymore! Ha ha ha ha ha! They grow up so fast, I swear!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022cec_Oblivion_RESP1"
msgid ""
"So, here's the plan. I'll meet with the Sponsor, while you cover me from the "
"upper gallery. What do you think?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006245d_Oblivion_RESP1"
msgid "So, how about it? Are you ready to fight now?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00040b9c_Oblivion_RESP1"
msgid "So, how'd you like to get together later and leaf through my octavo?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11RakheranGreeting2b_00019fc9_Oblivion_RESP3"
msgid ""
"So, if you will help me, I will help you. Ciirta will die and you will not "
"need to lift a finger. Then you can take whatever you need and go."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002241c_Oblivion_RESP1"
msgid ""
"So, it's Hero now, is it? I suppose the little urchin wants to be a Champion. "
"Bah! You will never join our ranks! We are gods among mortals!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0006145b_Oblivion_RESP1"
msgid ""
"So, it's a secret contract then, is it? You must be moving up in the world. "
"Congratulations."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_00027988_Oblivion_RESP1"
msgid ""
"So, it's to be five against one, is it? The odds are against you. With any "
"luck, you'll be dead within an hour."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00058e02_Oblivion_RESP4"
msgid ""
"So, like I said, thanks. I'm glad I was able to come here and do my bit for "
"our side, you know?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025b3a_Oblivion_RESP1"
msgid "So, ready for your next match?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StolenGold_0005375f_Oblivion_RESP1"
msgid ""
"So, she's dead eh? Hahaha. Finally! Finally someone has wiped that stupid "
"smug grin off her face. Good, good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StolenGold_000a04dc_Oblivion_RESP2"
msgid ""
"So, she's dead eh? Hahaha. Finally! Finally someone has wiped that stupid "
"smug grin off her face. Good, good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS09AlreadyDead_00090869_Oblivion_RESP1"
msgid ""
"So, she's dead, eh? Hahaha. Finally! Finally someone has wiped that stupid "
"smug grin off her face. Good, good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugo08_00090b7b_Oblivion_RESP3"
msgid "So, thank you. You been good to me. And I won't ever forget it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugo09_00090b7c_Oblivion_RESP3"
msgid "So, thank you. You been good to me. And I won't ever forget it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugo10_00090b7d_Oblivion_RESP2"
msgid "So, thank you. You've been good to me. And I won't ever forget it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00089935_Oblivion_RESP1"
msgid ""
"So, thanks to some hired help, the Jemanes recovered Weatherleah. Good "
"thing... I never liked having ogres so close to Chorrol."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Investigation_00031529_Oblivion_RESP1"
msgid ""
"So, the Countess hired you to find the painting, eh? Well, you'll not find it "
"by gawking at me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f1e9_Oblivion_RESP1"
msgid ""
"So, the Gatekeeper is back at its post... good. Now we all may be able to get "
"things done around here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004421a_Oblivion_RESP1"
msgid ""
"So, the Great Torch burns. I know something about burning. The human body "
"makes a pretty good torch, especially the fattier parts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000a09f_Oblivion_RESP1"
msgid ""
"So, the Night Mother has spoken! I will make sure this information reaches "
"the appropriate family members. Ah yes, here are your weekly earnings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000441dd_Oblivion_RESP1"
msgid ""
"So, the Torch is lit. Can a flame be captured in time? Would it still burn?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023f7c_Oblivion_RESP1"
msgid ""
"So, the accident has been staged, and Baenlin lies dead. Well done! You have "
"more than earned your reward and bonus. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f453_Oblivion_RESP1"
msgid ""
"So, the armies have been restored. They'd better not show up here looking to "
"procure my crops."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12TraitorTaunts_0008f7da_Oblivion_RESP1"
msgid "So, the bloody-handed Duchess comes to claim another victim!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12TraitorTaunts_0008f7c6_Oblivion_RESP1"
msgid "So, the bloody-handed Duke comes to claim another victim!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d48b_Oblivion_RESP6"
msgid ""
"So, the bottom line is, you show a little skin... just a tease. No one "
"touches you. What do you say?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MankarRant_0008c21b_Oblivion_RESP10"
msgid "So, the cat's-paw of the Septims arrives at last."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000206ad_Oblivion_RESP1"
msgid "So, the cycle begins anew and the Dutchess of Dementia has fallen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022504_Oblivion_RESP1"
msgid ""
"So, the deed is done. How do I know this? You will find that the Dark "
"Brotherhood knows a great many things. For you are now part of the family."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ee2f_Oblivion_RESP1"
msgid ""
"So, the enforcer Hides-His-Heart has been killed. He was to bear witness to "
"Motierre's death, and report back to his superiors.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000711b8_Oblivion_RESP1"
msgid ""
"So, the infamous criminal surrenders? This calls for a celebration! So... pay "
"the fine or serve your sentence. Your stolen goods are forfeit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000837e7_Oblivion_RESP1"
msgid ""
"So, the last guest finally arrives. I'll tell you what I told all the others. "
"You go in, I lock the door. You don't come out 'til it's over."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05LexToDremora_0000a235_Oblivion_RESP1"
msgid ""
"So, the mages send a foul daedra to deliver a simple note when an honest "
"footman would have done. How typical."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000441fb_Oblivion_RESP1"
msgid ""
"So, the mighty Syl has fallen. Well then, that's one less woman to worry "
"about... more men for me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003f14f_Oblivion_RESP1"
msgid ""
"So, the mighty Ulrich Leland has fallen. Apparently Llevana Nedaren snapped "
"and killed him. Good riddance I say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00019132_Oblivion_RESP1"
msgid ""
"So, the pirate has been eliminated. Excellent. No one will mourn his passing, "
"and Sithis has been appeased. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607c1_Oblivion_RESP1"
msgid ""
"So, the story has been rewritten and the Greymarch is at a new ending. Arden-"
"Sul's will be done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark12Choice1C_0005179d_Oblivion_RESP1"
msgid ""
"So, the thief opts for the stoic approach, hmm? Oh, my friend, I'm afraid "
"you've broken into your last house. Ha ha ha ha ha! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00009180_Oblivion_RESP1"
msgid ""
"So, the work is complete. Now we can discuss the information I have for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d4c5_Oblivion_RESP1"
msgid "So, they're at Gweden, eh? Good to know. Keep on it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434b9_Oblivion_RESP1"
msgid ""
"So, this mystery adventurer has breached our defenses. I better prepare a "
"special dish to commemorate this event."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028d33_Oblivion_RESP1"
msgid ""
"So, three of us left -- you, Dovesi and myself. The list of suspects is "
"certainly getting smaller. With Nels dead, my eye is on Dovesi."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46GoblinWar_0000ab72_Oblivion_RESP5"
msgid ""
"So, to stop the war, all you need to do is sneak into Timberscar Cave, find "
"the stolen Tribal Head, and return it to the Cracked Wood Cave goblins."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000566f_Oblivion_RESP7"
msgid ""
"So, we have no choice but to invoke an ancient ritual. We must wake the Night "
"Mother from her slumber, and seek her guidance! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00053760_Oblivion_RESP1"
msgid "So, were you able to find out about the gold or not?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_duties_0006e2e3_Oblivion_RESP5"
msgid "So, what are your first orders, Guildmaster?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0018d929_Oblivion_RESP1"
msgid "So, what brings you here today?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06CurseTopic_00002b1e_Knights_RESP1"
msgid ""
"So, what can be done for me? I know you've learned something. I can see it in "
"your face."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002366d_Oblivion_RESP1"
msgid "So, what did you discover about the upstanding Davide Surilie?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46Choice1_0008fab8_Oblivion_RESP2"
msgid ""
"So, what does he do? What else? Casts a spell. You can see how well that "
"went. Two of each of us walking around this place."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002edd7_Oblivion_RESP1"
msgid "So, what of the Rogue mage? Has he been found?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0018917b_Oblivion_RESP1"
msgid "So, what's the news from Greyland?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062cae_Oblivion_RESP1"
msgid "So, what's this about?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkUmaril1_00002c58_Knights_RESP1"
msgid ""
"So, when do you think we will be able to strike back at this foul Umaril "
"creature?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Decision_0001e3ec_Oblivion_RESP2"
msgid ""
"So, which is it? What will it be? Mania? Dementia? The suspense is killing "
"me. Or you, if I have to keep waiting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028b80_Oblivion_RESP3"
msgid ""
"So, why am I here? Greed, my friend. I need the gold. I served the Legion "
"proudly for twenty-three years, but pride doesn't put food on my table."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002d3a3_Oblivion_RESP1"
msgid ""
"So, you are here to kill Motierre, eh? Well he's mine, and nothing will stand "
"in my way!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StolenGold_0005375c_Oblivion_RESP1"
msgid ""
"So, you both tricked me, and now you're here to mock me. Fine, fine. I hope "
"you were happy working with that deceitful wench."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_000251c8_Oblivion_RESP1"
msgid ""
"So, you come to me for assistance. How interesting. I think I'd much rather "
"you die in the field."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036616_Oblivion_RESP1"
msgid ""
"So, you didn't sell me out. I appreciate that. Well, I said I'd make it worth "
"your while, so let me teach you a little something."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028267_Oblivion_RESP1"
msgid ""
"So, you finally showed up. It's about time. People of my station are not "
"accustomed to waiting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007ac75_Oblivion_RESP1"
msgid ""
"So, you have the pearls? Or perhaps any other things of value I can have -- I "
"mean, hold for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000251b9_Oblivion_RESP1"
msgid ""
"So, you infiltrated the Imperial Prison, eliminated Valen Dreth, and killed "
"not one guard. Most excellent!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0000bcaf_Oblivion_RESP1"
msgid ""
"So, you need to find this High Elf, hmm? Why don't you take a trip to "
"Summerset Isle, ask around for him there. Idiot. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002c81e_Oblivion_RESP1"
msgid ""
"So, you remember S'razirr after all. This one was as good as his word. Are "
"you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001dcc6_Oblivion_RESP1"
msgid ""
"So, you saw Bernadette Peneles, did you?  She WAS watching me and following "
"me, wasn't she?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Necromancers_000038b7_Oblivion_RESP1"
msgid ""
"So, you saw them? The altars must be infused with some kind of power to "
"change over the soul gems."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS10FollowMe_0003c379_Oblivion_RESP1"
msgid ""
"So, you say Llevana wishes to see me? Very well, lead on. This should prove "
"amusing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028240_Oblivion_RESP1"
msgid ""
"So, you think Nels did it, do you? I would appreciate you keeping your "
"opinions to yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00091885_Oblivion_RESP2"
msgid "So, you want to find the secret escape route? Easy enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035a13_Oblivion_RESP4"
msgid ""
"So, you'll have to die. Don't worry. We'll put your body to good use, I "
"assure you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035a14_Oblivion_RESP4"
msgid ""
"So, you'll have to die. Don't worry. We'll put your body to good use, I "
"assure you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035a15_Oblivion_RESP4"
msgid ""
"So, you'll have to die. Don't worry. We'll put your body to good use, I "
"assure you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36Choice2HelpNo_00061c45_Oblivion_RESP1"
msgid ""
"So, you're a coward. Just my luck. Never mind. I'll find someone else to do "
"it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03Xedilian_0006770c_Oblivion_RESP3"
msgid ""
"So, you're going to get Xedilian up and running. Here's a little book to tell "
"you how, and the Attenuator of Judgement. You'll need that, too."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c13e_Oblivion_RESP1"
msgid "So, you're the famous Hero of Kvatch."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00037ff7_Oblivion_RESP1"
msgid ""
"So, you've actually challenged the Gray Prince? Do you really know what "
"you've gotten yourself into? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e941_Oblivion_RESP1"
msgid "So, you've brought something for me to examine?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025e1c_Oblivion_RESP1"
msgid ""
"So, you've collected the pelts. I trust you've learned a lesson. Your rank is "
"restored, along with all rights and responsibilities."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000009e6_Oblivion_RESP1"
msgid "So, you've come back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE35Brithaur_00078666_Oblivion_RESP1"
msgid "So, you've dealt with the problem, eh? I like the sound of that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE35Brithaur_00078667_Oblivion_RESP1"
msgid "So, you've dealt with the problem, eh? I like the sound of that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e615_Oblivion_RESP2"
msgid "So, you've decided to light the Torch for Mania?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081ddf_Oblivion_RESP1"
msgid ""
"So, you've managed to kill the Gatekeeper. Pity. Well, you'll now be able to "
"enter the Realm proper. You'll notice there are two doors."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_00003460_Oblivion_RESP1"
msgid ""
"So, your first contract. No chance for a bonus, huh? That's all right, you're "
"better off! Who needs magic items when you've got raw skill?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e33_Oblivion_RESP1"
msgid ""
"So. The Fighters Guild got Azani Blackheart. Blackwood Company said they did "
"him, but apparently they were mistaken. Or stretching the truth, maybe?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMalacathSpeech_000579d3_Oblivion_RESP1"
msgid ""
"So. You get over to Lord Drad's estate. Get my ogres loose, and get them out. "
"Do it now, for me... the Boss."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugoTopic_00090b63_Oblivion_RESP1"
msgid ""
"So. You killed Black Brugo. Well, the bastard had it coming, I guess. You get "
"a reward?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05RavenSpeech_00022cf6_Oblivion_RESP1"
msgid "So. You want to become one of the Chosen of Mehrunes Dagon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeatherleahTopic_00088b30_Oblivion_RESP1"
msgid ""
"So... the brothers have once again reclaimed Weatherleah, eh? Good for them!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008daa4_Oblivion_RESP1"
msgid "So... what have you brought me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NorbertLellesTOPIC_000356b9_Oblivion_RESP1"
msgid ""
"So... you took care of the thieves. Excellent. You'll want to talk to Lelles "
"to close out the contract. And get paid, of course."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005c0c8_Oblivion_RESP1"
msgid "So?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONENTER_0018b2de_Oblivion_RESP1"
msgid "So?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugoTopic_00090b68_Oblivion_RESP1"
msgid "So? Am I a knight?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MazogatheOrcTopic_00086071_Oblivion_RESP1"
msgid ""
"So? An Orc wants to see me? And this interests me how? Did I forget how much "
"I like you so I should do this favor for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugo07_00090b7a_Oblivion_RESP2"
msgid "So? Go on... say it! Say... 'I greet you, Sir Mazoga.'"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0006fdb0_Oblivion_RESP1"
msgid "So? What do you have to report?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003377c_Oblivion_RESP1"
msgid "So? What happened?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000038a7_Oblivion_RESP1"
msgid "So? You a living statue or are you gonna say something?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003be7e_Oblivion_RESP1"
msgid "Soft flesh... brittle bones... snap snap... Love how they crack."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MartinBattleSpeech_0003d063_Oblivion_RESP1"
msgid "Soldiers of Cyrodiil! Do you stand with me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MartinBattleSpeech_0003d05f_Oblivion_RESP1"
msgid ""
"Soldiers of Cyrodiil! The Empire will stand or fall by what we do here today!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEDunrootBurrowTopic_0001338b_Oblivion_RESP3"
msgid ""
"Some Elytra there are... different. You'll need to get Felldew from them, and "
"eat it. Can't get in without it. But once you do..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46Choice1_0008fab8_Oblivion_RESP1"
msgid ""
"Some blasted mage. Had a theory. They've always got theories. He thought "
"there was a Manic and a Demented in each of us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_00028790_Oblivion_RESP1"
msgid ""
"Some bloodthirsty monster killed that woman in cold blood. It's obvious to me "
"one of the other guests killed her to eliminate the competition. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479c7_Oblivion_RESP1"
msgid ""
"Some clown keeps tossing meat out in my backyard, and it attracts dogs from "
"Necrom to Daggerfall."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BonusTopic_0002ff51_Oblivion_RESP1"
msgid ""
"Some contracts are straightforward. Find the target, eliminate them, then "
"return to the Sanctuary. No time limits or complications."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000432ba_Oblivion_RESP1"
msgid "Some dashing new hero has stolen into the Realm!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE34Crisis_00066edd_Oblivion_RESP4"
msgid ""
"Some dastardly Grummites stole my most prized possession... my Medallion that "
"signified my membership in the Knights."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_disappearances_0000bea5_Oblivion_RESP1"
msgid ""
"Some folks are missing in Harlun's Watch. We've been contracted to find out "
"what's happened. Speak to Drarana Thelis for all the details. Get going."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0002c59d_Oblivion_RESP1"
msgid ""
"Some folks are saying that the Blackwood Company is taking over all of the "
"Fighters Guild contracts. There's rumor they'll lose their charter."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_disappearances_0000be70_Oblivion_RESP1"
msgid ""
"Some folks reported seeing strange lights near the old Swampy Cave. We sent "
"folks to investigate them, but haven't seen them since. We need help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004421c_Oblivion_RESP1"
msgid "Some fool lit himself on fire in the city."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StrangeLights_0000bed9_Oblivion_RESP1"
msgid ""
"Some have said they're will-o-the-wisps, though I've never heard of one "
"killing a full-grown man."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000276a3_Oblivion_RESP1"
msgid ""
"Some help is better than nothing, but my militia are farmers and shopkeepers, "
"not soldiers. I would recommend delaying until more help can arrive."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434f3_Oblivion_RESP1"
msgid ""
"Some idiot killed the Gatekeeper. Now we'll be swamped with morons coming and "
"bothering us. Present company not excluded."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateTopic_000091a0_Oblivion_RESP4"
msgid ""
"Some kind of portal to Oblivion. The enemy used them to attack the city -- "
"they appeared outside the walls and daedra poured out!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ND04CarodusGreetingZenithar_00002abe_Knights_RESP2"
msgid ""
"Some legends say that Zenithar has close ties to Kynareth, an idea that is "
"supported by the manner in which the two gods' realms interact."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND04Zenithar_00002ac2_Knights_RESP2"
msgid ""
"Some legends say that Zenithar has close ties to Kynareth, an idea that is "
"supported by the manner in which the two gods' realms interact."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND04Zenithar_00002ac3_Knights_RESP2"
msgid ""
"Some legends say that Zenithar has close ties to Kynareth, an idea that is "
"supported by the manner in which the two gods' realms interact."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_MS48SalvianWhatHappened_00098142_Oblivion_RESP3"
msgid ""
"Some made it into the Chapel, but others were just run down in the streets. "
"The Count and his men are still holed up in the castle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RogueMage_0002ee53_Oblivion_RESP1"
msgid ""
"Some mages do not abide by the principles of the guild, and operate outside "
"its boundaries. Many hold little value for the lives of others."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebb6_Oblivion_RESP1"
msgid ""
"Some mischief of yours in Bleaker's Way has interfered with Mephala's plans. "
"You're wasting your time here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000432c3_Oblivion_RESP1"
msgid ""
"Some new person has arrived. It'd be polite to introduce myself, but I'm "
"feeling more tired than usual."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e7c_Oblivion_RESP1"
msgid "Some of the Leyawiin boys are cutting up pretty bad. Oreyn is not happy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00088b44_Oblivion_RESP1"
msgid ""
"Some of the new ones say that the war is going badly. The attack on Bruma "
"failed completely."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD08Choice5_000a3456_Oblivion_RESP2"
msgid ""
"Some of your Guild brothers found you and brought you to me. Good to see some "
"of them think like we do. Now, what happened out there?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_causingtrouble_0002c7c4_Oblivion_RESP1"
msgid ""
"Some of your brothers have been getting rowdy at the local tavern. I've got "
"no problem with cutting loose, but I don't like it when we all look bad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000914e1_Oblivion_RESP1"
msgid "Some other time maybe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00041f18_Oblivion_RESP2"
msgid ""
"Some people are frightened by this, or they despair, or even try to deny the "
"truth of what I say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000c47e1_Oblivion_RESP1"
msgid ""
"Some people want special bows that take too long to load and need special "
"arrows called bolts. M'aiq thinks they are idiots."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000c47dd_Oblivion_RESP1"
msgid ""
"Some people wish to throw their weapons. That seems foolish to M'aiq. If you "
"hold your weapon, you only need one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrisonBreak_00009c36_Oblivion_RESP1"
msgid ""
"Some real hard cases got out of the Bravil prison. Been terrorizing the "
"locals ever since. The Watch is useless, so we step in. Get to it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Visions_00033795_Oblivion_RESP3"
msgid ""
"Some resent her, and wish she'd disappear. I do not. I am proud to help her "
"with her daily tasks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006c29b_Oblivion_RESP1"
msgid ""
"Some say that Traven is mis-using the power of the Arch-Mage's position to "
"further his personal agendas."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077c4a_Oblivion_RESP1"
msgid ""
"Some say the Grummites are the original inhabitants of the Shivering Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HackdirtTopic_000280a2_Oblivion_RESP1"
msgid ""
"Some say the Legion burned the town to the ground, but it's still there, for "
"those that go looking for trouble."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c997_Oblivion_RESP2"
msgid ""
"Some see only the conflicts between northern and southern cultures, but I see "
"the way they are stronger when woven together."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_InfoRefusal_0002459f_Oblivion_RESP1"
msgid "Some words should be shared only by friends."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_jobs_0002c7ad_Oblivion_RESP1"
msgid ""
"Some work would be a gift from the gods. If you've found something, tell "
"Vantus."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Flee_000872dc_Oblivion_RESP1"
msgid "Somebody help!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Steal_000626b7_Oblivion_RESP1"
msgid "Somebody help! Come quickly! We've got a burglar!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008e4e7_Oblivion_RESP1"
msgid "Somebody stop that awful racket!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081dcc_Oblivion_RESP1"
msgid ""
"Someday I hope you will invite me to eat with you in the palace, Lord "
"Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007347a_Oblivion_RESP1"
msgid ""
"Someday I'll get out of here and take my revenge on everyone that put me in "
"prison."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseDecline_0004f20d_Oblivion_RESP1"
msgid "Somehow I knew you weren't serious about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS18Choice2A_00027533_Oblivion_RESP1"
msgid "Somehow I knew you'd do the right thing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0000a220_Oblivion_RESP1"
msgid "Somehow I think we will meet again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12HaskillGreetC2_00016d03_Oblivion_RESP1"
msgid ""
"Somehow the forces of Order have poisoned the Pools of Mania and Dementia "
"that feed the Font."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12HaskillGreetC2_00016edd_Oblivion_RESP1"
msgid ""
"Somehow the forces of Order have poisoned the Pools of Mania and Dementia "
"that feed the Tree."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07BeggarPay_00020093_Oblivion_RESP2"
msgid ""
"Someone I'd never seen before. When Jearl wasn't home. You see what I mean?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00042da8_Oblivion_RESP1"
msgid ""
"Someone different come to the Isles? Don't like to think what kind of "
"diseases came along."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00062684_Oblivion_RESP1"
msgid ""
"Someone finally solved the problems with research at Vahtacen. You'd think "
"the Council would know more about the Ayleids by now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028195_Oblivion_RESP1"
msgid ""
"Someone has been brutally murdered, yet you want to question me about that "
"little Dark Elf tramp? Go away, you fool."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002815b_Oblivion_RESP1"
msgid ""
"Someone has been killed. I don't suppose you know anything about that, now do "
"you? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004422b_Oblivion_RESP1"
msgid "Someone has replaced the Duchess!  I bet she got sick and died."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005edba_Oblivion_RESP1"
msgid "Someone has replaced the Duke. I bet he got sick and died."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS49Whatnow_00031d28_Oblivion_RESP1"
msgid ""
"Someone has to get inside that gatehouse, and raise the gate. We'll never "
"make it into the castle otherwise."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434ff_Oblivion_RESP1"
msgid ""
"Someone killed my poor child! And my Lord cares little. So be it. Let the "
"adventurers in. I don't care anymore."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434bc_Oblivion_RESP1"
msgid ""
"Someone killed the Gatekeeper? Do you know who? Maybe he'll kill me too. Do "
"you think? I hope so. Someone put me out of my misery, please!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_000286f6_Oblivion_RESP1"
msgid "Someone killed the man, but who? And for what reason? We may never know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043510_Oblivion_RESP1"
msgid ""
"Someone managed to turn the Resonator back on. I guess that's a good thing. "
"Though it sounds like a lot of work for little pay off to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000465a0_Oblivion_RESP1"
msgid ""
"Someone needs to get Skjorta under control. You'd think Olfand would be the "
"one to do it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00042dad_Oblivion_RESP1"
msgid "Someone new around? Not one of those horrible cats, I hope."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00042da3_Oblivion_RESP1"
msgid "Someone new comes to the Isles. Much more interesting than someone old."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00042d9f_Oblivion_RESP1"
msgid "Someone new in the Isles? Don't care. Plenty to drink for everyone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00042d91_Oblivion_RESP1"
msgid ""
"Someone new in the Isles? Oh no, I don't want that. Perhaps Syl will put a "
"stop to it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005edc0_Oblivion_RESP1"
msgid "Someone new is running Bliss. Can't say I care."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00044231_Oblivion_RESP1"
msgid "Someone new is running Crucible. Can't say I care."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00042da4_Oblivion_RESP1"
msgid ""
"Someone new is trying to get into the Shivering Isles. I'd better hide what "
"little I have left."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005edb9_Oblivion_RESP1"
msgid "Someone new on the throne of Mania? I hope it's not one of Them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS26ShopkeeperReport_00035ca0_Oblivion_RESP2"
msgid "Someone ought to do something about him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36GuardResponse_00081dad_Oblivion_RESP1"
msgid "Someone really ought to put up a railing. That happens all the time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00044206_Oblivion_RESP1"
msgid ""
"Someone relit the torch of Arden-Sul. Maybe they'll come here next and save "
"us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000029f6_Knights_RESP1"
msgid ""
"Someone removed those gauntlets from the Chapel in Chorrol. I wonder how they "
"managed it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0014c731_Oblivion_RESP1"
msgid ""
"Someone said the Bloated Float mysteriously departed from the docks and then "
"returned. I didn't know she was even seaworthy!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000825ea_Oblivion_RESP1"
msgid "Someone should put Hirrus Clutumnus out of his misery."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062cdc_Oblivion_RESP1"
msgid "Someone should teach you some manners."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008fa94_Oblivion_RESP1"
msgid ""
"Someone should write a book about the problems we're having with our doubles "
"here in Split."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_00028c31_Oblivion_RESP1"
msgid ""
"Someone slaughtered that poor old woman like a lamb. I've got my eyes on you. "
"Make one false move and I'll come down on you like a hammer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00064454_Oblivion_RESP1"
msgid ""
"Someone told me that Hieronymus Lex is gone. Reassigned to Anvil. That can't "
"be true!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028187_Oblivion_RESP1"
msgid ""
"Someone turns up dead and you have nothing better to do than pester me about "
"that fine young man? How truly pathetic you are. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00002a01_Knights_RESP1"
msgid "Someone was able to lift the curse from that poor man at the Chapel. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035f32_Oblivion_RESP2"
msgid ""
"Someone will need to see where this goes. I think you should go; you've done "
"all the hard work, after all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028b81_Oblivion_RESP1"
msgid ""
"Someone's been killed, and as far as I'm concerned, you're one of the prime "
"suspects. You watch your step. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028c38_Oblivion_RESP1"
msgid ""
"Someone's been killed, and you know what my real problem is? Trying to decide "
"who did it, you or that worthless Nord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Murder_00025d02_Oblivion_RESP1"
msgid "Someone's been murdered!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002799a_Oblivion_RESP1"
msgid "Someone's been murdered! By Ysmir's beard, I need a drink!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_000241b0_Oblivion_RESP1"
msgid "Something I can do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bc9d_Oblivion_RESP1"
msgid "Something I can help you with?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c222_Oblivion_RESP1"
msgid ""
"Something about Arvena Thelas is a bit odd. I've heard she keeps strange "
"things in her basement."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE44ComingStorm_0007872f_Oblivion_RESP1"
msgid "Something big is coming. The end of it all. And I'm going to be ready."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_00037ffe_Oblivion_RESP2"
msgid ""
"Something catchy, something the people of Cyrodiil will remember when they "
"tell stories about your inglorious defeat! So, what's it going to be?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_00037fff_Oblivion_RESP2"
msgid ""
"Something catchy, something the people of Cyrodiil will remember when they "
"tell stories about your inglorious defeat! So, what's it going to be?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateTopic_0009226b_Oblivion_RESP3"
msgid "Something fundamental must have changed to make them possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateTopic_00033fc9_Oblivion_RESP5"
msgid "Something has changed to make these stable portals to Oblivion possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006267f_Oblivion_RESP1"
msgid ""
"Something has gone seriously wrong at the Arcane University. I heard that a "
"high-ranking member was killed in some sort of ambush."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c25c_Oblivion_RESP1"
msgid ""
"Something is just a bit off about Glarthir. Someone needs to keep an eye on "
"him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03SyndelC2Idle01_0008eab6_Oblivion_RESP1"
msgid "Something isn't right here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008e142_Oblivion_RESP1"
msgid ""
"Something lost upon the ground? It's likely to show up at Ahjazda's Things "
"Found."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recharge_00066a52_Oblivion_RESP1"
msgid "Something need charging?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002b5f3_Oblivion_RESP1"
msgid "Something on your mind, furlicker?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002b5f1_Oblivion_RESP1"
msgid "Something on your mind, goldenrod?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000b97d0_Oblivion_RESP1"
msgid "Something seems... amiss with you, milady."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000b97d1_Oblivion_RESP1"
msgid "Something seems... amiss with you, milord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001e43c_Oblivion_RESP1"
msgid "Something smooth and sharp? Leave your foes sticky with blood."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000465f5_Oblivion_RESP1"
msgid ""
"Something strange is going on with Ardaline and Varon Vamori. I always see "
"him hanging around her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_000286e3_Oblivion_RESP1"
msgid ""
"Something tells me the murder of one of the guests isn't going to stop "
"Matilde from searching for the money. She strikes me as the greedy type.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000908e8_Oblivion_RESP1"
msgid ""
"Something the matter with your eyes? There will be if you keep gawkin' at me "
"like that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bcab_Oblivion_RESP1"
msgid "Something to report?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00072df9_Oblivion_RESP1"
msgid "Something you need? So many things to need."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002c7ac_Oblivion_RESP1"
msgid "Something you need? We still need work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0018d7dd_Oblivion_RESP1"
msgid "Something's come up. It can't wait."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001fdaf_Oblivion_RESP1"
msgid "Something's wrong... I can tell. What's happened to Aleron?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04DarkSecrets_0004f9ea_Oblivion_RESP3"
msgid ""
"Sometimes I can hear the screams of the prisoners when I'm in my chambers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081c50_Oblivion_RESP1"
msgid ""
"Sometimes I come up here to think. Everything looks so small from up here. "
"Makes me feel better, you know? Like I'm not so small myself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000241d8_Oblivion_RESP1"
msgid "Sometimes I just go look at the Great Oak. Magnificent, don't you think?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00036316_Oblivion_RESP1"
msgid "Sometimes I think Lachance will let anyone into this Sanctuary..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk4_00034054_Oblivion_RESP1"
msgid ""
"Sometimes I wonder how you survive at all without me being there to watch "
"your back! He he he. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DagailTopic_0003395b_Oblivion_RESP2"
msgid ""
"Sometimes I wonder why she hasn't just retired, and gone someplace to rest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeGreaves_0001f3e0_Oblivion_RESP1"
msgid ""
"Sometimes a woman needs to make a quick exit. No shame in that. But it won't "
"be very graceful if your legs are broken."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeAmberHammer_00016528_Oblivion_RESP1"
msgid ""
"Sometimes a woman's got to swing a big stick to be taken seriously, right? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077c42_Oblivion_RESP1"
msgid "Sometimes, a sharp blade is the best way to kill a Flesh Atronach."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeSword_0001f3e6_Oblivion_RESP1"
msgid ""
"Sometimes, a woman has got to make her point using the tip of her sword, "
"right? You'd better believe it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000301de_Oblivion_RESP1"
msgid ""
"Sometimes, people who are invisible are trying to get some privacy. Diram "
"will be glad to talk your ear off about the whole mess."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Sithis_000251eb_Oblivion_RESP1"
msgid ""
"Sometimes, right before a kill, Sithis speaks to me. He whispers in my ear "
"and fills my heart with the joy of suffering and death!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CloudRulerTempleTopic_000626c3_Oblivion_RESP1"
msgid ""
"Sometimes, when it's quiet, I walk the battlements and breathe in the cold "
"mountain air. It's the only peace I allow myself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00072df6_Oblivion_RESP1"
msgid "Songs of forks follow you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00078161_Oblivion_RESP1"
msgid "Sontaire may sell a lot of books, but that's not why the men visit her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDLathonGreetB_00002a77_Knights_RESP2"
msgid ""
"Soon I'll be ready to return to Totambu and become a Knight of the Scarab."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001796f_Oblivion_RESP3"
msgid "Soon after that, the sky darkened and the knights came."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002a347_Oblivion_RESP1"
msgid "Soon the guards will arrest you for trespassing! I warned you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDSirBerichTopic_00002c79_Knights_RESP2"
msgid ""
"Soon we will all finish our long-delayed journey to Aetherius, and Sir Berich "
"will be among us, as of old. Thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008119a_Oblivion_RESP1"
msgid "Soon we will birth a new Gatekeeper!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10JyggalagTopic_00091460_Oblivion_RESP2"
msgid ""
"Soon, I'll turn into Jyggalag. There's no stopping it. That doesn't excuse "
"you from your duties, though. Get to it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07JyggalagTopic_0009124e_Oblivion_RESP1"
msgid ""
"Soon, Jyggalag will come to this Realm, bringing destruction in his wake. "
"With the Throne of Madness empty, the Realm is doomed. Lovely."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07JyggalagTopic_00091289_Oblivion_RESP1"
msgid ""
"Soon, Jyggalag will come to this Realm, bringing destruction in his wake. "
"With the Throne of Madness empty, the Realm is doomed. Lovely."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_00047711_Oblivion_RESP1"
msgid ""
"Soon, the Elder Council must choose a new emperor, and then I suppose they'll "
"sort out my commission. Until then, I just have to keep on working."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MankarSpeech_0008b0a2_Oblivion_RESP10"
msgid ""
"Soon, very soon, the lines now blurred will be erased. Tamriel and Oblivion "
"rejoined! The Mythic Age reborn!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11TheLightTopic_0008f12d_Oblivion_RESP4"
msgid "Soon, we will seek the light without her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10SheoJyggalag2_000913e7_Oblivion_RESP1"
msgid ""
"Soon. Too soon. I can already feel the change beginning. I feel like I'm not "
"quite here. I'm not over there yet, but I'm not quite here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05WhatNow_00015f22_Oblivion_RESP2"
msgid ""
"Sooner or later they will order him to return the guards to their original "
"posts. When that happens, come and tell me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004f221_Oblivion_RESP1"
msgid "Soris Arenim sure seems upset. I think he lost something important."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03GrommokChamberTwoDone_000671bb_Oblivion_RESP1"
msgid ""
"Sorry Syndelius. I don't know who built this nightmare, but if I get my hands "
"on them..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001bb25_Oblivion_RESP4"
msgid ""
"Sorry to break it to you like that, but if it wasn't for that annoying thief, "
"we wouldn't be in this predicament."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGJoin2_00024284_Oblivion_RESP1"
msgid "Sorry to hear that. If you change your mind, let me know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Gang_0003d4a0_Oblivion_RESP1"
msgid ""
"Sorry we had to fool you like that, but it was the only way to get someone in "
"close enough to stop Faustina's gang."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ShadyDeal_0001e7fb_Oblivion_RESP1"
msgid ""
"Sorry, I am not used to this kind of meeting. It always makes me nervous."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GarridansTears_000980f1_Oblivion_RESP1"
msgid "Sorry, I can no longer help you with that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003842f_Oblivion_RESP1"
msgid "Sorry, I have a lot of work to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00189186_Oblivion_RESP1"
msgid "Sorry, I have little time to speak."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00189182_Oblivion_RESP1"
msgid "Sorry, I must check in at Leyawiin Castle. Excuse me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00053751_Oblivion_RESP1"
msgid "Sorry, I'm too busy counting the number of rat droppings in my cell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000980ec_Oblivion_RESP1"
msgid "Sorry, I'm too busy to speak to you now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000980ee_Oblivion_RESP1"
msgid "Sorry, I'm too busy to speak to you now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000237ae_Oblivion_RESP1"
msgid "Sorry, buddy. I'm with Hides-His-Heart, and I can't be distracted. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000a317c_Oblivion_RESP1"
msgid ""
"Sorry, but I'm too busy to talk right now. Try one of the other Blades. "
"Perhaps Roliand or Cyrus?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseBuyCheydinhal_0004f213_Oblivion_RESP4"
msgid "Sorry, but as it stands now, the place is fairly bare. Enjoy!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GarridansTears_000980f0_Oblivion_RESP1"
msgid "Sorry, can't help you with that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a908_Oblivion_RESP1"
msgid ""
"Sorry, friend, but we've got nothing more to talk about. If you're ready to "
"fight, talk to Ysabel and she'll arrange the match."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Trespass_00062271_Oblivion_RESP1"
msgid ""
"Sorry, friend, it looks like you've wandered into a restricted area. You've "
"got to leave. Now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000a7148_Oblivion_RESP1"
msgid ""
"Sorry, friend, no time to talk! My friend Saliith and I are training to be "
"combatants in the Arena! It takes a lot of dedication to do what we do. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e95d_Oblivion_RESP1"
msgid ""
"Sorry, friend. It's not safe here. Can't talk now. Got to move. Carefully. "
"Don't want to bring the place down on our heads!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00035a32_Oblivion_RESP1"
msgid "Sorry, just doing my job."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000be33a_Oblivion_RESP1"
msgid ""
"Sorry, no time to talk! I have copies of the Black Horse Courier to deliver! "
"Here's one of the latest! The Imperial Legion commander's been murdered!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000be339_Oblivion_RESP1"
msgid ""
"Sorry, no time to talk! I have to deliver these copies of the Black Horse "
"Courier! Have the latest edition, free as always! It's about the Gray Fox!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000be337_Oblivion_RESP1"
msgid ""
"Sorry, no time to talk! I have to deliver these copies of the Black Horse "
"Courier! Have you heard of the Blackwood Company? Read all about them!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000be342_Oblivion_RESP1"
msgid ""
"Sorry, no time to talk! I have to deliver these copies of the Black Horse "
"Courier! Here, have a copy! The Night Mother rituals are on the rise!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000be338_Oblivion_RESP1"
msgid ""
"Sorry, no time to talk! I have to deliver these copies of the Black Horse "
"Courier! Here, have one of the latest editions, free as always!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000be33b_Oblivion_RESP1"
msgid ""
"Sorry, no time to talk! I have to deliver these copies of the Black Horse "
"Courier! Here, have the latest edition! Some Elf in Bruma got killed!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000be336_Oblivion_RESP1"
msgid ""
"Sorry, no time to talk! I have to deliver these copies of the Black Horse "
"Courier! Here, take a copy! It's free!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000475ad_Oblivion_RESP1"
msgid ""
"Sorry, sorry, sorry. Got to get cooking. I'm the cooking sister. I'm Shomara. "
"The cooking sister."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FrostSaltsTopic_00026bbf_Oblivion_RESP1"
msgid ""
"Sorry, that's all I had. The refining process is quite costly, and very "
"tedious."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FollowupNegative_0002423a_Oblivion_RESP1"
msgid "Sorry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00038f26_Oblivion_RESP1"
msgid "Sorry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000919cb_Oblivion_RESP1"
msgid "Sorry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONEXIT_0018b2e9_Oblivion_RESP1"
msgid "Sorry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c978_Oblivion_RESP1"
msgid ""
"Sorry. All I have is paints. Serviceable beasts, but nothing special. We "
"Nords are no great fanciers of horse flesh, except in stews, I'm afraid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Manor_00003a5e_Oblivion_RESP1"
msgid "Sorry. But how is this my problem?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003d4e2_Oblivion_RESP1"
msgid "Sorry. Can't talk right now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JOKEDISLIKE_0006231f_Oblivion_RESP1"
msgid "Sorry. I don't get it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TimeToGo_0002a7d9_Oblivion_RESP1"
msgid "Sorry. I have things to do. You'll have to leave now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE42Confused_0007322d_Oblivion_RESP1"
msgid ""
"Sorry. I keep forgetting that most people don't remember when we'll meet in "
"the future."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseInquiry_00066a1c_Oblivion_RESP1"
msgid ""
"Sorry. I'm looking for someone with a bit more renown. If you become suddenly "
"famous,  I would be glad to reconsider."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0d0_Oblivion_RESP1"
msgid "Sorry. I'm new in town. Don't know a soul."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006dc2a_Oblivion_RESP1"
msgid "Sorry. Only one copy of the Black Horse Courier per customer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038ab6_Oblivion_RESP1"
msgid "Sorry. You want me? I'm Shum gro-Yarug, the Count's butler."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005eede_Oblivion_RESP1"
msgid ""
"Souless Knights on the prowl, they say. Better carry a weapon with you. "
"Wouldn't want you to get hurt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_000289fd_Oblivion_RESP3"
msgid "Sound crazy? Well these are crazy times, my friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45Follow_00028696_Oblivion_RESP1"
msgid "Sounds good.  I'm right behind you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NorbertLellesTOPIC_000356b6_Oblivion_RESP1"
msgid "Sounds like everything is taken care of there. Good work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG02BribeBeggar_0000802e_Oblivion_RESP1"
msgid ""
"Sounds like food on the table. Lex has a small office in the South "
"Watchtower. Most of the tower is open to the public, but not his quarters."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NorbertLellesTOPIC_000356ba_Oblivion_RESP1"
msgid ""
"Sounds like he wants your help stopping the theft at his store. What are you "
"doing here talking to me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CurrentEventsResponses_000c459e_Oblivion_RESP1"
msgid ""
"Sounds like the Empire has given up on stopping the skooma trade in Elsweyr, "
"and I hear tribal chiefs are supporting the Renrijra Krin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00062677_Oblivion_RESP1"
msgid ""
"Sounds like the Skingrad branch of the guild can't even keep track of its "
"members. How appalling."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000c1c7_Oblivion_RESP1"
msgid ""
"Sounds like the coast is clear, so I'll make my way up to the ship's wheel. "
"But I'm not moving this hulk an inch until Ormil is safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_00159762_Oblivion_RESP2"
msgid ""
"Sounds like they were in it with Blackheart. As folks learn more about the "
"Blackwood Company's methods, they aren't so eager to hire them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_thieves_00002e50_Oblivion_RESP1"
msgid ""
"Sounds like we need to ask around Anvil for any clues. Figures we'd get a "
"mission without any real direction. I'll follow you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_thieves_00002e4c_Oblivion_RESP1"
msgid "Sounds like we'll find the bandits in Hrota Cave."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG12TravenWhere_000835fc_Oblivion_RESP2"
msgid "South of the White Rose river, nearly halfway to the border of Elsweyr."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetSpeechUmaril_00002a5e_Knights_RESP1"
msgid ""
"Spake Peninal: \"Beware, Morihaus, beware! With the foresight of death I know "
"now that my foe yet lives, bitter knowledge to take to my grave...\""
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00015e07_Oblivion_RESP1"
msgid "Spare a coin for the infirm?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate4_00015632_Oblivion_RESP1"
msgid "Spare me your pleasantries, Herdir. Ask what you will and be done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Yield_00025203_Oblivion_RESP1"
msgid "Spare me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bafc_Oblivion_RESP1"
msgid "Speak quickly! I have no time for mindless blather!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00061c7d_Oblivion_RESP1"
msgid "Speak quickly, mortal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00069752_Oblivion_RESP1"
msgid "Speak quickly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003be7c_Oblivion_RESP1"
msgid "Speak quickly. Cindanwe watches us. She watches us always..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Displeased_0001365c_Oblivion_RESP3"
msgid ""
"Speak to Arctus and Dervenin, the High Priests at the Sacellum Arden-Sul. "
"They can explain what needs to be done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThoronirTopic_0001d03e_Oblivion_RESP1"
msgid ""
"Speak to Thoronir first. Although I am happy you were able to recover some "
"solid evidence, he deserves to see it as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Orders_0001aeae_Oblivion_RESP1"
msgid "Speak to each of the Aureals to give them your orders."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08PlaceGuardsHelp_0001da85_Oblivion_RESP1"
msgid "Speak to each of the Aureals to give them your orders."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Orders_0001aead_Oblivion_RESP1"
msgid "Speak to each of the Mazken to give them orders."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08PlaceGuardsHelp_0001ec27_Oblivion_RESP1"
msgid "Speak to each of the Mazken to give them orders."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDAreldurTopic_00002b00_Knights_RESP4"
msgid ""
"Speak to him, if you can. Convince him to tell me what he knows, as a dying "
"man's last wish."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDAnvilChapel_00002a98_Knights_RESP4"
msgid ""
"Speak to the Prophet, in Anvil. He knows what this portends. He says it is "
"only the beginning."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062ccb_Oblivion_RESP1"
msgid "Speak while the sands are warm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrinaCrossInnTopic_0002fd6b_Oblivion_RESP3"
msgid ""
"Speak with Arielle Jurard when you arrive. She will be, let's say, "
"\"assisting\" you with your task."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05SylHelp_0001361f_Oblivion_RESP3"
msgid ""
"Speak with Herdir. He will help you. Do you understand what is required of "
"you? If no one is found, you will be held responsible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_tasks_00035f41_Oblivion_RESP1"
msgid "Speak with Irlav Jarol. He can give you the details you need."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00062454_Oblivion_RESP1"
msgid ""
"Speak with J'bari here in town. He's good with Light Armor; far better than I."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0006244c_Oblivion_RESP1"
msgid ""
"Speak with J'bari in Leyawiin. He can teach you all that you need to know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000a0fa_Oblivion_RESP1"
msgid "Speak with Jeanne Frasoric in Bruma, and see that she is all right."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00000811_AltarESPMain_RESP1"
msgid ""
"Speak with Oleta, at the Chapel of Akatosh in Kvatch. She will be able to "
"train you further."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_000613a5_Oblivion_RESP1"
msgid ""
"Speak with Oleta, at the Chapel of Akatosh in Kvatch. She will be able to "
"train you further."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002500f_Oblivion_RESP3"
msgid ""
"Speak with Raminus Polus at the Arcane University. He can lift the "
"suspension, and get you back on track."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_00053241_Oblivion_RESP2"
msgid "Speak with Raminus Polus when you arrive. He will assist you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG11ChoiceWhatNext_0003353f_Oblivion_RESP3"
msgid ""
"Speak with her specifically about these Black Soul Gems. If she knows "
"anything about their powers or creation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE01HaskillChoice8_000133e7_Oblivion_RESP3"
msgid ""
"Speak with me again when you have made up your mind. The anticipation is "
"almost too much to bear."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08PlaceGuardsYes_000181c3_Oblivion_RESP2"
msgid ""
"Speak with the Aureals and tell them where you wish them to stand. Then speak "
"to me when you are satisfied."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08PlaceGuardsYes_00017d86_Oblivion_RESP2"
msgid ""
"Speak with the Mazken and tell them where you wish them to stand. Then speak "
"to me when you are satisfied."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JanusHassildorTopic_0003567a_Oblivion_RESP2"
msgid "Speak with the castle steward when you arrive."
msgstr ""

