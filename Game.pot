msgid "Good one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_0004835f_Oblivion_RESP1"
msgid ""
"Good people of Cyrodiil, welcome to the Imperial City Arena! Believe it or "
"not, someone has actually challenged the unbeatable Arena Grand Champion!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_00046654_Oblivion_RESP1"
msgid "Good people of the Imperial City, welcome to the Arena!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICMonsterAnnounce_00093cd9_Oblivion_RESP1"
msgid ""
"Good people of the Imperial City, welcome to the Arena! You've come to watch "
"the Grand Champion battle some of Cyrodiil's fiercest creatures!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048361_Oblivion_RESP1"
msgid ""
"Good people, I give you the Blue Team's latest Champion, a warrior of skill, "
"strength, and determination!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICMonsterAnnounce_00093cdb_Oblivion_RESP1"
msgid ""
"Good people, the Grand Champion is victorious! Esteemed Grand Champion, leave "
"the Arena now and rest! You've earned it once again!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_0004667b_Oblivion_RESP1"
msgid ""
"Good people, we have a winner! All hail the combatant from the Blue Team! "
"Victor from the Blue Team, leave the Arena now and rest! You've earned it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAnnouncer_00048377_Oblivion_RESP1"
msgid ""
"Good people, you have just witnessed the impossible! Agronak gro-Malog has "
"been defeated! I say again, the Gray Prince has been defeated!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS12Stipend_00018232_Oblivion_RESP1"
msgid ""
"Good point. Allow me to formally introduce myself. I'm Countess Narina "
"Carvain. I assume you've noticed all of the Akaviri relics I'm displaying."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05WhatNow_00015f22_Oblivion_RESP1"
msgid ""
"Good question. I want you to spy on Hieronymus Lex. Make sure you stay close "
"enough to overhear any conversations."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD05Choice1_0002c5bb_Oblivion_RESP1"
msgid ""
"Good question. I've heard stories, but nothing I can prove is true. Maybe "
"they've got a mage working with them. Maybe they're just well trained."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e21_Oblivion_RESP1"
msgid ""
"Good riddance to the Blackwood Company, and good luck to the Fighters Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ08ArtifactL_00038fb8_Oblivion_RESP1"
msgid "Good riddance to this tool of mischief."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00073075_Oblivion_RESP1"
msgid "Good riddance!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000165bc_Oblivion_RESP1"
msgid "Good riddance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005327c_Oblivion_RESP1"
msgid "Good riddance."
msgstr ""

