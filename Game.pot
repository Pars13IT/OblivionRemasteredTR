msgctxt "ST_LogEntries/LOC_LE_MQ01_STAGE76_LOG0"
msgid ""
"You can <RT_BlueMed>Shortcut</> items and spells. \n"
"\n"
"In your journal, select an item or spell and press <IA "
"id=\"IA_UI_Specific_InventoryMenu_AssignToWheel\"/>to show the Shortcuts and "
"<RT_BlueMed>bind</> a slot by pressing <IA "
"id=\"IA_UI_Generic_Accept\"/>.\n"
"\n"
"Press <IA id=\"IA_Game_QuickKeys_OpenMenu\"/> to bring up the Shortcuts, then "
"use <IA id=\"IA_UI_Generic_NavigateRight\"/> to <RT_BlueMed>equip</> a slot "
"immediately."
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_MQ01_STAGE76_LOG1"
msgid ""
"You can <RT_BlueMed>Shortcut</> items and spells. \n"
"In your journal, select an item or spell and press <IA "
"id=\"IA_Game_QuickKeys_OpenMenu\"/> to select a slot, then use your mouse to "
"<RT_BlueMed>equip</> your choice. \n"
"Pressing <IA id=\"IA_Game_QuickKeys_Keyboard_1\"/> to <IA "
"id=\"IA_Game_QuickKeys_Keyboard_8\"/> will also equip that shortcut "
"immediately."
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_MQ01_STAGE64_LOG0_0"
msgid ""
"You have found a Mortar and Pestle. Go in your Inventory and find it. "
"Activate it to <RT_BlueMed>create potions and poisons</>."
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_MQ01_STAGE64_LOG0"
