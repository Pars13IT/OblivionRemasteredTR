msgid "[GS/DS Power Attack]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_00061cce_Oblivion_RESP1"
msgid "[GS/DS Power Attack]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002529c_Oblivion_RESP1"
msgid "[Gasp!] A burglar!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_00046679_Oblivion_RESP1"
msgid ""
"[Gasp!] Can this be? The Blue Team combatant is not wearing an Arena Battle "
"Raiment! The Blue Team is hereby disqualified!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Pickpocket_000626b8_Oblivion_RESP1"
msgid "[Gasp!] Guards, guards! This filthy cutpurse has purloined my valuables!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Corpse_00027528_Oblivion_RESP1"
msgid ""
"[Gasp!] Oh my goodness. Excuse me, are you all right? I... By the Divines, "
"this person's dead!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MageTalk3_0006a866_Oblivion_RESP1"
msgid ""
"[Gasp!] Surely you're joking! Are... Are you sure? I mean, I'm excited by "
"this news of course, but think of the ramifications!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_00062501_Oblivion_RESP1"
msgid "[Gasp!] What's going on?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Pickpocket_00062277_Oblivion_RESP1"
msgid "[Gasp!] Why you dirty little thief! How dare you touch me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00061ca1_Oblivion_RESP1"
msgid "[Knight Attack Sound]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008259e_Oblivion_RESP1"
msgid "[Knight Attack Sound]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008259f_Oblivion_RESP1"
msgid "[Knight Attack Sound]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00061c7c_Oblivion_RESP1"
msgid "[Knight of Order Hit Sound]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_000825a0_Oblivion_RESP1"
msgid "[Knight of Order Hit Sound]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_000825a1_Oblivion_RESP1"
msgid "[Knight of Order Hit Sound]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_00061c72_Oblivion_RESP1"
msgid "[Knight of Order POWER ATTACK sound]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_000825a2_Oblivion_RESP1"
msgid "[Knight of Order POWER ATTACK sound]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_000825a3_Oblivion_RESP1"
msgid "[Knight of Order POWER ATTACK sound]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark02PirateDoor_00049881_Oblivion_RESP1"
msgid ""
"[Knock knock knock!] Captain! Captain Tussaud! Are you all right sir? We... "
"We heard a clamor. Captain? We're coming in!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TRANSITION_0002a85a_Oblivion_RESP1"
msgid "[SIGH]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TRANSITION_0002a863_Oblivion_RESP1"
msgid "[SIGH]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TRANSITION_0002a857_Oblivion_RESP1"
msgid "[SNIFF]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TRANSITION_0002a860_Oblivion_RESP1"
msgid "[SNIFF]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TRANSITION_000617c8_Oblivion_RESP1"
msgid "[SNIFF]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TRANSITION_0002a85b_Oblivion_RESP1"
msgid "[SNORT]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TRANSITION_0002a864_Oblivion_RESP1"
msgid "[SNORT]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TRANSITION_000617c7_Oblivion_RESP1"
msgid "[SNORT]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk3_00068351_Oblivion_RESP1"
msgid ""
"[Sigh.] Look at me, acting the paranoid fool. I apologize, my lord. I meant "
"no disrespect. My nerves are taut as a bowstring!"
msgstr ""

