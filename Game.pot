msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0009f999_Oblivion_RESP1"
msgid "May Malacath forgive us for what we've done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00022a09_Oblivion_RESP1"
msgid "May Mara guide you in your travels."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00014831_Oblivion_RESP1"
msgid "May Shadow hide you."
