msgid "TEMP: 62 Emperor reaches marker H"
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_Charactergen_STAGE68_LOG1"
msgid "TEMP: 68 Emperor reaches marker J"
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_Charactergen_STAGE85_LOG1"
msgid "TEMP: 85: Baurus is supposed to kneel next to Emperor here."
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_Charactergen_STAGE86_LOG1"
