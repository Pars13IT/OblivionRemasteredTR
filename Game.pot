msgctxt "ST_ResponseTexts/LOC_RT_SE08Ally01Tactic3_00017991_Oblivion_RESP1"
msgid "Yes, Your Grace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Ally01Tactic3_000181bd_Oblivion_RESP1"
msgid "Yes, Your Grace."
