msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBows01_000908e0_Oblivion_RESP1"
msgid "Very well. You may bring it to me at any time and receive your reward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06StelaGreetA3_00018f94_Oblivion_RESP1"
msgid "Very well... I shall be your guide to Cylarne, then. Proceed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG00JoinA_0002d287_Oblivion_RESP2"
msgid "Very well... you are now an Associate of the Mages Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE41No_0006eab2_Oblivion_RESP1"
msgid "Very well... you have doomed a frail woman to certain death...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00049926_Oblivion_RESP1"
msgid "Viator Accius has a good shield selection at Stonewall Shields."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_000251c2_Oblivion_RESP1"
msgid ""
"Vicente wants YOU to infiltrate the Imperial Prison? I didn't realize you had "
"such a good sense of humor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006090b_Oblivion_RESP1"
msgid ""
"Victory calls for celebration, don't you think? I wish I had the coin to "
"drink a toast to Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000131a9_Oblivion_RESP1"
msgid ""
"Victory is ours! I have already instructed my subordinates to kindle the "
"Altar of Rapture."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000131a8_Oblivion_RESP1"
msgid ""
"Victory is ours! I have already selected a candidate for the honor of "
"kindling the Altar of Rapture."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017972_Oblivion_RESP1"
msgid "Victory is ours... for the moment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017d54_Oblivion_RESP1"
msgid "Victory is ours... for the moment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00080d89_Oblivion_RESP1"
msgid "Victory is sweet!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000165c7_Oblivion_RESP1"
msgid "Victory is yours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008247b_Oblivion_RESP1"
msgid "Victory or death."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607c9_Oblivion_RESP1"
msgid ""
"Victory over Order! That calls for a grand celebration. Break out the casks "
"of Skooma!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEArctusSpeech09_00089891_Oblivion_RESP1"
msgid "Victory to the Demented!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0018bd5d_Oblivion_RESP1"
msgid "Victory will be mine!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000c42cb_Oblivion_RESP1"
msgid "Victory!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e08a_Oblivion_RESP1"
msgid "Vigdis, Fighters Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c236_Oblivion_RESP1"
msgid ""
"Vigge the Cautious is responsible for enchanted item recharge at the Mages "
"Guild. Good thing he's cautious. I'd hate to have something go wrong. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e37_Oblivion_RESP1"
msgid ""
"Vilena Donton hasn't been very aggressive as head of the Fighters Guild. "
"Maybe her son Viranus will show a bit more spunk."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000241e1_Oblivion_RESP1"
msgid ""
"Vilena Donton just hasn't been the same since her eldest son died. Still, she "
"does a good job of running the Fighters Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e38_Oblivion_RESP1"
msgid ""
"Vilena Donton needs to set a fire under the Fighters Guild if they expect to "
"compete with the Blackwood Company."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VitellusDontonTOPIC_0002d725_Oblivion_RESP1"
msgid ""
"Vilena Donton's eldest son. Good man. We lost him on a botched mission "
"recently. You've probably seen the other wounded around."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00024e08_Oblivion_RESP1"
msgid ""
"Vilena Donton, Master of the Fighters Guild. Please excuse the mess. "
"Paperwork. But what can I do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ViranusDontonTOPIC_0002d71d_Oblivion_RESP2"
msgid ""
"Vilena coddles the boy too much. Doesn't want him in the line of fire. "
"Suppose it's no surprise after Vitellus."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032eb8_Oblivion_RESP1"
msgid ""
"Vilena is pretty useless since Vitellus died. Thank gods Oreyn is around to "
"keep things together."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD05Choice2_0002c5bc_Oblivion_RESP1"
msgid ""
"Vilena's gotten tentative since the Blackheart mission. She's worried about "
"getting us killed. But we're just getting killed a little bit at a time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047680_Oblivion_RESP1"
msgid ""
"Vinicia Melissaeia, Office of Imperial Commerce. You got complaints? Of "
"course you got complaints. Who doesn't?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_00049972_Oblivion_RESP1"
msgid ""
"Vinicia may have the worst job in Cyrodiil. She takes complaints all day, and "
"nothing ever comes of them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004996f_Oblivion_RESP1"
msgid "Vinivia Melissaeia takes all the merchant complaints in the city."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e76_Oblivion_RESP1"
msgid "Viranus is a good kid. It's his mom who's getting in the way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e75_Oblivion_RESP1"
msgid ""
"Viranus is just a kid. But he did pretty well at Nonwyll Cavern, I guess."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e79_Oblivion_RESP1"
msgid ""
"Viranus needs to stop hiding behind his mother's skirts if he expects to run "
"this outfit someday."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e74_Oblivion_RESP1"
msgid ""
"Viranus wasn't alone at Nonwyll Cavern, you know. Would he have done that "
"well without help?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e30_Oblivion_RESP1"
msgid ""
"Viranus, the Fighters Guild son-and-heir, is dead, and Vilena kicked Modryn "
"Oreyn out of the guild. The Fighters Guild is falling apart."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bc7b_Oblivion_RESP1"
msgid ""
"Virtuous visitors to Wayshrines of Kynareth may receive Blessings of Agility."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005efe5_Oblivion_RESP1"
msgid ""
"Visit Passwall once, Relan did. Good that it burned. People there deserve "
"pain."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d88e_Oblivion_RESP2"
msgid ""
"Visit her at the Leyawiin Guild hall. But be aware that she's a bit...  odd."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007f44e_Oblivion_RESP1"
msgid "Visit me during store hours. These are private moments."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001c470_Oblivion_RESP1"
msgid "Visitors ain't allowed down heres."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_0008f03e_Oblivion_RESP1"
msgid "Vitharn is doomed!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008f03a_Oblivion_RESP1"
msgid "Vitharn shall fall!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_0008f040_Oblivion_RESP1"
msgid "Vitharn!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488eb_Oblivion_RESP1"
msgid ""
"Vlanarus Kvinchal. Kastav is my brother, all right, but I'm nothing like that "
"deadbeat."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081dc3_Oblivion_RESP1"
msgid "Voices from nowhere. I don't get paid enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesGuildTopic_0006260f_Oblivion_RESP1"
msgid ""
"Volanaro has a twisted sense of humor, but he also has a few nice spells up "
"his sleeve. If you want to summon a Bound sword, talk to him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c9a6_Oblivion_RESP1"
msgid ""
"Volanaro, at your service. Need a spell? Need an item recharged? Need a witty "
"practical joke played on someone? I can handle it all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e8d5_Oblivion_RESP1"
msgid ""
"Voranil got parties near about every night, and there's plenty of cooking and "
"cleaning and preparing to be done. If you don't mind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0003dfbf_Oblivion_RESP1"
msgid "Voranil is such a fool. Have you seen how he treats his servants?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03GrommokChamberThreeMan01_00067706_Oblivion_RESP1"
msgid "WHAT!? How in Oblivion can I be dead?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG05AChoice1A_00028c07_Oblivion_RESP1"
msgid "WHAT?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE34Medallion_00066eaa_Oblivion_RESP1"
msgid ""
"Wait a moment... if you'll pardon my manners, you reek of the bogs. You must "
"have been to the Fetid Grove!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_0001d113_Oblivion_RESP1"
msgid "Wait here with the Emperor. Guard him with your life."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00056e6a_Oblivion_RESP2"
msgid "Wait here. I will tell the Count you are waiting to see him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00056e6c_Oblivion_RESP2"
msgid "Wait here. I will tell the Count you are waiting to see him."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03SyndelChamberOneGrow01_00066e3d_Oblivion_RESP1"
msgid "Wait just a moment... what's that sound?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AThadonShout_0008f530_Oblivion_RESP1"
msgid "Wait! I must speak! Halt! Cease! Desist!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BSylShout_0008f57f_Oblivion_RESP1"
msgid "Wait! I must speak! The Ritual must not be completed!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00022e0d_Oblivion_RESP1"
msgid "Wait! I need to speak with you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05RavenSpeech_00095899_Oblivion_RESP1"
msgid ""
"Wait! I've seen you before! You're the Blade that Brother Astav was tailing!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate1_00013fee_Oblivion_RESP1"
msgid ""
"Wait! Wait, no. Please. All I know is that on certain nights, Syl asked me to "
"guard her chambers. She never said why. I think she went somewhere."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00025273_Oblivion_RESP1"
msgid ""
"Wait, I know you... You... You're the one! That day the Emperor was killed! "
"They went through your cell! You lucky bastard! But... You came back?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004cad8_Oblivion_RESP1"
msgid ""
"Wait, I know you... You... You're the one! That day the Emperor was killed! "
"They went through your cell! You lucky strumpet! But... You came back?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04XedilianChoice_00044f52_Oblivion_RESP2"
msgid ""
"Wait, scratch that. Cheese for no one. That can be just as much of a "
"celebration, if you don't like cheese. True?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE42Confused_0007322d_Oblivion_RESP2"
msgid "Wait, this is yesterday's future. I'm the one that's confused."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaChoice1A_00029ca6_Oblivion_RESP2"
msgid ""
"Wait, you're serious, aren't you? What is with you people? You walk in, want "
"to be combatants, and your entrails end up decorating my Red Room."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilA1_0001587a_Oblivion_RESP1"
msgid ""
"Wait. I know who you must be. You're the one who killed Raven and Ruma. They "
"told me about you, when I was still in their father's favor..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ16MartinB_0004bfbd_Oblivion_RESP1"
msgid ""
"Wait. Yes. The Amulet was given to mortals by Akatosh... it contains His "
"divine power..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033593_Oblivion_RESP1"
msgid "Wait... I have much to tell you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark06Choice1A_0002fbb1_Oblivion_RESP1"
msgid ""
"Wait... You... You lied! Ohh... That's mean! Nordinor.. In Bravil... He sells "
"skooma! Late at night... Go get me some... Okay?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03GrommokChamberOneGnarl03_00066e32_Oblivion_RESP1"
msgid "Wait... what's wrong with Lewin?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e7f_Oblivion_RESP2"
msgid ""
"Wait... you don't work here, do you? But you do work for me. At least, you're "
"supposed to be working for me. Off you go, then."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003b96e_Oblivion_RESP1"
msgid ""
"Wait... you're not one of them... no. You're fine. Cats. They're everywhere. "
"But my babies protect me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark10SancChoice1A_00032bf0_Oblivion_RESP4"
msgid ""
"Waiting just outside is a magnificent steed named Shadowmere. She has served "
"me well. I present her now to you, as a token of my trust and love."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark10SancChoice1B_00032bf1_Oblivion_RESP4"
msgid ""
"Waiting just outside is a magnificent steed named Shadowmere. She has served "
"me well. I present her now to you, as a token of my trust and love."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark10SancChoice1C_00032bf3_Oblivion_RESP4"
msgid ""
"Waiting just outside is a magnificent steed named Shadowmere. She has served "
"me well. I present her now to you, as a token of my trust and love."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0018a955_Oblivion_RESP1"
msgid "Waiting's been difficult, I hope your journey was successful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033349_Oblivion_RESP1"
msgid ""
"Wake up, Redguard! Ah, there you are. How do you like your cell, huh? Roomy "
"enough for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_0003333d_Oblivion_RESP1"
msgid ""
"Wake up, kitty kitty. That's it. There's a rat in my cell, Khajiit. A fat, "
"tasty rat. Does the kitty want it? Is the kitty hungry?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_0003334a_Oblivion_RESP1"
msgid ""
"Wake up, pretty Redguard! Ah, there you are. How do you like your cell, huh? "
"Roomy enough for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00004b9f_DLCVileLair_RESP1"
msgid "Walk always in the Shadow of Sithis."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00007972_DLCVileLair_RESP1"
msgid "Walk always in the Shadow of Sithis."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00034031_Oblivion_RESP1"
msgid "Walk always in the Shadow of Sithis."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32WhatCanIDo_00012d05_Oblivion_RESP2"
msgid ""
"Walk among them. There were four who failed to protect the gate lever. Find "
"out what they did wrong and help them correct it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_0018ae86_Oblivion_RESP1"
msgid ""
"Walk just up the stairs there, and it's the door on the right. Thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000243bd_Oblivion_RESP1"
msgid "Walk where your road must take you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00061cc8_Oblivion_RESP1"
msgid "Walk with Our Lord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00034034_Oblivion_RESP1"
msgid "Walk with darkness, child of the Night Mother."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000029e8_Knights_RESP1"
msgid "Walk with the Nine, Sir Knight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062ca6_Oblivion_RESP1"
msgid "Walk with virtue, friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDPilgrimageTopic_00002a9b_Knights_RESP2"
msgid "Walking the Pilgrim's Way is the traditional start of a holy quest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_00038ab3_Oblivion_RESP1"
msgid ""
"Wander the streets, fields, and public places of Skingrad to your heart's "
"content. Just don't include me in your social explorations."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00071f30_Oblivion_RESP1"
msgid ""
"Wanna buy a stick? I gotta fresh one right here. No? Then what can I do for "
"ya?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeGreavesMagic_000400b8_Oblivion_RESP1"
msgid "Want some help putting these on?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479b0_Oblivion_RESP1"
msgid "Want to hear a Khajiit joke?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopicGrayFox_0004891c_Oblivion_RESP1"
msgid ""
"Want to learn more? Visit the Waterfront District of the Imperial City. Find "
"the Garden of Dareloth at midnight. Then ask your questions."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032eb0_Oblivion_RESP1"
msgid ""
"Want to pick up a shield and go a few rounds later? Been a while since I saw "
"real action."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007fde2_Oblivion_RESP1"
msgid ""
"War has come to the Shivering Isles at last. We stand ready to protect these "
"lands."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062c8b_Oblivion_RESP1"
msgid "Warm day to you, friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022500_Oblivion_RESP1"
msgid ""
"Warmest greetings to you. I trust you've already spoken with Ocheeva? I am "
"Vicente Valtieri. I provide assignments for all new family members."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000251dd_Oblivion_RESP1"
msgid ""
"Warmest welcomes to you. I am Telaendril, Wood Elf and loyal daughter of "
"Sithis. I hope you find our Sanctuary to your liking."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0014684e_Oblivion_RESP1"
msgid ""
"Warrior? You? Ha ha ha ha ha ha ha ha! Just... Just look at you! Ha ha ha ha "
"ha ha! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032ebf_Oblivion_RESP1"
msgid ""
"Was Vigdis our most recent recruit? Or Lensi Llharam? It's been so long, I "
"forget."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00012d07_Oblivion_RESP1"
msgid "Was my sin so great that I must suffer for all eternity?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ADMIREDISLIKE_0018b2a5_Oblivion_RESP1"
msgid "Was that supposed to be a compliment?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5a3_Oblivion_RESP1"
msgid "Was that you? What did you eat?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081d92_Oblivion_RESP1"
msgid "Was that...? Nah, just my imagination."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003d4bb_Oblivion_RESP1"
msgid "Wasn't I clear?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000343e6_Oblivion_RESP1"
msgid "Waste no time. You must find Martin before the enemy does."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bcc3_Oblivion_RESP1"
msgid ""
"Watch for minotaurs in the forests. Aggressive beasts. They'll tear right "
"through your armor, too."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077c46_Oblivion_RESP1"
msgid ""
"Watch for the Elytra's stingers; their poison can be deadly. They don't like "
"magic much, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00072df5_Oblivion_RESP1"
msgid "Watch for them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Ceremony_00014aea_Oblivion_RESP1"
msgid ""
"Watch my child destroy the interlopers, or run to Sheogorath. Either way, "
"tell Him of our doings here. Send Him my tribute... and my affections."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00088b40_Oblivion_RESP1"
msgid "Watch out for Anaxes. Some meddling fool must have let him loose."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46Goblins_000319ce_Oblivion_RESP1"
msgid ""
"Watch out for them if you're heading north. We ran into goblin war parties "
"northwest of here, while starting to build a new settlement."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ObserveCombat_00027959_Oblivion_RESP1"
msgid "Watch out!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0006b82b_Oblivion_RESP1"
msgid "Watch out! There may be more of them!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_sons_0002573f_Oblivion_RESP1"
msgid ""
"Watch over them, and keep them safe. I couldn't bear to lose them to those "
"monsters."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraSpeech_0005dc94_Oblivion_RESP1"
msgid "Watch over these souls, who have strayed from the light of your love."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00051e9f_Oblivion_RESP1"
msgid "Watch the flank!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00054679_Oblivion_RESP1"
msgid "Watch the flank!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32CombatYell_0001b6fe_Oblivion_RESP1"
msgid "Watch the gate!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00014a38_Oblivion_RESP1"
msgid "Watch your back, Baurus!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00034472_Oblivion_RESP1"
msgid "Watch your back, citizen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00072f10_Oblivion_RESP1"
msgid "Watch your back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000917ca_Oblivion_RESP1"
msgid ""
"Watch your step in the Silo. Thadon doesn't want just anyone traipsing "
"through there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bcbe_Oblivion_RESP1"
msgid ""
"Watch yourself around goblins. Some of the nastier ones will toss spells at "
"you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0c1_Oblivion_RESP1"
msgid ""
"Watch yourself around the Fo'c's'le. Sailors despise landsmen, and won't "
"hesitate to treat them to a good beating when they're in their cups."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFellmoorTopic_0003be76_Oblivion_RESP1"
msgid ""
"Watch yourself while you're here. Cindanwe is out for us. She cares for "
"nothing but work, and she keeps us as slaves! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0004fa70_Oblivion_RESP1"
msgid "Watch yourself, prisoner!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bc80_Oblivion_RESP1"
msgid ""
"Wayshrines of Arkay confer Blessings of Health on those who've pleased the "
"Nine by righteous acts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bc79_Oblivion_RESP1"
msgid ""
"Wayshrines of the Nine in the wilderness confer blessings on the righteous "
"and faithful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BleakersWayTopic_0001ece0_Oblivion_RESP1"
msgid ""
"We Dalvilus are good neighbors to the Ulfgars, and our leaders, Hrol Ulfgar "
"and Nivan Dalvilu, work hard to keep it that way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034510_Oblivion_RESP1"
msgid ""
"We agreed I would meet the Sponsor. You need to get out of sight before you "
"blow the whole meeting."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_00061786_Oblivion_RESP1"
msgid "We all knew that's how Thadon would go. But, Syl?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000355cb_Oblivion_RESP2"
msgid ""
"We all love Count Marius, and his father before him... Arkay bless his "
"soul... such a fine young man..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d28c_Oblivion_RESP1"
msgid ""
"We all owe you a debt of gratitude for closing that Oblivion Gate. Thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00062be7_Oblivion_RESP1"
msgid ""
"We all owe you our lives. From what I've heard, the battle was hanging in the "
"balance until you destroyed that horrible daedric machine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000475d0_Oblivion_RESP4"
msgid ""
"We all profit by your lawful pursuit of the unlawful, and we encourage you to "
"attack, burn, loot, and destroy them wherever you can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity8_00081e8d_Oblivion_RESP3"
msgid ""
"We already have one of those, I'm afraid. It wasn't all that Odd to begin "
"with, honestly. We certainly can't have two."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07Spies_00020077_Oblivion_RESP3"
msgid ""
"We always see them near the runestone at dusk. They aren't too woodcrafty, "
"but Grandmaster Jauffre has forbidden us to range too far from the walls."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000335fa_Oblivion_RESP1"
msgid "We appreciate it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGJoin1_0002427e_Oblivion_RESP1"
msgid ""
"We appreciate your interest, but I understand you've got a bounty on your "
"head. Take care of that, and we'll consider your application."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGJoin1_00024281_Oblivion_RESP1"
msgid ""
"We appreciate your interest, but you've got quite a nasty reputation. Do "
"something about that, and perhaps we'll consider your application."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KnightsofThorn_00031842_Oblivion_RESP1"
msgid ""
"We are Knights sworn to uphold the laws of Cheydinhal. We fear no being, and "
"we strike fast and true as lightning."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KnightsofThorn_000c452c_Oblivion_RESP1"
msgid ""
"We are Knights sworn to uphold the laws of Cheydinhal. We fear no being, and "
"we strike fast and true as lightning."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_duties_0000344b_Oblivion_RESP1"
msgid ""
"We are a brotherhood, a family. What affects one of us affects us all. "
"Fighting, drunkenness, dereliction of duty are not tolerated."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFellmoorTopic_0003be78_Oblivion_RESP1"
msgid ""
"We are a farming community. Nothing more. Nothing less. That is, when I can "
"get these layabouts to actually put in a day's work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OrderOfTalosTopic_00033dfc_Oblivion_RESP1"
msgid ""
"We are a monastic order devoted to divine Talos, who was the mortal Tiber "
"Septim, the founder of the empire."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PellsGateTOPIC_00026b13_Oblivion_RESP1"
msgid ""
"We are a small community. Mostly keep to ourselves. Can't say it isn't nice "
"to see a new face around, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG18Choice3A_00070487_Oblivion_RESP2"
msgid ""
"We are after the same things, your guild and I. Yet you worry about 'good' "
"and 'evil' and do not accept they are manifestations of the same thing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDKnightsTopic_00002bd8_Knights_RESP1"
msgid ""
"We are all reunited once more. You have done what we once thought impossible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_00061c69_Oblivion_RESP1"
msgid "We are all safer now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00055b03_Oblivion_RESP1"
msgid ""
"We are all that are left. The others were struck down by Order. How did this "
"happen?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00079c09_Oblivion_RESP1"
msgid ""
"We are all that are left. The others were struck down by Order. How did this "
"happen?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002A2A_AltarDeluxe_RESP1"
msgid "We are blessed by an Envoy of Lord Dagon!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06HelpDefend_000131b5_Oblivion_RESP1"
msgid ""
"We are expecting the Aureals to attack any moment. They'll come down the main "
"passage from the Altar of Rapture. They always do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0001fe8a_Oblivion_RESP1"
msgid "We are from Anvil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00020058_Oblivion_RESP1"
msgid "We are from Bravil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_00020087_Oblivion_RESP1"
msgid "We are from Bruma."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_00020079_Oblivion_RESP1"
msgid "We are from Cheydinhal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_0001fe86_Oblivion_RESP1"
msgid "We are from Chorrol."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KvatchTopic_0001fe87_Oblivion_RESP1"
msgid "We are from Kvatch."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_0001fe89_Oblivion_RESP1"
msgid "We are from Leyawiin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_0001fe88_Oblivion_RESP1"
msgid "We are from Skingrad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_00020086_Oblivion_RESP1"
msgid "We are from the IC (not to be confused with the OC)."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11LastHeist_0001fb4f_Oblivion_RESP2"
msgid ""
"We are going to steal one of the Elder Scrolls from the Imperial Palace. Are "
"you ready for this challenge?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OrderOfTalosTopic_00033dfb_Oblivion_RESP4"
msgid ""
"We are honored to have Grandmaster Jauffre, or Brother Jauffre as he prefers, "
"as a resident here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000251d6_Oblivion_RESP1"
msgid ""
"We are kin, yet I cannot help but despise you. Leave my sight, before I do "
"something I regret."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MSMiscKotT_000c453c_Oblivion_RESP1"
msgid "We are led by Farwil Indarys. Yes, the Count's son himself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008511c_Oblivion_RESP1"
msgid ""
"We are not afraid of the dark. The Night Mistress gives us eyes to see "
"night's secrets."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000a78da_Oblivion_RESP1"
msgid ""
"We are not yet done with your test. When you have passed or failed, then we "
"may have reason to speak."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElderCouncilTopic_000add0c_Oblivion_RESP1"
msgid ""
"We are now the stewards of the Empire. We can hold the Empire together in the "
"short term."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk4_0018d7f8_Oblivion_RESP1"
msgid "We are one mind and one blade, of course."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD07Choice2_00098198_Oblivion_RESP1"
msgid "We are over one hundred strong now. We grow by the day!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06KanehGreetA_000131ab_Oblivion_RESP2"
msgid ""
"We are preparing to sweep the Mazken scum from Cylarne. Perhaps Sheogorath "
"sent you to help us?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06UlfriGreetA1_000131b2_Oblivion_RESP1"
msgid "We are preparing to wipe out the arrogant Aureals once and for all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008d32a_Oblivion_RESP1"
msgid "We are safe in your presence, Lord. Thank you."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061ca2_Oblivion_RESP1"
msgid "We are safe. For now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033b27_Oblivion_RESP1"
msgid "We are so very sooth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07WhyNotKillLex_0000c049_Oblivion_RESP1"
msgid ""
"We are thieves, not murderers. That is the province of the Dark Brotherhood."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008ef56_Oblivion_RESP1"
msgid "We are vigilant."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001d23f_Oblivion_RESP2"
msgid ""
"We are, for lack of a better word, defenders. We guard this city from an "
"infestation that plagues it. We are vampire hunters."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HenantierTopic_00027f31_Oblivion_RESP1"
msgid ""
"We aren't going far, so no need to prepare for a long journey. In fact, he's "
"still in town. More I can't say aloud without risk of others hearing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS31Selene04Negative_0000c1ef_Oblivion_RESP1"
msgid ""
"We aren't here for that! My patience is at an end, as will soon be your life!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04WhereIsAmusei_00035fad_Oblivion_RESP1"
msgid ""
"We arrested that miscreant. The stupid lizard tried to blackmail the "
"Countess. I wouldn't waste much time thinking about him any more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice1A_00028150_Oblivion_RESP2"
msgid ""
"We believe it's somewhere south of Chorrol, but south-west of Fort Carmala. "
"It may be difficult to find."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_MG04ChoiceCarahilContinue_0004f228_Oblivion_RESP1"
msgid ""
"We believe the killings are the actions of a rogue mage. Battlemages have "
"been sent to the Brina Cross Inn, the only common link between the victims."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MerchantTopic_0002ee50_Oblivion_RESP3"
msgid "We believe these deaths to be the actions of a rogue Mage."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005c0bd_Oblivion_RESP1"
msgid "We bow before the Ring."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061b75_Oblivion_RESP1"
msgid "We can all sleep better with the armies at full strength."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RulesOfCompetition_0003d7b4_Oblivion_RESP2"
msgid ""
"We can do them any time of the day. You kidding? The citizens of the Imperial "
"City would love some late-night entertainment!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02GatesOfMadness_0007eaaa_Oblivion_RESP1"
msgid ""
"We can go in? Well... I better stay here. There's no telling what kind of "
"diseases are floating around in there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GenericBanditB_000a333d_Oblivion_RESP1"
msgid "We can play it that way if you like."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0002e5e5_Oblivion_RESP1"
msgid ""
"We can talk, so long as Falcar is out of earshot. If I didn't know any "
"better, I'd say he's trying to get you killed!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateConv_000545f4_Oblivion_RESP1"
msgid "We can use your help! Let's go!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateConv_000980aa_Oblivion_RESP1"
msgid "We can use your help! Let's go!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00043cd2_Oblivion_RESP1"
msgid "We can't advance until you get that gate open!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00000923_Oblivion_RESP1"
msgid ""
"We can't be seen talking!  I waited for you last night behind the Great "
"Chapel, where WERE you?!  I'll meet you there tonight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000224a8_Oblivion_RESP1"
msgid ""
"We can't keep stopping to talk like this! We've got to get out there and "
"fight!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CastleGateTopic_00090ab5_Oblivion_RESP1"
msgid ""
"We can't open that gate from out here. The only mechanism for raising it is "
"inside the gatehouse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e63_Oblivion_RESP1"
msgid ""
"We can't talk about it. Just go about your business. If Oreyn needs "
"something, he'll let us know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38StartQuest_0002a871_Oblivion_RESP1"
msgid ""
"We can't talk here. Too public. Meet me behind the Great Chapel at midnight. "
"Don't let anyone follow you. I'll make it worth your while."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05BaurusA_00022b14_Oblivion_RESP1"
msgid "We can't talk now! Just follow my lead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeatherleahTopic_00028ac4_Oblivion_RESP1"
msgid "We can't wait to return to Weatherleah, now that the ogres are dead!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ThoronirBad_0000bca2_Oblivion_RESP7"
msgid ""
"We cannot do it ourselves, as he recognizes all of us. The job pays a fair "
"bounty in gold when he is brought to justice."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE08CommanderGreeting3a_000186fc_Oblivion_RESP1"
msgid ""
"We cannot talk now -- we don't have very long until the next wave arrives. "
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE08CommanderGreeting3a_00018c7e_Oblivion_RESP1"
msgid ""
"We cannot talk now -- we don't have very long until the next wave arrives. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDKnightsStartCombat_00002b4f_Knights_RESP1"
msgid "We cannot win this battle! You must destroy the Orb at once!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Become_00013657_Oblivion_RESP2"
msgid ""
"We celebrate him with the Ritual of Accession... the path to Maniac Bliss."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034ea8_Oblivion_RESP1"
msgid "We come to the real work at last."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ICAllNQDResponses_00049964_Oblivion_RESP1"
msgid ""
"We could just listen to people talking. It's uncanny how informed people are."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KvatchTopic_0002855b_Oblivion_RESP2"
msgid ""
"We couldn't have been any less prepared for this. Seems like they came out of "
"nowhere. There were just so many of them..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RaynilDralasTopic_0003843c_Oblivion_RESP8"
msgid ""
"We did a follow up investigation, and it's true that no one recollects seeing "
"Bradon out in the daylight. He's only been spotted at night."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c144_Oblivion_RESP1"
msgid "We did it! We showed those damned daedra a thing or two!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ09GhostB_00036666_Oblivion_RESP2"
msgid ""
"We did not know that the Underking, who was Zurin Arctus, had arisen to take "
"his first revenge upon his former lord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000ace2c_Oblivion_RESP1"
msgid ""
"We don't go looking for new worshippers. If people are interested, they can "
"find us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004d827_Oblivion_RESP2"
msgid ""
"We don't have any horses for sale right now. You bought our last Bay horse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004d16d_Oblivion_RESP2"
msgid ""
"We don't have any horses for sale right now. You bought our last White horse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002c592_Oblivion_RESP1"
msgid "We don't have time to talk. I want to find Blackheart. What do you need?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_00032b06_Oblivion_RESP1"
msgid "We don't know that, Sire. The messenger only said they were attacked."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00028bc8_Oblivion_RESP1"
msgid "We don't like strangers meddling in our affairs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028212_Oblivion_RESP1"
msgid "We don't like strangers poking their noses into our business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HackdirtTopic_000286a0_Oblivion_RESP1"
msgid ""
"We don't look kindly on strangers asking questions.  If you need a room, try "
"Moslin's Inn.  Otherwise, you'd best be moving on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e8c3_Oblivion_RESP2"
msgid ""
"We don't much like spellcasters in Hammerfell. Wizards steal souls and tamper "
"with minds. If you use magic, you're weak or wicked."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_000165e4_Oblivion_RESP1"
msgid ""
"We don't talk about him in public. The Thieves Guild follows the Gray Fox. "
"However, we make sure that most folks think he is just a myth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000ace2a_Oblivion_RESP1"
msgid "We don't want more worshippers. We just want to be left alone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000ace48_Oblivion_RESP1"
msgid "We don't welcome visitors, but we don't murder them either."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c98b_Oblivion_RESP1"
msgid ""
"We drink because we're happy. We're Nords. It's just the thick tongue and fat "
"head the day after that makes me unhappy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG09Choice5C_00022bdd_Oblivion_RESP1"
msgid ""
"We feared Hassildor may have been involved with the Necromancers. Thanks to "
"your involvement, it would seem that he is not."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00031036_Oblivion_RESP4"
msgid ""
"We figured it was time to move on to a new prank. This one was getting "
"boring, anyway. So you can tell her you've found me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e89_Oblivion_RESP1"
msgid ""
"We filled the Desolate Mine contract, but the butcher's bill was pretty steep."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003c35a_Oblivion_RESP1"
msgid "We finally got him! There'll be no excuses this time. Ulrich is mine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD05Choice9_0002c622_Oblivion_RESP1"
msgid ""
"We find Blackheart and get that weapon. We'll finish this contract and let "
"all of Cyrodiil know what happened here."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ND10FinThedretGreeting01a_00002ca5_Knights_RESP2"
msgid ""
"We found Umaril's body next to yours, but it seemed that you had met the same "
"fate as Pelinal Whitestrake. We didn't know..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13Gate_000329e9_Oblivion_RESP5"
msgid ""
"We found the way back blocked by more daedra. So we were stuck here until "
"rescued by you. It's just like Farwil to leap before he looks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND03AltarofKynareth_00002a4f_Knights_RESP2"
msgid ""
"We gather here to pay tribute to all of the blessings she bestows upon us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022506_Oblivion_RESP1"
msgid ""
"We got plenty of rooms if you want one. Ain't nobody staying here these days "
"'cept old Rufio."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GaltusPreviaTOPIC_0002d729_Oblivion_RESP1"
msgid ""
"We got the contract from his aunt. Was in Nonwyll looking for gems of some "
"sort. Never heard from again. You and Viranus go find him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005c0c1_Oblivion_RESP1"
msgid "We greet you, Spellbreaker."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d49b_Oblivion_RESP1"
msgid ""
"We had a feeling you'd be surprised when you saw us in our real uniforms. I "
"see you have a puzzled look on your face. Ask away."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE42AgreeLie_0007322e_Oblivion_RESP1"
msgid ""
"We had an agreement, don't you remember? I'm trying to build a skyboat and "
"you are supposed to bring me calipers and tongs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KvatchTopic_000699fc_Oblivion_RESP2"
msgid ""
"We had everything here. Beautiful gardens. Fresh mountain air. Did you know "
"Kvatch had the only Arena in Cyrodiil outside the Imperial City?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46Goblins_00033efc_Oblivion_RESP1"
msgid ""
"We had just set up at Cropsford when Mirisa came running in. Said goblins "
"were heading our way. We barely escaped with our lives!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDKnightsTopic_00002bd6_Knights_RESP1"
msgid ""
"We had only the best of intentions. Truly, we did. We meant only to serve the "
"Nine and the Empire. It's hard to believe it all went so wrong."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS26CorruptGuard_00035c98_Oblivion_RESP3"
msgid "We had to pay his \"fine\" or go to jail."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS26CorruptGuard_000363b8_Oblivion_RESP3"
msgid "We had to pay the \"fine\" or he was going to march us off to jail."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46NewSettlement_000319d6_Oblivion_RESP3"
msgid ""
"We have a charter from the county, everything done official and by the book."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d49a_Oblivion_RESP1"
msgid ""
"We have a lot of paperwork and follow-up investigation to do. Please, leave "
"us to it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MankarSpeech_0001fb36_Oblivion_RESP1"
msgid ""
"We have a new Brother who wishes to bind himself to the service of Lord Dagon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MankarSpeech_0001fb35_Oblivion_RESP1"
msgid ""
"We have a new Sister who wishes to bind herself to the service of Lord Dagon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e60_Oblivion_RESP1"
msgid ""
"We have a new master. And with Oreyn to run daily affairs, we should be in "
"good shape."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG00JoinA_0002d284_Oblivion_RESP4"
msgid ""
"We have a responsibility to look after one another, don't we? I dare say we "
"do, no matter what the costs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06Trespassing_0000bf89_Oblivion_RESP1"
msgid ""
"We have a... situation. The Count has sent most of the servants home. You "
"have to leave. Sorry, but you ain't working here anymore either."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15SavageGarden_00047364_Oblivion_RESP4"
msgid ""
"We have all died in the Master's service. Here in Gaiar Alata we are "
"immortal, and wait to return to Tamriel after Lord Dagon's final victory."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Accuse_00035659_Oblivion_RESP1"
msgid "We have already been through this, and I admitted my guilt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001c4d9_Oblivion_RESP1"
msgid "We have awaited your arrival, messenger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007be56_Oblivion_RESP3"
msgid ""
"We have awaited your arrival. Tell us, what news do you bring from Akavir?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_mission_000356f1_Oblivion_RESP1"
msgid ""
"We have been contracted by the town of Water's Edge to rid their town of "
"goblins. They've been raiding for days, and appear to be in large numbers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MehrunesDagonTopic_00097cc3_Oblivion_RESP1"
msgid ""
"We have been preparing for the coming of Lord Dagon for many years. You come "
"to us at a fateful time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThreeSigns_0006bf17_Oblivion_RESP4"
msgid ""
"We have but the six sheep in our pasture, and we make sure they are well-"
"tended."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036646_Oblivion_RESP1"
msgid ""
"We have fulfilled our last duty. We go now to Aetherius without shame. "
"Farewell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThreeSigns_00026af5_Oblivion_RESP4"
msgid ""
"We have had some livestock die recently, but not all of them, which is a "
"relief."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RaynilDralasTopic_00038438_Oblivion_RESP3"
msgid ""
"We have it on good authority from officials in a neighboring city that Raynil "
"is what he says he is. So I'm not sure what you're trying to prove."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e7a_Oblivion_RESP2"
msgid ""
"We have much to discuss, but if you have time, I'd beg you stay a moment "
"longer and hear about our home, Weatherleah."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackSoulGemMG17_00015459_Oblivion_RESP2"
msgid ""
"We have much to speak of, and very little time. A new task awaits you, and it "
"is by far the most important you have been entrusted with."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000908e9_Oblivion_RESP1"
msgid "We have nothing to discuss."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000685a3_Oblivion_RESP1"
msgid ""
"We have only once chance at this! Use the portal to Camoran's Paradise before "
"it closes again!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000291e_Knights_RESP2"
msgid ""
"We have orders to leave everything just the way it was until the "
"investigation into the Chapel attack is finished."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG11ChoiceExplain_00033540_Oblivion_RESP4"
msgid ""
"We have overlooked these questions because we are so focused on rooting out "
"the Necromancers as quickly as possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HorseInquiry_0004d82e_Oblivion_RESP1"
msgid ""
"We have some of the best Bay horses in Cyrodiil. They are hardier than the "
"Chestnut and faster than the Paint horses."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HorseInquiry_0004ce57_Oblivion_RESP1"
msgid ""
"We have the finest white horses in Cyrodiil. None are hardier, and only the "
"black horses of Cheydinhal are faster."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004bf9b_Oblivion_RESP1"
msgid ""
"We have to get Martin to the Temple of the One or Mehrunes Dagon has won "
"after all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StolenGold_0005371e_Oblivion_RESP1"
msgid "We have to get him to tell us about the gold. Use any trick you can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0009837e_Oblivion_RESP1"
msgid "We have to stay in our homes while the Watch searches for the Gray Fox."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032ea0_Oblivion_RESP1"
msgid ""
"We have trainers for block and marksman in Skingrad. And there's a shepherd "
"who teaches athletics, too, I think."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AncotarTopic_000301e5_Oblivion_RESP1"
msgid ""
"We haven't seen him since that whole invisibility mess. I hope it stays that "
"way!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeersStone_00033793_Oblivion_RESP3"
msgid ""
"We haven't yet spoken to the others, for fear they would be less than "
"accepting of her situation. Perhaps it is time, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG13EridorWhy_0003446e_Oblivion_RESP2"
msgid ""
"We heard tell that vampires have infiltrated the town. Came here to root them "
"out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04Who_0001330b_Oblivion_RESP1"
msgid ""
"We hold on to fleeting things even as we slip. I knew, and yet I indulged "
"myself anyway. I indulged her a fair bit, too. Hee hee!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEAltarofDespairTopic_0007ff5e_Oblivion_RESP3"
msgid ""
"We hold the Altar of Despair, here within the Shrine of the Flame of Agnon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005c0c2_Oblivion_RESP1"
msgid "We honor the Rose and its bearer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005c0be_Oblivion_RESP1"
msgid "We honor you, Mace-Bearer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033b26_Oblivion_RESP1"
msgid "We is most pleased... eth... ified."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00031036_Oblivion_RESP3"
msgid ""
"We just get tired of Jeanne lording her position over us, when she barely "
"knows anything about magic. Every now and then, we like to trick her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004d0b7_Oblivion_RESP1"
msgid ""
"We just made it through to the Palace. The Market District was swarming with "
"daedra."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e65_Oblivion_RESP1"
msgid ""
"We just need to keep our heads down and try to do our jobs. Oreyn's doing "
"what he can from the outside."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BGreenmote_000167e3_Oblivion_RESP2"
msgid ""
"We keep the Greenmote safely tucked inside the Greenmote Silo. You can "
"imagine the ruckus if its location was known."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00090cb9_Oblivion_RESP1"
msgid "We kill and kill and kill! All we know is death! It ends here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkBrotherhoodTopic_000bba98_Oblivion_RESP3"
msgid ""
"We kill for profit, for enjoyment, and for the glory of the Dread Father, "
"Sithis. We are family, with bonds forged in blood and death."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13Gate_000c4531_Oblivion_RESP3"
msgid ""
"We killed scores... nay, hundreds of evil daedra! The ground ran thick with "
"their dark blood."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005c0bf_Oblivion_RESP1"
msgid "We kiss the Ring."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ND10FinThedretGreeting01_00002c9d_Knights_RESP2"
msgid ""
"We knew you had succeeded in destroying Umaril's physical form, but it seemed "
"that you had met the same fate as Pelinal Whitestrake.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000473c4_Oblivion_RESP2"
msgid ""
"We knew you would find your way here eventually. But it is of no consequence."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ecdd_Oblivion_RESP1"
msgid "We know how to deal with criminals in Bleaker's Way!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000290d_Knights_RESP4"
msgid ""
"We laid you to rest in the undercroft... we kept your death a secret. We "
"feared what would happen if our enemies thought you were dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD05Choice5_0002c5c0_Oblivion_RESP1"
msgid ""
"We leave as soon as you're ready. I want to investigate Blackheart's "
"stronghold at Arpenia. Meet me at the Leyawiin guild hall. We'll go from "
"there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007a022_Oblivion_RESP1"
msgid "We live at your whim, Lord Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeatherleahTopic_00028abf_Oblivion_RESP1"
msgid ""
"We look forward to returning to our family's ancestral home at Weatherleah, "
"once the ogres are dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e6b_Oblivion_RESP1"
msgid ""
"We lost Vitellus and a lot of good men against Blackheart. Somebody must be "
"pretty good to take him and all his people."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00062be9_Oblivion_RESP3"
msgid ""
"We lost a lot of good men that day. But Bruma is still standing. That's what "
"counts."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_MS48SalvianWhatHappened_00098142_Oblivion_RESP1"
msgid "We lost the damned city, that's what happened!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13Gate_000329e9_Oblivion_RESP4"
msgid ""
"We lost two more in that skirmish, as well as Farwil and I being wounded "
"badly. It was at this point we considered retreat."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39RanarrJo_00072c95_Oblivion_RESP2"
msgid ""
"We made Sheogorath by planting little seeds in the ground and watering them "
"with our tears and blood."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002e71e_Oblivion_RESP1"
msgid "We made it!... errr, I mean... victory is ours once again! Huzzah!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00031eba_Oblivion_RESP1"
msgid ""
"We made it!... errr, I mean... victory is ours once again! Huzzah! It's a "
"shame that Bremman didn't make it though. He was a good knight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetB1_00002b80_Knights_RESP2"
msgid ""
"We made our way to Lord Vlindrel's crypt. Sir Roderic spoke the words that "
"unsealed the tomb..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_00062157_Oblivion_RESP1"
msgid "We may be in the Choosy Beggar, but here you can eat like a king."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE05HerdirInvestigateCurrentTask_00083f4f_Oblivion_RES"
"P2"
msgid ""
"We may have to torture dozens of people before we find one who knows "
"something. How exciting!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAVaerminaSpeech_0008ade3_Oblivion_RESP1"
msgid ""
"We meet again, mortal, for we have met before, whether you know it or not. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0000bf97_Oblivion_RESP1"
msgid "We meet again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000292f_Knights_RESP1"
msgid ""
"We meet again. I am here to join your Order, having received a divine vision "
"from Kynareth herself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000982ca_Oblivion_RESP1"
msgid "We might be able to grow turnips next spring."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_jointheFightersGuild_00027f8b_Oblivion_RESP1"
msgid ""
"We might be able to use someone of your talents... if you've got a clean "
"record, and a good reputation. Are you interested?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalSpeech_00084a50_Oblivion_RESP1"
msgid ""
"We mock the thieves, for bitter is their loss. You, mortal, may take this. It "
"shall open the secrets of dark places for you."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061431_Oblivion_RESP1"
msgid "We must all be on watch."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13BattlePlans_000276a9_Oblivion_RESP1"
msgid ""
"We must allow the Mythic Dawn to proceed with their plan to open three lesser "
"Gates outside Bruma."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkUmaril2_00002c55_Knights_RESP1"
msgid ""
"We must bide our time until our Commander has finished his quest for the "
"Relics. It is hard, but the work of the gods cannot be rushed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_000806ea_Oblivion_RESP2"
msgid ""
"We must carry out her wishes, however. And I, for one, am looking forward to, "
"ahh... interacting with the citizens of Crucible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalk2_00002bad_Knights_RESP1"
msgid ""
"We must deal with that situation in Daggerfall. You know... the ghost. Dead "
"king or some such?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017972_Oblivion_RESP2"
msgid ""
"We must discuss our next move. The spire is obviously their source of power. "
"This battle will not end until we find a way to shut it down."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017d54_Oblivion_RESP2"
msgid ""
"We must discuss our next move. The spire is obviously their source of power. "
"This battle will not end until we find a way to shut it down."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002822e_Oblivion_RESP1"
msgid ""
"We must escape! Do you understand? We're the only two left! We're next! If we "
"don't find a way out of here, we're going to die!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00016ecb_Oblivion_RESP1"
msgid "We must find Dylora and free her!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002e57f_Oblivion_RESP1"
msgid "We must find Galtus Previa. He must be here somewhere."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark16Choice2A_000262d8_Oblivion_RESP1"
msgid ""
"We must find out who is behind this betrayal! We haven't much time... I am "
"hunted day and night by the Black Hand! They want me dead!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark16Choice2B_000262d9_Oblivion_RESP1"
msgid ""
"We must find out who is behind this betrayal! We haven't much time... I am "
"hunted day and night by the Black Hand! They want me dead!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark16Choice2C_000262da_Oblivion_RESP1"
msgid ""
"We must find out who is behind this betrayal! We haven't much time... I am "
"hunted day and night by the Black Hand! They want me dead!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10Opposition_00017d11_Oblivion_RESP2"
msgid "We must free Dylora as soon as possible. She will know what to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10Opposition_00016b38_Oblivion_RESP2"
msgid "We must free Staada as soon as possible. She will know what to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003640b_Oblivion_RESP2"
msgid "We must get out of here! Come on!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003ca8f_Oblivion_RESP1"
msgid "We must get out of this place!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000093bb_Oblivion_RESP1"
msgid "We must get out of this place."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0006b827_Oblivion_RESP1"
msgid "We must get to the Temple! Drive them back!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDKnightsStartCombat_00002b4c_Knights_RESP1"
msgid "We must give the Crusader time to destroy the Orb!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000c42c9_Oblivion_RESP1"
msgid "We must go."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MartinBattleSpeech_0003d062_Oblivion_RESP1"
msgid ""
"We must hold fast until the Hero of Kvatch can destroy their Great Gate. We "
"must kill whatever comes out of that gate!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d7f4_Oblivion_RESP1"
msgid "We must hold the line until the Great Gate opens!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Lost_00081a3b_Oblivion_RESP1"
msgid "We must not let down our guard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk5_0018d7fd_Oblivion_RESP1"
msgid ""
"We must not relax our guard, not even for a second. We'll talk more about "
"this later.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice5A_00022ba9_Oblivion_RESP5"
msgid ""
"We must now take our leave of each other, you and I, for there is much work "
"to be done. I'll be following... your progress. Welcome to the family. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice5B_00022baa_Oblivion_RESP5"
msgid ""
"We must now take our leave of each other, you and I, for there is much work "
"to be done. I'll be following... your progress. Welcome to the family. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice5C_00022bab_Oblivion_RESP5"
msgid ""
"We must now take our leave of each other, you and I, for there is much work "
"to be done. I'll be following... your progress. Welcome to the family. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalk4_00002bbb_Knights_RESP1"
msgid ""
"We must prepare ourselves, spiritually and physically. An increased training "
"regimen, for at least a week. Then, we'll be ready."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029c4_Knights_RESP1"
msgid "We must press on!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008f047_Oblivion_RESP1"
msgid "We must prevail."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008f04a_Oblivion_RESP1"
msgid "We must prevail."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d7ee_Oblivion_RESP1"
msgid "We must protect Martin during the battle. He is the Empire's last hope."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008f041_Oblivion_RESP1"
msgid "We must purge Order from our home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008f042_Oblivion_RESP1"
msgid "We must purge Order from our home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c2a9_Oblivion_RESP1"
msgid "We must put an end to this travesty of justice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateTopic_0008571a_Oblivion_RESP9"
msgid ""
"We must recover the Amulet of Kings and relight the Dragonfires, before it is "
"too late to stem Dagon's invasion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0004db71_Oblivion_RESP1"
msgid "We must shut down the Obelisks!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000982cc_Oblivion_RESP1"
msgid "We need more pressure on Lex. He's a stubborn fetcher."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001e7a8_Oblivion_RESP1"
msgid "We need one more piece of evidence to make Agarmir's guilt complete."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479ec_Oblivion_RESP3"
msgid ""
"We need some law-and-order... bring in the Legions. 'Leyawiin for the "
"Imperials,' I say. No sense coddling those Renrijra Krin bandits."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001bb22_Oblivion_RESP1"
msgid ""
"We need the Brush to get out of here. Bring it to me so we can get out of "
"this painting. Hurry, I'm starving."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e4c3_Oblivion_RESP1"
msgid "We need those Gatekeeper bones. You ready to go to the Gardens with me? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002c595_Oblivion_RESP1"
msgid "We need to check out Arpenia. Come on. I'll follow you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00054678_Oblivion_RESP1"
msgid "We need to fall back!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AzaniBlackheartTOPIC_0002c597_Oblivion_RESP1"
msgid "We need to find out what happened with him. It's all suspicious to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026ea8_Oblivion_RESP3"
msgid ""
"We need to gather what allies we can before Bruma is hopelessly besieged."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05MethredhelJob_0000c05b_Oblivion_RESP2"
msgid ""
"We need to get Hieronymus Lex to lift his siege. I have put together a plan."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05FoundMythicDawn_00022cf0_Oblivion_RESP2"
msgid ""
"We need to get that fourth book, then. If Tar-Meena is right, we can use "
"these books to locate the Mythic Dawn's hidden shrine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002920_Knights_RESP1"
msgid "We need to get these gates open!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029c0_Knights_RESP1"
msgid "We need to get those gates open."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00012066_Oblivion_RESP1"
msgid ""
"We need to get through the Gates of Madness. Let's go kill the Gatekeeper!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000bfa2_Oblivion_RESP1"
msgid "We need to get to safety."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ad7a_Oblivion_RESP2"
msgid ""
"We need to get to the castle. That's where Count Goldwine and his men should "
"be. Last I saw, they were trying to fortify the castle from an attack."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ee25_Oblivion_RESP4"
msgid "We need to go see if it is safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033751_Oblivion_RESP1"
msgid "We need to talk."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_00023e47_Oblivion_RESP1"
msgid ""
"We need you to stage an... accident. Kill the target in the manner specified, "
"and you'll receive a considerable bonus. Do you accept this contract?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008320e_Oblivion_RESP1"
msgid "We need your help desperately!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033d10_Oblivion_RESP1"
msgid "We need your help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateConv_00097fa9_Oblivion_RESP1"
msgid ""
"We never even knew what hit us. They were inside the city before we knew what "
"was happening."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WatersEdgeTOPIC_000356fe_Oblivion_RESP3"
msgid ""
"We now know the threat this group poses. Perhaps better than they themselves "
"know it. We must take decisive action now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_duties_00074a93_Oblivion_RESP1"
msgid ""
"We obviously didn't get enough information from the Argonian. I want you to "
"infiltrate them. See how they work from the inside."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CovenantTopic_000272af_Oblivion_RESP2"
msgid ""
"We of the Dark Brotherhood serve the Night Mother, who is the bride of "
"Sithis. The Night Mother rules her children with a terrible Black Hand."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JauffreTopic_0001e910_Oblivion_RESP3"
msgid ""
"We of the Imperial Bodyguard are the public face of the Blades, but most of "
"my brothers serve the Emperor quietly, behind the scenes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_0004767f_Oblivion_RESP1"
msgid ""
"We operate throughout the Imperial City and Cyrodiil. Very fast, very "
"accurate. News happens? The Black Horse Courier is there!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND10SirAmielSpeech04_00002cc2_Knights_RESP1"
msgid ""
"We owe you a debt of thanks. You have succeeded where we could not. You and "
"your knights have held true to your purpose."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46NewSettlement_000319d6_Oblivion_RESP1"
msgid ""
"We plan to call it Cropsford. My daugher Callia, her husband Aloys, and I, "
"came all the way from High Rock to start a new life here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NightMother_0006633c_Oblivion_RESP1"
msgid ""
"We praise our Unholy Matron. From her shadowed womb we were born, from her "
"breast we suckle malice and pain. She loves her children, you see."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalk4_00002bbc_Knights_RESP1"
msgid ""
"We pray, fellow knight! First and foremost, we pray. The Nine must bless us, "
"and strengthen us. Only then will we be ready."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_000476f7_Oblivion_RESP1"
msgid ""
"We rarely get real trouble here. The Watch puts a stop to rough stuff damn "
"quick. I'm mostly ornamental at the Bloated Float. Makes folks happy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39Cindanwe_000781f4_Oblivion_RESP1"
msgid "We really shouldn't be talking about this. Someone might be listening!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a849_Oblivion_RESP1"
msgid "We really taught those bastards a lesson, didn't we ma'am?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a84a_Oblivion_RESP1"
msgid "We really taught those bastards a lesson, didn't we sir?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11HowlingHalls_00016b7e_Oblivion_RESP2"
msgid ""
"We rebuilt it here, as it was when it hosted its most famous guest. Sometimes "
"at night, I can still hear Emperor Pelagius screaming."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ16OcatoA_000add1a_Oblivion_RESP2"
msgid ""
"We saw the Temple dome explode, the avatar of Akatosh appear... that was "
"Martin?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007babf_Oblivion_RESP1"
msgid ""
"We saw the smoke from the Gold Road while out on patrol. How can we help?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HackdirtTopic_0002869f_Oblivion_RESP1"
msgid ""
"We scrape by, not that we've ever had nought but trouble from outsiders like "
"you.  You'd best be moving on, if you know what's good for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11TheLightTopic_00082650_Oblivion_RESP1"
msgid ""
"We seek the light with an open eye and an open heart. We carve the flesh "
"away, seeking the light within."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008511d_Oblivion_RESP1"
msgid "We seek what the darkness hides, and the Night Mistress is our guide."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005d507_Oblivion_RESP1"
msgid "We serve Her will."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08BlindMonks_000983ac_Oblivion_RESP1"
msgid ""
"We serve the retired Moth priests from the Imperial City. The work they do "
"leads to progressive blindess."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06FollowMe_0000c012_Oblivion_RESP1"
msgid "We shall be stealthy."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEZoeMalenePykeResponses_00091b1c_Oblivion_RESP1"
msgid "We shall celebrate our love tonight, my darling."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00016b79_Oblivion_RESP1"
msgid "We shall find a way to the light."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004f220_Oblivion_RESP7"
msgid ""
"We shall look forward instead of back, however. You still have work to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RolandJensericTopic_0001da71_Oblivion_RESP1"
msgid "We shall never speak of him again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008f043_Oblivion_RESP1"
msgid "We shall not fail you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008f045_Oblivion_RESP1"
msgid "We shall not fail you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEDerveninSpeech05_00089915_Oblivion_RESP1"
msgid ""
"We shall raise our goblets to the Demented. Though misguided they are, we are "
"all children of Arden-Sul's teachings and therefore equal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEDerveninSpeech04_000898f4_Oblivion_RESP1"
msgid ""
"We shall raise our goblets to the great Sheogorath, may he rule the Isles for "
"another thousand years."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081730_Oblivion_RESP1"
msgid "We shall speak when we've reached the chamber."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00026daa_Oblivion_RESP1"
msgid "We should be on our way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ04PinerA1_00090994_Oblivion_RESP1"
msgid "We should check the Chapel. Come on!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033585_Oblivion_RESP1"
msgid "We should continue for Farwil's sake."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_000164b5_Oblivion_RESP1"
msgid ""
"We should find a defensible spot and protect the Emperor until help arrives."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE05HerdirInvestigateCurrentTask_0008567d_Oblivion_RES"
"P2"
msgid ""
"We should find him soon. If he knows something, it might be a key to what's "
"going on in Crucible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000343ef_Oblivion_RESP1"
msgid "We should get Martin to Cloud Ruler Temple immediately."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002e57e_Oblivion_RESP1"
msgid "We should get back to Oreyn and report what we have found."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000343e9_Oblivion_RESP1"
msgid ""
"We should get moving. I won't rest easy until Martin is safe at Cloud Ruler "
"Temple."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003e1e5_Oblivion_RESP1"
msgid "We should get out of here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03LewinC1Idle01_0008ea8a_Oblivion_RESP1"
msgid "We should go back, I'm not sure we should be here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalConvo1_00026ab8_Oblivion_RESP1"
msgid "We should go get it right now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANocturnalConvo1_000878d7_Oblivion_RESP1"
msgid "We should go get it right now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e4c1_Oblivion_RESP1"
msgid "We should go hunting. Soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00037828_Oblivion_RESP1"
msgid "We should go to the Imperial City at once. Lead on."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE05HerdirInvestigateCurrentTask_00083f4d_Oblivion_RES"
"P2"
msgid ""
"We should have a little chat with her as soon as possible. I look forward to "
"it; I get the feeling she avoids me at times."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03GrommokC1Idle01_0008ea70_Oblivion_RESP1"
msgid "We should just kill this stupid tree and move on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ04KeepMartinSafe_0001ee2e_Oblivion_RESP4"
msgid "We should leave at once."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGNoBloodPrice_000153af_Oblivion_RESP1"
msgid "We should not speak of this again until you can pay the blood price."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006d811_Oblivion_RESP1"
msgid "We should speak in your room, where it is private. Not here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalk2_00002bac_Knights_RESP1"
msgid ""
"We should travel, you and I. Quell evil throughout Tamriel! To be knights, "
"aye... But to be knights errant! The adventures we will have!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000781e8_Oblivion_RESP2"
msgid "We shouldn't be seen talking until the mission is accomplished!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MageTalk5_0006a874_Oblivion_RESP1"
msgid ""
"We shouldn't keep this news a secret. Feel free to tell the others, but let "
"them know the complications we face. We'll continue our talk later."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG09Choice4C_00022bd9_Oblivion_RESP1"
msgid ""
"We simply wanted to survey the situation in Skingrad. Our relationship with "
"Hassildor is tenuous at best."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479cd_Oblivion_RESP2"
msgid ""
"We speak West-fashion for the comfort of our Western clients, but we invest "
"the fierce pride of our ancient races in each of our mercenary contracts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_0007be9d_Oblivion_RESP1"
msgid ""
"We stable horses for folks in the Imperial City. We'd sell horses, too. "
"Except... we can't seem to keep track of them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StoneofStAlessiaTOPIC_00003927_Oblivion_RESP1"
msgid ""
"We stole it. I won't try to hide that now. I'm all that's left now, though. "
"We may have stolen the stone, but we weren't the last ones to do it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11HowlingHalls_00016b7f_Oblivion_RESP3"
msgid ""
"We stole the stones from Cyrodiil and reassembled the temple here in the "
"Shivering Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_00047746_Oblivion_RESP1"
msgid ""
"We store goods here until the buyer can collect them, or until the ships come "
"in."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002927_Knights_RESP1"
msgid ""
"We strike them down, but the orb keeps bringing them back to life! You must "
"destroy the orb, Commander!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Brothers_00084a9c_Oblivion_RESP1"
msgid "We thought you and Mother had both been killed. If we had only known!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000ace4a_Oblivion_RESP1"
msgid "We threaten no one. Why can't they just leave us alone?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQDaedricMagic_0008b603_Oblivion_RESP3"
msgid ""
"We threw ourselves into the riddles of daedric magic. We hungered for "
"forbidden secrets. Knowledge and power were our gods."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000298d_Knights_RESP1"
msgid ""
"We took an oath to protect the Cuirass in death. The one who could defeat us "
"is the one who is meant to have it. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetA2_00002b86_Knights_RESP3"
msgid ""
"We travelled back and forth across Colovia. He was always asking about an old "
"noble family, the Vlindrels."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005d506_Oblivion_RESP1"
msgid "We tremble beneath His eye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08FinChoice1A_00035df3_Oblivion_RESP3"
msgid ""
"We tried to eliminate Phillida, of course, but failed on three separate "
"occassions. He's a powerful man, and was surrounded by powerful associates."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32SiegeVitharn_0001b68e_Oblivion_RESP1"
msgid ""
"We tried to gather the townsfolk into the keep, but it was too late. I barely "
"had time to find my betrothed and get us inside."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003013d_Oblivion_RESP2"
msgid ""
"We trusted you to help, and you betrayed us! It would be best if you left "
"this town and never came back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BonusTopic_0002ff51_Oblivion_RESP3"
msgid ""
"We try to honor these requests whenever possible. After all, the Dark "
"Brotherhood's reputation has been built on providing... good service."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BRIBE_0018b2c3_Oblivion_RESP1"
msgid "We understand each other perfectly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22SrazirrGoAhead_0002c526_Oblivion_RESP1"
msgid ""
"We wait and see how this plays out. If and when there's an opportunity, "
"S'razirr will help you against Maric."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005c0f9_Oblivion_RESP1"
msgid "We watch and wait."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00058e02_Oblivion_RESP2"
msgid "We were all expecting to become the next Kvatch, you know?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00062be9_Oblivion_RESP2"
msgid ""
"We were all watching from the walls, and to be honest it was looking bad. I "
"thought we were going to have to fight 'em street by street."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG09Choice4B_00022bd6_Oblivion_RESP2"
msgid ""
"We were also concerned that it might drive any Necromancers in the area "
"underground, making them more difficult to root out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS09SoIHear_00053778_Oblivion_RESP4"
msgid ""
"We were doing petty crimes all over Cyrodiil. Small scores; 10 gold here, 25 "
"there. Nothing big enough to have them investigate you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDSirBerichTopic_00002c7e_Knights_RESP2"
msgid ""
"We were estranged in life, but I had hoped that in death we could be "
"reconciled."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0005a029_Oblivion_RESP1"
msgid ""
"We were ordered out to attack the daedra coming out of that Oblivion Gate. "
"Captain's the only one who ever knows what's going on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10WhatHappened_00017d16_Oblivion_RESP2"
msgid ""
"We were so focused on organizing quickly that by the time we realized he'd "
"let Order in himself, it was too late. We were split up and picked off."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10WhatHappened_0001746f_Oblivion_RESP2"
msgid ""
"We were so focused on organizing quickly that by the time we realized she'd "
"let Order in herself, it was too late. We were split up and picked off."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000151f4_Oblivion_RESP5"
msgid ""
"We were supposed to storm the place and take this gem they're holding. Only "
"we can't. There's some sort of enchantment on the door."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Shadowscale_000251fc_Oblivion_RESP3"
msgid ""
"We were taken at birth, and given to the Dark Brotherhood. We returned to "
"Black Marsh as Shadowscales, trained in the arts of stealth and murder. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15EldamilC1_0003fbde_Oblivion_RESP2"
msgid ""
"We were the Chosen. We saw more clearly than ordinary mortals. We would "
"destroy the world and remake it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SESylTopic_0008f176_Oblivion_RESP2"
msgid ""
"We will catch her, and will turn her over ourselves. Her treachery cannot be "
"allowed to stand."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008ef57_Oblivion_RESP1"
msgid "We will continue to hold the Fringe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13CaptainGreetA2_0001a79c_Oblivion_RESP3"
msgid ""
"We will defend the Palace to the end of our strength, and will cast ourselves "
"in the path of cursed Jyggalag himself should he come here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13CaptainGreetA2_0005e378_Oblivion_RESP3"
msgid ""
"We will defend the Palace to the end of our strength, and will cast ourselves "
"in the path of cursed Jyggalag himself should he come here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008247a_Oblivion_RESP1"
msgid "We will defend this land until we are dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000343f1_Oblivion_RESP1"
msgid ""
"We will exact our revenge on the Mythic Dawn for the Emperor's murder. By the "
"holy blood of Talos, Mankar Camoran will pay for his crimes!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00082475_Oblivion_RESP1"
msgid "We will hold the line."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00040b79_Oblivion_RESP1"
msgid "We will keep fighting until the last of us is dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGPayBloodPrice_0001c474_Oblivion_RESP2"
msgid "We will make sure each person on these tax rolls gets their money back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001796b_Oblivion_RESP1"
msgid "We will not be able to hold this position for long, Your Grace. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00082476_Oblivion_RESP1"
msgid "We will not fail you, Your Grace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008247e_Oblivion_RESP1"
msgid "We will not lose this land."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d14b_Oblivion_RESP1"
msgid ""
"We will not speak of training here. When I have settled myself in my favorite "
"spot in the bay, then we shall talk. Follow me there, if you wish."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13Gate_00031845_Oblivion_RESP1"
msgid ""
"We will remain out here until the gate is either closed, or something emerges "
"from inside. We need to warn Cheydinhal of impending attacks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00031615_Oblivion_RESP1"
msgid "We will speak when your task is complete."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003b838_Oblivion_RESP1"
msgid "We will speak when your task is complete."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000c42ce_Oblivion_RESP1"
msgid "We will spill their blood in the name of our father!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d7ed_Oblivion_RESP1"
msgid ""
"We won a great victory here today! We now have the means to recover the "
"Amulet of Kings from Mankar Camoran."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c141_Oblivion_RESP1"
msgid "We won't let those daedra take Bruma."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c146_Oblivion_RESP1"
msgid ""
"We won't let you down, ma'am. The daedra will be sorry they messed with Bruma."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c145_Oblivion_RESP1"
msgid ""
"We won't let you down, sir. The daedra will be sorry they messed with Bruma."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfb3_Oblivion_RESP1"
msgid "We wouldn't be here if you'd done your job!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ04Conv_0008b601_Oblivion_RESP1"
msgid "We'd all best get back to our duties, eh, Captain?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ForsakenMineTOPIC_0002f9e8_Oblivion_RESP1"
msgid ""
"We'd been contracted to clear the place of trolls. It was a tough job, but I "
"felt the men I sent were up to it. I want to know what happened."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0006fdb2_Oblivion_RESP1"
msgid ""
"We'd best get back to work now, hmm? Captain catches us gabbin', it'll be our "
"heads. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00090992_Oblivion_RESP1"
msgid "We'd better find Jauffre."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_00061417_Oblivion_RESP1"
msgid "We'll be ready if the daedra decide to attack, don't worry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS49FollowMe_0007944d_Oblivion_RESP1"
msgid "We'll be right behind you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02OrcConversation_0007eace_Oblivion_RESP1"
msgid "We'll be swimming in blood soon. Yuck."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003375c_Oblivion_RESP1"
msgid "We'll be talking."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS04Faustina_0003d4a3_Oblivion_RESP1"
msgid ""
"We'll clean up the mess. Don't concern yourself about it. I'm sure you had no "
"choice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RulesOfCompetition_0003d7b4_Oblivion_RESP6"
msgid ""
"We'll do it like this. You can fight one, two, or three creatures. The more "
"creatures you fight, the more you win. If you survive, that is! Ha ha ha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQFollow_00026ef0_Oblivion_RESP1"
msgid "We'll follow your lead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033755_Oblivion_RESP1"
msgid "We'll get through this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00058e0c_Oblivion_RESP1"
msgid ""
"We'll give them a good fight. They'll know they tangled with the best "
"Cyrodiil has to offer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ04CheckOnAmulet_0001ee2b_Oblivion_RESP1"
msgid "We'll go together. But I fear the worst."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ValusOdiilTopic_000224aa_Oblivion_RESP1"
msgid ""
"We'll have to break the news to him that Antus didn't make it. He fought "
"bravely, and father will respect that."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03SyndelChamberTwoMani01_00073269_Oblivion_RESP1"
msgid ""
"We'll have to fend for ourselves. Do you think you can pry the door open?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ10BurdB_0003a854_Oblivion_RESP1"
msgid ""
"We'll hold here until you're ready. Although I'd rather not sit around "
"waiting to see what else comes out of that gate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00043cd1_Oblivion_RESP2"
msgid ""
"We'll hold our position here until you get that gate open. May Sheogorath's "
"madness guard and guide you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQWait_000152ef_Oblivion_RESP1"
msgid "We'll hold them off as long as we can. Return quickly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00091c4f_Oblivion_RESP2"
msgid ""
"We'll hold this area. You head to the back of the castle, and find the Count."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQWait_00026ef2_Oblivion_RESP1"
msgid "We'll hold this position as long as we can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e62_Oblivion_RESP1"
msgid "We'll just have to trust Oreyn, and keep our mouths shut."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000297a_Knights_RESP2"
msgid "We'll meet again, don't worry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Agree_0001dc2d_Oblivion_RESP3"
msgid ""
"We'll meet here again tomorrow night.  Oh, and NEVER contact me in public.  "
"They're watching.  They can't know you're helping me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JskarTopic_0000a100_Oblivion_RESP4"
msgid ""
"We'll need a few days to digest this new information. Should J'skar arrive "
"here, we'll see to it that he's well taken care of. Thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000301d7_Oblivion_RESP1"
msgid ""
"We'll never forget how you saved us from Ancotar's crazy magic. What can I do "
"for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Flee_0005c012_Oblivion_RESP1"
msgid "We'll never hold them!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark05Convo_000282fd_Oblivion_RESP1"
msgid ""
"We'll see who gets to cut you, Motierre! Let me show you how a real killer "
"operates, you Dark Brotherhood mongrel! Defend yourself!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONENTER_00062301_Oblivion_RESP1"
msgid "We'll see."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033768_Oblivion_RESP1"
msgid "We'll show them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0006a84f_Oblivion_RESP1"
msgid "We'll speak again later, Apprentice. Now go! Your studies await!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00088b68_Oblivion_RESP1"
msgid "We'll speak again soon, no doubt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d7fa_Oblivion_RESP1"
msgid "We'll stand our ground as long as we can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00028754_Oblivion_RESP1"
msgid "We'll talk later tonight at the gathering."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_duties_0002c5b7_Oblivion_RESP1"
msgid "We'll talk later. Meet me at my house after dark."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000bf37_Oblivion_RESP1"
msgid ""
"We'll talk more once I've finished getting Erthor back. For now, I have work "
"to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001551c_Oblivion_RESP1"
msgid ""
"We'll talk when we're closer, so I can show you what we're facing. Not now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d146_Oblivion_RESP1"
msgid "We'll try again, I suppose. What does the name Hazadir mean to you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48SavlianWhatDoing_00098143_Oblivion_RESP2"
msgid ""
"We'll try to hold our ground, that's what. If we can't hold this barricade, "
"those beasts could march right down and overrun the encampment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeynonPrioryTopic_000aa08b_Oblivion_RESP1"
msgid ""
"We're a Nine Divines priory dedicated to the Order of Talos. Lord Talos "
"teaches us to be prepared to protect his people in peace and war."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038a80_Oblivion_RESP3"
msgid ""
"We're a bit suspicious of strangers here. Don't give us anything to be "
"suspicious about, will you, please?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_00023995_Oblivion_RESP1"
msgid ""
"We're a mountain people, tough, independent. County Chorrol is rich in mines "
"and timber, wool and mutton, and hard-working people."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479e4_Oblivion_RESP3"
msgid ""
"We're a small, select organization of crime fighters. We're going after the "
"crimes and criminals the Guard overlooks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003842c_Oblivion_RESP2"
msgid ""
"We're afraid there may be retribution on Bradon's wife even though she had "
"nothing to do with it. Vampires are a hated lot."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000af065_Oblivion_RESP1"
msgid "We're alive! You did it! You beat that monster! We won!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesGuildTopic_00062bc2_Oblivion_RESP1"
msgid ""
"We're all better off now that Necromancy has been banned from the guild. It's "
"just safer that way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607e5_Oblivion_RESP1"
msgid ""
"We're all doomed. Jyggalag has won. Sheogorath is dead. The forces of Order "
"are victorious."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Flee_0005c016_Oblivion_RESP1"
msgid "We're all going to die!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d286_Oblivion_RESP1"
msgid ""
"We're all in your debt for closing that Oblivion Gate outside the city. Well "
"done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk3_0018d7f4_Oblivion_RESP1"
msgid ""
"We're all on edge, and for good reason. But we can't give in to panic. Let's "
"deal with this together, as the Blades always have."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607e6_Oblivion_RESP1"
msgid ""
"We're all still here. It's a miracle! Someone really needs to write a book "
"about this. Perhaps I should...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018b1f7_Oblivion_RESP1"
msgid ""
"We're all talking about the emperor's murder. We have no emperor. And no "
"heir. That's never happened before. I suppose we should all be worried."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_00061418_Oblivion_RESP1"
msgid ""
"We're all wondering when more of those evil Gates are going to open. I'd "
"leave town if I dared."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_0018d2a8_Oblivion_RESP1"
msgid ""
"We're all wondering when more of those evil Gates are going to open. I'd "
"leave town if I dared."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CropsfordTopic_00023f50_Oblivion_RESP1"
msgid ""
"We're almost ready to start planting crops. Cropsford is really starting to "
"feel like home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bc8d_Oblivion_RESP1"
msgid "We're always on duty."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebc7_Oblivion_RESP1"
msgid "We're back. Thank Peryite!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Trespass_0009fd6c_Oblivion_RESP1"
msgid "We're being robbed!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028beb_Oblivion_RESP1"
msgid ""
"We're being stalked, like animals in the forest. I'm still not sure if the "
"killer is one of the other guests, or is hiding somewhere in the house."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06HelpAttackA1_00012cca_Oblivion_RESP3"
msgid ""
"We're better off storming the main passage, where our superior strength and "
"bladework can come into play."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0004ed9d_Oblivion_RESP1"
msgid "We're busted. Get her!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0004ed8f_Oblivion_RESP1"
msgid "We're busted. Get him!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033609_Oblivion_RESP1"
msgid "We're done here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002e4d_Oblivion_RESP1"
msgid "We're done here. Let's go get paid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00033566_Oblivion_RESP1"
msgid "We're done here. Let's go get paid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001b687_Oblivion_RESP1"
msgid "We're doomed, doomed I tell you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006052b_Oblivion_RESP1"
msgid ""
"We're doomed. The Greymarch can't be stopped. We'll all be Ordered like the "
"old tales tell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008ef72_Oblivion_RESP1"
msgid "We're going to die!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d7f6_Oblivion_RESP1"
msgid "We're going to show them daedra a thing or two, aren't we ma'am?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c14a_Oblivion_RESP1"
msgid "We're going to show them daedra a thing or two, aren't we sir?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bc92_Oblivion_RESP1"
msgid "We're here to help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bc8c_Oblivion_RESP1"
msgid "We're here to serve."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000335ff_Oblivion_RESP1"
msgid "We're in your debt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_0003d7b6_Oblivion_RESP1"
msgid ""
"We're just not ready! It takes time to find those beasties and get them back "
"here alive. Remember, just one show a week. Come back some other day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00033dd3_Oblivion_RESP1"
msgid "We're looking for fighters and adventurers. You should join up."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00033dcf_Oblivion_RESP1"
msgid "We're looking for recruits. Interested?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00033dcb_Oblivion_RESP1"
msgid ""
"We're looking for recruits. Think you're tough enough to join the Fighters "
"Guild?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033750_Oblivion_RESP1"
msgid "We're making progress."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_0018d303_Oblivion_RESP1"
msgid ""
"We're next. I'm sure of it. First Kvatch, now Skingrad! The daedra won't stop "
"until we're all dead!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035a13_Oblivion_RESP3"
msgid ""
"We're not about to let the Guild interfere with our plans, for the Count or "
"otherwise. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035a14_Oblivion_RESP3"
msgid ""
"We're not about to let the Guild interfere with our plans, for the Count or "
"otherwise. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035a15_Oblivion_RESP3"
msgid ""
"We're not about to let the Guild interfere with our plans, for the Count or "
"otherwise. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46Choice1_0008fabc_Oblivion_RESP3"
msgid ""
"We're not allowed to take care of it either. There are rules. And I don't "
"want to end up on the Hill of Suicides. You, on the other hand...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeatherleahTopic_000242ae_Oblivion_RESP5"
msgid ""
"We're not fighters; you appear to have more skill than either of us. Would "
"you go to Weatherleah, and see if it's still inhabited by ogres?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugoTopic1Tell_00090b70_Oblivion_RESP2"
msgid ""
"We're pals, right? So we'll kill Black Brugo and be knights! I'll wait right "
"here until you ask me to follow you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_000677c8_Oblivion_RESP2"
msgid ""
"We're peas in a pod, you and I. I'd be happy to offer whatever help I can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AncotarTopic_0003003a_Oblivion_RESP1"
msgid ""
"We're pretty sure he's still hiding out in Fort Caractacus, although he never "
"answers when we've tried to find him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029bd_Knights_RESP1"
msgid "We're ready for anything, Commander."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a844_Oblivion_RESP1"
msgid "We're ready when you are."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026ee9_Oblivion_RESP2"
msgid ""
"We're ready when you are. Just say the word and we'll follow you into that "
"hell-spawned Gate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033b35_Oblivion_RESP1"
msgid "We're ready."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_00061c9d_Oblivion_RESP1"
msgid "We're saved! Sheogorath has protected us once again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_0002c4d3_Oblivion_RESP1"
msgid ""
"We're simple, Gods-fearing folk here in County Chorrol. Easterners worship "
"their wallets and their fat bellies."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElixirofExploration_0004e91a_Oblivion_RESP1"
msgid ""
"We're so close. Just bring 40 Nirnroot samples, and we can make the best "
"version of the Elixir yet!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c987_Oblivion_RESP1"
msgid ""
"We're still in Cyrodiil here in Bruma, but just barely. We build for the "
"cold, just like in Skyrim."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47WhatHappened_00030038_Oblivion_RESP6"
msgid ""
"We're sure it was Ancotar's doing, but we can't find him. If you can help us, "
"we will be extremely grateful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTopic_000178cc_Oblivion_RESP1"
msgid ""
"We're the Emperor's bodyguards. Our job is to get him out of situations like "
"this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000152ed_Oblivion_RESP1"
msgid "We're too late... Mehrunes Dagon is here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c991_Oblivion_RESP1"
msgid ""
"We're trying to bring the comfort of the Chapel to the Nords here, but "
"Bruma's Nords stick to their heathen gods and uncivilized practices."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_00023e73_Oblivion_RESP1"
msgid ""
"We're usually called upon to take a life, but not this time. This contract "
"requires us to stage the assassination of a marked man. Are you ready?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ10BurdSpeech_00046305_Oblivion_RESP1"
msgid "We're with you, Captain!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000301df_Oblivion_RESP1"
msgid ""
"We've all agreed to let Diram be our spokesman. You'll find him in the inn, "
"if you look very carefully."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003ccb1_Oblivion_RESP1"
msgid "We've arrived."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033788_Oblivion_RESP1"
msgid "We've been had."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000146d2_Oblivion_RESP1"
msgid ""
"We've been hard at work. Caranya is very determined. You should go talk to "
"her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002d76f_Oblivion_RESP1"
msgid "We've been hit hard. But we'll come back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00092266_Oblivion_RESP2"
msgid ""
"We've been through too much together already for me to just abandon them to "
"their fate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Gang_0003d4af_Oblivion_RESP2"
msgid ""
"We've been trying to foil Faustina's gang for months now. Every time we tried "
"to interview a man who was lured there, they refused to talk."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00086782_Oblivion_RESP1"
msgid "We've been waiting for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000151f4_Oblivion_RESP2"
msgid ""
"We've been watching the site for a while, and have tried to stay out of sight "
"ever since the original plan was blown."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000294c_Knights_RESP2"
msgid ""
"We've come all the way from Skyrim to join up. We can't claim any experience "
"as knights, but we learned soldiering from our years in the Legion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ad7a_Oblivion_RESP1"
msgid ""
"We've done good work, but this is no time to start patting each other on the "
"back. There's still much to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028865_Oblivion_RESP1"
msgid ""
"We've done it! I can't believe it -- I didn't really think this would work. "
"Maybe we do have a fighting chance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001e8dd_Oblivion_RESP1"
msgid ""
"We've failed. I've failed ... The Blades are sworn to protect the Emperor, "
"and now he and all his heirs are dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_00002e5d_Oblivion_RESP1"
msgid "We've got one. Let's hope this one will pay well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000356fb_Oblivion_RESP1"
msgid "We've got some work to do if we're going to stop the Blackwood Company."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028872_Oblivion_RESP1"
msgid ""
"We've got to clear out all these goblins. I'll let you know when we've gotten "
"the last of them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028003_Oblivion_RESP1"
msgid ""
"We've got to clear this area so we can pull those people out of the chapel! "
"Kill anything that moves!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003a84f_Oblivion_RESP1"
msgid "We've got to get out of here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028168_Oblivion_RESP1"
msgid ""
"We've got to get out of here! You understand me? We're the only ones left! We "
"need to find a way out of this house! Come on!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028cd4_Oblivion_RESP2"
msgid ""
"We've got to kill that cold-loving bastard before he turns on us! You cover "
"me while I strike the killing blow!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ad78_Oblivion_RESP1"
msgid "We've got to make it to the castle!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033759_Oblivion_RESP1"
msgid "We've got to stop them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000a564b_Oblivion_RESP1"
msgid "We've got work to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AleswellTopic_00030037_Oblivion_RESP2"
msgid ""
"We've had travellers through recently that say it's turned into a ghost town. "
"Everyone vanished without a trace. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ForlornWatchman_00035cab_Oblivion_RESP2"
msgid ""
"We've learned to just accept that he's there. Every night, sure as clockwork, "
"he appears at Bawnwatch Camp at 8 on the shore of Niben Bay."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017d0a_Oblivion_RESP2"
msgid ""
"We've lost control of Brellach. Thadon let them in... We had no idea he would "
"turn on us."
msgstr ""

