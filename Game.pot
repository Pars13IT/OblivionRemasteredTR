msgid "Have you heard any word about the other provinces?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00062682_Oblivion_RESP1"
msgid ""
"Have you heard anything more about what the Council knows about these "
"Necromancers? Something's not right."
msgstr ""

