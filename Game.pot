msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MazogaTalk04_00086570_Oblivion_RESP1"
msgid "Take me there. Now. I'm in a hurry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008606d_Oblivion_RESP1"
msgid "Take me to Fisherman's Rock. Now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001e6fd_Oblivion_RESP3"
msgid ""
"Take my Amulet. Give it to Jauffre. I have a secret son, and Jauffre alone "
"knows where to find him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000363b1_Oblivion_RESP1"
msgid "Take my advice. Stay away from the Watchmen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS09AlternateWay_0005377e_Oblivion_RESP2"
msgid ""
"Take my amulet to him. Get the gold and bring half of it back here to me. If "
"you don't come back, I'll let the guards in on our plan."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Fines_0003c295_Oblivion_RESP3"
msgid ""
"Take my good friend Aldos Othran for example. In the last month, he's been "
"fined six times! SIX! All for being drunk and disorderly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32NotSolved_000135d2_Oblivion_RESP3"
msgid ""
"Take my helm. With it, you can take my place in the defense of the gate. "
"Defeat the Devoted Fanatic in combat, and the curse will be lifted."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraSpeech_0005c01a_Oblivion_RESP1"
msgid ""
"Take my ring. Let it bring pain to others who would wish it upon you. Namira "
"blesses you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003da55_Oblivion_RESP2"
msgid ""
"Take some advice? Go down to the sea, stand a while. Watch the sun rise and "
"set. Think on the distant lands across the water."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateVoice_00085493_Oblivion_RESP1"
msgid "Take that you bastard!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008ef6b_Oblivion_RESP1"
msgid "Take that you sack of rotting meat!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0006b83a_Oblivion_RESP1"
msgid "Take that!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00091916_Oblivion_RESP1"
msgid "Take that!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00080d05_Oblivion_RESP1"
msgid "Take that!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00054824_Oblivion_RESP3"
msgid ""
"Take the Amulet. Give it to Jauffre. He alone knows where to find my last son."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00089936_Oblivion_RESP1"
msgid ""
"Take the key. Get to the Sigil Keep, and find the Sigil Stone. It's the only "
"way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00014a37_Oblivion_RESP1"
msgid "Take them down!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0004ea47_Oblivion_RESP1"
msgid "Take them down!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15KathutetC5_0003e8fb_Oblivion_RESP2"
msgid ""
"Take these Bands of the Chosen, then. Wear them, or you cannot enter the "
"Forbidden Grotto, the only way out of the Eternal Garden."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE11RakheranGiveDaggers1_0001a7bc_Oblivion_RESP1"
msgid ""
"Take these daggers! Slay her and at last, we can be on our path to true "
"enlightenment!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SECaldanaMonriusSkoomaYes_0008f7b0_Oblivion_RESP2"
msgid "Take this as a token of my thanks."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SECaldanaMonriusSkoomaYes_0008f787_Oblivion_RESP2"
msgid "Take this as payment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesStaff_0002ba66_Oblivion_RESP2"
msgid ""
"Take this charm scroll. With it, you should find Varon more receptive to "
"questioning. Don't come back without that staff."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11HaskillChoice6_00014b61_Oblivion_RESP5"
msgid ""
"Take this crystal. It contains the power to open the sealed door. Inside, you "
"will find the final remnants of the library."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AKithlanHelp_00014025_Oblivion_RESP2"
msgid ""
"Take this key. It should unlock any door in her wing of the palace. You still "
"need to be wary of her Seducer guards, but it should help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05accept_0000a1b7_Oblivion_RESP2"
msgid ""
"Take this note. Leave it in his nightstand. Bring me the staff when you get "
"it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001b6a6_Oblivion_RESP3"
msgid ""
"Take this trinket of mine. Perhaps it will serve you well. Or look lovely on "
"your corpse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PowerAttack_0008ef78_Oblivion_RESP1"
msgid "Take this!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003569f_Oblivion_RESP2"
msgid ""
"Take this. It will increase your skills in battle. We use it often. It is a "
"good, good thing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035648_Oblivion_RESP1"
msgid "Take this. It's from a friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00024e51_Oblivion_RESP3"
msgid ""
"Take up the dagger and offer Lord Dagon the sacrificial red-drink as pledge "
"of your own life's blood, which shall be his in the end."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00086065_Oblivion_RESP7"
msgid ""
"Take what you want from the dead. I came to keep my oath, and now I'm done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Flee_00098386_Oblivion_RESP1"
msgid "Take what you will! Just spare me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Flee_00023e56_Oblivion_RESP1"
msgid "Take whatever you want! Just don't hurt me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00073b60_Oblivion_RESP1"
msgid "Take your flies and your sores over there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0002798e_Oblivion_RESP1"
msgid ""
"Take your time with this one. Observe the other guests. Learn their schedules "
"and behaviors, and strike each one when they're alone. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00018bfc_Oblivion_RESP1"
msgid ""
"Take your time, and hurry back. I might not be waiting for you when you "
"return."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00022e1b_Oblivion_RESP1"
msgid "Take your time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00022e10_Oblivion_RESP1"
msgid "Take your time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONENTER_00062307_Oblivion_RESP1"
msgid "Take your time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062cc1_Oblivion_RESP1"
msgid "Talk is free. What do you want?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15KathutetB1_0003e8f2_Oblivion_RESP1"
msgid "Talk or not as you choose. But you will listen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028557_Oblivion_RESP1"
msgid ""
"Talk to Captain Matius if you need something. I'm just following his orders."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004f3ea_Oblivion_RESP1"
msgid "Talk to Cirroc about that contract. Make me proud."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000301e2_Oblivion_RESP1"
msgid ""
"Talk to Diram in the inn. I'm tired of this minstrel's freakshow our town has "
"turned into."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d493_Oblivion_RESP1"
msgid "Talk to Faustina. She's got a proposition for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03XedilianTopic_0008e94d_Oblivion_RESP2"
msgid ""
"Talk to Haskill if you need more information. He's got more brains than a "
"brain pie. Oh... Brain pie! Perfect!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00062447_Oblivion_RESP1"
msgid ""
"Talk to Helvius Cecia in Bruma. He's your best bet for learning more about "
"hand to hand combat."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ce97_Oblivion_RESP1"
msgid "Talk to Hjolfrodi. I can't help you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46DoublesTopic_0008fa9a_Oblivion_RESP2"
msgid "Talk to Horkvir. Our Horkvir. He's in charge. He'll know what to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThoronirTopic_0000bc94_Oblivion_RESP1"
msgid "Talk to Jensine. She can help you better than I can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Gang_0003d4ed_Oblivion_RESP1"
msgid "Talk to Maelona. She runs the council. Judge, jury and executioner."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003d4d3_Oblivion_RESP1"
msgid "Talk to her, she seems to have all the answers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00072c91_Oblivion_RESP3"
msgid "Talk to my Kishashi. If she will trust you, I will trust you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FaelianTopic_0002ff0b_Oblivion_RESP2"
msgid ""
"Talk to the Publican, Augusta Calidia. I'm sure she can tell you more about "
"him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45Choice2_00083f5f_Oblivion_RESP1"
msgid ""
"Talk to the beggar! Talk to Bolwing! He knows secrets, but no one can hear "
"them. No one but Big Head."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JskarTopic_0002d591_Oblivion_RESP4"
msgid ""
"Talk to the mages here, and see what you can find out. If you can make J'skar "
"re-appear, you'll have your recommendation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_COERCEHATE_0018b2c9_Oblivion_RESP1"
msgid "Talk tough to me. I love tough guys."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark17Choice2A_0005402e_Oblivion_RESP4"
msgid ""
"Talk... talk to Ulfgar. He's sure to have the key to the cellar. You know, "
"if... if you want to get down there! Now please, just let me go!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark17Choice2B_0005402f_Oblivion_RESP4"
msgid ""
"Talk... talk to Ulfgar. He's sure to have the key to the cellar. You know, "
"if... if you want to get down there! Now please, just let me go!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark17Choice2C_00054030_Oblivion_RESP4"
msgid ""
"Talk... talk to Ulfgar. He's sure to have the key to the cellar. You know, "
"if... if you want to get down there! Now please, just let me go!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b598_Oblivion_RESP1"
msgid "Talking to yourself is not a sign of mental illness. It's not."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000730c1_Oblivion_RESP1"
msgid "Talking wears me out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001ad4e_Oblivion_RESP1"
msgid ""
"Talking with you leaves such a nasty taste in my mouth. And not the good kind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND09ProphetGreeting02b_00002cd5_Knights_RESP3"
msgid ""
"Talos and Tiber Septim are one and the same. Rather, Tiber Septim ascended to "
"godhood upon his death, and became Talos."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00051ea2_Oblivion_RESP1"
msgid "Talos bless me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_000549b8_Oblivion_RESP1"
msgid "Talos preserve us!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000293a_Knights_RESP1"
msgid ""
"Talos, the Dragonborn, patron of questing knights, will surely look with "
"favor upon us. Walk with me to his shrine, if you will."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c25e_Oblivion_RESP1"
msgid ""
"Tamika makes some truly fine wines at her winery. I think they're every bit "
"as good as the Surilie Brothers wines."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MankarRant_0008c229_Oblivion_RESP10"
msgid ""
"Tamriel is just one more Daedric realm of Oblivion, long since lost to its "
"Prince when he was betrayed by those that served him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00062462_Oblivion_RESP1"
msgid ""
"Tandilwe has a true mastery of the spoken word. She is the one you should "
"speak with about more training."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047644_Oblivion_RESP1"
msgid ""
"Tar-Meena. This is my Mystic Archives. Keep it neat. Keep it quiet. No eating "
"in the stacks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateVoice_00085494_Oblivion_RESP1"
msgid "Teach you to mess with the Legion!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004cfa5_Oblivion_RESP1"
msgid "Tell Ardaline I'm sorry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE35HereYouGo_00078673_Oblivion_RESP3"
msgid "Tell everyone not to worry, I won't be bothering them any longer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003377d_Oblivion_RESP1"
msgid "Tell her right away."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029ac_Knights_RESP1"
msgid ""
"Tell me about Garlas Malatar, sir knight. These Aurorans -- what sort of foes "
"were they?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONENTER_0018b2e6_Oblivion_RESP1"
msgid "Tell me more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001dc29_Oblivion_RESP1"
msgid "Tell me what you learned about Toutius Sextius."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08Orders_0001ec1d_Oblivion_RESP1"
msgid "Tell me where you would have me serve, Your Grace."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE09MiscRelmynaExperiment_00046f6b_Oblivion_RESP1"
msgid "Tell me, how does this feel?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ND10FinThedretGreeting01a_00002ca5_Knights_RESP3"
msgid ""
"Tell me... Umaril... what happened? Did you succeed in pursuing him into the "
"spirit realm, as the Prophet said?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ND10FinThedretGreeting01_00002c9d_Knights_RESP3"
msgid "Tell me... was Umaril destroyed? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0007d470_Oblivion_RESP1"
msgid "Tell the daen! Tell the daen! Karn sky is relfing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG09ChoiceGoOn_00022b65_Oblivion_RESP1"
msgid ""
"Tell your Council that the next time they want something from me, they come "
"themselves. They don't send someone under false pretenses."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterExit_000091e9_DLCThievesDen_RESP1"
msgid "Tell your friends about me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_jobs_00071096_Oblivion_RESP2"
msgid ""
"Tell your men I'll pay them for minotaur horns and ogre teeth. The Fighters "
"Guild will be my sole supplier. I look forward to doing more business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e05_Oblivion_RESP1"
msgid "Ten of the evening watch, and all's well. Everything okay, ma'am? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e8b_Oblivion_RESP1"
msgid "Ten of the evening watch, and all's well. Everything okay, sir? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e18_Oblivion_RESP1"
msgid "Ten of the morning watch, and all's well. How are you, ma'am?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023edd_Oblivion_RESP1"
msgid "Ten of the morning watch, and all's well. How are you, sir?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11TalkToMillona07_00022e83_Oblivion_RESP1"
msgid ""
"Ten years ago I inherited this cowl from the former guildmaster of the "
"Thieves Guild. I became the new guildmaster, but I also received it's curse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0018a956_Oblivion_RESP1"
msgid "Ten years of research down the drain..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TenetsTopic_000272ae_Oblivion_RESP2"
msgid ""
"Tenet 1: Never dishonor the Night Mother. To do so is to invoke the Wrath of "
"Sithis."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TenetsTopic_000272ae_Oblivion_RESP3"
msgid ""
"Tenet 2: Never betray the Dark Brotherhood or its secrets. To do so is to "
"invoke the Wrath of Sithis."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TenetsTopic_000272ae_Oblivion_RESP4"
msgid ""
"Tenet 3: Never disobey or refuse to carry out an order from a Dark "
"Brotherhood superior. To do so is to invoke the Wrath of Sithis."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TenetsTopic_000272ae_Oblivion_RESP5"
msgid ""
"Tenet 4: Never steal the possessions of a Dark Brother or Dark Sister. To do "
"so is to invoke the Wrath of Sithis."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TenetsTopic_000272ae_Oblivion_RESP6"
msgid ""
"Tenet 5: Never kill a Dark Brother or Dark Sister. To do so is to invoke the "
"Wrath of Sithis."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CreatureResponses_0002b1c7_Oblivion_RESP1"
msgid ""
"Terrible creatures. They travel in packs, and they're always up to no good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46DoublesTopic_0008fa7a_Oblivion_RESP1"
msgid ""
"Terrible drain on productivity. Never know who's who. It's been a problem for "
"too long."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_LeyawiinNQDQuestionResponses_0003de4e_Oblivion_RESP1"
msgid "Terrible jokes. Just terrible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerStatus_00024203_Oblivion_RESP1"
msgid "Terrible. Just terrible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004769e_Oblivion_RESP1"
msgid ""
"Tertius Favonius. Romana and me have set up housekeeping. She's a real doll, "
"isn't she?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004766a_Oblivion_RESP1"
msgid "Tertullian, Sergius, and Cicero... the Three Verus Brothers. I'm Cicero."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047668_Oblivion_RESP1"
msgid ""
"Tertullian, Sergius, and Cicero... the Three Verus Brothers. I'm Sergius."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047666_Oblivion_RESP1"
msgid ""
"Tertullian, Sergius, and Cicero... the Three Verus Brothers. I'm Tertullian."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00074a14_Oblivion_RESP1"
msgid "Test your strength against me, mortal!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS26FileCharges_00035ca4_Oblivion_RESP1"
msgid ""
"Testify against a Watch Captain and accuse him of corruption? I don't think "
"I'm willing to risk doing that."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_0006176f_Oblivion_RESP1"
msgid "Thadon and Syl gone. Strange times."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e9f_Oblivion_RESP1"
msgid "Thadon and his Chalice can both rot in Hell, for all I care."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ec7_Oblivion_RESP1"
msgid ""
"Thadon better not drink out of that Chalice. Who knows how many people have "
"used it while it was missing? Reusing cups is the best way to get sick."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_0006177e_Oblivion_RESP1"
msgid "Thadon dead, and Syl gone. This isn't good."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_0006176c_Oblivion_RESP1"
msgid "Thadon finally did himself in. Good riddance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ed3_Oblivion_RESP1"
msgid ""
"Thadon finally has his precious Chalice. But, such things do not matter to "
"those of us who work for a living."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed50_Oblivion_RESP1"
msgid "Thadon gone.... I wonder if his quarters are still guarded."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e8a_Oblivion_RESP1"
msgid ""
"Thadon got his Chalice back. I heard he uses it around women. Better steer "
"clear of mine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10StaadaWhere_00016b3a_Oblivion_RESP3"
msgid ""
"Thadon had her called aside, separating her from the group. He meant to "
"divide our numbers when Order entered, making us easier targets."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e9b_Oblivion_RESP1"
msgid ""
"Thadon had outside help getting his Chalice back. Something sneaky going on "
"there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed57_Oblivion_RESP1"
msgid "Thadon has been replaced. It is a moment worth capturing forever."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed58_Oblivion_RESP1"
msgid "Thadon has died. I hope he didn't go quietly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ed7_Oblivion_RESP1"
msgid ""
"Thadon has his Chalice back. Doesn't he know a good leader doesn't need any "
"of that? Just his native intelligence. I would know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e8b_Oblivion_RESP1"
msgid ""
"Thadon has his Chalice back. I wonder if he'll let me take a look at it...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ec0_Oblivion_RESP1"
msgid ""
"Thadon has his Chalice back. In the stories, men are always off in search of "
"some sword or a cup of some kind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e98_Oblivion_RESP1"
msgid ""
"Thadon has his Chalice back. Why won't anyone help me replace what I've lost?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e93_Oblivion_RESP1"
msgid ""
"Thadon has his Chalice. That'll anger Syl, I'm sure, which means more work "
"for me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e97_Oblivion_RESP1"
msgid ""
"Thadon has one less excuse for his sloppy rule over Bliss, now that he has "
"his Chalice again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed77_Oblivion_RESP1"
msgid ""
"Thadon has passed the mantle. I heard he was in bad health, anyway, and I "
"know how that is."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThadonTopic_0004301c_Oblivion_RESP1"
msgid ""
"Thadon has told you what he wants. Consider speaking with the others in his "
"court, particularly his steward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BRoutine_000167e2_Oblivion_RESP2"
msgid ""
"Thadon has too many enemies that may turn that knowledge against him. He "
"depends on me quite dearly."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061427_Oblivion_RESP1"
msgid "Thadon is a drug-addled fool."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ed2_Oblivion_RESP1"
msgid ""
"Thadon is addicted to Felldew. I stay away from drugs. A sorceress needs a "
"clear mind. Hey, do you hear those dogs barking? They're so loud!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed4d_Oblivion_RESP1"
msgid ""
"Thadon is dead, and a new ruler is in his place. Sheer-Meedish must be "
"excited."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed5c_Oblivion_RESP1"
msgid "Thadon is dead. Bliss will be even more of a mess than before."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed51_Oblivion_RESP1"
msgid "Thadon is dead. I drink to his health. Or... whatever."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed8a_Oblivion_RESP1"
msgid ""
"Thadon is dead. I wonder if he had anything interesting for the museum...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed5b_Oblivion_RESP1"
msgid "Thadon is dead. Lucky bastard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed9e_Oblivion_RESP1"
msgid "Thadon is dead. Quite a tragedy. Perhaps someone will write about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005edb3_Oblivion_RESP1"
msgid "Thadon is dead? I had a nightmare about that once."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed4b_Oblivion_RESP1"
msgid "Thadon is gone! Perhaps things are looking up."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed56_Oblivion_RESP1"
msgid "Thadon is gone. I wonder if he left anything worth keeping..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ed8_Oblivion_RESP1"
msgid "Thadon is in high spirits now? I'm glad someone is."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e81_Oblivion_RESP1"
msgid ""
"Thadon is not so moody lately. Do you think that wall is about to fall on me? "
"It seems awfully unstable."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed90_Oblivion_RESP1"
msgid "Thadon isn't dead. He's just hiding."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ebf_Oblivion_RESP1"
msgid ""
"Thadon isn't really addicted to Felldew. Felldew is perfectly safe. There's "
"nothing magical about his special cup either."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10Opposition_00016b38_Oblivion_RESP1"
msgid ""
"Thadon let them in. More than I could count. It was all we could do to fall "
"back and regroup out here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BThadon_0006a896_Oblivion_RESP1"
msgid ""
"Thadon may be in a constant state of euphoria, but I wouldn't underestimate "
"his intelligence. Oh, this is so much fun!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e8c_Oblivion_RESP1"
msgid ""
"Thadon must be back on the Felldew... he's never tried the skooma though. "
"Say, you got any skooma you can spare, friend?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e99_Oblivion_RESP1"
msgid ""
"Thadon seems upbeat again. I know how hard it is to get anything done when "
"you're not feeling up to it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e82_Oblivion_RESP1"
msgid "Thadon with his Chalice. No Fork for Big Head. Songs of sadness."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ed5_Oblivion_RESP1"
msgid "Thadon's a fool. Who cares about his precious Chalice?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ecb_Oblivion_RESP1"
msgid ""
"Thadon's back to his old self, I hear. He gets moody when he's not on the "
"Felldew. He had two people killed. I know. I counted them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e8f_Oblivion_RESP1"
msgid ""
"Thadon's blood is so tainted. He needs to be cut open so he can let some of "
"the toxin out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005edc1_Oblivion_RESP1"
msgid "Thadon's dead? So what? He annoyed me as much as you do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005edf1_Oblivion_RESP1"
msgid "Thadon's dead? They're all just bags of meat to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043eca_Oblivion_RESP1"
msgid ""
"Thadon's got his cup back? Isn't that nice? I certainly can't lay around "
"drifting on Felldew all day. I've got too many important things to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ece_Oblivion_RESP1"
msgid ""
"Thadon's got his cup. The world's back in order. I get it. So then why the "
"hell are you still here bothering me? Get lost!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e85_Oblivion_RESP1"
msgid ""
"Thadon's in a much better mood lately. If he weren't so in love with the "
"Felldew, I might invite him over to inspect my \"wares\" some time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043edb_Oblivion_RESP1"
msgid "Thadon's new mood after recovering his Chalice is quite nice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005edc4_Oblivion_RESP1"
msgid "Thadon's not dead. He lives underground. In a house made of cheese."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEChaliceofReversal_0001e3fe_Oblivion_RESP1"
msgid "Thadon's problem. Not mine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07ASheoShout_0008f531_Oblivion_RESP1"
msgid "Thadon, how dare you interrupt me! Only I interrupt me. Like just then."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BSylLeaves_0003b83d_Oblivion_RESP1"
msgid "Thadon... dead? You've done this. It was you all along!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10WhatHappened_00017d16_Oblivion_RESP1"
msgid ""
"Thadon... the snake. He showed up, asked for a contingent of guards. Said "
"there was trouble, and that we were needed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000836cd_Oblivion_RESP1"
msgid "Thalfin's in charge. She's been waiting for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476dc_Oblivion_RESP1"
msgid ""
"Thamriel of Tamriel. What are all those strange creatures in the garden? "
"Where are all the white birds?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_000476dd_Oblivion_RESP1"
msgid ""
"Thamriel says she hears voices. All the men and women who lived and died here "
"for thousands of years... maybe they left ghosts behind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00061383_Oblivion_RESP1"
msgid ""
"Thank Akatosh the Oblivion Crisis is over! Although with no Emperor and no "
"heir, I wonder what will happen to the Empire?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000270eb_Oblivion_RESP1"
msgid ""
"Thank Akatosh you're here! I have deciphered the final item for the ritual to "
"open a portal to Camoran's Paradise!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008dd5d_Oblivion_RESP1"
msgid "Thank Peryite we've been saved!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ed4c_Oblivion_RESP1"
msgid "Thank Sheogorath it was Thadon who was killed, not Syl."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061788_Oblivion_RESP1"
msgid "Thank Sheogorath it was only a settlement, and not Crucible."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_00061c9b_Oblivion_RESP1"
msgid "Thank Sheogorath we're safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00025576_Oblivion_RESP1"
msgid ""
"Thank Stendarr for the chapel here in Chorrol. A lovely place, and the "
"healers are excellent."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05BaurusB_00022b22_Oblivion_RESP1"
msgid ""
"Thank Talos he lives! Martin Septim, you say ... We will restore him to the "
"throne! It is the sworn duty of all Blades."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00020073_Oblivion_RESP1"
msgid "Thank Talos you've returned safely!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46Goblins_00033efd_Oblivion_RESP2"
msgid ""
"Thank Y'ffre that Mirisa was there! Without her, the goblins would have "
"surely killed us all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002deb_Oblivion_RESP1"
msgid ""
"Thank goodness I found you. I assume you know that Hieronymus Lex has issued "
"an arrest warrant for Armand Christophe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0018abd5_Oblivion_RESP1"
msgid "Thank goodness someone that can help is here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000a3842_Oblivion_RESP1"
msgid ""
"Thank goodness the gate is gone. I couldn't get a good night's sleep knowing "
"it was out there!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000c1c1_Oblivion_RESP1"
msgid ""
"Thank goodness you arrived when you did! I feared that I'd be thrown to the "
"slaughterfish."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002945_Knights_RESP1"
msgid ""
"Thank the Nine that those creatures were stopped before they could desecrate "
"our Chapel!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009811c_Oblivion_RESP1"
msgid "Thank the Nine! I never thought I'd see another friendly face..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003661e_Oblivion_RESP1"
msgid ""
"Thank the gods you killed that thing. This is ridiculous! Someone's out to "
"get me, to get my poor babies! I'll bet it's that Quill-Weave next door."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00067dbe_Oblivion_RESP1"
msgid ""
"Thank you again for your kind words. Now please, don't let me keep you. We'll "
"speak again later.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RewardTopic_000a3df2_Oblivion_RESP2"
msgid ""
"Thank you again. I shall rest easier now, knowing that Rona no longer suffers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RewardTopic_000a3df4_Oblivion_RESP2"
msgid ""
"Thank you again. I shall rest easier now, knowing that Rona no longer suffers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006ede9_Oblivion_RESP1"
msgid "Thank you for all your help. My rats appreciate it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06TellKellen_00002b8d_Knights_RESP3"
msgid "Thank you for being honest with me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d285_Oblivion_RESP1"
msgid ""
"Thank you for closing that Oblivion Gate. Despite what the Count may say, "
"we're all in your debt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00026e96_Oblivion_RESP1"
msgid ""
"Thank you for closing the Oblivion Gate that was threatening Bravil. I will "
"send my guard captain, Viera Lerus, to Bruma's aid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d29c_Oblivion_RESP1"
msgid ""
"Thank you for closing the Oblivion Gate. We all took heart when we heard the "
"news."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS26ItiusResponse_00036608_Oblivion_RESP1"
msgid "Thank you for coming forward, citizen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00016b37_Oblivion_RESP1"
msgid "Thank you for coming. I apologize for summoning you. The blame is mine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017d0a_Oblivion_RESP1"
msgid "Thank you for coming. I apologize for summoning you. The blame is mine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13NarinaMartin1_0002777d_Oblivion_RESP1"
msgid ""
"Thank you for coming. I know I am asking for a great deal of trust. But this "
"is the only way. I would not suggest it otherwise."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002b45e_Oblivion_RESP1"
msgid ""
"Thank you for coming. You may recognize that statue over there on the table. "
"The very one that you recently sold -- for less than its true worth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0007b473_Oblivion_RESP1"
msgid "Thank you for convincing her to meet with me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029a9_Knights_RESP1"
msgid "Thank you for freeing me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000c1dc_Oblivion_RESP1"
msgid ""
"Thank you for freeing me. I'm Graman gro-Marad, the Bloated Float's bouncer "
"and helmsman. I've been locked in that storage room for hours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00031eb2_Oblivion_RESP1"
msgid "Thank you for getting me out of that cursed place."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00031e9f_Oblivion_RESP1"
msgid ""
"Thank you for getting me out of that cursed place. 'Tis ashame Farwil didn't "
"make it. At least he died doing what he loved."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000781eb_Oblivion_RESP1"
msgid ""
"Thank you for helping us overthrow the tyrant. But you must understand that "
"as Queen, I'm very busy ruling over the Shivering Isles. Run along."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Gift_0018bc30_Oblivion_RESP2"
msgid ""
"Thank you for indulging an old man's whims. Now, you wanted to learn "
"something about Heavy Armor, didn't you? I think I can help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VidkunTopic_0002e998_Oblivion_RESP5"
msgid ""
"Thank you for letting me know. I'm sorry that you had to be a part of all of "
"this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FaelianTopic_0002ff13_Oblivion_RESP5"
msgid ""
"Thank you for listening. You're a good friend. I just hope my sweet Faelian "
"can clean himself up, or that awful skooma will be the death of him!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterBuyItem_0005e047_Oblivion_RESP1"
msgid "Thank you for purchasing...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45DarMaGoHome_0002820d_Oblivion_RESP1"
msgid ""
"Thank you for rescuing me!  My mother will be so pleased when we arrive back "
"in Chorrol safe and sound.  Let's go!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000029a0_Knights_RESP1"
msgid ""
"Thank you for rescuing me. I've lost track of how long they've held me here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HenantierTopic_0003cd45_Oblivion_RESP1"
msgid ""
"Thank you for returning Henantier to me. I don't know what I would have done "
"without him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003640d_Oblivion_RESP1"
msgid ""
"Thank you for saving me, friend. I don't know who you are, but it is clear "
"that Akatosh guides you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0018abd8_Oblivion_RESP1"
msgid "Thank you for saving my business, I won't forget it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001e0d7_Oblivion_RESP1"
msgid "Thank you for sparing me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002996_Knights_RESP1"
msgid "Thank you for speaking to Areldur on my behalf."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterExit_0005e07e_Oblivion_RESP1"
msgid "Thank you for stopping by. Stay healthy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkDeadKnight3_00002cd8_Knights_RESP1"
msgid ""
"Thank you for taking the time to speak to me. Now, we must not spend our time "
"in regrets. We are Knights of the Nine, with duties to attend to!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003c352_Oblivion_RESP1"
msgid "Thank you for visiting me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GlarthirTopic_0002365e_Oblivion_RESP1"
msgid ""
"Thank you for warning me about him. Please, hurry and tell the guards before "
"it's too late!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE09MiscRelmynaExperiment_00046f4b_Oblivion_RESP1"
msgid "Thank you for your assistance in my research."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterExit_0000921d_DLCThievesDen_RESP1"
msgid "Thank you for your business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServeSentence_00045759_Oblivion_RESP1"
msgid "Thank you for your cooperation in this unfortunate matter, Your Grace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk5_00067dc8_Oblivion_RESP1"
msgid ""
"Thank you for your courtesy, sir. If you ever need a friendly ear, I'm always "
"available, night or day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45DarMaGoHome_0002820e_Oblivion_RESP1"
msgid ""
"Thank you for your help!  If you are ever in Chorrol, please look me up. My "
"mother owns the Northern Goods and Trade shop."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39MissionChoice1a_00078202_Oblivion_RESP2"
msgid ""
"Thank you for your help. Here, take this. I was using it to ward off "
"Cindanwe's evil mind control magic. I don't need it now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000be63_Oblivion_RESP1"
msgid "Thank you for your help. You are always welcome here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk3_00068353_Oblivion_RESP1"
msgid ""
"Thank you for your kind words. I never knew my father, but he must have been "
"proud to call the Blades his protectors. I know I am."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterExit_000091e6_DLCThievesDen_RESP1"
msgid "Thank you for your patronage."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterExit_00062023_Oblivion_RESP1"
msgid "Thank you for your patronage."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEServeSentence_000459c5_Oblivion_RESP1"
msgid ""
"Thank you for your understanding, My Lord. I am required by Your own command "
"to ask You for any items You may have inadvertently borrowed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BeggarGiveGold_00015e0d_Oblivion_RESP1"
msgid "Thank you kind lady!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BeggarGiveGold_00015e0c_Oblivion_RESP1"
msgid "Thank you kind sir!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugo08_00090b7b_Oblivion_RESP1"
msgid ""
"Thank you kindly! 'Knight of the White Stallion.' Sounds good. Damn good. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugo09_00090b7c_Oblivion_RESP1"
msgid "Thank you kindly, Sir Knight. Sounds good. Damn good. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE41PostHere_0008f9c6_Oblivion_RESP1"
msgid "Thank you so much again! Here is a small bit of change for your time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002990_Knights_RESP2"
msgid "Thank you so much! You have no idea what this means to me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002991_Knights_RESP2"
msgid "Thank you so much! You have no idea what this means to me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45DarMaUntie_0002820f_Oblivion_RESP1"
msgid "Thank you!  Hurry, we need to get out of here, quick!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45DarMaUntie_00028751_Oblivion_RESP1"
msgid ""
"Thank you!  You're the first friendly face I've seen since I arrived in this "
"hellhole."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetF1_00002b75_Knights_RESP1"
msgid "Thank you! I mean, thank you, Sir Knight. I will not fail you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002942_Knights_RESP1"
msgid ""
"Thank you! I was sure those creatures would be the end of all of us. You "
"truly are the defender of the Faith!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38OddityDonate_00043438_Oblivion_RESP3"
msgid ""
"Thank you! It is a truly odd Tentacle. I'm so glad to have one back on "
"display."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45Convo_000a2e57_Oblivion_RESP1"
msgid "Thank you! Let's get out of here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice1A_00028150_Oblivion_RESP1"
msgid ""
"Thank you! Now, we're not quite sure where the estate is located. We'll offer "
"up what we know, however."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MageConvReturn_0006bdbe_Oblivion_RESP1"
msgid "Thank you, Arch-Mage. It has been a pleasure to accompany you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDJoinOrderAccept_00002b39_Knights_RESP1"
msgid "Thank you, Sir Knight! I will do my best to vindicate your faith in me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38OddityDonate_00081e9e_Oblivion_RESP3"
msgid ""
"Thank you, dearie! My museum just wasn't the same without the ashes on "
"display."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAAzuraSpeech_0002c6c5_Oblivion_RESP1"
msgid ""
"Thank you, mortal. Their spirits are free, and henceforth, above my shrine, "
"five bright candles shall burn forever in memory of their sacrifice. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetE1_00002b79_Knights_RESP1"
msgid ""
"Thank you, sir knight. I would ask a boon, if I could, although I know I do "
"not deserve it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ09Scales_00067dd1_Oblivion_RESP3"
msgid ""
"Thank you, stranger. You've shown me kindness and I will think of you in the "
"long comfortable days ahead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45DarMaSafe_00028210_Oblivion_RESP1"
msgid ""
"Thank you, thank you!  I can never repay you for your gift of my daughter's "
"life, but you have my friendship and gratitude to the end of my days."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003013c_Oblivion_RESP1"
msgid ""
"Thank you, thank you! I can't tell you how good it feels to be able to see "
"myself again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05GwinasPhintiasB_00022b53_Oblivion_RESP1"
msgid ""
"Thank you, thank you! I can't tell you how long I've been looking for this "
"book!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05MazaddhaSpare2_0008118a_Oblivion_RESP1"
msgid ""
"Thank you, thank you! You are too kind. I shall bring you names, I promise."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ADMIRELIKE_0018b2ad_Oblivion_RESP1"
msgid "Thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033b25_Oblivion_RESP1"
msgid "Thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05TortureChoice3_0007ff44_Oblivion_RESP1"
msgid "Thank you."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BattlehornWineA_0000bb0c_DLCBattlehornCastle_RESP1"
msgid "Thank you. Anything else?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BattlehornWineB_0000bb18_DLCBattlehornCastle_RESP1"
msgid "Thank you. Anything else?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BattlehornWineC_0000bb19_DLCBattlehornCastle_RESP1"
msgid "Thank you. Anything else?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BattlehornWineD_0000bb1a_DLCBattlehornCastle_RESP1"
msgid "Thank you. Anything else?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BattlehornWineE_0000bb1b_DLCBattlehornCastle_RESP1"
msgid "Thank you. Anything else?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BattlehornWineF_0000bb1c_DLCBattlehornCastle_RESP1"
msgid "Thank you. Anything else?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BattlehornWineG_0000bb1d_DLCBattlehornCastle_RESP1"
msgid "Thank you. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterExit_000091e8_DLCThievesDen_RESP1"
msgid "Thank you. Come again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23RalsaGreet_0001db1f_Oblivion_RESP5"
msgid ""
"Thank you. Gilen always tends to exaggerate, but in this case he sounded "
"earnest which worries me a bit..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BRIBE_0018b2bf_Oblivion_RESP1"
msgid "Thank you. How kind."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_MQ13BattleGetMoreAllies_00027785_Oblivion_RESP1"
msgid ""
"Thank you. I know that delay is dangerous, but it is all for naught if we "
"lose the battle before you can recover the Great Sigil Stone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDJoinOrderAccept_00002b38_Knights_RESP1"
msgid "Thank you. I shall serve the Order to the best of my ability."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS11GiveAmulet_00038b06_Oblivion_RESP1"
msgid "Thank you. I will now speak the word."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS04HelpYes_0003d311_Oblivion_RESP1"
msgid ""
"Thank you. I'm afraid I can't offer you much help, but I'll do what I can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23KillNoRoland_0001d4c9_Oblivion_RESP1"
msgid "Thank you. I'm happy you gave me a chance to explain."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23RalsaGreet2_0001db20_Oblivion_RESP1"
msgid "Thank you. I'm sure he'll be pleased. I must go now. Good day to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDJoinOrderAccept_00002b37_Knights_RESP1"
msgid "Thank you. It means a great deal to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG12TravenVeryWell_000835fd_Oblivion_RESP1"
msgid ""
"Thank you. Know that I would not ask such a thing of you if I did not feel it "
"was urgent, or that it was beyond your capabilities."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_DEM02ImperialMaleVoice_00002A2D_AltarDeluxe_RESP1"
msgid "Thank you. May the Nine Divines be with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07SpiesResponse_00020076_Oblivion_RESP1"
msgid "Thank you. Talk to Steffan. He can tell you where he has seen them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGC07Choice5_00009213_Oblivion_RESP1"
msgid ""
"Thank you. Thank you so much. Hopefully, I'll be able to sell these for "
"enough to pay my debt. You're a lifesaver."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterBuyItem_0005e00e_Oblivion_RESP1"
msgid "Thank you. The funds go toward my home remedies."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13SignetYes_000335ad_Oblivion_RESP1"
msgid ""
"Thank you. You are truly worthy of all the praise being given to you. I "
"salute you. I'll keep the ring as a reminder of... hmmm..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14NoMoreBrush_0001c1c7_Oblivion_RESP1"
msgid ""
"Thank you. You're truly kind to help someone you've just met. The only thing "
"standing in our way are the painted trolls."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000366c6_Oblivion_RESP1"
msgid "Thank you..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EmfridDEMOchoice4_00028a33_Oblivion_RESP1"
msgid ""
"Thank you...thank you so much. I can't tell you how grateful I am. You always "
"have a home here at the Grey Mare."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008f7b7_Oblivion_RESP1"
msgid ""
"Thanks again for bringing Pyke back his Medallion! I've never seen him so "
"full of happiness."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000c1c4_Oblivion_RESP1"
msgid ""
"Thanks again for helping us. I'm sure Ormil will reward you appropriately."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001e7e2_Oblivion_RESP1"
msgid "Thanks again for your help, we had no other place to turn."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ee2e_Oblivion_RESP1"
msgid ""
"Thanks again, assassin. Your services have been invaluable. Soon I will find "
"passage out of Cyrodiil, and be rid of those moneylenders forever!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008655e_Oblivion_RESP1"
msgid "Thanks again, buddy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AlbertJemaneTopic_0008b074_Oblivion_RESP6"
msgid "Thanks again, my friend. You are always welcome in our home."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033757_Oblivion_RESP1"
msgid "Thanks again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000335ef_Oblivion_RESP1"
msgid "Thanks again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopicFalanu02_00038aa3_Oblivion_RESP1"
msgid "Thanks anyway."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026ee9_Oblivion_RESP1"
msgid ""
"Thanks for coming. Since we had the Hero of Kvatch available, I didn't think "
"it made sense to try this on our own the first time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003a84c_Oblivion_RESP1"
msgid "Thanks for coming. We could use your help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009079e_Oblivion_RESP1"
msgid ""
"Thanks for doing my work for me. Nothing like having someone else do your "
"dirty laundry. Thanks, you idiot!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08CutoffTopic_00079bdc_Oblivion_RESP1"
msgid ""
"Thanks for the help, I suppose. Although you seem to be doing your best to "
"get me killed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0005a027_Oblivion_RESP1"
msgid ""
"Thanks for the help, friend. I didn't recognize you at first, but you're the "
"Hero of Kvatch, aren't you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000be6f_Oblivion_RESP1"
msgid ""
"Thanks for the help, not that I couldn't have taken care of it myself. If I "
"were still allowed to carry an axe...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000335e5_Oblivion_RESP1"
msgid "Thanks for the help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0005a028_Oblivion_RESP1"
msgid ""
"Thanks for the help. As soon as my lieutenant gets back, we'll be moving out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00086566_Oblivion_RESP1"
msgid "Thanks for the help. You're okay."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001e8d0_Oblivion_RESP1"
msgid ""
"Thanks for the rescue. I didn't think we would make it out of the Chapel "
"alive. Perhaps Akatosh guided you to us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026eed_Oblivion_RESP1"
msgid ""
"Thanks for your help closing that Gate. Don't worry, we can handle anything "
"else they throw at us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00033df5_Oblivion_RESP1"
msgid ""
"Thanks for your help. I didn't think any of us were going to survive the "
"attack."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008dc3e_Oblivion_RESP1"
msgid "Thanks so much for getting us here safely!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_sons_0002573b_Oblivion_RESP4"
msgid ""
"Thanks so much for sticking with them and helping a foolish old man. Please, "
"take this... I won't be needing it any longer. My battles are over."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008ef52_Oblivion_RESP1"
msgid "Thanks to me, things are going well here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033579_Oblivion_RESP1"
msgid "Thanks to you, Cheydinhal is safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ToutiusSextiusTopic_00025b37_Oblivion_RESP1"
msgid "Thanks to you, his sinister plans have now been revealed to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDSirCaiusTopic_00002d23_Knights_RESP7"
msgid ""
"Thanks to you, that all is behind me. Sir Caius and I will go to Aetherius "
"side by side, as of old. The gods are truly merciful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00018f87_Oblivion_RESP1"
msgid "Thanks to you, the Mazken have been utterly defeated!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SERunsInCirclesGiveGold_00041207_Oblivion_RESP1"
msgid "Thanks! Thanks a lot!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033b1e_Oblivion_RESP1"
msgid "Thanks, friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD01Choice1_0002ae2f_Oblivion_RESP1"
msgid ""
"Thanks. I'm not trying to shirk my duty, but it used to be two or three men "
"would be on this. I like the Guild, but I've got a family to consider."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002d764_Oblivion_RESP1"
msgid "Thanks. Kvatch is safer for all of us, now you've closed the gate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EmfridHot_00023cd0_Oblivion_RESP4"
msgid ""
"Thanks. That's a very good suggestion. I think I'll stop by the Grey Mare, "
"and perhaps pay my respects to this Emfrid woman."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GenericBanditA_000a31c8_Oblivion_RESP1"
msgid "Thanks. Until next time, ha ha ha."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434dc_Oblivion_RESP1"
msgid ""
"That Adventurer-Attractor-Thingy is working again. You know what's attracting "
"me? The Skooma!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000825f6_Oblivion_RESP1"
msgid "That Amiable Fanriene is afraid of his own shadow."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e85_Oblivion_RESP1"
msgid ""
"That Bloodmane Cave gang had an assassin and a high-level mage? Our gold "
"soldier is a regular hard horse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c215_Oblivion_RESP1"
msgid ""
"That Danus Artellian is a little too full of himself. Sure, he's a Captain of "
"the Guard, but I'm not impressed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00046615_Oblivion_RESP1"
msgid ""
"That Delphine Jend seems dangerous to me. She's very skilled, but I think "
"she's reckless."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003aaab_Oblivion_RESP1"
msgid ""
"That Else God-Hater sure has a chip on her shoulder. Great with a blade, but "
"she really holds a grudge against the church."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434c6_Oblivion_RESP1"
msgid ""
"That Gatekeeper is tough. He's still alive. He killed that adventurer trying "
"to get in. So, we're all still perfectly safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_0000c059_Oblivion_RESP2"
msgid ""
"That Gray Cowl he wears was stolen from Nocturnal herself. Can you imagine "
"having the nerve to steal from a Daedric Lord?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003e97f_Oblivion_RESP1"
msgid ""
"That Gruiand Garrana is really full of herself. She'll talk your ear off, if "
"you let her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00029681_Oblivion_RESP1"
msgid ""
"That Honditar sure knows his way around this area. Have you spoken with him "
"recently?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e7f_Oblivion_RESP1"
msgid ""
"That Maglir is probably parked in some tavern. I never did like that eight-"
"pint hero."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00025583_Oblivion_RESP1"
msgid ""
"That Modryn Oreyn has got no sense of humor. Hell of a warrior, though. No "
"wonder he's done so well in the Fighters Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00078164_Oblivion_RESP1"
msgid ""
"That Museum of Oddities is a joke, although I hear Una Armina will pay for "
"certain items."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d292_Oblivion_RESP1"
msgid ""
"That Oblivion Gate threatened us all, yet only you took action to destroy it. "
"You have my thanks, Hero."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003dfcb_Oblivion_RESP1"
msgid ""
"That Ra'qanar seems a bit shady to me. He does a good job on the horses at "
"the castle, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000152e5_Oblivion_RESP1"
msgid ""
"That Raiment's getting a little tight on you, Brawler! I think you need some "
"exercise! What do you say? Ready for a match?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004350e_Oblivion_RESP1"
msgid ""
"That Resonator is up and running again. It traps adventurers like the disease-"
"infected rats that they are."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043514_Oblivion_RESP1"
msgid ""
"That Resonator keeps adventurers trapped until they die. Lots of bones in "
"there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000255b7_Oblivion_RESP1"
msgid ""
"That Rimalus Bruiant sure loves his dogs. A little too much, if you ask me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434f9_Oblivion_RESP1"
msgid ""
"That Xedilian place just sounds positively stuffed with Oddities. Surely "
"something could be spared for my museum?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_lightthedragonfires_000223e4_Oblivion_RESP6"
msgid ""
"That a false heir might be crowned... that the test of the Great God might "
"have failed... My heart fails me. It is unthinkable. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23AccuseRoland_0001d4b1_Oblivion_RESP1"
msgid ""
"That bastard! Seridur dares accuse me of being a vampire? Me?! Ha! He's the "
"one who is the vampire!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FingersoftheMountain_000236e5_Oblivion_RESP3"
msgid ""
"That book requires a great deal of care and security. I hope I am making "
"myself clear."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_0001ee40_Oblivion_RESP2"
msgid ""
"That buffoon, Hieronymus Lex, has invaded the Imperial City Waterfront. "
"Imperial Watch guards from all over the city prowl the streets."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Brothers_00084a9e_Oblivion_RESP1"
msgid ""
"That can't be. I don't have a brother. I mean, I never knew my real family. "
"Who did you say you were again?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008151c_Oblivion_RESP1"
msgid ""
"That cat beggar is following me! He's going to eat me, I just know it. Don't "
"look! He's standing right over there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00072dad_Oblivion_RESP1"
msgid ""
"That cat beggar is following me! He's going to eat me, Lord Sheogorath, I "
"just know it. Don't look! He's standing right over there."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE09AuthorityMyOwnFemale_00081dac_Oblivion_RESP1"
msgid ""
"That confirms it. You're the new Duchess. The stink of hubris surrounds you! "
"My Lord allows you to lick his boot straps, does he?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034511_Oblivion_RESP1"
msgid ""
"That could have gone smoother. Can't say I minded killing a few more of these "
"bastards, though. Get the book and let's get out of here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06Story_00002b0d_Knights_RESP3"
msgid "That curse still lingers on today, in fact. Poor Kellen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00086065_Oblivion_RESP4"
msgid "That day, I became a knight, and swore a knight's oath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StolenGold_0005371d_Oblivion_RESP2"
msgid ""
"That fetcher of a guard Tyrellius is always trying to be sneaky.  Well, you "
"can forget it. Tell him it isn't going to work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS09YourAmulet_0005377c_Oblivion_RESP1"
msgid ""
"That fetcher. He knows this is the only heirloom I have left from my family. "
"Only he would stoop so low."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04AlessiaCaro_00035fb8_Oblivion_RESP2"
msgid ""
"That filthy Argonian actually had the temerity to try and ransom it to me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f202_Oblivion_RESP1"
msgid ""
"That flesh monstrosity that patrols the Fringe has been rebuilt. Better to "
"let it stay dead if you ask me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00082605_Oblivion_RESP1"
msgid "That fool Big Head is always looking for the Fork of Horripilation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000441ce_Oblivion_RESP1"
msgid ""
"That giant torch is on fire now. Great. The thing's likely to fall over and "
"land on somebody. Me, probably. It's not safe walking around anymore."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0006155a_Oblivion_RESP1"
msgid ""
"That good-for-nothing husband's going to be very surprised if he crawls back "
"here. Very surprised."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b592_Oblivion_RESP1"
msgid "That guy asks way too many questions."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThoronirTopic_0000bc95_Oblivion_RESP1"
msgid ""
"That guy is going to run me out of business soon. His prices are so low, I "
"don't know how he does it. I think he's up to something."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11HistoryChanged_00022e8b_Oblivion_RESP3"
msgid ""
"That has been undone. If you go to the Imperial City, you will find that the "
"Thieves Guild has a guild hall on the site of the ruins of Dareloth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000151f6_Oblivion_RESP3"
msgid ""
"That helps the odds, but not much. We're still going to be outnumbered. "
"Follow me; I'll show you what we're up against."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028f4c_Oblivion_RESP3"
msgid ""
"That high-born little worm won't get away with this! He'll pay with his life! "
"Come on, you watch my back. I'm going to take Primo down!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14TruepaintTopic_0001c1c6_Oblivion_RESP5"
msgid ""
"That injured man was my father. He passed the Brush on to me, and I intend to "
"pass it along to my kin one day. Did you want to know how it works?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38DSNo_000be418_Oblivion_RESP1"
msgid ""
"That is a relief... I was sure... but you have proved yourself... "
"trustworthy. A friend indeed!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FollowupPositive_00024225_Oblivion_RESP1"
msgid "That is good news."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06Accept_00002de2_Oblivion_RESP1"
msgid "That is good. Go to Skingrad. The trail starts there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07accept_0000c019_Oblivion_RESP1"
msgid ""
"That is good. Remember, this is a mission of stealth, not blood. Your payment "
"will be higher than normal to cover the expense of the forgery."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22SrazirrNotEnough_0002c81f_Oblivion_RESP1"
msgid ""
"That is not the right answer. S'razirr knows you have been paid by Umbacano. "
"Oh yes, this one has listened much since we met at Malada."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGEmperor03_0002ad14_Oblivion_RESP3"
msgid "That is not what you will be remembered for."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetGreetA1_00002aad_Knights_RESP1"
msgid "That is usually best left to the gods to judge."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45ForkTopic_00078789_Oblivion_RESP3"
msgid ""
"That is when Big-Head came here. Master brought me! Whispered shouts into my "
"ear! Songs of Madgods! Songs of bad gods! Softly, Master. Softly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002fd92_Oblivion_RESP2"
msgid ""
"That is why I have sent for you. I'm afraid there is a... situation. The time "
"has come to test both your skill and your loyalty to Sithis. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark01Choice2C_00022ba1_Oblivion_RESP4"
msgid ""
"That is why I stand here before you. I bear an offering. An opportunity... to "
"join our rather unique family...  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ScarTailTopic_00035593_Oblivion_RESP7"
msgid ""
"That is why you must go to Bogwater and eliminate that treacherous snake! "
"Please kill Scar-Tail, so Ocheeva and I can put this matter behind us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS10WhatAboutLLev_0003c2c4_Oblivion_RESP2"
msgid "That is, if we could sober him up for five minutes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE41Catch_0006d604_Oblivion_RESP2"
msgid ""
"That is, unless someone like yourself could help me find the cure. But no one "
"has taken me up on my offer, even with the promise of a reward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS09ImIn_00053724_Oblivion_RESP4"
msgid ""
"That is, until last year. Jorundr started to take risks and began robbing "
"more dangerous targets. Not just lone merchants, mind you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VelwynBenirusTopic_00009273_Oblivion_RESP1"
msgid "That layabout? You can find him wasting time at The Count's Arms."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028d34_Oblivion_RESP2"
msgid ""
"That little Dark Elf urchin killed three people in cold blood, and now she's "
"going to try to kill us! We can't let that happen!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028197_Oblivion_RESP1"
msgid ""
"That little tramp is as guilty as sin, you hear me? She's the killer, and if "
"we don't keep our eyes on her she'll do it again!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035f37_Oblivion_RESP2"
msgid ""
"That looks important, whatever it is. I think you've really found something!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity7_00081e8b_Oblivion_RESP3"
msgid ""
"That looks just like one I used to have. Or maybe I saw it in a book... in "
"any case, I wish I could afford to buy it from you, but...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00062444_Oblivion_RESP1"
msgid ""
"That looks like the armor I asked for. Well done. That wasn't so hard, was it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE35Brithaur_0007866e_Oblivion_RESP1"
msgid ""
"That lout? Yes, he's a thorn in my side that never seems to go away! I'd have "
"his heart on a plate if I could!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00003a6b_Oblivion_RESP1"
msgid "That manor is still for sale if you're interested."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_000251c7_Oblivion_RESP1"
msgid ""
"That manservant is going to squash you like a bug! I can't wait to see what's "
"left of you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10JaksDiarySays_00015313_Oblivion_RESP2"
msgid ""
"That master thief died sometime shortly after stealing the Gray Cowl and "
"receiving Nocturnal's curse."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalk2_00002bae_Knights_RESP1"
msgid "That matter we discussed before. The lich lord? We need to act. Soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028cd5_Oblivion_RESP1"
msgid ""
"That mead-swilling barbarian killed those two people, I'm sure of it! I don't "
"have the proof just yet, but I'm watching him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD04Choice2_0002ee6f_Oblivion_RESP1"
msgid ""
"That means a lot, coming from you. You think I didn't hear about you ratting "
"me out to Oreyn? Now get out of here before my friend and I get angry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008585d_Oblivion_RESP2"
msgid ""
"That means the killer has been inside with us all along. You and I aren't "
"murderers, so that leaves one person! It's Nels the Naughty!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028bee_Oblivion_RESP2"
msgid ""
"That means the killer has been inside with us all along. You and I aren't "
"murderers, so that leaves one person! We must prepare to defend ourselves! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AzaniBlackheartTOPIC_0002c615_Oblivion_RESP1"
msgid ""
"That mission was the start of it. That was when Vitellus was killed. We were "
"contracted by a wizard, Argoth, to recover an artifact from Blackheart. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47AleswellInvisible_0003003d_Oblivion_RESP3"
msgid ""
"That must have been what all the shouting was about a few weeks ago. I'm "
"afraid I was engrossed in an experiment that required my full attention."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05OntusVanin_0000a250_Oblivion_RESP1"
msgid ""
"That name sounds familiar. Something to do with the Arcane University. Most "
"wizards live somewhere in the Imperial City."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BOASTDISLIKE_0018b2b3_Oblivion_RESP1"
msgid "That never happened."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00042dac_Oblivion_RESP1"
msgid ""
"That newcomer... I know I heard his name the other day, but I can't seem to "
"remember...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterFail_0006201a_Oblivion_RESP1"
msgid "That offer's not good enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028a02_Oblivion_RESP1"
msgid ""
"That poor boy didn't deserve to die. He was rich! He had no business even "
"being here, looking for treasure that might not even exist."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDRumorsUmaril_00002bc8_Knights_RESP1"
msgid ""
"That prophet in Anvil says that some evil Ayleid king is behind it. Umaril or "
"somesuch. Seeking revenge from beyond the grave, he says!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028f4c_Oblivion_RESP2"
msgid ""
"That rich little bastard lured us all here by appealing to our greed! Don't "
"you see? He considers us all low class, and wants us exterminated!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Nirnroot_0004e93c_Oblivion_RESP1"
msgid ""
"That root seems to have strange properties the likes of which I've yet to see "
"duplicated in other flora of its ilk. Hmmmm..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterSellItem_000091dc_Oblivion_RESP1"
msgid "That seems a fair price."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterSellItem_00061c5e_Oblivion_RESP1"
msgid "That seems fair to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterSellItem_00061c60_Oblivion_RESP1"
msgid "That seems fair to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterBuyItem_000620bd_Oblivion_RESP1"
msgid "That seems like a fair exchange."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061408_Oblivion_RESP1"
msgid "That should deter unwanted guests."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AAnyaHelp_00014026_Oblivion_RESP2"
msgid "That should help you to get in there a bit easier."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_000617d1_Oblivion_RESP1"
msgid "That should keep Passwall safer. But what about the rest of us?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterBuyItem_00062115_Oblivion_RESP1"
msgid "That should satisfy you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CurrentEventsResponses_000c45a0_Oblivion_RESP1"
msgid ""
"That skooma trade is bad business, and the Renrijra Krin are just a bunch of "
"thugs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_0002879c_Oblivion_RESP1"
msgid ""
"That sniveling Legion dog must die! Do you understand me? He's the murderer! "
"He killed all those people! He must pay for what he's done!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BookResponses_000285b6_Oblivion_RESP1"
msgid "That sounds interesting. Perhaps I'll have to read it as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0018d2ba_Oblivion_RESP1"
msgid "That the best you can do?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03LewinC1Idle01_0008ea8d_Oblivion_RESP1"
msgid "That thing may be small but it looks mean. Let's get out of here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesStaff_0002c55b_Oblivion_RESP1"
msgid ""
"That thing? Soris keeps it locked in a chest, down in the basement. I don't "
"see why he's so careful with it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004420c_Oblivion_RESP1"
msgid ""
"That torch in New Sheoth is lit. Hopefully, that will burn off some of the "
"airborne germs. It won't get all of them, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NenalataTopic_000a944f_Oblivion_RESP1"
msgid ""
"That was a bad fix and no mistake. One of the worst I've ever been in. You "
"saved us both, my friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017690_Oblivion_RESP1"
msgid ""
"That was a good fight, Bloodletter. You really showed that Redguard who's "
"boss! Here's your take. Now go clean yourself up."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000607fb_Oblivion_RESP1"
msgid "That was close, but Sheogorath has won. I'd better get back to work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00062457_Oblivion_RESP1"
msgid "That was disappointing at best. I was hoping for more from you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrenusAstisJournal_00024292_Oblivion_RESP1"
msgid ""
"That was my job. They said it was in Fallen Rock Cave. You ever been in "
"there? Didn't think so. I'm not going back. Not for that kind of money."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000807b2_Oblivion_RESP1"
msgid "That was quite a battle. I hope you are uninjured."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028878_Oblivion_RESP1"
msgid "That was some good goblin bashing. What else you need?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDSirBerichTopic_00002c7a_Knights_RESP4"
msgid ""
"That was the end of the old Order. Many of Sir Berich's friends left with "
"him. I tried to hold the rest together, but it was no use."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5b9_Oblivion_RESP1"
msgid "That was the strangest book I've ever read."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000335dc_Oblivion_RESP1"
msgid "That wasn't so bad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11HaskillChoice6_00014b61_Oblivion_RESP1"
msgid ""
"That which is lost can be found again. There is one being in the Shivering "
"Isles who may be able to assist you in the construction of a new Staff."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07BribeBeggar_00015f18_Oblivion_RESP1"
msgid ""
"That will do. Look for a man known only as the Stranger. He lives here in "
"Anvil, near the Mages Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BRIBE_000622fd_Oblivion_RESP1"
msgid "That will get you something."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_000613ee_Oblivion_RESP1"
msgid "That will take care of pesky adventurers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilNQDResponses_0003c255_Oblivion_RESP1"
msgid ""
"That woman is a bit off-kilter. I don't even want to know what she's got in "
"her basement."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONEXIT_0018b2ef_Oblivion_RESP1"
msgid "That works for me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0004a24b_Oblivion_RESP1"
msgid "That would be Falcar's responsibility. Good luck."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06AmuseiDoingHere_0001531f_Oblivion_RESP1"
msgid "That would be me. I am so glad you are here to save me from the vampire!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ShadyDeal_0001e846_Oblivion_RESP1"
msgid "That you, Agarmir?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028185_Oblivion_RESP1"
msgid ""
"That young man has more nobility in his pinky finger than you have in your "
"entire body, you uncultured swine.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MazogatheOrcTopic_000860c1_Oblivion_RESP1"
msgid "That's 'Sir Mazoga' to you..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_00082621_Oblivion_RESP1"
msgid "That's Amiable Fanriene. He can barely sleep because of it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_000514b5_Oblivion_RESP1"
msgid "That's Dagail's responsibility. Speak with her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0004a249_Oblivion_RESP1"
msgid "That's Falcar's responsibility. He takes it very seriously."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArchMageTopic_0006a879_Oblivion_RESP1"
msgid ""
"That's Hannibal Traven. You'll find him in the Arch-Mage's Tower, in the "
"center of the University. For your sake, he'd better be expecting you..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_00082616_Oblivion_RESP1"
msgid "That's Mirili Ulven. I know she's always looking for help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlademasterTopic_00146853_Oblivion_RESP1"
msgid ""
"That's Owyn. He is in charge of the Arena. Arranges the fights, trains "
"combatants, that sort of thing. Been that way since Gaiden Shinji."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00051dc7_Oblivion_RESP1"
msgid "That's TWICE you hit me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BattleMatronTopic_0014685b_Oblivion_RESP1"
msgid ""
"That's Ysabel Andronicus, crabby old woman who sits over there. She's dear to "
"me, so if you wrong her in any way, I'll rip your damn liver out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BattleMatronTopic_00146859_Oblivion_RESP1"
msgid ""
"That's Ysabel. She's sort of the Arena den mother. She handles the logistical "
"stuff, as well as the training of the Grand Champion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeCuirass_000400bd_Oblivion_RESP1"
msgid ""
"That's a big chest you've got there. You need any help getting this thing on?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ADMIREDISLIKE_0006230f_Oblivion_RESP1"
msgid "That's a bit excessive, don't you think?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterSellItem_000091d0_Oblivion_RESP1"
msgid "That's a fair deal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterSellItem_00061c58_Oblivion_RESP1"
msgid "That's a fair deal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesStaff_0002c0cb_Oblivion_RESP3"
msgid ""
"That's a good deal, right? I wouldn't offer it to anyone else, just you. So "
"what do you say?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterBuyItem_000091c7_Oblivion_RESP1"
msgid "That's a good deal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterBuyItem_000620c4_Oblivion_RESP1"
msgid "That's a good deal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterSellItem_000091dd_Oblivion_RESP1"
msgid "That's a good deal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterSellItem_00061c59_Oblivion_RESP1"
msgid "That's a good deal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479f4_Oblivion_RESP8"
msgid ""
"That's a joke. I wouldn't eat one of these horses. Nothing wrong with them, "
"of course..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028273_Oblivion_RESP4"
msgid ""
"That's a lot of chances to fill your purse with coin. So what do you say: you "
"want to bet on a match?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38OddityDonate_00082425_Oblivion_RESP3"
msgid ""
"That's a lovely gesture! Thank you so much. Everyone will be so glad to have "
"the Ring back where it belongs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39Notebook_000781fd_Oblivion_RESP1"
msgid ""
"That's a private thing. Besides, someone stole it. Relan needs to step up "
"security around here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00022b3b_Oblivion_RESP1"
msgid "That's a real shame."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48Choice2C_0001e8ab_Oblivion_RESP1"
msgid ""
"That's a real shame. With just a little help, I think we would have a chance. "
"But I can't risk leaving the camp defenseless."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e82_Oblivion_RESP1"
msgid ""
"That's a sad mess out at Harlun's Watch. Little satisfaction in killing those "
"trolls, I'm afraid. Won't bring those folks back, will it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MurderNoCrime_0018d830_Oblivion_RESP1"
msgid "That's a shame."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14ChoiceHeard_0001b947_Oblivion_RESP3"
msgid ""
"That's a silly notion of course, but it just goes to show the attention to "
"detail Rythe uses when he paints."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NoComment_0002a39a_Oblivion_RESP1"
msgid "That's all I know about Kvatch."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05PostTortureGreet_00081af0_Oblivion_RESP2"
msgid "That's all I know. Nothing more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetD2A_00002c0b_Knights_RESP3"
msgid "That's all I remember. I hope it may help you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND07LathonGreetD2B_00002c09_Knights_RESP3"
msgid "That's all I remember. I hope it may help you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003c369_Oblivion_RESP1"
msgid "That's all I'll be needing you for. Stay and watch, but don't interfere."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23RalsaGreet_0001db1f_Oblivion_RESP4"
msgid "That's all he told me to say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD03Choice6_0002d732_Oblivion_RESP1"
msgid ""
"That's all. For now. Good job, though. You got Viranus home safe, and I think "
"it'll do him good. I'll pay him for the contract, and this for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BOASTLOVE_00062313_Oblivion_RESP1"
msgid "That's amazing!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity4_00079f53_Oblivion_RESP3"
msgid ""
"That's amazing! The pelvis of Pelagius III! An honored madman if there ever "
"was one!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06HelpAttackA4_00012cd1_Oblivion_RESP1"
msgid ""
"That's an excellent idea. They cannot refuse entry to an emissary of Lord "
"Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Gelebourne_0003844c_Oblivion_RESP3"
msgid ""
"That's apparently why the guards trust him so readily. They had gotten word "
"from Skingrad's city watch about Raynil and his so-called accomplishment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_causingtrouble_0002c7b0_Oblivion_RESP3"
msgid ""
"That's been the state of things since the Blackwood Company began moving in."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0008c214_Oblivion_RESP1"
msgid "That's better!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_COERCEHATE_0018b2ca_Oblivion_RESP1"
msgid "That's cute. You think I'm afraid of you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_COERCELIKE_00062326_Oblivion_RESP1"
msgid "That's enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081b75_Oblivion_RESP1"
msgid "That's enough. Really."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark04GuardsConvo_00095339_Oblivion_RESP1"
msgid ""
"That's exactly what I'm saying! But will the Captain listen? Noooo... \"We "
"must have a presence!\" \"The prison must remain secure!\""
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05SylKill_000139b2_Oblivion_RESP1"
msgid ""
"That's exactly what they'd be expecting. They'll have replacements lined up, "
"and then there could be even more of them surrounding me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Pillar_00035f3b_Oblivion_RESP2"
msgid ""
"That's fantastic! Not only can I tell Irlav we're back on track, but I can "
"happily say we did it without his help!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FollowupPositive_00024227_Oblivion_RESP1"
msgid "That's fine news."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEOdditiesTourNo_00081eb9_Oblivion_RESP1"
msgid "That's fine. Feel free to look around on your own."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Choice7_000b1678_Oblivion_RESP1"
msgid ""
"That's fine. I'll buy elsewhere. If you change your mind, you'll know where "
"to find me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Choice5_000b1675_Oblivion_RESP1"
msgid "That's fine. I'll find them elsewhere."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15RitualNotReady_00027e46_Oblivion_RESP1"
msgid ""
"That's fine. Make sure you have everything you need. There's no telling what "
"you'll find there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GenericBanditC_000a333b_Oblivion_RESP1"
msgid "That's fine. This one will kill you for free."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGDPost3_0006e2db_Oblivion_RESP1"
msgid ""
"That's fine. We'll still get some solid revenue, and pick up some new "
"recruits along the way. Not a bad strategy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0006b835_Oblivion_RESP1"
msgid "That's for my father!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d72_Oblivion_RESP1"
msgid "That's funny! I just thought I saw Sheogorath!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_00061518_Oblivion_RESP1"
msgid "That's good news."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECreatureResponses_00077c5d_Oblivion_RESP1"
msgid "That's good to know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c1ab_Oblivion_RESP1"
msgid "That's good to know. You can never be too careful."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_00061720_Oblivion_RESP1"
msgid "That's great for the city, but what about the settlements?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HappyReceive_00024251_Oblivion_RESP1"
msgid "That's great!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JOKELOVE_0018b2dd_Oblivion_RESP1"
msgid "That's great! How's it go again?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SadGeneral_00024276_Oblivion_RESP1"
msgid "That's horrible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FaelianTopic_0004cf8b_Oblivion_RESP2"
msgid ""
"That's in the Talos Plaza District, here in the Imperial City. I'd ask around "
"there, if I were you."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_0006142c_Oblivion_RESP1"
msgid "That's incredible. I didn't think it possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05PostTortureGreet_00089614_Oblivion_RESP3"
msgid "That's it. That's what you want, isn't it? Now leave me alone!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48Convo_0002483c_Oblivion_RESP1"
msgid "That's it? There's no one else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity11_00081e97_Oblivion_RESP3"
msgid ""
"That's just like one that's gone missing from my Museum. If only I had the "
"funds to replace it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JOKEDISLIKE_00062320_Oblivion_RESP1"
msgid "That's just not funny."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterFail_000091e0_Oblivion_RESP1"
msgid "That's just not reasonable."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_DLC06DahliaTopicFence_00016020_DLCThievesDen_RESP1"
msgid "That's just not reasonable."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_DLC06DahliaTopicFletcher_00016026_DLCThievesDen_RESP1"
msgid "That's just not reasonable."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_DLC06DahliaTopicQuarters_00016027_DLCThievesDen_RESP1"
msgid "That's just not reasonable."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_DLC06DahliaTopicSecurity_00016028_DLCThievesDen_RESP1"
msgid "That's just not reasonable."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_DLC06DahliaTopicStealth_00016029_DLCThievesDen_RESP1"
msgid "That's just not reasonable."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_DLC06DahliaTopicSupplier_0001602a_DLCThievesDen_RESP1"
msgid "That's just not reasonable."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_DLC06DahliaUpgradeTopic_00016031_DLCThievesDen_RESP1"
msgid "That's just not reasonable."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JOKEDISLIKE_0018b2d2_Oblivion_RESP1"
msgid "That's just stupid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_COERCEDISLIKE_0018b2c6_Oblivion_RESP1"
msgid "That's just talk."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SadGeneral_00024278_Oblivion_RESP1"
msgid "That's just terrible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c1c5_Oblivion_RESP1"
msgid "That's just what this town needs: another reckless mage."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlademasterTopic_00146854_Oblivion_RESP1"
msgid ""
"That's me, genius. Down here, I'm the boss. I don't care if the Emperor's "
"ghost is floating around. In the Bloodworks, he answers to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterSellItem_000091d9_Oblivion_RESP1"
msgid "That's more than I'd usually pay."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MazogaTalk06_00086572_Oblivion_RESP1"
msgid "That's my business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45DarMaTrader_000280b8_Oblivion_RESP1"
msgid ""
"That's my horse.  Owned it for years.  Now either buy something or get out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45BrethrenTopic_00028217_Oblivion_RESP1"
msgid "That's none of your concern, outsider."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_0008dca2_Oblivion_RESP1"
msgid "That's not Amiable Fanriene. Amiable loves tall walls."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONEXIT_00062305_Oblivion_RESP1"
msgid "That's not bad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01AmuseiComplain_000521c8_Oblivion_RESP1"
msgid "That's not fair!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AngerReceive_00024261_Oblivion_RESP1"
msgid "That's not possible!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONEXIT_000622ff_Oblivion_RESP1"
msgid "That's not quite good enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenBaurus_0000b1c5_Oblivion_RESP1"
msgid "That's not smart."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGSkingradAdrienne_00047462_Oblivion_RESP1"
msgid ""
"That's not surprising. Sometimes I wonder if she forgets to eat, being so "
"focused on that research of hers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05NoBribeBeggar3_00016253_Oblivion_RESP1"
msgid "That's not very motivational."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopicFalanu04_00038aa5_Oblivion_RESP1"
msgid "That's nothing compared to Morrowind. Thanks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseDecline_000531be_Oblivion_RESP1"
msgid "That's okay. I'm sure I can find a buyer soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BOASTDISLIKE_00062317_Oblivion_RESP1"
msgid "That's pretty far-fetched."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JOKELIKE_0006231e_Oblivion_RESP1"
msgid "That's pretty good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_InfoRefusal_00024599_Oblivion_RESP1"
msgid "That's privileged information. I'm sorry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05HerdirGreetChoice1_000805ea_Oblivion_RESP1"
msgid ""
"That's rather forward of you, don't you think? We've only just met and "
"already you're ordering me around..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JOKELOVE_0006231b_Oblivion_RESP1"
msgid "That's really funny."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEMiscQuestResponses_00082628_Oblivion_RESP1"
msgid ""
"That's ridiculous. I understand there's a Khajiit beggar that follows him "
"around, just to annoy him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONEXIT_0006230a_Oblivion_RESP1"
msgid "That's right! Exactly!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS49ChoiceExplain_00031d33_Oblivion_RESP1"
msgid ""
"That's right! They managed to close the castle gates just before we were "
"forced in here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028799_Oblivion_RESP2"
msgid ""
"That's right, I think Neville is the murderer. I can't prove it yet, but "
"he'll slip up, just you wait. Whatever you do, don't turn your back on him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45MissingDaughter_0002809d_Oblivion_RESP1"
msgid ""
"That's right, my daughter Dar-Ma never came back from Hackdirt. I'm "
"dreadfully worried something may have happened to her. Can you help?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05BaurusSewerB1_000a31c0_Oblivion_RESP1"
msgid "That's right. Everything depends on this. So don't screw it up."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033368_Oblivion_RESP1"
msgid ""
"That's right. I heard some of the guards talking. You're going to die in "
"here, \"High\" Elf! You hear me? You're going to die in here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE44Choice1_00078730_Oblivion_RESP1"
msgid ""
"That's right. I've been stockpiling supplies. Things I'll need to ride it "
"out... or survive when they come for me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_00027993_Oblivion_RESP1"
msgid ""
"That's right. It's a Breton name. I'll have you know the Petits are one of "
"High Rock's oldest and most respected noble families."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ratsTOPIC_00036625_Oblivion_RESP1"
msgid ""
"That's right. Rats. In my basement. And something has been killing them! It's "
"horrible. My poor babies! You must do something!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MaglirTOPIC2_0002ee6a_Oblivion_RESP1"
msgid ""
"That's right. The little vermin has defaulted on another contract. I need you "
"to go babysit him again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033343_Oblivion_RESP1"
msgid ""
"That's right. You're going to die in here. You hear me, Nord? You're going to "
"die in here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SadGeneral_00024273_Oblivion_RESP1"
msgid "That's so sad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity10_00081e93_Oblivion_RESP3"
msgid ""
"That's so strange. I got one of those just the other day. Sorry. Maybe you "
"can start your own collection of oddities, hmm?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c1b4_Oblivion_RESP1"
msgid "That's so typical for a mage."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FearGeneral_0002426b_Oblivion_RESP1"
msgid "That's terrible!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SadGeneral_00024270_Oblivion_RESP1"
msgid "That's terrible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000c42c3_Oblivion_RESP1"
msgid "That's the last of them!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateConv_00085293_Oblivion_RESP1"
msgid "That's the last of them! Come on!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateConv_000980b0_Oblivion_RESP1"
msgid "That's the last of them! Come on!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebd2_Oblivion_RESP1"
msgid "That's the last time you'll commit a crime in Bleaker's Way!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG06Choice1A_0001ceee_Oblivion_RESP1"
msgid "That's the spirit!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkUmaril4_00002c4b_Knights_RESP1"
msgid "That's the spirit! Well, duty calls."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00065555_Oblivion_RESP1"
msgid "That's three more that won't be reporting back to their Master."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FollowupNegative_00024233_Oblivion_RESP1"
msgid "That's too bad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09NoBribeBeggar_00015f20_Oblivion_RESP1"
msgid "That's too bad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity6_00081e87_Oblivion_RESP3"
msgid ""
"That's too bad. I already have one of those. Can't very well have two in a "
"Museum of Oddities, now can we?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PayGoldforCrime_00028cea_Oblivion_RESP2"
msgid "That's too bad. I was hoping you'd resist arrest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseDecline_0004f20e_Oblivion_RESP1"
msgid "That's too bad. I was so looking forward to you living in the city."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13SignetNo_000335ac_Oblivion_RESP1"
msgid ""
"That's unfortunate, but I understand how difficult it must have been in that "
"place."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03reject_00034e9c_Oblivion_RESP1"
msgid "That's unfortunate. Let me know if you change your mind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONEXIT_0018b2f0_Oblivion_RESP1"
msgid "That's very good!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Daedricshrine_0000344d_Oblivion_RESP1"
msgid "That's what Elante is studying. Make sure she's safe while she does it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD08Choice5_000a3456_Oblivion_RESP1"
msgid ""
"That's what I was getting ready to ask you. You were found unconscious on the "
"streets in Leyawiin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48Choice1B_0001e8ad_Oblivion_RESP1"
msgid ""
"That's what the Empire has come to. I doubt any of the other cities will be "
"sending us aid either. Every man for himself these days."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE42Skyboat_00073233_Oblivion_RESP2"
msgid ""
"That's what the calipers and tongs are for. I need them to keep the water "
"airborne."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Nibenese_0002ba40_Oblivion_RESP1"
msgid ""
"That's what we call folk from the eastern side of Cyrodiil. The old name of "
"the lowland part of Cyrodiil is Nibenay."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEAureals_00012cc1_Oblivion_RESP1"
msgid ""
"That's what we call ourselves. The most loyal and honorable servants of "
"Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Pillar_00035f51_Oblivion_RESP1"
msgid ""
"That's what we're calling it, only because we don't know what it really is. "
"Or was."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MartinD1_0009ce83_Oblivion_RESP8"
msgid ""
"That's what you did at Kvatch. It wasn't the gods that saved us, it was you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RolandJensericTopic_0001d24c_Oblivion_RESP6"
msgid ""
"That's when I realized he was a vampire. The Order needs to you to track him "
"and destroy him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BleakFlatsCaveTopic_0002d6e7_Oblivion_RESP2"
msgid ""
"That's where Erthor wound up, after Adrienne told him he couldn't practice in "
"the guild hall anymore. She probably doesn't even remember that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VampireTopic_0001d24b_Oblivion_RESP3"
msgid ""
"That's where you come in. We want you to slay this vampire and cleanse the "
"city of his filth before he can feed or kill again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECylarneTopic_000910d3_Oblivion_RESP1"
msgid ""
"That's where you're going to get the Flame of Agnon. Do you listen to "
"anything I say? Do your ears work? If not, I can find use for them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06HelpAttackA3B3_00012cd0_Oblivion_RESP1"
msgid ""
"That's why females command and males take orders. Come. Let us surrender to "
"the madness of battle!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e073_Oblivion_RESP2"
msgid ""
"That's why things are so peaceful here. Just look around... and there's a "
"town guard. Prevents all sorts of misunderstandings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HaderusGoldwineTopic_0002ad7e_Oblivion_RESP5"
msgid ""
"That's why we've got to get in there and make sure he's safe. We owe him our "
"allegiance, and besides, he'd do the same for any of us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MankarCamoranTopic_00022b3e_Oblivion_RESP2"
msgid ""
"The \"Commentaries\" are contemporary with Tiber Septim, over 400 years ago. "
"So he is unlikely to still be alive, although you never know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_00038ae5_Oblivion_RESP2"
msgid ""
"The 415 vintages were particularly good. The 399... well... a once-in-a-"
"lifetime experience... IF you can find a bottle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetSpeechAmulet_00002d1e_Knights_RESP1"
msgid ""
"The Al-Esh is near! Mother of the Empire! She weeps for fallen Cyrod and all "
"her children that call it home for truly she is the mother to us all!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003161a_Oblivion_RESP1"
msgid "The Altar of Arden-Sul awaits."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003b83b_Oblivion_RESP1"
msgid "The Altar of Arden-Sul awaits."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06ShoutDefendAltar_00055367_Oblivion_RESP1"
msgid ""
"The Altar of Despair is ours! But the battle is not over yet! Defensive "
"positions!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00054b77_Oblivion_RESP1"
msgid ""
"The Altar of Despair is ours! We'll hold our position here and cut the "
"remaining Mazken to pieces when they try to retake it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000826d5_Oblivion_RESP1"
msgid "The Altar of Rapture will be ours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06KanehFinalA_000400dd_Oblivion_RESP2"
msgid ""
"The Altars can only be kindled by the willing sacrifice of a Mazken or an "
"Aureal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06UlfriFinalA_000400e0_Oblivion_RESP2"
msgid ""
"The Altars which feed the Flame of Agnon can be kindled only by the willing "
"death of an immortal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CurrentEventsResponses_000c4544_Oblivion_RESP1"
msgid "The Altmer have powerful wizards. It could be a dangerous situation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ee26_Oblivion_RESP1"
msgid "The Amulet ... is it safe?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusA_0001e8e6_Oblivion_RESP4"
msgid ""
"The Amulet has power. Only a true heir of the Blood can wear it, they say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE44AmuletTopic_00078735_Oblivion_RESP1"
msgid ""
"The Amulet of Disintegration! Thank you! It's one of the keys to my safety in "
"the coming times."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusA_0001e8e6_Oblivion_RESP3"
msgid ""
"The Amulet of Kings is a sacred symbol of the Empire. Most people think of "
"the Red Dragon Crown, but that's just jewelry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02JauffreD4_0001e74f_Oblivion_RESP2"
msgid ""
"The Amulet of Kings is ancient. Saint Alessia herself received it from the "
"gods. It is a holy relic of great power."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AmuletofKingsTopic_0001efe4_Oblivion_RESP1"
msgid "The Amulet of Kings is the key to everything now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusH_0001e90d_Oblivion_RESP4"
msgid ""
"The Amulet of Kings must get to Jauffre at Weynon Priory. He'll know what to "
"do with it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_0001e706_Oblivion_RESP1"
msgid "The Amulet of Kings will be mine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ee25_Oblivion_RESP3"
msgid ""
"The Amulet of Kings! I fear that was the target of this attack. I kept it in "
"a secret room in Weynon House."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGEmperor20_00032682_Oblivion_RESP1"
msgid "The Amulet of Kings. It is the Empire's sacred emblem of rulership."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001e8dd_Oblivion_RESP2"
msgid ""
"The Amulet, where's the Amulet of Kings? It wasn't on the Emperor's body."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0bd_Oblivion_RESP1"
msgid ""
"The Anvil Mages Guild is proud to follow the example Hannibal Traven sets for "
"us: mastery and scholarship free of the dark arts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00062671_Oblivion_RESP1"
msgid ""
"The Anvil guild has made quite a name for itself under Carahil. Did you hear "
"about the recent murderer they caught?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_0004770b_Oblivion_RESP1"
msgid ""
"The Arboretum. That's where J'mhad likes to go. Always quiet, always green. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesGuildTopic_00062bd2_Oblivion_RESP1"
msgid ""
"The Arcane University has been here for nearly as long as the Mages Guild has "
"been in Cyrodiil. It has been our home for ages."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGHieronymusLex_00015f26_Oblivion_RESP1"
msgid ""
"The Arcane University is getting restless. They have not gotten their "
"Icestaff back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneUniversityTopic_0006a85b_Oblivion_RESP1"
msgid ""
"The Arcane University is the greatest repository of knowledge in all of "
"Cyrodiil. The privilege of admission is a goal every mage strives for. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneUniversityTopic_000473ec_Oblivion_RESP1"
msgid ""
"The Arcane University is the seat of the Mages Guild in Cyrodiil. Located in "
"the Imperial City, it houses the leaders of our guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG11ChoiceExplain_00033540_Oblivion_RESP3"
msgid ""
"The Arch-Mage has other reports of these gems being associated with "
"Necromancers, but we do not know why. We don't even know what they do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488c5_Oblivion_RESP1"
msgid ""
"The Archer's Paradox. Because a perfect arrow flies forever, and that's "
"impossible. I'm Daenlin, and I have no perfect arrows."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaTopic_00146851_Oblivion_RESP1"
msgid ""
"The Arena is the bloody jewel of the Imperial City. It's where all the best "
"fighters from all over the Empire come to test their skills."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624c6_Oblivion_RESP1"
msgid ""
"The Arena's faked. You think those guys are getting killed? Really? It's just "
"berry syrup and ham-acting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00082606_Oblivion_RESP1"
msgid "The Argonian Big Head is always searching for the Fork of Horripilation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FishermansRockTopicNo_000860d3_Oblivion_RESP1"
msgid ""
"The Argonian said Fisherman's Rock is north of Leyawiin on a point of land on "
"the east shore of the Niben. Take me there. Now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FishermansRockFollow_000860d7_Oblivion_RESP1"
msgid ""
"The Argonian says it's north of Leyawiin, about six hours walk, on the east "
"bank of the Niben. Let's get moving."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008dc30_Oblivion_RESP1"
msgid ""
"The Argonian, Big Head, is always searching for the Spoon of Horripilation. "
"Yeah, the Spoon of Horripilation. Certainly not a fork."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ09ArmorTopic_00026d5f_Oblivion_RESP4"
msgid ""
"The Armor has been there ever since. Before evil came to Sancre Tor, this "
"shrine was a place of pilgrimage for all Blades."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036645_Oblivion_RESP2"
msgid ""
"The Armor is in the Shrine of Tiber Septim, in the catacombs beneath the "
"ruins of Sancre Tor. A holy place, once."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ09ArmorTopic_000c4315_Oblivion_RESP2"
msgid ""
"The Armor is in the Shrine of Tiber Septim, in the catacombs beneath the "
"ruins of Sancre Tor. A holy place, once."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007be56_Oblivion_RESP2"
msgid "The Army of Reman is at our doorstep, and our supplies have dwindled."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11P3Specifics_0001fb70_Oblivion_RESP2"
msgid ""
"The Arrow of Extrication is the only way to unlock the final door. Take them "
"both."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007a01c_Oblivion_RESP1"
msgid "The Aureal are yours to command."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000914e2_Oblivion_RESP1"
msgid "The Aureal do not waste time chatting with mortals."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007a01a_Oblivion_RESP1"
msgid "The Aureal stand at the ready, sire."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06ShoutStartAttack_00054fa4_Oblivion_RESP1"
msgid ""
"The Aureals are beginning their attack! Show them no mercy! Today, Cylarne "
"shall finally belong to us!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00080d8b_Oblivion_RESP1"
msgid "The Aureals do not forget their friends."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06FlameAgnon_000131b4_Oblivion_RESP3"
msgid ""
"The Aureals hold Rapture, and are massing to attack us. But never fear, they "
"are no match for us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00080d91_Oblivion_RESP1"
msgid "The Aureals no longer defile holy Cylarne, thanks to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06UlfriRedeploy_00054fb4_Oblivion_RESP1"
msgid ""
"The Aureals think to take us by surprise! We will teach them what happens to "
"those who trifle with the Mazken! To the Underdeep!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000826d6_Oblivion_RESP1"
msgid "The Aureals will soon pay for their arrogance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06SidePassage_00012cbd_Oblivion_RESP2"
msgid ""
"The Aurmazl Kaneh wants to assault the altar down the main passage, but the "
"Mazken are expecting us to come that way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06GreetB1_0003e6bb_Oblivion_RESP2"
msgid ""
"The Aurmazl Kaneh would wish to speak to you at once. Proceed through this "
"door to our main encampment at the Altar of Rapture."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13MessengerB2_0005e37b_Oblivion_RESP2"
msgid ""
"The Aurmazl merely wants you to know that matters of the gravest import to "
"the Realm's security may be at stake."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDKnightsStartCombat_00002b4e_Knights_RESP1"
msgid "The Aurorans are drawing power from the Orb! Destroy it, quickly!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002926_Knights_RESP1"
msgid "The Aurorans are restored by the power of that orb!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkGarlas1_00002c49_Knights_RESP1"
msgid ""
"The Aurorans fought fiercely, but they were no match for our Commander that "
"day, let me tell you! They fell before his wrath like wheat!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13MessengerA2_0001a798_Oblivion_RESP2"
msgid ""
"The Autkendo merely wants you to know that matters of the gravest import to "
"the Realm's security may be at stake."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27CrownLindai_000a6575_Oblivion_RESP1"
msgid ""
"The Ayleid city of Lindai was a bitter rival to Nenalata, the city of the so-"
"called \"Last King of the Ayleids.\""
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00048915_Oblivion_RESP1"
msgid ""
"The Ayleid ruin of Anutwyll is nearby. I can spend a few days on site, then "
"return here for the comforts of home and my library."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DaedraShrineTopic_000981ff_Oblivion_RESP1"
msgid ""
"The Azura coven in the Jeralls north of Cheydinhal... nice folks. Nothing "
"like the blood-drinking Daedra worshippers everyone raves about."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DaedraCultTopic_00098200_Oblivion_RESP2"
msgid ""
"The Azura shrine north of town, up Lake Arrius way, for instance. I know a "
"Dark Elf there. Nothing evil about him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077c4e_Oblivion_RESP1"
msgid "The Baliwog are known to carry Swamp Fever."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077c4d_Oblivion_RESP1"
msgid ""
"The Baliwog is a dangerous little creature. Some say they grow up to be "
"Scalons."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077c4f_Oblivion_RESP1"
msgid "The Baliwog will return to the water to heal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008dc1e_Oblivion_RESP1"
msgid ""
"The Baliwog will stay away from the water. Water certainly doesn't heal them. "
"Nope, not at all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BattleMatronTopic_0014685a_Oblivion_RESP1"
msgid ""
"The Battle Matron serves as the Grand Champion's trainer and manager, among "
"other things. Plus, I get to keep Owyn in line. Works for me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RulesOfCompetition_00029ca8_Oblivion_RESP3"
msgid ""
"The Battle Raiment covers your entire body. You can use your own helmet, "
"shield, and weapon, so choose those items wisely."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RulesOfCompetition_00029ca8_Oblivion_RESP4"
msgid ""
"The Battle Raiment's already enchanted, so you can't muck with it. But aside "
"from that, anything goes. Magic, stealth... whatever you need to win. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006234c_Oblivion_RESP1"
msgid ""
"The Battle of Bruma was a great victory! The Mythic Dawn have learned that we "
"are not defenseless."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ00BrumaResponse_00062bf2_Oblivion_RESP1"
msgid ""
"The Battle of Bruma will surely go down in history as the turning point in "
"the Oblivion Crisis. Mark my words."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047674_Oblivion_RESP1"
msgid "The Best Defense! That's me, Maro Rufus! Light Armor! The very best!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaChampName4_00038b3f_Oblivion_RESP1"
msgid ""
"The Black Arrow, huh? I like it! Yeah, that'll do nicely. All right, it's "
"time to see if you're crazy good or just plain crazy. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002fd92_Oblivion_RESP3"
msgid ""
"The Black Hand has learned that the Dark Brotherhood has been infiltrated. By "
"whom, and for what purpose, we do not yet know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08FinChoice2A_00032be9_Oblivion_RESP1"
msgid ""
"The Black Hand has sanctioned the Rose of Sithis. It is a magic arrow "
"specifically enchanted to kill its target. In this case, Phillida."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002fdb3_Oblivion_RESP3"
msgid ""
"The Black Hand is most pleased with your progress. You have been invited to "
"share in secrets that few within the Dark Brotherhood even know exist."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SilencerTopic_0002fdb6_Oblivion_RESP1"
msgid ""
"The Black Hand is the Dark Brotherhood's ruling council. That hand consists "
"of four Speakers and one Listener. Four fingers and a thumb, as it were."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CovenantTopic_000272af_Oblivion_RESP3"
msgid ""
"The Black Hand is the ruling body of the Dark Brotherhood. It is made up of "
"one Listener and Four Speakers. Four fingers and a thumb, if you will."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624f2_Oblivion_RESP1"
msgid ""
"The Black Hand is trying to keep it very hush hush, but one of their own has "
"been assassinated! It would seem the Brotherhood has been infiltrated."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00009176_Oblivion_RESP1"
msgid "The Black Hand welcomes you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_0004767b_Oblivion_RESP1"
msgid ""
"The Black Horse Courier brings the news of the people to the people. We are "
"funded by the Empire, so our broadsheets are always free!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00066ccf_Oblivion_RESP1"
msgid ""
"The Black Horse Courier has a story about Rythe Lythandas. Here. Take my "
"copy. I'm done with it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_00047669_Oblivion_RESP1"
msgid ""
"The Black Horse Courier is run by three Khajiit brothers. They buy freelance "
"stories with an Imperial stipend, and give the papers away for free."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004767e_Oblivion_RESP1"
msgid ""
"The Black Horse Courier. Brothers Urjabhi and Ra'Jiradh, and I, Hassiri. We "
"bring the news of the Empire to the people of the Empire! Fast, fast!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HorseInquiry_0004f00f_Oblivion_RESP1"
msgid ""
"The Black horses of Cheydinhal are the finest in all of Cyrodiil! None are "
"faster and only the White horses of Anvil are stronger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e28_Oblivion_RESP1"
msgid ""
"The Blackwood Company gets the contracts because the Fighters Guild is coming "
"apart at the seams."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e26_Oblivion_RESP1"
msgid ""
"The Blackwood Company has a terrible reputation. But with the Fighters Guild "
"in trouble, who else is there?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_causingtrouble_0002ae34_Oblivion_RESP1"
msgid ""
"The Blackwood Company has taken that much of a foothold in Leyawiin. Those "
"sons of.... "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e25_Oblivion_RESP1"
msgid ""
"The Blackwood Company is gone. They were working high on Hist sap. That's why "
"there were so many terrible 'accidents'."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e3c_Oblivion_RESP1"
msgid ""
"The Blackwood Company is just plain mean. They've got a bad reputation, but "
"that won't hurt business in their line of work, will it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e2b_Oblivion_RESP1"
msgid ""
"The Blackwood Company is not popular, but they're still cheap and effective."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479cd_Oblivion_RESP1"
msgid ""
"The Blackwood Company is proud of our beastfolk heritage, and we are solely "
"owned and operated by Khajiit and Argonians."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e3e_Oblivion_RESP1"
msgid ""
"The Blackwood Company people are more hard-core than the fighters from the "
"Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e29_Oblivion_RESP1"
msgid ""
"The Blackwood Company seems to be winning the battle for mercenary contracts "
"in Cyrodiil, but I wouldn't count the Fighters Guild out just yet."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e41_Oblivion_RESP1"
msgid ""
"The Blackwood Company takes any job, no matter how tough. Fighters Guild is "
"more fussy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e22_Oblivion_RESP1"
msgid ""
"The Blackwood Company were taking bad hist from a sick tree. No wonder they "
"fought blood-mad and fearless."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ09ArmorTopic_00026d6e_Oblivion_RESP3"
msgid ""
"The Blades are as touchy as priests about relics of Tiber Septim, it seems!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTopic_00033df6_Oblivion_RESP1"
msgid ""
"The Blades are closely linked to the Order of Talos. We both serve Talos, of "
"course, and many of our brothers are former Blades."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQJoinBladesDuties_00037cef_Oblivion_RESP1"
msgid ""
"The Blades are sworn to the service of the Emperor, as the mortal "
"representative of the Dragon Blood of the divine Talos."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ12JauffreMartin_0007be91_Oblivion_RESP1"
msgid "The Blades are, as always, at your disposal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ09ArmorTopic_00026d5f_Oblivion_RESP3"
msgid ""
"The Blades built a shrine in the catacombs of Sancre Tor, on the spot where "
"Tiber Septim received the blessing of Akatosh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000227b5_Oblivion_RESP1"
msgid "The Blades have gotten the Emperor out of worse situations than this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialSewers_00022cf1_Oblivion_RESP2"
msgid ""
"The Blades have occasion to use them in our undercover work, as well as a "
"means to move around the city without attracting attention."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001efe0_Oblivion_RESP3"
msgid "The Blades saluting me and hailing me as Martin Septim..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_000476f5_Oblivion_RESP2"
msgid ""
"The Bloated Float on the Waterfront is cheap... and a bit too interesting for "
"my tastes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_00047742_Oblivion_RESP1"
msgid ""
"The Bloated Float rents beds. Only place on the waterfront. Cheap. And it's "
"safe. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00016ea6_Oblivion_RESP2"
msgid ""
"The Blood of Thadon has been consumed by Arden-Sul's will, and all of Mania "
"welcomes you with open arms."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007dbff_Oblivion_RESP2"
msgid ""
"The Blood of Thadon has been consumed by Arden-Sul's will, and all of Mania "
"welcomes you with open arms."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDBootsoftheCrusader_00002a40_Knights_RESP1"
msgid ""
"The Boots are safeguarded by Kynareth herself. You must be tested, and prove "
"yourself worthy to acquire them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000029ff_Knights_RESP1"
msgid ""
"The Boots of the Crusader have been given to a worthy knight, I understand. "
"He must have been very brave!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14Thief_0001bb32_Oblivion_RESP4"
msgid ""
"The Bosmer must have leapt into the painting, then painted guardians inside "
"to protect himself using the Brush of Truepaint."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MaglirTOPIC_0002428c_Oblivion_RESP1"
msgid ""
"The Bosmer? I've seen him at the West Weald Tavern. Been there for days, from "
"what I hear. Better go see him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00028755_Oblivion_RESP1"
msgid "The Brethren are restless."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_HackdirtStrangerResponse_000981de_Oblivion_RESP1"
msgid "The Brethren won't like it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00062bce_Oblivion_RESP1"
msgid "The Bruma guild hall has been decimated. Our hall could be next!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14MoreBrush_0001bb34_Oblivion_RESP1"
msgid ""
"The Brush allows the artist to paint from within a canvas. It opens a portal "
"into which the artist may enter to paint things life-sized."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaChampName2_00038b41_Oblivion_RESP1"
msgid ""
"The Butcher, huh? I like it! Yeah, that'll do nicely. All right, it's time to "
"see if you're crazy good or just plain crazy. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48IlendA1_001778cf_Oblivion_RESP1"
msgid ""
"The Captain is still holding the barricade? I figured I was the last one left "
"alive."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0018d2a3_Oblivion_RESP1"
msgid ""
"The Captain said you've been inside one of those Oblivion Gate things. Said "
"you knew how to destroy them. I sure hope you can help us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a848_Oblivion_RESP1"
msgid "The Captain's in charge. I'll follow his orders."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASanguineSpeech_000b121f_Oblivion_RESP1"
msgid ""
"The Castle Leyawiin is a dull, dreary place. The mistress is an especially "
"somber soul, and tomorrow she will hold another excruciating dinner party."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEChaliceofReversal_00043021_Oblivion_RESP1"
msgid ""
"The Chalice has altered the effects that Felldew has on you. You'll find that "
"it now provides minor benefits, without any of the withdrawal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e84_Oblivion_RESP1"
msgid ""
"The Chalice has been returned to Thadon. He should use it while there is "
"still time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEChaliceofReversal_00013384_Oblivion_RESP1"
msgid "The Chalice is in Dunroot Burrow. Haven't you been listening?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e92_Oblivion_RESP1"
msgid ""
"The Chalice is once again in its rightful place. And places are rightfully "
"mine. And Chalices. Right?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEChaliceofReversal_00082470_Oblivion_RESP1"
msgid ""
"The Chalice is one of the Duke's prized possessions. He has been at a loss "
"without it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ec5_Oblivion_RESP1"
msgid ""
"The Chalice of Reversal is back in Thadon's hands, I hear. Wonder if it could "
"be used as a blunt weapon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEThadonWaitingForever_000131d8_Oblivion_RESP5"
msgid ""
"The Chalice of Reversal is waiting for you. When I say you, I mean me, but "
"it's no difference to the Chalice. One ends up being the other."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEDunrootBurrowTopic_0001338b_Oblivion_RESP2"
msgid ""
"The Chalice, Felldew, Elytra... it's all connected. One without the others is "
"no good, poison. Oh, a rough road awaits you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001330c_Oblivion_RESP2"
msgid ""
"The Chalice, remember? Don't forget, because if I forget then no one will "
"remember, and it might cease to exist. Reality is fickle like that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ModrynOreynTOPIC_00098197_Oblivion_RESP1"
msgid "The Champion? He was on the second floor last I saw him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c993_Oblivion_RESP1"
msgid ""
"The Chapel has made enemies here in the past. The Nords prefer their dragon "
"Ysmir to our Father Akatosh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Enemy_0002d77c_Oblivion_RESP2"
msgid "The Chapel is cast down, and the faithful... my friends... all dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_00038aa9_Oblivion_RESP1"
msgid ""
"The Chapel of Julianos is always open for worship and contemplation. Perhaps "
"you should speak to Marie Palielle, our healer and Restoration trainer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0000080A_AltarESPMain_RESP1"
msgid ""
"The Chestnut Handy Stables now offers to protect your horse… seems handy "
"enough!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_0007be9b_Oblivion_RESP1"
msgid ""
"The Chestnut Handy Stables used to sell horses. But they're gone. Our horses. "
"All gone. Big mystery. No idea where they went. [burp]"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00054170_Oblivion_RESP1"
msgid ""
"The Cheydinhal Black horse is the finest in Cyrodiil. Take good care of him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006266e_Oblivion_RESP1"
msgid ""
"The Chorrol guild hall had an unpleasant visit recently, from someone who had "
"a grudge against Teekeeus."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13Gate_000329e9_Oblivion_RESP7"
msgid ""
"The City Watch and the Knights of the Thorn are always at odds. They think we "
"don't have what it takes, and Farwil wanted to show them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bc8f_Oblivion_RESP1"
msgid ""
"The Colovian Highlands are barren wastelands along the border with Hammerfell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bc90_Oblivion_RESP1"
msgid ""
"The Colovian Highlands? Near the Hammerfell border? No one lives there. "
"That's barren wastelands."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bcae_Oblivion_RESP1"
msgid ""
"The Colovians are proud of their reputation for being independent, rough, and "
"rebellious."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkRelics2_00002c6c_Knights_RESP1"
msgid ""
"The Commander has recovered the Boots! Kynareth smiles upon our endeavor, "
"there can be no doubt!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkRelicsShield_00002c60_Knights_RESP1"
msgid ""
"The Commander must truly be blessed with the wisdom of Julianos! Come, the "
"others will want to hear the good news."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000479ce_Oblivion_RESP2"
msgid ""
"The Company provides expert jihatt for selected customers. Very discreet."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG09Choice4C_00022bd9_Oblivion_RESP2"
msgid ""
"The Council has agreed to keep his nature a secret, and in exchange he "
"occasionally provides us with useful information."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00062bc9_Oblivion_RESP1"
msgid ""
"The Council has turned on Traven. Things couldn't possibly get any worse for "
"the guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000a0fb_Oblivion_RESP1"
msgid ""
"The Council is in complete disarray at the news of Mannimarco's presence in "
"Cyrodiil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_tasks_00035678_Oblivion_RESP1"
msgid ""
"The Council is investigating what happened at Wellspring Cave. Many of our "
"resources are devoted to the task, leaving our ranks spread thin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG12Choice1A_0000befd_Oblivion_RESP2"
msgid ""
"The Council of Mages has been aware of the increased Necromancer activity in "
"Cyrodiil for some time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00062bcc_Oblivion_RESP1"
msgid ""
"The Council of Mages has been dissolved. Arch-Mage Traven has been deserted. "
"He's all we have left."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00062bd6_Oblivion_RESP1"
msgid ""
"The Council of Mages has this Necromancer situation under control. They must, "
"or else we'd know about it, right?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneUniversityTopic_000473f2_Oblivion_RESP1"
msgid ""
"The Council of Mages meets there in the Imperial City. That's where the real "
"power of the guild lies."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00115edc_Oblivion_RESP1"
msgid ""
"The Council requires more time. Please, be patient. I will have work for you "
"soon enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624c8_Oblivion_RESP1"
msgid ""
"The Council runs the Arena to amuse the masses, and it pays for itself, with "
"all the fools who lose their shirts gambling."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00062681_Oblivion_RESP1"
msgid ""
"The Council seems very interested in this new group of Necromancers that has "
"sprung up. I wonder how things will play out."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG12TravenSomeone_000835f9_Oblivion_RESP2"
msgid ""
"The Council was initially reluctant to believe the information was reliable, "
"but with recent events, they have little choice but to trust it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d29e_Oblivion_RESP1"
msgid ""
"The Count always says that Leyawiin stands alone, but your actions proved him "
"wrong. Well done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c34a_Oblivion_RESP4"
msgid ""
"The Count and I thank you for helping bring Ulrich's hold on Cheydinhal to an "
"end, and for doing so without unnecessary bloodshed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c339_Oblivion_RESP2"
msgid ""
"The Count and I thank you for helping bring Ulrich's hold on Cheydinhal to an "
"end, though we would have preferred having him brought up on charges."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_00091b41_Oblivion_RESP2"
msgid ""
"The Count appears for audiences in the County Hall near the throne weekdays "
"between 8 AM and 4 PM."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034475_Oblivion_RESP1"
msgid ""
"The Count appreciates your efforts, but as the vampires have not yet been "
"dealt with, he has no interest in seeing you at this time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00098122_Oblivion_RESP1"
msgid "The Count awaits within. Please, do not delay."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FawilTopic_00031c82_Oblivion_RESP2"
msgid ""
"The Count fears the worst, and has posted guards here so we can watch and see "
"if anyone comes back out. So far, nothing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035672_Oblivion_RESP2"
msgid "The Count has agreed to see you, but not here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00056e67_Oblivion_RESP1"
msgid "The Count has dispatched soldiers to Bruma, as he promised."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00056e68_Oblivion_RESP1"
msgid "The Count has dispatched soldiers to Bruma, as he promised."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00056e6b_Oblivion_RESP1"
msgid ""
"The Count has instructed me to tell you that he will be happy to speak to you "
"again once the Oblivion Gate threatening Skingrad is closed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_0018d301_Oblivion_RESP1"
msgid ""
"The Count has ordered the Guard to defend the city to the last man. There "
"will be no panic here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JanusHassildorTopic_0003567a_Oblivion_RESP1"
msgid ""
"The Count is a reclusive man, and sometimes difficult to see. Hopefully, your "
"status as a representative of the Guild will aid you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000748a4_Oblivion_RESP1"
msgid "The Count is on his way. Please, remain here and be patient."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00048902_Oblivion_RESP1"
msgid ""
"The Count is too preoccupied with his pastimes to spend time on county "
"affairs. So the burden lies on me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00056e69_Oblivion_RESP1"
msgid ""
"The Count left very specific instructions. He does not want to see you again "
"on this matter until the Oblivion Gate outside Skingrad is closed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00146005_Oblivion_RESP1"
msgid ""
"The Count made that Orc, Mazoga, into a knight? Well, well. Next thing, we'll "
"be making horses into knights."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00098121_Oblivion_RESP1"
msgid "The Count needs more time. He will see you when he is ready."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624a9_Oblivion_RESP1"
msgid ""
"The Count of Skingrad and I are not social intimates. In fact, I don't "
"believe Janus Hassildor has any social intimates."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624ed_Oblivion_RESP1"
msgid ""
"The Count of Skingrad is not all he seems. Let's just say I'm not the only "
"one who enjoys his evenings..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_0018d2a7_Oblivion_RESP1"
msgid ""
"The Count put the Guard on high alert. We'll be ready if the daedra decide to "
"attack, don't worry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00048907_Oblivion_RESP1"
msgid ""
"The Count used to be a great man, but power and idleness have spoilt him. "
"However, we remain loyal in memory of past kindnesses, and to serve Bravil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_000488bb_Oblivion_RESP1"
msgid ""
"The Count was once a tournament champion. Now he's a loafer and skirt-chaser. "
"And his son, Gellius, is a spoiled good-for-nothing skooma-sucker."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003cf89_Oblivion_RESP1"
msgid ""
"The Count went missing about ten years ago. No one knows what happened to "
"him. Lady Millona rules County Anvil. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_00154cde_Oblivion_RESP1"
msgid ""
"The Count went missing about ten years ago... but just recently he "
"reappeared. It's a bit of a mystery, but the Countess seems pleased."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038ab2_Oblivion_RESP1"
msgid ""
"The Count will not see you now. Not now, not ever. He sees no one. I'm "
"Mercator Hosidus, his steward. I believe that's all you need to know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003c1b3_Oblivion_RESP1"
msgid ""
"The Count's Arms is a very nice place for a meal. And Wilbur has an extensive "
"knowledge of wines."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DirectionsSleep_0018bd8e_Oblivion_RESP1"
msgid "The Count's Arms is next to the north gate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00146007_Oblivion_RESP1"
msgid ""
"The Count's been asking questions about some Orc named Mazoga at the "
"castle... she claims she's a knight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG09Choice4A_00022bd5_Oblivion_RESP1"
msgid ""
"The Count's unique nature is not public knowledge. The Council wishes to keep "
"it that way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e891_Oblivion_RESP1"
msgid ""
"The Count, Andel Indarys, is a Hlaalu parvenu, but his steward, Naspia Cosma, "
"does her best to coach him on the finer points of Imperial etiquette."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS10Count_0003c29b_Oblivion_RESP1"
msgid ""
"The Count? He could care less about our plight. As long as the roast suckling "
"pig is delivered to his feast table, he's as happy as can be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GreetingMazoga04_0009381f_Oblivion_RESP1"
msgid "The Count? Then I can talk to you. I'm Mazoga."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0b3_Oblivion_RESP1"
msgid ""
"The Countess deserves all the credit. I do things my way, indeed, but she "
"gives me the authority and support."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04DarkSecrets_0004f9ea_Oblivion_RESP2"
msgid ""
"The Countess has a secret passage somewhere in the basement that leads to her "
"private quarters. That's where the torture chamber is."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00097a6b_Oblivion_RESP1"
msgid ""
"The Countess has received word from Cloud Ruler Temple that grave matters are "
"afoot. Nothing else concerns her at the moment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c97e_Oblivion_RESP1"
msgid ""
"The Countess is Heartland Nibenean, and so are most guildsmen and chapelmen, "
"but most others are as Nordish as you'll find."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CountessCarvain_000980fa_Oblivion_RESP1"
msgid ""
"The Countess is in attendance from 8 in the morning until 6 in the evening "
"each day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CountessCarvain_00132aa2_Oblivion_RESP1"
msgid ""
"The Countess is in attendance from 8 in the morning until 6 in the evening "
"each day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CountessValga_000038cf_Oblivion_RESP1"
msgid ""
"The Countess is in attendance from 8 in the morning until 6 in the evening."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CountessValga_00159752_Oblivion_RESP1"
msgid ""
"The Countess is in attendance from 8 in the morning until 6 in the evening."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CountessCarvain_000980f9_Oblivion_RESP1"
msgid "The Countess is in attendance. Please observe proper etiquette."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CountessCarvain_00132aa1_Oblivion_RESP1"
msgid "The Countess is in attendance. Please observe proper etiquette."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CountessValga_000038d0_Oblivion_RESP1"
msgid "The Countess is in attendance. Proper etiquette is expected."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CountessValga_00159751_Oblivion_RESP1"
msgid "The Countess is in attendance. Proper etiquette is expected."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04AlessiasRing_0001e107_Oblivion_RESP1"
msgid ""
"The Countess is very happy to have her ring back. I don't think she has taken "
"it off for days. If you want to hear the whole story, talk to Hlidara."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04GivePick_00035fb7_Oblivion_RESP5"
msgid "The Countess rarely leaves the castle. Good luck getting it back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003481b_Oblivion_RESP1"
msgid ""
"The Countess seems much happier now that the item that was stolen from her "
"was returned."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0018d2a4_Oblivion_RESP1"
msgid ""
"The Countess sent Captain Burd to deal with that Oblivion Gate outside of "
"town. We're all praying that they'll be all right."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003481c_Oblivion_RESP1"
msgid ""
"The Countess still seems quite sad. I hear someone tried to find the item "
"stolen from the castle, but they had no luck. Oh well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ12JauffreMartin_0007be8e_Oblivion_RESP1"
msgid "The Countess will never agree to it..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002d77a_Oblivion_RESP2"
msgid "The Covenant is broken. The Enemy has won. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaChampName8_00038b3b_Oblivion_RESP1"
msgid ""
"The Crimson Blade, huh? I like it! Yeah, that'll do nicely. All right, it's "
"time to see if you're crazy good or just plain crazy. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27HerminiaC1_000a5604_Oblivion_RESP2"
msgid ""
"The Crown of the Ayleids which Umbacano wants is not simply an ancient work "
"of art."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000298e_Knights_RESP1"
msgid ""
"The Cuirass of the Crusader represents our greatest achievement as servants "
"of the Nine. We protect it, even in death. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_KvatchTopic_000039d7_Oblivion_RESP2"
msgid "The Daedra came out of the gate in the middle of the night."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04JyggalagTopic_00091018_Oblivion_RESP1"
msgid ""
"The Daedric Prince of Order, and the leader of the Greymarch. As I'm sure my "
"Lord told you, Jyggalag has always been a threat to this Realm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04SheoIntro1_0008245e_Oblivion_RESP1"
msgid ""
"The Daedric Prince of Order. Or biscuits... No. Order. And not in a good way. "
"Bleak. Colorless. Dead. Boring, boring, boring."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f427_Oblivion_RESP1"
msgid ""
"The Daedric armies are whole again. If only I could live to see them in "
"battle. The chills are getting worse, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PurificationTopic_0002fd9c_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood is an ancient organization. We have survived for "
"millenia. Sometimes, to ensure that survival, drastic measures are required."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_specialarrangement_000253d8_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood is not in the business of staging deaths, no matter how "
"much gold is offered. Sithis demands blood, and blood must be paid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_00086711_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out a Breton named Annabelle. She has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_00086712_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out a Breton named Evangeline. She has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_00086720_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out a Dark Elf named Hlanas. He has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_00086719_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out a High Elf named Alwaen. She has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_0008671d_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out a High Elf named Aranath. He has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_00086721_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out a Khajiit named Dahlima. He has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_00086716_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out a Khajiit named Shavari. She has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_0008671b_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out a Nord named Erich. He has need of our "
"services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_0008671a_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out a Nord named Sonje. She has need of our "
"services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_00086718_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out a Redguard named Rhiannon. She has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_00086713_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out a Wood Elf named Naarifin. She has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_0008671c_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out a Wood Elf named Urunil. He has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_00086717_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out an Argonian named Pasha. She has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_00086715_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out an Imperial named Avresa. She has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_00086714_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out an Imperial named Camilla. She has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_0008671f_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out an Imperial named Florentius. He has need "
"of our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_0008671e_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out an Imperial named Haderus. He has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_00086723_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out an Imperial named Severio. He has need of "
"our services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark19StatueTalk2_00086722_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood must seek out an Orc named Buramog. He has need of our "
"services, and we are only too happy to oblige."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0007c0a9_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood! They've actually murdered Adamus Phillida, the Imperial "
"Legion commander! It's in the latest Black Horse Courier. Here. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark05Convo_000282a6_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood? Oh, you have been a naughty boy, Motierre, haven't you? "
"Stand aside, assassin! Motierre is mine! My employers demand it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark17Choice4B_00054037_Oblivion_RESP1"
msgid ""
"The Dark Brotherhood? Okay! Okay! Here! Here's the key! Just don't hurt me! I "
"won't say a word, I swear!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChallengeDarkElf_0009f9b1_Oblivion_RESP1"
msgid ""
"The Dark Elves are my favored people. But I am fair-minded... the outcome is "
"in your hands."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10WellspringInfo_0001e971_Oblivion_RESP2"
msgid ""
"The Darkness is a frightening place, even to us, and so our Lord has given us "
"this beacon, a light to guide us back to Him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10WellspringInfo_00043027_Oblivion_RESP2"
msgid ""
"The Darkness is a frightening place, even to us, and so our Lord has given us "
"this beacon, a light to guide us back to Him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0001eee1_Oblivion_RESP1"
msgid "The Dawn is breaking!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000475b0_Oblivion_RESP1"
msgid ""
"The Dividing Line between a live hero and a dead one is a sharp sword. Get "
"the best you can afford from Tun-Zeeus..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003dfc4_Oblivion_RESP1"
msgid ""
"The Dividing Line is a good place to buy a sharp blade. Of course, you're "
"likely to hear some of Tun-Zeeus' stories if you hang around."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaChampName6_00038b3d_Oblivion_RESP1"
msgid ""
"The Divine Avenger, huh? I like it! Yeah, that'll do nicely. All right, it's "
"time to see if you're crazy good or just plain crazy. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00002a0e_Knights_RESP1"
msgid ""
"The Divine Crusader has returned, they say. None too soon, if you ask me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002982_Knights_RESP1"
msgid "The Divine Crusader herself! To what do I owe this honor?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002981_Knights_RESP1"
msgid "The Divine Crusader himself! To what do I owe this honor?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkDisappearances_00014e21_AltarDeluxe_RESP1"
msgid "The Divines are powerless to stop all these threats."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGDoyen_0001d4d4_Oblivion_RESP1"
msgid ""
"The Doyen are the eyes and claws of the guildmaster. As a hunter, you take "
"orders from them, and you get your favors from them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGDoyen_0001d4d2_Oblivion_RESP1"
msgid ""
"The Doyen are the hands and eyes of the guildmaster. You take your orders "
"from them. You get your favors from them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGDoyen_0001d4d3_Oblivion_RESP1"
msgid ""
"The Doyen are the hands and eyes of the guildmaster. You take your orders "
"from them. You get your favors from them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ06MankarSpeech_0001f875_Oblivion_RESP1"
msgid "The Dragon Throne is empty, and we hold the Amulet of Kings!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DragonfiresTopic_00033fc8_Oblivion_RESP2"
msgid ""
"The Dragonfires of Akatosh remain lit until the death of the Emperor. His "
"successor then lights them anew upon ascending to the throne."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004423f_Oblivion_RESP1"
msgid ""
"The Duchess of Dementia has been assassinated? Well, no need to finish her "
"portrait then."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SESylTopic_00044f56_Oblivion_RESP1"
msgid ""
"The Duchess of Dementia. Ever wary, ever worried. A prisoner in her own "
"House, in a way. And a delightful conversationalist, really."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04SheoLearnWhat_00044f54_Oblivion_RESP2"
msgid ""
"The Duke of Mania and the Duchess of Dementia. Seek them out, and let them "
"show you what New Sheoth is. You might be surprised."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005edfe_Oblivion_RESP1"
msgid ""
"The Duke of Mania has been assassinated? Well, no need to finish his "
"portrait, then...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_000476f1_Oblivion_RESP1"
msgid ""
"The Earl is perhaps not well known in the city. He is a private man, and "
"keeps to himself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00064465_Oblivion_RESP1"
msgid ""
"The Earl of Imbel was attacked and killed in his own home. I heard the body "
"burned in the sunlight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetSpeechMain_00002a6d_Knights_RESP1"
msgid "The Eight And One require a champion, a Divine Crusader reborn."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetSpeechMQ2_00002d17_Knights_RESP1"
msgid "The Eight and One favor only the righteous! And too few of you remain!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND09ProphetQuestions04_00002c9b_Knights_RESP2"
msgid ""
"The Eight created the Relics to withstand Umaril's fell power. Do not attempt "
"to face him without this divine protection."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElderCouncilTopic_000add4a_Oblivion_RESP1"
msgid ""
"The Elder Council Chambers are closed to the public for the duration of the "
"emergency."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624b7_Oblivion_RESP1"
msgid ""
"The Elder Council and the bureaucracy have managed the Empire's affairs for "
"decades. The Emperor rules, but the Council handles all the details."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElderCouncilTopic_00037833_Oblivion_RESP2"
msgid ""
"The Elder Council has been governing the Empire since the Emperor's murder. "
"They will be overjoyed to have an heir to crown."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElderCouncilTopic_000adc6a_Oblivion_RESP1"
msgid "The Elder Council rules in the Emperor's absence, by ancient tradition."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11P1WhatIsPlan_0001fb6e_Oblivion_RESP3"
msgid ""
"The Elder Scrolls are kept in the Imperial Palace behind a door that cannot "
"be breached.  Savilla's Stone has revealed a path around this door."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElixirofExploration_0004e946_Oblivion_RESP2"
msgid ""
"The Elixir of Exploration is a multi-purpose potion that was obviously "
"created with the dungeon explorer in mind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0000bcb4_Oblivion_RESP1"
msgid ""
"The Elves of the Imperial City are a fairly close-knit community. One of them "
"will have at least heard of Faelian. You should ask around."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077c45_Oblivion_RESP1"
msgid "The Elytra have wondrous poisons that can drain the very life from you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFelldew_00018b7e_Oblivion_RESP2"
msgid ""
"The Elytra in Dunroot Burrow, the ones that secrete it are immune, but "
"they're the only ones."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018b1fa_Oblivion_RESP1"
msgid ""
"The Emperor and his three sons, dead, right under the noses of the Imperial "
"Guard. It's a disgrace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018b2f6_Oblivion_RESP1"
msgid ""
"The Emperor is dead, and so are his heirs. We're a Legion without a leader. "
"The Blades were trusted with our Lord's protection... and they failed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ03MartinA2_00082dc8_Oblivion_RESP2"
msgid "The Emperor is dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MankarSpeech_0008b0a6_Oblivion_RESP10"
msgid "The Emperor is dead. The Amulet of Kings is mine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000178c7_Oblivion_RESP1"
msgid "The Emperor may trust you, but I don't. Stay out of our way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00015b94_Oblivion_RESP1"
msgid "The Emperor! I must get to the Emperor!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00062354_Oblivion_RESP1"
msgid ""
"The Emperor's death was a harsh lesson for all of us. We failed in our duty "
"to the Dragonborn. It must not happen again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk5_0018d7ff_Oblivion_RESP1"
msgid ""
"The Emperor's death was a harsh lesson to learn. We can never be too "
"vigilant. But now is the time for action, not talk. There is work to be done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTopic_00033df8_Oblivion_RESP1"
msgid ""
"The Emperor's elite knights. They dedicate themselves to Talos above and the "
"Septims here on earth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bab4_Oblivion_RESP1"
msgid ""
"The Emperor's heir lives! The bloodline is unbroken! Long live Martin Septim!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenBlades_00051d77_Oblivion_RESP1"
msgid "The Emperor's in danger!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02JauffreD1_00092d85_Oblivion_RESP4"
msgid ""
"The Emperor's words-- \"Close shut the jaws of Oblivion\"-- certainly suggest "
"that he perceived some threat from Oblivion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ04MartinEmperor_0001efe2_Oblivion_RESP1"
msgid "The Emperor... that's an idea that will take some getting used to."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk2_0018d7f0_Oblivion_RESP1"
msgid ""
"The Empire has been saved, but the Septim bloodline, it's... it's broken. "
"There is no Emperor. I can't help but feel a bit... obsolete."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ef4d_Oblivion_RESP1"
msgid ""
"The End is coming. You just wait, you'll see. Time to gather up your things "
"while you can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Enemy_0002d77c_Oblivion_RESP3"
msgid "The Enemy has won, and we are destroyed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00088b67_Oblivion_RESP1"
msgid ""
"The Eternal Garden is the testing ground for the new rulers of Tamriel. I "
"intend to pass the Master's test."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00088b35_Oblivion_RESP1"
msgid ""
"The Eternal Garden... I used to dream about coming here. The Master made it "
"sound so wonderful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS43Scamps_00094eca_Oblivion_RESP1"
msgid ""
"The Everscamp is unique. Not quite as powerful as a regular scamp, it can "
"barely use magic and is more of an annoyance than a threat."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32SiegeVitharn_0005a756_Oblivion_RESP1"
msgid "The Fanatics are about to break into the courtyard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32SiegeVitharn_0001b68f_Oblivion_RESP3"
msgid ""
"The Fanatics caught us by surprise, attacking out of the Reservoir, killing "
"the rear guard and opening the main gates. Now I do the dance of death."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32SiegeVitharn_0001b68d_Oblivion_RESP1"
msgid ""
"The Fanatics? What's to understand? They were just after my power. But it's "
"mine, all mine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00049927_Oblivion_RESP1"
msgid "The Feed Bag isn't fancy, but it fills you up."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008ef88_Oblivion_RESP1"
msgid "The Felldew is ours! You can't have it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e32_Oblivion_RESP1"
msgid ""
"The Fighters Guild got Azani Blackheart's ring. Not the Blackwood Company. "
"Apparently the Blackwood Company made the whole thing up."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e4a_Oblivion_RESP1"
msgid ""
"The Fighters Guild got Lady Rogbut out safe and sound. With the Blackwood "
"Company, you never know...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e42_Oblivion_RESP1"
msgid ""
"The Fighters Guild has competition in Leyawiin. Called 'The Blackwood "
"Company'. Very tough. Maybe too tough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e36_Oblivion_RESP1"
msgid ""
"The Fighters Guild hasn't actually defaulted on any contracts. But still, all "
"the confusion and delays are going to hurt them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FightersGuildTopic_00049973_Oblivion_RESP1"
msgid ""
"The Fighters Guild is a brotherhood of warriors. We provide a service to "
"Tamriel, lending steel and shield to those who need our help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e39_Oblivion_RESP1"
msgid ""
"The Fighters Guild is a family business. With Vitellus dead, Viranus is in "
"line to succeed his mother."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000255b1_Oblivion_RESP1"
msgid "The Fighters Guild is a good place to go if you need weapons training."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_jointheFightersGuild_0002427a_Oblivion_RESP1"
msgid ""
"The Fighters Guild is always looking for new members. If you've got a clean "
"record, and don't have a bounty on your head, we may be able to use you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DirectionsGuilds_0018bd8f_Oblivion_RESP1"
msgid ""
"The Fighters Guild is east, by the bridge to the castle. The Mages Guild is "
"south, by the bridge to the port."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00048908_Oblivion_RESP1"
msgid ""
"The Fighters Guild is good enough to encourage me in sharing the inner peace "
"and spiritual harmony of the martial arts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00061432_Oblivion_RESP1"
msgid ""
"The Fighters Guild is recruiting again. Not a bad way to make some money, if "
"you've got the stones for it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e3f_Oblivion_RESP1"
msgid ""
"The Fighters Guild needs to get aggressive if they're going to compete with "
"the Blackwood Company in Leyawiin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e52_Oblivion_RESP1"
msgid ""
"The Fighters Guild recovered the Stone of Alessia? I didn't know it was lost. "
"Is it magical or something?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e27_Oblivion_RESP1"
msgid ""
"The Fighters Guild still gets a little work from old friends, but the "
"Blackwood Company gets all the big contracts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e4f_Oblivion_RESP1"
msgid ""
"The Fighters Guild thing at Desolate Mine went perfectly, didn't it? They "
"cleared out the goblins, and no one got hurt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0003dfa0_Oblivion_RESP1"
msgid ""
"The Five Claws Lodge is a nice, clean place. Witseidutsei makes sure of it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinNQDResponses_0003de4f_Oblivion_RESP1"
msgid ""
"The Five Claws is a very clean place. Witseidutsei wouldn't have it any other "
"way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TenetsTopic_000272ae_Oblivion_RESP1"
msgid "The Five Tenets are as follows: "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PurificationTopic_0002fd9c_Oblivion_RESP3"
msgid ""
"The Five Tenets are the laws that guide and protect us. But, sometimes, even "
"they must be broken to protect the sanctity of our beliefs."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_000614a9_Oblivion_RESP1"
msgid "The Flame being re-lit is a good sign."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06FlameAgnon_00012cc8_Oblivion_RESP3"
msgid ""
"The Flame is fed from the Altar of Rapture and the Altar of Despair. Only "
"servants of Sheogorath can kindle the Altars."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06GreetB1_0003e6b7_Oblivion_RESP1"
msgid ""
"The Flame is lit from the Shrine's two Altars. Once the Aureals are driven "
"out of Cylarne, it will be our pleasure to light the Flame for Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06FlameAgnon_0003e6af_Oblivion_RESP3"
msgid ""
"The Flame is only lit at the command of Sheogorath, from the Altars of "
"Rapture and Despair within the Shrine itself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFlameofAgnonTopic_00019ad0_Oblivion_RESP1"
msgid ""
"The Flame of Agnon can only be lit by the immortal servants of Sheogorath: "
"the Golden Saints and Dark Seducers of His creation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008e659_Oblivion_RESP1"
msgid "The Flame of Agnon! Sheogorath's blessing upon you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06UlfriFinalC_000400e2_Oblivion_RESP2"
msgid "The Flame will be lit, by my Lord's command, not yours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BloatedFloat_00015726_Oblivion_RESP1"
msgid ""
"The Float has three decks. This deck is the inn deck, the next level up is "
"the tavern deck and then there's the top deck."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003d4d8_Oblivion_RESP1"
msgid ""
"The Flowing Bowl attracts the worst Anvil has to offer. Always be on your "
"guard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12FontofMadness_00017272_Oblivion_RESP1"
msgid ""
"The Font flows with the sap of the Tree of Madness, which it draws up from "
"deep beneath the palace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12HaskillGreetA1_00016cfe_Oblivion_RESP3"
msgid "The Font which is unaccountably covered with crystals."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15ForbiddenGrotto_00047360_Oblivion_RESP4"
msgid "The Forbidden Grotto is the only way out of the Savage Garden."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00078784_Oblivion_RESP1"
msgid ""
"The Fork for Big Head. Oh, where has Master put the Fork? It sings alone. Far "
"from home. Sad, sad Fork. Sad, sad Big-Head."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007877e_Oblivion_RESP1"
msgid "The Fork! Songs of bringing? The Fork for Big-Head?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45ForkTopic_00078789_Oblivion_RESP1"
msgid ""
"The Fork! The precious, precious fork! Hear how it sings to Big-Head! "
"Beautiful, perfect Fork of Horripilation!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12FontofMadness_00017272_Oblivion_RESP2"
msgid ""
"The Fountainhead leads down to the Pools of Dementia and Mania, where the "
"insanity of the Realm's inhabitants settles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ef04_Oblivion_RESP1"
msgid ""
"The Fringe attacked? This may be our last day alive. Let's make the most of "
"it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ef82_Oblivion_RESP1"
msgid "The Fringe can fend for itself. We have our own problems."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ef08_Oblivion_RESP1"
msgid "The Fringe gone. We're next. I'm sure of it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ef2c_Oblivion_RESP1"
msgid ""
"The Fringe has been attacked. I'm more than willing to help find out who's "
"responsible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ef1a_Oblivion_RESP1"
msgid ""
"The Fringe has been destroyed. Who knows what could happen next? I'll have to "
"work quickly to get my affairs in order."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ef1b_Oblivion_RESP1"
msgid ""
"The Fringe has been laid to waste! I do hope none of my poor children were "
"caught up in it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00045d2c_Oblivion_RESP1"
msgid "The Fringe is outside Lord Sheogorath's mercy... but not his justice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ef6e_Oblivion_RESP1"
msgid "The Fringe is under attack! Probably a cat conspiracy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005effc_Oblivion_RESP1"
msgid ""
"The Fringe was destroyed! Did you hear? Gone. Everything turned to dust! You "
"don't think that could happen here, do you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09HaskillGardens_0004036f_Oblivion_RESP4"
msgid ""
"The Gardens are in the Fringe, near Passwall. Beware, Your Grace. Creatures "
"of the sorceress' doing and undoing haunt those tunnels."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09HaskillGardens_0004036f_Oblivion_RESP1"
msgid ""
"The Gardens of Flesh and Bone are where Sorceress Verenim lived and worked "
"for many years."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434ac_Oblivion_RESP1"
msgid "The Gatekeeper dead. Can the rest of us be far behind?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_000613f7_Oblivion_RESP1"
msgid "The Gatekeeper dead. I didn't think it possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434ba_Oblivion_RESP1"
msgid "The Gatekeeper dead. Let's drink to the Gatekeeper!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_00061426_Oblivion_RESP1"
msgid "The Gatekeeper dead. That concerns me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f1f0_Oblivion_RESP1"
msgid ""
"The Gatekeeper has been reborn. I wonder if there are pieces left over...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f1ed_Oblivion_RESP1"
msgid ""
"The Gatekeeper has been rebuilt, which means the Realm is a little safer for "
"now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f1f6_Oblivion_RESP1"
msgid ""
"The Gatekeeper has been rebuilt. I wonder if I could get a little piece of "
"the old one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434e0_Oblivion_RESP1"
msgid ""
"The Gatekeeper has been slain. I bet he died of a disease. I hope someone "
"takes care of his corpse. Can you imagine how disgusting that will be?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434b4_Oblivion_RESP1"
msgid ""
"The Gatekeeper has been slain. That calls for a bit of Skooma, don't you "
"think? I need a fix of Skooma! Please! You got some Skooma?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434c4_Oblivion_RESP1"
msgid "The Gatekeeper has died. Wonder what got him. Collywobbles? Greenspore?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f1f5_Oblivion_RESP1"
msgid ""
"The Gatekeeper has returned to its former glory... Arden-Sul blesses us once "
"more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434b1_Oblivion_RESP1"
msgid ""
"The Gatekeeper is dead, you know. Now, that was a truly ugly creature. "
"Perhaps now a handsome adventurer will come to steal me away."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043503_Oblivion_RESP1"
msgid ""
"The Gatekeeper is dead. Did you kill him? You've got awfully sharp looking "
"teeth. Don't eat me. Please!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434f2_Oblivion_RESP1"
msgid "The Gatekeeper is dead. He's got really big bones."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434e6_Oblivion_RESP1"
msgid ""
"The Gatekeeper is dead. Just great. Who's going to protect us now? I sure "
"hope I don't have to move. I hate moving. It's depressing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434bf_Oblivion_RESP1"
msgid ""
"The Gatekeeper is dead. One more sign that the Realm is being run into the "
"ground. This never should've happened."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434cd_Oblivion_RESP1"
msgid ""
"The Gatekeeper is dead? Who will keep out the cats? They'll be everywhere!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0008e553_Oblivion_RESP1"
msgid ""
"The Gatekeeper is my child, the consummation of Sheogorath's wisdom in the "
"womb of my genius. It was a painful and bloody birth, but well worth it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434ad_Oblivion_RESP1"
msgid ""
"The Gatekeeper is no more. The Fork is missing. These are difficult times."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00012f37_Oblivion_RESP1"
msgid ""
"The Gatekeeper is slain. Congratulations. The honor of taking the keys from "
"his corpse is yours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f210_Oblivion_RESP1"
msgid ""
"The Gatekeeper is still dead. That's fine. He never did anything useful, "
"anyway."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f1ec_Oblivion_RESP1"
msgid ""
"The Gatekeeper protects us once again. But, can he protect us from the coming "
"horror?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000432cc_Oblivion_RESP1"
msgid "The Gatekeeper should take care of anyone who doesn't belong."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09HaskillGatekeeper_0004036a_Oblivion_RESP1"
msgid ""
"The Gatekeeper stood guard over the Realm, keeping those not blessed by "
"Sheogorath out... until you, Your Grace, slew him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03Xedilian_0006770c_Oblivion_RESP1"
msgid ""
"The Gatekeeper takes care of most of the unwanted, but he's dead. We'll have "
"to remedy that soon, as well...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f1e8_Oblivion_RESP1"
msgid "The Gatekeeper walks again. He'll help keep Sheer-Meedish safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081da8_Oblivion_RESP1"
msgid ""
"The Gatekeeper walks again. This is good. Now maybe Relmyna will be in a "
"better mood around here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f218_Oblivion_RESP1"
msgid ""
"The Gatekeeper walks once more, but what good does that do me? Who knows "
"what's already inside the Realm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043501_Oblivion_RESP1"
msgid ""
"The Gatekeeper was killed. Nobody asked me if I thought that was a good idea. "
"Well, I do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f212_Oblivion_RESP1"
msgid ""
"The Gatekeeper will keep out those adventurers again. Too bad. Some of them "
"had exciting stories to tell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434bb_Oblivion_RESP1"
msgid ""
"The Gatekeeper's been killed, I hear. Now who knows what new faces I'll get a "
"chance to mangle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434c3_Oblivion_RESP1"
msgid ""
"The Gatekeeper's been killed, you know. Uncle Leo is most distressed, but I'm "
"thrilled. Can't wait to find out who's behind it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434ce_Oblivion_RESP1"
msgid "The Gatekeeper's been killed. Now we're even more exposed to attack."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434c8_Oblivion_RESP1"
msgid ""
"The Gatekeeper's been killed. This is only the first step; they'll be coming "
"for me next."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_000807a3_Oblivion_RESP1"
msgid ""
"The Gatekeeper's dead. As soon as you get one of those doors unlocked, we can "
"go in. They're calling to me from in there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_000807a2_Oblivion_RESP1"
msgid "The Gatekeeper's dead. He won't stop us from coming and going now. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434fc_Oblivion_RESP1"
msgid "The Gatekeeper's dead. I hope I get to help rebuild a new one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434ca_Oblivion_RESP1"
msgid ""
"The Gatekeeper's dead. Must have had some curse or weakness. There always is. "
"Heroes kill monsters by exploiting a weakness."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02Gatekeeper_0007eaa3_Oblivion_RESP1"
msgid "The Gatekeeper's dead. Relmyna is very unhappy about that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434ab_Oblivion_RESP1"
msgid ""
"The Gatekeeper's dead? Probably got killed by the Gates of Madness falling "
"down on his head."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f238_Oblivion_RESP1"
msgid ""
"The Gatekeeper's return can only mean one thing... time to begin a new "
"painting of him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000434af_Oblivion_RESP1"
msgid "The Gatekeeper, dead! This could be the end for all of us!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001a11a_Oblivion_RESP1"
msgid "The Gates! The Gates! And...him!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_NDGauntletsoftheCrusader_00002b19_Knights_RESP1"
msgid ""
"The Gauntlets have been here far longer than any of us. I don't expect that "
"to ever change."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_NDGauntletsoftheCrusader_00002b14_Knights_RESP1"
msgid ""
"The Gauntlets were recovered by Sir Casimir. One of our few victories during "
"our time. But then even our victories became our failure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047672_Oblivion_RESP1"
msgid ""
"The Gilded Carafe, for all your alchemical needs. Claudette Perrick, service "
"with a smile."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00049956_Oblivion_RESP1"
msgid "The Gilded Carafe. A fine store with a terrible name."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077c3d_Oblivion_RESP1"
msgid ""
"The Gnarl are strange creatures. Hit them with a fireball, and they get "
"stronger, but they hate other elements even more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE12GnarlTopic_0001a325_Oblivion_RESP1"
msgid ""
"The Gnarls can help you. Those that have not been poisoned may be able to "
"reverse the spread of Order. Do not slay them heedlessly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ03Avenge_00189d07_Oblivion_RESP2"
msgid ""
"The Goblins must have been watching me, as they knew right when to strike. I "
"could hear Kayleen's screams from far away."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_0006178f_Oblivion_RESP1"
msgid "The Golden Saints will protect us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06GreetB1_0003e6b7_Oblivion_RESP2"
msgid ""
"The Grakedrig Ulfri will explain everything. You should speak to her at once."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022e8a_Oblivion_RESP1"
msgid ""
"The Gray Cowl is now yours. You are the new guildmaster of the Thieves Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGGrayFox_0003c16f_Oblivion_RESP1"
msgid ""
"The Gray Fox and I are closer than brothers. We share a desire to remain "
"unknown."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00071f6e_Oblivion_RESP1"
msgid "The Gray Fox appreciates all you've done for the guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StealNoCrime_0009838a_Oblivion_RESP1"
msgid "The Gray Fox dares to steal from Fathis Aren?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_TG08MethredhelDeliverMsg_00014700_Oblivion_RESP1"
msgid ""
"The Gray Fox has a task for you. Meet him at Helvius Cecia's house in Bruma."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09AmuseiDeliverMsg_00014824_Oblivion_RESP1"
msgid ""
"The Gray Fox has a task for you. Meet him at Malintus Ancus' house in Chorrol."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG02TaxesTopic_0003fd45_Oblivion_RESP3"
msgid ""
"The Gray Fox has always guaranteed protection to the poor of the waterfront. "
"He doesn't want to let this injustice stand. It's a matter of principle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_0001ee44_Oblivion_RESP1"
msgid ""
"The Gray Fox has asked me to take care of a problem, and I'm putting you on "
"it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GuardTalk1_0006fdd1_Oblivion_RESP1"
msgid ""
"The Gray Fox has been spotted! Some of the men gave chase, but he eluded "
"them. Don't worry, we'll bring that scoundrel in, no matter what it takes!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG02GrayFoxCare_0003fd47_Oblivion_RESP1"
msgid ""
"The Gray Fox has led our guild for over 300 years now. He has always "
"guaranteed protection to the poor of the waterfront."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG02WhoIsLex_0003fd46_Oblivion_RESP3"
msgid ""
"The Gray Fox has led our guild for over 300 years now. He has always "
"guaranteed protection to the poor of the waterfront."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_00014709_Oblivion_RESP2"
msgid ""
"The Gray Fox himself may call on you soon, though. Wait for contact from him. "
"Keep the guild fences busy. You can find your own work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000982db_Oblivion_RESP1"
msgid "The Gray Fox is hiding nearby. What do you know about him?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0009f913_Oblivion_RESP1"
msgid "The Gray Fox is inside."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000982de_Oblivion_RESP1"
msgid "The Gray Fox is waiting for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000982be_Oblivion_RESP1"
msgid "The Gray Fox is waiting for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000a9786_Oblivion_RESP1"
msgid "The Gray Fox is waiting inside."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_0001ee3e_Oblivion_RESP2"
msgid ""
"The Gray Fox is watching your career carefully. He may contact you soon with "
"a special job."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00064452_Oblivion_RESP1"
msgid ""
"The Gray Fox made a fool of Hieronymus Lex. While half the Watch was in the "
"Waterfront, thieves made off with half the rest of the city."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003c17a_Oblivion_RESP1"
msgid "The Gray Fox protects you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10AmuseiDeliverMsg_0001530b_Oblivion_RESP1"
msgid ""
"The Gray Fox requests a meeting. Please travel to Ganredhel's house in "
"Cheydinhal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG11AmuseiDeliverMsg_0001fb61_Oblivion_RESP1"
msgid ""
"The Gray Fox requests a meeting. Please travel to Othrelo's house in the "
"Imperial City Elven Gardens."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009f911_Oblivion_RESP1"
msgid "The Gray Fox seems very anxious to see you. Go inside."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00064445_Oblivion_RESP1"
msgid "The Gray Fox sounds like a dangerous thief."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07WhatIsPlan_000983a1_Oblivion_RESP3"
msgid ""
"The Gray Fox wants this list replaced with one that highly recommends "
"Hieronymus Lex. From Anvil he can do little harm to the guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaChampName10f_00038b38_Oblivion_RESP2"
msgid ""
"The Gray Prince is headed up to the Arena as we speak. Go up there and meet "
"him, one Champion to the next. May the Divines have mercy on your soul."
msgstr ""

