msgid "Have you prepared the Aureals?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017970_Oblivion_RESP1"
msgid ""
"Have you provided the soldiers with aid? We have little in the way of "
"supplies here. No healing. No restoration. "
msgstr ""

