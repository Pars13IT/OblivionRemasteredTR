msgid "Yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00038f2a_Oblivion_RESP1"
msgid "Yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003aab7_Oblivion_RESP1"
msgid "Yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003c349_Oblivion_RESP1"
msgid "Yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005c0c5_Oblivion_RESP1"
msgid "Yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000617c4_Oblivion_RESP1"
msgid "Yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00064d27_Oblivion_RESP1"
msgid "Yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000919a3_Oblivion_RESP1"
msgid "Yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000919bf_Oblivion_RESP1"
msgid "Yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00091a7d_Oblivion_RESP1"
msgid "Yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000980ce_Oblivion_RESP1"
msgid "Yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONENTER_0018b2e1_Oblivion_RESP1"
msgid "Yes?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03Reactivated_0008e94b_Oblivion_RESP1"
msgid ""
"Yes? Ah... silly me. The book has no pictures. Can't really expect you to "
"read that, now can I?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000aa092_Oblivion_RESP1"
msgid "Yes? Can I help you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007cf43_Oblivion_RESP1"
msgid "Yes? Change of heart? Do tell."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002e49_Oblivion_RESP1"
msgid "Yes? Do you have questions about your contract?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ac57_Oblivion_RESP1"
msgid "Yes? Do you require assistance?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004301d_Oblivion_RESP1"
msgid "Yes? Do you require assistance?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS21AyleidStatueTopic_0002b43f_Oblivion_RESP1"
msgid "Yes? Have you found another statue for me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00073024_Oblivion_RESP1"
msgid "Yes? How can I help you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001e400_Oblivion_RESP1"
msgid ""
"Yes? How may I assist you? I'd be happy to help, if helping you means helping "
"Thadon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00027fa1_Oblivion_RESP1"
msgid "Yes? How should I act?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BejeenTOPIC_00026abe_Oblivion_RESP1"
msgid "Yes? I am Bejeen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ee61_Oblivion_RESP1"
msgid "Yes? I assume you've spoken to that lout Maglir?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE40SleepOutside_000790b1_Oblivion_RESP1"
msgid ""
"Yes? I have idea for you. But first sweetroll for Fimmion. Sweetroll for "
"Fimmion, idea for you! Saa-WEET-ROOOOLL!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000a656b_Oblivion_RESP1"
msgid "Yes? Is there a problem?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002db92_Oblivion_RESP1"
msgid "Yes? Is there something I can help you with, Associate?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002e40_Oblivion_RESP1"
msgid "Yes? Is there something else I can help you with?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002dd9_Oblivion_RESP1"
msgid "Yes? Is there something you need?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000251c0_Oblivion_RESP1"
msgid "Yes? Is there something you need?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00072c8f_Oblivion_RESP1"
msgid "Yes? Is there something you require?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00072c94_Oblivion_RESP1"
msgid "Yes? Oh look, you have some pod pits! I need five of those myself. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SESheogorathTopic_00078caa_Oblivion_RESP1"
msgid ""
"Yes? Speaking to me? I'm he. He's me. And others, as well. Or, they were. "
"Weren't they?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035676_Oblivion_RESP1"
msgid "Yes? The Mages Guild, you say?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00033564_Oblivion_RESP1"
msgid "Yes? We should keep moving."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007cc43_Oblivion_RESP1"
msgid "Yes? Well, out with it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006edeb_Oblivion_RESP1"
msgid "Yes? What can I do for you, my tight-lipped friend?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036619_Oblivion_RESP1"
msgid "Yes? What can I do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00013566_Oblivion_RESP1"
msgid "Yes? What do you want? Out with it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001a112_Oblivion_RESP1"
msgid "Yes? What is it you want?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00090e2f_Oblivion_RESP1"
msgid "Yes? What news are you bringing me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_0001ac5a_Oblivion_RESP1"
msgid "Yes? What would you have me say about it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008e4cb_Oblivion_RESP1"
msgid "Yes? What'd I miss?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026a9e_Oblivion_RESP1"
msgid "Yes? Why do you not approach the Shrine?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000844bb_Oblivion_RESP1"
msgid "Yes? You have something of interest to me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e4be_Oblivion_RESP1"
msgid "Yes? You need my help, don't you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ09Retirement_00067dd3_Oblivion_RESP3"
msgid ""
"Yessir, I worked too hard to collect that money. I'm not about to let anyone "
"steal it from me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ09Retirement_000cbb73_Oblivion_RESP3"
msgid ""
"Yessir, I worked too hard to collect that money. I'm not about to let anyone "
"steal it from me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007b726_Oblivion_RESP1"
msgid ""
"Yessir, no more fish for me. Just long peaceful days ahead for ol' Aelwin "
"Merowald."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0007b727_Oblivion_RESP1"
msgid ""
"Yessir, no more fish for me. Just long peaceful days ahead for ol' Aelwin "
"Merowald."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_00032b04_Oblivion_RESP1"
msgid "Yessir."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS08UrsanneTell_0001f42b_Oblivion_RESP1"
msgid ""
"Yesterday, the usurer, Kurdan gro-Dragol, sent for my husband to meet him at "
"the Lonely Suitor Lodge. He hasn't returned since."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AmuletofKingsTopic_00033fcc_Oblivion_RESP4"
msgid ""
"Yet those gates to Oblivion existed. The old rules no longer apply. Kvatch is "
"only the beginning of what Mehrunes Dagon will do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00086085_Oblivion_RESP1"
msgid "Yield, slave!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00073016_Oblivion_RESP1"
msgid "Yikes! Get away from me you foul beast!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00042ff1_Oblivion_RESP1"
msgid ""
"Yikes! Get away from me you foul beast! Somebody help! A mountain lion has "
"gotten into the village!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043520_Oblivion_RESP1"
msgid ""
"Yikes! To bad that Resonator of Judgment doesn't get rid of troublesome "
"beasts. I bet you could swallow me whole, couldn't you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenVoice_00032b11_Oblivion_RESP1"
msgid "You ... I've seen you ..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047355_Oblivion_RESP2"
msgid "You ... how can you be here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0018bd68_Oblivion_RESP1"
msgid "You Elves are all the same! All flash and no fury!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_000488ba_Oblivion_RESP1"
msgid ""
"You MUST have a fast horse! Travel quickly to ruined forts and caves nearby! "
"It will pay for itself in precious time saved!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002a366_Oblivion_RESP1"
msgid "You MUST leave! If you don't, I'll call the guards!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ06Bears_0018afd5_Oblivion_RESP2"
msgid "You actually did it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GarridansTears_00022f11_Oblivion_RESP1"
msgid "You actually found them? Interesting. I'll have to make a note of that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038b31_Oblivion_RESP1"
msgid ""
"You again, huh? Look, I told you, if you want to challenge the Gray Prince "
"that's your right. But don't say I didn't warn you. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00029d5e_Oblivion_RESP1"
msgid ""
"You again, huh? So what is it this time? Better start talkin' before my sword "
"starts swingin'!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002b3d1_Oblivion_RESP1"
msgid "You again. Are you ready yet?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ee75_Oblivion_RESP1"
msgid "You again. Fine. I imagine you're looking for work from me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003b968_Oblivion_RESP1"
msgid "You again. Guess you're not afraid of catching it. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023ff3_Oblivion_RESP1"
msgid ""
"You again. Have you reconsidered? The offer still stands. Say the word, and "
"I'll tell you all about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ee5e_Oblivion_RESP1"
msgid "You again. I imagine I know why you're here, guild rat."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002d92c_Oblivion_RESP1"
msgid "You again. What is it this time?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00035758_Oblivion_RESP1"
msgid "You again?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000251ff_Oblivion_RESP1"
msgid ""
"You again? I thought I'd made it clear I'm not looking for a friend. If "
"you're here to buy or sell something, get on with it already!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003be82_Oblivion_RESP1"
msgid "You again? Make it quick. I have work to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001acd2_Oblivion_RESP1"
msgid "You again? Really?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038b34_Oblivion_RESP1"
msgid ""
"You again? You're becoming a real pain in my arse, you know that? I thought I "
"made myself clear. You don't belong down here. Now get!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002b106_Oblivion_RESP1"
msgid ""
"You ain't gonna stop until you hit Champion, are you? Well good! The Blue "
"Team needs as much glory as we can get!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002529b_Oblivion_RESP1"
msgid "You ain't one of me crew. What business ye be havin' here, mate?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_0004666b_Oblivion_RESP1"
msgid ""
"You almost have to feel bad for the Yellow Team's Khajiit, for the Blue "
"Team's Gladiator is a combatant you know and love! Let's see how they fare!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Manor_00003a60_Oblivion_RESP1"
msgid "You already bought the manor, and I have nothing more to say about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CureforVampirism_0005c2fd_Oblivion_RESP1"
msgid "You already have the cure. Shouldn't you be delivering that somewhere?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_00089530_Oblivion_RESP1"
msgid "You already know my part in this. There is nothing more to say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE14Benefits_0004b831_Oblivion_RESP4"
msgid ""
"You also have the ability to affect the weather in your Realm. As it is an "
"extension of yourself, it will often have an effect on you, as well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE14Benefits_0004b831_Oblivion_RESP3"
msgid ""
"You also have the benefit of Sheogorath's Protection. Cast this upon "
"yourself, and if your life is threatened, you will be returned to your castle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035e00_Oblivion_RESP3"
msgid ""
"You also managed to leave Phillida's severed finger as a warning to his "
"successor. Well done! Your bonus, 500 additional gold coins, is well earned."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQJauffreHelp_0005d2c7_Oblivion_RESP2"
msgid ""
"You also should talk to Prior Maborel and Brother Piner. I'm sure they will "
"help you in whatever way they can."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_0003e453_DLCThievesDen_RESP1"
msgid "You always bring in good business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d2a0_Oblivion_RESP1"
msgid ""
"You and Captain Burd sure gave them daedra a good kick in the teeth. I wish I "
"had been there to see it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008670f_Oblivion_RESP1"
msgid ""
"You and I are the only ones left, but we're not alone in this house. That "
"killer is in here with us, hiding. But where?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00092d87_Oblivion_RESP1"
msgid ""
"You and I are the only ones left. But we did it. We survived. We... we won!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08MothPriestNote_0001474a_Oblivion_RESP4"
msgid ""
"You and I have even met before, when I was not wearing the cowl. To your "
"clouded memory he and I are two different people."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000251d3_Oblivion_RESP1"
msgid ""
"You and I, we've got to stick together, eh? The others, they don't "
"understand. Orcs may not be quiet, but can anyone kill as well as us? Never!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0004f3e7_Oblivion_RESP1"
msgid "You and Maglir need to catch those thieves."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_00028180_Oblivion_RESP1"
msgid ""
"You and Nels... both still alive. One of you is a cold-blooded killer! I... I "
"never did trust that Nord...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_duties_0002d716_Oblivion_RESP1"
msgid ""
"You and Viranus are to go to Nonwyll and find out what happened to Galtus "
"Previa. Now get to it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002e587_Oblivion_RESP1"
msgid ""
"You and Viranus have business to attend to. Why are you wasting time here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05WhatIsPlan_0000c05d_Oblivion_RESP1"
msgid ""
"You and four other operatives will stage high profile thefts, all at the same "
"time. Hopefully that will force Lex to reassign the Watchmen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk4_0006834c_Oblivion_RESP1"
msgid ""
"You and the other Blades have extended me every courtesy. But please, don't "
"forget, I'm just a man. I need the company of friends, like any other."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062cef_Oblivion_RESP1"
msgid "You annoy even me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d149_Oblivion_RESP3"
msgid ""
"You answer a simple question, and I'll think about training you. So here it "
"is: What does the name Hazadir mean to you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE01HaskillChoice2_000133e1_Oblivion_RESP1"
msgid ""
"You approach the Shivering Isles. Through the door behind me lies the realm "
"of Sheogorath, Prince of Madness, Lord of the Never-There."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebd5_Oblivion_RESP1"
msgid "You approach the Shrine of Boethia. Tread lightly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026aa7_Oblivion_RESP1"
msgid ""
"You approach the Shrine of Clavicus Vile. You should not be here unless you "
"have business with Lord Clavicus."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebcf_Oblivion_RESP1"
msgid "You approach the Shrine of Hircine. Are you hunter, or are you prey?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebcc_Oblivion_RESP1"
msgid ""
"You approach the Shrine of Mephala. The Webspinner watches you, stranger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000251d9_Oblivion_RESP1"
msgid ""
"You are Argonian, yes, but you are no Shadowscale! What chaos you must have "
"known as a hatchling! Thank Sithis you have come home at last. Welcome."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Advancement_00188f41_Oblivion_RESP1"
msgid ""
"You are Conjurer no more. Guild members shall now address you as Magician. "
"Congratulations."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00091b45_Oblivion_RESP1"
msgid "You are Weebam-Na?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026ddf_Oblivion_RESP1"
msgid ""
"You are a breaker of Tenets, and have been eternally exiled from the Dark "
"Brotherhood! Begone from here, and never return!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGEmperor02_0002ad13_Oblivion_RESP2"
msgid ""
"You are a citizen of Tamriel, and you, too, shall serve her in your own way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001470c_Oblivion_RESP1"
msgid "You are a credit to the guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FromTheDead_0001e7e6_Oblivion_RESP1"
msgid "You are a damn fool."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000276a5_Oblivion_RESP1"
msgid ""
"You are a diplomat as well as a warrior, it seems! I would prefer more men, "
"of course, but if we must offer battle now, so be it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000356a6_Oblivion_RESP1"
msgid "You are a fool to be here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS31Minx02Negative_0001525a_Oblivion_RESP1"
msgid ""
"You are a liar! Lynch had specific instructions not to disturb me. Since you "
"came from below decks, you must have gotten past Lynch."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkDisappearances_00014e21_AltarDeluxe_RESP3"
msgid "You are a noble soul and a follower of the Nine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00094ebc_Oblivion_RESP1"
msgid ""
"You are a person of your word. You must hasten to Rosentia and tell her at "
"once!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGNoBloodPrice_0001c4e4_Oblivion_RESP1"
msgid ""
"You are a rogue hunter. Membership in the Thieves Guild is denied. Leave me "
"now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00071f6d_Oblivion_RESP1"
msgid "You are a skillful thief. The guild is lucky to have you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00014e87_AltarDeluxe_RESP3"
msgid "You are a true champion to the Nines and you shall be rewarded."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000bfa0_Oblivion_RESP1"
msgid "You are a welcome sight in these troubling times."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0000bf9b_Oblivion_RESP1"
msgid "You are a welcome sight!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ12GotStoneAlready_00026efc_Oblivion_RESP1"
msgid ""
"You are a wonder! Not only the Hero of Kvatch, but the Master of Miscarcand "
"as well!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0011cad6_Oblivion_RESP1"
msgid ""
"You are about to witness the glorious rebirth of Ayleid civilization. Stand "
"aside!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002957_Knights_RESP1"
msgid ""
"You are almost ready to confront your nemesis, Umaril. Do not allow yourself "
"to be led astray now, so close to victory."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00189d0c_Oblivion_RESP1"
msgid "You are always welcome at Harm's Folly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDBootsoftheCrusader_00002a45_Knights_RESP1"
msgid ""
"You are an asset to your Order. You have claimed the Boots, and for this I am "
"grateful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002910_Knights_RESP2"
msgid ""
"You are an embodiment of Pelinal Whitestrake, the bane of Umaril the "
"Unfeathered."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07LexReassigned_00098390_Oblivion_RESP2"
msgid ""
"You are being promoted to Shadowfoot, and may now use Orrin of Castle Anvil "
"as your fence."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DABoethiaChoice1_0001ec92_Oblivion_RESP1"
msgid ""
"You are brave. Or suicidal. Approach then, and make an offering. Boethia "
"demands a daedra's heart."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ClaudeMaricTopic_0002c525_Oblivion_RESP1"
msgid ""
"You are cautious and perceptive. Good traits to have in this business. Yes, "
"you guess correctly. This one is working for Maric."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32AcolyteWarning_0005a753_Oblivion_RESP1"
msgid "You are defiling this holy place!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00098382_Oblivion_RESP1"
msgid "You are dismissed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS21StatueGive_0002b51f_Oblivion_RESP1"
msgid ""
"You are doing very well in your treasure hunt, my friend. Only one more "
"statue remains to be discovered!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00025291_Oblivion_RESP1"
msgid "You are finding your contracts agreeable, I hope?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MankarCamoranTopic_00097cc2_Oblivion_RESP2"
msgid ""
"You are fortunate indeed, to have heard the Master preach at your initiation!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06GSWardenGreet2_00018dbb_Oblivion_RESP1"
msgid "You are fortunate that my duty forbids me from satisfying my honor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002955_Knights_RESP1"
msgid ""
"You are fortunate. A vision from the Divine Crusader himself is a sign of "
"high favor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG04Choice1A_0002ee4f_Oblivion_RESP3"
msgid "You are going to help me do so."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00014e87_AltarDeluxe_RESP4"
msgid ""
"You are hebery made a Paladin of the Hour and shall receive weapons and gear "
"befitting the hero of Akatosh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081da9_Oblivion_RESP1"
msgid ""
"You are here to help rebuild the Gatekeeper. That is very good of you... "
"considering what you did to him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00003999_Oblivion_RESP1"
msgid ""
"You are here to see the Count, yes? He has been expecting you. Please, wait "
"here. I shall inform him of your arrival."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22SrazirrPay_0002c820_Oblivion_RESP1"
msgid ""
"You are honorable. Unlike that renrij Maric, may the moons never shine upon "
"his path. This one will not forget."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15KathutetC1_0003e8f6_Oblivion_RESP1"
msgid "You are impertinent, mortal. I did not offer to answer questions."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0000a173_Oblivion_RESP1"
msgid "You are in good spirits today, milady"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VampireAshTopic_000977d8_Oblivion_RESP2"
msgid ""
"You are indeed a force to be reckoned with. I shall take the ashes; finally, "
"some part of him can be put to a good use."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TestToddNeutral_0002830b_Oblivion_RESP1"
msgid "You are indeed...a bastard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002526c_Oblivion_RESP1"
msgid ""
"You are like a dark gift from the Night Mother herself. Please, tell me how I "
"can help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00009175_Oblivion_RESP1"
msgid "You are like an unholy vision. So beautiful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022e00_Oblivion_RESP1"
msgid "You are looking well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01BribeBeggar_00007dff_Oblivion_RESP1"
msgid ""
"You are most generous! He lives in the Temple district on the far east side. "
"He's an early riser, usually up by sunrise."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10BribeBeggar_00016254_Oblivion_RESP1"
msgid ""
"You are most gracious. The Earl of Imbel has a home in the Talos Plaza, "
"facing the center plaza."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BravilTopicCitySwimmer01_0004891a_Oblivion_RESP1"
msgid "You are most welcome."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22SrazirrNotEnough2_0002c822_Oblivion_RESP1"
msgid ""
"You are no better than that renrij Maric. S'razirr should have known better "
"than to trust you. Get out of this one's sight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22SrazirrScrew_0002c824_Oblivion_RESP1"
msgid ""
"You are no better than that renrij Maric. S'razirr should have known better "
"than to trust you. Get out of this one's sight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDJoinOrderReject_00002b32_Knights_RESP1"
msgid ""
"You are no doubt correct. I will continue to train and meditate here at the "
"Priory until I become worthy to serve Auri-El."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG02GiveItem_0001c477_Oblivion_RESP2"
msgid ""
"You are no longer a Thieves Guild member until you pay the blood price. Guild "
"tradition holds that you must pay it for each person slain."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04AhdarjisStolenRing_00007de7_Oblivion_RESP2"
msgid ""
"You are no longer a member of the Thieves Guild until blood price is paid for "
"the lives you took."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD09JafazirGreet_000a5658_Oblivion_RESP1"
msgid ""
"You are no longer one of us! Fighters Guild spy! Traitor! Your life is "
"forfeit!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00026902_Oblivion_RESP1"
msgid "You are no longer welcome here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e809_Oblivion_RESP1"
msgid ""
"You are not a member of the society. Watch if you must, but don't get in the "
"way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00082643_Oblivion_RESP1"
msgid "You are not one of us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003eac4_Oblivion_RESP2"
msgid "You are not to speak to me, worm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ServiceRefusal_000613ac_Oblivion_RESP1"
msgid "You are not worthy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00047374_Oblivion_RESP1"
msgid ""
"You are now one with the Dark Brotherhood. Visit Ocheeva at the Cheydinhal "
"Sanctuary and your new life will begin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038acb_Oblivion_RESP2"
msgid ""
"You are obviously of low birth. Unless you dispute my judgement... and you "
"would press your suit at the end of a sword."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Barter_0003e454_DLCThievesDen_RESP1"
msgid "You are one hot customer!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGStealingFromGuild_0001d4d0_Oblivion_RESP1"
msgid ""
"You are removed from the guild. You must pay a fine to one of the guild Doyen "
"to get back in."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_0001ee3d_Oblivion_RESP1"
msgid ""
"You are skillful, but not skillful enough. Prove your worth to me. Provide "
"the guild fences with the bounty of your work, then return."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02RelmynaVisit_0001a128_Oblivion_RESP1"
msgid ""
"You are strong like Him. I made you for Him. But still He refuses me. Why?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0c3_Oblivion_RESP1"
msgid ""
"You are stupid if you come to chatter. If you want to train, and you pay me, "
"then that is not so stupid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00048920_Oblivion_RESP1"
msgid ""
"You are stupid, so I'll make myself clear... you are stupid. Go away. I don't "
"want your blood and puke all over me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000a9485_Oblivion_RESP1"
msgid ""
"You are summoned by the Lord Hermaeus Mora. He sees your path as he sees all "
"things. Make your way to his shrine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00038ace_Oblivion_RESP1"
msgid "You are talking again. You will stop."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11RakheranGreeting1a_00019cd2_Oblivion_RESP2"
msgid ""
"You are the Duchess, yes? And Sheogorath has sent you to find Ciirta, has he "
"not? He finally seeks to kill her?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11RakheranGreeting1a_0007eaf4_Oblivion_RESP2"
msgid ""
"You are the Duke, yes? And Sheogorath has sent you to find Ciirta, has he "
"not? He finally seeks to kill her?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MankarRant_0008c246_Oblivion_RESP10"
msgid ""
"You are the last defender of decadent Tamriel. I am the midwife of the Mythic "
"Dawn, Tamriel Reborn."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MankarSpeech_0008b09f_Oblivion_RESP10"
msgid ""
"You are the last gasp of a dying age. You breathe the stale air of false hope."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEMMythicDawnNotes_00014e02_AltarDeluxe_RESP2"
msgid ""
"You are the last that was needed. Go to Mingo Cave, dressed as one of us, and "
"revel in the fire."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ad84_Oblivion_RESP2"
msgid "You are the one from my dreams..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10LetsGo_00016bb9_Oblivion_RESP3"
msgid ""
"You are the only remaining Duchess, which is a situation quite unprecedented. "
"Normally you would never be permitted to pass within Pinnacle Rock."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10LetsGo_00017d12_Oblivion_RESP2"
msgid ""
"You are the only remaining Duchess, which is a situation quite unprecedented. "
"Normally, you would never be permitted to pass within Brellach."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10LetsGo_00017d14_Oblivion_RESP3"
msgid ""
"You are the only remaining Duke, which is a situation quite unprecedented. "
"Normally, you would never be permitted to pass within Brellach."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10LetsGo_00017d13_Oblivion_RESP2"
msgid ""
"You are the only remaining Duke, which is a situation quite unprecedented. "
"Normally, you would never be permitted to pass within Pinnacle Rock."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d28a_Oblivion_RESP1"
msgid ""
"You are the toast of Anvil, my friend! It may be only a temporary respite, "
"but everyone feels better with that Gate closed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASheogorathSpeech_0008c262_Oblivion_RESP1"
msgid ""
"You are to find a way to make the first two parts of the prophecy come true. "
"I'll take care of the rest, because it's the most fun. Now, run along. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASheogorathSpeech_0009760d_Oblivion_RESP1"
msgid ""
"You are to find a way to make the first two parts of the prophecy come true. "
"I'll take care of the rest, because it's the most fun. Now, run along. "
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_MG04ChoiceCarahilContinue_0004f228_Oblivion_RESP3"
msgid ""
"You are to travel north to the Brina Cross Inn, and speak with Arielle "
"Jurard. She will give you further instructions."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_00023e70_Oblivion_RESP1"
msgid ""
"You are to travel to Bruma, enter the house of the Wood Elf Baenlin, and kill "
"him. It should look like an accident. I'm sure you can handle it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00074a0f_Oblivion_RESP1"
msgid "You are too late, fool!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06PriestGreetA_00040149_Oblivion_RESP1"
msgid ""
"You are truly Demented, as I always suspected. Release yourself to your "
"secret fears and desires. Let them rule you, as they must in the end!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk4_00034050_Oblivion_RESP1"
msgid ""
"You are truly an asset to this Sanctuary. Here's hoping all of our contracts "
"work out that well!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDCrusadersRelicsTopic_00002a82_Knights_RESP9"
msgid ""
"You are truly the Divine Crusader reborn. You are ready to face Umaril, and "
"destroy him, in the name of the Eight and One."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15KathutetC6_0003e8fc_Oblivion_RESP1"
msgid ""
"You are unlike any other mortal I have encountered. You serve me, and then "
"you spurn the reward for your service."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_0000a1b5_Oblivion_RESP1"
msgid ""
"You are unproven, or at least insufficiently proven for the tasks this one "
"has available."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS21StatueGive_0002b51f_Oblivion_RESP2"
msgid ""
"You are very close to earning the reward for completing the set of ten. I "
"urge you to redouble your efforts!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0001eee4_Oblivion_RESP1"
msgid "You are weak, like the gods you pray to!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeatherleahTopic_0008dc3f_Oblivion_RESP1"
msgid "You are welcome here anytime, my friend!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00071ee8_Oblivion_RESP1"
msgid ""
"You are welcome in my home anytime, friend! Maybe one day you'll learn to "
"love it so much, you'll wish to stay here, too."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQJauffreHelp_0005dcca_Oblivion_RESP1"
msgid ""
"You are welcome to take my horse. I rarely travel, so I'm sure you will put "
"her to better use than I."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseInquiry_0004f212_Oblivion_RESP1"
msgid ""
"You are? There is a positively gorgeous home for sale right on the main plaza."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000982c3_Oblivion_RESP1"
msgid "You aren't a member of the castle staff. What are you doing here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00086739_Oblivion_RESP1"
msgid "You aren't brooding on that little unpleasantness at Malada, are you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008fa9c_Oblivion_RESP1"
msgid "You aren't going to kill me. I know it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GarridansTears_00022e55_Oblivion_RESP1"
msgid ""
"You aren't the first person to go looking for those. Quite a remarkable "
"story, really. I know a bit about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000343e3_Oblivion_RESP1"
msgid "You arrived just in time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MeetMartin_0002777a_Oblivion_RESP1"
msgid "You avoid answering my question ..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS10LlevanaTalk_0003c373_Oblivion_RESP1"
msgid ""
"You bastard! How many more people are going to \"pay the price\"? How many "
"more have to die just so you can earn another gold coin?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG06NoRescue_0001473a_Oblivion_RESP1"
msgid ""
"You bastard! It's not like I killed her. I just roughed her up a bit. Nothin' "
"the healers can't fix."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_0002b1e2_Oblivion_RESP3"
msgid ""
"You beat all three, and you get named Champion! I know you can do this! Now "
"get up there and show everyone why you're the best!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000164e2_Oblivion_RESP1"
msgid ""
"You beatin' those twins is a good sign. You got a lot of fight in ya. Let me "
"know when you're ready to get bloody again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Advancement_0003abf9_Oblivion_RESP1"
msgid ""
"You become more valuable to the guild with each passing day. The guild wishes "
"to reward that, and so you are raised to the rank of Conjurer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003632e_Oblivion_RESP1"
msgid "You befoul the very air with your presence. Begone!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG09Choice2B_00022b6b_Oblivion_RESP3"
msgid ""
"You believe your Council would send you here to merely fetch a book? No, they "
"wanted information on me and what is going on here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ShrineofBoethiaTOPIC_0001ec94_Oblivion_RESP1"
msgid ""
"You believe yourself worthy to approach the Shrine of Boethia? Perhaps. Or, "
"perhaps you will be slaughtered. It is your choice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00085213_Oblivion_RESP1"
msgid "You best be careful around here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0007eab9_Oblivion_RESP1"
msgid "You better have a good reason for disturbing me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001ad47_Oblivion_RESP1"
msgid "You better have a very good reason to interrupt me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000ace63_Oblivion_RESP1"
msgid "You better have the right offering, or you're wasting your time here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c334_Oblivion_RESP1"
msgid "You better hope I never get out of here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000301dd_Oblivion_RESP1"
msgid "You better stay away from Diram. He's not very happy with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007a020_Oblivion_RESP1"
msgid "You bless me, Lord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022ca6_Oblivion_RESP1"
msgid ""
"You blew it. You had it in the palm of your hand and you threw it all away. "
"You make me sick."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_0002819b_Oblivion_RESP1"
msgid ""
"You bloody half-wit! Do I have to spell it out for you? She's a killer! A "
"murderer! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004d840_Oblivion_RESP1"
msgid "You bought an execellent Chestnut horse. Take care of him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterBuyItem_000091eb_Oblivion_RESP1"
msgid "You bought that for a song."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ElixirofExploration_0004e946_Oblivion_RESP1"
msgid ""
"You bring me 10 samples of Nirnroot, and I'll make the Elixir available to "
"you at a huge discount as well as give you one for free."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45HaveFork_00078785_Oblivion_RESP1"
msgid ""
"You bring the Fork! Happy day! The blind shall see! The lame shall walk! The "
"short shall tall! Forks for all!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMalacathSpeech_000579ca_Oblivion_RESP1"
msgid "You brought a present. Good. That's smart."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02JauffreB3_00092d84_Oblivion_RESP1"
msgid "You brought me the Amulet of Kings? This cannot be. Let me see it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32Betrothed_00012d02_Oblivion_RESP1"
msgid "You burned her?! She's gone?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00061395_Oblivion_RESP1"
msgid ""
"You came all this way for training from Aerin? You must be really "
"disappointed that she's not here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008c239_Oblivion_RESP1"
msgid "You came for the Amulet. Take it then!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008b0ac_Oblivion_RESP4"
msgid "You came for the Amulet. Take it then!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_00046665_Oblivion_RESP1"
msgid ""
"You came here for a fight, and a fight you shall have! But talk is for the "
"weak! You want blood! Lower the gates! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_00047c62_Oblivion_RESP1"
msgid ""
"You came to watch a fight, and a fight you shall have! It's the Blue Team "
"versus the Yellow Team in a battle to the death! Lower the gates!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_00046662_Oblivion_RESP1"
msgid ""
"You came to watch these two Bloodletters do what they do best, and they're "
"dying to prove their worth! So let the bloodletting... begin!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37ExpertSpell_0007b228_Oblivion_RESP1"
msgid "You came up short? Well, I'm not going to haggle with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017787_Oblivion_RESP1"
msgid ""
"You came. Good. I don't have much time. I have to get to the Gathering before "
"I'm missed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolTopic_00024e03_Oblivion_RESP1"
msgid ""
"You can PAY for a bed at the Grey Mare or the Oak and Crosier. But if you get "
"a bed for free at a guild, why would you pay for one?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05GwinasPhintiasB_00022b54_Oblivion_RESP1"
msgid ""
"You can be sure I won't be back! I've never been treated so shabbily in all "
"my life! Good day, sir!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0b2_Oblivion_RESP1"
msgid ""
"You can best know Anvil by walking its streets and speaking with its people. "
"My favorite time is the harbor at sunset, the sun and sea to the west."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArenaBettingTopic_0002ada1_Oblivion_RESP1"
msgid ""
"You can bet on either the Yellow Team or Blue Team. The opponents are always "
"evenly matched, so your chance of winning is 50/50."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488f1_Oblivion_RESP1"
msgid "You can call me Hillod the Outlaw. Because I'm on the lam."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08NelsNevConvo_000852c4_Oblivion_RESP1"
msgid ""
"You can call me a barbarian. It's true and I'm proud of the fact. But you "
"call me pathetic again and I'm going to show you just how barbaric I am."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RulesOfCompetition_00029ca8_Oblivion_RESP5"
msgid ""
"You can compete in the Arena any day from 9:00 AM to 9:00 PM. Just come to "
"me, tell me you're ready for a match, and away you'll go. Got it? Good."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000917ca_Oblivion_RESP2"
msgid ""
"You can count on the presence of the Golden Saints to defend his impressive "
"store of Greenmote."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000c42cd_Oblivion_RESP1"
msgid "You can do it, Antus. You can do it... just follow big brother's lead..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033766_Oblivion_RESP1"
msgid "You can do it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033796_Oblivion_RESP1"
msgid "You can do this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624cd_Oblivion_RESP1"
msgid ""
"You can find Cairn Bolete growing in caves. They're said to mark the place "
"someone has died."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGSpecialJobs_00035dd8_Oblivion_RESP2"
msgid ""
"You can find her at the Lonely Suitor lodge. I wouldn't recommend bothering "
"her at home, unless the door is unlocked."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07DairihillOffice_00098398_Oblivion_RESP2"
msgid ""
"You can find her in the audience chamber in the mornings. She dines with the "
"Countess from evening's eighth bell until midnight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS10AnyoneWhoCares_0003c29c_Oblivion_RESP3"
msgid "You can find him roaming the County Hall of the castle most of the time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00078169_Oblivion_RESP1"
msgid ""
"You can find some good deals at Things Found. Ahjazda has an interesting "
"collection."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_duties_0006e2e3_Oblivion_RESP4"
msgid ""
"You can find your monthly stipend in the Master's Chest upstairs, along with "
"anything we find that you might find useful. Here's the key."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0006770a_Oblivion_RESP1"
msgid "You can go now. Run along. Scoot!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQDaedricMagic_0008b603_Oblivion_RESP4"
msgid ""
"You can guess the rest. We got in over our heads. People died. My friends "
"died."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e4c0_Oblivion_RESP2"
msgid "You can hear them better that way, too."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47WhatHappened_00030038_Oblivion_RESP4"
msgid ""
"You can imagine how difficult it is to run an inn while invisible. Once you "
"get a reputation as a haunted inn, you can just forget about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JoinUs_0003d4aa_Oblivion_RESP1"
msgid ""
"You can make a good deal of money in our gang. But you have to be willing to "
"show a little skin if you know what I mean."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c1fd_Oblivion_RESP1"
msgid "You can never be too good with a bow. I know I'm not."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilNQDResponses_0003c1e1_Oblivion_RESP1"
msgid "You can never know too much about how to handle a sword."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RulesOfCompetition_0003d7b4_Oblivion_RESP4"
msgid ""
"You can only fight once a week, though. We'll need that much time to catch "
"new creatures for you to fight against."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05GwinasC2_0009532e_Oblivion_RESP1"
msgid ""
"You can only get Volume 4 directly from a member of the Mythic Dawn. I had "
"set up a meeting with the Sponsor, as he called himself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DLC06FenceTopic01_000079bb_DLCThievesDen_RESP1"
msgid ""
"You can pay your fines to the guards, serve your time, or pay me half and "
"I'll fix them all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGPayCrimeGold_000983a3_Oblivion_RESP1"
msgid ""
"You can pay your fines to the guards, serve your time, or pay me half and "
"I'll fix them all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03LlathasaIndarys_00045f77_Oblivion_RESP1"
msgid ""
"You can pay your respects in the northern croft. Just don't touch anything."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32WhatCanIDo_00012d05_Oblivion_RESP3"
msgid ""
"You can put away your sword in these halls. Unlike the defending spirits, "
"within these walls, none will war with you. Not even the Fanatics."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ09ArmorTopic_00026d6e_Oblivion_RESP2"
msgid ""
"You can reassure Jauffre that I will not destroy the armor. All I need is a "
"scraping of Talos's divine blood. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00032d3e_Oblivion_RESP1"
msgid "You can say what you like, but I'm never going back to Kvatch."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48Choice1A_00028030_Oblivion_RESP3"
msgid ""
"You can see the marks on the ground where they were, with the Great Gate "
"right in the middle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_00086074_Oblivion_RESP1"
msgid ""
"You can speak to the Count near the throne weekdays between eight in the "
"morning and four in the afternoon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077d0e_Oblivion_RESP1"
msgid "You can stay at the Choosy Beggar in Bliss, but I wouldn't."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StealNoCrime_000626bf_Oblivion_RESP1"
msgid "You can take that one, but let's not make it a habit..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47AncotarContinue_00030134_Oblivion_RESP2"
msgid ""
"You can tell them not to worry, the effect is not actually permanent. It "
"should wear off eventually."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000917ca_Oblivion_RESP3"
msgid ""
"You can try to sneak by them or you may elect to eliminate them, but the "
"latter is hardly the way of Mania, now is it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BThadon_00016570_Oblivion_RESP2"
msgid ""
"You can usually find her roaming around New Sheoth, or spending a lot of time "
"on the palace grounds."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RulesOfCompetition_0003d7b4_Oblivion_RESP3"
msgid ""
"You can wear whatever ever you want, of course. We don't want you getting "
"killed out there!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002a388_Oblivion_RESP1"
msgid "You can't be here now. Please leave, and quickly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bcbd_Oblivion_RESP1"
msgid ""
"You can't be too careful out in the wilderness. Almost any creature you find "
"is liable to give you a disease."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE44RingInfo_0007873a_Oblivion_RESP2"
msgid "You can't be too careful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ReadyForAMatch_000be425_Oblivion_RESP1"
msgid ""
"You can't fight now! You have a bet down on an Arena match. Look, finish up "
"with our gambling, and then you can fight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0ce_Oblivion_RESP1"
msgid ""
"You can't imagine the fuss some people make. My rats are no problem for "
"anyone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_0002824e_Oblivion_RESP1"
msgid ""
"You can't possibly think that Primo had anything to do with the murder, do "
"you? That's madness!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_COERCEDISLIKE_00062328_Oblivion_RESP1"
msgid "You can't scare me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008c0e1_Oblivion_RESP1"
msgid "You can't see me. You can't see me. Neither can He. No one can see me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c93d_Oblivion_RESP1"
msgid ""
"You cannot deceive me. Anaxes has fallen. Now I must restore order to the "
"Garden myself, and this angers me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Seen_0006c63f_Oblivion_RESP1"
msgid "You cannot escape the Master's vigilance!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15BandsOfChosen_0003c80e_Oblivion_RESP1"
msgid ""
"You cannot pass through the door to the Forbidden Grotto unless you wear the "
"Bands."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00074a0e_Oblivion_RESP1"
msgid "You cannot stop Lord Dagon!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32FanaticYell_0001b706_Oblivion_RESP1"
msgid "You cannot stop me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38Reward_00023668_Oblivion_RESP1"
msgid ""
"You certainly earned this. Take it with my thanks. I believe it must have "
"been fate that brought the two of us together. Goodbye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018b19b_Oblivion_RESP1"
msgid ""
"You certainly know your Destruction spells. I wish I could be of more help, "
"but... I just don't feel comfortable talking about it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062c83_Oblivion_RESP1"
msgid "You choose to share your time with me? You humble me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00040141_Oblivion_RESP1"
msgid ""
"You chose well. The Great Torch shines as a beacon of Mania to inspire and "
"enflame all who gaze upon it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004013e_Oblivion_RESP1"
msgid ""
"You chose well. The Great Torch shines with the luster of Dementia and the "
"glory of Sheogorath."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46DoublesTopic_0008fa7e_Oblivion_RESP1"
msgid "You cleared that up. You must be exhausted."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001e8a7_Oblivion_RESP1"
msgid ""
"You closed the Gate? I knew you could do it! This is our chance to launch a "
"counterattack!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002d75e_Oblivion_RESP1"
msgid "You closed the gate. That's the first good news in a long time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002d762_Oblivion_RESP1"
msgid "You closed the gate? How did you do it? We can't thank you enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_000251b8_Oblivion_RESP1"
msgid ""
"You come crying to me for help? Perhaps Lucien Lachance was wrong about you "
"after all, eh?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035598_Oblivion_RESP1"
msgid ""
"You come speak with me, yet you do not bear Scar-Tail's heart. Please, you "
"must slay that traitorous snake so Ocheeva and I can find peace!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_00027998_Oblivion_RESP1"
msgid ""
"You come to me for knowledge, for advice? I would sooner see you flounder in "
"a pool of your own blood. Good luck, worm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00019fc3_Oblivion_RESP2"
msgid ""
"You come to me glowing with violence and death. Your light has no place here. "
"We seek harmony for ourselves and the Shivering Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00028bb6_Oblivion_RESP1"
msgid "You coming to the gathering tonight?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000285a1_Oblivion_RESP1"
msgid ""
"You complete and utter disgrace! Disqualified? For not wearing your Battle "
"Raiment? Don't you dare humiliate the Blue Team like this again!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDHelmTopic_00002d25_Knights_RESP2"
msgid ""
"You completed the quest that I could not. I am glad that my death at least "
"served to lead you here, as I had hoped."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000bee5_Oblivion_RESP1"
msgid "You continue to do the guild proud. As such, a new task awaits you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GreetingLazare02_00038acd_Oblivion_RESP1"
msgid ""
"You contradict me. This conversation is tiresome. Leave me. Or draw your "
"sword."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_vampirehunters_00009226_Oblivion_RESP1"
msgid "You convinced them to leave, I see. A wise plan."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilNQDResponses_0003c240_Oblivion_RESP1"
msgid "You could learn a lot from Pinarus."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS26CorruptGuard_00035c9c_Oblivion_RESP2"
msgid ""
"You could try taking your problem to Itius Hayn. Maybe he'll be willing to "
"risk his career by arresting Audens."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062cea_Oblivion_RESP1"
msgid "You creatures are all the same."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ShadyDeal_0001e7f1_Oblivion_RESP1"
msgid ""
"You cut back now, and I'm going to take my business elsewhere. Or maybe pay a "
"visit to that Jensine and tell her about your little scheme."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081f59_Oblivion_RESP1"
msgid ""
"You cute little bunny. You've done a horrible thing here. Bad bunny. Bad!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraSpeech_0005c01f_Oblivion_RESP1"
msgid ""
"You dare approach my shrine, Child of the Light? You, who walk this plane "
"basking in the light of the warm, cruel sun?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AssaultNoCrime_00066338_Oblivion_RESP1"
msgid "You dare attack me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateConv_00091aee_Oblivion_RESP1"
msgid "You dare challenge the power of Oblivion?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001ebbd_Oblivion_RESP1"
msgid "You dare come here to the shrine of our lord? You are not one of us."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081194_Oblivion_RESP1"
msgid "You dare disturb me in my sanctum?!?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0018bd73_Oblivion_RESP1"
msgid "You dare oppose the might of the Imperial Legion?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_00098387_Oblivion_RESP1"
msgid "You dare to attack Fathis Aren?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002e91d_Oblivion_RESP1"
msgid ""
"You dare torment me? Valen Dreth? Let me out of this cell, you fetid piece of "
"Guar dung!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000711ba_Oblivion_RESP1"
msgid ""
"You decided to turn yourself in? Good. You lack the gold to pay your bounty, "
"so you must serve out your sentence. Your stolen goods are now forfeit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000711b9_Oblivion_RESP1"
msgid ""
"You decided to turn yourself in? Smart move. Pay your bounty, or serve your "
"sentence... your choice... but your stolen goods are forfeit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ03ComeWithMe_0001e8d7_Oblivion_RESP1"
msgid ""
"You destroyed the Oblivion Gate, they say. You gave them hope. You helped "
"them drive the daedra back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c93c_Oblivion_RESP1"
msgid "You destroyed the Sigil Tower at Ganonah. My kin say you fought well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG05AChoice1A_00028c09_Oblivion_RESP1"
msgid "You did WHAT?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00095a64_Oblivion_RESP1"
msgid ""
"You did it! You actually made it back with the crystal ball! Oh thank you! "
"Here, please take this as a reward!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000176c4_Oblivion_RESP1"
msgid ""
"You did it! You beat them, every last one! Do you know how long it will take "
"for the Yellow Team to recover from this? Ha ha ha ha ha! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateTopic_0001e8af_Oblivion_RESP1"
msgid ""
"You did it! You closed that damned Gate! Now we have a chance to take the "
"enemy by surprise."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0014684a_Oblivion_RESP1"
msgid ""
"You did it! You made it to Gladiator rank, same as me! Here's to a long, "
"successful career, my friend!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00046307_Oblivion_RESP1"
msgid ""
"You did it, Captain! You closed the Oblivion Gate! We didn't think we'd ever "
"see you alive again!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MartinA_0003782c_Oblivion_RESP1"
msgid ""
"You did it. You defeated him. Then you have it... you have the Amulet of "
"Kings?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGDefault2_00024295_Oblivion_RESP1"
msgid ""
"You did it? I'll be talking to Maglir soon. I don't need one wet-ear covering "
"for another. Still, the job got done. Here's the reward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000473c2_Oblivion_RESP1"
msgid ""
"You did not expect to see me again, did you? You have no grasp of the power "
"that my father has at his command."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND03TestofKynareth_00002a57_Knights_RESP1"
msgid ""
"You did not heed my warnings, did you? I told you not to delay, to go "
"directly to the Grove."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GlarthirTopic_00023660_Oblivion_RESP1"
msgid ""
"You did the right thing showing us that note. My brother and I will take care "
"of him, don't worry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_RaynilDralasTopic_00038b00_Oblivion_RESP1"
msgid ""
"You did what had to be done. There should be no regrets or doubts in your "
"mind about it. Raynil was an evil Dunmer, and he deserved that fate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ12MartinA1_000a31c4_Oblivion_RESP1"
msgid "You did. I can count on you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002a34a_Oblivion_RESP1"
msgid "You didn't leave, so I called the guards! Now you'll be arrested!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MankarRant_0008c21c_Oblivion_RESP10"
msgid ""
"You didn't think you could take me unawares, here of all places? In the "
"Paradise that I created?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS27UmbacanoB2_000a6580_Oblivion_RESP1"
msgid "You disappoint me. I was counting on your help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002d922_Oblivion_RESP1"
msgid "You do NOT belong in here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE01HaskillChoice7_000133e6_Oblivion_RESP1"
msgid ""
"You do as you will. You may leave the way you entered. Your life will be none "
"the worse for your time spent here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk3_00068355_Oblivion_RESP1"
msgid ""
"You do me too much honor. For who am I? The bastard heir of a dead Emperor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGExpelYes_00025038_Oblivion_RESP1"
msgid "You do not have all the materials you were told to collect."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGExpelYes_0002503d_Oblivion_RESP1"
msgid "You do not have all the materials you were told to collect."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS40Choice3A_0009813a_Oblivion_RESP1"
msgid "You do not have the cure. Please do not attempt to deceive me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_000bb9bb_Oblivion_RESP1"
msgid "You do not have the money for me, so I do not have a room for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Advancement_000836d2_Oblivion_RESP1"
msgid "You do not yet qualify for further advancement in the guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0018bd71_Oblivion_RESP1"
msgid "You do realize I've been holding back?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MageTalk4_0006a871_Oblivion_RESP1"
msgid ""
"You do realize this raises quite a few questions? The overall impact on "
"Alchemy is a complete unknown. And what of Spellmaking?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS09MetoDO_0005377a_Oblivion_RESP2"
msgid ""
"You do this for me, and you get the gold. All of it. All I need as proof is "
"that damn amulet she always wears. Show that to me and the money's yours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_000174b8_Oblivion_RESP2"
msgid ""
"You do, however. I believe the key he used for the well should also work on "
"his quarters."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE11RakheranGreeting3c1_00019fd1_Oblivion_RESP1"
msgid ""
"You do? Give them to me, and we can start now! I did not think that it would "
"be so easy!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraChoice1_0001ce9b_Oblivion_RESP1"
msgid ""
"You do? Perhaps you should. You are repulsive, displeasing to the eye. Namira "
"might find favor in you. Approach."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DANamiraChoice1_0001ce9a_Oblivion_RESP1"
msgid ""
"You do? You are too pretty to worship in this place. People like you. Like to "
"hear you talk. When you are more loathesome, you may return."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000b97d2_Oblivion_RESP1"
msgid "You don't appear well, milady. Perhaps you should rest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000b97d3_Oblivion_RESP1"
msgid "You don't appear well, milord. Perhaps you should rest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0009ded8_Oblivion_RESP1"
msgid "You don't belong here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfc8_Oblivion_RESP1"
msgid "You don't belong here. Get out!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002a38a_Oblivion_RESP1"
msgid "You don't belong here. Please leave. Now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_000bb9b7_Oblivion_RESP1"
msgid ""
"You don't even have the money! Why are you wasting my time? Is this some sort "
"of joke to you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterFail_0000921f_Oblivion_RESP1"
msgid "You don't expect me to make that deal, do you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfc0_Oblivion_RESP1"
msgid "You don't find something soon, I'm gonna lose my temper."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004f220_Oblivion_RESP1"
msgid ""
"You don't follow orders well, do you? You were supposed to find me before you "
"spoke to anyone else here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01Lockpicks_0009fd6e_Oblivion_RESP1"
msgid "You don't have enough coin to buy one."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0006139c_Oblivion_RESP1"
msgid ""
"You don't have my coin, so you don't get any training. I haven't changed my "
"mind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11RakheranDagger_0001a813_Oblivion_RESP1"
msgid ""
"You don't have the daggers yet? Time is growing short. Do whatever you must "
"to get them!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01ThievesTest_000355ec_Oblivion_RESP1"
msgid "You don't have the diary. Stop wasting my time!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37JourneymanSpell_0007b226_Oblivion_RESP1"
msgid ""
"You don't have the gold. I hope you didn't think I was just going to give it "
"to you?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BattlehornTrophyA_0000c52a_DLCBattlehornCastle_RESP1"
msgid "You don't have the item I need. I'm sorry."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BattlehornTrophyB_0000c52c_DLCBattlehornCastle_RESP1"
msgid "You don't have the item I need. I'm sorry."
msgstr ""

