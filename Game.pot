msgid "Varnado at The Best Defense knows a lot about Heavy Armor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00046634_Oblivion_RESP1"
msgid ""
"Varon Vamori can be really charming. Of course, there's something a bit odd "
"about him as well."
msgstr ""

