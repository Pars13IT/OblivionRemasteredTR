msgid ""
"Have you heard? That big galleon down at the Waterfront? Someone killed the "
"captain! Right there on the ship!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00002d2e_Knights_RESP1"
msgid ""
"Have you heard? The Chapel of Mara in Bravil's been attacked, just like "
"Anvil. Everyone slaughtered, the altars desecrated!"
msgstr ""

