msgid "Hello again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00025279_Oblivion_RESP1"
msgid "Hello again. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000314ff_Oblivion_RESP1"
msgid "Hello again. I hope your search for the painting goes well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000314f5_Oblivion_RESP1"
msgid ""
"Hello again. I'm sorry, but I have little time to chat. I am quite busy with "
"affairs of state and all that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f36a_Oblivion_RESP1"
msgid ""
"Hello again. You don't happen to recall how many steps you took in getting "
"here, do you? I was just wondering."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000bc90_Oblivion_RESP1"
msgid ""
"Hello again. You're more than welcome here! I have everything for the budding "
"alchemist under one roof."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006d603_Oblivion_RESP1"
msgid ""
"Hello again... talk to me while you can. I don't think I've got too long."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00038f2e_Oblivion_RESP1"
msgid "Hello and well met."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000301d6_Oblivion_RESP1"
msgid "Hello friend. Stay a while and watch the sheep with me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e7f_Oblivion_RESP1"
msgid ""
"Hello love. I'll have another bottle of wine if you please. And do hurry - "
"the last 5 barmaids I've talked to never came back..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000038d7_Oblivion_RESP1"
msgid "Hello milady."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00159758_Oblivion_RESP1"
msgid "Hello milady."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000038d6_Oblivion_RESP1"
msgid "Hello milord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00159757_Oblivion_RESP1"
msgid "Hello milord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028737_Oblivion_RESP1"
msgid ""
"Hello my friend.  I will never forget your daring rescue.  What can I do for "
"you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000319cb_Oblivion_RESP1"
msgid ""
"Hello my friend. A word of advice. Watch for goblins if you're heading north."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0009d9f2_Oblivion_RESP1"
msgid "Hello stranger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000224ea_Oblivion_RESP1"
msgid ""
"Hello stranger. We don't get many visitors around here. Makes things pretty "
"lonely for me, if you know what I mean."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002edee_Oblivion_RESP1"
msgid "Hello there! Are you here to join the Mages Guild?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d62_Oblivion_RESP1"
msgid "Hello there! Can I cut you a deal?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004f21f_Oblivion_RESP1"
msgid "Hello there! I must say, I'm quite surprised to see anyone else here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028273_Oblivion_RESP1"
msgid ""
"Hello there! Welcome to the Arena! I don't think I've ever seen you around "
"here before. I know all the regulars, believe me. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00042ff3_Oblivion_RESP1"
msgid ""
"Hello there! You're a cute little thing, aren't you? A little baby bear. Did "
"you get lost?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002f1f3_Oblivion_RESP1"
msgid ""
"Hello there, Associate. You're here for a recommendation, I presume. Are you "
"prepared to earn it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e961_Oblivion_RESP1"
msgid "Hello there, hello indeed! I'm Caldana Monrius. Well met!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000256e1_Oblivion_RESP1"
msgid "Hello there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002acbe_Oblivion_RESP1"
msgid "Hello there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002b494_Oblivion_RESP1"
msgid "Hello there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003d4eb_Oblivion_RESP1"
msgid "Hello there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0018afdd_Oblivion_RESP1"
msgid "Hello there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002948b_Oblivion_RESP1"
msgid "Hello there. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f36e_Oblivion_RESP1"
msgid ""
"Hello there. Have I mentioned that my left arm is actually one inch longer "
"than my right? Never know when that might be important."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e706_Oblivion_RESP1"
msgid "Hello there. Have you reconsidered my offer?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000277ab_Oblivion_RESP1"
msgid ""
"Hello there. Hmm... you might do nicely. Are you interested in some work? I "
"have a small task that needs accomplishing. You may be up to it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00031036_Oblivion_RESP1"
msgid "Hello there. I hear you've been looking for me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f367_Oblivion_RESP1"
msgid ""
"Hello there. I just finished a lovely conversation with Uncle Leo; it seems "
"he's not feeling well today. Lost an arm."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004300b_Oblivion_RESP1"
msgid ""
"Hello there. I suppose I should make the effort to introduce myself. I'm "
"Horkvir Bear-Arm. I hope there isn't anything I can do for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003ea30_Oblivion_RESP1"
msgid ""
"Hello there. I'm Hirrus Clutumnus, not that it should matter to you, or "
"anyone else for that matter. I'm worthless. I should die. Will you kill me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000357a_Oblivion_RESP1"
msgid "Hello there. Is there something I can do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002edda_Oblivion_RESP1"
msgid ""
"Hello there. Is there something with which I can assist you? Perhaps you're "
"curious about joining the Mages Guild?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000613bb_Oblivion_RESP1"
msgid "Hello there. Welcome to Aerin's Camp."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f366_Oblivion_RESP1"
msgid ""
"Hello there. You don't have any experience building boats, do you? I'm rather "
"stuck, what without any instructions and all. Confusing stuff."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008f106_Oblivion_RESP1"
msgid "Hello there. You'd look great in my newest work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003cd60_Oblivion_RESP1"
msgid "Hello to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00024122_Oblivion_RESP1"
msgid "Hello!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002b482_Oblivion_RESP1"
msgid "Hello!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002b490_Oblivion_RESP1"
msgid "Hello!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00038f30_Oblivion_RESP1"
msgid "Hello!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001e442_Oblivion_RESP1"
msgid ""
"Hello! I'm Dumag gro-Bonk. Best and prettiest smith in town. I know the "
"secret art of forging Amber. Here. Take this list. It explains what I need."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001accf_Oblivion_RESP1"
msgid "Hello! It's always a pleasure to speak with you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000091f2_Oblivion_RESP1"
msgid ""
"Hello! You must be from the Fighters Guild. I'm glad you're here. I need your "
"help to repay a debt."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e4bb_Oblivion_RESP1"
msgid "Hello! You'll need to speak up."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001badc_Oblivion_RESP1"
msgid "Hello, Apprentice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001bade_Oblivion_RESP1"
msgid "Hello, Associate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002d58f_Oblivion_RESP1"
msgid "Hello, Associate. If you need anything, just let me know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034eaa_Oblivion_RESP1"
msgid ""
"Hello, Associate. It seems you've obtained the final recommendation you "
"required."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ee3f_Oblivion_RESP1"
msgid ""
"Hello, Associate. To earn a recommendation from me, you need simply prove you "
"are able-bodied and prepared to learn something in the process."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000251e0_Oblivion_RESP1"
msgid "Hello, Brother. How can I help you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000251de_Oblivion_RESP1"
msgid ""
"Hello, Brother. It's good to see you again. The Night Mother has been smiling "
"upon you, I hope."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001bad6_Oblivion_RESP1"
msgid "Hello, Conjurer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001bad8_Oblivion_RESP1"
msgid "Hello, Evoker."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00003a6a_Oblivion_RESP1"
msgid ""
"Hello, I am Velwyn Benirus. If you're in the market, I'm selling a manor "
"house right now for a very good price."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002809c_Oblivion_RESP1"
msgid "Hello, I don't think we've met.  Are you new in town?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000b97df_Oblivion_RESP1"
msgid ""
"Hello, I heard you purchased the Servants Quarters for Rosethorn Hall, and I "
"was wondering if you had anyone in mind to fill that position?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002821f_Oblivion_RESP1"
msgid ""
"Hello, I'm Dovesi. I'm very pleased to meet you. Now that you're here, we can "
"really start looking for that chest of gold."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e4c7_Oblivion_RESP1"
msgid ""
"Hello, I'm Dredhwen. No one was running this place when I got here. They left "
"plenty of things behind, though. What do you need?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e4ba_Oblivion_RESP1"
msgid ""
"Hello, I'm Nanette Don. I wasn't sure why I came here, until she showed up. "
"Now I know. I'm going to be a powerful sorceress. Just like Relmyna! "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008e4bd_Oblivion_RESP1"
msgid ""
"Hello, I'm Shelden. I've been here the longest. That's why I'm mayor of "
"Passwall. That, and because I'm the best at being in charge."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000412c8_Oblivion_RESP1"
msgid "Hello, I'm Una Armina. Perhaps you've heard of my Museum of Oddities?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001bada_Oblivion_RESP1"
msgid "Hello, Journeyman."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001bad4_Oblivion_RESP1"
msgid "Hello, Magician."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001bace_Oblivion_RESP1"
msgid "Hello, Master-Wizard."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000251e1_Oblivion_RESP1"
msgid "Hello, Sister. Can I help you with something?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate1_00013a5f_Oblivion_RESP1"
msgid "Hello, Steward. Welcome to my little corner of the castle."
msgstr ""

