msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008ebfe_Oblivion_RESP1"
msgid "Goodbye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000c42c8_Oblivion_RESP1"
msgid "Goodbye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00028a28_Oblivion_RESP1"
msgid "Goodbye. And thank you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00072df3_Oblivion_RESP1"
msgid "Goodbye. And watch yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001e7cc_Oblivion_RESP1"
msgid "Goodbye. Hope to see you again very soon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00072df1_Oblivion_RESP1"
msgid "Goodbye. If you find any interesting things, let me know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0001e7d2_Oblivion_RESP1"
msgid "Goodbye. Please, come again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00072df0_Oblivion_RESP1"
msgid "Goodbye. So long. See you soon. Or not. Whichever it might be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003c358_Oblivion_RESP1"
msgid "Goodbye... fare-thee-well... hic."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HappyReceive_0002a394_Oblivion_RESP1"
msgid "Goodness. Well, I hope you don't say that to all the girls."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ADMIRELOVE_0006230c_Oblivion_RESP1"
msgid "Goodness. What can I say?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECreatureResponses_0008e826_Oblivion_RESP1"
msgid "Gorble. Can't you hear them gorbling?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e0a6_Oblivion_RESP1"
msgid ""
"Gorgo gro-Shura. Soldier of fortune. Which means, more-or-less, unemployed "
"and thoroughly pauperized."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003d4dc_Oblivion_RESP1"
msgid "Got a lot to do here. We can talk later in Anvil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BieneAmelionTOPIC_000091cf_Oblivion_RESP1"
msgid ""
"Got a sword and armor for her, huh? Not bad work, meat. Here's your payment "
"for the contract."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark05Choice2A_0004cacf_Oblivion_RESP4"
msgid ""
"Got all that? Good! Hides-His-Heart will be here any moment. Get ready! Oh, I "
"do hope this works..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark05Choice2B_0004cad0_Oblivion_RESP4"
msgid ""
"Got all that? Good! Hides-His-Heart will be here any moment. Get ready! Oh, I "
"do hope this works..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark05Choice2C_0004cad1_Oblivion_RESP4"
msgid ""
"Got all that? Good! Hides-His-Heart will be here any moment. Get ready! Oh, I "
"do hope this works..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00073029_Oblivion_RESP1"
msgid "Got any stories? I love stories."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GuardTalk1_0006fdd3_Oblivion_RESP1"
msgid ""
"Got called in on a murder. There's been some talk. Some of the men think it "
"was... You know... the Dark Brotherhood!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OblivionGateVoice_000910f1_Oblivion_RESP1"
msgid "Got him!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ee5d_Oblivion_RESP1"
msgid "Got nothing else to say to you. Get out of here before I get angry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46DoublesTopic_0008fa71_Oblivion_RESP1"
msgid ""
"Got them all, did you? Good work! I promised you a reward, and here it is. "
"Now, go find some other work to do, you layabout!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46DoublesTopic_0008fa7f_Oblivion_RESP1"
msgid ""
"Got them all? Makes me tired just thinking about it. Good work, though. "
"Here's the reward I promised."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0008f10c_Oblivion_RESP1"
msgid "Got to go. Have things to see and people to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0000bcbd_Oblivion_RESP1"
msgid "Gotta run!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00071fac_Oblivion_RESP1"
msgid "Gotta run."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS48StartCombatShouts_00082c8e_Oblivion_RESP1"
msgid "Grab the Sigil Stone and let's get out of here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BOASTLOVE_00062314_Oblivion_RESP1"
msgid "Gracious! What a hero!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476f6_Oblivion_RESP1"
msgid ""
"Graman gro-Marad. I'm a bouncer for the Bloated Float. My wife, Umog, is a "
"night guard for Master Umbacano."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047741_Oblivion_RESP1"
msgid "Graman gro-Marad. I'm the night man on the Bloated Float."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00037b4e_Oblivion_RESP1"
msgid "Grandmaster, is this ... ?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00049d12_Oblivion_RESP1"
msgid "Grave robber!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MartinA1_00027101_Oblivion_RESP3"
msgid ""
"Great Sigil Stones are the anchors of Great Gates. The kind of gate the "
"Mythic Dawn opened at Kvatch."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000243bf_Oblivion_RESP1"
msgid "Great fortunes to you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003cc0d_Oblivion_RESP1"
msgid ""
"Great show, great show! You really brought down the house! Here's your gold. "
"Now get some rest, and I'll see you next week!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000c5539_Oblivion_RESP1"
msgid ""
"Great show, great show! You really brought down the house! Here's your gold. "
"Now get some rest, and I'll see you next week!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000c553a_Oblivion_RESP1"
msgid ""
"Great show, great show! You really brought down the house! Here's your gold. "
"Now get some rest, and I'll see you next week!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0005323f_Oblivion_RESP2"
msgid ""
"Great things will befall you. There will be trials, but you will prevail. You "
"must, for the good of the guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerStatus_000241f7_Oblivion_RESP1"
msgid "Great!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FollowupPositive_00024221_Oblivion_RESP1"
