msgid "Welcome, Knight Commander."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002989_Knights_RESP1"
msgid "Welcome, Knight Errant."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00081d8c_Oblivion_RESP1"
msgid "Welcome, Madgod."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate2_00014459_Oblivion_RESP1"
msgid ""
"Welcome, Miss Herrick! Welcome! I'd been hoping to have a chance to chat with "
"you. I get the sense that you avoid me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Salutation_0009f9a0_Oblivion_RESP1"
msgid ""
"Welcome, Nord, to the Tournament of Ten Bloods. To your right, through each "
"of nine gates, another Chosen awaits you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Salutation_0009f9a1_Oblivion_RESP1"
msgid ""
"Welcome, Orc, to the Tournament of Ten Bloods. To your right, through each of "
"nine gates, another Chosen awaits you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002988_Knights_RESP1"
msgid "Welcome, Pilgrim."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Salutation_0009f9a2_Oblivion_RESP1"
msgid ""
"Welcome, Redguard, to the Tournament of Ten Bloods. To your right, through "
"each of nine gates, another Chosen awaits you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Salutation_0009f9a3_Oblivion_RESP1"
msgid ""
"Welcome, Wood Elf, to the Tournament of Ten Bloods. To your right, through "
"each of nine gates, another Chosen awaits you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e3f_Oblivion_RESP1"
msgid ""
"Welcome, brother. So good to finally meet you. I hope you're getting along "
"all right."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05ShrinePassword_0001f10b_Oblivion_RESP1"
msgid ""
"Welcome, brother. The hour is late, but the Master still has need for willing "
"hands. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003640e_Oblivion_RESP1"
msgid "Welcome, brother. You are one of the Chosen now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG00JoinA_0002d288_Oblivion_RESP1"
msgid ""
"Welcome, child, to the Guild of Mages. You shall be called Associate by all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e3c_Oblivion_RESP1"
msgid ""
"Welcome, dear Sister! So good to finally meet you! I hope you're getting "
"along all right. If you need anything, anything at all, you need only ask."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000476c0_Oblivion_RESP1"
msgid ""
"Welcome, friend, to the Tiber Septim Hotel. I am Augusta Calidia, your "
"hostess."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001dc94_Oblivion_RESP1"
msgid ""
"Welcome, good citizen. I'm Brother Piner, and this is Weynon Priory. A "
"monastery. Can I help you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00003997_Oblivion_RESP1"
msgid "Welcome, guild mage. We meet again, although in different circumstances."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001465a_Oblivion_RESP1"
msgid "Welcome, honored cat burglar."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488be_Oblivion_RESP1"
msgid ""
"Welcome, my friend! I am Isabeau Bienne, the ostler of Bay Roan Stables. And "
"today I can sell you such a very fine bay horse!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05ShrinePassword_0001f874_Oblivion_RESP1"
msgid ""
"Welcome, sister. The hour is late, but the Master still has need for willing "
"hands. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036410_Oblivion_RESP1"
msgid "Welcome, sister. You are one of the Chosen now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000355c3_Oblivion_RESP1"
msgid ""
"Welcome, stranger, to the Five Claws. Food and beds, cheap and good, but most "
"of all, your hostess promises, always clean!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00033ef2_Oblivion_RESP1"
msgid ""
"Welcome, traveller. We're all so worried about the goblins, we may not be as "
"hospitable as we should be."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000977d6_Oblivion_RESP1"
msgid "Welcome, welcome!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_0004216e_Oblivion_RESP1"
msgid "Welcome, welcome, to the Arena, good citizens of the Empire!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000919c1_Oblivion_RESP1"
msgid "Welcome."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00014830_Oblivion_RESP1"
msgid "Welcome. Let's talk."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002b459_Oblivion_RESP1"
msgid ""
"Welcome. My master instructed me to show you up immediately. Please follow me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062c98_Oblivion_RESP1"
msgid "Welcome. Please, don't be shy. I'm listening."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001d23f_Oblivion_RESP1"
msgid ""
"Welcome. You're now in the sanctuary of the Order of the Virtuous Blood. Few "
"outside our circle have ever set foot in our hallowed hall."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQLastItem_00026ef7_Oblivion_RESP3"
msgid ""
"Welkynd stones contain the concentrated power of Mundus; their counterparts "
"are Sigil stones, which are used to hold open Oblivion Gates."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15OrtheEldamil_0003eabc_Oblivion_RESP1"
msgid "Well ... carry on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDLathonGreetA_00002a79_Knights_RESP1"
msgid ""
"Well ... yes. But Sir Roderic won many battles all the same. I'm sure if we "
"had had more knights like him we would have beaten the Nords."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00023e4e_Oblivion_RESP1"
msgid "Well I'll be a spotted Snow Bear -- a customer!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseTooMuchChorrol_0004f21a_Oblivion_RESP1"
msgid "Well I'm certainly not about to lower the price."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023e84_Oblivion_RESP3"
msgid ""
"Well I'm sick of it. Sick and tired, tired and sick. And perhaps a little "
"drunk. But nevermind. You look like the honest sort, so I've a job for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38OddityDonate_00082423_Oblivion_RESP3"
msgid "Well aren't you a darling? I know just where I'm going to put this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS21StatueGive_0002b527_Oblivion_RESP1"
msgid "Well done! Here is your payment as promised."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000275c1_Oblivion_RESP1"
msgid ""
"Well done! Not only did you kill the five guests, you acted as an agent of "
"terror and grief. You have earned your reward and bonus, Assassin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThoronirTopic_0001d03d_Oblivion_RESP1"
msgid ""
"Well done! This shovel will certainly confirm Agarmir's crimes. Along with "
"the manifest, it should prove useful to the City Watch."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HistTreeTopic_00035701_Oblivion_RESP1"
msgid ""
"Well done! With that tree gone, the Blackwood Company is just another band of "
"mercenaries. Cyrodiil is a safer place for what you've done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002aef8_Oblivion_RESP1"
msgid ""
"Well done! You have much to learn about this business, my friend, but you "
"show definite promise."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_0000392e_Oblivion_RESP1"
msgid ""
"Well done! You've put in good work for me. I only wish I had more. Things are "
"a little lean right now, as I'm sure you know. Here's your payment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASheogorathSpeech_00095531_Oblivion_RESP1"
msgid ""
"Well done, My Lord. You should have this, as it is one of your artifacts. I "
"don't know why I didn't think to give it to you sooner."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002947_Knights_RESP1"
msgid ""
"Well done, Sir Knight! We are all in your debt. I don't like to think what "
"those Aurorans would have done if you hadn't stopped them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MankarRant_0008c243_Oblivion_RESP10"
msgid ""
"Well done, champion! Your progress is swift and sure. Perhaps you will reach "
"me after all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07LexReassigned_00098390_Oblivion_RESP1"
msgid ""
"Well done, hunter! Hieronymus Lex will no longer be a thorn in the paw of the "
"Thieves Guild. The Gray Fox shows his gratitude."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMephalaSpeech_000579db_Oblivion_RESP1"
msgid ""
"Well done, little webspinner. Is there a prettier sight than friends at war? "
"Take pleasure in the strife you have caused, mortal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002887f_Oblivion_RESP1"
msgid "Well done, my friend. This mine is once again safe for the miners."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS12CmdrAnswer2_0001c490_Oblivion_RESP1"
msgid ""
"Well done, soldier. Your mission is complete, and you have my thanks. Now we "
"may rest. Long live the Akavir!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BOASTLIKE_00062316_Oblivion_RESP1"
msgid "Well done."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018d296_Oblivion_RESP1"
msgid ""
"Well done. Bruma will never fall while you and our intrepid Captain Burd are "
"on duty!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009171f_Oblivion_RESP1"
msgid ""
"Well done. I suppose you deserve your new post. Now, if only you stay alive "
"long enough to enjoy it..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000915c2_Oblivion_RESP1"
msgid ""
"Well done. I suppose you deserve your new post. Now, if only you stay alive "
"long enough to enjoy it...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081b72_Oblivion_RESP1"
msgid "Well done. Summoned again. I applaud you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMeridiaSpeech_000579b9_Oblivion_RESP1"
msgid ""
"Well done. Those creatures were an affront to all life, and they have paid "
"the price for their actions. Take this ring and go with my blessing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00024e53_Oblivion_RESP1"
msgid ""
"Well done. You are now a member of the Order of the Mythic Dawn, one of the "
"Chosen. Your life belongs to Lord Dagon."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DASheogorathSpeech_00095532_Oblivion_RESP1"
msgid ""
"Well done. You should have this, one of the artifacts of the Realm. Perhaps "
"it should have been given to you sooner."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09NoArrow_00014829_Oblivion_RESP1"
msgid "Well go get it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0005375d_Oblivion_RESP1"
msgid "Well go get it! What good is it doing if you're standing here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity10_00081e95_Oblivion_RESP3"
msgid ""
"Well isn't that just the Oddest thing! A dagger that heals people. Who would "
"make such a thing, and why? I absolutely adore it!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08CutoffTopic_00079b66_Oblivion_RESP1"
msgid ""
"Well look at this, I found the easy road. How are things going over there?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00025679_Oblivion_RESP1"
msgid "Well met!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002b487_Oblivion_RESP1"
msgid "Well met!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003c343_Oblivion_RESP1"
msgid "Well met!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00146850_Oblivion_RESP1"
msgid "Well met!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000319cd_Oblivion_RESP1"
msgid "Well met! Come, warm yourself by our fire."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029d4_Knights_RESP1"
msgid "Well met, Sir Knight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000335a4_Oblivion_RESP1"
msgid "Well met, adventurer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00189183_Oblivion_RESP1"
msgid "Well met, adventurer. A moment of your time if you please."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bafb_Oblivion_RESP1"
msgid ""
"Well met, citizen. I see few new faces these days, it seems. With the "
"Emperor's murder, a darkness has fallen upon all of Cyrodiil. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001badf_Oblivion_RESP1"
msgid "Well met, guildmate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001c4d6_Oblivion_RESP1"
msgid "Well met, milady."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001c4d5_Oblivion_RESP1"
msgid "Well met, milord."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000153b1_Oblivion_RESP1"
msgid "Well met, old friend!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00071f51_Oblivion_RESP1"
msgid ""
"Well met, traveler. Are you seeking treasure as well? Gortwog demands riches, "
"so all of Tamriel will respect Orsinium."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002931_Knights_RESP1"
msgid ""
"Well met, traveler. Have you heard the call of the Prophet? Do you walk the "
"Pilgrim's Way?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001c5d3_Oblivion_RESP1"
msgid "Well met."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00023db9_Oblivion_RESP1"
msgid "Well met."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001ce00_Oblivion_RESP1"
msgid "Well met."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002567c_Oblivion_RESP1"
msgid "Well met."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002b48f_Oblivion_RESP1"
msgid "Well met."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0009198e_Oblivion_RESP1"
msgid "Well met."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000c4534_Oblivion_RESP1"
msgid "Well met."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000c453e_Oblivion_RESP1"
msgid "Well met."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00189cfb_Oblivion_RESP1"
msgid "Well met. I trust no great harm has befallen you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018885c_Oblivion_RESP1"
msgid ""
"Well met. Welcome to the Bloated Float. She's the finest inn on the water in "
"all Cyrodiil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006fdbe_Oblivion_RESP1"
msgid ""
"Well now, I didn't expect to see anyone else foolish enough to venture out "
"here in the rain! How do you fare, citizen?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033360_Oblivion_RESP1"
msgid ""
"Well now, a pretty little Wood Elf. You're a little far from the forest, huh? "
"Looks like your days of woodland frolicking have come to a tragic end."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000bf1c0_Oblivion_RESP1"
msgid ""
"Well now, what do we have here? Caught in the act and no gold to pay your "
"fine? I'm confiscating your stolen goods. Now it's off to jail with ya!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00054032_Oblivion_RESP1"
msgid "Well now, what might you want?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00044f51_Oblivion_RESP1"
msgid "Well now, what news do you have to report?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003a90a_Oblivion_RESP1"
msgid "Well now, who do we have here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000008af_Oblivion_RESP1"
msgid ""
"Well now, you are an ambitious one, aren't you? I'm afraid I have no more "
"contracts for you. Our time working together has come to an end."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002f87d_Oblivion_RESP1"
msgid ""
"Well now, you are an ambitious one, aren't you? I'm afraid I have no more "
"contracts for you. Our time working together has come to an end."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23SeridurHeSays_000947c1_Oblivion_RESP1"
msgid "Well of course he'd say that! He'd do anything to save his skin!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS11ErlineOpinion_00038444_Oblivion_RESP1"
msgid ""
"Well of course it does! It was obviously planted here. Why would he stash a "
"body in his own house? That's ridiculous!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkUmaril3_00002c52_Knights_RESP1"
msgid ""
"Well said. I will endeavor to follow your example, and continue to train for "
"the day when we are able to strike back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29InvNice_0001d049_Oblivion_RESP1"
msgid ""
"Well thank you! It's not only a fine assortment of goods, but a bit of a "
"treasure trove; you never know what I'll have in stock."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetGreetA2_00002aa9_Knights_RESP1"
msgid ""
"Well then, \"Hail, Hero of Kvatch!\" Let me add one more voice to the "
"neverending chorus of praise."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark02FinChoice1B_00023e49_Oblivion_RESP1"
msgid ""
"Well then, I suggest you get your affairs in order and return to me as soon "
"as you're able."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS12PaleYes_00018235_Oblivion_RESP1"
msgid ""
"Well then, history lesson notwithstanding, I hope you can recover the "
"Draconian Madstone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007028f_Oblivion_RESP1"
msgid ""
"Well then, it's back to the open road for us, eh? Stay safe, my friend. And "
"stay clear of those Goblins. Little buggers have been getting cocky..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS21StatueNo_0002b464_Oblivion_RESP1"
msgid ""
"Well then, you have work to do. I will continue to search the archives for "
"any clues to the statues' locations."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS21StatueNo_0002b5ed_Oblivion_RESP1"
msgid "Well then, you have work to do. You'd best be on your way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13GateHeard_00031c81_Oblivion_RESP1"
msgid ""
"Well then, you know what they're capable of producing. Although, nothing has "
"come through ever since Farwil entered."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice7B_00028c7b_Oblivion_RESP1"
msgid "Well then, you must excuse me. I have important business to attend to."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG00JoinB_0002d077_Oblivion_RESP1"
msgid "Well then. If you re-think your decision, I'll be around."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04NoRingYet_00035fc1_Oblivion_RESP1"
msgid "Well then. It seems you still have a job to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38DSNo_00023671_Oblivion_RESP1"
msgid ""
"Well then... I suppose I must believe you. At least now I can be sure... "
"[Scribbles something on a piece of paper.] Here. This is your last task."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39CindanweChoice_000781fc_Oblivion_RESP1"
msgid ""
"Well there's the obvious way. But don't let us see you do it. Sheogorath has "
"a thousand eyes and ears."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Seen_001854eb_Oblivion_RESP1"
msgid "Well well, look who we've got here!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04NoLockPick_00035fb6_Oblivion_RESP1"
msgid ""
"Well what are you waiting for? Go get some! I'm not tellin' you a thing until "
"I've got one in my hand."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS14TivelaHeard_00061423_Oblivion_RESP1"
msgid "Well yes, of course. Why are you asking me these silly questions twice?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Fines_0003c295_Oblivion_RESP5"
msgid ""
"Well, Aldos couldn't pay the last two fines, so they seized his home and "
"threw him into the street until he could pay it! Bastards!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS05WhyLie_00027f39_Oblivion_RESP1"
msgid ""
"Well, Henantier's been warned that if he strays outside the Guild rules one "
"more time, he may be up for summary dismissal."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479ee_Oblivion_RESP1"
msgid ""
"Well, I don't know much about politics, but I think Lady Alessia's right. "
"We've got to put a stop to all these bandits and rabble in the Trans-Niben."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_00028233_Oblivion_RESP1"
msgid ""
"Well, I don't really know her, but she seems like a very respectable old "
"lady. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Abilities_000151f3_Oblivion_RESP1"
msgid ""
"Well, I excelled in my studies in magic, especially large-scale spells. I'm "
"pretty accurate with them, too. More accurate than swinging a sword."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04GivePick_00035fb7_Oblivion_RESP4"
msgid ""
"Well, I figured I would ransom it back to the Countess. Except she tricked "
"me. I was arrested for theft, and she kept the ring."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00043007_Oblivion_RESP1"
msgid ""
"Well, I guess I can take a short break. A short one, mind you. I have lots to "
"do still."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE40SleepOutsideChoice1a_000790be_Oblivion_RESP2"
msgid ""
"Well, I guess if he's not afraid of the walls falling on him, he won't care "
"when they do. Can't save everyone, can we?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f85f_Oblivion_RESP3"
msgid ""
"Well, I guess we'll go back to the drawing board. Fine, go tell Jeanne you "
"found me. I was getting tired of being invisible all the time, anyway."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00061395_Oblivion_RESP2"
msgid ""
"Well, I haven't ever seen her, so I guess you're out of luck there. But, if "
"you want... I could train you. I'm pretty skilled myself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ06Bears_0018afd5_Oblivion_RESP3"
msgid ""
"Well, I hope this will eventually drive them away. There may be a few "
"stragglers, but I think this should do it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GlarthirTopic_00028d6c_Oblivion_RESP1"
msgid ""
"Well, I know he's a bit odd, but I've always thought he was kind of sweet.  "
"Lately, though, he has been stranger than usual."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PinerDEMO1_0002ae29_Oblivion_RESP1"
msgid "Well, I must be going. Take care."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedYes_000b1298_Oblivion_RESP1"
msgid ""
"Well, I must say. You have some nerve, attempting to swindle me out of a "
"night's stay. If you've no gold, I suggest you find alternate lodging."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0006fdb1_Oblivion_RESP1"
msgid "Well, I should go. If you need any backup, just give me a shout. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DarkSancTalk5_00034057_Oblivion_RESP1"
msgid "Well, I should return to my duties. Till next time, then."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39Cindanwe_000781f5_Oblivion_RESP1"
msgid ""
"Well, I suppose I can trust you. You did bring me the spoon... Cindanwe is "
"pure evil. She must be stopped at all costs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StolenPainting_0003150e_Oblivion_RESP1"
msgid ""
"Well, I suppose I should congratulate you on returning the painting to the "
"Countess. I won't."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS02ManorBuyChoice2_00003a70_Oblivion_RESP1"
msgid ""
"Well, I'll be at The Count's Arms every day from noon until midnight. Let me "
"know if you change your mind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS02ManorBuyChoice2_00003a6f_Oblivion_RESP1"
msgid ""
"Well, I'll be here every day from noon until midnight. Let me know if you "
"change your mind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackwaterBrigands_0000c1ce_Oblivion_RESP1"
msgid ""
"Well, I'm afraid all of this was my fault. They hijacked the Bloated Float "
"because of me. Business has been waning of late, so I invented a story."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ10BjalfiDead_00061422_Oblivion_RESP2"
msgid ""
"Well, I'm just glad that it's all over and Rockshatter is back where it "
"belongs; in my family."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UlrichLelandTopic_0003c2a6_Oblivion_RESP3"
msgid ""
"Well, I'm not standin' for this any more. You come with me and I'll show you "
"what the Othrans can do when their backs are to the wall."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e703_Oblivion_RESP3"
msgid ""
"Well, I've got to be going -- many treasures to find around here, yes indeed! "
"We'll speak again, I'm sure!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AKithlan_00013a6b_Oblivion_RESP1"
msgid ""
"Well, I've heard that recent events in Syl's court have made Kithlan a bit "
"disillusioned with its leadership. But you didn't hear that from me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00067dc7_Oblivion_RESP1"
msgid ""
"Well, I've kept you long enough, my lord. Remember that I'm here if you need "
"anything."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_000286ff_Oblivion_RESP1"
msgid ""
"Well, Neville is a trained soldier. He was in the Imperial Legion for twenty "
"years, or so I've heard. He certainly knows how to kill. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002802_Oblivion_RESP1"
msgid ""
"Well, ain't you the high-tom-titty? You want something, I guess, or you "
"wouldn't be messing up my air."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000176c4_Oblivion_RESP3"
msgid ""
"Well, almost the best... You're done competing in normal Arena matches. But "
"there's still the Grand Champion... "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ShadowbanishWine_0018d92e_Oblivion_RESP2"
msgid ""
"Well, apparently the wine is so rare because it was only made in one tiny "
"batch. It's the product of an alchemist who was also a vintner."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00073017_Oblivion_RESP1"
msgid "Well, aren't you just the cutest little thing!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE04YouMeanSyl_00019863_Oblivion_RESP1"
msgid ""
"Well, aren't you the clever one. Mind you don't get too full of yourself. You "
"might explode."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002c6da_Oblivion_RESP1"
msgid ""
"Well, as you can see, Henantier's right here and he's trapped in his "
"Dreamworld."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CreatureResponses_0002b1c4_Oblivion_RESP1"
msgid ""
"Well, at least they're slow, and not too bright. Their pincers are sharp, "
"though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f85c_Oblivion_RESP2"
msgid ""
"Well, at least you took care of Jeanne's book. We'll be able to laugh over "
"that one for weeks, I bet."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003c357_Oblivion_RESP1"
msgid "Well, come on, let's get movin'."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00132a9f_Oblivion_RESP1"
msgid ""
"Well, despite everything, Aleron Loche turned up dead. That's what you get "
"when you deal with gamblers and usurers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000947b5_Oblivion_RESP1"
msgid "Well, don't just stand there! Go and kill him!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05PlanC_00022cf4_Oblivion_RESP1"
msgid ""
"Well, don't take too long. I don't think they'll like it if they realize you "
"didn't come alone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE34No_00066ede_Oblivion_RESP1"
msgid ""
"Well, fine. I see that only true Knights understand the meaning of honor. "
"Good day."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f85d_Oblivion_RESP2"
msgid ""
"Well, fine. You go tell Jeanne you found me. You're the big hero. Whoopee. "
"I'm going back to work. I was tired of being see-through, anyway."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46GoblinMischief_0002f814_Oblivion_RESP1"
msgid "Well, for instance, you could give it to any other goblin tribe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e8ce_Oblivion_RESP2"
msgid ""
"Well, forget about it. Invitation only. And no invitation for you, stranger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ02PrivateBusiness_000aa091_Oblivion_RESP2"
msgid ""
"Well, go ahead. You know what you're looking for. I'll just go back to my "
"reading."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03KilibanChamberChatter_0008f036_Oblivion_RESP1"
msgid ""
"Well, go on, press one. They won't bite you. At least, I think they won't."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002ee5b_Oblivion_RESP1"
msgid ""
"Well, have you found that imp gall for me yet? I've got some research I need "
"to get to."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008f109_Oblivion_RESP1"
msgid "Well, hello stranger."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007ac76_Oblivion_RESP1"
msgid ""
"Well, hello there. It's good to see such a well-equipped individual as "
"yourself around these parts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028159_Oblivion_RESP1"
msgid ""
"Well, hello there. Nels is my name. Some call me Naughty, but don't you "
"believe it! Hahahaha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00024c99_Oblivion_RESP1"
msgid ""
"Well, hello there. Sabine Laul, guild smith -- real happy to meet you. So. "
"What can I do for you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028269_Oblivion_RESP1"
msgid ""
"Well, here we all are. It's funny how money can bring people together, don't "
"you think?  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0006e605_Oblivion_RESP1"
msgid ""
"Well, here we are. If you wish to learn what I know about Alteration, then "
"you must stay here with me for a full three hours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028bef_Oblivion_RESP1"
msgid ""
"Well, here we both are. Retired Imperial Legion officer and hired assassin. "
"So, who do you work for? The Dark Brotherhood? The Morag Tong? No matter."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062c8c_Oblivion_RESP1"
msgid "Well, here's a fine one! Speak freely."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_0002816a_Oblivion_RESP1"
msgid ""
"Well, if I can be perfectly honest with you, I find Neville quite attractive. "
"Redguards are so... exotic. Don't you think?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity3_0004342a_Oblivion_RESP3"
msgid ""
"Well, if it doesn't look just like you! So lifelike! My patrons are going to "
"absolutely adore this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022493_Oblivion_RESP1"
msgid ""
"Well, if it isn't my little helper. Have you retrieved that book for me yet?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c189_Oblivion_RESP1"
msgid "Well, if it was Ugak, you can be sure she had some good animals."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GarridansTears_00022f17_Oblivion_RESP1"
msgid ""
"Well, if what you learned is accurate, then you must protect yourself. It "
"sounds like the cold in the glade is so severe that it could harm you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_00047675_Oblivion_RESP1"
msgid ""
"Well, if you MUST have Heavy Armor, see Varnado. So heavy, so ugly... but "
"it's your choice."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnvilTopic_0003e0cb_Oblivion_RESP1"
msgid ""
"Well, if you don't mind scruffy sailors smelling like bilge, it's a lovely "
"town. The men are all the same, drunk and shiftless."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ04Continue_0018a95d_Oblivion_RESP1"
msgid ""
"Well, if you must know, I've been studying the Welkynd Stones. Yes, the "
"aquamarine colored crystals usually native to Ayleid ruins."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479fb_Oblivion_RESP1"
msgid ""
"Well, if you want to know what I think, I think it stinks. The Elder Council "
"takes the Trans-Niben and just gives it to Cyrodiil!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MaleneTopic_0018bc38_Oblivion_RESP2"
msgid ""
"Well, if you're dead set on learning something from me, then how about you do "
"a little something for me, first? Something for her, to be honest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d491_Oblivion_RESP2"
msgid ""
"Well, if you're up to it, I think we can solve that little problem. You see, "
"me and Faustina here are lonely too, and we've been looking for someone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BRIBE_00062303_Oblivion_RESP1"
msgid "Well, isn't that sweet of you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAMolagBalSpeech_00037816_Oblivion_RESP1"
msgid ""
"Well, it seems you've accomplished the task set out for you. Well done. "
"Another man damned. Another ruined soul."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE40SleepOutsideChoiceU2_000790b2_Oblivion_RESP1"
msgid ""
"Well, it sounds fishy, but I suppose I can trust you. I'm sure I'll regret "
"this later, but... yeah. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Prank_000836cc_Oblivion_RESP1"
msgid ""
"Well, it was fun while it lasted. I'll have to start thinking up something "
"new to try."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_00038aca_Oblivion_RESP1"
msgid ""
"Well, it's a bit rugged. Nothing like the Arcane University. Have to go to "
"the Imperial City to buy anything. But it's good enough, I suppose."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark02PirateConvo_000493b4_Oblivion_RESP1"
msgid ""
"Well, it's never happened to Malvulis, has it? You know why? 'Cause she could "
"sail better than you in her sleep, you old fool!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624c3_Oblivion_RESP1"
msgid ""
"Well, it's no problem traveling from the Imperial City to Leyawiin... if "
"you're a wizard and can walk on water. I'd stay off the roads, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MageTalk3_0006a86b_Oblivion_RESP1"
msgid ""
"Well, it's not surprising, really. This is Necromancy we're talking about, "
"after all. Such a hideous discipline! All that blood and rotting flesh..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS12Stipend_00018232_Oblivion_RESP2"
msgid ""
"Well, it's safe to say I'm a collector of sorts. I've invested a great deal "
"of time and money acquiring these bits of ancient history."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38OddityNotNow_00081e5d_Oblivion_RESP3"
msgid "Well, just keep looking and I'm sure something Odd will turn up!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ShadyDeal_0001e7fa_Oblivion_RESP1"
msgid ""
"Well, just shut up and listen to me. The next shipment will be sooner than I "
"expected. Just have the money ready."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05Gwinas_00094c3a_Oblivion_RESP3"
msgid ""
"Well, just this once I don't suppose it would do any harm. Gwinas mentioned "
"he was staying at the Tiber Septim Hotel."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05Gwinas_00094c3b_Oblivion_RESP3"
msgid ""
"Well, just this once I don't suppose it would do any harm. Gwinas mentioned "
"he was staying at the Tiber Septim Hotel."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FingersoftheMountain_000253ca_Oblivion_RESP1"
msgid ""
"Well, look at that! You should take that to Teekeeus right away - he'll want "
"to see it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00018c8e_Oblivion_RESP1"
msgid ""
"Well, look at you. A change for the better, or for the worst? We'll have to "
"see, won't we?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002871f_Oblivion_RESP1"
msgid ""
"Well, look at you. Two people have been horribly murdered, and you're right "
"as rain. Strikes me as odd, that does."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00067707_Oblivion_RESP1"
msgid "Well, look who's here! You! How about that?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00097621_Oblivion_RESP1"
msgid "Well, look who's here! You! How about that?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONEXIT_0018b2ea_Oblivion_RESP1"
msgid "Well, maybe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02RelmynaVisit_0001a121_Oblivion_RESP1"
msgid "Well, my child, how are you this evening?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk5_00068349_Oblivion_RESP1"
msgid ""
"Well, my friend, let's hope it doesn't come to that, hmm? We'll get through "
"this together... as brothers."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002815a_Oblivion_RESP1"
msgid ""
"Well, my friend, the search is on, eh? I wonder how much gold is actually in "
"the chest? A thousand pieces of gold? Ten thousand? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG01AdrienneConv_0002d903_Oblivion_RESP1"
msgid "Well, my pride is a little wounded..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE35HereYouGo_00078673_Oblivion_RESP2"
msgid ""
"Well, my thieving days have finally come to an end. I promise never to set "
"foot in any of the shops in Crucible ever again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_jointheMagesGuild_0002d061_Oblivion_RESP1"
msgid ""
"Well, no bounty on your head, and you look able enough. Very well; are you "
"sure you want to join the guild?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04AlessiasRing_0000a175_Oblivion_RESP2"
msgid ""
"Well, not all the time. I mean, she puts it in her jewelry box for baths and "
"at night. No proper lady would wear her jewelry to bed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE44PantsInfo_00078738_Oblivion_RESP2"
msgid ""
"Well, not me. No way. I'll be calm and collected with these pants on. Ready "
"for action."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13GateHeardNot_00031c7c_Oblivion_RESP1"
msgid ""
"Well, not much to say really. These gates to... other places... ummm, well... "
"it's very hard to explain. I'm not sure I even understand it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG09Choice2B_00022b6b_Oblivion_RESP4"
msgid "Well, now they shall have it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackwaterBrigands_0000c1ce_Oblivion_RESP4"
msgid ""
"Well, obviously, I was mistaken. It was a terrible idea. I'm just glad that "
"no innocents were hurt; I wouldn't want to have their blood on my hands."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ChorrolNQDQuestionResponses_000238bb_Oblivion_RESP1"
msgid ""
"Well, of course. I mean, there's always something there I need. And Seed-"
"Neeus gives a fair price."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_0002d590_Oblivion_RESP2"
msgid "Well, of course. Raminus would naturally want my opinion, wouldn't he?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG07MasterForger_00048974_Oblivion_RESP1"
msgid ""
"Well, only because I like you. Look for a man known only as the Stranger. He "
"lives here in Anvil, down the road from the Chapel of Dibella."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFelldew_000206f8_Oblivion_RESP1"
msgid ""
"Well, perhaps Thadon would want you to have a bit more guidance. He did say "
"that you should talk to me, did he not?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilTopic_00048917_Oblivion_RESP1"
msgid ""
"Well, perhaps, yes, one hears such things, what is one to believe? That "
"S'krivva collects goods of untestable provenance? Pshaw. Rumors."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_00028236_Oblivion_RESP1"
msgid ""
"Well, she does seem genuinely upset that someone's been killed. Not that I'm "
"ruling her out as a suspect, mind you.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07Strangers_00020072_Oblivion_RESP1"
msgid "Well, since I like you ... I think there's somebody staying with Jearl."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS31Wrath03Final_0001525f_Oblivion_RESP1"
msgid ""
"Well, since they're out of the way, if I kill you, that means Selene and I "
"split the take two ways. This heist is getting better and better!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BrumaTopic_0003c9a9_Oblivion_RESP1"
msgid ""
"Well, sometimes I feel we're not welcome here. The Nords don't like "
"Heartlanders very much."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGOtherJobs_00018120_Oblivion_RESP1"
msgid ""
"Well, sometimes the guild gets a special commission. You know. Guaranteed pay "
"to 'acquire' certain items for special clients."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479f0_Oblivion_RESP1"
msgid ""
"Well, stranger, anyone ever tell you the story of Torval the Pilot, the High "
"Elf who discovered the Niben? The patron saint of Leyawiin?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark08Choice6C_00085a66_Oblivion_RESP1"
msgid ""
"Well, thanks for listening. I know I'm just being a silly little girl, but "
"the heart wants what it wants, as they say."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29ShadyDeal_0001e7f3_Oblivion_RESP1"
msgid ""
"Well, that Society is putting more pressure on me. So maybe we better cut "
"back for a while."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028b7f_Oblivion_RESP1"
msgid ""
"Well, that chest of gold is supposed to be in here somewhere. Though why "
"someone would invite us all here just to give it away is quite the mystery."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00081d93_Oblivion_RESP1"
msgid "Well, that was humbling."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29InvGet_0001d044_Oblivion_RESP1"
msgid ""
"Well, that would be a trade secret. I can't divulge how I pass the great "
"savings on to you, now can I?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00085973_Oblivion_RESP1"
msgid ""
"Well, that's it, my friend. We're the last. And that damned assassin is still "
"hiding out in this house somewhere."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EmfridNot_00023cd1_Oblivion_RESP1"
msgid "Well, that's just my opinion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS04SayNo_0003d4b1_Oblivion_RESP1"
msgid ""
"Well, that's never happened before. I suppose we'd have to kill you. I mean, "
"we can't have you going back to Anvil and ruining the whole plan."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG13EridorWhy_0003446f_Oblivion_RESP1"
msgid "Well, that's not really any of your concern, now is it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00092d76_Oblivion_RESP1"
msgid ""
"Well, that's that. The killer is dead, and this nightmare is just about over. "
"All we have to do now is find a way out of here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE36Choice7NowWhat_00061c4f_Oblivion_RESP1"
msgid ""
"Well, that's up to you, I suppose. I'm going to go about my daily life, such "
"as it is, as if nothing has changed."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AAnyaHelp_00014026_Oblivion_RESP1"
msgid ""
"Well, the best I can offer is help with the guards. I can distract at least "
"two of them and get them to leave her wing of the palace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03AInstDoYouHandle_00018dfc_Oblivion_RESP1"
msgid "Well, the dead will be disposed of, have no fear. That's my job."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NelsTheNaughtyTopic_0002817d_Oblivion_RESP1"
msgid ""
"Well, the list of suspects is certainly getting smaller. I didn't think the "
"swine had it in him, but now I'm not so sure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopic_00038aa7_Oblivion_RESP1"
msgid ""
"Well, the local wine is great. It isn't cheap. But I don't bother with beer "
"or ale any more, and for a Nord, that's saying something."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0006a854_Oblivion_RESP1"
msgid ""
"Well, the others and I have been talking.... Is it true? About the traitor? "
"It's frightening to think he infiltrated the Brotherhood so easily."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d88a_Oblivion_RESP2"
msgid ""
"Well, then my request is small. Prove to me that you are capable of serving "
"Molag Bal in your own way."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE09AuthorityMyOwnFemale_00081dac_Oblivion_RESP2"
msgid ""
"Well, then. I trust my servants didn't give you too hard a time getting here. "
"Haha! Perhaps the Duchess would like to explain her business?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09AuthorityMyOwn_0001356b_Oblivion_RESP2"
msgid ""
"Well, then. I trust my servants didn't give you too hard a time getting here. "
"Haha! Perhaps the Duke would like to explain his business?"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE09AuthoritySheogoraths_0001356a_Oblivion_RESP2"
msgid ""
"Well, then. I trust my servants didn't give you too hard a time getting in "
"here. Haha! What is it Sheogorath's lackey requires of me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_jointheMagesGuild_0002d05d_Oblivion_RESP1"
msgid ""
"Well, then. It's no small matter; membership in the guild is quite an honor, "
"but also a responsibility. Do you wish to join the guild?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ04Conv_0008b600_Oblivion_RESP1"
msgid "Well, then. Thank you, Martin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00061393_Oblivion_RESP1"
msgid "Well, there it is. Not the best job I've seen, but you did it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE40GreetingChoice2_000790c0_Oblivion_RESP1"
msgid ""
"Well, there's an idea! Why didn't I think of that? But, where would I sleep? "
"I need someplace to sleep."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS10AnyoneWhoCares_0003c29c_Oblivion_RESP1"
msgid ""
"Well, there's one man who seems to care: Garrus Darelliun, the second in "
"command of the guard. I hear he isn't happy with Ulrich."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_MS40MelisandeIdonthavethem_0005373c_Oblivion_RESP2"
msgid "Well, there's still time, is there not? I shall continue to wait."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Gift_0018bc2f_Oblivion_RESP3"
msgid ""
"Well, these are simply beautiful. Thank you so much. And there's no need to "
"let him know that I know where they came from. You understand."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028870_Oblivion_RESP1"
msgid ""
"Well, they're all taken care of now. Good work, there, soldier. Get back to "
"gro-Khash and get your payment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002886d_Oblivion_RESP1"
msgid ""
"Well, they're all taken care of now. I can't believe we lost Elidor and Brag. "
"Head back to gro-Khash. He won't be happy, but these things happen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002886e_Oblivion_RESP1"
msgid ""
"Well, they're all taken care of now. It's a damn shame about Elidor. He was a "
"fine swordsman. You should head back to gro-Khash now. Thanks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002886f_Oblivion_RESP1"
msgid ""
"Well, they're all taken care of now. It's a shame we lost Brag. I'll miss the "
"ugly bastard. You should head back to gro-Khash now. Thanks."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GuardTalk2_0006fdd4_Oblivion_RESP1"
msgid ""
"Well, things are bound to get worse before they get better. They always do. "
"Keep your eyes peeled for trouble."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000918dc_Oblivion_RESP2"
msgid ""
"Well, things aren't always as they seem. In fact, I think I hear the answer "
"to your problem coming as we speak...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItem6_00081ec9_Oblivion_RESP1"
msgid ""
"Well, this case seems to be empty. Strange. I'm sure that yesterday... ah, my "
"memory just isn't what it used to be. Let's see what else we can find."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009079d_Oblivion_RESP1"
msgid ""
"Well, this saves me a bit of trouble. Aleron's dead even though I planned to "
"kill him anyway. So, that just leaves you. Let the game continue!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e8c6_Oblivion_RESP1"
msgid ""
"Well, to be honest, I don't think we have much of a team in the Cheydinhal "
"guildhall. We lack leadership, and individually, we aren't very skilled."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000b97df_Oblivion_RESP3"
msgid "Well, to help around the house I mean."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQJauffreHelp_0005e160_Oblivion_RESP3"
msgid ""
"Well, we both have better things to do than stand here all day exchanging "
"idle gossip. Good day to you, now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalk4_00002bbd_Knights_RESP1"
msgid ""
"Well, we'll need weapons, of course. And armor. Provisions. Traveling "
"expenses. Scrolls and potions too, I'd imagine."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingArmorerHazadir_0018d15f_Oblivion_RESP1"
msgid "Well, well!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10MessengerGreeting_0008f4db_Oblivion_RESP1"
msgid ""
"Well, well! What a turn of events this is! It's new, and I like new, even if "
"it's bad. And this is bad, isn't it? My, my."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d628_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't Dragonheart! How's our new Grand Champion, huh? You "
"ready to make me some money? Ha ha ha ha ha!  Ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d629_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't Lady Luck! How's our new Grand Champion, huh? You "
"ready to make me some money? Ha ha ha ha ha!  Ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d625_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't Man o' War! How's our new Grand Champion, huh? You "
"ready to make me some money? Ha ha ha ha ha!  Ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d61f_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't Shadowstep! How's our new Grand Champion, huh? You "
"ready to make me some money? Ha ha ha ha ha!  Ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d626_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't Sir Slaughter! How's our new Grand Champion, huh? You "
"ready to make me some money? Ha ha ha ha ha!  Ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d621_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't Skullcrusher! How's our new Grand Champion, huh? You "
"ready to make me some money? Ha ha ha ha ha!  Ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d620_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't the Black Arrow! How's our new Grand Champion, huh? "
"You ready to make me some money? Ha ha ha ha ha!  Ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d61e_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't the Butcher! How's our new Grand Champion, huh? You "
"ready to make me some money? Ha ha ha ha ha!  Ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d624_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't the Crimson Blade! How's our new Grand Champion, huh? "
"You ready to make me some money? Ha ha ha ha ha!  Ahem... "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d622_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't the Divine Avenger! How's our new Grand Champion, "
"huh? You ready to make me some money? Ha ha ha ha ha!  Ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d62a_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't the Iron Maiden! How's our new Grand Champion, huh? "
"You ready to make me some money? Ha ha ha ha ha!  Ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d623_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't the Messenger of Death! How's our new Grand Champion, "
"huh? You ready to make me some money? Ha ha ha ha ha!  Ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d61d_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't the Spellslinger! How's our new Grand Champion, huh? "
"You ready to make me some money? Ha ha ha ha ha!  Ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003d627_Oblivion_RESP1"
msgid ""
"Well, well, if it isn't the Tamriel Terror! How's our new Grand Champion, "
"huh? You ready to make me some money? Ha ha ha ha ha!  Ahem..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033366_Oblivion_RESP1"
msgid ""
"Well, well, look at the elegant Altmer maiden. Where's your dignity now, huh? "
"Where's that famous High Elf poise and bearing?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenTaunt2_00033365_Oblivion_RESP1"
msgid ""
"Well, well, look at the high and mighty Altmer. Where's your dignity now, "
"huh? Where's that famous High Elf poise and bearing?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028be9_Oblivion_RESP1"
msgid ""
"Well, well, look who's here. It's the number one suspect in the cold-blooded "
"murder of two innocent people. I'm watching you, scum."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001dc4e_Oblivion_RESP1"
msgid ""
"Well, well, still alive, are we? Amazing. I never thought you'd make it past "
"the first combatant. Just make sure you remember your place, Brawler."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000290a_Knights_RESP1"
msgid ""
"Well, well. A wayward son returning to the church? What do you want with me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000297e_Knights_RESP1"
msgid "Well, well. If it isn't the holy Crusader herself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000297d_Knights_RESP1"
msgid "Well, well. If it isn't the holy Crusader himself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VampireAshTopic_0008d1eb_Oblivion_RESP1"
msgid "Well, well. It would seem you've been busy out on your own."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035f31_Oblivion_RESP2"
msgid ""
"Well, well. Raminus was right in sending you out there. Good work. I'll be "
"sure and put in a good word for you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00012cc0_Oblivion_RESP1"
msgid ""
"Well, well. So you've experienced both shades of madness. Wonderful. You "
"seemed fulfilled. Full of fill. Bursting at the seams. Seamless."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000a7154_Oblivion_RESP1"
msgid "Well, well. The Gray Fox, in person."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000146c7_Oblivion_RESP1"
msgid ""
"Well, well. This is quite a surprise. I thought you were Traven's lapdog, "
"doing whatever he said, and yet here you are."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002526b_Oblivion_RESP1"
msgid "Well, well. Who might you be?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SeersStone_0001e067_Oblivion_RESP1"
msgid ""
"Well, well. Word is finally spreading, is it? They won't be able to keep up "
"this facade much longer!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047696_Oblivion_RESP1"
msgid ""
"Well, well. You interested in Acrobatics training? You'd be quite a "
"challenge. I'm Ida Vlinorman."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035a15_Oblivion_RESP1"
msgid "Well, well. You're early, Mage."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035a14_Oblivion_RESP1"
msgid "Well, well. You're late, Mage."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000837e8_Oblivion_RESP1"
msgid ""
"Well, what are you waiting for. There's a party, and you're the guest of "
"honor. All I get to do is lock the damn door. You get to have all the fun."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003a910_Oblivion_RESP1"
msgid "Well, what are you waiting for? Get!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000356a5_Oblivion_RESP1"
msgid "Well, what did you find at Water's Edge?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062c9e_Oblivion_RESP1"
msgid "Well, what have we here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007eae5_Oblivion_RESP1"
msgid ""
"Well, what have we here? Another hopeful whose blessing hasn't fully taken "
"root? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00036622_Oblivion_RESP1"
msgid ""
"Well, what have you found? Did you take care of my babies? What was going on "
"down there?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005374c_Oblivion_RESP1"
msgid "Well, what're you just standing there for?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark05Choice2A_0004cacf_Oblivion_RESP1"
msgid ""
"Well, when Hides-His-Heart gets here, I'll put on a little act. You'll cut me "
"with your poison knife, and that vile enforcer will think I'm dead."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrimoAntoniusTopic_00028f45_Oblivion_RESP1"
msgid ""
"Well, when somebody gets murdered, everyone nearby could be considered a "
"suspect. That includes young Primo."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_MS02VelwynEscortChoice2_0000927a_Oblivion_RESP1"
msgid "Well, when you're ready, you know where to find me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c2b3_Oblivion_RESP1"
msgid "Well, where is he?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG13Choice3A_00003a91_Oblivion_RESP1"
msgid ""
"Well, where is it? I sure don't see any. I'd expect you to at least have some "
"vampire dust. Don't try to pull my leg."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00061396_Oblivion_RESP1"
msgid ""
"Well, will you look at that. Quite a bit of gold you have there... so "
"beautiful, isn't it?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00026ea3_Oblivion_RESP1"
msgid ""
"Well, with the Oblivion Gate near Leyawiin closed, I suppose the immediate "
"threat is lessened."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035f32_Oblivion_RESP1"
msgid "Well, would you look at that!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e886_Oblivion_RESP1"
msgid ""
"Well, yes, my name.... Mivryna Arano. Excuse me, but I don't speak much. With "
"people, that is."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BPleasures_000167e1_Oblivion_RESP4"
msgid ""
"Well, yes. Apart from enjoying his painting, reading a good book, or a "
"rousing night of erotic bedroom games?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035586_Oblivion_RESP3"
msgid ""
"Well, you can kill me if you like. I'm afraid I won't make much of a "
"challenge, though. The Argonian Royal Court already sent an Agent to do the "
"job."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS46OtherOptions_0000ab73_Oblivion_RESP1"
msgid ""
"Well, you could always just fight your way into Cracked Wood Cave and kill "
"their shaman."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFlameofAgnonTopic_00019ad7_Oblivion_RESP1"
msgid ""
"Well, you did accomplish your task. There's no denying that the Golden Saints "
"are defeated."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StolenGold_0005375f_Oblivion_RESP2"
msgid ""
"Well, you did your part of the bargain, now I'll do mine. The gold is buried "
"outside the walls of Bruma, near the North Gate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_StolenGold_000a04dc_Oblivion_RESP3"
msgid ""
"Well, you did your part of the bargain, now I'll do mine. The gold is buried "
"outside the walls of Bruma, near the North Gate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_00061397_Oblivion_RESP1"
msgid ""
"Well, you do get around, don't you? You've seen a good bit of what the world "
"has to offer, which is more than can be said for most people."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01ThievesTest_0001c14f_Oblivion_RESP1"
msgid "Well, you finally returned with Rohssan's sword."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f85e_Oblivion_RESP3"
msgid "Well, you found me. Congratulations. Go tell Jeanne, if you must."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_00027f85_Oblivion_RESP1"
msgid ""
"Well, you got the weapons there, but there were casualties after. Do better "
"in the future, or don't come to me for work. Here's your reward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00037ff6_Oblivion_RESP4"
msgid ""
"Well, you know the drill. You let me know when you're ready for a match, and "
"Agronak will head up to the Arena and prepare for your arrival."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00037ff7_Oblivion_RESP3"
msgid ""
"Well, you know the drill. You let me know when you're ready for a match, and "
"Agronak will head up to the Arena and prepare for your arrival."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017201_Oblivion_RESP1"
msgid ""
"Well, you managed to get Llathasa's bust, and you got Hieronymus Lex off my "
"back. However, you broke the code of the Thieves Guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000477f5_Oblivion_RESP1"
msgid ""
"Well, you sorted out the Blackwood boys, all right. Nice work. Now maybe "
"we'll see a little more guild contract work here in Leyawiin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG04Choice4A_0003018a_Oblivion_RESP3"
msgid ""
"Well, you take care of yourself. I'd hate to hear about another senseless "
"death. Good luck to you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG04Choice2A_0004f229_Oblivion_RESP3"
msgid "Well, you watch out for yourself, and be careful!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DinnerParty_0001c106_Oblivion_RESP1"
msgid ""
"Well, you're dressed for it, and you seem like a really good person. You can "
"go in. Sorry to have bothered you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_duties_0006e2e3_Oblivion_RESP1"
msgid ""
"Well, you're in charge. You won't be doing the contracts, but the Master is "
"always paid a percentage of the Guild's monthly take."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035708_Oblivion_RESP1"
msgid ""
"Well, you've found the Three Sisters. Beds and food. Not cheap, but you get "
"what you pay for."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_jobs_00071096_Oblivion_RESP1"
msgid ""
"Well, you've got the ectoplasm! Seems you Fighters Guild types can do a job "
"when you put your mind to it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFlameofAgnonTopic_00019ad1_Oblivion_RESP1"
msgid ""
"Well, you've talked to one side. Perhaps a visit to the Dark Seducers is in "
"order?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFlameofAgnonTopic_00019ad2_Oblivion_RESP1"
msgid ""
"Well, you've talked to one side. Perhaps a visit to the Golden Saints is in "
"order?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NeutralReceive_0002954c_Oblivion_RESP1"
msgid "Well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001dc28_Oblivion_RESP2"
msgid ""
"Well.  Yes.  I need you to do something for me.  I'll pay you -- gold.  You "
"like gold, don't you?  Lots of gold."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopicElse01_00038a9c_Oblivion_RESP1"
msgid ""
"Well. Good. I really don't care, either. I just get sick of all the god-talk. "
"Might as well pray to rocks and lamp posts."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugo05_00090b78_Oblivion_RESP2"
msgid "Well. That's nice. I set Brugo up for you, and you get the reward?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BlackBrugo06_00090b79_Oblivion_RESP1"
msgid "Well. That's nice. I set Brugo up for you, and you get the reward?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06SheoIntro5_00082461_Oblivion_RESP5"
msgid ""
"Well. That's your problem now. Off with you. I don't want to see you again "
"until the Great Torch is lit. I wouldn't want to have to hurt you. Much."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradTopicMog01_00038a8e_Oblivion_RESP1"
msgid ""
"Well. The guards must've been careless. But Captain Dione has the guard on "
"full alert. We'll be safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00026bbc_Oblivion_RESP1"
msgid "Well..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MageTalk1_0006a85d_Oblivion_RESP1"
msgid ""
"Well... All right. But please, be brief. I have some... research I need to "
"tend to..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00014661_Oblivion_RESP2"
msgid "Well... Caranya will want to talk to you. You should go see her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Gang_0003d4a7_Oblivion_RESP5"
msgid ""
"Well... I did... and then suddenly they brandished weapons and robbed me. "
"They sent me away with barely a stitch of clothing! Harlots!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BladesTalk2_0006835a_Oblivion_RESP1"
msgid ""
"Well... I just wanted to say how honored I am... How honored we all are... by "
"your presence, I mean."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQJauffreHelp_0005e160_Oblivion_RESP1"
msgid ""
"Well... I normally stay out of the affairs of the great folk that come "
"through Weynon Priory to see Master Jauffre."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkDeadGukimir1_00002cf0_Knights_RESP1"
msgid ""
"Well... I was just thinking about poor Sir Gukimir. He should still be here, "
"with us, planning his next quest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ09Retirement_00067dd3_Oblivion_RESP1"
msgid ""
"Well... I'll tell you a secret. I took some of the money I saved and paid a "
"mage to lock the rest of it away in a box inside my house."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ09Retirement_000cbb73_Oblivion_RESP1"
msgid ""
"Well... I'll tell you a secret. I took some of the money I saved and paid a "
"mage to lock the rest of it away in a box inside my house."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE39NotebookChoice_00078205_Oblivion_RESP1"
msgid ""
"Well... I've never shown it to anyone else before, but I feel I can trust "
"you. Here. Look it over, but bring it right back. Okay?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MageTalk2_0006a864_Oblivion_RESP1"
msgid ""
"Well... You'll recall my hypothesis? The one I mentioned the other day? I'll "
"have you know, I was right! And to think, you actually doubted me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQWait_001778cc_Oblivion_RESP2"
msgid "Well... alright. I think we'd be better off sticking together, though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS47Eventually_0003003e_Oblivion_RESP1"
msgid ""
"Well... in a year or two. Maybe a bit more. There's no way to be absolutely "
"sure. That's the exciting thing about basic research!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE41Catch_0006d604_Oblivion_RESP1"
msgid ""
"Well... it seems I am dying. Yes, these may be my last days in the Shivering "
"Isles."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTalkDeadAreldur1_00002cfe_Knights_RESP1"
msgid ""
"Well... it's Sir Areldur. I don't understand how he can be gone. He was the "
"best of us..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ThoronirTopic_0001e83b_Oblivion_RESP1"
msgid ""
"Well... maybe Thoronir wasn't responsible for digging up those corpses, but "
"good riddance to his insane prices. Nice job."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MG13Choice3A_00003a78_Oblivion_RESP1"
msgid "Well... maybe you're not lying after all."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ11BrumaAllies_00058e0b_Oblivion_RESP1"
msgid ""
"Well... some is better than none. But more is always better. Honestly, I'd be "
"happier if we had more men."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE34Crisis_00066edd_Oblivion_RESP1"
msgid "Well... this is a bit embarrassing, so forgive me..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Displeased_0001365c_Oblivion_RESP4"
msgid "Well... yes. Absolutely. Bit of a shame for them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033754_Oblivion_RESP1"
msgid "Well?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033789_Oblivion_RESP1"
msgid "Well?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005c0cb_Oblivion_RESP1"
msgid "Well?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008f556_Oblivion_RESP1"
msgid "Well? Do you want your pay or not?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0005e36f_Oblivion_RESP1"
msgid "Well? Have you made up your mind? The tension is almost palpable."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000915c6_Oblivion_RESP1"
msgid ""
"Well? What are you waiting for? You have the blood, and the altar awaits."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000917b4_Oblivion_RESP1"
msgid ""
"Well? What are you waiting for? You have the heart, and the altar awaits."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008f7d7_Oblivion_RESP1"
msgid ""
"Well? What is it you need. Please, be quick about it... the seconds are "
"ticking by as we speak. Ohhhh. There goes several more."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MagesStaff_0003554a_Oblivion_RESP1"
msgid ""
"Wellspring Cave lies to the northeast of the Imperial City. The mages there "
"can assist you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00053245_Oblivion_RESP1"
msgid ""
"Wellspring Grove is owned by the Mages Guild. You're not a member, so I'm "
"afraid you're not supposed to be here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilNQDResponses_000465b2_Oblivion_RESP1"
msgid "Were I injured, I'd seek out Marz."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00025276_Oblivion_RESP1"
msgid ""
"Were I not ordered to assist you I would forgo the Tenets and feast on your "
"blood!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE02GatekeeperChoice2Accepted_0007eaed_Oblivion_RESP2"
msgid ""
"Were up to me, I'd cut you open and show you just how uninspired your blood "
"is."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017d53_Oblivion_RESP1"
msgid ""
"Were you able to provide the Mazken with aid? We have little in the way of "
"supplies here. No healing. No restoration. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001e7c9_Oblivion_RESP1"
msgid "Were you able to stop Agarmir?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000356a3_Oblivion_RESP1"
msgid "Were you able to take care of my problem with break-ins?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ13MartinD1_0009ce83_Oblivion_RESP9"
msgid "Were you acting for the gods? I don't know. But now it's my turn to act."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00072f16_Oblivion_RESP1"
msgid "Were you followed?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38TalkItem7_00082431_Oblivion_RESP1"
msgid ""
"Were you in here last week? Wasn't there an exhibit in this case then? Oh "
"well, I must just be going senile, hahaha!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000981f4_Oblivion_RESP1"
msgid "Were you invited? I didn't invite you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003cceb_Oblivion_RESP1"
msgid "Were you looking for me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001544c_Oblivion_RESP1"
msgid "Were you successful? Do you have the Black Soul Gem?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000c47ea_Oblivion_RESP1"
msgid ""
"Werewolves? Where? Wolves? Men that are wolves? Many wolves. Everywhere. Many "
"men. That is enough for M'aiq."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND03TellMeMore_00002c95_Knights_RESP2"
msgid ""
"West of the Imperial City, on the edge of the Great Forest, is a shrine. You "
"will find them there, and they will tell you what you need to know."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_LeyawiinTopic_000479f9_Oblivion_RESP1"
msgid ""
"West of the Niben, with all the troubles, many bandits. West of town I know "
"two lairs where bandits hide... Telepe and Undertow Caverns."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bc9e_Oblivion_RESP1"
msgid ""
"Western Cyrodiil is called 'Colovia,' and includes the Gold Coast, West "
"Weald, and Colovian Highlands regions."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_WeynonPrioryTopic_000247ea_Oblivion_RESP1"
msgid ""
"Weynon Priory is a monastery devoted to the praise and worship of Talos and "
"the Nine Divines."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DirectionsLandmarks_0018bd99_Oblivion_RESP3"
msgid "Weynon Priory is outside the south gate, just past the stables."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003c341_Oblivion_RESP1"
msgid "Wha'? You say somethin'?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000914db_Oblivion_RESP1"
msgid "Wha'? You sellin' something? Go away, I'm broke!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00015256_Oblivion_RESP1"
msgid "Wha- ? What are you doing up here? They find the Golden Galleon yet?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002fbab_Oblivion_RESP1"
msgid ""
"Wha...? What do you want... friend? Wait... You're not my friend. If you were "
"my friend., you'd give me something. Like, you know... skooma!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00078206_Oblivion_RESP1"
msgid "Whadda you need?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002c7b7_Oblivion_RESP1"
msgid "Whadda you want?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetGreetB1_00002adb_Knights_RESP2"
msgid ""
"What I can tell you is that traditionally, knights who wished to quest for "
"the Relics would walk the Pilgrim's Way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00034ea8_Oblivion_RESP3"
msgid ""
"What I hope you will now see is that while the guild can be disjointed and "
"misused, it can also achieve some wonderful things. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MartinTopic_0006c5c4_Oblivion_RESP2"
msgid ""
"What I know is that he sacrificed himself to save us all. As a Blade, I'm "
"proud to have served such a master, if only for a short while."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002821f_Oblivion_RESP2"
msgid ""
"What I mean to say is, before you arrived, we all just sort of glanced around "
"a bit. Now that we're all officially here, we can look in earnest!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS09PleaseGoOn_00053725_Oblivion_RESP5"
msgid ""
"What I need you to do is go to the Bruma Castle Dungeons and speak to him for "
"me. Convince him to tell you where the gold is and then we split it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AmuletofKingsTopic_00033fcc_Oblivion_RESP3"
msgid ""
"What I saw at Kvatch... everything I know about daedric magic says that such "
"stable portals are impossible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE40SleepOutside_000790ab_Oblivion_RESP2"
msgid ""
"What I would do for a warm bed. Soon I'll be leaving here. As soon as I can "
"figure out how to leave without them noticing."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08AncestorMoth_00048973_Oblivion_RESP3"
msgid ""
"What I've heard is that they live in total darkness in a secret underground "
"labyrinth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG08BribeBeggar_00015f1b_Oblivion_RESP3"
msgid ""
"What I've heard is that they live in total darkness in a secret underground "
"labyrinth."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_0004768c_Oblivion_RESP1"
msgid ""
"What Iniel says, goes. He says, lay off the Atius, I lay off the Atius. "
"Simple."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007b84a_Oblivion_RESP1"
msgid ""
"What a battle, eh? I thought we were all goners until I saw that fiery dragon "
"in the sky."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PrisonVisitor_0018d201_Oblivion_RESP1"
msgid ""
"What a bother. Don't be too long about it. I gotta stay with you so there "
"isn't any funny business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Announcer_0004667a_Oblivion_RESP1"
msgid ""
"What a disappointing turn of events this is! Leave the Arena now, combatant "
"from the Blue Team, and hang your head in shame!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JOKEDISLIKE_0018b2d3_Oblivion_RESP1"
msgid "What a dumb joke."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000165b8_Oblivion_RESP1"
msgid "What a fool I was."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_COERCEHATE_00062329_Oblivion_RESP1"
msgid "What a fool you are."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SkingradNQDResponses_0003c1db_Oblivion_RESP1"
msgid "What a fool. I hope he's happy with himself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BOASTLIKE_0018b2b8_Oblivion_RESP1"
msgid "What a great story."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MucianusAliasTopic_00095a69_Oblivion_RESP3"
msgid ""
"What a horrible fate. I cannot imagine how they could do that to him. So many "
"lives lost..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003357b_Oblivion_RESP1"
msgid "What a horrible turn of events."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03GrommokChamberOneGrow02_00066e40_Oblivion_RESP1"
msgid "What a joke! Let's be rid of this thing and continue on our way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00078679_Oblivion_RESP1"
msgid "What a mess! I would prefer to speak in the palace. Shall we?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND06KellenRumors_00002bcf_Knights_RESP1"
msgid "What a noble thing to do. I'm glad he'll finally have peace."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_contract_000253e1_Oblivion_RESP1"
msgid ""
"What a pathetic contract. Play acting and running, but no actual killing? I "
"can see why Vicenti gave it to you... coward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity9_00081e92_Oblivion_RESP3"
msgid ""
"What a perfect little Oddity! Just strange enough that it makes you go "
"\"Hmm?\" but not so strange as to become a Miracle or an Omen. Thank you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033d0e_Oblivion_RESP1"
msgid "What a pity."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HorseTooMuchBravil_0004d82f_Oblivion_RESP1"
msgid "What a pity."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EulogyBreton_0009f9ba_Oblivion_RESP1"
msgid "What a pity. For the Breton, it is over."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HorseDecline_0004d843_Oblivion_RESP1"
msgid ""
"What a pity. If you change your mind, we have a fine selection of Chestnut "
"horses."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00083f54_Oblivion_RESP2"
msgid ""
"What a pleasant surprise. Previously, it was only poor Big Head who seemed to "
"understand me. And he's always in such a lather about that Fork."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SadGeneral_00024275_Oblivion_RESP1"
msgid "What a shame."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HouseTooMuchBruma_0004f216_Oblivion_RESP1"
msgid "What a shame. I guess I have to look for another buyer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38Oddity3_00043428_Oblivion_RESP3"
msgid ""
"What a shame. One Sheogorath-shaped amber lump is Odd; two are simply boring. "
"Maybe next time you'll find something really Odd."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081b73_Oblivion_RESP1"
msgid ""
"What a surprise. I'm summoned. Your skill in repetition is truly astounding."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BRIBE_0018b2c1_Oblivion_RESP1"
msgid "What a thoughtful gift!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0005422c_Oblivion_RESP1"
msgid "What a waste of my talents."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_PERSUASIONEXIT_000622fa_Oblivion_RESP1"
msgid "What a waste of time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_VidkunTopic_0002d290_Oblivion_RESP1"
msgid "What a way to go. Awful news, just awful."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ADMIRELOVE_0006230b_Oblivion_RESP1"
msgid "What a wonderful compliment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DovesiDranTopic_00028193_Oblivion_RESP1"
msgid ""
"What about her? She's a Dark Elf, and that's bad enough. I may even like her "
"less than you, if that's possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Inventory_0000bca1_Oblivion_RESP1"
msgid "What about my inventory?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_0000bf14_Oblivion_RESP1"
msgid "What about that side passage back there?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07Spies_0002008d_Oblivion_RESP3"
msgid "What about you? Turned up anything suspicious?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0018a95f_Oblivion_RESP1"
msgid "What am I to do? I'll never be able to re-enter that cave alone."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03SyndelC1Idle01_0008eaa6_Oblivion_RESP1"
msgid "What an odd ruin."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15MankarRant_0008c230_Oblivion_RESP10"
msgid ""
"What are Scholarship, Love, and Mercy when compared to Fate, Night, and "
"Destruction? The gods you worship are trifling shadows of First Causes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG09FathisAren_00048972_Oblivion_RESP1"
msgid ""
"What are friends for? Fathis is also the wizard in the tower outside of town. "
"He keeps his most treasured items there, not in the castle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000293d_Knights_RESP1"
msgid "What are those things?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00086569_Oblivion_RESP1"
msgid "What are we waiting for?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CheydinhalTopic_0004e8db_Oblivion_RESP1"
msgid ""
"What are you asking me for? Do I look like Vile's dog or something? Go on. "
"Knit a doily or play a flute or something."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfbc_Oblivion_RESP1"
msgid "What are you doing here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00014661_Oblivion_RESP1"
msgid "What are you doing here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0000a22e_Oblivion_RESP1"
msgid "What are you doing here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00043e24_Oblivion_RESP1"
msgid "What are you doing here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00072f0d_Oblivion_RESP1"
msgid "What are you doing here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00072f17_Oblivion_RESP1"
msgid "What are you doing here?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018b192_Oblivion_RESP1"
msgid "What are you doing here? What do you want?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000335d4_Oblivion_RESP1"
msgid ""
"What are you doing in here. This is the headquarters for the Knights of the "
"Thorn. No one else is allowed inside."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004e8ba_Oblivion_RESP1"
msgid ""
"What are you doing in here? Wander in by mistake? This is the Mages Guild. "
"You want a barn or sheep pen or something."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0004fa6f_Oblivion_RESP1"
msgid "What are you doing?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS45DarMaDontUntie_000280b6_Oblivion_RESP1"
msgid "What are you doing?  You can't leave me here to die!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MatildePetitTopic_000286e5_Oblivion_RESP1"
msgid ""
"What are you doing? Trying to turn me against her? What's the matter, trying "
"to cover your tracks? "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00017786_Oblivion_RESP1"
msgid "What are you doing? We can't talk in front of him!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_000286fa_Oblivion_RESP1"
msgid ""
"What are you getting at? Are you suggesting that Neville is the killer? Take "
"your suspicions someplace else, you low-born worm.  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001f420_Oblivion_RESP1"
msgid ""
"What are you lookin' at? Get outta' my sight before I have you hacked off at "
"the knees."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0008656b_Oblivion_RESP1"
msgid "What are you looking at?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfbb_Oblivion_RESP1"
msgid "What are you looking at? Keep pouring drinks!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Directions_0018bd8b_Oblivion_RESP1"
msgid "What are you looking for?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_00028700_Oblivion_RESP1"
msgid ""
"What are you saying? That Neville is the killer? Why should I trust a low-"
"born dog like you? Get away from me!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Interrogate1_00013a57_Oblivion_RESP1"
msgid ""
"What are you talking about? I don't know anything! There's nothing going on!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00068dc3_Oblivion_RESP1"
msgid "What are you thinking, wearing something like that? Take it off at once!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03KilibanChamberChatter_0008f037_Oblivion_RESP1"
msgid "What are you waiting for? Choose a button."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003b358_Oblivion_RESP1"
msgid "What are you waiting for? Kill me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000285a2_Oblivion_RESP1"
msgid ""
"What are you waiting for? You signed up for this, maggot! Now get up to that "
"Arena and fight!  "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00002963_Knights_RESP1"
msgid "What are your orders, Commander?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13CaptainGreetA1_0001a79d_Oblivion_RESP3"
msgid "What are your orders, My Lord?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE13CaptainGreetA3_0005e37c_Oblivion_RESP3"
