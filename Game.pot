msgid "Speak, madwoman."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00061c7e_Oblivion_RESP1"
msgid "Speak, sister."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0002b5f4_Oblivion_RESP1"
msgid "Speak, snowman, and stop wasting my time."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00072e05_Oblivion_RESP1"
msgid "Speak, while I can still hear you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0005c0c9_Oblivion_RESP1"
msgid "Speak."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0018bb03_Oblivion_RESP1"
msgid "Speak."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00033b37_Oblivion_RESP1"
msgid "Speaketh you on."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEFlameofAgnonTopic_00019ad7_Oblivion_RESP2"
msgid ""
"Spearing fish in a barrel might have proved a bit more challenging, but "
"there's definitely something to be said for making it easy for yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003631e_Oblivion_RESP1"
msgid "Spill some blood for me, dear Brother."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003631f_Oblivion_RESP1"
msgid "Spill some blood for me, dear Sister."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30MadnessOre_0001650d_Oblivion_RESP1"
msgid ""
"Spirits of ancient souls are trapped in the Ore. Find it in old ruins. Also, "
"Grummites are especially attracted to it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062cd6_Oblivion_RESP1"
msgid "Spit it out or hit the road."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS23FollowSeridur_0001d248_Oblivion_RESP1"
msgid "Splendid. Watch your step."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Dark07FinChoice1A_000275ca_Oblivion_RESP1"
msgid ""
"Splendid. You need to go to the city of Skingrad, to the large house known as "
"Summitmist Manor. There you will meet up with five very unlucky guests."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SQ04Notes_0018a957_Oblivion_RESP1"
msgid "Splendid... just splendid!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GuardTalk1_00070291_Oblivion_RESP1"
msgid ""
"Spotted a minotaur out by the ridge. He nearly had my poor Bessie here for "
"lunch! Fear not, the monster's now rotting in a ditch, I assure you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00041f19_Oblivion_RESP1"
msgid ""
"Spread the word. The world is coming to an end. But it's nothing to worry "
"about."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0018bcc9_Oblivion_RESP1"
msgid ""
"Spriggans. \"Nature's guardians\" my foot! Mean things. They'll curse you, or "
"they might call a bear to tear you apart."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_000476ff_Oblivion_RESP1"
msgid ""
"St. Alessia has blessed our city and all its people. Visit the Temple of the "
"One, and renew your faith."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003664b_Oblivion_RESP1"
msgid ""
"Stand aside in the name of Tiber Septim and the Blades! Hinder me at your "
"peril!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000914d7_Oblivion_RESP1"
msgid "Stand aside!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000227b7_Oblivion_RESP1"
msgid "Stand aside, prisoner!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001b685_Oblivion_RESP1"
msgid "Stand back! They're going to breach the gate any minute now!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003c378_Oblivion_RESP1"
msgid "Stand back, and let me take care of this."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00024853_Oblivion_RESP1"
msgid "Stand back, civilian!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_00032b0e_Oblivion_RESP1"
msgid ""
"Stand back, prisoner. We won't hesitate to kill you if you get in our way."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE09Ceremony_00014aca_Oblivion_RESP1"
msgid "Stand clear of the cistern. Over here by me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003c3b7_Oblivion_RESP1"
msgid "Stand clear!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0006b82f_Oblivion_RESP1"
msgid "Stand fast for Bruma!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003c362_Oblivion_RESP1"
msgid "Stand fast, this isn't going to be pleasant."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_00051ea0_Oblivion_RESP1"
msgid "Stand ready!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGEmperor22_00032684_Oblivion_RESP1"
msgid ""
"Stand true, my friend. May your heart be your guide and the gods grant you "
"strength."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000c42c4_Oblivion_RESP1"
msgid "Stand your ground!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047704_Oblivion_RESP1"
msgid ""
"Stantus Varrid. I'm not a priest any more... just a private seeker in search "
"of white light."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003a90d_Oblivion_RESP1"
msgid "Start talkin' already!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DirectionsLandmarks_0018bda5_Oblivion_RESP2"
msgid ""
"Starting in the northeast, moving clockwise, you have the Market, Arena, "
"Arboretum, Temple, Talos Plaza, and Elven Gardens districts. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006fdbf_Oblivion_RESP1"
msgid "State your business, citizen."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bc85_Oblivion_RESP1"
msgid "State your business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0018bc93_Oblivion_RESP1"
msgid "State your business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000982c9_Oblivion_RESP1"
msgid "State your business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00018e7e_Oblivion_RESP1"
msgid "State your business. Cylarne is holy ground, unfit for mortals."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000327c5_Oblivion_RESP1"
msgid "Stay as long as you like."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BGreenmote_000167e5_Oblivion_RESP1"
msgid ""
"Stay away from Greenmote. Your enemy will just use it to lull you into a "
"false sense of security before he strikes!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000825e1_Oblivion_RESP1"
msgid "Stay away from Vitharn. It's said the dead walk there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081dbc_Oblivion_RESP1"
msgid "Stay away from me. You've already spent too much time... over there."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00077d02_Oblivion_RESP1"
msgid "Stay away from the obelisks! Strange things have appeared near them."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001e0d9_Oblivion_RESP1"
msgid "Stay away!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ObserveCombat_0002b376_Oblivion_RESP1"
msgid "Stay away!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0001a11f_Oblivion_RESP1"
msgid ""
"Stay away! You don't know! You can't know! It's in there! It'll kill us all!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008faa7_Oblivion_RESP1"
msgid "Stay away, you monster! I know what you're up to!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE02RelmynaVisit_0001a12f_Oblivion_RESP1"
msgid ""
"Stay away. My tears, they burn you! Don't you remember? Stay back, child!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE01GaiusTalk_00071177_Oblivion_RESP1"
msgid "Stay back! This one's violent!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00022a93_Oblivion_RESP1"
msgid "Stay back! We mustn't be seen!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0004421e_Oblivion_RESP1"
msgid ""
"Stay back! Where'd you come from? The big torch in the city? Back away, I "
"say. Back!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00024671_Oblivion_RESP1"
msgid "Stay back, prisoner."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001a110_Oblivion_RESP1"
msgid "Stay back. Isn't safe here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003376f_Oblivion_RESP1"
msgid "Stay close, please."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS18OdiilTalk02_0002b1cc_Oblivion_RESP1"
msgid "Stay focused! Watch your backs, and be careful. Antus, are you ready?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00072dfb_Oblivion_RESP1"
msgid "Stay for a while. And stay away from my wife."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE08SheldenStayHere_00043f6e_Oblivion_RESP1"
msgid ""
"Stay here? What's wrong with you? I'll be killed! Take me with you! Please?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfca_Oblivion_RESP1"
msgid "Stay outta my business!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenVoice_00024de7_Oblivion_RESP1"
msgid "Stay put, prisoner."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0006a82a_Oblivion_RESP1"
msgid "Stay safe, citizen. These are dark times...."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00072f12_Oblivion_RESP1"
msgid "Stay safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0018d7de_Oblivion_RESP1"
msgid "Stay safe."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000852b4_Oblivion_RESP1"
msgid "Stay safe... if that's even possible."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ00Voice_0003c420_Oblivion_RESP1"
msgid "Stay sharp!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE32AcolyteWarning_0008fb6d_Oblivion_RESP1"
msgid "Stay sharp!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00022a80_Oblivion_RESP1"
msgid "Stay sharp, Associate."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Lost_00081a45_Oblivion_RESP1"
msgid "Stay vigilant. Order's enemies are everywhere."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00026ba7_Oblivion_RESP1"
msgid "Stay warm, my friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Steal_000252ce_Oblivion_RESP1"
msgid "Stay where you are, thief!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000335df_Oblivion_RESP1"
msgid "Stay with it."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrespassNoCrime_0006250d_Oblivion_RESP1"
msgid "Stay. Go. What do I care?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0005467a_Oblivion_RESP1"
msgid "Steady!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03GrommokChamberThreeStart_00067288_Oblivion_RESP1"
msgid ""
"Steady, Grommok... steady. You've been through worse before. What more could "
"this place possibly throw at you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0008db88_Oblivion_RESP1"
msgid ""
"Steer clear of the Atronach whose skin is made of flesh. Just when you think "
"they'll be dead, they end up nice and fresh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECreatureResponses_0008e11c_Oblivion_RESP1"
msgid ""
"Steer clear of the Atronach whose skin is made of flesh. Just when you think "
"they'll be dead, they end up nice and fresh."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDTombSpeech_00002d04_Knights_RESP1"
msgid ""
"Stendarr grants you the gift of legerity. Always be swift to protect and "
"swift to forgive."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00035a29_Oblivion_RESP1"
msgid ""
"Step aside! I'm going to win the right to join the guild. You can't beat me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0006c29f_Oblivion_RESP1"
msgid "Step aside."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00073b4b_Oblivion_RESP1"
msgid "Step back, plague bearer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0000290e_Knights_RESP2"
msgid ""
"Step forward, adventurer, and face us each in honorable combat. For the vows "
"we failed to revere in life, we shall uphold in death. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0001ebf4_Oblivion_RESP1"
msgid "Step forward, herald of madness. Speak with me if you would."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0002c2ef_Oblivion_RESP1"
msgid "Stick close and let us do our job, and you'll be all right."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000227b4_Oblivion_RESP1"
msgid "Stick close and you'll be alright."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5d2_Oblivion_RESP1"
msgid "Stick the wickwheat until soft, add the marshwillow..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ00Voice_000817c6_Oblivion_RESP1"
msgid "Stick together!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00053758_Oblivion_RESP1"
msgid "Stick with the plan, and everything should go smoothly."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeArrows_0001f3c9_Oblivion_RESP1"
msgid "Stick your foe with one of these pretty arrows."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HackdirtTopic_000280a2_Oblivion_RESP2"
msgid "Still folks living up there, but no one you'd like to meet after dark."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000224f2_Oblivion_RESP1"
msgid "Still here, stranger? You're not actually renting a room, are you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrespassNoCrime_0006250e_Oblivion_RESP1"
msgid "Still here? You've got nerve, I'll give you that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00030036_Oblivion_RESP1"
msgid ""
"Still no news out of Aleswell since everybody vanished. Strange business."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0007b722_Oblivion_RESP1"
msgid ""
"Still staying away from my fishing spots? I may be retired but they're still "
"mine, you understand?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JeanneFrasoricTopic_0001ceeb_Oblivion_RESP3"
msgid ""
"Still, I don't quite think she deserves the hard time the others give her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NevilleTopic_000286ff_Oblivion_RESP2"
msgid ""
"Still, I don't think he's the murderer. No, quite the contrary. I think he "
"takes the murders personally, feels he should have protected the victims."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE11RakheranGreeting2b_00019fc9_Oblivion_RESP1"
msgid ""
"Still, for whatever reason you are here, you mean Ciirta ill, yes? Don't "
"bother refuting me, I know the truth. Yes, I do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22DontKnowHighFane_0002af33_Oblivion_RESP2"
msgid ""
"Still, the architectural detail is distinctive enough, it may still be "
"recognizable."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TheGrayPrince_00038b46_Oblivion_RESP4"
msgid ""
"Still... If I could prove who I really am, and show the world that an Orc can "
"be noble in blood as well as deed... Maybe... Yes! You could help me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004765e_Oblivion_RESP1"
msgid ""
"Stonewall Shields. We specialize in shields. Viator Accius, your servant."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ICAllNQDQuestionResponses_00049923_Oblivion_RESP1"
msgid "Stonewall is the best in the city when it comes to shields."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01ThievesTest_0000550e_Oblivion_RESP1"
msgid ""
"Stop following me! I'll beat both of you... if I can just figure out where "
"Amantius Allectus lives."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00072db5_Oblivion_RESP1"
msgid "Stop following me, you smelly cat!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003c340_Oblivion_RESP1"
msgid "Stop gettin' in my way!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10SheoJyggalag3_00091400_Oblivion_RESP1"
msgid ""
"Stop it? Oh, no. Can't do it. Believe me, I've tried. It never ends well."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000bf1be_Oblivion_RESP1"
msgid ""
"Stop right there, criminal scum! Nobody breaks the law on my watch! I'm "
"confiscating your stolen goods. Now pay your fine or it's off to jail."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000335e7_Oblivion_RESP1"
msgid "Stop staring at me. Let's get to work."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000241ad_Oblivion_RESP1"
msgid "Stop talking! Enough!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000277cd_Oblivion_RESP1"
msgid "Stop talking! Enough!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000c47eb_Oblivion_RESP1"
msgid "Stop talking."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_FGD02Insults_0002cfd4_Oblivion_RESP1"
msgid "Stop these maniacs!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0007eae6_Oblivion_RESP2"
msgid "Stop wagging that tongue at me, or I will rip it out!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000514bd_Oblivion_RESP1"
msgid "Stop wasting time. Get to Harlun's Watch. Now."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG01MethredhelCheated_0001c153_Oblivion_RESP1"
msgid ""
"Stop whining, Methredhel. You'll get another chance soon enough. Why should "
"the Thieves Guild turn down a recruit for stealing?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ15Voice_000872d4_Oblivion_RESP1"
msgid "Stop! Don't let Anaxes out!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0009816d_Oblivion_RESP1"
msgid "Stop! Please! What is it? What more do you want?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_0007cc3d_Oblivion_RESP1"
msgid "Stop! Take me unaware, not like this!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0007cc4a_Oblivion_RESP1"
msgid "Stop! Take me unaware, not like this!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Steal_000252b2_Oblivion_RESP1"
msgid "Stop! Thief!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028ce7_Oblivion_RESP1"
msgid ""
"Stop! You violated the law. Pay the court a fine or serve your sentence. Your "
"stolen goods are now forfeit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000281a4_Oblivion_RESP1"
msgid ""
"Stop! You violated the law. Since you lack the funds to pay the court, you "
"must serve out your sentence. Your stolen goods are now forfeit. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00027fc7_Oblivion_RESP1"
msgid ""
"Stop, criminal! I've heard of you. Your criminal exploits are well-known. Pay "
"the fine or serve your sentence. Your stolen goods are forfeit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS37SdrassaAcquire_00022e5d_Oblivion_RESP1"
msgid "Straight to the point, eh? Good, I like that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ef1c_Oblivion_RESP1"
msgid ""
"Strange creatures have appeared in the Fringe... perhaps you need a new "
"blade? A Madness blade?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005ef19_Oblivion_RESP1"
msgid "Strange knights in the Fringe? Well, I'll drink to that!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolNQDResponses_00029fe2_Oblivion_RESP1"
msgid "Strange noises, you say? How very odd. I haven't heard it myself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ChorrolNQDResponses_00029fe3_Oblivion_RESP1"
msgid "Strange noises? They should have the guards look into that."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MaladaTopic_0002c52e_Oblivion_RESP1"
msgid ""
"Strange ruins, huh? You'd have to be crazy to go in there. I'm just here for "
"the scenery and fresh air."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5b7_Oblivion_RESP1"
msgid "Strange."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusA_0001e8e6_Oblivion_RESP1"
msgid "Strange. He saw something in you. Trusted you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003357d_Oblivion_RESP1"
msgid ""
"Strange... with all the lava, you'd think I'd be warm, but all I feel is a "
"bone-chilling cold. Perhaps it's fear..."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00028bad_Oblivion_RESP1"
msgid "Stranger's in town."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CharGenMain_0001e708_Oblivion_RESP1"
msgid "Stranger, you chose a bad day to take up with the cause of the Septims."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_000607bb_Oblivion_RESP1"
msgid "Strangers are bad news."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_000607dd_Oblivion_RESP1"
msgid "Strangers. Probably causing trouble."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS13Gate_000c452f_Oblivion_RESP1"
msgid ""
"Strangest thing. One minute we're inside Oblivion, and the next thing I know "
"we're back here and the gate falls apart. How odd."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeShield_00055fdc_Oblivion_RESP1"
msgid "Strap this shield onto that big arm of yours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0008c23a_Oblivion_RESP1"
msgid "Strength against strength!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00074a06_Oblivion_RESP1"
msgid "Strength against strength!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Attack_0001a7fb_Oblivion_RESP1"
msgid "Strength through Order!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00074a0a_Oblivion_RESP1"
msgid "Strike me down and my father's power will raise me up again!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00074a05_Oblivion_RESP1"
msgid "Strike me down, if you can!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0001a7f9_Oblivion_RESP1"
msgid "Strike me down. My Lord Jyggalag has other servants."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_0008ef70_Oblivion_RESP1"
msgid "Strike me, will you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_0005f220_Oblivion_RESP1"
msgid ""
"Stronger than ever, and ever before. The new Gatekeeper is the ultimate ward."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b59c_Oblivion_RESP1"
msgid "Stuck his tongue to his axe! Ha! Serves him right."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04NoKilling_00008034_Oblivion_RESP1"
msgid ""
"Stupid guild rules! He is only an Argonian. He is less than human, and much "
"less than Khajiit. If you must spare him, at least make him suffer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03GrommokC2Idle01_0008ea7c_Oblivion_RESP1"
msgid "Stupid rogue, just when we needed him!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0008676a_Oblivion_RESP1"
msgid "Stupid... just plain stupid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000908ef_Oblivion_RESP1"
msgid "Stupid... just plain stupid."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0004575a_Oblivion_RESP1"
msgid ""
"Submitting to Sheogorath's justice is wise. Will you pay reparations, or "
"serve your sentence? Either way, your stolen goods are forfeit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE38OddityDonate_00081ea1_Oblivion_RESP3"
msgid ""
"Such a benefactor! I'll be sure to mention your generosity to all my other "
"patrons."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BThadon_000167e0_Oblivion_RESP1"
msgid ""
"Such a kind and noble man. In times like these, it's good to have a leader "
"who still enjoys all the modern pleasures Mania has to offer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003cc2e_Oblivion_RESP1"
msgid "Such a pleasure to be in good company."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE43DeadDog_0008f13d_Oblivion_RESP1"
msgid "Such a pretty dog. Dead, dead, dead. Ushnar is sad."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CureforVampirism_000748a3_Oblivion_RESP2"
msgid ""
"Such a thing is beyond our control. The body is so warped by vampirism, few "
"would be able to revert its effects. Even fewer would care to try."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BOASTLOVE_0018b2ba_Oblivion_RESP1"
msgid "Such adventures! How I envy you!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062c9d_Oblivion_RESP1"
msgid "Such good company. Welcome."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ND04CarodusGreeting2_00002ad1_Knights_RESP1"
msgid ""
"Such humility -- I admire you. I am Carodus Oholin. I originally came to this "
"chapel in search of the Mace of Zenithar. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE03SyndelC2Idle01_0008eab1_Oblivion_RESP1"
msgid "Such riches shouldn't go to waste. We must get in."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeGreavesMagic_00016cea_Oblivion_RESP1"
msgid "Such strong blood pulses through the legs."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b589_Oblivion_RESP1"
msgid "Such useless creatures."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_ServicetoLeyawiinTopic08_000860ba_Oblivion_RESP1"
msgid ""
"Such vengeance is a noble deed. Leyawiin thanks you for your service. And I "
"have a fitting reward for such noble deeds."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_000624fc_Oblivion_RESP1"
msgid "Such violence!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ04WeynonAttack_0001ee28_Oblivion_RESP3"
msgid ""
"Suddenly weapons appeared in their hands and they cut the Prior down before "
"he could move! They saw me watching and I ran."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS29InvGet_0001d044_Oblivion_RESP3"
msgid ""
"Suffice to say, they are quite reliable and low cost. That way, you walk out "
"with a full coinpurse!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062c94_Oblivion_RESP1"
msgid "Sugar and sands, friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS09ImOut_00053723_Oblivion_RESP1"
msgid "Suit yourself, but I have a feeling that you'll be back."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BedNo_0003b349_Oblivion_RESP1"
msgid "Suit yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00061559_Oblivion_RESP1"
msgid "Suit yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS38GuardChoice1_00023680_Oblivion_RESP1"
msgid "Suit yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE37NoSpell_0007b222_Oblivion_RESP1"
msgid "Suit yourself."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS09TyrelliusTalk_000908ea_Oblivion_RESP1"
msgid "Suit yourself. Enjoy your stay."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS16Choice5B_00028b85_Oblivion_RESP1"
msgid ""
"Suit yourself. I thought you might have an interest in self-improvement, but "
"perhaps not. Let me know if you ever change your mind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HorseTooMuchLeyawiin_00053236_Oblivion_RESP1"
msgid "Suit yourself. I'm practically giving them away at that price."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ07BeggarNeverMind_00020092_Oblivion_RESP1"
msgid "Suit yourself. I'm sure it isn't anything important."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS22SrazirrNoDeal_0002c529_Oblivion_RESP1"
msgid ""
"Suit yourself. Maric may be cheating S'razirr, but at least this one knows "
"what to expect."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ErthorTopic_0002d6e8_Oblivion_RESP2"
msgid ""
"Sulinus should be around here somewhere. Talk to him if you'd like to know "
"more about Erthor."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TrainingQuestTopic_0018d88a_Oblivion_RESP3"
msgid ""
"Summon a Faded Wraith right here, before me. When I have seen it with my own "
"eyes, you shall be worthy of my teachings."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Assault_000285a5_Oblivion_RESP1"
msgid "Summon the Brethren!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAHircineSpeech_00051edc_Oblivion_RESP1"
msgid "Summoned by prey. The hare crouches before the fox's muzzle."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG04GivePick_00035fb7_Oblivion_RESP2"
msgid ""
"Sunlit freedom! Yes, I stole that ring from Ahdarji. When I went to sell it, "
"the fence told me I was too hot for him."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture5_00071959_Oblivion_RESP1"
msgid ""
"Suppose that the runestones are divine, and that the secrets of their magics "
"are revealed only by divine revelation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture5_0007195a_Oblivion_RESP1"
msgid ""
"Suppose that the runestones existed, for whatever reason, and in whatever "
"form, long before the coming of the Cyrodilic emperors."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture5_0007195c_Oblivion_RESP1"
msgid ""
"Suppose that, under the guidance of the gods, these runestones were newly "
"consecrated to a great purpose... the founding of the Cyrodilic Empire."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ArcaneULecture5_0007195b_Oblivion_RESP1"
msgid ""
"Suppose, however, that the power of these stones had been hidden, but was "
"revealed to certain holy men or prophets in the First Era."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG05OntusVanin_0000a24f_Oblivion_RESP1"
msgid "Sure I know. I just need motivation."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkBladeAllofThem_00014d8b_AltarDeluxe_RESP1"
msgid "Sure thing. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkBluntAllofThem_00014d95_AltarDeluxe_RESP1"
msgid "Sure thing. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkHeavyFull_00014da5_AltarDeluxe_RESP1"
msgid "Sure thing. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DEAkLightArmorFull_00014daf_AltarDeluxe_RESP1"
msgid "Sure thing. Anything else?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46DoublesTopic_00081ef4_Oblivion_RESP1"
msgid ""
"Sure would be nice to read something about the other Atrabhi. Like an epitaph."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE46DoublesTopic_00081ed1_Oblivion_RESP1"
msgid ""
"Sure would be nice to see one more corpse around here. One that looks like "
"me, but isn't me. Take my meaning?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Fugitives_00009c2f_Oblivion_RESP1"
msgid ""
"Sure, I know about them. Look, you didn't hear it from me, but rumor is "
"they're hiding out in Bloodmayne Cave. Four of them. Bad news."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MouthofthePanther_00036601_Oblivion_RESP1"
msgid ""
"Sure, I know what that is. Any sailor worth his weight in sea salt could tell "
"you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGHieronymusLex_00015f27_Oblivion_RESP1"
msgid "Sure, I know where to find Hieronymus Lex. I sure am hungry though."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_bed_00037ce3_Oblivion_RESP1"
msgid ""
"Sure, friend, I've got a bed you can rent. It's upstairs at the end of the "
"hall, last door on your right. Just 20 Gold. Sound good?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0007311d_Oblivion_RESP1"
msgid ""
"Sure, friend. Go right ahead. I have plenty of time to talk to you. Really, I "
"do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetTopic_00002a91_Knights_RESP1"
msgid ""
"Sure, go down to the Chapel and you can't miss him. He'll be the one outside, "
"ranting at passersby."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DAClavicusSpeech_000243af_Oblivion_RESP1"
msgid ""
"Sure, he'll be a bit put off, but you won't be dead. At least, you probably "
"won't. That's better odds than you're getting here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_UmbacanoBribeB2_000a9851_Oblivion_RESP1"
msgid "Sure, sounds good. See you around."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e3b_Oblivion_RESP1"
msgid ""
"Sure, the Fighters Guild is established and reliable. But they just aren't as "
"aggressive as the Blackwood Company."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032e4e_Oblivion_RESP1"
msgid ""
"Sure, the Fighters Guild raided a family tomb, but they did it for a family "
"member. What's wrong with that?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetTopic_00002a94_Knights_RESP1"
msgid ""
"Sure, the guy down by the Chapel. He's the one calling for some holy knight "
"to return. Maybe we could use a few more holy knights these days."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BarterSellItem_0003d086_Oblivion_RESP1"
msgid ""
"Sure, why not. I might even be able to ransom it back to the original owner."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE30ForgeCuirass_0001652b_Oblivion_RESP1"
msgid "Sure, you've got your rib cage, but a sharp blade can pry ribs apart."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerPositive_0002420a_Oblivion_RESP1"
msgid "Sure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerPositive_0002b14f_Oblivion_RESP1"
msgid "Sure."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_AnswerPositive_0002b158_Oblivion_RESP1"
msgid "Sure."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE40SleepOutsideChoiceU2_000790b2_Oblivion_RESP2"
msgid ""
"Sure. Fine. I'm tired of sleeping outside. Tell him I'll sleep in his bed and "
"he can sleep in mine."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BattlehornTrainerSparring_0000c00b_DLCBattlehornCastle"
"_RESP1"
msgid "Sure. I need a weapon. The choice is yours."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG03ElvenBust_000092af_Oblivion_RESP1"
msgid "Sure. I've heard about it. What's it worth to ya?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00032eab_Oblivion_RESP1"
msgid ""
"Sure. In the Arena, you can make a lot of money, real fast. And you can get "
"dead, real fast, too."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_ImperialCityTopic_0007be9e_Oblivion_RESP1"
msgid ""
"Sure. Some folks here think horses are for riding. Then again, some of us are "
"Orcs. Snak gra-Bura, she prefers eating stew to riding horses. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_JOKELIKE_0006231d_Oblivion_RESP1"
msgid "Sure. That's cute."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05Conspiracy_000895df_Oblivion_RESP1"
msgid ""
"Surely the Inquisitor has considered that with direct evidence, Ma'zaddha may "
"now be more responsive to questioning."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDProphetGreetA4a_00002be8_Knights_RESP2"
msgid ""
"Surely there can be no better preparation for becoming a holy knight than a "
"career spent slaughtering for the public's entertainment."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_OrderOfTalosTopic_00033dfd_Oblivion_RESP2"
msgid ""
"Surely you have heard of us? If not, I invite you to spend some time in our "
"fine library. All are welcome here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE06ArctusGreetA_00040144_Oblivion_RESP4"
msgid "Surely you will do what is right, won't you?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_NDCrusadersRelicsTopic_00002a81_Knights_RESP1"
msgid "Surely you've heard the stories of the Quest for the Crusader's Relics?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00081b71_Oblivion_RESP1"
msgid "Surely, you have something better to do."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488ce_Oblivion_RESP1"
msgid ""
"Surely... you must know who I am! The Count's son. Do you mind? I have no "
"desire to be further acquainted with every visitor to Bravil."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00047739_Oblivion_RESP1"
msgid "Surius Afranius. I'm a guard for Umbacano."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_EronorTopic_000247e8_Oblivion_RESP1"
msgid "Surprised by Eronor's uncanny way with sheep?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_0003d4e3_Oblivion_RESP1"
msgid "Surprised to see us?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00132a8c_Oblivion_RESP1"
msgid "Surprised to see us?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGExpelAccept_00025037_Oblivion_RESP4"
msgid ""
"Surprised? Annoyed? It is not unexpected. Nevertheless, that is your path to "
"re-acceptance in the guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MGExpelAccept_0002503b_Oblivion_RESP4"
msgid ""
"Surprised? Annoyed? It is not unexpected. Nevertheless, that is your path to "
"re-acceptance in the guild."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_information_000039a3_Oblivion_RESP3"
msgid "Surprised? Nothing is for free, mage."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_BravilNQDResponses_00046607_Oblivion_RESP1"
msgid ""
"Surprising, don't you think, since she never seems to leave that guild hall."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE05SylFindYou_0007fe20_Oblivion_RESP3"
msgid ""
"Surrounded by traitors and spies, I am. Always, always. They watch and wait, "
"eager to slip a knife into my spine when I'm not looking."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DABoethiaSpeech_00051ed8_Oblivion_RESP1"
msgid "Survive, and you will be rewarded. Fail, and your soul belongs to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5be_Oblivion_RESP1"
msgid "Sweet Skooma."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SERunsInCirclesGreetE_0004120e_Oblivion_RESP1"
msgid "Sweet and juicy! I can always count on you, my best pal!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SERunsInCirclesGreetF_0004120f_Oblivion_RESP1"
msgid "Sweet and juicy! You're the best!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Idle_0018b5bd_Oblivion_RESP1"
msgid "Sweet moon sugar."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00033b42_Oblivion_RESP1"
msgid "Sweet!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TGPayExpelFine_0001efc0_Oblivion_RESP1"
msgid "Sweet! The hunter is restored. The pride welcomes the hunter once again."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SECaldanaMonriusSkooma_0008f5f1_Oblivion_RESP1"
msgid "Sweet, sweet Skooma. Give it here. Give it here!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE40SleepOutsideChoiceSweetroll_000790bb_Oblivion_RESP"
"1"
msgid "Sweetroll for Fimmion. Yummy in tummy. Answer for you. Problem solved."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE44FimmionChoice1_0007877b_Oblivion_RESP1"
msgid "Sweetroll good. Fimmion give pants. Got pie? Apples? Fimmion hungry."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_00062ca4_Oblivion_RESP1"
msgid "Swift hunting, friend."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0000a221_Oblivion_RESP1"
msgid "Swift hunting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_00061610_Oblivion_RESP1"
msgid "Syl always thinks someone is out to get her."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Become_0007893e_Oblivion_RESP2"
msgid ""
"Syl anticipates plots against her, so expect heavy resistance that may "
"require a great deal of fighting and physical exertion."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_0006172b_Oblivion_RESP1"
msgid "Syl being killed is no surprise, but Thadon leaving, as well?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ef3_Oblivion_RESP1"
msgid ""
"Syl enjoys having people tortured. She's a rank amateur. I could teach her a "
"few things."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10DyloraWhere_00017d0e_Oblivion_RESP3"
msgid ""
"Syl had called her aside, separating her from the group. She meant to divide "
"our numbers when Order entered, making us easier targets."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ead_Oblivion_RESP1"
msgid ""
"Syl had folks tortured again. So what? Real torture is my mug being empty."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ee4_Oblivion_RESP1"
msgid ""
"Syl has been known to round up people for \"questioning\" from time to time. "
"Torture devices are known to spread disease."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000441f6_Oblivion_RESP1"
msgid "Syl has been replaced. I should tell Sheer-Meedish."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00091805_Oblivion_RESP2"
msgid ""
"Syl has been slain. You need Syl's heart. I'll let you figure out the rest."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043eb2_Oblivion_RESP1"
msgid ""
"Syl has gone on another one of her rampages in Crucible. I'm certainly glad I "
"live on the right side of the wall."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00013ffa_Oblivion_RESP1"
msgid ""
"Syl has made her escape through the hidden tunnel in the gardens outside her "
"quarters! She must not get away!"
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061436_Oblivion_RESP1"
msgid "Syl has spies everywhere. We are all at risk."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ea5_Oblivion_RESP1"
msgid "Syl has tortured her courtiers again, I hear. Poor things."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_000615ed_Oblivion_RESP1"
msgid "Syl is a paranoid fool."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043eaf_Oblivion_RESP1"
msgid ""
"Syl is a paranoid fool. She could torture me as much as she'd like, though. "
"Cut intricate patterns into my skin. I shiver just thinking about it."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEDementiaRumorResponses_00061465_Oblivion_RESP1"
msgid "Syl is always threatened."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07ASyl_0006a890_Oblivion_RESP1"
msgid ""
"Syl is as crafty as she is beautiful. I'd watch my back if I were you. Oh, "
"this is so much fun!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SEManiaRumorResponses_00061730_Oblivion_RESP1"
msgid "Syl is dead, but Thadon is missing! These are dark times."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00044203_Oblivion_RESP1"
msgid ""
"Syl is gone, and a new ruler presides over the House of Dementia. Perhaps "
"they can cure my malady."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00044234_Oblivion_RESP1"
msgid "Syl isn't dead. She's living on an island nearby."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10Opposition_00017d11_Oblivion_RESP1"
msgid ""
"Syl let them in. More than I could count. It was all we could do to fall back "
"and regroup out here."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ee6_Oblivion_RESP1"
msgid ""
"Syl likes torturing people, doesn't she? But, there's really no point in "
"lying. I mean, it takes too much energy to keep it all straight."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043eef_Oblivion_RESP1"
msgid ""
"Syl likes torturing people. She's got nothing on the methods of Sorceress "
"Verenim, though. She's a genius with pain."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043edc_Oblivion_RESP1"
msgid ""
"Syl never has anyone tortured. She's a gentle and kind leader. She trusts "
"everyone, and is therefore trustworthy."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ea4_Oblivion_RESP1"
msgid "Syl once again tortures her courtiers. Soon, we will all suffer."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07Decision_0001e3ed_Oblivion_RESP1"
msgid "Syl or Thadon? Which will it be?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000441cb_Oblivion_RESP1"
msgid "Syl replaced. I wouldn't have guessed I'd see it."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_0006166c_Oblivion_RESP1"
msgid "Syl tends to jump at shadows."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043eae_Oblivion_RESP1"
msgid "Syl torturing her own staff? Kinky."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07BSheoShout_0008f57c_Oblivion_RESP1"
msgid "Syl! You dare interrupt Me? Only I interrupt Me. Like just then."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SEWildernessRumorResponses_00061759_Oblivion_RESP1"
msgid "Syl's finally dead. I'm not surprised."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043ef5_Oblivion_RESP1"
msgid ""
"Syl's really suspicious of other people. I bet she's the one with something "
"to hide."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043eac_Oblivion_RESP1"
msgid ""
"Syl's rounding up people again. I better go stash my Skooma. Or... I would if "
"I had some. You have any?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043e9d_Oblivion_RESP1"
msgid ""
"Syl's torturing people again? I'd hate to be locked up in a tiny cell. That'd "
"be torture enough."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00043eb4_Oblivion_RESP1"
msgid ""
"Syl's torturing people? To death, I hope? It was me. I did it, whatever it "
"was. Come take me away and kill me. I'm the culprit."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE07AThadonLeaves_000206cd_Oblivion_RESP1"
msgid ""
"Syl... my... Syl is dead? This can't be right. Is this right? What have you "
"done? Have you done this?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE10WhatHappened_0001746f_Oblivion_RESP1"
msgid ""
"Syl... the snake. She showed up, asked for a contingent of guards. Said there "
"was trouble at the palace, and that we were needed."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE03LewinChamberOneGnarl01_000648b2_Oblivion_RESP1"
msgid "THIS is one of the \"horrid guardians\" of which the stories spoke?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00072dee_Oblivion_RESP1"
msgid "Ta! Come visit again! Or I'll pluck out your eyes."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000465e4_Oblivion_RESP1"
msgid ""
"Tadrose Helas teaches smithing at the Fighters Guild. Well, when she has the "
"time."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_BravilNQDQuestionResponses_000465c1_Oblivion_RESP1"
msgid ""
"Tadrose is a fine smith, but I understand she only offers services to other "
"Fighters Guild members."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE45Choice2_00083f5f_Oblivion_RESP2"
msgid ""
"Take Big Head's charm! Listen to Bolwing! His tongue is tied, but his mind is "
"unraveled! He'll tell you the secret. Who has the Fork?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000624cb_Oblivion_RESP1"
msgid ""
"Take Cheydinhal, for example. Pretty little town. But the Count's a Dark Elf, "
"and it's crawling with Orc thugs and gangsters."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_DABoethiaSpeech_00051eda_Oblivion_RESP1"
msgid ""
"Take Goldbrand, sheathe it in your enemies, and offer their souls as praise "
"to me. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000488c4_Oblivion_RESP1"
msgid "Take a chance on the Warlock's Luck!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00028865_Oblivion_RESP5"
msgid ""
"Take a few moments to catch your breath and think it over. When you're ready, "
"let me know, and we'll get underway. "
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Recommendation_00034e12_Oblivion_RESP3"
msgid ""
"Take a moment to try it on, and then we shall speak of what comes next for "
"you."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000029ad_Knights_RESP1"
msgid ""
"Take a moment, if you would, and tell me again about the battle of Garlas "
"Malatar."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003e1d0_Oblivion_RESP2"
msgid ""
"Take a seat, or feel free to look around. We have a fine collection of "
"cheeses here, some of the rarest in all Tamriel!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_SE01HaskillTalk_0005dd12_Oblivion_RESP1"
msgid "Take a seat, please."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQ05RavenSpeech_00022daa_Oblivion_RESP1"
msgid "Take a seat."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00072f13_Oblivion_RESP1"
msgid "Take care now!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0004f3e4_Oblivion_RESP1"
msgid "Take care of Lelles. He needs the help."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_duties_0002e584_Oblivion_RESP1"
msgid "Take care of Maglir's contract. Then report back to me."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MaglirTOPIC2_0002ee65_Oblivion_RESP1"
msgid "Take care of his contract. We'll discuss him later."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007b79b_Oblivion_RESP1"
msgid "Take care of the rats."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_000825e2_Oblivion_RESP1"
msgid "Take care venturing into the ruined city of Vitharn."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00083f55_Oblivion_RESP1"
msgid "Take care! Come back for a chat whenever you have the chance."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000343b2_Oblivion_RESP1"
msgid "Take care, father."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0002fa6d_Oblivion_RESP1"
msgid "Take care, friend. Don't get yourself killed on our account."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000256e0_Oblivion_RESP1"
msgid "Take care."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003aaa8_Oblivion_RESP1"
msgid "Take care."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_000617b1_Oblivion_RESP1"
msgid "Take care."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_HELLO_000a715a_Oblivion_RESP1"
msgid "Take care."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00072df4_Oblivion_RESP1"
msgid "Take care. Wish I could."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Trespass_0009f916_Oblivion_RESP1"
msgid "Take everything, just don't hurt me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_TG10JakBuried_0001530e_Oblivion_RESP1"
msgid "Take everything, just spare me!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MS04HeardNo_0003d30d_Oblivion_RESP3"
msgid ""
"Take for example that good-for-nothing husband of mine, Gogan. He cared more "
"about their charms than my own."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003160d_Oblivion_RESP1"
msgid "Take heed the knife that strikes from behind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0007ec6c_Oblivion_RESP1"
msgid "Take heed the knife that strikes from behind."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Hit_00054676_Oblivion_RESP1"
msgid "Take him on the flank!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_CGBaurusH_0001e90d_Oblivion_RESP1"
msgid ""
"Take it easy. You'll be fine. I know this is a lot to take in all at once."
msgstr ""

