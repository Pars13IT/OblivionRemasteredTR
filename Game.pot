msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_0003d4ec_Oblivion_RESP1"
msgid "Goodbye."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GOODBYE_00040bb3_Oblivion_RESP1"
