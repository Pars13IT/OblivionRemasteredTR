msgid "Let's look around."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003a845_Oblivion_RESP1"
msgid "Let's make these bastards sorry they messed with Bruma."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00064f38_Oblivion_RESP1"
msgid "Let's not keep the Blades waiting."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000232cb_Oblivion_RESP1"
msgid ""
"Let's not waste time on pleasantries. Gaston Tussaud is still alive, and it's "
"your job to remedy that. I suggest you tend to your duties."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_000473c9_Oblivion_RESP1"
msgid "Let's put an end to Mankar Camoran and his evil Paradise."
msgstr ""

msgctxt ""
"ST_ResponseTexts/LOC_RT_SE09MiscRelmynaExperiment_00046f45_Oblivion_RESP1"
msgid "Let's see how much of this you can take before dying, shall we?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0003661c_Oblivion_RESP1"
msgid "Let's see if we can't find those mountain lions."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Training_000389a1_Oblivion_RESP1"
msgid "Let's see if we can't teach you a thing or two."
