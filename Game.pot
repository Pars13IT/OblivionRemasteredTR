msgid "Have you reconsidered, child? Will you aid me?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_00022e59_Oblivion_RESP1"
msgid "Have you reconsidered?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_MQJoinBlades_00037cf0_Oblivion_RESP1"
msgid ""
"Have you reconsidered? Are you ready to join our order in service to the "
"Dragon Blood?"
msgstr ""

