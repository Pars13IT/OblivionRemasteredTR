msgid "Have you heard that Samuel Bantien has a bit of a checkered past?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0003dfba_Oblivion_RESP1"
msgid "Have you heard the Derics arguing?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_00029685_Oblivion_RESP1"
msgid "Have you heard the odd noises coming from Eugal Belette's place?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_0004662f_Oblivion_RESP1"
msgid "Have you heard the rumors about why Edla Dark-Heart left Skyrim?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_Question_000465e3_Oblivion_RESP1"
msgid "Have you heard what a good alchemist Ardaline is?"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_GREETING_0002815c_Oblivion_RESP1"
msgid ""
"Have you heard, my friend? One of our fellow guests has been murdered! This "
"bodes ill for our stay, and our search for the gold."
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00034073_Oblivion_RESP1"
msgid ""
"Have you heard? Adamus Phillida has been killed! Murdered by the Dark "
"Brotherhood!"
msgstr ""

msgctxt "ST_ResponseTexts/LOC_RT_INFOGENERAL_00002a06_Knights_RESP1"
msgid ""
"Have you heard? Some questing knight actually recovered one of the Crusader's "
"Relics! Well done, I say!"
msgstr ""

