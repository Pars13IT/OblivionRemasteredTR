msgid ""
"I should talk to the sorceress Relmyna Verenim about the Gatekeeper. I can "
"also talk to Jayred about killing the Gatekeeper."
msgstr ""

msgctxt "ST_LogEntries/LOC_LE_SE02_STAGE20_LOG4"
msgid ""
